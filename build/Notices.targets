<Project>
  <!--
    The license of AI Client, its NOTICE and the notices of every third-party component it ships
    (THIRD-PARTY-NOTICES.md, generated by the build application's third-party-notices command) travel
    with each installed product. Imported by the executables that are installed: AI.Host and AI.Desktop.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE;$(MSBuildThisFileDirectory)..\NOTICE;$(MSBuildThisFileDirectory)..\THIRD-PARTY-NOTICES.md"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
