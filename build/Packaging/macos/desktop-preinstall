#!/bin/sh
set -e

# C# scripts now run in the built-in tools: remove the retired optional C# scripting
# package and forget its receipt, whichever application installed it.
rm -rf '/Library/Application Support/AI Client/McpCsharp'
pkgutil --pkg-info org.devteam.aiclient.csharpmcp >/dev/null 2>&1 \
    && pkgutil --forget org.devteam.aiclient.csharpmcp >/dev/null 2>&1 || true

executable='/Applications/AI Client.app/Contents/MacOS/AI.Desktop'
pids=$(ps -axww -o pid= -o command= | while read -r pid command; do
    case "$command" in
        "$executable"|"$executable "*) echo "$pid" ;;
    esac
done)
for pid in $pids; do kill -TERM "$pid" 2>/dev/null || true; done

attempt=0
while [ "$attempt" -lt 15 ]; do
    active=''
    for pid in $pids; do
        kill -0 "$pid" 2>/dev/null && active="$active $pid"
    done
    [ -z "$active" ] && exit 0
    sleep 1
    attempt=$((attempt + 1))
done

echo 'AI Client Desktop did not stop; close it and retry.' >&2
exit 1
