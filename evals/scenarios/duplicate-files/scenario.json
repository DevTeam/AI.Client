// A data task with one exact answer that reading the files cannot give: the expected output is in
// expected.txt, generated with the fixture. Nothing requires cs_run; the run shows which tools the model picks.
{
    "id":  "duplicate-files",
    "description":  "Find groups of byte-identical binary files under different names in a nested folder, with same-size and same-name decoys.",
    "tags":  [
                 "data",
                 "script"
             ],
    "turns":  [
                  "My photo folder {workspace}/assets has collected duplicate copies under different names. Find every group of files with byte-identical content and write duplicates.txt in the workspace root: one group per line, the paths relative to assets with forward slashes, separated by single spaces and sorted within the line, and the lines sorted. Do not move, rename or delete anything."
              ],
    "timeoutSeconds":  900,
    "checks":  [
                   {
                       "type":  "fileContains",
                       "name":  "exact result",
                       "path":  "duplicates.txt",
                       "pattern":  "\\A2024/family/IMG_0137\\.jpg\\ 2024/family/IMG_0138\\.jpg\\r?\\n2024/trip-alps/IMG_0140\\.jpg\\ 2025/work/scans/IMG_0141\\.jpg\\ archive/old/IMG_0139\\.jpg\\r?\\n2024/trip-alps/IMG_0143\\.jpg\\ 2025/work/scans/IMG_0142\\.jpg\\ inbox/IMG_0144\\.jpg\\r?\\n2025/work/scans/IMG_0131\\.jpg\\ 2025/work/scans/IMG_0132\\.jpg\\r?\\n2025/work/scans/IMG_0134\\.jpg\\ 2025/work/slides/IMG_0133\\.jpg\\r?\\ninbox/phone/IMG_0135\\.jpg\\ inbox/phone/IMG_0136\\.jpg(\\r?\\n)?\\s*\\z"
                   },
                   {
                       "type":  "onlyChanged",
                       "paths":  [
                                     "duplicates.txt"
                                 ]
                   }
               ]
}
