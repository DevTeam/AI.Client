<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The Web SDK, not the plain one: it is what carries the Blazor UI's static web assets from
    AI.Client.Web into this executable's build and publish output, exactly as for AI.Client.Host.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AI.Client.Mcp.BuiltIn\AI.Client.Mcp.BuiltIn.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\AI.Client.Contracts\AI.Client.Contracts.csproj" />
    <ProjectReference Include="..\AI.Client.Server\AI.Client.Server.csproj" />
    <ProjectReference Include="..\AI.Client.Web\AI.Client.Web.csproj" Aliases="AIClientWeb" />
    <Compile Include="..\AI.Client.Contracts\Composition.cs" Link="Contracts\Composition.cs" />
    <Compile Include="..\AI.Client.Server\Composition.cs" Link="Server\Composition.cs" />
    <Compile Include="..\AI.Client.Server\CommandLine\Composition.cs" Link="Server\CommandLine\Composition.cs" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\app-icon.png" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Pure.DI" PrivateAssets="all" />
    <PackageReference Include="Pure.DI.MS" />
  </ItemGroup>
  <Import Project="..\..\build\McpBuiltIn.targets" />
</Project>
