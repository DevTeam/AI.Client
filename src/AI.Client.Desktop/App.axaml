<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AI.Client.Desktop.App"
             RequestedThemeVariant="Dark">
    <!--
        The drawn titlebar is not a child of the window, so its brushes resolve here, not in
        Window.Resources. Names are the ones Fluent's WindowDrawnDecorations theme looks up.
    -->
    <Application.Resources>
        <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#171717" />
        <SolidColorBrush x:Key="CaptionButtonForeground" Color="#EDF2F7" />
        <SolidColorBrush x:Key="CaptionButtonBackground" Color="#2B2B2B" />
        <SolidColorBrush x:Key="CaptionButtonBorderBrush" Color="#454545" />
        <x:Double x:Key="CaptionButtonWidth">46</x:Double>
        <x:Double x:Key="CaptionButtonHeight">38</x:Double>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
