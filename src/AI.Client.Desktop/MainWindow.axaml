<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AI.Client.Desktop.MainWindow"
        Title="AI Client"
        Width="1400" Height="900"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#171717">
    <Grid>
        <!-- The UI's own index.html shows the loading screen; the dark background avoids a white flash. -->
        <NativeWebView x:Name="WebView" Background="#171717" />
        <!-- A native web view draws above Avalonia content, so this is shown instead of it, never over it. -->
        <Border x:Name="Status" Background="#171717" IsVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="560">
                <TextBlock x:Name="StatusTitle" Text="AI Client" FontSize="18" Foreground="#E5E5E5"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusDetail" Foreground="#A3A3A3" TextWrapping="Wrap" TextAlignment="Center"
                           IsVisible="False" />
                <Button x:Name="Retry" Content="Retry" HorizontalAlignment="Center" IsVisible="False" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
