<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AI.Client.Desktop.MainWindow"
        Title="AI Client"
        Icon="/Assets/app-icon.png"
        Width="1400" Height="900"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="#171717">
    <Window.Styles>
        <Style Selector="Button.caption-button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#EDF2F7" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.caption-button:pointerover">
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="Foreground" Value="#7EB4ED" />
        </Style>
        <Style Selector="Button.caption-button:pressed">
            <Setter Property="Background" Value="#454545" />
        </Style>
        <Style Selector="Button.caption-close:pointerover">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.caption-close:pressed">
            <Setter Property="Background" Value="#A52518" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="38,*">
        <Border Grid.Row="0" Background="#171717" BorderBrush="#292929" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <Border Grid.Column="0" Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="8">
                        <Image Source="/Assets/app-icon.png" Width="20" Height="20" />
                        <TextBlock Text="AI Client" FontSize="12" FontWeight="Medium" Foreground="#EDF2F7"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="Minimize" Classes="caption-button" ToolTip.Tip="Minimize" AutomationProperties.Name="Minimize window"
                            WindowDecorationProperties.ElementRole="User">
                        <Path Data="M4 12H20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" Width="24" Height="24" Stretch="None" />
                    </Button>
                    <Button x:Name="Maximize" Classes="caption-button" ToolTip.Tip="Maximize" AutomationProperties.Name="Maximize window"
                            WindowDecorationProperties.ElementRole="User">
                        <Grid Width="24" Height="24">
                            <Path x:Name="MaximizeGlyph" Data="M5 5H19V19H5Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" />
                            <Path x:Name="RestoreGlyph" Data="M8 5H19V16M5 8H16V19H5Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" IsVisible="False" />
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" Classes="caption-button caption-close" ToolTip.Tip="Close" AutomationProperties.Name="Close window"
                            WindowDecorationProperties.ElementRole="User">
                        <Path Data="M5 5 19 19M19 5 5 19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"
                              Width="24" Height="24" Stretch="None" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <!-- The UI's own index.html shows the loading screen; the dark background avoids a white flash. -->
            <NativeWebView x:Name="WebView" Background="#171717" />
            <!-- A native web view draws above Avalonia content, so this is shown instead of it, never over it. -->
            <Border x:Name="Status" Background="#171717" IsVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="560">
                    <TextBlock x:Name="StatusTitle" Text="AI Client" FontSize="18" Foreground="#E5E5E5"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="StatusDetail" Foreground="#A3A3A3" TextWrapping="Wrap" TextAlignment="Center"
                               IsVisible="False" />
                    <Button x:Name="Retry" Content="Retry" HorizontalAlignment="Center" IsVisible="False" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
