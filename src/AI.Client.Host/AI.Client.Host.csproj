<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\AI.Client.Mcp.BuiltIn\AI.Client.Mcp.BuiltIn.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\AI.Client.Application\AI.Client.Application.csproj" />
    <ProjectReference Include="..\AI.Client.Contracts\AI.Client.Contracts.csproj" />
    <ProjectReference Include="..\AI.Client.Infrastructure\AI.Client.Infrastructure.csproj" />
    <ProjectReference Include="..\AI.Client.Mcp.App\AI.Client.Mcp.App.csproj" />
    <ProjectReference Include="..\AI.Client.Web\AI.Client.Web.csproj"
                      Aliases="AIClientWeb" />
    <Compile Include="..\AI.Client.Contracts\Composition.cs" Link="Contracts\Composition.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Pure.DI" PrivateAssets="all" />
    <PackageReference Include="Pure.DI.MS" />
  </ItemGroup>
  <Target Name="CopyDefaultMcpServer" AfterTargets="Build">
    <ItemGroup><DefaultMcpFiles Include="..\AI.Client.Mcp.BuiltIn\bin\$(Configuration)\$(TargetFramework)\*" /></ItemGroup>
    <Copy SourceFiles="@(DefaultMcpFiles)" DestinationFolder="$(OutDir)mcp" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishDefaultMcpServer" AfterTargets="Publish">
    <MSBuild Projects="..\AI.Client.Mcp.BuiltIn\AI.Client.Mcp.BuiltIn.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(PublishDir)mcp\" />
  </Target>
</Project>
