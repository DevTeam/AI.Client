@using System.Diagnostics.CodeAnalysis
@using System.Text.Json
@using AI.Client.Contracts.Settings
@inject IGlobalSettingsApi GlobalSettingsApi
@inject IConnectionContextLimitsResolver ContextLimits
@inject INotificationService Notifications
@implements IAsyncDisposable

<div class="permissions-drawer-backdrop"></div>
<aside class="permissions-drawer settings-drawer" aria-label="@Section" @onclick:stopPropagation="true">
    <header>
        <div><h2>@(Section == "Connections" ? "Connections" : "MCP")</h2><p>@(Section == "Connections" ? "OpenAI-compatible endpoints available to every project." : "Global MCP servers available to every project.")</p></div>
        <button class="icon-action" type="button" title="Close" aria-label="Close @Section" disabled="@_saving" @onclick="RequestCloseAsync"><AppIcon Name="x" /></button>
    </header>
    <div class="settings-drawer-content">
            @switch (Section)
            {
                case "Connections":
                {
                    <div class="global-editor-layout">
                        <div class="settings-list-column">
                            <nav class="settings-list">@foreach (var connectionItem in _connections) { <div class="settings-list-item @(connectionItem.Id == _selectedConnectionId ? "selected" : string.Empty)"><button class="settings-list-select" type="button" @onclick="() => SelectConnection(connectionItem.Id)"><span>@connectionItem.Name</span><small>@ConnectionStatus(connectionItem)</small></button>@if (connectionItem.Id == _selectedConnectionId) { <button class="icon-action settings-item-remove" type="button" title="Remove connection" aria-label="Remove connection" @onclick="RemoveConnection"><AppIcon Name="trash" /></button> }</div> }</nav>
                            <button class="icon-action settings-list-add" type="button" title="Add connection" aria-label="Add connection" @onclick="AddConnection"><AppIcon Name="plus" /></button>
                        </div>
                        @if (GetSelectedConnection() is { } connection)
                        {
                            <form class="global-form" autocomplete="off" @onsubmit:preventDefault="true"><div class="connection-flags"><label class="checkbox"><input type="checkbox" @bind="connection.Enabled" /> Enabled</label><label class="checkbox"><input type="checkbox" checked="@connection.IsDefault" @onchange="args => SetDefaultConnection(connection.Id, args)" /> Default</label><label class="checkbox"><input type="checkbox" disabled="@(!connection.Enabled)" checked="@connection.ForSubtasks" @onchange="args => SetSubtaskConnection(connection.Id, args)" /> For subtasks</label></div><label>Name<InputText autocomplete="off" @bind-Value="connection.Name" /></label><label>Base URL<input type="url" autocomplete="url" class="text-input" placeholder="https://api.openai.com/v1" @bind="connection.BaseUrl" @bind:event="oninput" @bind:after="() => OnEndpointChanged(connection.Id)" /></label><div class="model-field-row"><div class="model-field"><span>Model</span><ModelPicker @bind-Value="connection.Model" AriaLabel="Model" Models="@(_resolvedModels.TryGetValue(connection.Id, out var list) ? list : null)" Loading="@(_resolvingModelsForId == connection.Id)" Error="@(_resolvedErrors.TryGetValue(connection.Id, out var err) ? err : null)" OnRetry="@(() => LoadModelsIfStaleAsync(connection.Id, force: true))" Placeholder="@ModelPickerPlaceholder(connection)" EmptyHint="@ModelPickerEmptyHint(connection)" /></div>@if (_resolvingModelsForId == connection.Id) { <span class="model-loading" aria-label="Loading models" role="status"><AppIcon Name="spinner" Class="tool-row-spinner" /></span> }</div><div class="connection-ratings"><label>Context window tokens<input type="number" min="1024" max="4000000" step="1" @bind="connection.ContextWindowTokens" /><small>Effective: @EffectiveLimits(connection).ContextWindowTokens (@SourceLabel(EffectiveLimits(connection).ContextWindowSource))</small></label><label>Reserved output tokens<input type="number" min="256" max="1000000" step="1" @bind="connection.ReservedOutputTokens" /><small>Effective: @EffectiveLimits(connection).ReservedOutputTokens (@SourceLabel(EffectiveLimits(connection).ReservedOutputSource))</small></label></div><div class="connection-ratings"><label>Capability<input type="range" min="0" max="5" step="1" @bind="connection.Capability" @bind:event="oninput" /><small>@RatingLabel(connection.Capability, Capabilities)</small></label><label>Cost<input type="range" min="0" max="5" step="1" @bind="connection.Cost" @bind:event="oninput" /><small>@RatingLabel(connection.Cost, Costs)</small></label></div><label>Good for<InputText autocomplete="off" @bind-Value="connection.GoodFor" placeholder="What the ratings cannot say: vision, long context, local" /></label><label>API key<InputText type="password" autocomplete="new-password" @bind-Value="connection.Secret" @bind-Value:after="() => OnEndpointChanged(connection.Id)" placeholder="@(connection.HasCredential ? "Saved; enter to replace" : "Optional")" /></label></form>
                        }
                    </div>
                    break;
                }
                default:
                {
                    <div class="global-editor-layout">
                        <div class="settings-list-column">
                            <nav class="settings-list">@foreach (var serverItem in _globalMcpServers) { <div class="settings-list-item @(serverItem.Id == _selectedMcpServerId ? "selected" : string.Empty)"><button class="settings-list-select" type="button" @onclick="() => _selectedMcpServerId = serverItem.Id"><span>@serverItem.Name</span><small>@serverItem.Transport · @serverItem.Policy</small></button>@if (serverItem.Id == _selectedMcpServerId && !IsHostProvided(serverItem.Id)) { <button class="icon-action settings-item-remove" type="button" title="Remove MCP server" aria-label="Remove MCP server" @onclick="RemoveGlobalMcpServer"><AppIcon Name="trash" /></button> }</div> }</nav>
                            <button class="icon-action settings-list-add" type="button" title="Add MCP server" aria-label="Add MCP server" @onclick="AddGlobalMcpServer"><AppIcon Name="plus" /></button>
                        </div>
                        @if (GetSelectedMcpServer() is { } server)
                        {
                            <form class="global-form" autocomplete="off" @onsubmit:preventDefault="true">
                                <div class="connection-flags"><label class="checkbox"><input type="checkbox" @bind="server.Enabled" /> Enabled</label></div>
                                <label>Name<InputText autocomplete="off" @bind-Value="server.Name" readonly="@IsHostProvided(server.Id)" /></label>
                                <label>Transport<select disabled="@IsHostProvided(server.Id)" @bind="server.Transport"><option>StreamableHttp</option><option>Stdio</option><option>InProcess</option></select></label>
                                <label>Server policy<select @bind="server.Policy"><option>Allow</option><option>Ask</option><option>Deny</option></select></label>
                                @if (IsHostProvided(server.Id))
                                {
                                    <section class="mcp-tool-policies">
                                        <div class="section-heading"><div><h3>Tool defaults</h3><p>Used by every project unless that project has an override.</p></div><button class="secondary-action" type="button" @onclick="DiscoverDefaultToolsAsync">Discover tools</button></div>
                                        @if (_toolPolicies.All(item => item.ServerId != server.Id))
                                        {
                                            <p class="empty-hint">No tools discovered. Unknown tools will ask for approval.</p>
                                        }
                                        @foreach (var policy in _toolPolicies.Where(item => item.ServerId == server.Id))
                                        {
                                            <div class="mcp-tool-policy-row">
                                                <div class="mcp-tool-name"><span>Tool</span><strong title="@policy.SchemaHash">@policy.Name</strong></div>
                                                <label>Policy<select @bind="policy.Decision" aria-label="Policy for @policy.Name"><option>Ask</option><option>Allow</option><option>Deny</option></select></label>
                                                <label>Calls/run<input type="number" min="1" max="2147483647" @bind="policy.MaxCallsPerRun" /></label>
                                                <label>Timeout, sec<input type="number" min="1" max="600" @bind="policy.TimeoutSeconds" /></label>
                                            </div>
                                        }
                                        <p class="mcp-policy-note">Deny disables the server. Otherwise a tool-specific Allow can run without confirmation; unknown tools ask by default.</p>
                                    </section>
                                }
                                else if (server.Transport == "StreamableHttp")
                                {
                                    <label>URL<InputText autocomplete="url" @bind-Value="server.Url" /></label><label>Credential<InputText type="password" autocomplete="new-password" @bind-Value="server.Secret" placeholder="@(server.HasCredential ? "Saved; enter to replace" : "Optional")" /></label>
                                }
                                else
                                {
                                    <label>Command<InputText @bind-Value="server.Command" /></label><label>Arguments<InputText @bind-Value="server.ArgumentsText" placeholder="One argument per line" /></label><label>Working directory<InputText @bind-Value="server.WorkingDirectory" /></label><label>Environment variables<InputTextArea @bind-Value="server.EnvironmentText" placeholder="NAME=value" /></label>
                                }
                            </form>
                        }
                    </div>
                    break;
                }
            }
    </div>
    <footer>
        @if (_saveFailed)
        {
            <span class="settings-drawer-error" role="alert">Not saved. Fix the fields or discard.</span>
            <button class="secondary-action permissions-reset-all" type="button" disabled="@_saving" @onclick="DiscardAndCloseAsync">Discard changes</button>
        }
        else
        {
            <span>@(_saving ? "Saving…" : Stats)</span>
        }
    </footer>
</aside>
@code {
    [Parameter] public string Section { get; set; } = "Connections";
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public EventCallback Close { get; set; }
    private bool _loaded;
    private bool _saving;
    private bool _saveFailed;
    // What was loaded, in the shape that is sent back; closing without edits must not write
    // (and toast) anything, and secrets never appear here, so they are checked separately.
    private string? _loadedSnapshot;
    // Catalogs loaded from the endpoint on demand, keyed by connection id so switching between
    // connections in the left column keeps each one's results visible until the next refresh.
    private readonly Dictionary<Guid, IReadOnlyList<ResolvedModelInfo>> _resolvedModels = [];
    // What the last catalog was loaded for (BaseUrl and typed key), per connection. A load is needed
    // only when the form differs from it; storing it here skips duplicate calls and lets us know to
    // refresh after the user edits the URL or the key.
    private readonly Dictionary<Guid, string> _resolvedEndpoints = [];
    // Last failure per connection, kept so the picker can show why the dropdown is empty and offer
    // a Retry button. Cleared when the next attempt starts so a transient 401 does not linger once
    // the user fixes the key.
    private readonly Dictionary<Guid, string> _resolvedErrors = [];
    private Guid? _resolvingModelsForId;
    // Cancels an in-flight /models request when the user closes the drawer or refreshes again, so
    // the late response cannot leak into a different connection's dropdown.
    private CancellationTokenSource? _resolveCancellation;
    // Debounce for the auto-load: a typing burst into BaseUrl collapses into a single request
    // 350 ms after the last keystroke. The token cancels any pending timer so only the last
    // keystroke's request survives.
    private CancellationTokenSource? _autoLoadDebounce;
    // Connection id the pending debounce belongs to; if the user switches to a different one in the
    // middle of typing, the timer fires and would otherwise load for the old id.
    private Guid _autoLoadDebounceForId;
    // Auto-load latency in milliseconds. Short enough that the dropdown feels responsive after a
    // paste, long enough to skip the per-keystroke churn of typing the URL by hand.
    private const int AutoLoadDebounceMilliseconds = 350;
    private readonly List<ConnectionEditor> _connections = [];
    private readonly List<GlobalMcpServerEditor> _globalMcpServers = [];
    private readonly List<McpToolPolicyEditor> _toolPolicies = [];
    private Guid? _selectedConnectionId;
    private Guid? _selectedMcpServerId;
    protected override Task OnInitializedAsync() => LoadGlobalSettingsAsync();
    private async Task LoadGlobalSettingsAsync()
    {
        var settings = await GlobalSettingsApi.GetAsync(CancellationToken.None);
        _connections.Clear();
        _connections.AddRange(settings.Connections.Select(ConnectionEditor.From));
        _globalMcpServers.Clear();
        _globalMcpServers.AddRange(settings.McpServers.Select(GlobalMcpServerEditor.From));
        _toolPolicies.Clear();
        _toolPolicies.AddRange(settings.ToolPolicies.Select(McpToolPolicyEditor.From));
        // A save reloads, and switching between Connections and MCP saves: keep the selection
        // where it was instead of jumping back to the first item every time.
        if (_connections.All(item => item.Id != _selectedConnectionId)) _selectedConnectionId = _connections.FirstOrDefault()?.Id;
        // The selection may have been just resolved (first open or post-save reload) without going
        // through SelectConnection; kick off the model load here so the catalog is in place by the
        // time the form paints. LoadModelsIfStaleAsync is a no-op when the cache for this BaseUrl
        // is fresh, so a redundant call on a Save-then-keep-selection is free.
        if (_selectedConnectionId is { } autoLoadId) _ = LoadModelsIfStaleAsync(autoLoadId);
        if (_globalMcpServers.All(item => item.Id != _selectedMcpServerId)) _selectedMcpServerId = _globalMcpServers.FirstOrDefault()?.Id;
        _loadedSnapshot = Snapshot();
        _saveFailed = false;
        _loaded = true;
    }

    /// <summary>The footer line, counted the way the permissions drawer counts its overrides.</summary>
    private string Stats => Section == "Connections"
        ? $"{Plural(_connections.Count, "connection")} · {_connections.Count(item => item.Enabled)} enabled"
        : $"{Plural(_globalMcpServers.Count, "server")} · {_globalMcpServers.Count(item => item.Enabled)} enabled · {Plural(_toolPolicies.Count, "tool default")}";

    private static string Plural(int count, string word) => $"{count} {word}{(count == 1 ? string.Empty : "s")}";

    private SaveGlobalSettingsRequest BuildRequest() => new(
        // ReSharper disable once UseCollectionExpression
        _connections.Select(item => item.ToSettings()).ToArray(),
        [.. _globalMcpServers.Select(item => item.ToSettings())],
        [.. _toolPolicies.Select(item => item.ToSettings())]);

    private string Snapshot() => JsonSerializer.Serialize(BuildRequest());

    private bool HasChanges() => Snapshot() != _loadedSnapshot
        || _connections.Any(item => !string.IsNullOrWhiteSpace(item.Secret))
        || _globalMcpServers.Any(item => !string.IsNullOrWhiteSpace(item.Secret));

    /// <summary>
    /// Closing is the save, like the permissions drawer where every change is already applied.
    /// A failed save keeps the drawer open so the edits are not lost; discarding is explicit.
    /// </summary>
    public async Task RequestCloseAsync()
    {
        if (_saving) return;
        if (await SaveAsync()) await Close.InvokeAsync();
    }

    private Task DiscardAndCloseAsync() => Close.InvokeAsync();

    private void AddConnection()
    {
        var connection = new ConnectionEditor();
        _connections.Add(connection);
        _selectedConnectionId = connection.Id;
    }

    private void RemoveConnection()
    {
        if (_selectedConnectionId is not { } id) return;
        _connections.RemoveAll(item => item.Id == id);
        _selectedConnectionId = _connections.FirstOrDefault()?.Id;
    }

    private void SelectConnection(Guid id)
    {
        _selectedConnectionId = id;
        // Switching connections cancels any pending debounce for the previous one — otherwise a
        // typing burst that finished a moment ago could land on the row the user has just left.
        _autoLoadDebounce?.Cancel();
        _autoLoadDebounce?.Dispose();
        _autoLoadDebounce = null;
        // Switching connections is the trigger to load the new one's catalog. The "first show" path
        // (settings drawer just opened) goes through here too: the left column makes the first row
        // selected by default, and that calls SelectConnection with that row's id.
        _ = LoadModelsIfStaleAsync(id);
    }

    private ConnectionEditor? GetSelectedConnection() =>
        _connections.SingleOrDefault(item => item.Id == _selectedConnectionId);

    /// <summary>
    /// Called after the BaseUrl input (per keystroke) and the API key input (on change). Debounces a
    /// typing burst into a single /models request so each keystroke does not fire one. Switching to
    /// a different connection while the timer is pending cancels the in-flight load for the old one.
    /// </summary>
    private void OnEndpointChanged(Guid id)
    {
        _autoLoadDebounce?.Cancel();
        _autoLoadDebounce?.Dispose();
        _autoLoadDebounce = new CancellationTokenSource();
        _autoLoadDebounceForId = id;
        var token = _autoLoadDebounce.Token;
        _ = DebouncedAutoLoadAsync(id, token);
    }

    private async Task DebouncedAutoLoadAsync(Guid id, CancellationToken token)
    {
        try
        {
            await Task.Delay(AutoLoadDebounceMilliseconds, token);
        }
        catch (OperationCanceledException)
        {
            // A newer keystroke or a connection switch superseded this one; nothing to do.
            return;
        }
        if (token.IsCancellationRequested || _autoLoadDebounceForId != id) return;
        await LoadModelsIfStaleAsync(id);
    }

    /// <summary>
    /// Pulls the model catalog for <paramref name="id"/> unless we already have a fresh one for what
    /// the form currently says. Called automatically when the user selects a connection in the left
    /// column and again, debounced, after they edit its BaseUrl or key; those calls show a failure
    /// only inline in the picker, since a toast per typing pause would be noise. Retry passes
    /// <paramref name="force"/>, which also reloads a fresh catalog and raises a toast on failure.
    /// </summary>
    private async Task LoadModelsIfStaleAsync(Guid id, bool force = false)
    {
        var connection = _connections.SingleOrDefault(item => item.Id == id);
        if (connection is null) return;

        var baseUrl = connection.BaseUrl.Trim();
        // Empty BaseUrl: nothing to call, and we should not flash a spinner. Drop the catalog and any
        // error left from a URL the user has since cleared, and stop a request still in flight for it.
        if (baseUrl.Length == 0)
        {
            ForgetModels(id);
            _resolvedErrors.Remove(id);
            await InvokeAsync(StateHasChanged);
            return;
        }

        // A half-typed or mistyped URL never leaves the browser: the Host would only refuse it, and
        // what the user needs to know ("it must start with https://") is known right here.
        if (!IsHttpUrl(baseUrl))
        {
            ForgetModels(id);
            _resolvedErrors[id] = "Base URL must be an absolute HTTP or HTTPS URL, for example https://api.openai.com/v1.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Skip a network round-trip when nothing the catalog depends on has changed since the last
        // successful load. A failure is not "fresh", so the next debounce tick tries again.
        var apiKey = string.IsNullOrWhiteSpace(connection.Secret) ? null : connection.Secret;
        var endpointKey = $"{baseUrl}\n{apiKey}";
        if (!force &&
            _resolvedEndpoints.TryGetValue(id, out var cached) &&
            string.Equals(cached, endpointKey, StringComparison.Ordinal) &&
            _resolvedModels.ContainsKey(id))
        {
            return;
        }

        // Cancel any prior in-flight call so the late response from a previous connection cannot
        // overwrite the one the user is now looking at.
        _resolveCancellation?.Cancel();
        _resolveCancellation?.Dispose();
        _resolveCancellation = new CancellationTokenSource();
        var token = _resolveCancellation.Token;
        _resolvingModelsForId = id;
        _resolvedErrors.Remove(id);
        // Fire-and-forget callers (auto-load on first open, debounced BaseUrl changes) do not give
        // Blazor a task to await, so any state mutation after the network await goes unnoticed and
        // the spinner/datalist never paint. Notify the renderer here, before we yield, so the
        // spinner shows up immediately.
        await InvokeAsync(StateHasChanged);
        try
        {
            var models = await GlobalSettingsApi.GetConnectionModelsAsync(
                id, new ResolveConnectionModelsRequest(baseUrl, apiKey), token);
            _resolvedModels[id] = models;
            // Remember what this catalog came from, captured before the await: the user may have
            // kept typing while the request was in flight, and that newer value is not loaded yet.
            _resolvedEndpoints[id] = endpointKey;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // A newer load or the drawer closing superseded this one; the newer call, if any,
            // populates the dictionaries when it returns, so there is nothing to record here.
        }
        catch (Exception ex)
        {
            // HttpClient's own timeout also surfaces as a cancellation, but not ours; it is a
            // failure like any other. The Host's message already says what went wrong; we add a
            // leading note so the text says what we were trying to do.
            var message = ex is OperationCanceledException
                ? "Could not load models. The Host did not answer in time."
                : $"Could not load models. {ex.Message}";
            _resolvedModels.Remove(id);
            _resolvedEndpoints.Remove(id);
            _resolvedErrors[id] = message;
            if (force) Notifications.ShowError(message);
        }
        finally
        {
            if (_resolvingModelsForId == id && !token.IsCancellationRequested)
            {
                _resolvingModelsForId = null;
            }
            // Repaint so the catalog reaches the DOM and the spinner goes away. Same reasoning as
            // above: callers fire-and-forget this method, so we must explicitly wake the renderer.
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ForgetModels(Guid id)
    {
        _resolvedModels.Remove(id);
        _resolvedEndpoints.Remove(id);
        if (_resolvingModelsForId != id) return;
        _resolveCancellation?.Cancel();
        _resolvingModelsForId = null;
    }

    private static bool IsHttpUrl(string value) =>
        Uri.TryCreate(value, UriKind.Absolute, out var uri) && uri.Scheme is ("http" or "https") && uri.Host.Length > 0;

    /// <summary>Placeholder text for the model picker. The picker is only useful once the user has
    /// typed a Base URL; until then we tell them so rather than promising a catalog that is not
    /// coming.</summary>
    private static string ModelPickerPlaceholder(ConnectionEditor connection) =>
        string.IsNullOrWhiteSpace(connection.BaseUrl)
            ? "Set a Base URL first to load the model catalog"
            : "Model id (type your own or pick from the catalog)";

    /// <summary>What the open dropdown says when it has no models to list.</summary>
    private string ModelPickerEmptyHint(ConnectionEditor connection)
    {
        if (string.IsNullOrWhiteSpace(connection.BaseUrl)) return "Set a Base URL to load the model catalog";
        if (_resolvingModelsForId == connection.Id) return "Loading models…";
        return _resolvedModels.ContainsKey(connection.Id)
            ? "The endpoint lists no models; type the model id"
            : "No models loaded yet";
    }

    public async ValueTask DisposeAsync()
    {
        // The Host keeps the previous request alive if we do not tell it to stop; this can fire
        // a toast into a drawer the user has already closed.
        _resolveCancellation?.Cancel();
        _resolveCancellation?.Dispose();
        // Same reasoning for the debounce timer: a delayed call would fire after the component is
        // gone and overwrite state on a fresh drawer that has already taken its place.
        _autoLoadDebounce?.Cancel();
        _autoLoadDebounce?.Dispose();
        await ValueTask.CompletedTask;
    }

    /// <summary>
    /// What the list says about a connection under its name. Both marks can sit on the same one, so
    /// the line is composed rather than chosen; an unavailable connection wears neither.
    /// </summary>
    private static string ConnectionStatus(ConnectionEditor connection)
    {
        if (!connection.Enabled) return "Unavailable";
        var marks = new List<string>(2);
        if (connection.IsDefault) marks.Add("Default");
        if (connection.ForSubtasks) marks.Add("Subtasks");
        return marks.Count == 0 ? "Enabled" : string.Join(" · ", marks);
    }

    private void SetDefaultConnection(Guid id, ChangeEventArgs args)
    {
        if (args.Value is not true) return;
        foreach (var connection in _connections) connection.IsDefault = connection.Id == id;
    }

    /// <summary>
    /// Unlike the default, which the application always needs exactly one of, this mark is a set:
    /// tick several and a fan-out of subtasks is dealt out over them instead of queueing behind one
    /// provider. Ticking none is also an answer — subtasks then inherit the calling chat's.
    /// </summary>
    private void SetSubtaskConnection(Guid id, ChangeEventArgs args)
    {
        var connection = _connections.SingleOrDefault(item => item.Id == id);
        if (connection is not null) connection.ForSubtasks = args.Value is true;
    }

    private static readonly string[] Capabilities = ["weak", "modest", "solid", "strong", "frontier"];

    private static readonly string[] Costs = ["free", "cheap", "moderate", "pricey", "premium"];

    private static string RatingLabel(int value, string[] words) =>
        value is >= 1 && value <= words.Length ? words[value - 1] : "not rated";

    private ResolvedConnectionContextLimits EffectiveLimits(ConnectionEditor connection) =>
        ContextLimits.Resolve(connection.ToSettings());

    private static string SourceLabel(ContextLimitSource source) => source switch
    {
        ContextLimitSource.Override => "override",
        _ => "default"
    };

    private void AddGlobalMcpServer()
    {
        var server = new GlobalMcpServerEditor();
        _globalMcpServers.Add(server);
        _selectedMcpServerId = server.Id;
    }

    private void RemoveGlobalMcpServer()
    {
        if (_selectedMcpServerId is not { } id) return;
        _globalMcpServers.RemoveAll(item => item.Id == id);
        _toolPolicies.RemoveAll(item => item.ServerId == id);
        _selectedMcpServerId = _globalMcpServers.FirstOrDefault()?.Id;
    }

    private GlobalMcpServerEditor? GetSelectedMcpServer() =>
        _globalMcpServers.SingleOrDefault(item => item.Id == _selectedMcpServerId);

    /// <summary>
    /// A server the Host ships and runs itself. Its name, transport and existence are not the
    /// user's to edit — there is no command line behind it to get wrong — so it shows its tool
    /// defaults where a third-party server shows its process configuration.
    /// </summary>
    private static bool IsHostProvided(Guid id) =>
        id == AI.Client.Contracts.Settings.DefaultMcpServer.Id || id == AI.Client.Contracts.Settings.AppMcpServer.Id;

    private async Task DiscoverDefaultToolsAsync()
    {
        try
        {
            var tools = await GlobalSettingsApi.GetDefaultToolsAsync(CancellationToken.None);
            foreach (var tool in tools)
            {
                var previous = _toolPolicies.SingleOrDefault(item => item.ServerId == tool.ServerId
                    && item.Name == tool.Name && item.SchemaHash == tool.SchemaHash);
                _toolPolicies.RemoveAll(item => item.ServerId == tool.ServerId && item.Name == tool.Name);
                _toolPolicies.Add(previous ?? McpToolPolicyEditor.From(tool));
            }
            if (tools.Count == 0) Notifications.ShowInfo("No tools were found.");
            else Notifications.ShowSuccess($"Discovered {tools.Count} tool(s).");
        }
        catch (HttpRequestException)
        {
            Notifications.ShowError("Could not connect to the default tools server.");
        }
    }

    /// <summary>Saves pending edits; <c>true</c> when there is nothing left unsaved.</summary>
    public async Task<bool> SaveAsync()
    {
        if (!_loaded || !HasChanges()) return true;
        _saving = true;
        StateHasChanged();
        try
        {
            await GlobalSettingsApi.SaveAsync(BuildRequest(), CancellationToken.None);
            foreach (var connection in _connections.Where(item => !string.IsNullOrWhiteSpace(item.Secret)))
                await GlobalSettingsApi.SetConnectionCredentialAsync(connection.Id, connection.Secret, CancellationToken.None);
            foreach (var server in _globalMcpServers.Where(item => !string.IsNullOrWhiteSpace(item.Secret)))
                await GlobalSettingsApi.SetMcpCredentialAsync(server.Id, server.Secret, CancellationToken.None);
            await LoadGlobalSettingsAsync();
            await Saved.InvokeAsync();
            // Same corner toast the rest of the app uses, so "I saved something" always looks the
            // same wherever it happened — global settings, project settings, a chat's endpoint.
            Notifications.ShowSuccess("Settings saved.");
            return true;
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            // A save that fails silently is worse than no toast at all: the previous footer text
            // was easy to miss next to the Save button, and this panel is now the only place where
            // an endpoint's base URL / model / credentials are typed in.
            Notifications.ShowError("Settings were not saved. Check required fields.");
            _saveFailed = true;
            return false;
        }
        finally
        {
            // Home calls this on Escape and on switching sections, outside this component's own
            // event handlers, so nothing else would re-render the footer.
            _saving = false;
            StateHasChanged();
        }
    }

    [SuppressMessage("ReSharper", "PropertyCanBeMadeInitOnly.Local")]
    [SuppressMessage("ReSharper", "MemberCanBePrivate.Local")]
    private sealed class ConnectionEditor
    {
        public Guid Id { get; set; } = Guid.CreateVersion7();
        public string Name { get; set; } = "OpenAI connection";
        public string BaseUrl { get; set; } = string.Empty;
        public string Model { get; set; } = string.Empty;
        public bool Enabled { get; set; } = true;
        public bool IsDefault { get; set; }
        public bool ForSubtasks { get; set; }
        public int Capability { get; set; }
        public int Cost { get; set; }
        public string GoodFor { get; set; } = string.Empty;
        public long? ContextWindowTokens { get; set; }
        public long? ReservedOutputTokens { get; set; }
        public bool HasCredential { get; set; }
        public string? Secret { get; set; }

        public static ConnectionEditor From(ConnectionSettings item) => new()
        {
            Id = item.Id, Name = item.Name, BaseUrl = item.BaseUrl, Model = item.Model,
            Enabled = item.Enabled, IsDefault = item.IsDefault, HasCredential = item.HasCredential,
            ForSubtasks = item.ForSubtasks, Capability = item.Capability ?? 0, Cost = item.Cost ?? 0,
            GoodFor = item.GoodFor ?? string.Empty,
            ContextWindowTokens = item.ContextWindowTokens,
            ReservedOutputTokens = item.ReservedOutputTokens
        };

        public ConnectionSettings ToSettings() =>
            // Zero is how a range input says "nobody has rated this"; it travels as absence.
            new(Id, Name, BaseUrl, Model, Enabled, IsDefault, HasCredential, ForSubtasks,
                Capability == 0 ? null : Capability, Cost == 0 ? null : Cost,
                string.IsNullOrWhiteSpace(GoodFor) ? null : GoodFor,
                ContextWindowTokens, ReservedOutputTokens);
    }

    [SuppressMessage("ReSharper", "PropertyCanBeMadeInitOnly.Local")]
    [SuppressMessage("ReSharper", "MemberCanBePrivate.Local")]
    private sealed class GlobalMcpServerEditor
    {
        public Guid Id { get; set; } = Guid.CreateVersion7();
        public string Name { get; set; } = "MCP server";
        public string Transport { get; set; } = "StreamableHttp";
        public bool Enabled { get; set; } = true;
        public string Policy { get; set; } = "Ask";
        public string? Url { get; set; }
        public string? Command { get; set; }
        public string ArgumentsText { get; set; } = string.Empty;
        public string? WorkingDirectory { get; set; }
        public string EnvironmentText { get; set; } = string.Empty;
        public bool HasCredential { get; set; }
        public string? Secret { get; set; }

        public static GlobalMcpServerEditor From(AI.Client.Contracts.Settings.McpServerSettings item) => new()
        {
            Id = item.Id, Name = item.Name, Transport = item.Transport, Enabled = item.Enabled,
            Policy = item.Policy, Url = item.Url, Command = item.Command,
            ArgumentsText = string.Join(Environment.NewLine, item.Arguments),
            WorkingDirectory = item.WorkingDirectory,
            EnvironmentText = string.Join(Environment.NewLine, item.EnvironmentVariables.Select(variable =>
                variable.IsSecret ? $"secret:{variable.Name}=" : $"{variable.Name}={variable.Value}")),
            HasCredential = item.HasCredential
        };

        public AI.Client.Contracts.Settings.McpServerSettings ToSettings() => new(
            Id, Name, Transport, Enabled, Policy, Url, Command,
            ArgumentsText.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
            WorkingDirectory,
            EnvironmentText.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(line => line.Split('=', 2))
                .Where(parts => parts.Length == 2)
                .Select(parts => new McpEnvironmentVariableSettings(
                    parts[0].StartsWith("secret:", StringComparison.OrdinalIgnoreCase) ? parts[0][7..] : parts[0],
                    parts[1],
                    parts[0].StartsWith("secret:", StringComparison.OrdinalIgnoreCase),
                    // ReSharper disable once UseCollectionExpression
                    false)).ToArray(),
            HasCredential);
    }

