@* Split out of Home.razor so that typing in the composer doesn't re-render the whole message
   list: Blazor only re-renders a child component if ShouldRender() says so, so this component
   can be skipped entirely on renders where none of its parameters actually changed (see
   ShouldRender below). Without this boundary, every keystroke in the composer (which lives in
   Home and calls StateHasChanged on the whole page) also rebuilt and diffed this list. *@
@inject IMarkdownRenderer MarkdownRenderer
@inject IJSRuntime JsRuntime
@inject AI.Client.Web.Runs.IChatRunsApi RunsApi
@implements IAsyncDisposable
@using AI.Client.Contracts.Tools

<div class="messages-area">
@if (SelectedChat is not null)
{
    <nav class="history-markers" aria-hidden="true" @ref="_historyMarkers">
        @{
            var forkPoints = GetForkPointIds();
            var historyEntries = BuildHistoryEntries(GetVisibleBranchMessages(), forkPoints);
        }
        @for (var index = 0; index < historyEntries.Count; index++)
        {
            var entry = historyEntries[index];
            var isLast = index == historyEntries.Count - 1 && SelectedRun is not { Status: ChatRunStatus.Generating };
            <button class="history-marker @GetHistoryMarkerClass(entry, isLast)" type="button" tabindex="-1"
                    data-target="message-@entry.Question.Id"
                    data-question-html="@RenderMarkdownCached(entry.Question.Id, entry.Question.Content)"
                    data-answer-html="@(entry.Answer is { } answer ? RenderMarkdownCached(answer.Id, answer.Content) : string.Empty)"
                    data-fork="@(entry.HasFork ? "true" : string.Empty)"
                    data-created="@entry.Question.CreatedAt.ToString("o")"></button>
        }
        @if (SelectedRun is { Status: ChatRunStatus.Generating })
        {
            <button class="history-marker history-marker-assistant history-marker-generating" type="button" tabindex="-1" data-target="message-streaming" data-question-html="Generating&hellip;" data-answer-html="" data-fork=""></button>
        }
    </nav>
    <div class="history-marker-tip" role="tooltip" aria-hidden="true"></div>
    <div class="history-scroll-hint history-scroll-hint-up" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 14 5-5 5 5" /></svg></div>
    <div class="history-scroll-hint history-scroll-hint-down" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 10 5 5 5-5" /></svg></div>
}
<div class="workspace-messages" @ref="_messagesContainer">
    @if (!HasSelectedProject)
    {
        <div class="workspace-empty"><h2>Select a project</h2><p>Choose a project on the left or create a new one.</p></div>
    }
    else if (SelectedChat is null)
    {
        <div class="workspace-empty"><h2>Start a conversation</h2><p>Write a message below. A new chat will be created automatically.</p></div>
    }
    else
    {
        RenderFragment<ChatMessageView> renderBranchPicker = pickerMessage =>
        @<text>
                @if (GetBranchOptions(pickerMessage).Count > 1 || ForkSourceId == pickerMessage.Id)
                {
                    <div class="message-branch-indicator" @onkeydown="args => OnBranchPickerKeyDown.InvokeAsync(args)">
                        <span class="branch-connector" aria-hidden="true"></span>
                        @if (ForkSourceId == pickerMessage.Id)
                        {
                            <span class="branch-pending" title="The branch will be created after you send its first message"><AppIcon Name="git-branch" /><span>New branch</span></span>
                        }
                        else
                        {
                            var options = GetBranchOptions(pickerMessage);
                            <button class="branch-picker-trigger" type="button" title="Choose branch" aria-label="Choose branch" aria-expanded="@(MessageBranchMenuId == pickerMessage.Id ? "true" : "false")" @onclick="() => OnToggleBranchMenu.InvokeAsync(pickerMessage.Id)"><AppIcon Name="git-branch" /><span>Branch @GetActiveBranchPosition(options) of @options.Count</span></button>
                            @if (MessageBranchMenuId == pickerMessage.Id)
                            {
                                <span class="branch-picker-menu" role="menu">
                                    @foreach (var option in options)
                                    {
                                        var selected = IsMessageInActiveBranch(option.Id);
                                        var optionRun = GetOptionRun(option);
                                        <button class="@(selected ? "selected" : string.Empty)" type="button" role="menuitem" title="@(optionRun is null ? GetBranchOptionTitle(option) : $"{GetBranchOptionTitle(option)} · {RunStatusPresentation.GetStatusTooltip(optionRun)}")" @onclick="() => OnSelectBranch.InvokeAsync(option.Id)">@if (selected) { <AppIcon Name="check" /> } else { <span class="branch-option-spacer"></span> }<span class="status-dot @GetOptionStatusClass(option)"></span><span class="branch-option-label">@GetBranchOptionTitle(option)</span></button>
                                    }
                                </span>
                            }
                        }
                    </div>
                }
            </text>;
        @foreach (var item in ChatFeed.BuildFeedItems(GetVisibleBranchMessages()))
        {
            @if (item.Message is { } message)
            {
                <article @key="message.Id" id="message-@message.Id" class="workspace-message @message.Role.ToLowerInvariant() @(message.Id == BranchLeafId ? "branch-leaf" : string.Empty) @(message.Id == ForkSourceId ? "fork-source" : string.Empty)">
                    @if (message.IsIncomplete) { <span class="message-status">Incomplete</span> }
                    <div class="markdown-content">@((MarkupString)RenderMarkdownCached(message.Id, message.Content))</div>
                    <div class="message-actions">
                        <button class="icon-action" type="button" title="Copy Markdown" aria-label="Copy Markdown" @onclick="() => OnCopyMessage.InvokeAsync(message.Content)"><AppIcon Name="copy" /></button>
                        <button class="icon-action" type="button" title="@(IsActiveBranchLeaf(message) ? "This is already the end of the current branch" : "Fork from here")" aria-label="Fork from here" disabled="@IsActiveBranchLeaf(message)" @onclick="() => OnForkFromMessage.InvokeAsync(message)"><AppIcon Name="fork" /></button>
                        @if (message.Role == "User") { <button class="icon-action" type="button" title="Edit and branch" aria-label="Edit and branch" @onclick="() => OnEditAndBranch.InvokeAsync(message)"><AppIcon Name="edit" /></button><button class="icon-action destructive-action" type="button" title="@(IsBranchGenerating() ? "Can't replace while a response is being generated on this branch" : "Edit and replace branch")" aria-label="Edit and replace branch" disabled="@IsBranchGenerating()" @onclick="() => OnEditAndReplaceBranch.InvokeAsync(message)"><AppIcon Name="edit-replace" /></button> }
                    </div>
                    @renderBranchPicker(message)
                </article>
            }
            else if (item.ToolGroup is { } group)
            {
                var anchor = group[^1];
                var preamble = ChatFeed.PreambleOf(group);
                @* One block per cycle: the assistant's explanation, then the tools it announced.
                   They were two articles with a boundary between them, which read as unrelated
                   cards; together they read as intent followed by actions. The preamble needs no
                   id of its own here — the block already has the anchor's. *@
                <article @key="anchor.Id" id="message-@anchor.Id" class="workspace-message tool-group @(anchor.Id == BranchLeafId ? "branch-leaf" : string.Empty) @(anchor.Id == ForkSourceId ? "fork-source" : string.Empty)">
                    @if (preamble is not null)
                    {
                        @if (preamble.IsIncomplete) { <span class="message-status">Incomplete</span> }
                        <div class="markdown-content preamble-content">@((MarkupString)RenderMarkdownCached(preamble.Id, preamble.Content))</div>
                    }
                    <ToolActivityGroup Group="group" IsLive="@(IsBranchGenerating() && anchor.Id == BranchLeafId)" />
                    <div class="message-actions">
                        <button class="icon-action" type="button" title="Copy" aria-label="Copy" @onclick="() => OnCopyMessage.InvokeAsync(BuildToolGroupSummaryText(group))"><AppIcon Name="copy" /></button>
                        <button class="icon-action" type="button" title="@(IsActiveBranchLeaf(anchor) ? "This is already the end of the current branch" : "Fork from here")" aria-label="Fork from here" disabled="@IsActiveBranchLeaf(anchor)" @onclick="() => OnForkFromMessage.InvokeAsync(anchor)"><AppIcon Name="fork" /></button>
                    </div>
                    @renderBranchPicker(anchor)
                </article>
            }
        }
        @if (SelectedRun is { PendingApproval: { } approval } approvalRun)
        {
            <section class="tool-approval" role="region" aria-label="Tool approval">
                <strong>Allow @approval.Name?</strong>
                <pre>@approval.Arguments</pre>
                <p>Timeout: @approval.TimeoutSeconds seconds. The process runs with your account's permissions; the working directory is not a sandbox.</p>
                <div class="tool-approval-actions">
                    <button class="secondary-action" type="button" disabled="@(_decidingApproval == approval.Id)" @onclick="() => DecideToolAsync(approvalRun, approval.Id, ToolApprovalAction.Deny)">Deny</button>
                    <button type="button" disabled="@(_decidingApproval == approval.Id)" @onclick="() => DecideToolAsync(approvalRun, approval.Id, ToolApprovalAction.Allow)">Allow</button>
                    <details class="tool-approval-more">
                        <summary class="icon-action" aria-label="More allow options"><AppIcon Name="chevron-down" /></summary>
                        <div class="tool-approval-menu">
                            <button type="button" @onclick="() => DecideToolAsync(approvalRun, approval.Id, ToolApprovalAction.AllowForChat)"><strong>Allow for this chat</strong><span>Remember in @SelectedChat?.Title</span></button>
                            <button type="button" @onclick="() => DecideToolAsync(approvalRun, approval.Id, ToolApprovalAction.AllowForProject)"><strong>Allow for this project</strong><span>Use in every chat in this project</span></button>
                            @if (_confirmGlobalApprovalId == approval.Id)
                            {
                                <div class="tool-approval-global-confirm"><span>Allow <code>@approval.Name</code> in every project?</span><div><button class="secondary-action" type="button" @onclick="CancelGlobalApproval">Cancel</button><button type="button" @onclick="() => DecideToolAsync(approvalRun, approval.Id, ToolApprovalAction.AllowGlobally)">Always allow</button></div></div>
                            }
                            else
                            {
                                <button type="button" @onclick="() => BeginGlobalApproval(approval.Id)"><strong>Always allow this tool</strong><span>Apply to every project</span></button>
                            }
                        </div>
                    </details>
                </div>
                @if (_approvalError is not null) { <p role="alert">@_approvalError</p> }
            </section>
        }
        @if (SelectedRun?.ActiveTools is { Count: > 0 } activeTools)
        {
            @* aria-live is on the live region only: settled history must never be re-announced,
               and the same call is described by the same adapters that will describe it in the
               transcript a moment later, so the wording does not change when it lands. *@
            <div class="tool-activity tool-activity-live" role="status" aria-live="polite">
                @foreach (var active in activeTools)
                {
                    var call = ToolPresentations.Default.DescribeCall(active.Name, active.Arguments);
                    <div class="tool-row" @key="active.CallId">
                        <span class="tool-row-glyph" aria-hidden="true"><AppIcon Name="spinner" Class="tool-row-spinner" /></span>
                        <span class="tool-row-title">@call.Title</span>
                        @if (call.Detail is { Length: > 0 } detail) { <span class="tool-row-detail" title="@detail">@detail</span> }
                        <span class="tool-row-meta">@(FormatProgress(active) ?? "Running…")</span>
                    </div>
                }
            </div>
        }
        @if (SelectedRun is { Status: ChatRunStatus.Generating } activeRun && !string.IsNullOrEmpty(activeRun.StreamingContent))
        {
            <article id="message-streaming" class="workspace-message assistant streaming"><div class="markdown-content">@((MarkupString)MarkdownRenderer.Render(activeRun.StreamingContent))</div></article>
        }
        @* Last in the transcript, so it lands with the final answer: the aggregate describes the
           whole turn, and reading it before the answer would be reading the receipt first. *@
        <WorkspaceChanges Changes="@SelectedRun?.WorkspaceChanges" />
    }
</div>
</div>

@code {
    // Progress is whatever the server chose to report, verbatim: a fraction when it gave a total,
    // a bare count when it did not, and nothing at all when it said nothing — never an invented
    // percentage.
    private static string? FormatProgress(ActiveToolInvocation active)
    {
        if (active.Message is { Length: > 0 } message) return message;
        if (active.Progress is not { } progress) return null;
        return active.Total is { } total and > 0
            ? $"{progress / total:P0}"
            : progress.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    }

    // Copy yields the raw calls and results, not the rendered summaries: someone copying tool
    // activity wants the payload to paste into a bug report, not the UI's wording of it. The
    // preamble leads, because the block is one thing on screen and should be one thing on the
    // clipboard.
    private static string BuildToolGroupSummaryText(IReadOnlyList<ChatMessageView> group)
    {
        var parts = ChatFeed.BuildInvocations(group).Select(invocation =>
            $"{invocation.Call.Name}({invocation.Call.Arguments})"
            + (invocation.Result is { } result ? $"\n=> {result.Content}" : string.Empty));
        if (ChatFeed.PreambleOf(group) is { } preamble) parts = parts.Prepend(preamble.Content);
        return string.Join("\n\n", parts);
    }

    private Guid? _decidingApproval;
    private Guid? _confirmGlobalApprovalId;
    private string? _approvalError;
    private void BeginGlobalApproval(Guid approvalId)
    {
        _confirmGlobalApprovalId = approvalId;
        _renderedSelectedRun = null;
    }

    private void CancelGlobalApproval()
    {
        _confirmGlobalApprovalId = null;
        _renderedSelectedRun = null;
    }
    private async Task DecideToolAsync(ChatRunSnapshot run, Guid approvalId, ToolApprovalAction action)
    {
        _decidingApproval = approvalId;
        _renderedSelectedRun = null;
        _approvalError = null;
        _confirmGlobalApprovalId = null;
        try { await RunsApi.DecideToolAsync(run.ProjectId, run.ChatId, run.BranchId, new ToolApprovalDecision(approvalId, action), CancellationToken.None); }
        catch (HttpRequestException) { _approvalError = "This approval is no longer available. Refresh the chat."; }
        finally { _decidingApproval = null; }
        _renderedSelectedRun = null;
    }
    [Parameter] public bool HasSelectedProject { get; set; }
    [Parameter] public ChatDetails? SelectedChat { get; set; }
    [Parameter] public Guid? BranchLeafId { get; set; }
    [Parameter] public Guid? ForkSourceId { get; set; }
    [Parameter] public Guid? MessageBranchMenuId { get; set; }
    [Parameter] public ChatRunSnapshot? SelectedRun { get; set; }
    /// <summary>
    /// Looks up the run governing an arbitrary message's branch — given ANY message id (not
    /// necessarily a fork root), resolves to whichever run actually covers it (its own run if
    /// it's a fork root, or an ancestor's) and returns that run. Used to show a status dot per
    /// option in the branch picker, for branches other than the currently active one (which
    /// already has its own run available via <see cref="SelectedRun"/>).
    /// </summary>
    [Parameter] public Func<Guid, ChatRunSnapshot?>? GetRunForBranch { get; set; }
    [Parameter] public EventCallback<string> OnCopyMessage { get; set; }
    [Parameter] public EventCallback<ChatMessageView> OnForkFromMessage { get; set; }
    [Parameter] public EventCallback<ChatMessageView> OnEditAndBranch { get; set; }
    [Parameter] public EventCallback<ChatMessageView> OnEditAndReplaceBranch { get; set; }
    [Parameter] public EventCallback<Guid> OnToggleBranchMenu { get; set; }
    [Parameter] public EventCallback<Guid> OnSelectBranch { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnBranchPickerKeyDown { get; set; }

    private ElementReference _historyMarkers;
    private ElementReference _messagesContainer;
    private IJSObjectReference? _historyMarkersModule;
    private IJSObjectReference? _historyMarkersHandle;
    private IJSObjectReference? _scrollModule;
    private int _historyMarkerCount = -1;
    private bool _disposed;

    // Everything above is set by Home on every one of its renders (i.e. on every composer
    // keystroke), since Blazor always calls SetParametersAsync on a child regardless of whether
    // the values actually changed. ShouldRender is what turns "parameters were reassigned" into
    // "parameters actually changed" — without it, this component would rebuild and diff its own
    // render tree (the whole message list) just as often as before the split.
    private ChatDetails? _renderedSelectedChat;
    private Guid? _renderedBranchLeafId;
    private Guid? _renderedForkSourceId;
    private Guid? _renderedMessageBranchMenuId;
    private ChatRunSnapshot? _renderedSelectedRun;
    private bool _renderedHasSelectedProject;

    protected override bool ShouldRender()
    {
        var changed = !ReferenceEquals(_renderedSelectedChat, SelectedChat)
            || _renderedBranchLeafId != BranchLeafId
            || _renderedForkSourceId != ForkSourceId
            || _renderedMessageBranchMenuId != MessageBranchMenuId
            || !ReferenceEquals(_renderedSelectedRun, SelectedRun)
            || _renderedHasSelectedProject != HasSelectedProject;

        _renderedSelectedChat = SelectedChat;
        _renderedBranchLeafId = BranchLeafId;
        _renderedForkSourceId = ForkSourceId;
        _renderedMessageBranchMenuId = MessageBranchMenuId;
        _renderedSelectedRun = SelectedRun;
        _renderedHasSelectedProject = HasSelectedProject;

        return changed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;

        if (firstRender)
        {
            try
            {
                _historyMarkersModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/historyMarkers.js");
                _scrollModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/chatComposer.js");
            }
            catch (Exception error) when (error is JSException or ObjectDisposedException)
            {
                _historyMarkersModule = null;
            }
        }

        await SyncHistoryMarkersAsync();
    }

    public async Task ScrollToBottomAsync()
    {
        var module = _scrollModule;
        if (_disposed || module is null) return;
        try
        {
            await module.InvokeVoidAsync("scrollToBottom", _messagesContainer);
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
            // The parent can request a scroll while this feed is being replaced by a settings view.
        }
    }

    // Restores the last-viewed message for `key` (as persisted by historyMarkers.js while the
    // user scrolls), falling back to the bottom of the feed when there's nothing saved for it
    // yet (a chat/branch never viewed before) — same default as the old unconditional
    // scroll-to-bottom this replaced.
    public async Task RestoreScrollPositionAsync(string key)
    {
        var module = _historyMarkersModule;
        if (_disposed) return;
        if (module is null)
        {
            await ScrollToBottomAsync();
            return;
        }
        try
        {
            var restored = await module.InvokeAsync<bool>("restoreScrollPosition", _messagesContainer, key);
            if (!restored) await ScrollToBottomAsync();
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
            await ScrollToBottomAsync();
        }
    }

    // Identifies the (chat, branch) pair whose scroll position historyMarkers.js should persist
    // while attached — null while no chat is open (nothing to track).
    private string? GetScrollKey() => SelectedChat is null ? null : $"{SelectedChat.Id}:{BranchLeafId}";

    // The strip is attached only while a chat is open, and re-measured whenever the number of
    // markers changes: the marker elements themselves are re-created by Blazor on every such change.
    private async Task SyncHistoryMarkersAsync()
    {
        if (_disposed || _historyMarkersModule is null) return;

        if (SelectedChat is null)
        {
            await DisposeHistoryMarkersAsync();
            _historyMarkerCount = -1;
            return;
        }

        var count = GetVisibleBranchMessages().Count;
        if (_historyMarkersHandle is not null && count == _historyMarkerCount) return;

        _historyMarkerCount = count;
        await DisposeHistoryMarkersAsync();
        try
        {
            _historyMarkersHandle = await _historyMarkersModule.InvokeAsync<IJSObjectReference>("attach", _historyMarkers, _messagesContainer, GetScrollKey());
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
            _historyMarkersHandle = null;
        }
    }

    private async Task DisposeHistoryMarkersAsync()
    {
        if (_historyMarkersHandle is null) return;
        try
        {
            await _historyMarkersHandle.InvokeVoidAsync("dispose");
            await _historyMarkersHandle.DisposeAsync();
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
        }
        _historyMarkersHandle = null;
    }

    // _selectedChat is always replaced wholesale rather than mutated, so a reference check on it
    // (plus the branch leaf) is a cheap, correct invalidation key for the message chain, the
    // fork-point set, and the per-message sibling lookup used by the branch picker.
    private object? _branchCacheChat;
    private Guid? _branchCacheBranchLeafId;
    private IReadOnlyList<ChatMessageView> _branchCacheMessages = [];
    private Dictionary<Guid, List<ChatMessageView>> _branchCacheChildrenByParent = [];
    private HashSet<Guid> _branchCacheForkPoints = [];

    private void EnsureBranchCache()
    {
        if (ReferenceEquals(_branchCacheChat, SelectedChat) && _branchCacheBranchLeafId == BranchLeafId)
        {
            return;
        }

        // _markdownCache is keyed by message id and never shrinks on its own — switching chats
        // never revisits an old message's id, so without this it would hold every message ever
        // viewed for the lifetime of the component (this component is never recreated; Home keeps
        // a single instance across chat switches). Pruning to the newly selected chat's own
        // messages whenever the CHAT reference changes (not just the branch leaf, so switching
        // branches within the same chat keeps its cache) bounds the cache to
        // one chat's worth of messages.
        if (!ReferenceEquals(_branchCacheChat, SelectedChat))
        {
            PruneMessageCaches();
        }

        _branchCacheChat = SelectedChat;
        _branchCacheBranchLeafId = BranchLeafId;
        _branchCacheMessages = ComputeVisibleBranchMessages();

        var childrenByParent = new Dictionary<Guid, List<ChatMessageView>>();
        if (SelectedChat is not null)
        {
            foreach (var item in SelectedChat.Messages)
            {
                if (item.ParentId is not { } parentId) continue;
                if (!childrenByParent.TryGetValue(parentId, out var siblings))
                {
                    siblings = [];
                    childrenByParent[parentId] = siblings;
                }
                siblings.Add(item);
            }
            foreach (var siblings in childrenByParent.Values)
            {
                siblings.Sort((a, b) => a.CreatedAt.CompareTo(b.CreatedAt));
            }
        }
        _branchCacheChildrenByParent = childrenByParent;
        _branchCacheForkPoints = childrenByParent
            .Where(pair => pair.Value.Count > 1)
            .Select(pair => pair.Key)
            // ReSharper disable once UseCollectionExpression
            .ToHashSet();
    }

    private IReadOnlyList<ChatMessageView> GetVisibleBranchMessages()
    {
        EnsureBranchCache();
        return _branchCacheMessages;
    }

    private IReadOnlyList<ChatMessageView> ComputeVisibleBranchMessages()
    {
        if (SelectedChat is null || BranchLeafId is null)
        {
            return SelectedChat?.Messages.OrderBy(item => item.CreatedAt).ToArray() ?? [];
        }

        var byId = SelectedChat.Messages.ToDictionary(item => item.Id);
        var branch = new List<ChatMessageView>();
        var currentId = BranchLeafId;
        while (currentId is { } messageId && byId.TryGetValue(messageId, out var message))
        {
            branch.Add(message);
            currentId = message.ParentId;
        }

        branch.Reverse();
        return branch;
    }

    private HashSet<Guid> GetForkPointIds()
    {
        EnsureBranchCache();
        return _branchCacheForkPoints;
    }

    private List<ChatMessageView> GetBranchOptions(ChatMessageView message)
    {
        EnsureBranchCache();
        return _branchCacheChildrenByParent.TryGetValue(message.Id, out var options) ? options : [];
    }

    // The strip only shows the user's own questions (see BuildHistoryEntries), so every marker in
    // the loop is "history-marker-user" — brightness-by-role no longer distinguishes anything
    // there. Only the separate trailing "Generating" marker still uses history-marker-assistant.
    private readonly record struct HistoryEntry(ChatMessageView Question, ChatMessageView? Answer, bool HasFork);

    // chain is the full branch (user + assistant, root to leaf); a question's answer is simply
    // the next message in the chain when that next message is the assistant's reply to it.
    private static List<HistoryEntry> BuildHistoryEntries(IReadOnlyList<ChatMessageView> chain, HashSet<Guid> forkPoints)
    {
        var entries = new List<HistoryEntry>();
        for (var index = 0; index < chain.Count; index++)
        {
            if (chain[index].Role != "User") continue;
            ChatMessageView? answer = null;
            var hasFork = forkPoints.Contains(chain[index].Id);
            for (var next = index + 1; next < chain.Count && chain[next].Role != "User"; next++)
            {
                hasFork |= forkPoints.Contains(chain[next].Id);
                if (chain[next].Role == "Assistant" && chain[next].ToolCalls is not { Count: > 0 }) answer = chain[next];
            }
            entries.Add(new HistoryEntry(chain[index], answer, hasFork));
        }
        return entries;
    }

    private string GetHistoryMarkerClass(HistoryEntry entry, bool isLast)
    {
        var classes = new List<string>(3) { "history-marker-user" };

        if (entry.HasFork)
        {
            classes.Add("history-marker-fork");
        }

        // Only IsIncomplete is per-message; the run status describes the branch as a whole, so it
        // can only be attributed to the last question's answer, not the question itself.
        if (entry.Answer is { IsIncomplete: true })
        {
            classes.Add("history-marker-incomplete");
        }
        else if (isLast && SelectedRun is { } run)
        {
            switch (run.Status)
            {
                case ChatRunStatus.Failed:
                    classes.Add("history-marker-failed");
                    break;
                case ChatRunStatus.Interrupted or ChatRunStatus.Paused:
                    classes.Add("history-marker-incomplete");
                    break;
                default:
                {
                    if (run.HasUnreadResponse) classes.Add("history-marker-unread");
                    break;
                }
            }
        }

        return string.Join(' ', classes);
    }

    private bool IsActiveBranchLeaf(ChatMessageView message) => message.Id == BranchLeafId;

    // Every message rendered here is an ancestor of BranchLeafId, i.e. part of the same branch
    // SelectedRun tracks — so "is this branch generating" is a single check, not per-message.
    private bool IsBranchGenerating() => SelectedRun?.Status == ChatRunStatus.Generating;

    private readonly Dictionary<Guid, (string Content, string Html)> _markdownCache = [];

    // Markdig + HtmlSanitizer are not cheap; caching by message id means a re-render only
    // re-parses messages whose content actually changed (in practice, just the one being edited).
    private string RenderMarkdownCached(Guid messageId, string content)
    {
        if (_markdownCache.TryGetValue(messageId, out var cached) && cached.Content == content)
        {
            return cached.Html;
        }
        var html = MarkdownRenderer.Render(content);
        _markdownCache[messageId] = (content, html);
        return html;
    }

    private static string GetMessagePreview(string content)
    {
        var text = content.ReplaceLineEndings(" ").Trim();
        return text[..Math.Min(text.Length, 36)] + (text.Length > 36 ? "…" : string.Empty);
    }

    private void PruneMessageCaches()
    {
        var liveIds = SelectedChat?.Messages.Select(message => message.Id).ToHashSet() ?? [];
        foreach (var key in _markdownCache.Keys.Where(id => !liveIds.Contains(id)).ToList())
        {
            _markdownCache.Remove(key);
        }
    }

    private string GetBranchOptionTitle(ChatMessageView sibling)
    {
        var siblings = SelectedChat?.Messages
            .Where(message => message.ParentId == sibling.ParentId)
            .OrderBy(message => message.CreatedAt)
            .ToArray() ?? [];
        if (siblings.Length > 0 && siblings[0].Id == sibling.Id)
        {
            return sibling.Role == "Assistant" ? "Original response" : "Original message";
        }

        return GetMessagePreview(sibling.Content);
    }

    // GetRunForBranch resolves any option's message id to its actual governing run branch
    // (walking up to the nearest fork-root ancestor, or the chat's own id — see
    // BranchLeafHelpers.RunBranchIdFor). For the currently active option specifically,
    // SelectedRun already IS that exact run, so we use it directly rather than resolving from
    // scratch — same result, cheaper.
    private ChatRunSnapshot? GetOptionRun(ChatMessageView option) =>
        IsMessageInActiveBranch(option.Id) ? SelectedRun : GetRunForBranch?.Invoke(option.Id);

    private string GetOptionStatusClass(ChatMessageView option) => RunStatusPresentation.GetStatusClass(GetOptionRun(option));

    private bool IsMessageInActiveBranch(Guid messageId)
    {
        if (SelectedChat is null || BranchLeafId is not { } leafId) return false;
        var byId = SelectedChat.Messages.ToDictionary(message => message.Id);
        var current = leafId;
        while (byId.TryGetValue(current, out var message))
        {
            if (current == messageId) return true;
            if (message.ParentId is not { } parentId) break;
            current = parentId;
        }
        return false;
    }

    private int GetActiveBranchPosition(IReadOnlyList<ChatMessageView> options)
    {
        var index = options.ToList().FindIndex(option => IsMessageInActiveBranch(option.Id));
        return index < 0 ? 1 : index + 1;
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        await DisposeHistoryMarkersAsync();
        var historyMarkersModule = _historyMarkersModule;
        var scrollModule = _scrollModule;
        _historyMarkersModule = null;
        _scrollModule = null;
        try
        {
            if (historyMarkersModule is not null) await historyMarkersModule.DisposeAsync();
            if (scrollModule is not null) await scrollModule.DisposeAsync();
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
        }
    }
}
