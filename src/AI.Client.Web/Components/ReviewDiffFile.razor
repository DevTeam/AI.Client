@using AI.Client.Contracts.Resources
@using AI.Client.Contracts.Workspace
@using AI.Client.Web.Resources
@using Microsoft.AspNetCore.Components.Web
@inject IReviewApi ReviewsApi
@inject IUnifiedDiffParser DiffParser

<div class="review-diff-content">
    @if (SourceMessageId != Guid.Empty)
    {
        <button class="review-file-comment-action" type="button" @onclick="BeginFileComment">Comment on file</button>
    }
    @if (DiffParser.Parse(File.Diff) is { Count: > 0 } lines)
    {
        @foreach (var line in lines.Take(MaxLines))
        {
            <WorkspaceDiffLine Line="@line" ReviewMode="@(SourceMessageId != Guid.Empty)"
                               OnComment="args => BeginLineComment(line, args.ShiftKey)" />
            @if (line.Kind is not (DiffLineKind.Hunk or DiffLineKind.Note))
            {
                @foreach (var comment in CommentsAt(line)) { @CommentCard(comment) }
                @if (_editingCommentId is null && PendingEndsAt(line)) { @CommentEditor() }
            }
        }
        @if (lines.Count > MaxLines) { <div class="diff-note">… @(lines.Count - MaxLines) more lines not shown</div> }
    }
    else { <p class="workspace-change-unavailable">@UnavailableReason(File)</p> }
    @foreach (var comment in (_current?.Comments ?? []).Where(item => item.Path == File.Path && item.OldStart is null && item.NewStart is null))
    { @CommentCard(comment) }
    @if (_editingCommentId is null && _pending && _pendingOldStart is null && _pendingNewStart is null) { @CommentEditor() }
    @if (_error is not null) { <p class="review-error" role="alert">@_error</p> }
</div>

@code {
    [Parameter, EditorRequired] public FileChange File { get; set; } = default!;
    [Parameter] public IReadOnlyList<FileChange> SourceFiles { get; set; } = [];
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid ChatId { get; set; }
    [Parameter] public Guid SourceMessageId { get; set; }
    [Parameter] public ChatReview? Review { get; set; }
    [Parameter] public EventCallback<ChatReview> OnChanged { get; set; }
    [Parameter] public int MaxLines { get; set; } = 1500;

    private ChatReview? _current;
    private Guid? _editingCommentId;
    private int? _pendingOldStart, _pendingOldEnd, _pendingNewStart, _pendingNewEnd;
    private string _commentBody = string.Empty;
    private ElementReference _commentEditor;
    private bool _focusCommentEditor;
    private (int? Old, int? New)? _rangeStart;
    private string? _error;
    private bool _pending, _saving;

    protected override void OnParametersSet()
    {
        if (Review is not null && (_current is null || Review.Revision >= _current.Revision)) _current = Review;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusCommentEditor || !_pending) return;
        _focusCommentEditor = false;
        await _commentEditor.FocusAsync();
    }

    private void BeginFileComment() => BeginComment(null, null);

    private void BeginLineComment(DiffLine line, bool shift)
    {
        var oldLine = line.Kind == DiffLineKind.Removed ? line.OldLine : null;
        var newLine = line.Kind == DiffLineKind.Removed ? null : line.NewLine;
        if (shift && _rangeStart is { } start
            && (start.Old is not null && oldLine is not null || start.New is not null && newLine is not null))
        {
            BeginComment(oldLine is null ? null : Math.Min(start.Old!.Value, oldLine.Value),
                newLine is null ? null : Math.Min(start.New!.Value, newLine.Value));
            _pendingOldEnd = oldLine is null ? null : Math.Max(start.Old!.Value, oldLine.Value);
            _pendingNewEnd = newLine is null ? null : Math.Max(start.New!.Value, newLine.Value);
        }
        else
        {
            BeginComment(oldLine, newLine);
            _rangeStart = (oldLine, newLine);
        }
    }

    private void BeginComment(int? oldLine, int? newLine)
    {
        _editingCommentId = null;
        _pending = true;
        _pendingOldStart = _pendingOldEnd = oldLine;
        _pendingNewStart = _pendingNewEnd = newLine;
        _commentBody = string.Empty;
        _error = null;
        _focusCommentEditor = true;
    }

    private bool PendingEndsAt(DiffLine line) => _pending &&
        (_pendingOldEnd is { } oldLine && line.OldLine == oldLine && line.Kind == DiffLineKind.Removed
         || _pendingNewEnd is { } newLine && line.NewLine == newLine && line.Kind != DiffLineKind.Removed);

    private IReadOnlyList<ReviewComment> CommentsAt(DiffLine line) => (_current?.Comments ?? [])
        .Where(item => item.Path == File.Path && (line.Kind == DiffLineKind.Removed
            ? item.OldEnd == line.OldLine && item.NewStart is null
            : item.NewEnd == line.NewLine && item.OldStart is null)).ToArray();

    private RenderFragment CommentCard(ReviewComment comment) => @<div class="review-comment" @key="comment.Id">
        @if (_editingCommentId == comment.Id) { @CommentEditor() }
        else
        {
            <button class="review-comment-body" type="button" title="Edit comment" aria-label="Edit comment" @onclick="() => EditComment(comment)">@comment.Body</button>
            <div><button class="secondary-action compact-action" type="button" @onclick="() => EditComment(comment)">Edit</button>
                <button class="secondary-action compact-action" type="button" @onclick="() => DeleteCommentAsync(comment)">Delete</button></div>
        }
    </div>;

    private RenderFragment CommentEditor() => @<div class="review-comment-editor" @onkeydown="HandleCommentKeyDown">
        <textarea @ref="_commentEditor" aria-label="Review comment" value="@_commentBody" @oninput="e => _commentBody = e.Value?.ToString() ?? string.Empty"></textarea>
        <div><button type="button" disabled="@(_saving || string.IsNullOrWhiteSpace(_commentBody))" @onclick="SaveCommentAsync">Save comment</button>
            <button class="secondary-action compact-action" type="button" @onclick="CancelComment">Cancel</button></div>
    </div>;

    private void EditComment(ReviewComment comment)
    {
        _editingCommentId = comment.Id;
        _pending = true;
        _pendingOldStart = comment.OldStart; _pendingOldEnd = comment.OldEnd;
        _pendingNewStart = comment.NewStart; _pendingNewEnd = comment.NewEnd;
        _commentBody = comment.Body;
        _focusCommentEditor = true;
    }

    private void HandleCommentKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CancelComment();
    }

    private void CancelComment()
    {
        _editingCommentId = null;
        _pending = false;
        _pendingOldStart = _pendingOldEnd = _pendingNewStart = _pendingNewEnd = null;
        _rangeStart = null;
        _focusCommentEditor = false;
        _commentBody = string.Empty;
        _error = null;
    }

    private async Task SaveCommentAsync()
    {
        if (!_pending || string.IsNullOrWhiteSpace(_commentBody) || _saving) return;
        var comment = new ReviewComment(_editingCommentId ?? Guid.CreateVersion7(), File.Path,
            _pendingOldStart, _pendingOldEnd, _pendingNewStart, _pendingNewEnd, _commentBody.Trim());
        _saving = true;
        try
        {
            if (_current is null)
            {
                if (SourceMessageId == Guid.Empty || SourceFiles.Count == 0) return;
                _current = await ReviewsApi.CreateAsync(ProjectId, ChatId,
                    new CreateReviewRequest(SourceMessageId, $"Review {DateTime.Now:g}",
                        SourceFiles.Select(item => item.Path).ToArray()), CancellationToken.None);
                await OnChanged.InvokeAsync(_current);
            }
            var files = _current.Files.Contains(File.Path, StringComparer.Ordinal)
                ? _current.Files : _current.Files.Append(File.Path).ToArray();
            _current = await ReviewsApi.UpdateAsync(ProjectId, ChatId, _current.Id,
                new UpdateReviewRequest(_current.Name, files,
                    _current.Comments.Where(item => item.Id != comment.Id).Append(comment).ToArray(),
                    _current.Revision), CancellationToken.None);
            _error = null;
            CancelComment();
            await OnChanged.InvokeAsync(_current);
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException or ArgumentException)
        {
            _error = error.Message;
        }
        finally { _saving = false; }
    }

    private async Task DeleteCommentAsync(ReviewComment comment)
    {
        if (_current is null || _saving) return;
        _saving = true;
        try
        {
            _current = await ReviewsApi.UpdateAsync(ProjectId, ChatId, _current.Id,
                new UpdateReviewRequest(_current.Name, _current.Files,
                    _current.Comments.Where(item => item.Id != comment.Id).ToArray(), _current.Revision),
                CancellationToken.None);
            _error = null;
            CancelComment();
            await OnChanged.InvokeAsync(_current);
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException or ArgumentException)
        {
            _error = error.Message;
        }
        finally { _saving = false; }
    }

    private static string UnavailableReason(FileChange file) => file switch
    {
        { IsBinary: true } => "Binary file — there are no lines to compare.",
        { Kind: FileChangeKind.Deleted } => "The file was deleted; its former contents are not kept.",
        { Confidence: FileChangeConfidence.Approximate } => "Exact line differences were not available for this file.",
        _ => "No differences were recorded for this file.",
    };
}
