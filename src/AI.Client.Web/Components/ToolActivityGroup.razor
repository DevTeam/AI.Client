@* One run of tool activity, rendered as calm compact rows rather than a wall of JSON.

   Every label here is derived deterministically from the call name, its arguments and its actual
   result (see ToolPresentations) — never from a second model call, and never counted from
   anything the Host did not observe. Raw arguments and bulk output stay out of the DOM until a
   row is expanded, so a 10MB stdout costs nothing to scroll past. *@
@using AI.Client.Contracts.Tools
@inject IToolPresentations Presentations
@inject IToolResultCodec ToolResultCodec

<div class="tool-activity">
    @{
        var invocations = ChatFeed.BuildInvocations(Group);
        TrackArrivals(invocations);
        var failed = invocations.Count(item => item.Result is not null && Describe(item).Severity == ToolResultSeverity.Error);
        var unfinished = invocations.Count(item => item.Result is null);
        var pending = IsLive ? unfinished : 0;
    }
    @* Always one summary line, always collapsed — including for a single call. Folding used to
       depend on how many calls there were and whether any failed, which made the transcript's
       shape unpredictable: one failure expanded seven unrelated successes alongside it. The
       structure is now fixed and the outcome shows in the summary instead. *@
    <details class="tool-activity-batch @(failed > 0 ? "tool-row-failed" : string.Empty)" open="@_batchExpanded">
        <summary class="tool-row" @onclick="ToggleBatch" @onclick:preventDefault="true">
            <span class="tool-row-glyph" aria-hidden="true">
                @if (pending > 0) { <AppIcon Name="spinner" Class="tool-row-spinner" /> }
                else if (failed > 0) { <AppIcon Name="error" /> }
                else { <AppIcon Name="check" /> }
            </span>
            <span class="tool-row-title">@(pending > 0 ? "Running tools" : "Tools finished")</span>
            <span class="tool-row-detail">@invocations.Count @(invocations.Count == 1 ? "tool call" : "tool calls")@(pending == 0 && unfinished > 0 ? $" · {unfinished} without a result" : string.Empty)</span>
            @* The failure count travels with the duration as one trailing group, pinned to the
               right edge. Kept apart they could be laid out separately, which is how a failed
               group ended up stacked over three lines. The count, not just a colour: a collapsed
               group has to say how much went wrong before anyone decides whether to open it. *@
            <span class="tool-row-meta">
                @if (failed > 0) { <span class="tool-row-failure-count">@failed failed</span> }
                @FormatDuration(TotalDuration(invocations))
            </span>
        </summary>
        @if (_batchExpanded)
        {
            <div class="tool-activity-rows">
                @foreach (var invocation in invocations) { @RenderRow(invocation) }
            </div>
        }
    </details>
</div>

@code {
    [Parameter] [EditorRequired] public IReadOnlyList<ChatMessageView> Group { get; set; } = [];

    /// <summary>
    /// Whether this group belongs to a run that is still going. A call with no result is only
    /// "running" while that is true; in settled history the same shape means the run ended before
    /// the result was recorded, and showing it as a spinner forever would be a lie.
    /// </summary>
    [Parameter] public bool IsLive { get; set; }

    private bool _batchExpanded;
    private void ToggleBatch() => _batchExpanded = !_batchExpanded;

    private RenderFragment RenderRow(ChatFeed.ToolInvocation invocation) => @<text>
        @{
            var call = Presentations.DescribeCall(invocation.Call.Name, invocation.Call.Arguments);
            var running = invocation.Result is null && IsLive;
            var abandoned = invocation.Result is null && !IsLive;
            var result = invocation.Result is null ? null : Describe(invocation);
            var severity = abandoned
                ? ToolResultSeverity.Warning
                : result?.Severity ?? ToolResultSeverity.Ok;
            // Every row starts collapsed, failures included. A failure used to open itself, which
            // made a batch jump around as results landed and buried the rows either side of it in
            // output nobody asked for; the row's icon, severity colour and summary already say it
            // failed, and opening it is the user's call.
            var open = _expanded.Contains(invocation.Call.Id);
            // Set only for a row that showed up while the group was already on screen (see
            // TrackArrivals); its value staggers the row against the others that landed with it.
            var arriving = _arriving.TryGetValue(invocation.Call.Id, out var index) ? index : (int?)null;
        }
        <details class="tool-row-item @SeverityClass(severity) @(arriving is null ? string.Empty : "tool-row-arriving") @(_resolved.Contains(invocation.Call.Id) ? "tool-row-resolved" : string.Empty)"
                 style="@(arriving is { } order ? $"--arrive-index: {order}" : null)"
                 open="@open">
            <summary class="tool-row" @onclick="() => Toggle(invocation.Call.Id)" @onclick:preventDefault="true">
                <span class="tool-row-glyph" aria-hidden="true">
                    @if (running) { <AppIcon Name="spinner" Class="tool-row-spinner" /> }
                    else if (severity == ToolResultSeverity.Error) { <AppIcon Name="error" /> }
                    else if (abandoned) { <AppIcon Name="interrupted" /> }
                    else { <AppIcon Name="check" /> }
                </span>
                <span class="tool-row-title">@call.Title</span>
                @if (call.Detail is { Length: > 0 } detail)
                {
                    <span class="tool-row-detail" title="@detail">@detail</span>
                }
                @if (SafetyLabel(call.Safety) is { } safety)
                {
                    <span class="tool-row-safety">@safety</span>
                }
                <span class="tool-row-meta">
                    @if (result is not null) { @result.Summary }
                    else if (abandoned) { <span>No result recorded</span> }
                    @if (FormatDuration(invocation.Duration) is { } elapsed) { <span class="tool-row-elapsed">@elapsed</span> }
                </span>
            </summary>
            @if (open)
            {
            <div class="tool-row-body">
                @if (result is { Facts.Count: > 0 })
                {
                    <dl class="tool-row-facts">
                        @foreach (var fact in result.Facts)
                        {
                            <dt>@fact.Label</dt>
                            <dd>@fact.Value</dd>
                        }
                    </dl>
                }
                @if (FormatArguments(invocation.Call.Arguments) is { Length: > 0 } arguments)
                {
                    <pre class="tool-row-args">@arguments</pre>
                }
                @if (result?.Body is { Length: > 0 } body)
                {
                    <pre class="tool-row-output @(result.BodyFormat == ToolBodyFormat.Diff ? "tool-row-diff" : string.Empty)">@body</pre>
                }
                else if (running)
                {
                    <p class="tool-row-running">Waiting for the result…</p>
                }
                else if (abandoned)
                {
                    <p class="tool-row-running">The run ended before this call reported back. Its effects may still have happened.</p>
                }
            </div>
            }
        </details>
    </text>;

    // Which rows the user opened, by call id. Nothing else opens a row, so one set is enough —
    // there is no default-open state left to remember an override for.
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);

    private void Toggle(string id)
    {
        if (!_expanded.Remove(id)) _expanded.Add(id);
    }

    // Calls this group has rendered at least once, so a row can tell "just arrived" from "was
    // always here". Without it the first render of an old group would animate every row at once.
    private readonly HashSet<string> _known = new(StringComparer.Ordinal);

    // The arrivals that earned an entry animation, each with its position within the batch it
    // landed in. A CSS animation only plays when the element enters the DOM, so the marks are
    // never cleared: dropping one on a later render would cut the animation off mid-flight, and
    // keeping it costs one dictionary entry per call.
    private readonly Dictionary<string, int> _arriving = new(StringComparer.Ordinal);

    // Calls seen without a result that later got one, i.e. the ones whose row changed under the
    // user's eyes from spinner to outcome. Only those cross-fade; a row rendered as finished from
    // the start has nothing to fade between.
    private readonly HashSet<string> _pending = new(StringComparer.Ordinal);
    private readonly HashSet<string> _resolved = new(StringComparer.Ordinal);

    private bool _primed;

    /// <summary>
    /// Notes which calls are new since the previous render. Runs on every render, collapsed group
    /// included: a call that lands while the group is folded is absorbed silently, so unfolding it
    /// later shows a settled list instead of replaying a cascade the user never watched happen.
    /// </summary>
    private void TrackArrivals(IReadOnlyList<ChatFeed.ToolInvocation> invocations)
    {
        var batch = 0;
        foreach (var invocation in invocations)
        {
            var id = invocation.Call.Id;
            // A group's very first render is the baseline, never an arrival — it is transcript
            // that was already there, whether it was written a second or a week ago.
            if (_known.Add(id) && _primed && _batchExpanded) _arriving[id] = batch++;
            if (invocation.Result is null)
            {
                if (IsLive) _pending.Add(id);
            }
            else if (_pending.Remove(id))
            {
                _resolved.Add(id);
            }
        }
        _primed = true;
    }

    // Parsing a result and describing it is not free — a single process_run can carry megabytes of
    // stdout — and Blazor re-renders this subtree whenever the run snapshot changes. Results are
    // immutable once written, so the message id is a sound cache key.
    private readonly Dictionary<Guid, ToolResultPresentation> _described = [];

    private ToolResultPresentation Describe(ChatFeed.ToolInvocation invocation)
    {
        if (invocation.Result is not { } message) return EmptyResult;
        if (_described.TryGetValue(message.Id, out var cached)) return cached;
        var described = Presentations.DescribeResult(
            invocation.Call.Name, invocation.Call.Arguments, ToolResultCodec.Read(message.Content));
        _described[message.Id] = described;
        return described;
    }

    private static readonly ToolResultPresentation EmptyResult = new("", ToolResultSeverity.Ok, [], null);

    /// <summary>Sums only what was actually observed; an unfinished call contributes nothing.</summary>
    private static TimeSpan? TotalDuration(IReadOnlyList<ChatFeed.ToolInvocation> invocations)
    {
        var total = TimeSpan.Zero;
        var any = false;
        foreach (var invocation in invocations)
        {
            if (invocation.Duration is not { } duration) continue;
            total += duration;
            any = true;
        }
        return any ? total : null;
    }

    private static string? FormatDuration(TimeSpan? duration) => duration switch
    {
        null => null,
        { TotalSeconds: < 1 } value => $"{value.TotalMilliseconds:F0} ms",
        { TotalSeconds: < 60 } value => $"{value.TotalSeconds:F1} s",
        { } value => $"{(int)value.TotalMinutes}m {value.Seconds}s",
    };

    // Only the two states worth a badge. "Mutating" is the unremarkable default for anything that
    // writes, and Unknown means the server said nothing — neither earns visual weight.
    private static string? SafetyLabel(ToolSafety safety) => safety switch
    {
        ToolSafety.Destructive => "destructive",
        _ => null,
    };

    private static string SeverityClass(ToolResultSeverity severity) => severity switch
    {
        ToolResultSeverity.Error => "tool-row-failed",
        ToolResultSeverity.Warning => "tool-row-warned",
        _ => string.Empty,
    };

    // Renders a call's JSON arguments as "param: value" lines instead of raw JSON, so the common
    // case (a flat object of scalar args) reads like a short form rather than a payload.
    private static string FormatArguments(string arguments)
    {
        if (ToolPresentations.ParseArguments(arguments) is not { } input) return arguments;
        if (input.ValueKind != System.Text.Json.JsonValueKind.Object) return arguments;
        var properties = input.EnumerateObject().ToList();
        if (properties.Count == 0) return string.Empty;
        return string.Join("\n", properties.Select(property => $"{property.Name}: {FormatArgumentValue(property.Value)}"));
    }

    private static string FormatArgumentValue(System.Text.Json.JsonElement value) => value.ValueKind switch
    {
        System.Text.Json.JsonValueKind.String => value.GetString() ?? string.Empty,
        System.Text.Json.JsonValueKind.Null => "null",
        _ => value.GetRawText(),
    };
}
