    private async Task SaveProjectTitleAsync(ProjectSummary project)
    {
        if (_editingProjectId != project.Id || _isCompletingInlineEdit) return;
        if (string.IsNullOrWhiteSpace(_editingTitle)) { CancelInlineEdit(); return; }
        _isCompletingInlineEdit = true;
        try
        {
            var details = await ProjectApi.GetAsync(project.Id, CancellationToken.None);
            if (details is null) return;
            var result = await ProjectApi.UpdateAsync(project.Id, new UpdateProjectRequest(_editingTitle.Trim(), details.Description, details.Revision, details.ConnectionId), CancellationToken.None);
            if (result.Status == ProjectUpdateStatus.Updated) await LoadProjectsAsync(project.Id);
        }
        finally { _isCompletingInlineEdit = false; CancelInlineEdit(); }
    }

