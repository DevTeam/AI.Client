    private async Task DeleteBranchAsync(BranchTreeItem branch)
    {
        if (_selectedProject is null || _selectedChat is null) return;
        var result = await ChatHistoryApi.DeleteBranchAsync(_selectedProject.Id, _selectedChat.Id, branch.RootId, _selectedChat.Revision, CancellationToken.None);
        if (!result.IsDeleted) { ShowToast("Branch was not deleted. Reload the chat and try again.", "error"); return; }
        _selectedChat = await ChatHistoryApi.GetAsync(_selectedProject.Id, _selectedChat.Id, CancellationToken.None);
        _selectedBranchId = result.ParentBranchId ?? _selectedChat?.Id;
        _branchLeafId = result.ParentHeadMessageId
            ?? _selectedChat?.Branches?.SingleOrDefault(item => item.Id == _selectedBranchId)?.HeadMessageId;
        _branchMenuId = null;
        await LoadChatsAsync(_selectedProject.Id);
    }

    private object? _branchTreeCacheChat;
    private IReadOnlyList<BranchTreeItem> _branchTreeCache = [];

    private IReadOnlyList<BranchTreeItem> GetBranchTreeItems()
    {
        if (ReferenceEquals(_branchTreeCacheChat, _selectedChat))
        {
            return _branchTreeCache;
        }
        _branchTreeCacheChat = _selectedChat;
        _branchTreeCache = ComputeBranchTreeItems();
        return _branchTreeCache;
    }

    private IReadOnlyList<BranchTreeItem> ComputeBranchTreeItems()
    {
        if (_selectedChat is null) return [];
        var branches = _selectedChat.Branches ?? [];
        return branches.Where(branch => branch.Id != _selectedChat.Id && branch.HeadMessageId is not null)
            // ReSharper disable once UseCollectionExpression
            .Select(branch => new BranchTreeItem(branch.Id, branch.Title, GetBranchDepth(branch, branches), branch.HeadMessageId!.Value)).ToArray();
    }

    private static int GetBranchDepth(ChatBranchView branch, IReadOnlyList<ChatBranchView> branches)
    {
        var depth = 1;
        var visited = new HashSet<Guid> { branch.Id };
        while (branch.ParentBranchId is { } id && visited.Add(id) && branches.FirstOrDefault(item => item.Id == id) is { } parent)
        {
            if (parent.ParentBranchId is not null) depth++;
            branch = parent;
        }
        return depth;
    }

    private static Guid? GetOriginalBranchLeaf(ChatDetails? chat) =>
        chat?.Branches?.SingleOrDefault(branch => branch.Id == chat.Id)?.HeadMessageId;

    private async Task SelectBranchTreeItemAsync(BranchTreeItem branch)
    {
