    // The sidebar shows one page of chats at a time: a long-lived project accumulates dozens of
    // them and the directory/settings groups below the list get pushed off-screen otherwise.
    private const int ChatPageSize = 10;
    private int _visibleChatCount = ChatPageSize;
    // The project whose chats _visibleChatCount belongs to, so a background refresh of the same
    // project keeps the pages the user opened while switching projects starts over at one page.
    private Guid? _chatPagingProjectId;

    // The open chat is never paged away: it carries the branch tree and the selection highlight,
    // and losing it from the list would make the sidebar disagree with the transcript on screen.
    private int GetVisibleChatCount(IReadOnlyList<ChatSummary> orderedChats)
    {
        var count = Math.Min(_visibleChatCount, orderedChats.Count);
        if (_selectedChat is { } selected)
        {
            for (var index = count; index < orderedChats.Count; index++)
            {
                if (orderedChats[index].Id == selected.Id) return index + 1;
            }
        }

        return count;
    }

    // A run that finished (or wants approval) below the fold would otherwise be invisible, so the
    // count rides on the "Show more" button the same way the branch count rides on a chat row.
    private int CountHiddenChatsNeedingAttention(IReadOnlyList<ChatSummary> orderedChats, int visibleChatCount) =>
        orderedChats.Skip(visibleChatCount).Count(chat => RunState.Runs.Values.Any(run => run.ChatId == chat.Id && IsVisibleRun(run)));

    private void ShowMoreChats() => _visibleChatCount = GetVisibleChatCount(GetOrderedChats()) + ChatPageSize;

    private void ShowFewerChats() => _visibleChatCount = ChatPageSize;

    private static string GetShowMoreChatsLabel(int hiddenChatCount, int hiddenChatAttention) =>
        hiddenChatAttention > 0
            ? $"Show {hiddenChatCount} more chats, {GetHiddenAttentionTitle(hiddenChatAttention)}"
            : $"Show {hiddenChatCount} more chats";

    private static string GetHiddenAttentionTitle(int hiddenChatAttention) =>
        hiddenChatAttention == 1 ? "1 hidden chat needs attention" : $"{hiddenChatAttention} hidden chats need attention";

    // The same git-branch glyph the history-marker tooltip already uses for this fact, and the
    // count form of its "Has branches" wording, so "this chat has alternatives" reads the same
    // in both places. Pluralised explicitly: "1 branches" in a tooltip looks like a bug.
    private static string GetBranchCountTitle(int branchCount) =>
        branchCount == 1 ? "1 branch" : $"{branchCount} branches";

    private static string FormatBranchCount(int branchCount) => branchCount > 9 ? "9+" : branchCount.ToString();

