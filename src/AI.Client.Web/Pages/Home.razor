    private string GetComposerHint()
    {
        if (_selectedProject is null) return "Select a project";
        if (string.IsNullOrWhiteSpace(_chat.BaseUrl) || string.IsNullOrWhiteSpace(_chat.Model)) return "Select or configure an endpoint";
        var baseHint = _selectedChat is null ? "A new chat will be created on send" : "Continuing selected chat";
        // Mirror the modifier-to-action mapping in chatComposer.js so the hint above the
        // textarea and the Enter-key behaviour always agree on what will happen on press. The
        // Paused/Interrupted/Failed statuses never reach this method — the composer-status markup
        // shows its own status text for those instead (see GetHeldRunEnterHint for their Enter
        // hint suffix).
        if (_composerAltDown && _composerCtrlDown) return $"{baseHint} · fork on Enter";
        return _composerCtrlDown ? $"{baseHint} · queue on Enter" : baseHint;
    }

    private string GetHeldRunEnterHint(ChatRunSnapshot run)
    {
        if (run.Status == ChatRunStatus.Failed && !run.CanRetry) return " · choose rebase, skip, or clear queue";
        if (_composerAltDown && _composerCtrlDown) return " · fork on Enter, starts immediately";
        if (_composerCtrlDown) return " · queue on Enter, stays paused";
        return run.Queue.Count > 0 ? " · resume queue and send on Enter" : " · resume and send on Enter";
    }

