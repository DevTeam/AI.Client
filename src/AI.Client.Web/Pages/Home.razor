    private async Task DeleteChatAsync(ChatSummary chat)
    {
        if (_selectedProject is null) return;
        foreach (var run in RunState.Runs.Values.Where(item => item.ChatId == chat.Id).ToArray())
        {
            if (run.Status == ChatRunStatus.Generating) await ChatRunsApi.StopAsync(_selectedProject.Id, chat.Id, run.BranchId, Guid.CreateVersion7(), CancellationToken.None);
            await ChatRunsApi.ClearAsync(_selectedProject.Id, chat.Id, run.BranchId, Guid.CreateVersion7(), CancellationToken.None);
        }
        var result = await ChatHistoryApi.DeleteAsync(_selectedProject.Id, chat.Id, chat.Revision, CancellationToken.None);
        if (!result.IsDeleted)
        {
            _chatError = "The chat changed elsewhere. Reload it before deleting.";
            CloseContextMenus();
            return;
        }

        if (_selectedChat?.Id == chat.Id)
        {
            _selectedChat = null;
        _selectedBranchId = null;
            _branchLeafId = null;
            _chat.Message = string.Empty;
            _composerNeedsResize = true;
        }

        CloseContextMenus();
        await LoadChatsAsync(_selectedProject.Id);
        ShowToast("Chat deleted.", "success");
    }

