    public async ValueTask DisposeAsync()
    {
        _projectsBusy?.Dispose();
        _chatsBusy?.Dispose();
        await _generatingTickerCancellation.CancelAsync();
        _generatingTickerCancellation.Dispose();

        if (_toastCancellation is not null)
        {
            await _toastCancellation.CancelAsync();
            _toastCancellation.Dispose();
        }

        if (_justArrivedLeafCancellation is not null)
        {
            await _justArrivedLeafCancellation.CancelAsync();
            _justArrivedLeafCancellation.Dispose();
        }

        await DisposeComposerHandleAsync();

        if (_composerModule is not null)
        {
            await _composerModule.DisposeAsync();
        }

        if (_inlineEditorModule is not null)
        {
            await _inlineEditorModule.DisposeAsync();
        }

        if (_runEventsSubscription is not null) { await _runEventsSubscription.InvokeVoidAsync("dispose"); await _runEventsSubscription.DisposeAsync(); }
        if (_focusSubscription is not null) { await _focusSubscription.InvokeVoidAsync("dispose"); await _focusSubscription.DisposeAsync(); }
        if (_queueDragSubscription is not null) { await _queueDragSubscription.InvokeVoidAsync("dispose"); await _queueDragSubscription.DisposeAsync(); }
        if (_runEventsModule is not null) await _runEventsModule.DisposeAsync();

        _dotNetReference?.Dispose();
        await WorkspaceLayoutService.DisposeAsync();
    }
