    private async Task SubmitComposerAsync(ComposerSubmitMode mode)
    {
        if (_isSubmittingMessage || !CanSendMessage()) return;

        _isSubmittingMessage = true;
        _chatError = null;
        ComposerSubmitOutcome.Accepted? pendingUiUpdate = null;
        try
        {
            // _branchLeafId already points at the replace target's parent by the time we get
            // here (set in EditAndReplaceBranchAsync), so GetSelectedRun() here re-checks the
            // branch the replacement will actually land on, not the one the replaced message
            // originally lived on — re-validating against a race is the whole point.
            var replaceSourceIsGenerating = _replaceSourceId is not null && GetSelectedRun()?.Status == ChatRunStatus.Generating;
            var request = new ComposerSubmitRequest(
                mode,
                _selectedProject?.Id,
                _selectedChat,
                _branchLeafId,
                _forkSourceId,
                _replaceSourceId,
                replaceSourceIsGenerating,
                _chat.CredentialProfileId,
                _chat.BaseUrl,
                _chat.Model,
                _chat.Message,
                GetSelectedRun(),
                _selectedChat is null ? null : GetSelectedRunBranchId());

            var outcome = await Composer.SubmitAsync(request, CancellationToken.None);

            switch (outcome)
            {
                case ComposerSubmitOutcome.Rejected rejected:
                    _chatError = rejected.Reason;
                    return;
                case ComposerSubmitOutcome.Accepted accepted:
                    // ApplyAcceptedRunState runs (and StoreRun completes) BEFORE the guard is
                    // released in `finally` below — that's what makes GetSelectedRun() see this
                    // message's queue entry before a second, fast Ctrl+Enter can read the run
                    // cache. An earlier version of this guard released right after SubmitAsync
                    // returned but before StoreRun ran, leaving exactly that window open: two
                    // Ctrl+Enter presses in quick succession could both compute their enqueue
                    // anchor off the SAME stale (pre-StoreRun) run, silently forking the branch
                    // instead of queuing sequentially.
                    //
                    // FinishAcceptedUiUpdatesAsync (JS interop, sidebar refresh) is deliberately
                    // NOT awaited here, inside the guard — a subsequent fix held the guard
                    // through that too and it round-trips a real LoadChatsAsync network call,
                    // which was slow enough that a THIRD rapid Ctrl+Enter got silently dropped
                    // by the `_isSubmittingMessage` check above instead of being queued. None of
                    // that work affects what the next submission's GetSelectedRun() sees, so it
                    // runs after the guard drops.
                    ApplyAcceptedRunState(accepted);
                    pendingUiUpdate = accepted;
                    break;
            }
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _chatError = "The endpoint did not accept the request. Verify the base URL, model, and API key.";
            return;
        }
        finally
        {
            _isSubmittingMessage = false;
        }

        if (pendingUiUpdate is not null)
        {
            await FinishAcceptedUiUpdatesAsync(pendingUiUpdate);
        }
    }

    private void ApplyAcceptedRunState(ComposerSubmitOutcome.Accepted accepted)
    {
        // Accepted outcome is always safe to project onto component state: the service has
        // already persisted the chat, message and run. We just sync local UI state. Kept
        // synchronous (no JS interop, no network calls) so it finishes — and StoreRun's cache
        // update takes effect — before the submit guard in SubmitComposerAsync is released.
        if (_selectedChat?.Id != accepted.Chat.Id || _selectedChat.Revision < accepted.Chat.Revision) _selectedChat = accepted.Chat;
        _selectedBranchId = accepted.RunBranchId;
        StoreRun(accepted.Snapshot);
        _pendingBranchAnchorId = accepted.RunBranchId;
        if (accepted.UpdatedBranchLeafId is { } updatedLeaf)
        {
            _branchLeafId = updatedLeaf;
            // For a fresh message we anchor the pending branch on it so OnRunSnapshot can
            // advance to the new leaf once the assistant finishes. The service doesn't set
            // this because it's purely a UI bookkeeping signal.
            _pendingBranchAnchorId = accepted.RunBranchId == accepted.Snapshot.ChatId ? null : accepted.RunBranchId;
        }
        _messageBranchMenuId = null;
        _forkSourceId = null;
        _replaceSourceId = null;
        _chat.Message = string.Empty;
    }

    private async Task FinishAcceptedUiUpdatesAsync(ComposerSubmitOutcome.Accepted accepted)
    {
        // The textarea's DOM value is independent from the bound _chat.Message — Blazor will
        // sync it on the next render, but for Queue mode the snapshot that triggers a render
        // doesn't always arrive (the dispatcher only Publishes when the worker actually
        // starts). Force a render + tell the JS module to clear the DOM and resize, so the
        // composer visibly empties the moment Ctrl+Enter is pressed instead of staying full.
        await InvokeAsync(StateHasChanged);
        if (_composerHandle is not null) await _composerHandle.InvokeVoidAsync("reset");
        _composerNeedsResize = true;
        _scrollMessagesToBottom = true;

        // Refresh chat list in a guarded block so a transient failure (network blip,
        // revision conflict) doesn't roll back the projection already applied in
        // ApplyAcceptedRunState. The queue is already visible from accepted.Snapshot, so the
        // worst case is a stale sidebar that the next OnRunSnapshot event will fix.
        try
        {
            await LoadChatsAsync(accepted.Chat.ProjectId);
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            // The queue is visible from the snapshot — a stale sidebar isn't worth a render
            // failure. The next snapshot event will reconcile it.
        }
    }

