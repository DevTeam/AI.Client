@page "/"
@using System.Text.Json
@inject IClientMetadata ClientMetadata
@inject IProjectApi ProjectApi
@inject IChatApi ChatApi
@inject IChatHistoryApi ChatHistoryApi
@inject IJSRuntime JSRuntime
@inject IWorkspaceLayoutService WorkspaceLayoutService
@inject IGlobalSettingsApi GlobalSettingsApi
@inject IChatRunsApi ChatRunsApi
@implements IAsyncDisposable

<PageTitle>@ClientMetadata.ProductName</PageTitle>

<main class="workspace-shell @(_isSidebarCollapsed ? "left-collapsed" : string.Empty)" @ref="_workspace">
    <button class="icon-action sidebar-toggle" type="button" title="@(_isSidebarCollapsed ? "Show sidebar" : "Hide sidebar")" aria-label="@(_isSidebarCollapsed ? "Show sidebar" : "Hide sidebar")" aria-expanded="@(_isSidebarCollapsed ? "false" : "true")" @onclick="ToggleLeftPanelAsync"><AppIcon Name="@(_isSidebarCollapsed ? "chevron-right" : "chevron-left")" /></button>
    <aside class="workspace-sidebar">
        <div class="sidebar-heading">
            <button type="button" class="sidebar-heading-toggle" aria-expanded="@(_isSettingsSectionExpanded ? "true" : "false")" aria-controls="global-settings-nav" @onclick="ToggleSettingsSection">
                <AppIcon Name="chevron-right" />
                <span>Settings</span>
            </button>
        </div>
        @if (_isSettingsSectionExpanded)
        {
            <nav id="global-settings-nav" class="global-nav" aria-label="Global settings">
                @foreach (var section in new[] { "Connections", "Security", "MCP" })
                {
                    <button class="workspace-nav-item @(_globalSection == section ? "selected" : string.Empty)" type="button" @onclick="() => OpenGlobalSection(section)">@section</button>
                }
            </nav>
        }
        <div class="sidebar-heading">
            <button type="button" class="sidebar-heading-toggle" aria-expanded="@(_isProjectsSectionExpanded ? "true" : "false")" aria-controls="projects-nav" @onclick="ToggleProjectsSection">
                <AppIcon Name="chevron-right" />
                <span>Projects</span>
            </button>
            <button type="button" title="New project" aria-label="New project" @onclick="CreateProjectAsync">＋</button>
        </div>
        @if (_isProjectsSectionExpanded)
        {
        <div id="projects-nav">
        @if (_isLoading)
        {
            <p>Loading...</p>
        }
        @foreach (var project in _projects)
        {
            <div class="project-nav-row @(_globalSection is null && project.Id == _selectedProject?.Id ? "selected" : string.Empty) @(_draggedProjectId == project.Id ? "dragging" : string.Empty) @GetRunStatusClass(GetProjectRun(project.Id))" title="@GetProjectRunTitle(project.Id)" draggable="true" @ondragstart="() => OnProjectDragStart(project.Id)" @ondragover="OnDragOver" @ondragover:preventDefault="true" @ondrop="() => OnProjectDrop(project)" @oncontextmenu="() => OnProjectContextMenu(project)" @oncontextmenu:preventDefault="true">
                @if (_editingProjectId == project.Id)
                {
                    <input class="sidebar-inline-editor" @ref="_editingInput" value="@_editingTitle" @oninput="e => _editingTitle = e.Value?.ToString() ?? string.Empty" @onkeydown="e => HandleInlineEditKeyAsync(e, () => SaveProjectTitleAsync(project))" @onblur="() => SaveProjectTitleAsync(project)" aria-label="Project name" />
                }
                else
                {
                    <button class="workspace-nav-item" type="button" @onclick="() => SelectProjectAsync(project)">▣ @project.Name</button>
                }
                @if (project.Id == _selectedProject?.Id)
                {
                    <button class="icon-action project-action-button project-new-chat-button" type="button" title="New chat" aria-label="New chat" @onclick="CreateChatAsync"><AppIcon Name="plus" /></button>
                    <button class="icon-action project-action-button project-rename-button" type="button" title="Rename" aria-label="Rename project" @onclick="BeginProjectRename"><AppIcon Name="edit" /></button>
                    <button class="icon-action project-action-button project-menu-button" type="button" title="Project settings" aria-label="Project settings" @onclick="ToggleProjectMenu"><AppIcon Name="more" /></button>
                }
            </div>
            @if (project.Id == _selectedProject?.Id)
            {
                <nav class="workspace-chat-list" aria-label="Chats in @project.Name" @onkeydown="OnChatListKeyDown">
                    @foreach (var chat in _chats)
                    {
                        <div class="chat-nav-row @(_globalSection is null && chat.Id == _selectedChat?.Id && GetSelectedBranchId() is null ? "selected" : string.Empty) @(_draggedChatId == chat.Id ? "dragging" : string.Empty) @GetRunStatusClass(GetRun(chat.Id, chat.Id))" title="@GetRunTitle(GetRun(chat.Id, chat.Id))" draggable="true" @ondragstart="() => OnChatDragStart(chat.Id)" @ondragover="OnDragOver" @ondragover:preventDefault="true" @ondrop="() => OnChatDrop(chat)" @oncontextmenu="() => OnChatContextMenu(chat.Id)" @oncontextmenu:preventDefault="true">
                            @if (_editingChatId == chat.Id)
                            {
                                <input class="sidebar-inline-editor chat-link" @ref="_editingInput" value="@_editingTitle" @oninput="e => _editingTitle = e.Value?.ToString() ?? string.Empty" @onkeydown="e => HandleInlineEditKeyAsync(e, () => SaveChatTitleAsync(chat))" @onblur="() => SaveChatTitleAsync(chat)" aria-label="Chat name" />
                            }
                            else
                            {
                                <button class="workspace-nav-item chat-link" type="button" @onclick="() => SelectChatAsync(chat.Id)">@chat.Title</button>
                            }
                            <button class="icon-action chat-row-action" type="button" title="Rename" aria-label="Rename chat" @onclick="() => BeginChatRename(chat)"><AppIcon Name="edit" /></button>
                            <button class="icon-action chat-row-action chat-menu-button @(_chatMenuId == chat.Id ? "menu-open" : string.Empty)" type="button" title="Chat menu" aria-label="Chat menu" @onclick="() => ToggleChatMenu(chat.Id)"><AppIcon Name="more" /></button>
                            @if (_chatMenuId == chat.Id)
                            {
                                <div class="chat-menu" role="menu" @onclick:stopPropagation="true">
                                    @if (_isConfirmingChatDelete)
                                    {
                                        <div class="project-menu-confirm"><span>Are you sure?</span><button class="danger compact-action" type="button" @onclick="() => DeleteChatAsync(chat)">Delete</button><button class="secondary-action compact-action" type="button" @onclick="CancelChatDelete">Cancel</button></div>
                                    }
                                    else
                                    {
                                        <button class="menu-danger" type="button" role="menuitem" @onclick="ConfirmChatDelete"><AppIcon Name="trash" />Delete chat</button>
                                    }
                                </div>
                            }
                        </div>
                        @if (_selectedChat?.Id == chat.Id)
                        {
                            @foreach (var branch in GetBranchTreeItems())
                            {
                                <div class="chat-nav-row branch-nav-row @(GetSelectedBranchId() == branch.RootId ? "selected" : string.Empty) @GetRunStatusClass(GetBranchRun(chat.Id, branch))" title="@GetRunTitle(GetBranchRun(chat.Id, branch))" style="--branch-depth: @Math.Min(branch.Depth, 3)">
                                    <span class="branch-tree-line" aria-hidden="true"></span>
                                    @if (_editingBranchId == branch.RootId)
                                    {
                                        <input class="sidebar-inline-editor chat-link" @ref="_editingInput" value="@_editingTitle" @oninput="e => _editingTitle = e.Value?.ToString() ?? string.Empty" @onkeydown="e => HandleInlineEditKeyAsync(e, () => SaveBranchTitleAsync(branch))" @onblur="() => SaveBranchTitleAsync(branch)" aria-label="Branch name" />
                                    }
                                    else
                                    {
                                        <button class="workspace-nav-item chat-link branch-link" type="button" @onclick="() => SelectBranchTreeItemAsync(branch)"><AppIcon Name="git-branch" /><span>@branch.Title</span></button>
                                    }
                                    <button class="icon-action chat-row-action" type="button" title="Rename" aria-label="Rename branch" @onclick="() => BeginBranchRename(branch)"><AppIcon Name="edit" /></button>
                                    <button class="icon-action chat-row-action chat-menu-button @(_branchMenuId == branch.RootId ? "menu-open" : string.Empty)" type="button" title="Branch menu" aria-label="Branch menu" @onclick="() => ToggleBranchMenu(branch.RootId)"><AppIcon Name="more" /></button>
                                    @if (_branchMenuId == branch.RootId)
                                    {
                                        <div class="chat-menu" role="menu" @onclick:stopPropagation="true">
                                            <button class="menu-danger" type="button" role="menuitem" @onclick="() => DeleteBranchAsync(branch)"><AppIcon Name="trash" />Delete branch</button>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                    @if (_chats.Count == 0) { <span class="empty-hint">No chats yet</span> }
                </nav>
            }
        }
        </div>
        }
    </aside>

    <div class="workspace-resizer" data-side="left" role="separator" aria-label="Resize project sidebar"></div>

    @if (_globalSection is not null)
    {
        <section class="global-workspace" aria-label="@_globalSection">
            @if (_globalSection == "Connections")
            {
                <header class="global-header"><div><h1>Connections</h1><p>OpenAI-compatible endpoints available to every project.</p></div></header>
                <div class="global-editor-layout">
                    <div class="settings-list-column">
                        <nav class="settings-list">@foreach (var connectionItem in _connections) { <div class="settings-list-item @(connectionItem.Id == _selectedConnectionId ? "selected" : string.Empty)"><button class="settings-list-select" type="button" @onclick="() => SelectConnection(connectionItem.Id)"><span>@connectionItem.Name</span><small>@(connectionItem.IsDefault ? "Default" : connectionItem.Enabled ? "Enabled" : "Unavailable")</small></button>@if (connectionItem.Id == _selectedConnectionId) { <button class="icon-action settings-item-remove" type="button" title="Remove connection" aria-label="Remove connection" @onclick="RemoveConnection"><AppIcon Name="trash" /></button> }</div> }</nav>
                        <button class="icon-action settings-list-add" type="button" title="Add connection" aria-label="Add connection" @onclick="AddConnection"><AppIcon Name="plus" /></button>
                    </div>
                    @if (GetSelectedConnection() is { } connection)
                    {
                        <div class="global-form"><div class="connection-flags"><label class="checkbox"><input type="checkbox" @bind="connection.Enabled" /> Enabled</label><label class="checkbox"><input type="checkbox" checked="@connection.IsDefault" @onchange="args => SetDefaultConnection(connection.Id, args)" /> Default</label></div><label>Name<InputText @bind-Value="connection.Name" /></label><label>Base URL<InputText @bind-Value="connection.BaseUrl" /></label><label>Model<InputText @bind-Value="connection.Model" /></label><label>API key<InputText type="password" @bind-Value="connection.Secret" placeholder="@(connection.HasCredential ? "Saved; enter to replace" : "Optional")" /></label></div>
                    }
                </div>
                <footer class="global-actions"><button type="button" @onclick="SaveGlobalSettingsAsync">Save</button><button class="secondary-action" type="button" @onclick="LoadGlobalSettingsAsync">Cancel</button></footer>
            }
            else if (_globalSection == "Security")
            {
                <header class="global-header"><div><h1>Security</h1><p>Global confirmation and application policies.</p></div></header><div class="settings-placeholder"><h3>Notifications</h3><p>Show a local browser notification when a background chat finishes or fails while this application is not focused.</p><button type="button" @onclick="EnableNotificationsAsync">@(_notificationsEnabled ? "Notifications enabled" : "Enable notifications")</button><p>Directory access is configured independently for each project.</p></div>
            }
            else
            {
                <header class="global-header"><div><h1>MCP</h1><p>Global MCP servers available to every project.</p></div></header>
                <div class="global-editor-layout">
                    <div class="settings-list-column">
                        <nav class="settings-list">@foreach (var serverItem in _globalMcpServers) { <div class="settings-list-item @(serverItem.Id == _selectedMcpServerId ? "selected" : string.Empty)"><button class="settings-list-select" type="button" @onclick="() => _selectedMcpServerId = serverItem.Id"><span>@serverItem.Name</span><small>@serverItem.Transport · @serverItem.Policy</small></button>@if (serverItem.Id == _selectedMcpServerId) { <button class="icon-action settings-item-remove" type="button" title="Remove MCP server" aria-label="Remove MCP server" @onclick="RemoveGlobalMcpServer"><AppIcon Name="trash" /></button> }</div> }</nav>
                        <button class="icon-action settings-list-add" type="button" title="Add MCP server" aria-label="Add MCP server" @onclick="AddGlobalMcpServer"><AppIcon Name="plus" /></button>
                    </div>
                    @if (GetSelectedMcpServer() is { } server)
                    {
                        <div class="global-form"><label>Name<InputText @bind-Value="server.Name" /></label><label>Transport<select @bind="server.Transport"><option>StreamableHttp</option><option>Stdio</option></select></label><label>Policy<select @bind="server.Policy"><option>Allow</option><option>Ask</option><option>Deny</option></select></label><label class="checkbox"><input type="checkbox" @bind="server.Enabled" /> Enabled</label>@if (server.Transport == "StreamableHttp") { <label>URL<InputText @bind-Value="server.Url" /></label><label>Credential<InputText type="password" @bind-Value="server.Secret" placeholder="@(server.HasCredential ? "Saved; enter to replace" : "Optional")" /></label> } else { <label>Command<InputText @bind-Value="server.Command" /></label><label>Arguments<InputText @bind-Value="server.ArgumentsText" placeholder="One argument per line" /></label><label>Working directory<InputText @bind-Value="server.WorkingDirectory" /></label><label>Environment variables<InputTextArea @bind-Value="server.EnvironmentText" placeholder="NAME=value" /></label> }</div>
                    }
                </div>
                <footer class="global-actions"><button type="button" @onclick="SaveGlobalSettingsAsync">Save</button><button class="secondary-action" type="button" @onclick="LoadGlobalSettingsAsync">Cancel</button></footer>
            }
        </section>
    }
    else
    {
    <section class="workspace-conversation" aria-label="Chat">
        @if ((_isSidebarCollapsed || !_isProjectsSectionExpanded) && _selectedProject is not null)
        {
            <header class="conversation-context-header">
                <span class="conversation-context-project">@_selectedProject.Name</span>
                @if (GetContextBranchTitle() is { } contextBranchTitle)
                {
                    <AppIcon Name="chevron-right" />
                    <span class="conversation-context-branch">@contextBranchTitle</span>
                }
            </header>
        }
        <MessageFeed @ref="_messageFeed"
            HasSelectedProject="@(_selectedProject is not null)"
            SelectedChat="@_selectedChat"
            BranchLeafId="@_branchLeafId"
            ForkSourceId="@_forkSourceId"
            MessageBranchMenuId="@_messageBranchMenuId"
            SelectedRun="@GetSelectedRun()"
            OnCopyMessage="CopyMessageAsync"
            OnForkFromMessage="ForkFromMessageAsync"
            OnEditAndBranch="EditAndBranchAsync"
            OnEditAndReplaceBranch="EditAndReplaceBranchAsync"
            OnToggleBranchMenu="ToggleMessageBranchMenu"
            OnSelectBranch="SelectMessageBranch"
            OnBranchPickerKeyDown="HandleBranchPickerKeyDown" />
        @if (GetSelectedRun() is { } selectedRun && selectedRun.Queue.Count > 0)
        {
            <section class="chat-queue"><button class="queue-summary" type="button" aria-expanded="@(_isQueueExpanded ? "true" : "false")" @onclick="() => _isQueueExpanded = !_isQueueExpanded"><AppIcon Name="queue" /><span>Queued · @selectedRun.Queue.Count</span><AppIcon Name="chevron-right" /></button>@if (_isQueueExpanded) { <div class="queue-items">@foreach (var item in selectedRun.Queue) { <div @key="item.Id" class="queue-item" data-queue-id="@item.Id">@if (_editingQueueId == item.Id) { <input value="@_editingQueueText" @oninput="args => _editingQueueText = args.Value?.ToString() ?? string.Empty" @onkeydown="args => HandleQueueEditKeyAsync(args, item.Id)" @onblur="() => SaveQueuedMessageAsync(item.Id)" autofocus /> } else { <button class="queue-drag-handle" type="button" title="Drag to reorder" aria-label="Drag queued message"><AppIcon Name="drag" /></button><span>@GetMessagePreview(item.Content)</span><button class="icon-action" type="button" title="Move up" aria-label="Move up" @onclick="() => MoveQueuedMessageAsync(item.Id, -1)"><AppIcon Name="chevron-up" /></button><button class="icon-action" type="button" title="Move down" aria-label="Move down" @onclick="() => MoveQueuedMessageAsync(item.Id, 1)"><AppIcon Name="chevron-down" /></button><button class="icon-action" type="button" title="Edit queued message" aria-label="Edit queued message" @onclick="() => BeginQueueEdit(item)"><AppIcon Name="edit" /></button><button class="icon-action destructive-action" type="button" title="Remove queued message" aria-label="Remove queued message" @onclick="() => RemoveQueuedMessageAsync(item.Id)"><AppIcon Name="trash" /></button> }</div> }</div> }@if (selectedRun.Status is ChatRunStatus.Paused or ChatRunStatus.Interrupted or ChatRunStatus.Failed) { <div class="queue-actions"><button type="button" @onclick="ResumeQueueAsync">Resume</button><button type="button" class="secondary-action" @onclick="ClearQueueAsync">Clear</button></div> }</section>
        }
        <div class="composer-status" role="status">
            @if (GetSelectedRun()?.Status == ChatRunStatus.Generating) { <span>Generating...</span> }
            else if (GetSelectedRun()?.Status == ChatRunStatus.Paused) { <span>Stopped · queue paused</span> }
            else if (GetSelectedRun()?.Status == ChatRunStatus.Interrupted) { <span>Interrupted · resume when ready</span> }
            else if (GetSelectedRun() is { Status: ChatRunStatus.Failed } failedRun) { <span class="error">Failed: @failedRun.Error</span> }
            else if (GetReplaceSource() is { } replaceSource) { <span class="fork-mode replace-mode"><AppIcon Name="edit-replace" /><span>Replacing branch from “@GetMessagePreview(replaceSource.Content)”</span><button class="icon-action" type="button" title="Cancel replacement" aria-label="Cancel replacement" @onclick="CancelBranchOperation"><AppIcon Name="x" /></button></span> }
            else if (GetForkSource() is { } forkSource) { <span class="fork-mode"><AppIcon Name="fork" /><span>Forking from “@GetMessagePreview(forkSource.Content)”</span><button class="icon-action" type="button" title="Cancel fork" aria-label="Cancel fork" @onclick="CancelBranchOperation"><AppIcon Name="x" /></button></span> }
            else { <span>@GetComposerHint()</span> }
        </div>
        <footer class="workspace-composer">
            <textarea @ref="_composer" @bind="_chat.Message" @bind:event="oninput" @onkeydown="HandleComposerKeyDown" placeholder="@(_replaceSourceId is not null ? "Edit the message to replace this branch..." : _forkSourceId is not null ? "Write the first message in the new branch..." : "Message the assistant...")" aria-label="Message"></textarea>
            <div class="composer-footer">
                <div class="composer-endpoint">
                    <button class="composer-endpoint-trigger" type="button" title="Endpoint for this chat" aria-label="Endpoint for this chat" aria-haspopup="true" aria-expanded="@(_isEndpointMenuOpen ? "true" : "false")" @onclick="ToggleEndpointMenu" disabled="@(_connections.Count == 0)">
                        <span>@GetEndpointDisplayName()</span>
                        <AppIcon Name="chevron-down" />
                    </button>
                    @if (_isEndpointMenuOpen)
                    {
                        <div class="context-menu-backdrop" @onclick="CloseEndpointMenu"></div>
                        <span class="composer-endpoint-menu" role="menu">
                            @foreach (var connection in _connections.Where(item => item.Enabled))
                            {
                                var isSelected = connection.Id == _chat.CredentialProfileId;
                                <button type="button" role="menuitem" class="@(isSelected ? "selected" : string.Empty)" @onclick="() => SelectChatEndpointAsync(connection.Id)">
                                    @if (isSelected) { <AppIcon Name="check" /> } else { <span class="branch-option-spacer"></span> }
                                    <span>@connection.Name</span>
                                    @if (connection.IsDefault) { <span class="composer-endpoint-default">Default</span> }
                                </button>
                            }
                        </span>
                    }
                </div>
                @if (GetSelectedRun()?.Status == ChatRunStatus.Generating) { <button type="button" class="stop-button" title="Stop generation" aria-label="Stop generation" @onclick="StopGenerationAsync"><AppIcon Name="stop" /></button> } else { <button class="composer-send" type="button" title="Send message" aria-label="Send message" @onclick="SendChatAsync" disabled="@(!CanSendMessage())"><AppIcon Name="arrow-up" /></button> }
            </div>
            @if (!string.IsNullOrEmpty(_chatError)) { <p class="error" role="alert">@_chatError</p> }
        </footer>
    </section>
    }

    @if (_isProjectMenuOpen && _selectedProject is not null)
    {
        <div class="context-menu-backdrop" @onclick="CloseContextMenus" @oncontextmenu="OnBackdropContextMenu" @oncontextmenu:preventDefault="true"></div>
        <div class="project-menu" role="menu" @onclick:stopPropagation="true">
            <button type="button" role="menuitem" @onclick="OpenProjectSettings"><AppIcon Name="sliders" />Project settings</button>
            @if (_isConfirmingProjectDelete)
            {
                <div class="project-menu-confirm"><span>Are you sure?</span><button class="danger compact-action" type="button" @onclick="DeleteProjectAsync">Delete</button><button class="secondary-action compact-action" type="button" @onclick="CancelProjectDelete">Cancel</button></div>
            }
            else
            {
                <button class="menu-danger" type="button" role="menuitem" @onclick="ConfirmProjectDelete"><AppIcon Name="trash" />Delete project</button>
            }
        </div>
    }

    @if (_chatMenuId is not null)
    {
        <div class="context-menu-backdrop" @onclick="CloseContextMenus" @oncontextmenu="OnBackdropContextMenu" @oncontextmenu:preventDefault="true"></div>
    }

    @if (_isProjectSettingsOpen && _selectedProject is not null)
    {
        <div class="modal-backdrop" @onclick="CancelCurrentSettingsAsync">
            <section class="project-settings-modal" role="dialog" aria-modal="true" aria-labelledby="project-settings-title" @onclick:stopPropagation="true" @onkeydown="HandleProjectSettingsKeyDownAsync">
                <header><div><strong id="project-settings-title">Project settings</strong><span>@_selectedProject.Name</span></div></header>
            <div class="settings-content">
                <EditForm Model="_editor" class="workspace-form">
                    <DataAnnotationsValidator />
                    <label>Name<InputText @bind-Value="_editor.Name" /></label>
                    <label>Description<InputTextArea @bind-Value="_editor.Description" /></label>
                    <label>Connection<select @bind="_editor.ConnectionId"><option value="">No connection</option>@foreach (var connection in _connections) { <option value="@connection.Id" disabled="@(!connection.Enabled)">@connection.Name@(!connection.Enabled ? " (Unavailable)" : string.Empty)</option> }</select></label>
                </EditForm>
                <section class="directory-settings"><div class="section-heading"><div><h3>Allowed directories</h3><p>Access is always recursive.</p></div><button class="icon-action" type="button" title="Add directory" aria-label="Add directory" @onclick="AddDirectoryGrant"><AppIcon Name="plus" /></button></div>@foreach (var directory in _security.DirectoryGrants) { <div class="directory-row"><InputText @bind-Value="directory.CanonicalRoot" placeholder="C:\Projects\App" /><select @bind="directory.Mode"><option>Read only</option><option>Read/write</option></select><button class="icon-action" type="button" title="Remove directory" aria-label="Remove directory" @onclick="() => RemoveDirectoryGrant(directory.Id)">−</button></div> }</section>
                @if (!string.IsNullOrEmpty(_error)) { <p class="error" role="alert">@_error</p> }
            </div>
            <footer class="settings-modal-actions">
                <button type="button" @onclick="SaveProjectSettingsAsync">Save</button>
                <button type="button" class="secondary-action" @onclick="CancelCurrentSettingsAsync">Cancel</button>
            </footer>
            </section>
        </div>
    }
</main>

<div class="toast-region" aria-live="polite" aria-atomic="true">
    @if (_toast is not null)
    {
        <div class="toast @_toast.Kind" role="status"><AppIcon Name="@(_toast.Kind == "success" ? "check" : "x")" /><span>@_toast.Message</span><button class="icon-action" type="button" title="Dismiss notification" aria-label="Dismiss notification" @onclick="DismissToast"><AppIcon Name="x" /></button></div>
    }
</div>

@code {
    private readonly List<ProjectSummary> _projects = [];
    private ProjectSummary? _selectedProject;
    private bool _isProjectMenuOpen;
    private bool _isProjectSettingsOpen;
    private bool _isConfirmingProjectDelete;
    private Guid? _chatMenuId;
    private Guid? _branchMenuId;
    private Guid? _messageBranchMenuId;
    private bool _isEndpointMenuOpen;
    private Guid? _editingProjectId;
    private Guid? _editingChatId;
    private Guid? _editingBranchId;
    private string _editingTitle = string.Empty;
    private bool _isCompletingInlineEdit;
    private ElementReference _editingInput;
    private bool _focusEditingInputPending;
    private IJSObjectReference? _inlineEditorModule;
    private bool _isConfirmingChatDelete;
    private Guid? _draggedProjectId;
    private Guid? _draggedChatId;
    private bool _isSettingsSectionExpanded;
    private bool _isProjectsSectionExpanded = true;
    private bool _isSidebarCollapsed;
    private const string SidebarCollapsedKey = "ai-client.sidebar-collapsed.v1";
    private string? _globalSection;
    private readonly List<ConnectionEditor> _connections = [];
    private readonly List<GlobalMcpServerEditor> _globalMcpServers = [];
    private Guid? _selectedConnectionId;
    private Guid? _selectedMcpServerId;
    private ProjectEditor _editor = new();
    private ProjectSecurityEditor _security = new();
    private readonly List<EndpointProfileEditor> _endpointProfiles = [];
    private string? _error;
    private readonly List<ChatSummary> _chats = [];
    private ChatDetails? _selectedChat;
    private Guid? _branchLeafId;
    private Guid? _forkSourceId;
    private Guid? _replaceSourceId;
    private Guid? _pendingBranchAnchorId;
    private bool _isLoading = true;
    private readonly ChatEditor _chat = new();
    private string? _chatError;
    private ToastMessage? _toast;
    private CancellationTokenSource? _toastCancellation;
    private string _settingsTab = "Endpoints";
    private Guid? _selectedEndpointId;
    private Guid? _defaultEndpointProfileId;
    private ElementReference _composer;
    private MessageFeed? _messageFeed;
    private bool _scrollMessagesToBottom;
    private IJSObjectReference? _composerModule;
    private IJSObjectReference? _composerHandle;
    private DotNetObjectReference<Home>? _dotNetReference;
    private ElementReference _workspace;
    private bool _attachComposer = true;
    private bool _composerNeedsResize;
    private readonly Dictionary<RunKey, ChatRunSnapshot> _runs = [];
    private bool _isQueueExpanded;
    private bool _isSubmittingMessage;
    private Guid? _editingQueueId;
    private string _editingQueueText = string.Empty;
    private bool _applicationFocused = true;
    private bool _notificationsEnabled;
    private IJSObjectReference? _runEventsModule;
