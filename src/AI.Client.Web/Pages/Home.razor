    private async Task<bool> PersistDirectoryGrantsAsync()
    {
        if (_selectedProject is null) return false;

        var result = await ProjectApi.UpdateSecurityAsync(_selectedProject.Id, _security.ToRequest(), CancellationToken.None);
        if (result.Status != ProjectUpdateStatus.Updated || result.Project is null)
        {
            await LoadSecurityAsync(_selectedProject.Id);
            ShowToast("Directory changes were not saved. Reload the project and try again.", "error");
            return false;
        }

        _security = ProjectSecurityEditor.From(result.Project);
        _editor.Revision = result.Project.Revision;
        return true;
    }

