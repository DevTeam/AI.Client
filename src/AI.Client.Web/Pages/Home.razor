    /// <summary>
    /// Runs one queue command and makes its outcome visible. A refusal carries the server's own
    /// reason - "this message has already been sent", "the branch changed" - and showing it is the
    /// whole point: these buttons used to fail silently, leaving no way to tell a refusal from a
    /// no-op. A null snapshot means the run itself is gone, which needs no announcement.
    /// </summary>
    private async Task RunQueueCommandAsync(Func<Task<ChatRunSnapshot?>> command)
    {
        try
        {
            if (await command() is { } snapshot) StoreRun(snapshot);
        }
        catch (Exception error) when (error is InvalidOperationException or HttpRequestException)
        {
            ShowToast(error.Message, "error");
        }
