    // Searching replaces the sidebar tree rather than sitting beside it, so state is only these
    // three fields: what was typed, what came back, and whether a request is in flight. There is no
    // paging in the UI — a person narrows a query sooner than they page through it — so the cursor
    // the service returns is reported as "more remain" and otherwise left alone.
    private string _searchQuery = string.Empty;
    private ChatSearchResult? _searchResult;
    private bool _isSearching;
    private CancellationTokenSource? _searchCancellation;

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        if (_searchQuery.Trim().Length < 2)
        {
            // One character matches nearly everything and costs a full scan to prove it.
            await CancelSearchAsync();
            _searchResult = null;
            return;
        }

        await RunSearchAsync();
    }

    private Task OnSearchKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? ClearSearch() : Task.CompletedTask;

    private async Task ClearSearch()
    {
        await CancelSearchAsync();
        _searchQuery = string.Empty;
        _searchResult = null;
    }

    private async Task CancelSearchAsync()
    {
        if (_searchCancellation is { } previous)
        {
            await previous.CancelAsync();
            previous.Dispose();
            _searchCancellation = null;
        }

        _isSearching = false;
    }

    private async Task RunSearchAsync()
    {
        // Typing is faster than searching, so each keystroke cancels the scan the last one started;
        // otherwise the answer to a half-typed word could land after the answer to the whole one.
        await CancelSearchAsync();
        var cancellation = new CancellationTokenSource();
        _searchCancellation = cancellation;
        _isSearching = true;
        var query = _searchQuery.Trim();
        try
        {
            var result = await ChatHistoryApi.SearchAsync(query, null, cancellation.Token);
            if (!cancellation.IsCancellationRequested && _searchQuery.Trim() == query)
            {
                _searchResult = result;
                _isSearching = false;
            }
        }
        catch (OperationCanceledException) { }
        catch (HttpRequestException)
        {
            if (!cancellation.IsCancellationRequested) _searchResult = new ChatSearchResult([], 0, 0, false, null, "Search is unavailable.");
            _isSearching = false;
        }
    }

    private async Task OpenSearchMatchAsync(ChatSearchMatch match)
    {
