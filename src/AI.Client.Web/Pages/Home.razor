    [JSInvokable]
    public async Task OnRunSnapshot(string json)
    {
        var snapshots = JsonSerializer.Deserialize<IReadOnlyList<ChatRunSnapshot>>(json, new JsonSerializerOptions(JsonSerializerDefaults.Web)) ?? [];

        RunState.RemoveMissing(snapshots);

        foreach (var snapshot in snapshots)
        {
            RunState.Runs.TryGetValue(new RunKey(snapshot.ChatId, snapshot.BranchId), out var previous);
            StoreRun(snapshot);
            if (snapshot.ChatId == _selectedChat?.Id)
            {
                var isSelectedRun = snapshot.BranchId == GetSelectedRunBranchId();
                var isPendingBranchRun = _pendingBranchAnchorId is { } pendingId && snapshot.BranchId == pendingId;
                if (isSelectedRun || isPendingBranchRun) _scrollMessagesToBottom = true;
                if (snapshot.ChatRevision > _selectedChat.Revision && _selectedProject is not null)
                {
                    _selectedChat = await ChatHistoryApi.GetAsync(_selectedProject.Id, snapshot.ChatId, CancellationToken.None);
                    await LoadChatsAsync(_selectedProject.Id);
                }
                if ((isSelectedRun || isPendingBranchRun) && _selectedChat?.Branches?.SingleOrDefault(branch => branch.Id == snapshot.BranchId)?.HeadMessageId is { } head)
                    _branchLeafId = head;
                if ((isSelectedRun || isPendingBranchRun) && _applicationFocused && snapshot.HasUnreadResponse) await MarkSelectedChatReadAsync();
            }

            // ReSharper disable once InvertIf
            if (!_applicationFocused && previous?.Status == ChatRunStatus.Generating && snapshot.Status is ChatRunStatus.Completed or ChatRunStatus.Failed)
            {
                var chat = _chats.FirstOrDefault(item => item.Id == snapshot.ChatId);
                if (_runEventsModule is not null) await _runEventsModule.InvokeVoidAsync("notify", _selectedProject?.Name ?? "AI.Client", $"{chat?.Title ?? "Chat"}: {snapshot.Status}");
            }
        }
        await InvokeAsync(StateHasChanged);
    }

