    private void SwitchBranch(Guid siblingId)
    {
        if (_selectedChat is null) return;
        var current = siblingId;
        while (true)
        {
            var child = _selectedChat.Messages
                .Where(item => item.ParentId == current)
                .OrderBy(item => item.CreatedAt)
                .FirstOrDefault();
            if (child is null) break;
            current = child.Id;
        }

        _branchLeafId = current;
    }

