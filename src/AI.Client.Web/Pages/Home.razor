        // MessageFeed only ever renders the ancestor chain of _branchLeafId, so `message` is
        // necessarily on the branch GetSelectedRun() already reflects — checking it here (before
        // _branchLeafId moves to the parent below) tells us whether a response is still being
        // generated at or beyond this message. The button itself mirrors this same condition
        // (see MessageFeed's disabled state) so this is a defense-in-depth check, not the only gate.
        if (GetSelectedRun()?.Status == ChatRunStatus.Generating)
        {
            _chatError = "Can't replace this message while a response is being generated on this branch.";
            return;
