    // Single entry point for the transient accent-line marker: setting it also schedules the clear,
    // and cancels whatever clear was already pending, so a restart can't be cut short by a stale timer.
    private void SetJustArrivedLeaf(Guid? leafId)
    {
        _justArrivedLeafCancellation?.Cancel();
        _justArrivedLeafCancellation?.Dispose();
        _justArrivedLeafCancellation = null;
        _justArrivedLeafId = leafId;
        if (leafId is null) return;

        var cancellation = new CancellationTokenSource();
        _justArrivedLeafCancellation = cancellation;
        _ = ClearJustArrivedLeafIdAsync(leafId.Value, cancellation.Token);
    }

    // Drops the class once the animation has played out; subsequent renders then take the fast
    // path through MessageFeed's ShouldRender.
    private async Task ClearJustArrivedLeafIdAsync(Guid arrived, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(BranchLeafLineLifetime, cancellationToken);
        }
        catch (OperationCanceledException) { return; }
        if (_justArrivedLeafId == arrived)
        {
            _justArrivedLeafId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
