        var update = JsonSerializer.Deserialize<ChatRunSnapshotUpdate>(json, new JsonSerializerOptions(JsonSerializerDefaults.Web));
        if (update is null) return;
        var snapshots = update.Runs;

        if (update.IsFull) RunState.RemoveMissing(snapshots);
        else RunState.Remove(update.Removed);
        RunState.AppendStreaming(update.StreamingAppends);

        var updatedSnapshots = snapshots.Concat(update.StreamingAppends.Select(append =>
            RunState.Runs.GetValueOrDefault(new RunKey(append.ChatId, append.BranchId))).OfType<ChatRunSnapshot>());
