                : _composerCtrlDown
                    ? ComposerSendButton.SendMode.Queue
                    : ComposerSendButton.SendMode.Send;

    // The button does whatever its tooltip is highlighting, so pressing it and pressing the keys
    // it shows can never mean two different things.
    private Task SubmitFromSendButtonAsync() => SubmitComposerAsync(GetComposerSendMode() switch
    {
        ComposerSendButton.SendMode.Fork => ComposerSubmitMode.Fork,
        ComposerSendButton.SendMode.Queue => ComposerSubmitMode.Queue,
        ComposerSendButton.SendMode.SendNow => ComposerSubmitMode.SendNow,
        _ => ComposerSubmitMode.Send
    });

