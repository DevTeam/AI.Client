    // The open project's own status is already visible per-chat below it, so the project row
    // itself shows nothing — repeating it there would be the same redundant echo we just
    // removed from the currently open chat/branch row.
    private string? GetProjectRunTitle(Guid projectId) =>
        _selectedProject?.Id == projectId || GetProjectRun(projectId) is null ? null : GetProjectRunTooltip(projectId);
    private string GetProjectStatusClass(Guid projectId) =>
        _selectedProject?.Id == projectId ? string.Empty : GetRunStatusClass(GetProjectRun(projectId));
    // A completed/unread/attention status for what's currently open in the transcript needs no
    // separate sidebar signal — the message feed already shows it. Generating is the exception:
    // it stays visible even for the open chat/branch, since it is live progress rather than a
    // state the user has already seen.
    private bool IsCurrentRun(Guid chatId, Guid branchId) => _selectedChat?.Id == chatId && GetSelectedRunBranchId() == branchId;
    private bool ShouldHideCurrentRunStatus(Guid chatId, Guid branchId, ChatRunSnapshot? run) =>
        IsCurrentRun(chatId, branchId) && run?.Status != ChatRunStatus.Generating;
    private string? GetRunTitle(Guid chatId, Guid branchId, ChatRunSnapshot? run) =>
        ShouldHideCurrentRunStatus(chatId, branchId, run) || run is null || !IsVisibleRun(run) ? null : RunStatusPresentation.GetStatusTooltip(run);
    private string GetRunStatusClass(Guid chatId, Guid branchId, ChatRunSnapshot? run) =>
        ShouldHideCurrentRunStatus(chatId, branchId, run) ? string.Empty : GetRunStatusClass(run);
    private static string GetRunStatusClass(ChatRunSnapshot? run) => RunStatusPresentation.GetStatusClass(run);

    // Captures the currently selected chat/branch synchronously (before any await), then hands
    // off to MarkChatReadAsync. This must NOT read _selectedChat/_selectedBranchId again after
    // an await: a fast second chat switch reassigns those fields while this call's own
    // MarkReadAsync request is still in flight, and re-reading them post-await would mark the
    // NEW selection read instead of the one this call was actually invoked for — leaving the
    // chat the user already left showing an unread indicator that never gets cleared.
    private Task MarkSelectedChatReadAsync() =>
        _selectedProject is null || _selectedChat is null
            ? Task.CompletedTask
            : MarkChatReadAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId());

    private async Task MarkChatReadAsync(Guid projectId, Guid chatId, Guid branchId)
    {
        if (_isConfirmingProjectDelete || GetRun(chatId, branchId)?.HasUnreadResponse != true) return;
        if (!await _projectMutationGate.WaitAsync(0, CancellationToken.None)) return;
        try
        {
            if (_isConfirmingProjectDelete || GetRun(chatId, branchId)?.HasUnreadResponse != true) return;
            var snapshot = await ChatRunsApi.MarkReadAsync(projectId, chatId, branchId, Guid.CreateVersion7(), CancellationToken.None);
            if (snapshot is not null) StoreRun(snapshot);
        }
        finally
        {
            _projectMutationGate.Release();
        }
    }

