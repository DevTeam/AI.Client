        var text = direction < 0
            ? _composerHistoryNavigator.MoveOlder(history, _chat.Message)
            : _composerHistoryNavigator.MoveNewer(history);
        if (text is null) return null;
        // Deliberately not saved as a draft: browsing is transient, and persisting each entry the
        // user walks past would overwrite the unsent text they still expect to find here.
        _chat.Message = text;
        StateHasChanged();
        return new ComposerHistoryMove(text, _composerHistoryNavigator.IsActive);
    }

