    private async Task OnProjectDrop(ProjectSummary targetProject)
    {
        var draggedId = _draggedProjectId;
        _draggedProjectId = null;
        if (draggedId is not { } id || id == targetProject.Id)
        {
            return;
        }

        var draggedIndex = _projects.FindIndex(p => p.Id == id);
        var targetIndex = _projects.FindIndex(p => p.Id == targetProject.Id);
        if (draggedIndex < 0 || targetIndex < 0)
        {
            return;
        }

        var item = _projects[draggedIndex];
        _projects.RemoveAt(draggedIndex);
        _projects.Insert(targetIndex, item);
        await SaveOrderAsync(ProjectOrderKey, _projects.Select(p => p.Id));
    }

    private void OnChatDragStart(Guid chatId) => _draggedChatId = chatId;

    private async Task OnChatDrop(ChatSummary targetChat)
    {
        var draggedId = _draggedChatId;
        _draggedChatId = null;
        if (draggedId is not { } id || id == targetChat.Id || _selectedProject is null)
        {
            return;
        }

        var draggedIndex = _chats.FindIndex(c => c.Id == id);
        var targetIndex = _chats.FindIndex(c => c.Id == targetChat.Id);
        if (draggedIndex < 0 || targetIndex < 0)
        {
            return;
        }

        var item = _chats[draggedIndex];
        _chats.RemoveAt(draggedIndex);
        _chats.Insert(targetIndex, item);
        await SaveOrderAsync(ChatOrderKey(_selectedProject.Id), _chats.Select(c => c.Id));
    }

    private const string ProjectOrderKey = "ai-client.project-order.v1";

    private static string ChatOrderKey(Guid projectId) => $"ai-client.chat-order.v1.{projectId}";

    private async Task ApplyProjectOrderAsync()
    {
        var order = await LoadOrderAsync(ProjectOrderKey);
        if (order.Count == 0)
        {
            return;
        }

        var ordered = ApplyOrder(_projects, order, p => p.Id);
        _projects.Clear();
        _projects.AddRange(ordered);
    }

    private async Task<List<Guid>> LoadOrderAsync(string key)
    {
        try
        {
            var json = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", key);
            return string.IsNullOrEmpty(json) ? [] : JsonSerializer.Deserialize<List<Guid>>(json) ?? [];
        }
        catch (JsonException)
        {
            return [];
        }
    }

    private Task SaveOrderAsync(string key, IEnumerable<Guid> ids) =>
        JsRuntime.InvokeVoidAsync("localStorage.setItem", key, JsonSerializer.Serialize(ids)).AsTask();

    private static List<T> ApplyOrder<T>(IReadOnlyList<T> items, List<Guid> order, Func<T, Guid> idSelector)
    {
        var byId = items.ToDictionary(idSelector);
        var result = new List<T>(items.Count);
        var used = new HashSet<Guid>();
        foreach (var id in order)
        {
            if (byId.TryGetValue(id, out var item) && used.Add(id))
            {
                result.Add(item);
            }
        }

        result.AddRange(items.Where(item => used.Add(idSelector(item))));
        return result;
    }

