    protected override async Task OnInitializedAsync()
    {
        await LoadGlobalSettingsAsync();
        foreach (var run in await ChatRunsApi.GetAsync(CancellationToken.None)) StoreRun(run);
        await LoadProjectsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetReference = DotNetObjectReference.Create(this);
            await WorkspaceLayoutService.AttachAsync(_workspace);
            await LoadSidebarCollapsedAsync();
            await WorkspaceLayoutService.WatchPhoneModeAsync(_dotNetReference, PhoneModeBreakpointPx);
            try
            {
                _composerModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/chatComposer.js");
                _inlineEditorModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/inlineEditor.js");
                _runEventsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/runEvents.js");
                _runEventsSubscription = await _runEventsModule.InvokeAsync<IJSObjectReference>("subscribe", _dotNetReference);
                _focusSubscription = await _runEventsModule.InvokeAsync<IJSObjectReference>("watchFocus", _dotNetReference);
                _queueDragSubscription = await _runEventsModule.InvokeAsync<IJSObjectReference>("watchQueueDrag", _dotNetReference);
                _applicationFocused = await _runEventsModule.InvokeAsync<bool>("isFocused");
                _notificationsEnabled = await _runEventsModule.InvokeAsync<bool>("notificationsEnabled");
            }
            catch (JSException)
            {
                _composerModule = null;
            }

            StateHasChanged();
        }

        if (_globalSection is null && _attachComposer && _composerModule is not null && _dotNetReference is not null)
        {
            if (_composerHandle is not null)
            {
                await _composerHandle.InvokeVoidAsync("dispose");
                await _composerHandle.DisposeAsync();
            }

            try
            {
                _composerHandle = await _composerModule.InvokeAsync<IJSObjectReference>("attach", _composer, _dotNetReference);
            }
            catch (JSException)
            {
                _composerModule = null;
                _composerHandle = null;
            }
            _attachComposer = false;
        }

        if (_scrollMessagesToBottom && _messageFeed is not null)
        {
            _scrollMessagesToBottom = false;
            await _messageFeed.ScrollToBottomAsync();
        }

        if (_composerNeedsResize && _composerHandle is not null)
        {
            _composerNeedsResize = false;
            await _composerHandle.InvokeVoidAsync("resize");
        }

        if (_focusEditingInputPending && _inlineEditorModule is not null)
        {
            _focusEditingInputPending = false;
            await _inlineEditorModule.InvokeVoidAsync("focusAndSelect", _editingInput);
        }
    }

    [JSInvokable]
    public Task SendFromKeyboard() => CanSendMessage() ? SendChatAsync() : Task.CompletedTask;

    [JSInvokable]
    public async Task OnRunSnapshot(string json)
    {
        var snapshots = JsonSerializer.Deserialize<IReadOnlyList<ChatRunSnapshot>>(json, new JsonSerializerOptions(JsonSerializerDefaults.Web)) ?? [];
        foreach (var snapshot in snapshots)
        {
            _runs.TryGetValue(new RunKey(snapshot.ChatId, snapshot.BranchId), out var previous);
            StoreRun(snapshot);
            if (snapshot.ChatId == _selectedChat?.Id)
            {
                var isSelectedRun = snapshot.BranchId == GetSelectedRun()?.BranchId;
                var isPendingBranchRun = _pendingBranchAnchorId is { } pendingId && snapshot.BranchId == pendingId;
                if (isSelectedRun || isPendingBranchRun) _scrollMessagesToBottom = true;
                if ((isSelectedRun || isPendingBranchRun) && previous?.Status == ChatRunStatus.Generating && snapshot.Status != ChatRunStatus.Generating && _selectedProject is not null)
                {
                    _selectedChat = await ChatHistoryApi.GetAsync(_selectedProject.Id, snapshot.ChatId, CancellationToken.None);
                    SelectPendingBranchOrLatestMessage();
                    await LoadChatsAsync(_selectedProject.Id);
                }
                if ((isSelectedRun || isPendingBranchRun) && _applicationFocused && snapshot.HasUnreadResponse) await MarkSelectedChatReadAsync();
            }
            if (!_applicationFocused && previous?.Status == ChatRunStatus.Generating && snapshot.Status is ChatRunStatus.Completed or ChatRunStatus.Failed)
            {
                var chat = _chats.FirstOrDefault(item => item.Id == snapshot.ChatId);
                if (_runEventsModule is not null) await _runEventsModule.InvokeVoidAsync("notify", _selectedProject?.Name ?? "AI.Client", $"{chat?.Title ?? "Chat"}: {snapshot.Status}");
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnApplicationFocusChanged(bool focused)
    {
        _applicationFocused = focused;
        if (focused) await MarkSelectedChatReadAsync();
    }

    private Task HandleComposerKeyDown(KeyboardEventArgs args) =>
        _composerModule is null && args.Key == "Enter" && !args.ShiftKey && CanSendMessage()
            ? SendChatAsync()
            : Task.CompletedTask;

