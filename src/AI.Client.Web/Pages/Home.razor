    private async Task CreateProjectAsync()
    {
        try
        {
            var project = await ProjectApi.CreateAsync(new CreateProjectRequest("Untitled project", string.Empty), CancellationToken.None);
            _isProjectsSectionExpanded = true;
            await LoadProjectsAsync(project.Id);
            ShowToast("Project created.", "success");
        }
        catch (HttpRequestException)
        {
            _error = "The local gateway is unavailable.";
        }
    }

    private async Task SelectProjectAsync(ProjectSummary project)
    {
        _globalSection = null;
        _attachComposer = true;
        _selectedProject = project;
        _isProjectMenuOpen = false;
        _isProjectSettingsOpen = false;
        _isConfirmingProjectDelete = false;
        _chatMenuId = null;
        _branchMenuId = null;
        _isConfirmingChatDelete = false;
        _selectedChat = null;
        _branchLeafId = null;
        _editor = new ProjectEditor(project.Name, project.Description, project.Revision);
        _error = null;
        await LoadSecurityAsync(project.Id);
    }

    private async Task SaveProjectAsync()
    {
        if (_selectedProject is null)
        {
            return;
        }

        var result = await ProjectApi.UpdateAsync(
            _selectedProject.Id,
            new UpdateProjectRequest(_editor.Name, _editor.Description, _editor.Revision, _editor.ConnectionId),
            CancellationToken.None);
        if (result.Status == ProjectUpdateStatus.Updated && result.Project is not null)
        {
            await LoadProjectsAsync(result.Project.Id);
            ShowToast("Project saved.", "success");
            CloseProjectSettings();
            return;
        }

        _error = result.Status == ProjectUpdateStatus.Conflict
            ? "This project was changed elsewhere. Reload it before saving."
            : "This project no longer exists.";
    }

    private async Task DeleteProjectAsync()
    {
        if (_selectedProject is null)
        {
            return;
        }

        var result = await ProjectApi.DeleteAsync(_selectedProject.Id, _editor.Revision, CancellationToken.None);
        if (result.IsDeleted)
        {
            await LoadProjectsAsync();
            _isProjectMenuOpen = false;
            _isProjectSettingsOpen = false;
            _isConfirmingProjectDelete = false;
            ShowToast("Project deleted.", "success");
            return;
        }

        _error = result.Revision > 0
            ? "This project was changed elsewhere. Reload it before deleting."
            : "This project no longer exists.";
    }

    private async Task LoadProjectsAsync(Guid? selectedId = null)
    {
        try
        {
            _isLoading = true;
            _error = null;
            _projects.Clear();
            _projects.AddRange(await ProjectApi.ListAsync(CancellationToken.None));
            await ApplyProjectOrderAsync();
            var project = selectedId is null
                ? _projects.FirstOrDefault()
                : _projects.SingleOrDefault(item => item.Id == selectedId);
            if (project is not null)
            {
                await SelectProjectAsync(project);
            }
            else
            {
                _selectedProject = null;
            }
        }
        catch (HttpRequestException)
        {
            _error = "The local gateway is unavailable.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadSecurityAsync(Guid id)
    {
        var project = await ProjectApi.GetAsync(id, CancellationToken.None);
        if (project is not null && _selectedProject?.Id == id)
        {
            _security = ProjectSecurityEditor.From(project);
            _editor.ConnectionId = project.ConnectionId ?? GetDefaultConnection()?.Id;
            _defaultEndpointProfileId = _editor.ConnectionId;
            if (_defaultEndpointProfileId is { } defaultId)
            {
                SelectGlobalConnection(defaultId);
            }
            else
            {
                var defaultConnection = GetDefaultConnection();
                if (defaultConnection is not null) SelectGlobalConnection(defaultConnection.Id);
            }
            await LoadChatsAsync(id);
        }
    }

    private async Task SendChatAsync()
    {
        if (_isSubmittingMessage || _selectedProject is null || string.IsNullOrWhiteSpace(_chat.Message))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_chat.BaseUrl) || string.IsNullOrWhiteSpace(_chat.Model))
        {
            _chatError = "Select or configure an endpoint before sending a message.";
            return;
        }

        _isSubmittingMessage = true;
        var prompt = _chat.Message.Trim();
        try
        {
            _chatError = null;
            if (_selectedChat is null)
            {
                // The connection actually selected in the composer (_chat.CredentialProfileId),
                // not the project's own default (_defaultEndpointProfileId) — those can differ
                // once the composer endpoint picker lets a chat override the project's default,
                // and using the project default here silently discarded that choice for brand
                // new chats (it only took effect later, via UpdateEndpointAsync on an existing one).
                _selectedChat = await ChatHistoryApi.CreateAsync(
                    _selectedProject.Id,
                    new CreateChatRequest(CreateChatTitle(prompt), _chat.CredentialProfileId),
                    CancellationToken.None);
            }
            if (_replaceSourceId is { } replaceSourceId)
            {
                var replaceSource = _selectedChat.Messages.Single(message => message.Id == replaceSourceId);
                var deleteResult = await ChatHistoryApi.DeleteBranchAsync(
                    _selectedProject.Id,
                    _selectedChat.Id,
                    replaceSourceId,
                    _selectedChat.Revision,
                    CancellationToken.None);
                if (!deleteResult.IsDeleted)
                {
                    throw new InvalidOperationException("The branch changed before it could be replaced.");
                }

                _selectedChat = await ChatHistoryApi.GetAsync(_selectedProject.Id, _selectedChat.Id, CancellationToken.None)
                    ?? throw new InvalidOperationException("The chat no longer exists.");
                _branchLeafId = replaceSource.ParentId;
                _replaceSourceId = null;
            }
            var messageId = Guid.CreateVersion7();
            var runBranchId = _forkSourceId is not null ? messageId : GetSelectedRunBranchId();
            if (_forkSourceId is not null)
            {
                _pendingBranchAnchorId = messageId;
            }
            var snapshot = await ChatRunsApi.EnqueueAsync(_selectedProject.Id, _selectedChat.Id,
                new EnqueueChatMessageRequest(Guid.CreateVersion7(), messageId, prompt, _branchLeafId, runBranchId), CancellationToken.None);
            StoreRun(snapshot);
            _messageBranchMenuId = null;
            _forkSourceId = null;
            _replaceSourceId = null;
            _chat.Message = string.Empty;
            _composerNeedsResize = true;
            _scrollMessagesToBottom = true;
            await LoadChatsAsync(_selectedProject.Id);
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _chatError = "The endpoint did not accept the request. Verify the base URL, model, and API key.";
        }
        finally
        {
            _isSubmittingMessage = false;
        }
    }

    private async Task StopGenerationAsync()
    {
        if (_selectedProject is null || _selectedChat is null) return;
        var snapshot = await ChatRunsApi.StopAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), Guid.CreateVersion7(), CancellationToken.None);
        if (snapshot is not null) StoreRun(snapshot);
    }

    private bool CanSendMessage() =>
        !_isSubmittingMessage
        && _selectedProject is not null
        && !string.IsNullOrWhiteSpace(_chat.Message);

    private string GetComposerHint()
    {
        if (_selectedProject is null) return "Select a project";
        if (string.IsNullOrWhiteSpace(_chat.BaseUrl) || string.IsNullOrWhiteSpace(_chat.Model)) return "Select or configure an endpoint";
        return _selectedChat is null ? "A new chat will be created on send" : "Continuing selected chat";
    }

