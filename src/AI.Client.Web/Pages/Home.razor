    private async Task SaveEndpointProfilesAsync()
    {
        if (_selectedProject is null)
        {
            return;
        }

        ProjectUpdateResult result;
        try
        {
            result = await ProjectApi.UpdateEndpointProfilesAsync(
                _selectedProject.Id,
                new UpdateEndpointProfilesRequest(
                    _editor.Revision,
                    _endpointProfiles.Select(item => item.ToSettings()).ToArray(),
                    _defaultEndpointProfileId),
                CancellationToken.None);
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            ShowToast("Endpoints were not saved. Check the base URL and model.", "error");
            return;
        }
        if (result.Status != ProjectUpdateStatus.Updated || result.Project is null)
        {
            _error = result.Status == ProjectUpdateStatus.Conflict
                ? "Endpoint profiles were changed elsewhere. Reload the project before saving."
                : "This project no longer exists.";
            ShowToast(_error, "error");
            return;
        }

        foreach (var profile in _endpointProfiles.Where(item => !string.IsNullOrWhiteSpace(item.ApiKey)))
        {
            await ProjectApi.SetEndpointCredentialAsync(
                _selectedProject.Id,
                profile.Id,
                new UpdateEndpointCredentialRequest(profile.ApiKey),
                CancellationToken.None);
        }

        var selectedProfileId = _endpointProfiles.FirstOrDefault()?.Id;
        await LoadProjectsAsync(result.Project.Id);
        if (selectedProfileId is { } profileId)
        {
            SelectChatProfile(new ChangeEventArgs { Value = profileId.ToString() });
        }

        ShowToast("Endpoints saved.", "success");
        CloseProjectSettings();
    }

