    private void ShowToast(string message, string kind)
    {
        _toastCancellation?.Cancel();
        _toastCancellation?.Dispose();
        _toastCancellation = new CancellationTokenSource();
        _toast = new ToastMessage(message, kind);
        _ = DismissToastLaterAsync(_toastCancellation.Token);
    }

    private async Task DismissToastLaterAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(4), cancellationToken);
            await InvokeAsync(DismissToast);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void DismissToast()
    {
        _toast = null;
        StateHasChanged();
    }

