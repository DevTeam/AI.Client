    // _selectedChat is always replaced wholesale rather than mutated, so caching this by
    // reference is a safe, cheap invalidation key.
    // GetSelectedRun() (which reads this indirectly via GetSelectedBranchItem) is called ~9
    // times per render from the markup — without this cache, every one of those calls rebuilt
    // the entire branch tree (GroupBy + several ToDictionary + DistinctBy + a per-root depth
    // walk) from scratch, on every single render, including the one triggered by every composer
    // keystroke.
    private object? _branchTreeCacheChat;
    private IReadOnlyList<BranchTreeItem> _branchTreeCache = [];

    private IReadOnlyList<BranchTreeItem> GetBranchTreeItems()
    {
        if (ReferenceEquals(_branchTreeCacheChat, _selectedChat))
        {
            return _branchTreeCache;
        }
        _branchTreeCacheChat = _selectedChat;
        _branchTreeCache = ComputeBranchTreeItems();
        return _branchTreeCache;
    }

    private IReadOnlyList<BranchTreeItem> ComputeBranchTreeItems()
    {
        if (_selectedChat is null) return [];
        var messages = _selectedChat.Messages;
        var children = messages.GroupBy(message => message.ParentId ?? Guid.Empty).ToDictionary(group => group.Key, group => group.OrderBy(message => message.CreatedAt).ToArray());
        var roots = children.Values
            .Where(group => group.Length > 1)
            .SelectMany(group => group.Skip(1).Where(message => message.Role == "User"))
            .DistinctBy(message => message.Id)
            .OrderBy(message => message.CreatedAt)
            .ToArray();
        var rootIds = roots.Select(root => root.Id).ToHashSet();
        return roots.Select(root => new BranchTreeItem(root.Id, GetBranchTitle(root), GetBranchDepth(root, roots), FindBranchLeaf(root.Id, children, rootIds))).ToArray();
    }

    private string GetBranchTitle(ChatMessageView root) =>
        _selectedChat?.BranchTitles?.GetValueOrDefault(root.Id) ?? CreateChatTitle(root.Content);

    private int GetBranchDepth(ChatMessageView root, IReadOnlyList<ChatMessageView> roots)
    {
        var byId = _selectedChat!.Messages.ToDictionary(message => message.Id);
        var rootIds = roots.Select(message => message.Id).ToHashSet();
        var depth = 1;
        var parent = root.ParentId;
        while (parent is { } id && byId.TryGetValue(id, out var message)) { if (rootIds.Contains(id)) depth++; parent = message.ParentId; }
        return depth;
    }

    private static Guid FindBranchLeaf(Guid rootId, IReadOnlyDictionary<Guid, ChatMessageView[]> children, IReadOnlySet<Guid> branchRootIds)
    {
        var current = rootId;
        while (children.TryGetValue(current, out var descendants) && descendants.Length > 0)
        {
            var next = descendants.LastOrDefault(message => !branchRootIds.Contains(message.Id));
            if (next is null) break;
            current = next.Id;
        }
        return current;
    }

    private static Guid? GetOriginalBranchLeaf(ChatDetails? chat)
    {
        if (chat is null || chat.Messages.Count == 0) return null;
        var children = chat.Messages
            .GroupBy(message => message.ParentId ?? Guid.Empty)
            .ToDictionary(group => group.Key, group => group.OrderBy(message => message.CreatedAt).ToArray());
        var current = children.GetValueOrDefault(Guid.Empty)?.FirstOrDefault()?.Id;
        if (current is null) return null;
        while (children.TryGetValue(current.Value, out var descendants) && descendants.Length > 0)
        {
            current = descendants[0].Id;
        }
        return current;
    }

    private async Task SelectBranchTreeItemAsync(BranchTreeItem branch)
    {
        if (_selectedProject is null || _selectedChat is null) return;

        var refreshedChat = await ChatHistoryApi.GetAsync(_selectedProject.Id, _selectedChat.Id, CancellationToken.None);
        if (refreshedChat is not null)
        {
            _selectedChat = refreshedChat;
