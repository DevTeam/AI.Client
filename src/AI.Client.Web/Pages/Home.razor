        _replaceSourceId = message.Id;
        _forkSourceId = null;
        _branchLeafId = message.ParentId;
        _chat.Message = message.Content;
        _composerNeedsResize = true;
        if (_composerHandle is not null) await _composerHandle.InvokeVoidAsync("focus");
    }

