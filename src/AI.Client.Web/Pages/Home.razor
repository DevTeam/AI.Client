@page "/"
@using System.Diagnostics.CodeAnalysis
@using System.Text.Json
@using AI.Client.Web.State
@inject IClientMetadata ClientMetadata
@inject IProjectApi ProjectApi
@inject IChatHistoryApi ChatHistoryApi
@inject IJSRuntime JsRuntime
@inject IWorkspaceLayoutService WorkspaceLayoutService
@inject IWorkspaceStateService WorkspaceStateService
@inject IGlobalSettingsApi GlobalSettingsApi
@inject IChatRunsApi ChatRunsApi
@inject RunStateService RunState
@inject IChatComposerService Composer
@implements IAsyncDisposable

<PageTitle>@ClientMetadata.ProductName</PageTitle>

<main class="workspace-shell" @ref="_workspace">
    <aside class="workspace-sidebar">
        <div class="sidebar-projects">
        @* The projects list is the sidebar's top level now, so it has no heading of its own and
           nothing to collapse it into. Creating a project is an action row at the head of the
           list — the position the button already occupied, minus the section chrome around it. *@
        @* Search sits above the list it replaces: while a query is running the sidebar shows what
           was found instead of the tree, because the two answer the same question. *@
        <div class="sidebar-search">
            @* A search input clears itself, so no button of ours is added next to the one the
               browser already draws; Escape does the same from the keyboard. *@
            <input type="search" class="sidebar-search-input" value="@_searchQuery" @oninput="OnSearchInput" @onkeydown="OnSearchKeyDown" placeholder="Search messages" aria-label="Search messages in all chats" />
        </div>
        @if (_searchResult is { } found)
        {
            <div class="sidebar-search-results">
                @if (_isSearching) { <p class="empty-hint">Searching...</p> }
                else if (found.Error is { Length: > 0 } searchError) { <p class="empty-hint">@searchError</p> }
                else if (found.Matches.Count == 0) { <p class="empty-hint">Nothing found in @found.ChatsSearched chat(s).</p> }
                else
                {
                    <p class="empty-hint">@found.Matches.Count match(es) in @found.ChatsSearched chat(s)@(found.Truncated ? ", more remain" : string.Empty)</p>
                    @foreach (var match in found.Matches)
                    {
                        <button class="search-result" type="button" @onclick="() => OpenSearchMatchAsync(match)">
                            <span class="search-result-where">@match.ProjectName · @match.ChatTitle</span>
                            <span class="search-result-snippet">@match.Snippet</span>
                            <span class="search-result-meta">@match.Role · @match.CreatedAt.LocalDateTime.ToString("g")@(match.MatchCount > 1 ? $" · {match.MatchCount} matches" : string.Empty)</span>
                        </button>
                    }
                }
            </div>
        }
        <div id="projects-nav" hidden="@(_searchResult is not null)">
        <button class="workspace-nav-item new-project-action" type="button" @onclick="BeginProjectCreation"><AppIcon Name="plus" /><span class="nav-item-label">New project</span></button>
        @if (ProjectsBusy.IsVisible)
        {
            <div class="sidebar-skeleton" role="status" aria-label="Loading projects">
                @for (var row = 0; row < SkeletonProjectRows; row++)
                {
                    <div class="sidebar-skeleton-row" aria-hidden="true"><span class="sidebar-skeleton-mark"></span><span class="sidebar-skeleton-label"></span></div>
                }
            </div>
        }
        @if (_isCreatingProject)
        {
            <div class="project-nav-row project-nav-row-new">
                <input class="sidebar-inline-editor" @ref="_editingInput" value="@_newProjectName" @oninput="e => _newProjectName = e.Value?.ToString() ?? string.Empty" @onkeydown="HandleNewProjectKeyDownAsync" @onblur="SaveNewProjectAsync" placeholder="Project name" aria-label="Project name" />
            </div>
        }
        @foreach (var project in _projects)
        {
            <div @key="project.Id" class="project-nav-row @(_globalSection is null && project.Id == _selectedProject?.Id ? "selected" : string.Empty) @(_draggedProjectId == project.Id ? "dragging" : string.Empty)" title="@GetProjectRunTitle(project.Id)" draggable="true" @ondragstart="() => OnProjectDragStart(project.Id)" @ondragover="OnDragOver" @ondragover:preventDefault="true" @ondrop="() => OnProjectDrop(project)" @oncontextmenu="() => OnProjectContextMenu(project)" @oncontextmenu:preventDefault="true">
                @if (_editingProjectId == project.Id)
                {
                    <input class="sidebar-inline-editor" @ref="_editingInput" value="@_editingTitle" @oninput="e => _editingTitle = e.Value?.ToString() ?? string.Empty" @onkeydown="e => HandleInlineEditKeyAsync(e, () => SaveProjectTitleAsync(project))" @onblur="() => SaveProjectTitleAsync(project)" aria-label="Project name" />
                }
                else
                {
                    <button class="workspace-nav-item" type="button" aria-keyshortcuts="Alt+ArrowUp Alt+ArrowDown" @onkeydown="e => HandleProjectItemKeyDownAsync(e, project)" @onclick="() => SelectProjectAsync(project, restoreLastChat: false)"><span class="status-dot @GetProjectStatusClass(project.Id)"></span><span class="nav-item-label">@project.Name</span></button>
                }
                <button class="icon-action project-action-button project-new-chat-button" type="button" title="New chat" aria-label="New chat" @onclick="() => CreateChatForProjectAsync(project)"><AppIcon Name="plus" /></button>
                <button class="icon-action project-action-button project-rename-button" type="button" title="Rename" aria-label="Rename project" @onclick="() => BeginProjectRenameAsync(project)"><AppIcon Name="edit" /></button>
                <button class="icon-action project-action-button project-menu-button @(_isProjectMenuOpen && project.Id == _selectedProject?.Id ? "menu-open" : string.Empty)" type="button" title="Project settings" aria-label="Project settings" @onclick="() => ToggleProjectMenuAsync(project)"><AppIcon Name="more" /></button>
            </div>
            @if (project.Id == _selectedProject?.Id)
            {
                <nav class="workspace-chat-list" aria-label="Chats in @project.Name" @onkeydown="OnChatListKeyDown">
                    @{
                        var orderedChats = GetOrderedChats();
                        var visibleChatCount = GetVisibleChatCount(orderedChats);
                        var hiddenChatCount = orderedChats.Count - visibleChatCount;
                        var hiddenChatAttention = hiddenChatCount > 0 ? CountHiddenChatsNeedingAttention(orderedChats, visibleChatCount) : 0;
                    }
                    @foreach (var chat in orderedChats.Take(visibleChatCount))
                    {
                        var branchCount = GetBranchCount(chat);
                        <div @key="chat.Id" class="chat-nav-row @(_globalSection is null && chat.Id == _selectedChat?.Id && GetSelectedBranchId() is null ? "selected" : string.Empty) @(_draggedChatId == chat.Id ? "dragging" : string.Empty)" title="@GetRunTitle(chat.Id, chat.Id, GetRun(chat.Id, chat.Id))" draggable="true" @ondragstart="() => OnChatDragStart(chat.Id)" @ondragover="OnDragOver" @ondragover:preventDefault="true" @ondrop="() => OnChatDrop(chat)" @oncontextmenu="() => OnChatContextMenu(chat.Id)" @oncontextmenu:preventDefault="true">
                            @if (_editingChatId == chat.Id)
                            {
                                <input class="sidebar-inline-editor chat-link" @ref="_editingInput" value="@_editingTitle" @oninput="e => _editingTitle = e.Value?.ToString() ?? string.Empty" @onkeydown="e => HandleInlineEditKeyAsync(e, () => SaveChatTitleAsync(chat))" @onblur="() => SaveChatTitleAsync(chat)" aria-label="Chat name" />
                            }
                            else
                            {
                                <button class="workspace-nav-item chat-link" type="button" aria-keyshortcuts="Alt+ArrowUp Alt+ArrowDown" @onkeydown="e => HandleChatItemKeyDownAsync(e, chat)" @onclick="() => SelectChatAsync(chat.Id)"><span class="chat-icon-with-branch-count"><AppIcon Name="@(chat.IsPinned ? "pin" : "message-circle")" Class="@GetRunStatusClass(chat.Id, chat.Id, GetRun(chat.Id, chat.Id))" />@if (branchCount > 0) { <span class="chat-branch-count @GetChatBranchStatusClass(chat.Id)" title="@GetChatBranchCountTitle(chat, branchCount)">@FormatBranchCount(branchCount)</span> }</span><span class="nav-item-label">@chat.Title</span>@if (branchCount > 0) { <span class="visually-hidden">, @GetBranchCountTitle(branchCount)</span> }</button>
                            }
                            <button class="icon-action chat-row-action chat-pin-button @(chat.IsPinned ? "pinned" : string.Empty)" type="button" title="@(chat.IsPinned ? "Unpin chat" : "Pin chat")" aria-label="@(chat.IsPinned ? "Unpin chat" : "Pin chat")" @onclick="() => ToggleChatPinAsync(chat)"><AppIcon Name="pin" /></button>
                            <button class="icon-action chat-row-action" type="button" title="Rename" aria-label="Rename chat" @onclick="() => BeginChatRename(chat)"><AppIcon Name="edit" /></button>
                            <button class="icon-action chat-row-action chat-menu-button @(_chatMenuId == chat.Id ? "menu-open" : string.Empty)" type="button" title="Chat menu" aria-label="Chat menu" @onclick="() => ToggleChatMenu(chat.Id)"><AppIcon Name="more" /></button>
                            @if (_chatMenuId == chat.Id)
                            {
                                <div class="chat-menu" role="menu" @onclick:stopPropagation="true">
                                    <button type="button" role="menuitem" @onclick="() => ToggleChatPinAsync(chat)">
                                        <AppIcon Name="pin" />
                                        <span>@(chat.IsPinned ? "Unpin chat" : "Pin chat")</span>
                                    </button>
                                    <button type="button" role="menuitem" @onclick="() => OpenChatPermissions(chat)">
                                        <AppIcon Name="tool" />
                                        <span>Tool permissions</span>
                                        @if (GetChatPermissionCount(chat.Id) > 0)
                                        {
                                            <span class="menu-count">@GetChatPermissionCount(chat.Id)</span>
                                        }
                                    </button>
                                    @if (_isConfirmingChatDelete)
                                    {
                                        <div class="project-menu-confirm"><span>Delete this chat and all its branches?</span><button class="danger compact-action" type="button" @onclick="() => DeleteChatAsync(chat)">Delete</button><button class="secondary-action compact-action" type="button" @onclick="CancelChatDelete">Cancel</button></div>
                                    }
                                    else
                                    {
                                        <button class="menu-danger" type="button" role="menuitem" @onclick="ConfirmChatDelete"><AppIcon Name="trash" />Delete chat</button>
                                    }
                                </div>
                            }
                        </div>
                        @if (_selectedChat?.Id == chat.Id)
                        {
                            @foreach (var branch in GetBranchTreeItems())
                            {
                                <div class="chat-nav-row branch-nav-row @(GetSelectedBranchId() == branch.RootId ? "selected" : string.Empty)" title="@GetRunTitle(chat.Id, branch.RootId, GetBranchRun(chat.Id, branch))" style="--branch-depth: @Math.Min(branch.Depth, 3)">
                                    <span class="branch-tree-line" aria-hidden="true"></span>
                                    @if (_editingBranchId == branch.RootId)
                                    {
                                        <input class="sidebar-inline-editor chat-link" @ref="_editingInput" value="@_editingTitle" @oninput="e => _editingTitle = e.Value?.ToString() ?? string.Empty" @onkeydown="e => HandleInlineEditKeyAsync(e, () => SaveBranchTitleAsync(branch))" @onblur="() => SaveBranchTitleAsync(branch)" aria-label="Branch name" />
                                    }
                                    else
                                    {
                                        <button class="workspace-nav-item chat-link branch-link" type="button" @onclick="() => SelectBranchTreeItemAsync(branch)"><AppIcon Name="git-branch" Class="@GetRunStatusClass(chat.Id, branch.RootId, GetBranchRun(chat.Id, branch))" /><span class="nav-item-label">@branch.Title</span></button>
                                    }
                                    <button class="icon-action chat-row-action" type="button" title="Rename" aria-label="Rename branch" @onclick="() => BeginBranchRename(branch)"><AppIcon Name="edit" /></button>
                                    <button class="icon-action chat-row-action chat-menu-button @(_branchMenuId == branch.RootId ? "menu-open" : string.Empty)" type="button" title="Branch menu" aria-label="Branch menu" @onclick="() => ToggleBranchMenu(branch.RootId)"><AppIcon Name="more" /></button>
                                    @if (_branchMenuId == branch.RootId)
                                    {
                                        <div class="chat-menu" role="menu" @onclick:stopPropagation="true">
                                            @if (_confirmingBranchDeleteId == branch.RootId)
                                            {
                                                <div class="project-menu-confirm"><span>Delete this branch?</span><button class="danger compact-action" type="button" @onclick="() => DeleteBranchAsync(branch)">Delete</button><button class="secondary-action compact-action" type="button" @onclick="CancelBranchDelete">Cancel</button></div>
                                            }
                                            else
                                            {
                                                <button class="menu-danger" type="button" role="menuitem" @onclick="() => ConfirmBranchDelete(branch.RootId)"><AppIcon Name="trash" />Delete branch</button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                    @if (hiddenChatCount > 0 || _visibleChatCount > ChatPageSize)
                    {
                        <div class="chat-list-pager">
                            @if (hiddenChatCount > 0)
                            {
                                <button class="workspace-nav-item chat-list-more" type="button" @onclick="ShowMoreChats" aria-label="@GetShowMoreChatsLabel(hiddenChatCount, hiddenChatAttention)"><span class="nav-item-label">Show @hiddenChatCount more</span>@if (hiddenChatAttention > 0) { <span class="chat-list-more-attention" title="@GetHiddenAttentionTitle(hiddenChatAttention)" aria-hidden="true">@FormatBranchCount(hiddenChatAttention)</span> }</button>
                            }
                            @if (_visibleChatCount > ChatPageSize)
                            {
                                <button class="workspace-nav-item chat-list-less" type="button" @onclick="ShowFewerChats" aria-label="Show fewer chats"><span class="nav-item-label">Less</span></button>
                            }
                        </div>
                    }
                    @if (ChatsBusy.IsVisible)
                    {
                        <div class="sidebar-skeleton" role="status" aria-label="Loading chats">
                            @for (var row = 0; row < SkeletonChatRows; row++)
                            {
                                <div class="sidebar-skeleton-row" aria-hidden="true"><span class="sidebar-skeleton-mark"></span><span class="sidebar-skeleton-label"></span></div>
                            }
                        </div>
                    }
                    else if (_chats.Count == 0) { <span class="empty-hint">No chats yet</span> }
                </nav>
                <div class="directory-nav-group">
                    @if (_security.DirectoryGrants.Count == 0)
                    {
                        <button class="workspace-nav-item directory-empty-action" type="button" @onclick="BeginDirectoryCreation">
                            <AppIcon Name="folder-plus" />
                            <span class="nav-item-label">Add directory</span>
                        </button>
                    }
                    else
                    {
                        <div class="directory-nav-row directory-nav-row-header">
                            <span class="directory-row-main">
                                <button class="icon-action directory-toggle" type="button" aria-expanded="@_directoriesExpanded" aria-label="Toggle directories" @onclick="ToggleDirectoriesExpanded"><AppIcon Name="@(_directoriesExpanded ? "chevron-down" : "chevron-right")" /></button>
                                <AppIcon Name="folder" />
                                <span class="nav-item-label directory-label">Directories</span>
                                <span class="directory-count">@_security.DirectoryGrants.Count</span>
                            </span>
                            <button class="icon-action directory-row-action directory-add-button" type="button" title="Add directory" aria-label="Add directory" @onclick="BeginDirectoryCreation"><AppIcon Name="plus" /></button>
                        </div>
                        @if (_directoriesExpanded)
                        {
                            @foreach (var directory in _security.DirectoryGrants)
                            {
                                <div class="directory-nav-row directory-nav-row-child">
                                    @if (_editingDirectoryId == directory.Id)
                                    {
                                        <input class="sidebar-inline-editor directory-path-editor" @ref="_editingInput" value="@_editingDirectoryPath" @oninput="e => _editingDirectoryPath = e.Value?.ToString() ?? string.Empty" @onkeydown="e => HandleInlineEditKeyAsync(e, () => SaveDirectoryPathAsync(directory))" @onblur="() => SaveDirectoryPathAsync(directory)" aria-label="Directory path" />
                                    }
                                    else
                                    {
                                        <span class="directory-row-main">
                                            <span class="nav-item-label directory-name" title="@directory.CanonicalRoot">@GetDirectoryDisplayNameSuggestion(directory.CanonicalRoot)</span>
                                        </span>
                                    }
                                    <button class="directory-lock-indicator @(directory.Mode == "Read/write" ? "directory-lock-rw" : "directory-lock-ro")" type="button" title="@(directory.Mode == "Read/write" ? "Read/write — click to make read only" : "Read only — click to allow write")" aria-label="Toggle directory access mode" @onclick="() => ToggleDirectoryModeAsync(directory)"><AppIcon Name="@(directory.Mode == "Read/write" ? "unlock" : "lock")" /></button>
                                    <button class="icon-action directory-row-action directory-edit-button" type="button" title="Edit directory path" aria-label="Edit directory path" @onclick="() => BeginDirectoryPathEdit(directory)"><AppIcon Name="edit" /></button>
                                    <button class="icon-action directory-row-action directory-menu-button @(_directoryMenuId == directory.Id ? "menu-open" : string.Empty)" type="button" title="Directory menu" aria-label="Directory menu" @onclick="() => ToggleDirectoryMenu(directory.Id)"><AppIcon Name="more" /></button>
                                    @if (_directoryMenuId == directory.Id)
                                    {
                                        <div class="chat-menu" role="menu" @onclick:stopPropagation="true">
                                            @if (_isConfirmingDirectoryDelete)
                                            {
                                                <div class="project-menu-confirm"><span>Remove this directory?</span><button class="danger compact-action" type="button" @onclick="() => RemoveDirectoryGrantAsync(directory.Id)">Delete</button><button class="secondary-action compact-action" type="button" @onclick="CancelDirectoryDelete">Cancel</button></div>
                                            }
                                            else
                                            {
                                                <button class="menu-danger" type="button" role="menuitem" @onclick="ConfirmDirectoryDelete"><AppIcon Name="trash" />Remove directory</button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                </div>
            }
        }
        </div>
        <span class="visually-hidden" role="status" aria-live="polite">@_sidebarAnnouncement</span>
        </div>
        <nav class="global-nav root-nav sidebar-global-nav" aria-label="Application settings">
            <button class="workspace-nav-item @(_globalSection == "Connections" ? "selected" : string.Empty)" type="button" @onclick='() => OpenGlobalSection("Connections")'><AppIcon Name="connection" /><span>Connections</span><span class="directory-count">@_connections.Count(item => item.Enabled)</span></button>
            <button class="workspace-nav-item @(_globalSection == "MCP" ? "selected" : string.Empty)" type="button" @onclick='() => OpenGlobalSection("MCP")'><AppIcon Name="mcp" /><span>MCP</span><span class="directory-count">@_enabledMcpServerCount</span></button>
        </nav>
    </aside>

    <div class="workspace-resizer" data-side="left" role="separator" aria-label="Resize project sidebar"></div>

    @if (_globalSection is not null)
    {
        <GlobalSettingsPanel Section="@_globalSection" Saved="LoadGlobalSettingsAsync" />
    }
    else
    {
    <section class="workspace-conversation" aria-label="Chat">
        <MessageFeed @ref="_messageFeed"
            HasSelectedProject="@(_selectedProject is not null)"
            SelectedProjectName="@_selectedProject?.Name"
            SelectedChat="@_selectedChat"
            BranchLeafId="@_branchLeafId"
            JustArrivedLeafId="@_justArrivedLeafId"
            ForkSourceId="@_forkSourceId"
            MessageBranchMenuId="@_messageBranchMenuId"
            SelectedRun="@GetSelectedRun()"
            TranscriptRunPresentationVersion="@GetTranscriptRunPresentationVersion()"
            GetRunForBranch="@(messageId => _selectedChat is null ? null : GetRun(_selectedChat.Id, BranchLeafHelpers.RunBranchIdFor(messageId, _selectedChat)))"
            OnCopyMessage="CopyMessageAsync"
            OnForkFromMessage="ForkFromMessageAsync"
            OnEditAndBranch="EditAndBranchAsync"
            OnEditAndReplaceBranch="EditAndReplaceBranchAsync"
            OnToggleBranchMenu="ToggleMessageBranchMenu"
            OnSelectBranch="SelectMessageBranch"
            OnBranchPickerKeyDown="HandleBranchPickerKeyDown"
            OnResumeRun="ResumeQueueAsync"
            OnRebaseRun="RebaseQueueAsync"
            OnDiscardRun="DiscardCommandAsync" />
        @if (GetSelectedRun() is { } selectedRun && GetPendingQueue(selectedRun) is { Count: > 0 } pendingQueue)
        {
            @* Only what has not been sent yet. A command that is already a message in the
               transcript belongs to the turn chip above, not to a list whose every row promises
               that it can still be edited, reordered or removed. *@
            <section class="chat-queue"><div class="queue-header"><button class="queue-summary" type="button" aria-expanded="@(_isQueueExpanded ? "true" : "false")" @onclick="() => _isQueueExpanded = !_isQueueExpanded"><AppIcon Name="queue" /><span>Queued · @pendingQueue.Count</span><AppIcon Name="chevron-right" /></button><div class="queue-actions">@if (_isConfirmingQueueClearAll) { <span class="queue-clear-confirm"><span>Stop the run and drop everything?</span><button class="danger compact-action" type="button" @onclick="ClearEverythingAsync">Clear all</button><button class="secondary-action compact-action" type="button" @onclick="() => _isConfirmingQueueClearAll = false">Cancel</button></span> } else { <button type="button" class="queue-action-button queue-action-clear" title="@($"Remove the {pendingQueue.Count} message(s) still waiting in the queue")" aria-label="Clear queued messages" @onclick="ClearQueueAsync"><AppIcon Name="x" /></button>@if (HasCommittedCommand(selectedRun)) { <button type="button" class="queue-action-button destructive-action" title="Stop the run and clear everything, including the message already sent" aria-label="Stop and clear everything" @onclick="() => _isConfirmingQueueClearAll = true"><AppIcon Name="trash" /></button> } }</div></div>@if (_isQueueExpanded) { <div class="queue-items">@foreach (var item in pendingQueue) { <div @key="item.Id" class="queue-item" data-queue-id="@item.Id">@if (_editingQueueId == item.Id) { <input value="@_editingQueueText" @oninput="args => _editingQueueText = args.Value?.ToString() ?? string.Empty" @onkeydown="args => HandleQueueEditKeyAsync(args, item.Id)" @onblur="() => SaveQueuedMessageAsync(item.Id)" autofocus /> } else { <button class="queue-drag-handle" type="button" title="Drag to reorder" aria-label="Drag queued message"><AppIcon Name="drag" /></button><span title="@item.Content">@GetSingleLine(item.Content)</span><button class="icon-action" type="button" title="Move up" aria-label="Move up" @onclick="() => MoveQueuedMessageAsync(item.Id, -1)"><AppIcon Name="chevron-up" /></button><button class="icon-action" type="button" title="Move down" aria-label="Move down" @onclick="() => MoveQueuedMessageAsync(item.Id, 1)"><AppIcon Name="chevron-down" /></button><button class="icon-action" type="button" title="Edit queued message" aria-label="Edit queued message" @onclick="() => BeginQueueEdit(item)"><AppIcon Name="edit" /></button><button class="icon-action destructive-action" type="button" title="Remove queued message" aria-label="Remove queued message" @onclick="() => RemoveQueuedMessageAsync(item.Id)"><AppIcon Name="trash" /></button> }</div> }</div> }</section>
        }
        <div class="composer-status" role="status">
            @* While the composer shows a history entry the counter comes first and the plain
               hint is dropped — the hint describes what Enter does with text the user wrote,
               and that is no longer the interesting thing on screen. A fork/replace/generating
               chip still wins the line; the counter just prefixes it. *@
            @if (_composerHistoryNavigator.Index is { } historyIndex) { <span class="composer-history-counter">History @(historyIndex + 1)/@GetComposerHistory().Count</span> }
            @* Held states carry no status word: the turn chip above already names the state and,
               for a failure, its reason. This line says only what the Enter key will do. *@
            @if (GetSelectedRun()?.Status == ChatRunStatus.Generating) { <span>@($"Generating{(GetGeneratingElapsed() is { } elapsed ? $"... {FormatElapsed(elapsed)}" : "...")}{GetGeneratingEnterHint()}")</span> }
            else if (GetSelectedRun() is { Status: ChatRunStatus.Paused or ChatRunStatus.Interrupted } heldRun) { <span>@GetHeldRunEnterHint(heldRun)</span> }
            else if (GetSelectedRun() is { Status: ChatRunStatus.Failed } failedRun) { <span class="error">@GetHeldRunEnterHint(failedRun)</span> }
            else if (GetReplaceSource() is { } replaceSource) { <span class="fork-mode replace-mode"><AppIcon Name="edit-replace" /><span>Replacing branch from “@GetMessagePreview(replaceSource.Content)”</span><button class="icon-action" type="button" title="Cancel replacement" aria-label="Cancel replacement" @onclick="CancelBranchOperation"><AppIcon Name="x" /></button></span> }
            else if (GetForkSource() is { } forkSource) { <span class="fork-mode"><AppIcon Name="fork" /><span>Forking from “@GetMessagePreview(forkSource.Content)”</span><button class="icon-action" type="button" title="Cancel fork" aria-label="Cancel fork" @onclick="CancelBranchOperation"><AppIcon Name="x" /></button></span> }
            else if (!_composerHistoryNavigator.IsActive) { <span>@GetComposerHint()</span> }
        </div>
        <footer class="workspace-composer">
            <textarea @ref="_composer" value="@_chat.Message" @oninput="OnComposerInput" @onkeydown="HandleComposerKeyDown" placeholder="@(_replaceSourceId is not null ? "Edit the message to replace this branch..." : _forkSourceId is not null ? "Write the first message in the new branch..." : "Message the assistant...")" aria-label="Message"></textarea>
            <div class="composer-footer">
                <div class="composer-endpoint">
                    <button class="composer-endpoint-trigger" type="button" title="Endpoint for this chat" aria-label="Endpoint for this chat" aria-haspopup="true" aria-expanded="@(_isEndpointMenuOpen ? "true" : "false")" @onclick="ToggleEndpointMenu" disabled="@(_connections.Count == 0)">
                        <span>@GetEndpointDisplayName()</span>
                        <AppIcon Name="chevron-down" />
                    </button>
                    @if (_isEndpointMenuOpen)
                    {
                        <div class="context-menu-backdrop" @onclick="CloseEndpointMenu"></div>
                        <span class="composer-endpoint-menu" role="menu">
                            @foreach (var connection in _connections.Where(item => item.Enabled))
                            {
                                var isSelected = connection.Id == _chat.CredentialProfileId;
                                <button type="button" role="menuitem" class="@(isSelected ? "selected" : string.Empty)" @onclick="() => SelectChatEndpointAsync(connection.Id)">
                                    @if (isSelected) { <AppIcon Name="check" /> } else { <span class="branch-option-spacer"></span> }
                                    <span>@connection.Name</span>
