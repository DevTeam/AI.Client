    private async Task CreateChatAsync()
    {
        if (_selectedProject is null) return;
        _globalSection = null;
        _attachComposer = true;
        _selectedChat = null;
        _branchLeafId = null;
        if (_defaultEndpointProfileId is { } endpointId)
        {
            SelectChatProfile(new ChangeEventArgs { Value = endpointId.ToString() });
        }
        _chat.Message = string.Empty;
        if (_composerHandle is not null) await _composerHandle.InvokeVoidAsync("focus");
    }

    private async Task SelectChatAsync(Guid chatId)
    {
        _globalSection = null;
        _attachComposer = true;
        CloseContextMenus();
        if (_selectedProject is not null)
        {
            _selectedChat = await ChatHistoryApi.GetAsync(_selectedProject.Id, chatId, CancellationToken.None);
            _branchLeafId = GetOriginalBranchLeaf(_selectedChat);
            if (_selectedChat?.EndpointProfileId is { } endpointId)
            {
                SelectChatProfile(new ChangeEventArgs { Value = endpointId.ToString() });
            }
            _scrollMessagesToBottom = true;
            await MarkSelectedChatReadAsync();
        }
    }

    private ChatRunSnapshot? GetRun(Guid chatId, Guid branchId) => _runs.GetValueOrDefault(new RunKey(chatId, branchId));
    private ChatRunSnapshot? GetBranchRun(Guid chatId, BranchTreeItem branch)
    {
        var direct = GetRun(chatId, branch.RootId);
        if (direct is not null) return direct;
        return null;
    }
    private ChatRunSnapshot? GetSelectedRun()
    {
        if (_selectedChat is null) return null;
        return GetRun(_selectedChat.Id, GetSelectedRunBranchId());
    }
    private void StoreRun(ChatRunSnapshot run)
    {
        var key = new RunKey(run.ChatId, run.BranchId);
        if (!_runs.TryGetValue(key, out var current) || run.Revision >= current.Revision)
        {
            _runs[key] = run;
        }
    }
    // Generating is a live state and always shown; every other status (Paused/Interrupted/Failed,
    // same as Completed) is only shown while unread — MarkRead() (called as soon as the chat is
    // opened) clears it, so it never lingers after being seen once.
    private static bool IsVisibleRun(ChatRunSnapshot run) => run.Status == ChatRunStatus.Generating || run.HasUnreadResponse;
    private BranchTreeItem? GetSelectedBranchItem()
    {
        if (_selectedChat is null || _branchLeafId is null) return null;
        return GetBranchTreeItems()
            .Where(branch => IsMessageInBranch(_branchLeafId.Value, branch.RootId))
            .OrderByDescending(branch => branch.Depth)
            .ThenByDescending(branch => branch.RootId)
            .FirstOrDefault();
    }

    private Guid? GetSelectedBranchId() => GetSelectedBranchItem()?.RootId;

    private string? GetContextBranchTitle() =>
        _selectedChat is null ? null : GetSelectedBranchItem()?.Title ?? _selectedChat.Title;
    private Guid GetSelectedRunBranchId() => _selectedChat is null ? Guid.Empty : GetSelectedBranchId() ?? _selectedChat.Id;
    private ChatRunSnapshot? GetProjectRun(Guid projectId) => GetProjectRuns(projectId)
        .Where(IsVisibleRun)
        .OrderBy(item => item.Status == ChatRunStatus.Failed ? 0 : item.Status == ChatRunStatus.Generating ? 1 : item.HasUnreadResponse ? 2 : 3)
        .FirstOrDefault();
    private string GetProjectRunTooltip(Guid projectId) { var runs = GetProjectRuns(projectId).ToArray(); return $"{runs.Count(item => item.Status == ChatRunStatus.Generating)} generating · {runs.Count(item => item.HasUnreadResponse)} unread · {runs.Count(item => item.Status == ChatRunStatus.Failed)} failed"; }
    private IEnumerable<ChatRunSnapshot> GetProjectRuns(Guid projectId)
    {
        return _runs.Values.Where(run => run.ProjectId == projectId);
    }
    private string? GetProjectRunTitle(Guid projectId) => GetProjectRun(projectId) is null ? null : GetProjectRunTooltip(projectId);
    private static string? GetRunTitle(ChatRunSnapshot? run) => run is null || !IsVisibleRun(run) ? null : GetRunTooltip(run);
    private static string GetRunStatusClass(ChatRunSnapshot? run) => run switch
    {
        // A property pattern never matches null, so without this explicit case a null run
        // (e.g. GetProjectRun found nothing visible) fell through to the `_` arm below and was
        // incorrectly classified as unread instead of "no status at all".
        null => string.Empty,
        { Status: ChatRunStatus.Generating } => "run-status-generating",
        { HasUnreadResponse: false } => string.Empty,
        { Status: ChatRunStatus.Failed } => "run-status-failed",
        { Status: ChatRunStatus.Interrupted or ChatRunStatus.Paused } => "run-status-interrupted",
        _ => "run-status-unread"
    };
    private static string GetRunTooltip(ChatRunSnapshot run) => run.HasUnreadResponse ? $"{run.Status} · unread response" : run.Status.ToString();

    private async Task MarkSelectedChatReadAsync()
    {
        if (_selectedProject is null || _selectedChat is null || GetSelectedRun()?.HasUnreadResponse != true) return;
        var snapshot = await ChatRunsApi.MarkReadAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), Guid.CreateVersion7(), CancellationToken.None);
        if (snapshot is not null) StoreRun(snapshot);
    }

    private void BeginQueueEdit(QueuedChatMessage item) { _editingQueueId = item.Id; _editingQueueText = item.Content; }
    private async Task HandleQueueEditKeyAsync(KeyboardEventArgs args, Guid id)
    {
        if (args.Key == "Enter") await SaveQueuedMessageAsync(id);
        else if (args.Key == "Escape") _editingQueueId = null;
    }
    private async Task SaveQueuedMessageAsync(Guid id)
    {
        if (_editingQueueId != id || _selectedProject is null || _selectedChat is null) return;
        var snapshot = await ChatRunsApi.UpdateQueuedAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), id, new UpdateQueuedMessageRequest(Guid.CreateVersion7(), _editingQueueText), CancellationToken.None);
        if (snapshot is not null) StoreRun(snapshot);
        _editingQueueId = null;
    }
    private async Task MoveQueuedMessageAsync(Guid id, int offset)
    {
        if (_selectedProject is null || _selectedChat is null || GetSelectedRun() is not { } run) return;
        var position = run.Queue.ToList().FindIndex(item => item.Id == id) + offset;
        var snapshot = await ChatRunsApi.UpdateQueuedAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), id, new UpdateQueuedMessageRequest(Guid.CreateVersion7(), Position: position), CancellationToken.None);
        if (snapshot is not null) StoreRun(snapshot);
    }
    [JSInvokable]
    public async Task DropQueuedMessageAsync(string draggedValue, string targetValue)
    {
        if (!Guid.TryParse(draggedValue, out var draggedId) || !Guid.TryParse(targetValue, out var targetId) || draggedId == targetId || GetSelectedRun() is not { } run) return;
        var position = run.Queue.ToList().FindIndex(item => item.Id == targetId);
        if (_selectedProject is null || _selectedChat is null || position < 0) return;
        var snapshot = await ChatRunsApi.UpdateQueuedAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), draggedId, new UpdateQueuedMessageRequest(Guid.CreateVersion7(), Position: position), CancellationToken.None);
        if (snapshot is not null) StoreRun(snapshot);
    }
    private async Task RemoveQueuedMessageAsync(Guid id)
    {
        if (_selectedProject is null || _selectedChat is null) return;
        var snapshot = await ChatRunsApi.RemoveQueuedAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), id, Guid.CreateVersion7(), CancellationToken.None);
        if (snapshot is not null) StoreRun(snapshot);
    }
    private async Task ResumeQueueAsync() { if (_selectedProject is null || _selectedChat is null) return; var snapshot = await ChatRunsApi.ResumeAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), Guid.CreateVersion7(), CancellationToken.None); if (snapshot is not null) StoreRun(snapshot); }
    private async Task ClearQueueAsync() { if (_selectedProject is null || _selectedChat is null) return; var snapshot = await ChatRunsApi.ClearAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), Guid.CreateVersion7(), CancellationToken.None); if (snapshot is not null) StoreRun(snapshot); }
    private async Task EnableNotificationsAsync() { if (_runEventsModule is null) return; _notificationsEnabled = await _runEventsModule.InvokeAsync<string>("enableNotifications") == "granted"; }

