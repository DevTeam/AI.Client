            // bumped (so a stale push without a new message doesn't re-trigger), and only on the
            // currently selected chat so we don't draw lines on a chat the user isn't looking at.
            _wasGeneratingByBranch.TryGetValue(snapshot.BranchId, out var wasGenerating);
