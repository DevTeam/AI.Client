    private sealed class ProjectEditor
    {
        public ProjectEditor()
        {
        }

        public ProjectEditor(string name, string description, long revision)
        {
            Name = name;
            Description = description;
            Revision = revision;
        }

        public string Name { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;

        public long Revision { get; set; }

        public Guid? ConnectionId { get; set; }
    }

    private sealed class ProjectSecurityEditor
    {
        private long Revision { get; init; }

        public List<DirectoryGrantEditor> DirectoryGrants { get; } = [];

        public List<McpServerEditor> McpServers { get; } = [];

        public List<ToolPolicyEditor> ToolPolicies { get; } = [];

        public static ProjectSecurityEditor From(ProjectDetails project)
        {
            var editor = new ProjectSecurityEditor { Revision = project.Revision };
            editor.DirectoryGrants.AddRange(project.DirectoryGrants.Select(item => new DirectoryGrantEditor
            {
                Id = item.Id,
                DisplayName = item.DisplayName,
                CanonicalRoot = item.CanonicalRoot,
                Recursive = item.Recursive,
                ToolNames = string.Join(", ", item.ToolNames),
                Mode = item.ToolNames.Contains("write", StringComparer.OrdinalIgnoreCase) ? "Read/write" : "Read only"
            }));
            editor.McpServers.AddRange(project.McpServers.Select(item => new McpServerEditor
            {
                Id = item.Id,
                DisplayName = item.DisplayName,
                Transport = item.Transport,
                Enabled = item.Enabled
            }));
            editor.ToolPolicies.AddRange(project.ToolPolicies.Select(item => new ToolPolicyEditor
            {
                ServerId = item.ServerId,
                Name = item.Name,
                SchemaHash = item.SchemaHash,
                Decision = item.Decision,
                MaxCallsPerRun = item.MaxCallsPerRun,
                TimeoutSeconds = item.TimeoutSeconds
            }));
            return editor;
        }

        public UpdateProjectSecurityRequest ToRequest() => new(
            Revision,
            DirectoryGrants.Select(item => new DirectoryGrantSettings(
                item.Id,
                item.DisplayName,
                item.CanonicalRoot,
                item.Recursive,
                // ReSharper disable once UseCollectionExpression
                item.ToolNames.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))).ToArray(),
            // ReSharper disable once UseCollectionExpression
            McpServers.Select(item => new AI.Client.Contracts.Projects.McpServerSettings(item.Id, item.DisplayName, item.Transport, item.Enabled)).ToArray(),
            ToolPolicies.Select(item => new ToolPolicySettings(
                item.ServerId,
                item.Name,
                item.SchemaHash,
                item.Decision,
                item.MaxCallsPerRun,
                // ReSharper disable once UseCollectionExpression
                item.TimeoutSeconds)).ToArray());
    }

    [SuppressMessage("ReSharper", "PropertyCanBeMadeInitOnly.Local")]
    private sealed class DirectoryGrantEditor
    {
        public Guid Id { get; init; } = Guid.CreateVersion7();

        public string DisplayName { get; set; } = "Directory";

        public string CanonicalRoot { get; set; } = string.Empty;

        public bool Recursive { get; set; } = true;

        public string ToolNames { get; set; } = "read";

        public string Mode
        {
            get => ToolNames.Contains("write", StringComparison.OrdinalIgnoreCase) ? "Read/write" : "Read only";
            set => ToolNames = value == "Read/write" ? "read, write, edit, delete" : "read";
        }
    }

