    private void OnComposerInput(ChangeEventArgs args)
    {
        // Typing detaches the composer from history: the text is the user's own again, so it
        // goes back to being saved as a draft and Up starts a fresh walk from the newest entry.
        _composerHistoryNavigator.Reset();
        _chat.Message = args.Value?.ToString() ?? string.Empty;
        WorkspaceStateService.QueueComposerDraftSave(GetComposerDraftKey(), _chat.Message);
    }

    private string GetComposerDraftKey() => _selectedChat is not null
        ? $"{_selectedChat.Id}:{_branchLeafId}"
        : _selectedProject is not null ? $"new:{_selectedProject.Id}" : string.Empty;

    private void RestoreComposerDraft()
    {
        // The browsing position belongs to the composer the user just left; carrying it across a
        // chat or project switch would have Escape restore a draft that is no longer on screen.
        _composerHistoryNavigator.Reset();
        _chat.Message = WorkspaceStateService.GetComposerDraft(GetComposerDraftKey());
    }

