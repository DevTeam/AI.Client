    {
        if (message.Id == _branchLeafId) return;
        _messageBranchMenuId = null;
        _branchLeafId = message.Id;
        _forkSourceId = message.Id;
        _chat.Message = string.Empty;
        _composerNeedsResize = true;
        if (_composerHandle is not null)
        {
            await _composerHandle.InvokeVoidAsync("focus");
        }
    }

    private void CancelBranchOperation()
    {
        _messageBranchMenuId = null;
        _forkSourceId = null;
        _replaceSourceId = null;
        _branchLeafId = GetOriginalBranchLeaf(_selectedChat);
        _chat.Message = string.Empty;
        _composerNeedsResize = true;
    }

    private ChatMessageView? GetForkSource() =>
        _forkSourceId is { } id ? _selectedChat?.Messages.FirstOrDefault(message => message.Id == id) : null;

    private ChatMessageView? GetReplaceSource() =>
        _replaceSourceId is { } id ? _selectedChat?.Messages.FirstOrDefault(message => message.Id == id) : null;

    private static string GetMessagePreview(string content)
    {
        var text = content.ReplaceLineEndings(" ").Trim();
        return text[..Math.Min(text.Length, 36)] + (text.Length > 36 ? "…" : string.Empty);
    }

    private void SwitchBranch(Guid siblingId)
    {
        if (_selectedChat is null) return;
        var current = siblingId;
        while (true)
        {
            var child = _selectedChat.Messages
                .Where(item => item.ParentId == current)
                .OrderBy(item => item.CreatedAt)
                .FirstOrDefault();
            if (child is null) break;
            current = child.Id;
        }

        _branchLeafId = current;
    }

    private void ToggleMessageBranchMenu(Guid messageId) =>
        _messageBranchMenuId = _messageBranchMenuId == messageId ? null : messageId;

    private void SelectMessageBranch(Guid siblingId)
    {
        SwitchBranch(siblingId);
        _messageBranchMenuId = null;
    }

    private void HandleBranchPickerKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") _messageBranchMenuId = null;
    }

    private void SelectPendingBranchOrLatestMessage()
    {
        if (_selectedChat is null) return;
        if (_pendingBranchAnchorId is { } anchorId)
        {
            var root = _selectedChat.Messages
                .Where(message => message.Id == anchorId && message.Role == "User")
                .FirstOrDefault();
            if (root is not null)
            {
                SwitchBranch(root.Id);
                _pendingBranchAnchorId = null;
                return;
            }
        }
        _branchLeafId = _selectedChat.Messages.LastOrDefault()?.Id;
    }

    private IReadOnlyList<ChatCompletionMessage> BuildCompletionContext()
    {
        if (_selectedChat is null || _branchLeafId is null)
        {
            return [];
        }

        var byId = _selectedChat.Messages.ToDictionary(item => item.Id);
        var branch = new List<ChatCompletionMessage>();
        var currentId = _branchLeafId;
        while (currentId is { } messageId && byId.TryGetValue(messageId, out var message))
        {
            branch.Add(new ChatCompletionMessage(message.Role.ToLowerInvariant(), message.Content));
            currentId = message.ParentId;
        }

        branch.Reverse();
        branch.Add(new ChatCompletionMessage("user", _chat.Message));
        return branch;
