    private async Task SaveDirectoryPathAsync(DirectoryGrantEditor directory)
    {
        if (_editingDirectoryId != directory.Id || _isCompletingInlineEdit) return;
        var path = _editingDirectoryPath.Trim();
        var isCreating = _creatingDirectoryId == directory.Id;
        if (string.IsNullOrEmpty(path) || (!isCreating && string.Equals(path, directory.CanonicalRoot, StringComparison.Ordinal)))
        {
            CancelInlineEdit();
            return;
        }

        _isCompletingInlineEdit = true;
        try
        {
            directory.CanonicalRoot = path;
            directory.DisplayName = GetDirectoryDisplayNameSuggestion(path);
            if (await PersistDirectoryGrantsAsync())
            {
                _creatingDirectoryId = null;
            }
        }
        finally
        {
            _isCompletingInlineEdit = false;
            CancelInlineEdit();
        }
    }

