    }

    private bool IsMessageInBranch(Guid leafId, Guid rootId)
    {
        var byId = _selectedChat!.Messages.ToDictionary(message => message.Id);
        var current = leafId;
        while (byId.TryGetValue(current, out var message)) { if (current == rootId) return true; if (message.ParentId is not { } parent) break; current = parent; }
        return false;
    }

