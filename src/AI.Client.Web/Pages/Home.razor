        if (string.IsNullOrWhiteSpace(_editingTitle)) { CancelInlineEdit(); return; }
        _isCompletingInlineEdit = true;
        try
        {
            var renamed = await ChatHistoryApi.RenameAsync(_selectedProject.Id, chat.Id, new RenameChatRequest(_editingTitle.Trim(), chat.Revision), CancellationToken.None);
            if (renamed is not null) { _selectedChat = renamed; await LoadChatsAsync(_selectedProject.Id); }
