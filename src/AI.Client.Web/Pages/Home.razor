        var refreshedChat = await ChatHistoryApi.GetAsync(_selectedProject.Id, _selectedChat.Id, CancellationToken.None);
        if (refreshedChat is not null)
        {
            _selectedChat = refreshedChat;
        }

        var refreshedBranch = GetBranchTreeItems().FirstOrDefault(item => item.RootId == branch.RootId);
        _selectedBranchId = branch.RootId;
        _branchLeafId = refreshedBranch?.LeafId ?? branch.LeafId;
        RestoreComposerDraft();
        _pendingScrollRestoreKey = GetScrollPositionKey();
        await MarkSelectedChatReadAsync();
        await WorkspaceStateService.SetProjectContextAsync(_selectedProject.Id, _selectedChat.Id, _branchLeafId);
    }

