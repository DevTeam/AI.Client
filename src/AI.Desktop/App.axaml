<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="using:AI.Desktop"
             x:Class="AI.Desktop.App"
             RequestedThemeVariant="Dark">
    <!--
        The window's own brushes, for what shows before the page loads or when it cannot. The values
        follow the page's tokens (app.css): App.ApplyTheme switches between the sets when the page
        changes its theme, and the system titlebar follows the set's light or dark base.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#171717" />
                    <SolidColorBrush x:Key="StatusTitleBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="StatusDetailBrush" Color="#A3A3A3" />
                </ResourceDictionary>
                <!-- The page's dark blue palette (app.css), for the chrome it cannot paint. -->
                <ResourceDictionary x:Key="{x:Static desktop:DesktopThemes.DarkBlue}">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#101720" />
                    <SolidColorBrush x:Key="StatusTitleBrush" Color="#E8EDF4" />
                    <SolidColorBrush x:Key="StatusDetailBrush" Color="#A3B0C0" />
                </ResourceDictionary>
                <!-- The page's neutral grey palette (app.css), for the chrome it cannot paint. -->
                <ResourceDictionary x:Key="{x:Static desktop:DesktopThemes.Gray}">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#212121" />
                    <SolidColorBrush x:Key="StatusTitleBrush" Color="#ECECEC" />
                    <SolidColorBrush x:Key="StatusDetailBrush" Color="#AAAAAA" />
                </ResourceDictionary>
                <!-- The page's light grey palette (app.css), for the chrome it cannot paint. -->
                <ResourceDictionary x:Key="{x:Static desktop:DesktopThemes.LightGray}">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="StatusTitleBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="StatusDetailBrush" Color="#5C5C5C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="StatusTitleBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="StatusDetailBrush" Color="#575757" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
