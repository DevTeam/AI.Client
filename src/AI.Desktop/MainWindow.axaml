<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AI.Desktop.MainWindow"
        Title="AI Client"
        Icon="/Assets/app-icon.png"
        Width="1400" Height="900"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Panel>
        <Grid x:Name="Chrome" RowDefinitions="38,*" Margin="1">
            <!--
                Avalonia handles the titlebar in this reserved row; the window background covers
                its own titlebar fill, so the fill is drawn here and lets the pointer through.
            -->
            <Border x:Name="TitleBarFill" Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}" BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1"
                    IsHitTestVisible="False" />
            <Grid Grid.Row="1">
                <!-- A native WebView must stay below the titlebar; its HWND would cover Avalonia controls. -->
                <NativeWebView x:Name="WebView" Background="{DynamicResource WindowBackgroundBrush}" />
                <Border x:Name="Status" Background="{DynamicResource WindowBackgroundBrush}" IsVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="560">
                        <TextBlock x:Name="StatusTitle" Text="AI Client" FontSize="18" Foreground="{DynamicResource StatusTitleBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="StatusDetail" Foreground="{DynamicResource StatusDetailBrush}" TextWrapping="Wrap" TextAlignment="Center"
                                   IsVisible="False" />
                        <Button x:Name="Retry" Content="Retry" HorizontalAlignment="Center" IsVisible="False" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <!--
            Windows 10 draws no visible edge around a dark window, so the outline is ours. It sits
            beside the content, not around it: the WebView HWND stays 1px inside and cannot cover it.
        -->
        <Border x:Name="Frame" BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1" IsHitTestVisible="False" />
    </Panel>
</Window>
