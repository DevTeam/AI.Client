<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AI.Desktop.MainWindow"
        Title="AI Client"
        Icon="/Assets/app-icon.png"
        Width="1400" Height="900"
        MinWidth="360" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="Full"
        Background="{DynamicResource WindowBackgroundBrush}">
    <!-- The titlebar and frame are the system's own, so they look the way the user knows from every other app. -->
    <Grid>
        <NativeWebView x:Name="WebView" Background="{DynamicResource WindowBackgroundBrush}" IsVisible="False" />
        <Border x:Name="Status" Background="{DynamicResource WindowBackgroundBrush}" IsVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="560">
                <TextBlock x:Name="StatusTitle" Text="Starting AI Client…" FontSize="18" Foreground="{DynamicResource StatusTitleBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusDetail" Foreground="{DynamicResource StatusDetailBrush}" TextWrapping="Wrap" TextAlignment="Center"
                           IsVisible="False" />
                <Button x:Name="Retry" Content="Retry" HorizontalAlignment="Center" IsVisible="False" />
                <Button x:Name="UpdateHost" Content="Update Host" HorizontalAlignment="Center" IsVisible="False" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
