<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup Condition="'$(HostWindowsService)' == 'true'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AI.Mcp.BuiltIn\AI.Mcp.BuiltIn.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\AI.Contracts\AI.Contracts.csproj" />
    <ProjectReference Include="..\AI.Server\AI.Server.csproj" />
    <ProjectReference Include="..\AI.Web\AI.Web.csproj"
                      Aliases="AIWeb" />
    <Compile Include="..\AI.Contracts\Composition.cs" Link="Contracts\Composition.cs" />
    <Compile Include="..\AI.Server\Composition.cs" Link="Server\Composition.cs" />
    <Compile Include="..\AI.Server\CommandLine\Composition.cs" Link="Server\CommandLine\Composition.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only for the tray icon: no theme, fonts or web view, which only Desktop needs. -->
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Pure.DI" PrivateAssets="all" />
    <PackageReference Include="Pure.DI.MS" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\AI.Desktop\Assets\app-icon.png" LogicalName="AI.Host.app-icon.png" />
  </ItemGroup>
  <!-- SkiaSharp and HarfBuzzSharp ship about 100 MB of native symbols next to their libraries. -->
  <Target Name="DropNativeSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' And ('%(Filename)' == 'libSkiaSharp' Or '%(Filename)' == 'libHarfBuzzSharp')" />
    </ItemGroup>
  </Target>
  <Import Project="..\..\build\McpBuiltIn.targets" />
</Project>
