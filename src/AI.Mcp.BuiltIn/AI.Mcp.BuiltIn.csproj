<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <!--
      A release for one runtime gets the server and the C# compiler precompiled: a cs_run worker
      starts with the compiler already in native code instead of compiling it with the JIT, which
      takes about 40% off a script's first run. It is set here rather than passed to the publish,
      because the restore has to see it to fetch the compiler that does it; without a runtime
      identifier there is nothing to precompile for.
    -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
        <PublishReadyToRun>true</PublishReadyToRun>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\AI.Contracts\AI.Contracts.csproj"/>
        <ProjectReference Include="..\AI.Sandbox\AI.Sandbox.csproj"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting"/>
        <PackageReference Include="ModelContextProtocol.Core"/>
        <PackageReference Include="Pure.DI" PrivateAssets="all"/>
    </ItemGroup>
</Project>
