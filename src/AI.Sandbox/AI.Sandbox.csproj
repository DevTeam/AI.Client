<Project Sdk="Microsoft.NET.Sdk">
    <!--
      Starts a process confined to a list of directories. The assembly is also the launcher a
      confined process is started through on Windows (AppContainer) and Linux (Landlock), which is
      why it is an executable: the projects that reference it get its apphost next to their own.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- The AppContainer and Landlock interop is generated by LibraryImport. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="AI.Sandbox.Tests" />
    </ItemGroup>
</Project>
