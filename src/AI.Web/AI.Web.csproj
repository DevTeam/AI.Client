<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <!-- Blazor analyzers added in .NET 11. BL0012 cannot tell whether a method runs from an event
         handler, so it flags renders that loops, progress before long awaits and calls from other
         components rely on. BL0016 asks for try/catch around every JS interop call; failures are
         handled where they matter instead, and catching all of them would hide real errors. -->
    <NoWarn>$(NoWarn);BL0012;BL0016</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AI.Contracts\AI.Contracts.csproj" />
    <ProjectReference Include="..\AI.TextCorrection\AI.TextCorrection.csproj" />
    <Compile Include="..\AI.Contracts\Composition.cs" Link="Contracts\Composition.cs" />
    <Compile Include="..\AI.TextCorrection\Composition.cs" Link="TextCorrection\Composition.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Pure.DI" PrivateAssets="all" />
    <PackageReference Include="Pure.DI.MS" />
    <PackageReference Include="Markdig" />
  </ItemGroup>
  <!--
    Since .NET 11 the package provides blazor.webassembly.js as a framework asset, which the SDK
    copies into this project for this project only (AssetMode CurrentProject). AI.Host and
    AI.Desktop serve this application from their own static assets, so without this target they
    have no _framework/blazor.webassembly.js and the page never starts.
  -->
  <Target Name="ShareBlazorScriptWithHosts" AfterTargets="ReadPackageStaticWebAssetManifests">
    <ItemGroup>
      <StaticWebAsset Condition="'%(StaticWebAsset.AssetMode)' == 'CurrentProject' and $([System.String]::Copy('%(StaticWebAsset.RelativePath)').StartsWith('_framework/blazor.webassembly'))">
        <AssetMode>All</AssetMode>
      </StaticWebAsset>
    </ItemGroup>
  </Target>
</Project>
