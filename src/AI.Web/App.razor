@using System.Net.Http.Json
@using AI.Contracts
@implements IDisposable
@inject IClientMode ClientMode
@inject HttpClient Http
@inject IApiBaseUrl ApiBaseUrl
@inject IHostConnection HostConnection
@inject IJSRuntime Js
@inject NavigationManager Navigation

@if (!ClientMode.PublicWeb || _stage == Stage.Ready || _workspaceOpened)
{
    <div class="@(_stage == Stage.Ready ? "host-workspace" : "host-workspace host-workspace-hidden")" aria-hidden="@(_stage != Stage.Ready)">
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <main class="shell"><h1>Page not found</h1></main>
        </NotFound>
    </Router>

    <ToastRegion />
    </div>
}
@if (ClientMode.PublicWeb && (_stage is Stage.Checking or Stage.Redirecting))
{
    @* The same splash as index.html, so a browser that is already connected, or is about to be,
       never sees a page asking it anything. *@
    <main class="app-loading" aria-label="Connecting to Host" aria-live="polite">
        <img class="app-loading-mark" src="app-icon.svg" width="48" height="48" alt="" />
        <div class="app-loading-copy"><strong>AI Client</strong><span>@(_stage == Stage.Redirecting ? "Opening Host confirmation" : "Connecting to Host")</span></div>
        <div class="app-loading-track" role="progressbar" aria-label="Connecting" aria-valuetext="Connecting to Host"><span></span></div>
    </main>
}
else if (ClientMode.PublicWeb && _stage != Stage.Ready)
{
    <PageTitle>AI Client</PageTitle>
    <main class="host-gate">
        <div class="host-gate-brand"><img src="app-icon.svg" width="32" height="32" alt="" /><span>AI Client</span></div>

        @switch (_stage)
        {
            case Stage.Insecure:
                <h1>Open the secure site</h1>
                <p class="host-gate-lead">The Host on this computer accepts this Web app only over HTTPS.</p>
                <div class="host-gate-actions"><a class="host-gate-primary" href="@SecureAddress">Open HTTPS site</a></div>
                break;

            case Stage.Connect:
                <h1>Connect this browser</h1>
                <p class="host-gate-lead">AI Client Host is running on this computer. Confirm once on its local page, and this browser opens your projects and chats.</p>
                <div class="host-gate-actions"><button class="host-gate-primary" type="button" @onclick="ConnectAsync">Connect to Host</button></div>
                break;

            case Stage.Blocked:
                <h1>Allow local network access</h1>
                <p class="host-gate-lead">The browser blocks this site from reaching the Host on this computer. Select the icon to the left of the address, allow <strong>Local network access</strong>, and reload the page.</p>
                <div class="host-gate-actions"><button class="host-gate-primary" type="button" @onclick="Reload">Reload</button></div>
                break;

            default:
                <h1>@(_stage switch { Stage.Update => "Update AI Client Host", Stage.OtherApp => "The Host address is taken", _ when _workspaceOpened => "AI Client Host is unavailable", _ => "Use AI Client in this browser" })</h1>
                <p class="host-gate-lead">@(_stage switch
                {
                    Stage.Update => "This Web app and the Host on this computer speak different versions. Install the latest Host; your projects and chats stay where they are.",
                    Stage.OtherApp => $"Another application answers at {HostAuthority}. Close it and AI Client Host can start.",
                    _ when _workspaceOpened => "Start AI Client Host on this computer. Your workspace will return automatically when the connection is restored.",
                    _ => "A small background Host keeps your projects, chats and credentials on this computer. Install it once, and this page connects by itself."
                })</p>
                @if (_stage != Stage.OtherApp)
                {
                    <div class="host-gate-actions">
                        <a class="@(_workspaceOpened && _stage == Stage.Install ? "host-gate-download" : "host-gate-primary")" href="@AssetUrl("AI.Host", _runtime)"><AppIcon Name="download" />@(_workspaceOpened && _stage == Stage.Install ? "Install Host" : $"Download for {OsName(_runtime)}")</a>
                        <span class="host-gate-meta">@ArchitectureName(_runtime) · @Extension(_runtime)</span>
                    </div>
                }
                <p class="host-gate-waiting" role="status"><span aria-hidden="true"></span>@(_stage == Stage.OtherApp ? "Waiting for the address to free up…" : "Waiting for Host on this computer…")</p>
                @if (_stage != Stage.OtherApp)
                {
                    <details class="host-gate-more">
                        <summary><AppIcon Name="chevron-right" /><span>Other platforms</span></summary>
                        <ul>
                            @foreach (var runtime in Runtimes)
                            {
                                <li><a href="@AssetUrl("AI.Host", runtime)">@OsName(runtime) · @ArchitectureName(runtime)</a><span>@Extension(runtime)</span></li>
                            }
                        </ul>
                    </details>
                    <p class="host-gate-note">Prefer a separate window? <a href="@AssetUrl("AI.Desktop", _runtime)">Get the Desktop app</a>. It shares projects and chats with the Host.</p>
                    <p class="host-gate-note">If the browser asks to access devices on your local network, allow it.</p>
                }
                break;
        }

        @if (_error is not null)
        {
            <p class="host-gate-error" role="alert">@_error</p>
        }
    </main>
}

@code {
    private readonly string[] Runtimes = ["win-x64", "win-arm64", "osx-arm64", "osx-x64", "linux-x64", "linux-arm64"];
    private readonly TimeSpan PollInterval = TimeSpan.FromSeconds(2);

    private readonly CancellationTokenSource _disposed = new();
    private Stage _stage = Stage.Checking;
    private bool _workspaceOpened;
    private CancellationTokenSource? _offlineDelay;
    private bool _waitingForHost;
    private string? _error;
    private string _runtime = "win-x64";

    private enum Stage { Checking, Redirecting, Ready, Insecure, Install, Update, OtherApp, Blocked, Connect }

    private enum Probe { Missing, Ready, Incompatible, OtherApp }

    private string SecureAddress => new UriBuilder(Navigation.BaseUri) { Scheme = Uri.UriSchemeHttps, Port = -1 }.Uri.ToString();

    private string HostAuthority => ApiBaseUrl.Value.Authority;

    protected override async Task OnInitializedAsync()
    {
        if (!ClientMode.PublicWeb)
        {
            _stage = Stage.Ready;
            return;
        }

        HostConnection.Changed += OnHostConnectionChanged;

        _runtime = await Js.InvokeAsync<string>("aiHostBridge.platform");
        // A grant sent over plain HTTP could be read on the way; the Host refuses such an origin.
        // Only a development server on this computer may use HTTP.
        var page = new Uri(Navigation.Uri);
        if (page.Scheme != Uri.UriSchemeHttps && !page.IsLoopback)
        {
            _stage = Stage.Insecure;
            return;
        }

        var returned = await Js.InvokeAsync<string>("aiHostBridge.consumeReturn");
        if (returned == "invalid")
            _error = "The connection could not be verified. Connect again.";
        if (returned.StartsWith("pair:", StringComparison.Ordinal))
            await PairAsync(returned[5..]);

        _ = WaitForHostAsync(_disposed.Token);
    }

    private void OnHostConnectionChanged() => _ = InvokeAsync(async () =>
    {
        if (!_workspaceOpened) return;
        if (HostConnection.Status == HostConnectionStatus.Connected)
        {
            _offlineDelay?.Cancel();
            _error = null;
            _stage = Stage.Ready;
            StateHasChanged();
        }
        else if (HostConnection.Status == HostConnectionStatus.Offline && _stage == Stage.Ready)
        {
            _offlineDelay?.Cancel();
            var delay = CancellationTokenSource.CreateLinkedTokenSource(_disposed.Token);
            _offlineDelay = delay;
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(2), delay.Token);
                if (HostConnection.Status != HostConnectionStatus.Offline) return;
                _stage = Stage.Install;
                StateHasChanged();
                _ = WaitForHostAsync(_disposed.Token);
            }
            catch (OperationCanceledException) when (delay.IsCancellationRequested) { }
            finally
            {
                if (ReferenceEquals(_offlineDelay, delay)) _offlineDelay = null;
                delay.Dispose();
            }
        }
    });

    /// <summary>Checks now and then every <see cref="PollInterval"/> while the page waits for an install or update.</summary>
    private async Task WaitForHostAsync(CancellationToken cancellationToken)
    {
        if (_waitingForHost) return;
        _waitingForHost = true;
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                if (_workspaceOpened && HostConnection.Status == HostConnectionStatus.Connected) return;
                var probe = await ProbeAsync(cancellationToken);
                var next = probe switch
                {
                    Probe.Ready => await OpenAsync(),
                    Probe.Incompatible => Stage.Update,
                    Probe.OtherApp => Stage.OtherApp,
                    _ => await IsLocalNetworkAccessDeniedAsync() ? Stage.Blocked : Stage.Install
                };
                if (_workspaceOpened && HostConnection.Status == HostConnectionStatus.Connected) return;
                if (next != _stage)
                {
                    _stage = next;
                    if (next == Stage.Ready) _workspaceOpened = true;
                    StateHasChanged();
                }

                if (next is not (Stage.Install or Stage.Update or Stage.OtherApp)) return;
                await Task.Delay(PollInterval, cancellationToken);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        finally
        {
            _waitingForHost = false;
        }
    }

    private async Task<Probe> ProbeAsync(CancellationToken cancellationToken)
    {
        try
        {
            // Long enough for the user to answer the browser's local network access prompt: the
            // request waits for it. A Host that is not running refuses the connection at once.
            using var timeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
            timeout.CancelAfter(TimeSpan.FromSeconds(30));
            var health = await Http.GetFromJsonAsync<HostHealth>("api/health", timeout.Token);
            if (health?.ProductName != HostProtocol.ProductName) return Probe.OtherApp;
            return health.ApiVersion == HostProtocol.ApiVersion ? Probe.Ready : Probe.Incompatible;
        }
        catch (System.Text.Json.JsonException)
        {
            return Probe.OtherApp;
        }
        catch (Exception error) when (error is HttpRequestException or TaskCanceledException && !cancellationToken.IsCancellationRequested)
        {
            return Probe.Missing;
        }
    }

    /// <summary>
    /// Local Network Access guards only a public site reaching loopback; a dev server on this
    /// computer is not subject to it, and some embedded browsers report "denied" there regardless.
    /// </summary>
    private async Task<bool> IsLocalNetworkAccessDeniedAsync() =>
        !new Uri(Navigation.Uri).IsLoopback
        && await Js.InvokeAsync<string>("aiHostBridge.localNetworkAccess") == "denied";

    /// <summary>With a compatible Host running: opens the workspace, or goes to the Host for a grant.</summary>
    private async Task<Stage> OpenAsync()
    {
        if (await Js.InvokeAsync<string?>("aiHostBridge.token") is not null)
        {
            try
            {
                using var session = await Http.GetAsync("api/bridge/session");
                if (session.IsSuccessStatusCode)
                {
                    await Js.InvokeVoidAsync("aiHostBridge.connected");
                    // Just proven reachable: the workspace shows it connected from its first frame
                    // instead of waiting for the event stream to say so.
                    _ = HostConnection.ReportAsync(true);
                    return Stage.Ready;
                }

                // Revoked, or granted by a Host whose data directory has since been replaced.
                if (session.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                    await Js.InvokeVoidAsync("aiHostBridge.forget");
                else
                    _error = "The Host answered, but the connection failed. Connect again.";
            }
            catch (HttpRequestException)
            {
                _error = "The Host stopped answering. Connect again.";
            }
        }

        if (_error is null && await Js.InvokeAsync<bool>("aiHostBridge.mayConnectAutomatically"))
        {
            await ConnectAsync();
            return Stage.Redirecting;
        }

        return Stage.Connect;
    }

    private async Task PairAsync(string code)
    {
        try
        {
            using var response = await Http.PostAsJsonAsync("api/bridge/pair", new { Code = code });
            if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<Pairing>() is { Token: { } token })
            {
                await Js.InvokeVoidAsync("aiHostBridge.store", token);
                return;
            }
        }
        catch (Exception error) when (error is HttpRequestException or System.Text.Json.JsonException)
        {
        }

        _error = "The link from the Host has expired. Connect again.";
    }

    private async Task ConnectAsync()
    {
        _stage = Stage.Redirecting;
        await Js.InvokeVoidAsync("aiHostBridge.connect", ApiBaseUrl.Value.ToString());
    }

    private void Reload() => Navigation.Refresh(forceReload: true);

    private string AssetUrl(string product, string runtime) =>
        $"https://github.com/DevTeam/AI.Client/releases/latest/download/{product}-{runtime}.{Extension(runtime).TrimStart('.')}";

    private string Extension(string runtime) => runtime.Split('-')[0] switch
    {
        "win" => ".exe",
        "osx" => ".pkg",
        _ => ".deb"
    };

    private string OsName(string runtime) => runtime.Split('-')[0] switch
    {
        "win" => "Windows",
        "osx" => "macOS",
        _ => "Ubuntu/Debian"
    };

    private string ArchitectureName(string runtime) => runtime switch
    {
        "osx-arm64" => "Apple silicon",
        "osx-x64" => "Intel",
        _ when runtime.EndsWith("arm64", StringComparison.Ordinal) => "ARM64",
        _ => "x64"
    };

    public void Dispose()
    {
        HostConnection.Changed -= OnHostConnectionChanged;
        _offlineDelay?.Cancel();
        _disposed.Cancel();
        _disposed.Dispose();
    }

    private sealed record HostHealth(string ProductName, int ApiVersion);

    private sealed record Pairing(string? Token);
}
