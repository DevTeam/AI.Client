<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <main class="shell">
            <h1>Page not found</h1>
        </main>
    </NotFound>
</Router>

@* Global toast region: lives at the app shell so any page (Home, GlobalSettingsPanel,
   ToolPermissionsDrawer, anything that saves settings) can pop a notification and have it
   appear in the same place. Subscription to NotificationService.Changed is set up inside the
   component, not here, so disposing/recreating it on navigation does not happen — the router
   only swaps the RouteView, this fragment is rendered once. *@
<ToastRegion />
