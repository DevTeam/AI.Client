<svg class="app-icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "settings":
            <circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1A1.7 1.7 0 0 0 9 4.6 1.7 1.7 0 0 0 10 3V2.8h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z" />
            break;
        case "send":
            <path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" />
            break;
        case "arrow-up":
            <path d="M12 19V5M5 12l7-7 7 7" />
            break;
        case "stop":
            <rect x="7" y="7" width="10" height="10" rx="1" fill="currentColor" stroke="none" />
            break;
        case "x":
            <path d="M18 6 6 18M6 6l12 12" />
            break;
        case "panel-left":
            <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M9 4v16" />
            break;
        case "panel-right":
            <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M15 4v16" />
            break;
        case "check":
            <path d="m5 12 4 4L19 6" />
            break;
        case "edit":
            <path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />
            break;
        case "copy":
            <rect x="9" y="9" width="11" height="11" rx="2" /><path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3" />
            break;
        case "trash":
            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v5M14 11v5" />
            break;
        case "chevron-left":
            <path d="m15 18-6-6 6-6" />
            break;
        case "bell":
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" />
            break;
        case "chevron-right":
            <path d="m9 18 6-6-6-6" />
            break;
        case "more":
            <circle cx="12" cy="6" r="1.5" fill="currentColor" stroke="none" /><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" /><circle cx="12" cy="18" r="1.5" fill="currentColor" stroke="none" />
            break;
        case "sliders":
            <path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3" /><path d="M1 14h6M9 8h6M17 16h6" />
            break;
        case "fork":
            <path d="M4 12h7a5 5 0 0 0 5-5V4" /><path d="m13 7 3-3 3 3" /><path d="M11 12a5 5 0 0 1 5 5v3" /><path d="m13 17 3 3 3-3" />
            break;
        case "git-branch":
            <circle cx="6" cy="5" r="2" /><circle cx="18" cy="7" r="2" /><circle cx="6" cy="19" r="2" /><path d="M6 7v10M8 15h3a7 7 0 0 0 7-6" />
            break;
        case "edit-replace":
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" />
            break;
        case "spinner":
            <path d="M21 12a9 9 0 1 1-6.2-8.6" />
            break;
        case "unread":
        case "generating":
            <circle cx="12" cy="12" r="5" fill="currentColor" stroke="none" />
            break;
        case "error":
            <circle cx="12" cy="12" r="9" /><path d="M12 7v6M12 17h.01" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" />
            break;
        case "interrupted":
            <rect x="6" y="6" width="12" height="12" rx="2" />
            break;
        case "chevron-up":
            <path d="m7 14 5-5 5 5" />
            break;
        case "chevron-down":
            <path d="m7 10 5 5 5-5" />
            break;
        case "drag":
            <path d="M9 5h.01M15 5h.01M9 12h.01M15 12h.01M9 19h.01M15 19h.01" stroke-width="3" stroke-linecap="round" />
            break;
        case "queue":
            <path d="M5 7h14M5 12h14M5 17h9" />
            break;
        case "play":
            <path d="M6 4l14 8-14 8Z" fill="currentColor" />
            break;
        case "tool":
            <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.8 2.8-2-2Z" />
            break;
        case "skill":
            <path d="M12 6.5C9.5 5 6.5 5 3 6v13c3.5-1 6.5-1 9 .5 2.5-1.5 5.5-1.5 9-.5V6c-3.5-1-6.5-1-9 .5Z" />
            <path d="M12 6.5v13" />
            break;
        case "shield":
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
            <path d="m9 12 2 2 4-4" />
            break;
        @* Added over removed: the two halves of a diff, in the order a diff reads them. *@
        case "diff":
            <path d="M12 4v6M9 7h6M9 17h6" />
            break;
        case "connection":
            <path d="M8 12h8M5 8v8M19 8v8" /><rect x="2" y="6" width="3" height="12" rx="1" /><rect x="19" y="6" width="3" height="12" rx="1" />
            break;
        case "mcp":
            <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M7 9h10M7 15h6" /><circle cx="17" cy="15" r="1" fill="currentColor" stroke="none" />
            break;
        @* Refresh: a circular arrow, drawn as one path so the stroke joins stay consistent with the
           rest of the icon set. The arrow head sits on top-right and points down-right, matching
           the visual "tap to refresh" idiom used by settings UIs. *@
        case "refresh":
            <path d="M3 12a9 9 0 0 1 15.5-6.3L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-15.5 6.3L3 16" /><path d="M3 21v-5h5" />
            break;
        case "download":
            <path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" />
            break;
        @* Into and out of a tray: settings coming in from a paste or a file, and going out. *@
        case "import":
            <path d="M12 3v11" /><path d="m7.5 9.5 4.5 4.5 4.5-4.5" /><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4" />
            break;
        case "export":
            <path d="M12 14V3" /><path d="m7.5 7.5 4.5-4.5 4.5 4.5" /><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4" />
            break;
        case "reset":
            <path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" />
            break;
        case "folder":
            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
            break;
        case "file":
            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" /><path d="M14 3v5h5" />
            break;
        case "folder-plus":
            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /><path d="M12 11v5M9.5 13.5h5" />
            break;
        case "lock":
            <rect x="4" y="10" width="16" height="11" rx="2" fill="currentColor" stroke="none" /><path d="M8 10V7a4 4 0 0 1 8 0v3" />
            break;
        case "unlock":
            <rect x="6" y="11" width="15" height="10" rx="2" fill="currentColor" stroke="none" /><path d="M9 11V7a4 4 0 0 1 7.8-1.2" />
            break;
        case "project":
            <path d="m12 3 9 5-9 5-9-5Z" /><path d="m3 13 9 5 9-5" />
            break;
        case "message-circle":
            <path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 8.4 8.4 0 0 1-3.9-.94L3 20l1.06-3.98A8.5 8.5 0 1 1 21 11.5Z" />
            break;
        case "memory":
            <path d="M6.5 3h11A1.5 1.5 0 0 1 19 4.5V21l-7-4.5L5 21V4.5A1.5 1.5 0 0 1 6.5 3Z" />
            break;
        case "zap":
            <path d="M13 2 4 14h7l-1 8 9-12h-7Z" />
            break;
        case "pin":
            <path d="M12 17v5" /><path d="M15 9.34V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1v2.34a4 4 0 0 1-1.52 3.13l-.99.79A2 2 0 0 0 6 15.83V16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-.17a2 2 0 0 0-.74-1.56l-.99-.79A4 4 0 0 1 15 9.34Z" />
            break;
        @* Unpin: the same pin, with a diagonal slash from top-right to bottom-left to show the
           pinned state is the one about to be removed. Drawn as one path so the stroke joins
           stay consistent with the rest of the icon set. *@
        case "unpin":
            <path d="M12 17v5" /><path d="M15 9.34V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1v2.34a4 4 0 0 1-1.52 3.13l-.99.79A2 2 0 0 0 6 15.83V16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-.17a2 2 0 0 0-.74-1.56l-.99-.79A4 4 0 0 1 15 9.34Z" /><path d="M4 4l16 16" />
            break;
        default:
            <circle cx="12" cy="12" r="9" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string? Class { get; set; }
}
