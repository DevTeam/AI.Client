        case "arrow-up":
            <path d="M12 19V5M5 12l7-7 7 7" />
            break;
        case "stop":
            <rect x="7" y="7" width="10" height="10" rx="1" fill="currentColor" stroke="none" />
            break;
        case "x":
            <path d="M18 6 6 18M6 6l12 12" />
            break;
        case "drawer-close":
            <path d="M4 12h11M11 7l5 5-5 5M20 5v14" />
            break;
        case "panel-left":
