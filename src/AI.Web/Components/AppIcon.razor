        case "shield":
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
            <path d="m9 12 2 2 4-4" />
            break;
        @* Added over removed: the two halves of a diff, in the order a diff reads them. *@
        case "diff":
            <path d="M12 4v6M9 7h6M9 17h6" />
            break;
        case "connection":
            <path d="M8 12h8M5 8v8M19 8v8" /><rect x="2" y="6" width="3" height="12" rx="1" /><rect x="19" y="6" width="3" height="12" rx="1" />
