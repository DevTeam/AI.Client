            <path d="M4 12h7a5 5 0 0 0 5-5V4" /><path d="m13 7 3-3 3 3" /><path d="M11 12a5 5 0 0 1 5 5v3" /><path d="m13 17 3 3 3-3" />
            break;
        case "git-branch":
            <circle cx="6" cy="5" r="2" /><circle cx="18" cy="7" r="2" /><circle cx="6" cy="19" r="2" /><path d="M6 7v10M8 15h3a7 7 0 0 0 7-6" />
