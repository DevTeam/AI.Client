            break;
        @* Refresh: a circular arrow, drawn as one path so the stroke joins stay consistent with the
           rest of the icon set. The arrow head sits on top-right and points down-right, matching
           the visual "tap to refresh" idiom used by settings UIs. *@
        case "refresh":
            <path d="M3 12a9 9 0 0 1 15.5-6.3L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-15.5 6.3L3 16" /><path d="M3 21v-5h5" />
            break;
        case "download":
            <path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" />
            break;
        @* Into and out of a tray: settings coming in from a paste or a file, and going out. *@
        case "import":
            <path d="M12 3v11" /><path d="m7.5 9.5 4.5 4.5 4.5-4.5" /><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4" />
