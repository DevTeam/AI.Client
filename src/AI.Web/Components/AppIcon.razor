        case "sparkles":
            <path d="M12 3 13.9 8.1 19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9Z" /><path d="M19 15v4M17 17h4M5 3v4M3 5h4" />
            break;
