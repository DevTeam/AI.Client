@using AI.Contracts.Chats

<div class="composer-approval" @onkeydown="OnKeyDown">
    <button class="composer-approval-trigger @ModeClass(Mode) @(Inheritance?.Overridden == true ? "is-branch-override" : null)" type="button" title="@TriggerTitle" aria-label="@AriaLabel"
            aria-haspopup="true" aria-expanded="@(_isOpen ? "true" : "false")" disabled="@Disabled" @onclick="Toggle">
        <AppIcon Name="@Icon(Mode)" />
        <span>@Title(Mode)</span>
        @if (Inheritance?.Overridden == true) { <span class="branch-override-dot" aria-hidden="true"></span> }
    </button>
    @if (_isOpen)
    {
        <div class="context-menu-backdrop" @onclick="Close"></div>
        <div class="composer-approval-menu" role="menu" aria-label="Tool permissions">
            <span class="composer-approval-menu-label">@(Inheritance is null ? "How should tool calls be approved?" : "How should tool calls be approved on this branch?")</span>
            @if (Inheritance is { } branch)
            {
                var inherited = !branch.Overridden;
                <button type="button" role="menuitemradio" aria-checked="@(inherited ? "true" : "false")"
                        class="composer-approval-inherit @(inherited ? "selected" : null)" @onclick="InheritAsync">
                    <AppIcon Name="reset" />
                    <span class="composer-approval-option">
                        <strong>Inherit from @branch.From</strong>
                        <span>@Title(InheritedMode) — follows its changes</span>
                    </span>
                    @if (inherited) { <AppIcon Name="check" Class="composer-approval-check" /> }
                </button>
                <span class="composer-menu-separator" role="separator"></span>
            }
            @foreach (var mode in Modes)
            {
                var selected = mode == Mode && Inheritance?.Overridden != false;
                <button type="button" role="menuitemradio" aria-checked="@(selected ? "true" : "false")"
                        class="@ModeClass(mode) @(selected ? "selected" : null)" @onclick="() => SelectAsync(mode)">
                    <AppIcon Name="@Icon(mode)" />
                    <span class="composer-approval-option">
                        <strong>@Title(mode)</strong>
                        <span>@Description(mode)</span>
                    </span>
                    @if (selected) { <AppIcon Name="check" Class="composer-approval-check" /> }
                </button>
            }
        </div>
    }
</div>

@code {
    private static readonly ToolApprovalMode[] Modes = [ToolApprovalMode.Ask, ToolApprovalMode.Auto, ToolApprovalMode.FullAccess];

    private bool _isOpen;

    [Parameter] public ToolApprovalMode Mode { get; set; }

    [Parameter] public EventCallback<ToolApprovalMode> ModeChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Set on a branch other than the main one: whether the mode is its own and where it would come from.</summary>
    [Parameter] public BranchInheritance? Inheritance { get; set; }

    /// <summary>The mode the branch gets when it inherits.</summary>
    [Parameter] public ToolApprovalMode InheritedMode { get; set; }

    [Parameter] public EventCallback Inherit { get; set; }

    private string AriaLabel => $"Tool permissions: {Title(Mode)}" + Inheritance switch
    {
        { Overridden: true } => ", set on this branch",
        { } branch => $", inherited from {branch.From}",
        _ => string.Empty
    };

    private string TriggerTitle => Inheritance switch
    {
        { Overridden: true } => $"{Description(Mode)}. Set on this branch; change or inherit it again",
        { } branch => $"{Description(Mode)}. Inherited from {branch.From}; change it for this branch",
        _ => $"{Description(Mode)}. Change tool approval mode for this chat"
    };

    private static string Title(ToolApprovalMode mode) => mode switch
    {
        ToolApprovalMode.Auto => "Approve for me",
        ToolApprovalMode.FullAccess => "Full access",
        _ => "Ask for approval"
    };

    private static string Description(ToolApprovalMode mode) => mode switch
    {
        ToolApprovalMode.Auto => "Only ask for calls a risk check finds potentially unsafe",
        ToolApprovalMode.FullAccess => "Run every tool call without asking",
        _ => "Show a risk recommendation and ask before every tool call that is not allowed yet"
    };

    private static string Icon(ToolApprovalMode mode) => mode switch
    {
        ToolApprovalMode.Auto => "shield",
        ToolApprovalMode.FullAccess => "shield-alert",
        _ => "hand"
    };

    private static string ModeClass(ToolApprovalMode mode) => mode == ToolApprovalMode.FullAccess ? "is-full-access" : string.Empty;

    private void Toggle() => _isOpen = !_isOpen;

    private void Close() => _isOpen = false;

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") Close();
    }

    private async Task SelectAsync(ToolApprovalMode mode)
    {
        _isOpen = false;
        // On an inheriting branch, choosing even the inherited mode pins it to this branch.
        if (mode != Mode || Inheritance?.Overridden == false) await ModeChanged.InvokeAsync(mode);
    }

    private async Task InheritAsync()
    {
        _isOpen = false;
        if (Inheritance?.Overridden == true) await Inherit.InvokeAsync();
    }
}
