@using AI.Contracts.Resources
@inject IChatKnowledgeStatisticsCalculator Calculator
@* What the assistant read on the visible branch: the read-only tool calls, the sources they
   named, and how often each one came up. Only built-in read tools and web fetches count; write,
   edit, process_run and third-party tools do not, even when their results happen to land in the
   model's context. A path or URL is one row with its read count: the row opens its preview or the
   page, and its locate button steps through the messages that read it. *@
<ChatWidget Widget="@Widget" Summary="@GetSummary()" Class="chat-knowledge-widget">
    @if (_hasAnyReads) { <ChatWidgetScopeSwitch Value="_scope" ValueChanged="SetScope" /> }

    @if (_stats.TotalReads == 0)
    {
        <p class="chat-usage-empty">@(_scope == ChatWidgetScope.LastTurn && _hasAnyReads
            ? "The last turn read no files or pages."
            : "Files and pages the assistant read appear here once it reads something.")</p>
    }
    else
    {
        <div class="chat-usage-section">
            <div class="chat-widget-headline">
                <span class="chat-widget-count" title="Read attempts by supported file and web tools in the selected scope; a stored batch counts each source, including repeated reads">@_stats.TotalReads</span>
                <span class="chat-usage-muted">@(_stats.TotalReads == 1 ? "read" : "reads")@(_stats.IsRunning ? " so far" : null)</span>
                @if (_stats.Entries.Count > 0)
                {
                    <span class="chat-widget-headline-aside chat-usage-muted" title="Distinct files, directories and pages read in the selected scope">@_stats.Entries.Count @(_stats.Entries.Count == 1 ? "source" : "sources")</span>
                }
            </div>
            <div class="chat-usage-legend">
                @foreach (var group in _stats.Groups)
                {
                    <span @key="@(group.Server + group.ToolName)" title="@($"Read attempts by {group.ToolLabel}{(group.Server.Length > 0 ? $" ({group.Server})" : "")}; stored batches count each source")"><b>@group.Calls</b> @group.ToolLabel</span>
                }
            </div>
        </div>

        @if (_stats.Entries.Count > 0)
        {
            <div class="chat-usage-section">
                <div class="chat-usage-row chat-usage-heading"><span>Most read</span><span class="chat-usage-muted">reads</span></div>
                <ul class="chat-widget-rows">
                    @foreach (var source in _showAll ? _stats.Entries : _stats.Entries.Take(VisibleSources))
                    {
                        <ChatWidgetRow @key="source.Display" Widget="@Widget" Uses="@source.Messages" UseNoun="read"
                                       Resource="@(source.IsUrl ? null : new ChatResource(Guid.Empty, ChatResourceKind.File, source.Target))"
                                       Href="@(source.IsUrl ? source.Target : null)"
                                       OpenTitle="@($"{(source.IsUrl ? "Open the page" : "Preview")} {source.Display}")">
                            <Tile><AppIcon Name="@(source.IsUrl ? "globe" : IsDirectoryTool(source) ? "folder" : "file")" /></Tile>
                            <Name>@Leaf(source)</Name>
                            <Details>
                                @if (Parent(source) is { Length: > 0 } parent) { <span title="@source.Display">@parent</span> }
                                <span>@string.Join(", ", source.Tools)</span>
                            </Details>
                            <Figure><span title="Times this source was read in the selected scope">@source.Reads</span></Figure>
                            <Bar>
                                <span style="flex-grow: @source.Reads"></span>
                                @if (_stats.Entries[0].Reads > source.Reads) { <i style="flex-grow: @(_stats.Entries[0].Reads - source.Reads)"></i> }
                            </Bar>
                        </ChatWidgetRow>
                    }
                </ul>
                @if (_stats.Entries.Count > VisibleSources)
                {
                    <button class="chat-usage-link chat-widget-more" type="button" @onclick="() => _showAll = !_showAll">@(_showAll ? "Show fewer" : $"Show {_stats.Entries.Count - VisibleSources} more")</button>
                }
            </div>
        }

        @if (_scope == ChatWidgetScope.Chat && _stats.TurnsWithReads > 0)
        {
            <div class="chat-usage-section chat-usage-footnote">
                <span title="Turns with at least one supported read call, out of all turns on the visible branch">In @_stats.TurnsWithReads of @GetScopeTurns() @(GetScopeTurns() == 1 ? "turn" : "turns")</span>
            </div>
        }
    }
</ChatWidget>

@code {
    private const int VisibleSources = 6;

    [Parameter, EditorRequired]
    public ChatWidgetContext Widget { get; set; } = null!;

    /// <summary>The visible branch, root to leaf.</summary>
    [Parameter]
    public IReadOnlyList<ChatMessageView> Messages { get; set; } = [];

    /// <summary>The run snapshot for the open chat, when one exists.</summary>
    [Parameter]
    public ChatRunSnapshot? Run { get; set; }

    private ChatWidgetScope _scope = ChatWidgetScope.Chat;
    private ChatKnowledgeStatistics _stats = ChatKnowledgeStatistics.Empty;
    private bool _hasAnyReads;
    private bool _showAll;

    private bool _statisticsInitialized;
    private IReadOnlyList<ChatMessageView> _statisticsMessages = [];
    private ChatRunSnapshot? _statisticsRun;

    protected override void OnParametersSet()
    {
        // Parent renders also follow typing and modifier keys; only changed data needs statistics.
        if (_statisticsInitialized
            && ReferenceEquals(_statisticsMessages, Messages)
            && ReferenceEquals(_statisticsRun, Run)) return;

        Refresh();
        _statisticsInitialized = true;
        _statisticsMessages = Messages;
        _statisticsRun = Run;
    }

    private void SetScope(ChatWidgetScope scope)
    {
        _scope = scope;
        _showAll = false;
        Refresh();
    }

    private void Refresh()
    {
        _stats = Calculator.Calculate(Messages, Run, _scope);
        _hasAnyReads = _scope == ChatWidgetScope.Chat
            ? _stats.TotalReads > 0
            : Calculator.Calculate(Messages, Run, ChatWidgetScope.Chat).TotalReads > 0;
    }

    private static bool IsDirectoryTool(ChatKnowledgeSourceEntry source) =>
        source.Tools.All(tool => tool is "List directory" or "Read directory tree" or "Search files" or "Search in files");

    private static string Leaf(ChatKnowledgeSourceEntry source)
    {
        if (source.IsUrl) return Uri.TryCreate(source.Target, UriKind.Absolute, out var url) ? url.Host + url.AbsolutePath.TrimEnd('/') : source.Display;
        var trimmed = source.Display.TrimEnd('/');
        var index = trimmed.LastIndexOf('/');
        return index < 0 || index == trimmed.Length - 1 ? trimmed : trimmed[(index + 1)..];
    }

    private static string Parent(ChatKnowledgeSourceEntry source)
    {
        if (source.IsUrl) return string.Empty;
        var trimmed = source.Display.TrimEnd('/');
        var index = trimmed.LastIndexOf('/');
        return index <= 0 ? string.Empty : trimmed[..index];
    }

    private string? GetSummary()
    {
        if (_stats.TotalReads == 0) return null;
        var parts = new List<string> { $"{_stats.TotalReads} {(_stats.TotalReads == 1 ? "read" : "reads")}" };
        if (_scope == ChatWidgetScope.Chat && _stats.TurnsWithReads > 1)
            parts.Add($"{_stats.TurnsWithReads} turns");
        return string.Join(" · ", parts);
    }

    private int GetScopeTurns()
    {
        if (Messages.Count == 0) return 0;
        var count = 0;
        var started = false;
        foreach (var message in Messages)
        {
            if (message.Role == "User")
            {
                count++;
                started = true;
            }
            else if (!started)
            {
                count++;
                started = true;
            }
        }
        return count;
    }
}
