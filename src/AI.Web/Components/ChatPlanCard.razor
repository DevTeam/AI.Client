@* The model's plan for the task in hand: one line with the step in progress and a progress bar by
   default, the steps with their notes and times when opened. Docked above the composer while the
   run works through it; the turn keeps its final state under the answer. *@
@using AI.Contracts.Plans
@inject IJSRuntime JsRuntime
@inject IChatPlanClock PlanClock
@implements IAsyncDisposable

@if (Plan is { Steps.Count: > 0 } plan)
{
    var progress = ChatPlanProgress.Of(plan, Live ? PlanClock.Now(plan, WorkingSince ?? plan.UpdatedAt, Waiting) : plan.Clock);
    var current = progress.Current is { } index ? plan.Steps[index] : null;
    var criteria = ChatPlanCriteriaSummary.Of(plan);
    <section class="chat-plan chat-summary-card @(ExpandUpward ? "opens-upward" : null) @(_showDetails ? "is-expanded" : "is-collapsed") @(Live ? "is-live" : null)"
             aria-label="Plan">
        <div class="chat-summary-top">
            <button class="chat-summary-toggle chat-card-header" type="button" aria-expanded="@_showDetails" aria-controls="@_detailsId" @ref="_header"
                    title="@(_showDetails ? "Collapse the plan" : "Show the plan's steps")" @onclick="ToggleDetails">
                <span class="chat-summary-icon chat-card-mark" aria-hidden="true"><AppIcon Name="list-checks" /></span>
                <span class="chat-summary-title chat-card-title">
                    @if (current is not null)
                    {
                        @current.Title
                    }
                    else
                    {
                        @(plan.Title ?? "Plan") <span class="chat-plan-outcome">· @Outcome(plan)</span>
                    }
                </span>
                <span class="chat-summary-chevron" aria-hidden="true"><AppIcon Name="chevron-down" /></span>
            </button>
            <span class="chat-card-header-actions chat-plan-figures">
                @if (Live && Waiting)
                {
                    <span class="chat-plan-eta" title="The plan's clock stands still while the run waits for you">Waiting for you</span>
                }
                else if (Live && progress is { RemainingLow: { } low, RemainingHigh: { } high })
                {
                    <span class="chat-plan-eta" title="@FinishTitle(low, high)">@FormatRange(low, high) left</span>
                }
                <span class="chat-plan-count" title="Steps completed">@progress.Completed/@progress.Total</span>
                @if (criteria.Total > 0)
                {
                    <span class="chat-plan-criteria-count @CriteriaState(criteria, progress.IsFinished)" title="@CriteriaTitle(criteria)">✓ @criteria.Met/@criteria.Total</span>
                }
                <span class="chat-plan-percent" title="Progress by the estimated share of each step">@progress.Percent%</span>
            </span>
            <span class="chat-plan-track" role="progressbar" aria-label="Plan progress" aria-valuemin="0" aria-valuemax="100"
                  aria-valuenow="@progress.Percent"><span style="--plan-progress: @Fraction(progress)"></span></span>
        </div>
        <div class="chat-summary-details" id="@_detailsId" aria-hidden="@(!_showDetails)" inert="@(!_showDetails)">
            <div class="chat-summary-details-inner">
                @if (plan.Title is { } title && current is not null)
                {
                    <div class="chat-plan-title">@title</div>
                }
                <ol class="chat-plan-steps">
                    @for (var stepIndex = 0; stepIndex < plan.Steps.Count; stepIndex++)
                    {
                        var step = plan.Steps[stepIndex];
                        var timing = progress.Steps[stepIndex];
                        <li @key="stepIndex" class="chat-plan-step is-@StatusClass(step.Status) @(timing.IsOver ? "is-over" : null)">
                            <span class="chat-plan-mark is-@StatusClass(step.Status)" title="@StatusLabel(step.Status)" aria-label="@StatusLabel(step.Status)">
                                @if (step.Status == ChatPlanStepStatus.Completed) { <AppIcon Name="check" /> }
                                else if (step.Status == ChatPlanStepStatus.Failed) { <AppIcon Name="x" /> }
                            </span>
                            <span class="chat-plan-step-text">
                                <span class="chat-plan-step-title">@step.Title</span>
                                @if (step.Note is { } note)
                                {
                                    <span class="chat-plan-step-note">@note</span>
                                }
                            </span>
                            <span class="chat-plan-step-meta">
                                @if (step.Status == ChatPlanStepStatus.InProgress && step.Progress > 0)
                                {
                                    <span class="chat-plan-step-progress">@step.Progress%</span>
                                }
                                @if (TimeOf(step, timing, Live) is { } time)
                                {
                                    <span class="chat-plan-step-time" title="@TimeTitle(step, timing)">@time</span>
                                }
                            </span>
                        </li>
                    }
                </ol>
                @if (plan.Criteria is { Count: > 0 } items)
                {
                    <div class="chat-plan-criteria-title">Done when</div>
                    <ul class="chat-plan-criteria">
                        @for (var criterionIndex = 0; criterionIndex < items.Count; criterionIndex++)
                        {
                            var criterion = items[criterionIndex];
                            var evidence = criterion.EvidenceCall is { } call ? EvidenceMessage?.Invoke(call) : null;
                            <li @key="criterionIndex" class="chat-plan-criterion is-@CriterionClass(criterion.Status)">
                                <span class="chat-plan-mark is-@CriterionMark(criterion.Status)" title="@CriterionLabel(criterion.Status)" aria-label="@CriterionLabel(criterion.Status)">
                                    @if (criterion.Status == ChatPlanCriterionStatus.Met) { <AppIcon Name="check" /> }
                                    else if (criterion.Status == ChatPlanCriterionStatus.NotMet) { <AppIcon Name="x" /> }
                                </span>
                                <span class="chat-plan-step-text">
                                    <span class="chat-plan-criterion-text">@criterion.Text</span>
                                    @if (criterion.Evidence is { } note)
                                    {
                                        <span class="chat-plan-step-note">@note</span>
                                    }
                                </span>
                                <span class="chat-plan-step-meta">
                                    @if (evidence is { } messageId && OnShowMessage.HasDelegate)
                                    {
                                        <button class="chat-plan-evidence" type="button" title="Show the tool call that showed it"
                                                @onclick="() => OnShowMessage.InvokeAsync(messageId)">Evidence</button>
                                    }
                                    else
                                    {
                                        <span>@CriterionLabel(criterion.Status)</span>
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public ChatPlan? Plan { get; set; }

    /// <summary>The plan of a run still in progress: its clock runs and it estimates the time left.</summary>
    [Parameter] public bool Live { get; set; }

    /// <summary>Shows details above a docked card while keeping its header in place.</summary>
    [Parameter] public bool ExpandUpward { get; set; }

    /// <summary>When the live run began; the clock of a plan an earlier turn left goes on from here.</summary>
    [Parameter] public DateTimeOffset? WorkingSince { get; set; }

    /// <summary>The live run is waiting for the person: the clock stands still and no forecast is given.</summary>
    [Parameter] public bool Waiting { get; set; }

    /// <summary>The message holding a tool call's result, by the call's id; null when it is not on this branch.</summary>
    [Parameter] public Func<string, Guid?>? EvidenceMessage { get; set; }

    /// <summary>Shows a message in the transcript: where a criterion's evidence is.</summary>
    [Parameter] public EventCallback<Guid> OnShowMessage { get; set; }

    private readonly string _detailsId = $"chat-plan-details-{Guid.NewGuid():N}";
    private bool _showDetails;
    private ElementReference _header;
    private IJSObjectReference? _summaryModule;
    private double? _headerTop;
    private PeriodicTimer? _clock;

    protected override void OnParametersSet()
    {
        // The step times and the estimate move with the clock between plan updates, so a live card
        // redraws itself; a settled one shows fixed times and needs no timer.
        if (Live && _clock is null)
        {
            _clock = new PeriodicTimer(TimeSpan.FromSeconds(1));
            _ = TickAsync(_clock);
        }
        else if (!Live && _clock is not null)
        {
            _clock.Dispose();
            _clock = null;
        }
    }

    private async Task TickAsync(PeriodicTimer clock)
    {
        try
        {
            while (await clock.WaitForNextTickAsync()) await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private async Task ToggleDetails()
    {
        if (ExpandUpward)
        {
            _summaryModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/chatSummary.js");
            _headerTop = await _summaryModule.InvokeAsync<double?>("captureHeader", _header);
        }
        _showDetails = !_showDetails;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_headerTop is not { } top || _summaryModule is null) return;
        _headerTop = null;
        await _summaryModule.InvokeVoidAsync("restoreHeader", _header, top);
    }

    public async ValueTask DisposeAsync()
    {
        _clock?.Dispose();
        if (_summaryModule is not null)
        {
            try { await _summaryModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

    private static string Fraction(ChatPlanProgress progress) =>
        Math.Clamp(progress.Fraction, 0, 1).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);

    private static string Outcome(ChatPlan plan)
    {
        var failed = plan.Steps.Count(step => step.Status == ChatPlanStepStatus.Failed);
        var skipped = plan.Steps.Count(step => step.Status == ChatPlanStepStatus.Skipped);
        if (failed == 0 && skipped == 0) return "done";
        var parts = new List<string>(2);
        if (failed > 0) parts.Add($"{failed} failed");
        if (skipped > 0) parts.Add($"{skipped} skipped");
        return string.Join(", ", parts);
    }

    /// <summary>
    /// How the criteria count reads: in the warning colour once the steps are done with criteria still
    /// unchecked, in the danger colour when one was not met; the words in its tooltip say which.
    /// </summary>
    private static string? CriteriaState(ChatPlanCriteriaSummary criteria, bool finished) =>
        criteria.NotMet > 0 ? "is-not-met" : finished && criteria.Unverified > 0 ? "is-unverified" : null;

    private static string CriteriaTitle(ChatPlanCriteriaSummary criteria)
    {
        var parts = new List<string> { $"{criteria.Met} of {criteria.Total} criteria met" };
        if (criteria.NotMet > 0) parts.Add($"{criteria.NotMet} not met");
        if (criteria.Unverified > 0) parts.Add($"{criteria.Unverified} not verified");
        if (criteria.NotApplicable > 0) parts.Add($"{criteria.NotApplicable} not applicable");
        return string.Join(", ", parts);
    }

    public static string CriterionClass(ChatPlanCriterionStatus status) => status switch
    {
        ChatPlanCriterionStatus.Met => "met",
        ChatPlanCriterionStatus.NotMet => "not-met",
        ChatPlanCriterionStatus.NotApplicable => "not-applicable",
        _ => "unverified"
    };

    /// <summary>A criterion wears the mark of the step status it reads like.</summary>
    public static string CriterionMark(ChatPlanCriterionStatus status) => status switch
    {
        ChatPlanCriterionStatus.Met => "completed",
        ChatPlanCriterionStatus.NotMet => "failed",
        ChatPlanCriterionStatus.NotApplicable => "skipped",
        _ => "pending"
    };

    public static string CriterionLabel(ChatPlanCriterionStatus status) => status switch
    {
        ChatPlanCriterionStatus.Met => "Met",
        ChatPlanCriterionStatus.NotMet => "Not met",
        ChatPlanCriterionStatus.NotApplicable => "Not applicable",
        _ => "Not verified"
    };

    public static string StatusClass(ChatPlanStepStatus status) => status switch
    {
        ChatPlanStepStatus.InProgress => "in-progress",
        ChatPlanStepStatus.Completed => "completed",
        ChatPlanStepStatus.Skipped => "skipped",
        ChatPlanStepStatus.Failed => "failed",
        _ => "pending"
    };

    public static string StatusLabel(ChatPlanStepStatus status) => status switch
    {
        ChatPlanStepStatus.InProgress => "In progress",
        ChatPlanStepStatus.Completed => "Completed",
        ChatPlanStepStatus.Skipped => "Skipped",
        ChatPlanStepStatus.Failed => "Failed",
        _ => "Pending"
    };

    /// <summary>
    /// A step's time as it stands: what a finished step took, what the step in progress has taken
    /// against what it was expected to, what a waiting step is expected to take.
    /// </summary>
    public static string? TimeOf(ChatPlanStep step, ChatPlanStepTiming timing, bool live) => step.Status switch
    {
        ChatPlanStepStatus.Pending => timing.Expected is { } expected ? "~" + FormatDuration(expected) : null,
        ChatPlanStepStatus.Skipped => null,
        ChatPlanStepStatus.InProgress when !live => null,
        ChatPlanStepStatus.InProgress => timing.Spent is { } spent
            ? FormatDuration(spent) + (timing.Expected is { } expected ? " / ~" + FormatDuration(expected) : null)
            : null,
        _ => timing.Spent is { } took ? FormatDuration(took) : null
    };

    public static string TimeTitle(ChatPlanStep step, ChatPlanStepTiming timing)
    {
        var expected = timing.Expected is { } expect ? $"about {FormatDuration(expect)} expected" : "no estimate";
        var title = step.Status switch
        {
            ChatPlanStepStatus.Pending => "Expected working time",
            ChatPlanStepStatus.InProgress => $"Working time so far; {expected}",
            _ => $"Working time taken; {expected}"
        };
        return timing.IsOver ? title + ". Well over the estimate." : title;
    }

    /// <summary>A forecast as a range in whole minutes, "8–15m", or one figure when the range is that narrow.</summary>
    public static string FormatRange(TimeSpan low, TimeSpan high)
    {
        var from = (int)Math.Floor(low.TotalMinutes);
        var to = (int)Math.Ceiling(high.TotalMinutes);
        if (to <= 1) return "~1m";
        if (from < 1) return to >= 60 ? $"up to {FormatDuration(high)}" : $"up to {to}m";
        if (to >= 60) return $"{FormatDuration(low)}–{FormatDuration(high)}";
        return from >= to ? $"~{to}m" : $"{from}–{to}m";
    }

    /// <summary>When the forecast says the plan should be done, by this device's clock.</summary>
    public static string FinishTitle(TimeSpan low, TimeSpan high)
    {
        var now = DateTimeOffset.Now;
        return $"Likely done between {now.Add(low):t} and {now.Add(high):t}: the estimates, corrected by how the "
            + "finished steps went; time spent waiting for you is not counted";
    }

    /// <summary>Whole units at the scale of the span: "40s", "12m", "1h 5m".</summary>
    public static string FormatDuration(TimeSpan span)
    {
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        if (span.TotalMinutes < 1) return $"{(int)span.TotalSeconds}s";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes}m";
        return span.Minutes == 0 ? $"{(int)span.TotalHours}h" : $"{(int)span.TotalHours}h {span.Minutes}m";
    }
}
