@using AI.Contracts.Plans
@inject IChatPlanStatisticsCalculator Calculator
@implements IDisposable
@* The plan of the visible branch (docs/37-chat-plans.md). The plan's bar is made of its steps, each
   as wide as its share of the work and filled as far as it has come, so the weights are seen once,
   where they add up to the whole. A step's row is about its time: what it took or has taken against
   what it was expected to, with a bar that fills towards that time and turns to the warning colour
   past it. The plan stays here between turns, so a task the assistant set aside can still be read;
   the chat card shows it only while a run works on it and under the turn that moved it. *@
<ChatWidget Widget="@Widget" Summary="@GetSummary()" Class="chat-plan-widget">
    @if (_stats is not { Plan: { } plan, Progress: { } progress })
    {
        <p class="chat-usage-empty">When the assistant works through a task of several steps, its plan and progress appear here.</p>
    }
    else
    {
        <div class="chat-usage-section">
            <div class="chat-widget-headline">
                <span class="chat-widget-count" title="Progress by the assistant's estimate of each step's share of the work">@progress.Percent%</span>
                <span class="chat-usage-muted">@(progress.IsFinished ? "finished" : "done")</span>
                <span class="chat-widget-headline-aside chat-usage-muted" title="Steps completed, out of all steps">@progress.Completed of @progress.Total @(progress.Total == 1 ? "step" : "steps")</span>
            </div>
            @if (plan.Title is { } title)
            {
                <div class="chat-plan-widget-title">@title</div>
            }
            <div class="chat-plan-widget-bar" role="progressbar" aria-label="Plan progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress.Percent">
                @foreach (var entry in _stats.Steps.Where(entry => entry.Share > 0))
                {
                    <span @key="entry.Number" class="chat-plan-widget-segment" title="@SegmentTitle(entry)"
                          style="flex-grow: @Share(entry.Share); --step-done: @Share(entry.Done)"></span>
                }
            </div>
        </div>

        <div class="chat-usage-section">
            <ul class="chat-widget-rows">
                @foreach (var entry in _stats.Steps)
                {
                    var step = entry.Step;
                    var timing = entry.Timing;
                    <ChatWidgetRow @key="entry.Number" Widget="@Widget" Current="@(progress.Current == entry.Number - 1 && !progress.IsFinished)"
                                   Class="@($"chat-plan-widget-step is-{ChatPlanCard.StatusClass(step.Status)} {(timing.IsOver ? "is-over" : null)}")"
                                   OpenTitle="@StepTitle(entry)" Note="@NoteOf(step)">
                        <Tile>
                            <span class="chat-plan-mark is-@ChatPlanCard.StatusClass(step.Status)" aria-label="@ChatPlanCard.StatusLabel(step.Status)">
                                @if (step.Status == ChatPlanStepStatus.Completed) { <AppIcon Name="check" /> }
                                else if (step.Status == ChatPlanStepStatus.Failed) { <AppIcon Name="x" /> }
                            </span>
                        </Tile>
                        <Name>@step.Title</Name>
                        <Details>
                            <span>@ChatPlanCard.StatusLabel(step.Status)</span>
                            @if (step.Status == ChatPlanStepStatus.InProgress && step.Progress > 0)
                            {
                                <span title="How far this step has come, by the assistant's estimate">@step.Progress% done</span>
                            }
                            @if (timing.IsOver)
                            {
                                <span class="chat-plan-widget-over-text">over its estimate</span>
                            }
                        </Details>
                        <Figure>@Figure(entry)</Figure>
                        <Bar>
                            @if (TimeBar(step, timing) is var (within, over, rest))
                            {
                                @if (within > 0) { <span class="@(over > 0 ? "chat-plan-widget-expected" : null)" style="flex-grow: @Share(within)"></span> }
                                @if (over > 0) { <span class="chat-plan-widget-over" style="flex-grow: @Share(over)"></span> }
                                @if (rest > 0) { <i style="flex-grow: @Share(rest)"></i> }
                            }
                        </Bar>
                    </ChatWidgetRow>
                }
            </ul>
        </div>

        @if (progress.Elapsed is { } elapsed)
        {
            <div class="chat-usage-section chat-usage-footnote">
                <span title="Working time from the first step's start; time spent waiting for you is not counted">@ChatPlanCard.FormatDuration(elapsed) @(progress.IsFinished ? "in all" : "so far")</span>
                @if (IsGenerating && Waiting)
                {
                    <span class="chat-usage-muted" title="The plan's clock stands still while the run waits for you">waiting for you</span>
                }
                else if (IsGenerating && progress is { RemainingLow: { } low, RemainingHigh: { } high })
                {
                    <span class="chat-usage-muted" title="@ChatPlanCard.FinishTitle(low, high)">about @ChatPlanCard.FormatRange(low, high) left</span>
                }
            </div>
        }
    }
</ChatWidget>

@code {
    [Parameter, EditorRequired]
    public ChatWidgetContext Widget { get; set; } = null!;

    /// <summary>The visible branch, root to leaf.</summary>
    [Parameter]
    public IReadOnlyList<ChatMessageView> Messages { get; set; } = [];

    /// <summary>True while the branch's run is working: the clock runs and the time left is estimated.</summary>
    [Parameter]
    public bool IsGenerating { get; set; }

    /// <summary>True while that run waits for the person: the clock stands still.</summary>
    [Parameter]
    public bool Waiting { get; set; }

    private ChatPlanStatistics _stats = ChatPlanStatistics.Empty;
    private (IReadOnlyList<ChatMessageView> Messages, bool Generating, bool Waiting)? _computedFor;
    private PeriodicTimer? _clock;

    protected override void OnParametersSet()
    {
        if (_computedFor != (Messages, IsGenerating, Waiting)) Refresh();
        if (IsGenerating && _clock is null)
        {
            _clock = new PeriodicTimer(TimeSpan.FromSeconds(1));
            _ = TickAsync(_clock);
        }
        else if (!IsGenerating && _clock is not null)
        {
            _clock.Dispose();
            _clock = null;
        }
    }

    private async Task TickAsync(PeriodicTimer clock)
    {
        try
        {
            while (await clock.WaitForNextTickAsync())
                await InvokeAsync(() => { if (_stats.HasPlan) { Refresh(); StateHasChanged(); } });
        }
        catch (ObjectDisposedException) { }
    }

    private void Refresh()
    {
        _stats = Calculator.Calculate(Messages, IsGenerating, Waiting);
        _computedFor = (Messages, IsGenerating, Waiting);
    }

    public void Dispose() => _clock?.Dispose();

    private string? GetSummary() => _stats is { Progress: { } progress }
        ? $"{progress.Percent}% · {progress.Completed}/{progress.Total}"
        : null;

    /// <summary>
    /// The step's time as the card shows it; a waiting step with nothing to forecast from shows its
    /// share of the plan instead, muted and marked as an estimate so it is not read as progress.
    /// </summary>
    private RenderFragment? Figure(ChatPlanStepEntry entry) =>
        ChatPlanCard.TimeOf(entry.Step, entry.Timing, IsGenerating) is { } time
            ? @<span title="@ChatPlanCard.TimeTitle(entry.Step, entry.Timing)">@time</span>
            : entry.Step.Status == ChatPlanStepStatus.Pending
                ? @<span class="chat-usage-muted" title="This step's estimated share of the plan's work">≈@Percent(entry.Share)</span>
                : null;

    /// <summary>
    /// A step's time against what it was expected to take, as parts of the track: the time within the
    /// expectation, the time past it, and what is left of it. The track is the expected time, or the
    /// time taken once that is longer. A waiting or skipped step, or one with nothing expected, has none.
    /// </summary>
    private static (double Within, double Over, double Left)? TimeBar(ChatPlanStep step, ChatPlanStepTiming timing)
    {
        if (step.Status is ChatPlanStepStatus.Pending or ChatPlanStepStatus.Skipped
            || timing is not { Spent: { } spent, Expected: { TotalSeconds: > 0 } expected }) return null;
        if (spent <= expected) return (spent / expected, 0, 1 - spent / expected);
        return (expected / spent, 1 - expected / spent, 0);
    }

    private static RenderFragment? NoteOf(ChatPlanStep step) => step.Note is { } note ? @<text>@note</text> : null;

    private static string StepTitle(ChatPlanStepEntry entry) =>
        $"Step {entry.Number}: {entry.Step.Title}"
        + (entry.Share > 0 ? $"\nAbout {Percent(entry.Share)} of the plan's work (weight {entry.Step.Weight})" : string.Empty)
        + (entry.Step.Minutes is { } minutes ? $"\nEstimated by the assistant at {minutes:0.#} min" : string.Empty);

    private static string SegmentTitle(ChatPlanStepEntry entry) =>
        $"{entry.Number}. {entry.Step.Title} · {Percent(entry.Share)} of the plan, {Percent(entry.Done)} done";

    private static string Share(double value) =>
        Math.Max(0, value).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);

    private static string Percent(double share) => $"{(int)Math.Round(Math.Clamp(share, 0d, 1d) * 100)}%";
}
