@* The selected branch has its own schedule. Every run forks from that branch's current head.
   Before a chat exists, the composer text becomes the first message of a new scheduled chat. *@
@using AI.Contracts.Chats
@using AI.Contracts.Schedules
@using AI.Web.Widgets
@inject AI.Web.Chats.IChatScheduleApi ScheduleApi
@inject IChatSchedulePresentation Presentation
@inject IScheduleCalendar Calendar
@inject IScheduleDescriptions Descriptions
@implements IDisposable

<ChatWidget Widget="@Widget" Summary="@GetSummary()" Class="chat-schedule-widget">
    @if (Chat is null && _draft is null)
    {
        @if (!CanCreate)
        {
            <p class="chat-usage-empty">Open a project to schedule a chat.</p>
        }
        else
        {
            <div class="chat-usage-section chat-schedule-intro">
                <p class="chat-usage-empty">Write what the new chat should do in the message box, then schedule it instead of sending it. Nothing reaches the model until the first run.</p>
                <button class="compact-action chat-schedule-primary" type="button" @onclick="StartScheduling">
                    <AppIcon Name="stopwatch" /> Schedule a new chat
                </button>
                <p class="chat-schedule-shortcut"><kbd>Alt</kbd><kbd>Shift</kbd><kbd>Enter</kbd><span>in the message box does the same</span></p>
            </div>
        }
    }
    else if (_draft is { } draft)
    {
        <div class="chat-usage-section">
            <div class="chat-schedule-editor-heading" tabindex="-1" @ref="_editorHeading">
                <AppIcon Name="stopwatch" />
                <strong>@(_schedule is not null ? "Edit the schedule" : Chat is null ? "Schedule a new chat" : IsBranch ? "Schedule this branch" : "Schedule this chat")</strong>
            </div>
            @if (_schedule is null)
            {
                <p class="chat-usage-footnote">@(Chat is null
                    ? "The task becomes the chat's first message; the model first sees it in the first run."
                    : IsBranch ? "Runs fork from this branch and carry out the task with its conversation as context."
                    : "Runs fork the chat from its end and carry out the task; the conversation so far stays as their context.")</p>
            }
            <ScheduleSettingsForm Value="@draft" ValueChanged="settings => _draft = settings" Disabled="@_busy"
                                  HideChatDeletion="@IsBranch" />
            @if (_error is not null)
            {
                <p class="chat-usage-note context-note-critical" role="alert">@_error</p>
            }
            else if (Calendar.Validate(draft) is { } invalid && !string.IsNullOrWhiteSpace(draft.Task))
            {
                @* Says why Save is unavailable; an empty task needs no words, its box is right there. *@
                <p class="chat-usage-note context-note-warning">@invalid</p>
            }
            <div class="chat-schedule-actions">
                <button class="compact-action chat-schedule-primary" type="button" disabled="@(_busy || Calendar.Validate(draft) is not null)"
                        title="@Calendar.Validate(draft)" @onclick="SaveAsync">
                    <AppIcon Name="check" /> @(_schedule is null ? "Schedule" : "Save")
                </button>
                <button class="compact-action secondary-action" type="button" disabled="@_busy" @onclick="CancelEdit">Cancel</button>
            </div>
        </div>
    }
    else if (_schedule is not { } schedule)
    {
        <div class="chat-usage-section chat-schedule-intro">
            <p class="chat-usage-empty">@(IsBranch ? "This branch" : "This chat") runs only when you write in it. Schedule it to run its task on a date or a recurrence, in a child branch each time.</p>
            @if (!CanSchedule)
            {
                <p class="chat-usage-footnote">Only an ordinary conversation can be scheduled.</p>
            }
            else
            {
                <button class="compact-action chat-schedule-primary" type="button" @onclick="StartScheduling">
                    <AppIcon Name="stopwatch" /> Schedule this @(IsBranch ? "branch" : "chat")
                </button>
            }
        </div>
    }
    else
    {
        var state = Presentation.State(schedule);
        var settings = schedule.Settings;
        var next = NextRun(schedule);
        <div class="chat-usage-section">
            <div class="chat-widget-headline">
                @if (next is { } at && state.Kind is ChatScheduleStateKind.Active or ChatScheduleStateKind.Running or ChatScheduleStateKind.Blocked)
                {
                    <span class="chat-widget-count chat-schedule-countdown" role="timer" title="@($"Time left until the next run, {Presentation.Moment(at, settings.TimeZone, _now)}")">@Presentation.Countdown(at, _now)</span>
                    <span class="chat-usage-muted">until @(schedule.RetryAt == at ? "the retry" : "the next run")</span>
                }
                else
                {
                    <span class="chat-widget-count chat-schedule-countdown is-idle">@(state.Kind == ChatScheduleStateKind.Paused ? "Paused" : "—")</span>
                }
                <span class="chat-widget-headline-aside chat-schedule-state is-@state.Kind.ToString().ToLowerInvariant()" title="@state.Title"><i aria-hidden="true"></i>@state.Label</span>
            </div>
            <p class="chat-schedule-when">
                <AppIcon Name="@(settings.Recurrence.Frequency == ScheduleFrequency.Once ? "calendar" : "repeat")" />
                <span>
                    @if (next is { } shown && state.Kind != ChatScheduleStateKind.Paused)
                    {
                        <b>@Presentation.Moment(shown, settings.TimeZone, _now)</b><span class="chat-schedule-dot" aria-hidden="true">·</span>
                    }
                    @Descriptions.Describe(settings.Recurrence)
                </span>
            </p>
            @if (schedule.Demo)
            {
                <p class="chat-usage-note" title="Set up by the application guide to show a schedule">Guide demo: this schedule starts no run. Change it, and it becomes your own.</p>
            }
            @if (schedule.ActiveRun is { BranchId: { } activeBranch } active)
            {
                <div class="chat-usage-note @(active.Status == ScheduleRunStatus.Blocked ? "context-note-warning" : null)">
                    <span>@(active.Status == ScheduleRunStatus.Blocked ? $"Run #{active.Number} waits for you: an approval, an answer or a resume." : $"Run #{active.Number} is going now.")</span>
                    <button class="chat-usage-link" type="button" @onclick="() => OnOpenBranch.InvokeAsync(activeBranch)">Open run</button>
                </div>
            }
            <div class="chat-schedule-actions">
                <button class="compact-action" type="button" disabled="@(_busy || schedule.ActiveRun is not null)"
                        title="@(schedule.ActiveRun is null ? "Start a run now, outside the schedule" : "One run goes at a time")" @onclick="RunNowAsync">
                    <AppIcon Name="play" /> Run now
                </button>
                <button class="compact-action" type="button" disabled="@_busy" @onclick="() => PauseAsync(!schedule.Paused)"
                        title="@(schedule.Paused ? "Start runs again; occurrences missed while paused are skipped" : "Stop starting runs; a run going now keeps going")">
                    <AppIcon Name="@(schedule.Paused ? "play" : "pause")" /> @(schedule.Paused ? "Resume" : "Pause")
                </button>
                <button class="compact-action" type="button" disabled="@_busy" @onclick="StartEditing"><AppIcon Name="edit" /> Edit</button>
            </div>
            @if (_error is not null)
            {
                <p class="chat-usage-note context-note-critical" role="alert">@_error</p>
            }
        </div>

        <div class="chat-usage-section">
            <dl class="chat-usage-grid chat-schedule-facts">
                <dt class="chat-usage-grid-row">Task</dt><dd class="chat-usage-grid-wide chat-schedule-task" title="@settings.Task">@settings.Task</dd>
                <dt class="chat-usage-grid-row">Success</dt><dd class="chat-usage-grid-wide" title="@settings.SuccessCriteria">@(settings.SuccessCriteria ?? "The task is done completely")</dd>
                <dt class="chat-usage-grid-row">On failure</dt><dd class="chat-usage-grid-wide" title="@settings.Retry?.Condition">@Presentation.Retry(settings.Retry)</dd>
                <dt class="chat-usage-grid-row">Runs</dt>
                <dd class="chat-usage-grid-wide chat-schedule-rules">
                    @{ var retention = settings.Retention ?? DefaultRetention; }
                    <span class="is-succeeded" title="What happens to the branch of a run that succeeded"><i aria-hidden="true"></i>@Presentation.Retention(retention.Succeeded)</span>
                    <span class="is-failed" title="What happens to the branch of a run that failed"><i aria-hidden="true"></i>@Presentation.Retention(retention.Failed)</span>
                    <span class="is-blocked" title="What happens to the branch of a run that waits for you"><i aria-hidden="true"></i>@Presentation.Retention(retention.Blocked)</span>
                </dd>
                @if (!IsBranch)
                {
                    <dt class="chat-usage-grid-row">Chat</dt><dd class="chat-usage-grid-wide">@Presentation.Deletion(settings.Deletion, settings.TimeZone, _now)</dd>
                }
                <dt class="chat-usage-grid-row">Time zone</dt><dd class="chat-usage-grid-wide">@settings.TimeZone</dd>
            </dl>
        </div>

        <div class="chat-usage-section">
            <div class="chat-usage-row chat-usage-heading">
                <span>Recent runs</span>
                <span class="chat-usage-muted">@RunCount(schedule)</span>
            </div>
            @if (schedule.Runs is not { Count: > 0 } runs)
            {
                <p class="chat-usage-empty">Runs appear here, newest first, with how each one ended.</p>
            }
            else
            {
                var newest = runs.Reverse().ToArray();
                var shownRuns = _showAllRuns ? newest : newest.Take(CollapsedRuns).ToArray();
                <ul class="chat-schedule-runs">
                    @foreach (var run in shownRuns)
                    {
                        var open = run.BranchId is { } branchId && !run.BranchDeleted && BranchExists(branchId);
                        <li @key="run.Id">
                            <button type="button" class="chat-schedule-run is-@run.Status.ToString().ToLowerInvariant()" disabled="@(!open)"
                                    title="@(open ? "Open this run's branch" : RunGoneTitle(run))"
                                    @onclick="() => OpenRunAsync(run)">
                                <span class="chat-schedule-run-mark" aria-hidden="true"><AppIcon Name="@RunIcon(run.Status)" /></span>
                                <span class="chat-schedule-run-body">
                                    <span class="chat-schedule-run-title">
                                        @(run.Number > 0 ? $"#{run.Number} · " : null)@Presentation.Moment(run.Number > 0 ? run.StartedAt : run.ScheduledFor, settings.TimeZone, _now)
                                    </span>
                                    <span class="chat-schedule-run-meta">
                                        <span class="chat-schedule-run-status">@Descriptions.Outcome(run.Status)</span>
                                        @if (run.Manual) { <span>manual</span> }
                                        else if (run.Attempt > 1) { <span>retry @(run.Attempt - 1)</span> }
                                        @if (run.BranchDeleteAt is { } deleteAt && !run.BranchDeleted && open) { <span title="The run branch is deleted by its rule">deleted @Presentation.Moment(deleteAt, settings.TimeZone, _now).ToLowerInvariant()</span> }
                                    </span>
                                    @if (run.Summary is { Length: > 0 } summary)
                                    {
                                        <span class="chat-schedule-run-summary" title="@summary">@summary</span>
                                    }
                                </span>
                            </button>
                        </li>
                    }
                </ul>
                @if (newest.Length > CollapsedRuns)
                {
                    <button class="chat-usage-link" type="button" @onclick="() => _showAllRuns = !_showAllRuns">@(_showAllRuns ? "Show fewer" : $"Show all {newest.Length}")</button>
                }
            }
        </div>

        <div class="chat-usage-section chat-schedule-remove">
            @if (_confirmRemove)
            {
                <div class="chat-usage-note context-note-warning" role="alert">
                    <span>Remove the schedule? The conversation and its branches stay; no more runs start here.</span>
                    <span class="chat-usage-note-actions">
                        <button class="compact-action chat-schedule-danger" type="button" disabled="@_busy" @onclick="RemoveAsync">Remove</button>
                        <button class="compact-action secondary-action" type="button" disabled="@_busy" @onclick="() => _confirmRemove = false">Keep</button>
                    </span>
                </div>
            }
            else
            {
                <button class="chat-usage-link chat-schedule-remove-link" type="button" disabled="@_busy" @onclick="() => _confirmRemove = true">
                    <AppIcon Name="chat-schedule-delete" /> Remove the schedule
                </button>
            }
        </div>
    }
</ChatWidget>

@code {
    private const int CollapsedRuns = 5;
    private static readonly ScheduleBranchRetention DefaultRetention = new(
        new ScheduleRetentionRule(ScheduleRetentionAction.Delete), new ScheduleRetentionRule(ScheduleRetentionAction.Keep),
        new ScheduleRetentionRule(ScheduleRetentionAction.Keep));

    [Parameter, EditorRequired] public ChatWidgetContext Widget { get; set; } = null!;
    [Parameter] public ChatDetails? Chat { get; set; }
    [Parameter] public Guid? BranchId { get; set; }

    /// <summary>Saves settings; returns what the Host refused, or null.</summary>
    [Parameter] public Func<SetChatScheduleRequest, Task<string?>>? OnSave { get; set; }
    [Parameter] public Func<bool, long, Task<string?>>? OnPause { get; set; }
    [Parameter] public Func<Task<string?>>? OnRemove { get; set; }
    [Parameter] public Func<Task<string?>>? OnRunNow { get; set; }
    [Parameter] public EventCallback<Guid> OnOpenBranch { get; set; }

    /// <summary>Whether a new chat can be scheduled here: a project is open and no chat is.</summary>
    [Parameter] public bool CanCreate { get; set; }

    /// <summary>The text in the message box, the task a new schedule starts from.</summary>
    [Parameter] public string? ComposerText { get; set; }

    /// <summary>Grows each time the message box asks for the editor (Alt+Shift+Enter).</summary>
    [Parameter] public int? DraftRequest { get; set; }

    private ChatSchedule? _schedule;
    private ChatScheduleSettings? _draft;
    private string? _error;
    private bool _busy;
    private bool _confirmRemove;
    private bool _showAllRuns;
    private Guid? _chatId;
    private Guid? _loadedBranchId;
    private bool IsBranch => Chat is { } chat && BranchId is { } branchId && branchId != chat.Id;
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private Timer? _ticker;
    private Timer? _refreshTicker;
    private int? _draftRequest;
    private bool _focusEditor;
    private ElementReference _editorHeading;

    private bool CanSchedule => Chat is { Kind: "conversation" or ChatSchedule.Kind } || Chat is null && CanCreate;

    protected override void OnInitialized()
    {
        _refreshTicker = new Timer(_ => _ = InvokeAsync(async () =>
        {
            await RefreshAsync();
            _now = DateTimeOffset.UtcNow;
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    protected override async Task OnParametersSetAsync()
    {
        Guid? selectedBranch = Chat is null ? null : BranchId ?? Chat.Id;
        if (Chat?.Id != _chatId || selectedBranch != _loadedBranchId)
        {
            _chatId = Chat?.Id;
            _loadedBranchId = selectedBranch;
            _draft = null;
            _error = null;
            _confirmRemove = false;
            _showAllRuns = false;
            _schedule = null;
            await RefreshAsync();
        }
        _now = DateTimeOffset.UtcNow;
        if (DraftRequest is { } request && request != _draftRequest)
        {
            _draftRequest = request;
            // The message box asked: its text is the task, of a new schedule or of the one being edited.
            if (_schedule is { } existing)
                _draft = string.IsNullOrWhiteSpace(ComposerText) ? existing.Settings : existing.Settings with { Task = ComposerText.Trim() };
            else
                StartScheduling();
            _error = null;
            _focusEditor = true;
        }
        Tick();
    }

    private async Task RefreshAsync()
    {
        if (Chat is null || _loadedBranchId is not { } branchId) return;
        var chatId = Chat.Id;
        try
        {
            var schedule = (await ScheduleApi.GetAsync(Chat.ProjectId, chatId, branchId, CancellationToken.None)).Schedule;
            if (Chat?.Id == chatId && _loadedBranchId == branchId) _schedule = schedule;
        }
        catch (AI.Web.Chats.ChatScheduleException)
        {
            if (Chat?.Id == chatId && _loadedBranchId == branchId) _schedule = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusEditor || _draft is null) return;
        _focusEditor = false;
        // Focus brings the editor into view in the column and puts the keyboard where the person continues.
        try { await _editorHeading.FocusAsync(); }
        catch (InvalidOperationException) { }
    }

    /// <summary>The countdown ticks every second in its last hour, otherwise every half minute.</summary>
    private void Tick()
    {
        var next = _schedule is { } schedule ? NextRun(schedule) : null;
        var period = next is { } at && at - _now < TimeSpan.FromHours(1) ? TimeSpan.FromSeconds(1) : TimeSpan.FromSeconds(30);
        if (next is null || Widget.Preference.Collapsed && period > TimeSpan.FromSeconds(1))
        {
            _ticker?.Dispose();
            _ticker = null;
            return;
        }
        _ticker ??= new Timer(_ => InvokeAsync(() =>
        {
            _now = DateTimeOffset.UtcNow;
            StateHasChanged();
        }), null, period, period);
        _ticker.Change(period, period);
    }

    public void Dispose()
    {
        _ticker?.Dispose();
        _refreshTicker?.Dispose();
    }

    private static DateTimeOffset? NextRun(ChatSchedule schedule)
    {
        if (schedule.Paused) return null;
        return new[] { schedule.NextRunAt, schedule.RetryAt }.OfType<DateTimeOffset>().Select(at => (DateTimeOffset?)at).Min();
    }

    private string GetSummary()
    {
        if (_schedule is not { } schedule) return "Not scheduled";
        var state = Presentation.State(schedule);
        return state.Kind is ChatScheduleStateKind.Active && NextRun(schedule) is { } next
            ? $"in {Presentation.Countdown(next, _now)}"
            : state.Label;
    }

    private void StartScheduling()
    {
        // What is in the message box is what the person means now; otherwise the chat's first request.
        var task = !string.IsNullOrWhiteSpace(ComposerText) ? ComposerText.Trim()
            : Chat?.Messages.Where(message => message.Role == "User" && message.Content.Length > 0)
                .OrderBy(message => message.CreatedAt).Select(message => message.Content.Trim()).FirstOrDefault() ?? string.Empty;
        _draft = Presentation.Draft(task.Length > 4000 ? task[..4000] : task, Calendar.LocalTimeZoneId,
            Calendar.ToLocal(DateTimeOffset.UtcNow, Calendar.LocalTimeZoneId));
        _error = null;
    }

    private void StartEditing()
    {
        _draft = _schedule?.Settings;
        _error = null;
    }

    private void CancelEdit()
    {
        _draft = null;
        _error = null;
    }

    private async Task SaveAsync()
    {
        if (_draft is not { } draft || OnSave is null) return;
        if (await RunAsync(() => OnSave(new SetChatScheduleRequest(draft, _schedule?.Revision))) && _error is null) _draft = null;
    }

    private Task PauseAsync(bool paused) => OnPause is null || _schedule is null
        ? Task.CompletedTask : RunAsync(() => OnPause(paused, _schedule.Revision));

    private async Task RemoveAsync()
    {
        if (OnRemove is null) return;
        await RunAsync(OnRemove);
        _confirmRemove = false;
    }

    private Task RunNowAsync() => OnRunNow is null ? Task.CompletedTask : RunAsync(OnRunNow);

    private async Task<bool> RunAsync(Func<Task<string?>> action)
    {
        _busy = true;
        _error = null;
        try
        {
            _error = await action();
            return true;
        }
        finally
        {
            _busy = false;
            await RefreshAsync();
        }
    }

    private Task OpenRunAsync(ScheduleRunRecord run) =>
        run.BranchId is { } branchId ? OnOpenBranch.InvokeAsync(branchId) : Task.CompletedTask;

    private bool BranchExists(Guid branchId) => Chat?.Branches?.Any(branch => branch.Id == branchId) == true;

    private static string RunCount(ChatSchedule schedule)
    {
        var finished = schedule.Runs?.Count(run => run.Number > 0 && run.Status is not (ScheduleRunStatus.Running or ScheduleRunStatus.Blocked)) ?? 0;
        var succeeded = schedule.Runs?.Count(run => run.Status == ScheduleRunStatus.Succeeded) ?? 0;
        return finished == 0 ? string.Empty : $"{succeeded} of {finished} succeeded";
    }

    private static string RunGoneTitle(ScheduleRunRecord run) => run.BranchId is null
        ? "This occurrence did not run"
        : "The run's branch was deleted";

    private static string RunIcon(ScheduleRunStatus status) => status switch
    {
        ScheduleRunStatus.Running => "generating",
        ScheduleRunStatus.Blocked => "hand",
        ScheduleRunStatus.Succeeded => "check",
        ScheduleRunStatus.Failed => "error",
        _ => "minimize"
    };
}
