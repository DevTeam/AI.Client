@inject IUsagePresentation Usage
@inject IComposerContextPresentation ContextPresentation
@* What the open chat holds and has spent: the context window now, then one set of figures for the
   whole chat or for the turn in progress (or the last one), and where the tokens went. Figures the endpoint did not report are
   marked "≈" rather than passed off as billed ones. *@
<ChatWidget Widget="@Widget" Summary="@GetSummary()" Class="chat-usage-widget">
    @if (Context is { } context)
    {
        var free = Math.Max(0, context.CapacityTokens - context.UsedTokens);
        <div class="chat-usage-section">
            <div class="chat-usage-row chat-usage-heading">
                <span class="chat-usage-connection" title="@ConnectionName">Context@(ConnectionName is null ? null : " · ")<span class="chat-usage-muted">@ConnectionName</span></span>
                <span class="chat-usage-figure">
                    <span class="chat-usage-muted">@Usage.FormatTokens(context.UsedTokens) / @(context.IsDefaultCapacity ? "~" : null)@Usage.FormatTokens(context.CapacityTokens)</span>
                    <span class="context-fill-@context.Level.ToString().ToLowerInvariant()">@context.Percent%</span>
                </span>
            </div>
            <div class="chat-usage-bar" role="img"
                 aria-label="@($"{context.Percent}% of the context window used: {Usage.FormatTokens(context.UsedTokens)} of {Usage.FormatTokens(context.CapacityTokens)}")">
                @foreach (var layer in context.Layers.Where(layer => layer.Tokens > 0))
                {
                    <span @key="layer.Kind" class="chat-usage-bar-segment context-layer-@layer.CssName @(layer.Reserved ? "reserved" : null)"
                          style="flex-grow: @Grow(layer.Tokens, context.CapacityTokens)" title="@layer.Label: @Usage.FormatTokens(layer.Tokens)"></span>
                }
                <span class="chat-usage-bar-free" style="flex-grow: @Grow(free, context.CapacityTokens)"></span>
            </div>
            <div class="chat-usage-legend">
                @foreach (var layer in context.Layers.Where(layer => layer.Tokens > 0 && !layer.Reserved))
                {
                    <span @key="layer.Kind"><span class="context-swatch context-layer-@layer.CssName"></span>@layer.Label <b>@Usage.FormatTokens(layer.Tokens)</b></span>
                }
                <span><span class="context-swatch"></span>Free <b>@Usage.FormatTokens(free)</b></span>
            </div>
            @if (Usage.FormatRateLimits(ChatUsage?.RateLimits, DateTimeOffset.UtcNow) is { } limits)
            {
                <div class="chat-usage-row chat-usage-muted @(Usage.IsRateLimitLow(ChatUsage?.RateLimits) ? "chat-usage-limit-low" : null)"
                     title="What the provider said is left of its limits with its last response">
                    <span>Limits: @limits</span>
                </div>
            }
            @if (ContextPresentation.Note(context) is { } note && CompactionNote is null)
            {
                <div class="chat-usage-note context-note-@context.Level.ToString().ToLowerInvariant()">
                    <span>@note</span>
                    @if (context.Level != ContextFillLevel.Normal)
                    {
                        <span class="chat-usage-note-actions">
                            @if (CanCompact) { <button class="compact-action" type="button" disabled="@Compacting" @onclick="OnCompact">@(Compacting ? "Compacting…" : "Compact now")</button> }
                            @if (OnNewChat.HasDelegate) { <button class="compact-action" type="button" @onclick="OnNewChat">New chat</button> }
                        </span>
                    }
                </div>
            }
            @if (CompactionNote is { } compactionNote)
            {
                <p class="chat-usage-note" role="status">@compactionNote</p>
            }
            @if (ActiveCheckpoint is { } checkpoint)
            {
                <div class="chat-usage-row chat-usage-muted chat-usage-checkpoint">
                    <span title="@checkpoint.CreatedAt.LocalDateTime.ToString("g")">Earlier turns summarized · @checkpoint.CoveredMessages @(checkpoint.CoveredMessages == 1 ? "message" : "messages")</span>
                    @if (OnUndoCheckpoint.HasDelegate) { <button class="chat-usage-link" type="button" @onclick="() => OnUndoCheckpoint.InvokeAsync(checkpoint)">Undo</button> }
                </div>
            }
            else if (CanCompact && context.Level == ContextFillLevel.Normal && ChatUsage?.Turns.Count > 2)
            {
                <div class="chat-usage-row">
                    <button class="chat-usage-link" type="button" disabled="@Compacting" title="Summarize all but the last two turns for the model"
                            @onclick="OnCompact">@(Compacting ? "Compacting…" : "Compact earlier turns")</button>
                </div>
            }
        </div>
    }

    <ChatWidgetScopeSwitch @bind-Value="_scope" />
    @if (GetFigures() is { } figures)
    {
        var totals = figures.Totals;
        <div class="chat-usage-section chat-usage-scope-figures">
            <div class="chat-usage-row chat-usage-headline">
                <span class="chat-usage-figure" title="Input → output tokens">@Usage.FormatFlow(totals)@if (figures.Running) { <small>so far</small> }</span>
                @if (Usage.FormatCost(totals) is { } cost)
                {
                    <span class="chat-usage-figure">
                        @cost
                        @if (totals.PricedRequests < totals.Requests) { <small title="Some requests went to a connection without prices">partial</small> }
                        else if (totals.EstimatedCostRequests > 0) { <small title="@($"The endpoint quoted a cost for some requests only; the other {totals.EstimatedCostRequests} are worked out from those quotes")">estimated</small> }
                    </span>
                }
                else if (OnOpenConnections.HasDelegate)
                {
                    <button class="chat-usage-link" type="button" @onclick="OnOpenConnections">Set prices</button>
                }
            </div>
            <dl class="chat-usage-grid">
                @if (figures.Turns is { } turns) { <dt>Turns</dt><dd>@turns</dd> }
                <dt>Requests</dt><dd>@totals.Requests</dd>
                @if (Usage.CachePercent(totals.Tokens) is { } cache)
                {
                    var reusable = Usage.ReusablePercent(totals);
                    var missed = reusable is { } possible && possible - cache >= 20;
                    <dt>Cached</dt>
                    <dd title="@(missed ? $"Up to {reusable}% could have come from the cache: the requests started the same as the ones before them, but the provider did not serve that, so it may have expired or been dropped" : "Input served from the provider's cache")">
                        @cache%@if (missed) { <small>/@reusable%</small> }
                    </dd>
                }
                @if (totals.Tokens.ReasoningTokens > 0) { <dt>Reasoning</dt><dd>@Usage.FormatTokens(totals.Tokens.ReasoningTokens)</dd> }
                @if (Usage.OutputSpeed(totals) is { } speed) { <dt>Speed</dt><dd>@speed tok/s</dd> }
                @if (Usage.FormatPrefixChanges(totals) is { } changes)
                {
                    <dt class="chat-usage-grid-row" title="Requests whose start differed from the request before them, which costs the provider's cache">Cache reset</dt>
                    <dd class="chat-usage-grid-wide">@changes</dd>
                }
            </dl>
        </div>

        var shares = Usage.Shares(figures.ByPurpose);
        @if (shares.Count > 1)
        {
            <div class="chat-usage-section">
                <ul class="chat-usage-shares">
                    @foreach (var share in shares)
                    {
                        <li @key="share.Key">
                            <span class="chat-usage-share-label">@share.Label</span>
                            <span class="chat-usage-share-track"><span style="width: @Percent(share.Fraction)%"></span></span>
                            <span class="chat-usage-share-value">@(share.Fraction < 0.005 ? "<1" : Math.Round(share.Fraction * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%</span>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (Usage.IsEstimated(totals))
        {
            <p class="chat-usage-footnote">≈ estimated: @totals.EstimatedRequests of @totals.Requests requests went to an endpoint that does not report usage.</p>
        }
    }
    else
    {
        <p class="chat-usage-empty">Token usage appears here once the chat sends its first request.</p>
    }
</ChatWidget>

@code {
    [Parameter, EditorRequired]
    public ChatWidgetContext Widget { get; set; } = null!;

    /// <summary>The window as the composer ring shows it; null when context usage is switched off.</summary>
    [Parameter]
    public ComposerContext? Context { get; set; }

    [Parameter]
    public ChatTokenUsage? ChatUsage { get; set; }

    /// <summary>The turn the run is on, as the run snapshot reports it while it happens.</summary>
    [Parameter]
    public TurnTokenUsage? LiveTurn { get; set; }

    [Parameter]
    public bool IsGenerating { get; set; }

    [Parameter]
    public string? ConnectionName { get; set; }

    [Parameter]
    public EventCallback OnNewChat { get; set; }

    [Parameter]
    public EventCallback OnOpenConnections { get; set; }

    /// <summary>The summary the model's view of this branch starts from, if any.</summary>
    [Parameter]
    public HistoryCheckpoint? ActiveCheckpoint { get; set; }

    [Parameter]
    public bool Compacting { get; set; }

    /// <summary>What the last compaction did, until a turn has run on it.</summary>
    [Parameter]
    public string? CompactionNote { get; set; }

    [Parameter]
    public EventCallback OnCompact { get; set; }

    [Parameter]
    public EventCallback<HistoryCheckpoint> OnUndoCheckpoint { get; set; }

    /// <summary>What the chosen scope used; <see cref="ScopeFigures.Running"/> for a turn still going.</summary>
    private sealed record ScopeFigures(TokenUsageTotals Totals, IReadOnlyList<TokenUsageSlice> ByPurpose, int? Turns = null, bool Running = false);

    private ChatWidgetScope _scope = ChatWidgetScope.Chat;

    private ScopeFigures? GetFigures()
    {
        if (_scope == ChatWidgetScope.LastTurn)
            return GetTurn() is { Totals.Requests: > 0 } turn
                ? new ScopeFigures(turn.Totals, turn.ByPurpose, Running: IsGenerating && LiveTurn?.TurnId == turn.TurnId)
                : null;
        return ChatUsage is { Totals.Requests: > 0 } chat
            ? new ScopeFigures(chat.Totals, chat.ByPurpose, chat.Turns.Count)
            : null;
    }

    // A running turn built its request already; the history is compacted between turns.
    private bool CanCompact => OnCompact.HasDelegate && !IsGenerating;

    private TurnTokenUsage? GetTurn() =>
        LiveTurn is { } live && (ChatUsage?.Turns.LastOrDefault() is not { } stored
                                 || stored.TurnId == live.TurnId && live.Totals.Requests >= stored.Totals.Requests
                                 || stored.TurnId != live.TurnId && live.StartedAt >= stored.StartedAt)
            ? live
            : ChatUsage?.Turns.LastOrDefault();

    private string? GetSummary()
    {
        var parts = new List<string>();
        if (Context is { } context) parts.Add($"{context.Percent}%");
        if (GetFigures() is { } figures) parts.Add(Usage.FormatCost(figures.Totals) ?? Usage.FormatFlow(figures.Totals));
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    private static string Grow(long tokens, long capacity) =>
        (capacity <= 0 ? 0 : (double)tokens / capacity).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);

    private static string Percent(double fraction) =>
        Math.Max(2, fraction * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
