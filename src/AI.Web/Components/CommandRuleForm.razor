@inject IGlobalSettingsApi GlobalSettingsApi
@inject INotificationService Notifications

@* Adds a global command rule for one tool; rules are written only in the global tool settings. *@
@* A group, not a form: the global settings already wrap it in one, and forms do not nest. *@
<div class="command-rule-form" role="group" aria-label="New command rule">
    <input aria-label="@(IsPath ? "Path pattern" : "Command pattern")" placeholder="@(IsPath ? "docs/**" : "git diff *")"
           spellcheck="false" autocomplete="off" maxlength="2000" value="@_pattern"
           @oninput="e => _pattern = e.Value?.ToString() ?? string.Empty" @onkeydown="OnKeyDownAsync" disabled="@_saving" />
    <select aria-label="Decision for the new command rule" @bind="_decision" disabled="@_saving">
        <option value="Allow">Allow</option><option value="Ask">Ask</option><option value="Deny">Deny</option>
    </select>
    <button type="button" title="Save this command rule" disabled="@(_saving || string.IsNullOrWhiteSpace(_pattern))" @onclick="AddAsync">Add</button>
</div>
@if (_error is not null) { <p class="error" role="alert">@_error</p> }
@if (IsPath)
{
    <p class="command-rule-hint">A path below the project, with <code>/</code> between folders: <code>*</code> or <code>?</code> inside a name is a mask, <code>**</code> stands for any number of folders. A full path matches only there. A call that names several paths needs all of them for Allow and any one for Deny. A Deny always wins; otherwise the most specific rule decides.</p>
}
else
{
    <p class="command-rule-hint">The program's name, then its arguments word by word. <code>*</code> or <code>?</code> inside a word is a mask; a lone <code>*</code> at the end allows any further arguments. A Deny always wins; otherwise the most specific rule decides.</p>
}

@code {
    /// <summary>The tool whose calls the new rule decides.</summary>
    [Parameter] public string Tool { get; set; } = CommandRule.ProcessRun;
    [Parameter] public EventCallback<CommandRule> Saved { get; set; }

    private string _pattern = string.Empty;
    private string _decision = "Allow";
    private bool _saving;
    private string? _error;

    private bool IsPath => CommandRule.IsPathTool(Tool);

    /// <summary>Enter adds the rule; a settings form around this group already refuses to submit.</summary>
    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_pattern) && !_saving) await AddAsync();
    }

    private async Task AddAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            var rule = await GlobalSettingsApi.AddCommandRuleAsync(new CreateCommandRuleRequest(CommandRule.Global,
                null, null, _pattern.Trim(), _decision, Tool), CancellationToken.None);
            _pattern = string.Empty;
            Notifications.ShowSuccess("Command rule saved.");
            await Saved.InvokeAsync(rule);
        }
        // The Host explains a pattern it refuses ("A command pattern starts with the program's name…").
        catch (InvalidOperationException error) { _error = error.Message; }
        catch (HttpRequestException) { _error = "The command rule could not be saved."; }
        finally { _saving = false; }
    }
}
