@inject AI.Web.Navigation.IAppControlHints ControlHints
<span class="composer-send-wrapper @(Context is { } ringContext ? $"has-context context-{ringContext.Level.ToString().ToLowerInvariant()}" : null)">
    @* The ring sits around the button as a quiet halo, grey at rest and in the layer colours
       while the tooltip explains them; only a filling window colours it on its own. The figures
       behind it are in the Context widget. *@
    @if (Context is not null) { <ContextRing Context="@Context" Size="50" Thickness="2.5" Gap="9" Class="composer-send-ring" /> }
    <button @attributes="@(ControlHints.Attributes("chat.send", GetActionLabel(), nativeTooltip: false))" class="composer-send" type="button" disabled="@Disabled" aria-label="@GetAriaLabel()" aria-describedby="composer-send-tooltip" @onclick="OnClick">
        @* Keyed by the icon, so a held modifier swaps it with a short entrance instead of a jump. *@
        <AppIcon @key="GetIcon()" Name="@GetIcon()" Class="@(Busy ? "tool-row-spinner" : "composer-send-icon")" />
    </button>
    @* The shared help stays on the button as data-app-hint, where the guide reads it; the panel
       keeps only what the current send mode adds: one row per action, its keys aligned on the
       right, the action the keys held now would take highlighted. While a turn is generating,
       Esc stopping it is listed last; it is no way of sending, so it is never highlighted. *@
    <span class="composer-send-tooltip" id="composer-send-tooltip" role="tooltip">
        @if (ActiveMode is SendMode.EditFork or SendMode.Replace)
        {
            @Row(new(ActiveMode, ActiveMode == SendMode.EditFork ? "fork" : "edit-replace", GetActionLabel(), ["Enter"]))
        }
        else
        {
            @foreach (var row in Rows())
            {
                @Row(row)
            }
            <span class="composer-send-tooltip-footnote" data-app-tooltip-hint><kbd>Shift</kbd><kbd>Enter</kbd><span>new line</span></span>
        }
    </span>
</span>

@code {
    [Parameter, EditorRequired]
    public SendMode ActiveMode { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnClick { get; set; }

    /// <summary>Whether the branch is generating a turn: Enter then adds to it and Esc stops it.</summary>
    [Parameter]
    public bool TurnInFlight { get; set; }

    /// <summary>Whether the text can become the task of a schedule instead of a message.</summary>
    [Parameter]
    public bool CanSchedule { get; set; } = true;

    private string SendLabel => TurnInFlight ? "Add to the current turn" : "Send";

    /// <summary>How the context window is filled; no ring is drawn without it.</summary>
    [Parameter]
    public ComposerContext? Context { get; set; }

    private sealed record TooltipRow(SendMode? Mode, string Icon, string Label, string[] Keys);

    private IEnumerable<TooltipRow> Rows()
    {
        yield return new(SendMode.Send, TurnInFlight ? "send-aside" : "arrow-up", SendLabel, ["Enter"]);
        yield return new(SendMode.Queue, "send-queue", "Queue for later", ["Ctrl", "Enter"]);
        yield return new(SendMode.Fork, "send-fork", "Send in a forked session", ["Ctrl", "Alt", "Enter"]);
        if (CanSchedule) yield return new(SendMode.Schedule, "send-schedule", "Schedule instead of sending", ["Alt", "Shift", "Enter"]);
        if (TurnInFlight) yield return new(null, "stop", "Stop the turn", ["Esc"]);
    }

    private RenderFragment Row(TooltipRow row) =>
        @<span class="composer-send-tooltip-row @(row.Mode == ActiveMode ? "active" : null)" data-app-tooltip-hint>
            <AppIcon Name="@row.Icon" Class="composer-send-tooltip-icon" />
            <span class="composer-send-tooltip-label">@row.Label</span>
            <span class="composer-send-tooltip-keys">
                @foreach (var key in row.Keys)
                {
                    <kbd>@key</kbd>
                }
            </span>
        </span>;

    private string GetAriaLabel() => Context is { } context
        ? $"{GetActionLabel()}, context {context.Percent}% full"
        : GetActionLabel();

    private string GetActionLabel() => ActiveMode switch
    {
        SendMode.EditFork => "Create edited branch",
        SendMode.Replace => "Replace branch now",
        SendMode.Queue => "Queue for later",
        SendMode.Fork => "Send in a forked session",
        SendMode.Schedule => "Schedule instead of sending",
        _ => TurnInFlight ? "Add to the current turn" : "Send message"
    };

    private string GetIcon() => Busy ? "spinner" : ActiveMode switch
    {
        // Every way of sending is the send arrow, varied; editing a branch keeps its own icons.
        SendMode.Queue => "send-queue",
        SendMode.Fork => "send-fork",
        SendMode.EditFork => "fork",
        SendMode.Replace => "edit-replace",
        SendMode.Schedule => "send-schedule",
        _ => TurnInFlight ? "send-aside" : "arrow-up"
    };

    public enum SendMode { Send, Queue, Fork, EditFork, Replace, Schedule }
}
