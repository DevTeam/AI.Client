@inject AI.Web.Navigation.IAppControlHints ControlHints
<span class="composer-send-wrapper @(Context is { } ringContext ? $"has-context context-{ringContext.Level.ToString().ToLowerInvariant()}" : null)">
    @* The ring sits around the button as a quiet halo, grey at rest and in the layer colours
       while the tooltip explains them; only a filling window colours it on its own. The figures
       behind it are in the Context widget. *@
    @if (Context is not null) { <ContextRing Context="@Context" Size="50" Thickness="2.5" Gap="9" Class="composer-send-ring" /> }
    <button @attributes="@(ControlHints.Attributes("chat.send", GetActionLabel(), nativeTooltip: false))" class="composer-send" type="button" disabled="@Disabled" aria-label="@GetAriaLabel()" aria-describedby="composer-send-tooltip" @onclick="OnClick">
        <AppIcon Name="@GetIcon()" Class="@(Busy ? "tool-row-spinner" : null)" />
    </button>
    @* The shared help stays on the button as data-app-hint, where the guide reads it; the panel
       keeps only what the current send mode adds, the key rows. *@
    <span class="composer-send-tooltip" id="composer-send-tooltip" role="tooltip">
        @if (ActiveMode == SendMode.EditFork)
        {
            <span class="composer-send-tooltip-row active" data-app-tooltip-hint><kbd>Enter</kbd><span class="composer-send-tooltip-label">Create edited branch</span></span>
        }
        else if (ActiveMode == SendMode.Replace)
        {
            <span class="composer-send-tooltip-row active" data-app-tooltip-hint><kbd>Enter</kbd><span class="composer-send-tooltip-label">Replace branch now</span></span>
        }
        else
        {
            <span class="composer-send-tooltip-row @(ActiveMode == SendMode.Send ? "active" : string.Empty)" data-app-tooltip-hint><kbd>Enter</kbd><span class="composer-send-tooltip-label">Send</span></span>
            <span class="composer-send-tooltip-row @(ActiveMode == SendMode.Queue ? "active" : string.Empty)" data-app-tooltip-hint><kbd>Ctrl</kbd><span>+</span><kbd>Enter</kbd><span class="composer-send-tooltip-label">Queue for later</span></span>
            <span class="composer-send-tooltip-row @(ActiveMode == SendMode.Fork ? "active" : string.Empty)" data-app-tooltip-hint><kbd>Ctrl</kbd><span>+</span><kbd>Alt</kbd><span>+</span><kbd>Enter</kbd><span class="composer-send-tooltip-label">Send in a forked session</span></span>
            <span class="composer-send-tooltip-row @(ActiveMode == SendMode.SendNow ? "active" : string.Empty)" data-app-tooltip-hint><kbd>Ctrl</kbd><span>+</span><kbd>Shift</kbd><span>+</span><kbd>Enter</kbd><span class="composer-send-tooltip-label">Interrupt and send now</span></span>
            @if (CanAside)
            {
                <span class="composer-send-tooltip-row @(ActiveMode == SendMode.Aside ? "active" : string.Empty)" data-app-tooltip-hint><kbd>Alt</kbd><span>+</span><kbd>Enter</kbd><span class="composer-send-tooltip-label">@AsideLabel</span></span>
            }
        }
    </span>
</span>

@code {
    [Parameter, EditorRequired]
    public SendMode ActiveMode { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnClick { get; set; }

    /// <summary>Whether there is a conversation an aside could join; a new chat starts with a turn.</summary>
    [Parameter]
    public bool CanAside { get; set; }

    /// <summary>Whether a turn is in flight on the branch, which is what an aside then joins.</summary>
    [Parameter]
    public bool TurnInFlight { get; set; }

    private string AsideLabel => TurnInFlight ? "Add to the current turn" : "Add as an aside, no reply";

    /// <summary>How the context window is filled; no ring is drawn without it.</summary>
    [Parameter]
    public ComposerContext? Context { get; set; }

    private string GetAriaLabel() => Context is { } context
        ? $"{GetActionLabel()}, context {context.Percent}% full"
        : GetActionLabel();

    private string GetActionLabel() => ActiveMode switch
    {
        SendMode.SendNow => "Interrupt and send now",
        SendMode.EditFork => "Create edited branch",
        SendMode.Replace => "Replace branch now",
        SendMode.Queue => "Queue for later",
        SendMode.Fork => "Send in a forked session",
        SendMode.Aside => AsideLabel,
        _ => "Send message"
    };

    private string GetIcon() => Busy ? "spinner" : ActiveMode switch
    {
        SendMode.SendNow => "zap",
        SendMode.EditFork => "fork",
        SendMode.Replace => "edit-replace",
        SendMode.Aside => "plus",
        _ => "arrow-up"
    };

    public enum SendMode { Send, Queue, Fork, SendNow, EditFork, Replace, Aside }
}
