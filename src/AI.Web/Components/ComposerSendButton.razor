@inject AI.Web.Navigation.IAppControlHints ControlHints
@inject IComposerContextPresentation ContextPresentation
<span class="composer-send-wrapper @(Context is { } ringContext ? $"has-context context-{ringContext.Level.ToString().ToLowerInvariant()}" : null)">
    @* The ring sits around the button as a quiet halo, grey at rest and in the layer colours
       while the tooltip explains them; only a filling window colours it on its own. *@
    @if (Context is not null) { <ContextRing Context="@Context" Size="50" Thickness="2.5" Gap="9" Class="composer-send-ring" /> }
    @* The halo itself opens the chat's usage: a press on the ring rather than on the button. It is
       left out of the tab order, since the header's widget button does the same from the keyboard. *@
    @if (Context is not null && OnContextClick.HasDelegate)
    {
        <button class="composer-send-context-open" type="button" tabindex="-1" aria-label="Show chat usage" @onclick="OnContextClick"></button>
    }
    <button @attributes="@(ControlHints.Attributes("chat.send", GetActionLabel(), nativeTooltip: false))" class="composer-send" type="button" disabled="@Disabled" aria-label="@GetAriaLabel()" aria-describedby="composer-send-tooltip" @onclick="OnClick">
        <AppIcon Name="@GetIcon()" Class="@(Busy ? "tool-row-spinner" : null)" />
    </button>
    <span class="composer-send-tooltip" id="composer-send-tooltip" role="tooltip">
        <span class="composer-send-tooltip-help">@ControlHints.GetHint("chat.send")</span>
        @if (Context is { } context)
        {
            <span class="composer-send-context">
                <span class="composer-send-context-chart">
                    <ContextRing Context="@context" Size="92" Thickness="8" Gap="5" />
                    <span class="composer-send-context-center">
                        <span class="composer-send-context-percent"><AnimatedCount Value="@context.Percent" />%</span>
                        <span class="composer-send-context-total">@ContextPresentation.FormatTokens(context.UsedTokens) / @(context.IsDefaultCapacity ? "~" : null)@ContextPresentation.FormatTokens(context.CapacityTokens)</span>
                    </span>
                </span>
                <span class="composer-send-context-legend">
                    @foreach (var layer in context.Layers)
                    {
                        <span @key="layer.Kind" class="composer-send-context-row @(layer.Reserved ? "reserved" : null)">
                            <span class="context-swatch context-layer-@layer.CssName"></span>
                            <span class="composer-send-context-label">@layer.Label</span>
                            <span class="composer-send-context-value">@(IsKnown(context, layer) ? ContextPresentation.FormatTokens(layer.Tokens) : "—")</span>
                        </span>
                    }
                    <span class="composer-send-context-row free">
                        <span class="context-swatch"></span>
                        <span class="composer-send-context-label">Free</span>
                        <span class="composer-send-context-value">@ContextPresentation.FormatTokens(Math.Max(0, context.CapacityTokens - context.UsedTokens))</span>
                    </span>
                </span>
            </span>
            @if (ContextPresentation.Note(context) is { } note) { <span class="composer-send-context-note context-note-@context.Level.ToString().ToLowerInvariant()">@note</span> }
            <span class="composer-send-tooltip-divider"></span>
        }
        @if (ActiveMode == SendMode.EditFork)
        {
            <span class="composer-send-tooltip-row active" data-app-tooltip-hint><kbd>Enter</kbd><span class="composer-send-tooltip-label">Create edited branch</span></span>
        }
        else if (ActiveMode == SendMode.Replace)
        {
            <span class="composer-send-tooltip-row active" data-app-tooltip-hint><kbd>Enter</kbd><span class="composer-send-tooltip-label">Replace branch now</span></span>
        }
        else
        {
            <span class="composer-send-tooltip-row @(ActiveMode == SendMode.Send ? "active" : string.Empty)" data-app-tooltip-hint><kbd>Enter</kbd><span class="composer-send-tooltip-label">Send</span></span>
            <span class="composer-send-tooltip-row @(ActiveMode == SendMode.Queue ? "active" : string.Empty)" data-app-tooltip-hint><kbd>Ctrl</kbd><span>+</span><kbd>Enter</kbd><span class="composer-send-tooltip-label">Queue for later</span></span>
            <span class="composer-send-tooltip-row @(ActiveMode == SendMode.Fork ? "active" : string.Empty)" data-app-tooltip-hint><kbd>Ctrl</kbd><span>+</span><kbd>Alt</kbd><span>+</span><kbd>Enter</kbd><span class="composer-send-tooltip-label">Send in a forked session</span></span>
            <span class="composer-send-tooltip-row @(ActiveMode == SendMode.SendNow ? "active" : string.Empty)" data-app-tooltip-hint><kbd>Ctrl</kbd><span>+</span><kbd>Shift</kbd><span>+</span><kbd>Enter</kbd><span class="composer-send-tooltip-label">Interrupt and send now</span></span>
        }
    </span>
</span>

@code {
    [Parameter, EditorRequired]
    public SendMode ActiveMode { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnClick { get; set; }

    /// <summary>Pressing the ring around the button; without it the ring only shows.</summary>
    [Parameter]
    public EventCallback OnContextClick { get; set; }

    /// <summary>How the context window is filled; no ring is drawn without it.</summary>
    [Parameter]
    public ComposerContext? Context { get; set; }

    // Before the first measured request only the draft and the reserves are known; the layers the
    // Host measures read as unknown rather than as an empty 0.
    private static bool IsKnown(ComposerContext context, ContextLayer layer) =>
        context.IsMeasured || layer.Reserved || layer.Kind == ContextLayerKind.Draft;


    private string GetAriaLabel() => Context is { } context
        ? $"{GetActionLabel()}, context {context.Percent}% full"
        : GetActionLabel();

    private string GetActionLabel() => ActiveMode switch
    {
        SendMode.SendNow => "Interrupt and send now",
        SendMode.EditFork => "Create edited branch",
        SendMode.Replace => "Replace branch now",
        SendMode.Queue => "Queue for later",
        SendMode.Fork => "Send in a forked session",
        _ => "Send message"
    };

    private string GetIcon() => Busy ? "spinner" : ActiveMode switch
    {
        SendMode.SendNow => "zap",
        SendMode.EditFork => "fork",
        SendMode.Replace => "edit-replace",
        _ => "arrow-up"
    };

    public enum SendMode { Send, Queue, Fork, SendNow, EditFork, Replace }
}
