@implements IDisposable
@inject AI.Web.Settings.ITextCorrectionLanguages Languages
@inject AI.TextCorrection.ITextCorrectionPreparation Preparation
@inject INotificationService Notifications

<section class="settings-group" aria-label="Text correction">
    <div class="settings-card">
        <details class="settings-disclosure">
            <summary class="settings-row" data-app-target="settings.chat.text_correction">
                <span class="settings-row-label">Text correction</span>
                <AppIcon Name="chevron-right" Class="settings-disclosure-chevron" />
            </summary>
            <label class="settings-row" data-app-target="settings.chat.text_correction.enabled">
                <span class="settings-row-text">
                    <span class="settings-row-label">Correct while typing</span>
                    <span class="settings-row-hint">The button in the message editor pauses or resumes correction. If no languages are selected, it opens these language settings.</span>
                </span>
                <input class="settings-switch" type="checkbox" role="switch" checked="@_state.Enabled" disabled="@_saving" @onchange="args => SetEnabledAsync(args.Value is true)" />
            </label>
            <div class="settings-row" data-app-target="settings.chat.text_correction.languages" tabindex="-1" aria-label="Text correction languages">
                <span class="settings-row-text">
                    <span class="settings-row-label">Languages</span>
                    @if (_state.Languages.Count == 0)
                    {
                        <span class="settings-row-hint">Select a language for spelling correction. Select two or more to also correct text typed in the wrong layout.</span>
                    }
                    else if (!_state.Enabled)
                    {
                        <span class="settings-row-hint">Correction is paused. Your languages stay selected until you turn it back on.</span>
                    }
                    else if (_state.Languages.Count == 1)
                    {
                        <span class="settings-row-hint">Spelling correction is enabled. Select another language to also correct text typed in the wrong layout.</span>
                    }
                    else if (_state.Languages.Count > 2)
                    {
                        <span class="settings-row-hint">For optimal performance, we recommend selecting only two languages.</span>
                    }
                </span>
            </div>
            @foreach (var language in Languages.Available)
            {
                <label class="settings-row" data-app-target="@($"settings.chat.text_correction.{language.LanguageId}")">
                    <span class="settings-row-label">@language.Name</span>
                    <input class="settings-switch" type="checkbox" role="switch" checked="@_state.Languages.Any(item => item.LanguageId == language.LanguageId)" disabled="@_saving" @onchange="args => SetLanguageAsync(language.LanguageId, args.Value is true)" />
                </label>
            }
        </details>
    </div>
</section>

@code {
    private AI.Web.Settings.TextCorrectionState _state = new([], true);
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _state = await Languages.GetStateAsync();
        Languages.Changed += OnLanguagesChanged;
    }

    public void Dispose() => Languages.Changed -= OnLanguagesChanged;

    // The switch in the message editor changes the same setting while this panel is open.
    private void OnLanguagesChanged() => _ = InvokeAsync(async () =>
    {
        _state = await Languages.GetStateAsync();
        StateHasChanged();
    });

    private Task SetLanguageAsync(string languageId, bool enabled) =>
        SaveAsync(() => Languages.SetLanguageAsync(languageId, enabled), "Could not update correction languages");

    private Task SetEnabledAsync(bool enabled) =>
        SaveAsync(() => Languages.SetEnabledAsync(enabled), "Could not switch text correction");

    private async Task SaveAsync(Func<ValueTask> save, string failure)
    {
        _saving = true;
        try
        {
            await save();
            _state = await Languages.GetStateAsync();
            var layouts = await Languages.GetLayoutIdsAsync();
            if (layouts.Count > 0) await Preparation.PrepareAsync(layouts);
        }
        catch (Exception error)
        {
            Notifications.ShowError($"{failure}: {error.Message}");
        }
        finally { _saving = false; }
    }
}
