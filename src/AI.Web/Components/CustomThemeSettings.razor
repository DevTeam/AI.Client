@inject AI.Web.Navigation.IAppControlHints ControlHints
@inject AI.Web.Settings.IThemeService Theme
@inject INotificationService Notifications

@implements IDisposable

@* Settings → Appearance: one gallery for every theme, presets and saved ones alike, and below it the
   studio that builds a theme from a background colour and three dials. The gallery is a single radio
   group, so exactly one card is ever selected: a saved theme in use clears the preset cards rather
   than leaving a preset looking chosen while another palette paints the page. The palette itself is
   generated by the engine in AI.Contracts/Themes, so the studio never offers a colour the engine could
   not derive, and the verdict says what the result reads. *@
<section class="settings-group" aria-labelledby="settings-appearance">
    <h3 id="settings-appearance">Appearance</h3>
    <div class="settings-card">
        <div class="settings-row is-stacked theme-gallery-row">
            <span class="settings-row-label" id="settings-theme">Theme</span>
            <div @attributes="@(ControlHints.Attributes("settings.appearance.theme"))" class="theme-gallery" style="@AccentStyle(_presetAccent)" role="radiogroup" aria-labelledby="settings-theme">
                @foreach (var preset in Presets)
                {
                    var selected = _activeId is null && _preference == preset.Value;
                    <label class="theme-card @(selected ? "selected" : null)" data-theme-swatch="@preset.Swatch">
                        <input type="radio" name="theme" value="@preset.Value.ToString().ToLowerInvariant()" checked="@selected" @onchange="() => SetPresetAsync(preset.Value)" />
                        <span class="theme-card-preview" aria-hidden="true">
                            <ThemeCardSketch />
                            @if (preset.Value == AI.Web.Settings.ThemePreference.System)
                            {
                                <span class="theme-card-half" data-theme-swatch="dark"><ThemeCardSketch /></span>
                            }
                        </span>
                        <span class="theme-card-name">@preset.Label</span>
                    </label>
                }
            </div>
            <span class="settings-row-label" id="settings-custom-theme-list">Your themes</span>
            <div @attributes="@(ControlHints.Attributes("settings.appearance.custom_theme"))" class="theme-gallery" role="radiogroup" aria-labelledby="settings-custom-theme-list">
                @foreach (var saved in _themes)
                {
                    var selected = saved.Id == _activeId;
                    <label class="theme-card @(selected ? "selected" : null)" style="@SwatchStyle(saved)" title="@saved.Name">
                        <input type="radio" name="theme" value="@saved.Id" checked="@selected" @onclick="() => ActivateAsync(saved.Id)" />
                        <span class="theme-card-preview" aria-hidden="true"><ThemeCardSketch /></span>
                        <span class="theme-card-name">@saved.Name</span>
                    </label>
                }
                <button class="theme-card is-new" type="button" disabled="@_saving" @onclick="StartNewAsync">
                    <span class="theme-card-preview" aria-hidden="true"><AppIcon Name="plus" /></span>
                    <span class="theme-card-name">New theme</span>
                </button>
            </div>
        </div>
        @ChildContent
    </div>
</section>
<section class="settings-group" aria-labelledby="settings-custom-themes">
    <h3 id="settings-custom-themes">Theme studio</h3>
    <div class="settings-card theme-studio">
        <div class="settings-row theme-studio-head">
            <span class="settings-row-text">
                <span class="settings-row-label">@(_editingId is null ? "New theme" : CleanName)</span>
                <span class="settings-row-hint">@(_status ?? (IsDirty ? "Unsaved changes, shown on the page as you go" : _editingId is null ? "Pick a starting point or a background; the page follows as you go" : "Saved. Changes show on the page as you go"))</span>
            </span>
            <span class="theme-studio-verdict @(_shortfalls.Count == 0 ? "is-met" : "is-short")" role="status"
                  title="@(_bodyText is { } body ? $"{body.Label}: {Ratio(body.Ratio)}:1" : null)">
                <AppIcon Name="@(_shortfalls.Count == 0 ? "check" : "error")" />
                @(_shortfalls.Count == 0 ? "Readable" : _shortfalls.Count == 1 ? "1 pair low" : $"{_shortfalls.Count} pairs low")
                @if (_bodyText is { } text)
                {
                    <span class="theme-studio-ratio">@Ratio(text.Ratio):1</span>
                }
            </span>
        </div>
        <div class="theme-studio-palette" aria-hidden="true">
            @foreach (var role in PaletteRoles)
            {
                if (_palette.TryGetValue(role, out var value) && AI.Contracts.Themes.SrgbColor.TryParse(value, out var color))
                {
                    <span style="--swatch: @color.ToHex()" title="@role"></span>
                }
            }
        </div>
        <div class="settings-row settings-field theme-studio-starters" role="group" aria-labelledby="settings-custom-theme-starters">
            <span class="settings-row-label" id="settings-custom-theme-starters">Start from</span>
            <span class="theme-starters">
                @foreach (var starter in Starters)
                {
                    var current = string.Equals(starter.Background, _seeds.Background, StringComparison.OrdinalIgnoreCase);
                    <button class="theme-starter @(current ? "selected" : null)" type="button" title="@starter.Name · @starter.Background"
                            aria-pressed="@(current ? "true" : "false")" @onclick="() => StartFromAsync(starter.Background)">
                        <span class="theme-starter-swatch" style="--swatch: @starter.Background"></span>
                        <span>@starter.Name</span>
                    </button>
                }
            </span>
        </div>
        <label @attributes="@(ControlHints.Attributes("settings.appearance.custom_theme.background"))" class="settings-row settings-field">
            <span class="settings-row-label">Background</span>
            <span class="settings-field-control theme-studio-color">
                <input type="color" value="@_seeds.Background" aria-label="Page background" @oninput="SetBackgroundAsync" />
                <input type="text" class="theme-studio-hex" value="@_seeds.Background" maxlength="7" spellcheck="false" autocomplete="off"
                       aria-label="Page background as #rrggbb" aria-invalid="@(_hexInvalid ? "true" : null)" @onchange="SetBackgroundAsync" />
            </span>
        </label>
        <div @attributes="@(ControlHints.Attributes("settings.appearance.custom_theme.family"))" class="settings-row settings-field" role="radiogroup" aria-labelledby="settings-custom-theme-family">
            <span class="settings-row-label" id="settings-custom-theme-family">Mode</span>
            <span class="settings-field-control">
                <span class="theme-options theme-studio-family">
                    @foreach (var (value, label) in Families)
                    {
                        <label class="theme-option @(FamilyValue == value ? "selected" : null)">
                            <input type="radio" name="custom-theme-family" value="@value" checked="@(FamilyValue == value)" @onchange="SetFamilyAsync" /><span>@label</span>
                        </label>
                    }
                </span>
            </span>
        </div>
        <label @attributes="@(ControlHints.Attributes("settings.appearance.custom_theme.contrast"))" class="settings-row settings-field">
            <span class="settings-row-label">Contrast</span>
            <span class="settings-field-control settings-range theme-studio-dial">
                <span class="theme-studio-dial-end">Soft</span>
                <input type="range" min="@AI.Contracts.Themes.CustomThemeSeeds.MinContrast" max="@AI.Contracts.Themes.CustomThemeSeeds.MaxContrast" step="5"
                       value="@_seeds.Contrast" aria-label="Contrast" aria-valuetext="@_seeds.Contrast" @oninput="SetContrastAsync" />
                <span class="theme-studio-dial-end">Crisp</span>
                <output>@_seeds.Contrast</output>
            </span>
        </label>
        <label @attributes="@(ControlHints.Attributes("settings.appearance.custom_theme.saturation"))" class="settings-row settings-field">
            <span class="settings-row-label">Colour</span>
            <span class="settings-field-control settings-range theme-studio-dial">
                <span class="theme-studio-dial-end">Grey</span>
                <input type="range" min="@AI.Contracts.Themes.CustomThemeSeeds.MinSaturation" max="@AI.Contracts.Themes.CustomThemeSeeds.MaxSaturation" step="5"
                       value="@_seeds.Saturation" aria-label="Colour saturation" aria-valuetext="@_seeds.Saturation" @oninput="SetSaturationAsync" />
                <span class="theme-studio-dial-end">Vivid</span>
                <output>@_seeds.Saturation</output>
            </span>
        </label>
        @if (_shortfalls.Count > 0)
        {
            <div class="settings-row settings-custom-theme-shortfall" role="alert">
                <AppIcon Name="error" />
                <span>@ShortfallText</span>
            </div>
        }
        <label @attributes="@(ControlHints.Attributes("settings.appearance.custom_theme.name"))" class="settings-row settings-field">
            <span class="settings-row-label">Name</span>
            <input type="text" maxlength="@AI.Contracts.Themes.CustomTheme.MaxNameLength" value="@_name"
                   placeholder="@AI.Contracts.Themes.CustomTheme.DefaultName" @oninput="SetName" />
        </label>
        <div class="settings-row settings-custom-theme-actions">
            @if (_editingId is not null)
            {
                <button @attributes="@(ControlHints.Attributes("settings.appearance.custom_theme.delete"))" class="compact-action theme-studio-delete @(_confirmingDelete ? "is-confirming" : null)" type="button"
                        disabled="@_saving" @onclick="DeleteAsync" @onfocusout="() => _confirmingDelete = false"><AppIcon Name="trash" />@(_confirmingDelete ? "Delete for good?" : "Delete")</button>
            }
            <span class="theme-studio-actions-end">
                @if (IsDirty)
                {
                    <button class="compact-action" type="button" disabled="@_saving" @onclick="DiscardAsync"><AppIcon Name="undo" />Discard</button>
                }
                @if (_editingId is not null)
                {
                    <button class="compact-action" type="button" disabled="@_saving" @onclick="SaveAsNewAsync"><AppIcon Name="copy" />Save as new</button>
                }
                <button @attributes="@(ControlHints.Attributes("settings.appearance.custom_theme.save"))" class="compact-action primary" type="button"
                        disabled="@(_saving || (_editingId is not null && !IsDirty))" @onclick="SaveAsync"><AppIcon Name="check" />@(_editingId is null ? "Add theme" : "Save")</button>
            </span>
        </div>
    </div>
</section>

@code {
    /// <summary>
    /// The rest of the appearance card (accent, corners, animations), which the settings panel owns. It
    /// sits in the same card as the gallery because the accent is part of what every card shows.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The accent the panel's picker shows. When it changes, the theme in use took it as its own, so the
    /// cards are read again to show it.
    /// </summary>
    [Parameter] public AI.Web.Settings.AccentColor Accent { get; set; }

    /// <summary>
    /// Raised after the theme on the page changed, so the panel's accent picker can show the accent
    /// that came with it.
    /// </summary>
    [Parameter] public EventCallback ThemeChanged { get; set; }

    private static readonly (AI.Web.Settings.ThemePreference Value, string Label, string Swatch)[] Presets =
    [
        (AI.Web.Settings.ThemePreference.System, "System", "light"),
        (AI.Web.Settings.ThemePreference.Light, "Light", "light"),
        (AI.Web.Settings.ThemePreference.Dark, "Dark", "dark"),
        (AI.Web.Settings.ThemePreference.DarkBlue, "Dark blue", "darkblue"),
        (AI.Web.Settings.ThemePreference.Gray, "Gray", "gray"),
        (AI.Web.Settings.ThemePreference.LightGray, "Light grey", "lightgray")
    ];

    /// <summary>
    /// Backgrounds a theme can start from with one click. They are seeds, not palettes: each still goes
    /// through the engine, so a starter is only a shortcut to a colour the picker could reach anyway.
    /// </summary>
    private static readonly (string Name, string Background)[] Starters =
    [
        ("Graphite", AI.Contracts.Themes.CustomTheme.DefaultBackground),
        ("Midnight", "#121a2b"),
        ("Forest", "#142019"),
        ("Plum", "#231a29"),
        ("Espresso", "#2a211c"),
        ("Paper", "#f6f4ef"),
        ("Sand", "#efe6d3"),
        ("Mist", "#e6edf2")
    ];

    private static readonly (string Value, string Label)[] Families = [("dark", "Dark"), ("light", "Light")];

    /// <summary>The strip under the studio's head: surfaces from the deepest up, then text from faint to strong.</summary>
    private static readonly string[] PaletteRoles =
    [
        AI.Contracts.Themes.ThemeToken.BgSunken, AI.Contracts.Themes.ThemeToken.Bg, AI.Contracts.Themes.ThemeToken.Surface,
        AI.Contracts.Themes.ThemeToken.SurfaceRaised, AI.Contracts.Themes.ThemeToken.Fill, AI.Contracts.Themes.ThemeToken.FillStrong,
        AI.Contracts.Themes.ThemeToken.BorderStrong, AI.Contracts.Themes.ThemeToken.TextFaint, AI.Contracts.Themes.ThemeToken.TextMuted,
        AI.Contracts.Themes.ThemeToken.Text, AI.Contracts.Themes.ThemeToken.TextStrong
    ];

    private AI.Web.Settings.ThemePreference _preference;
    private AI.Web.Settings.AccentColor _presetAccent;
    private AI.Web.Settings.AccentColor? _shownAccent;
    private IReadOnlyList<AI.Contracts.Themes.CustomTheme> _themes = [];
    private AI.Contracts.Themes.CustomThemeSeeds _seeds = new(AI.Contracts.Themes.CustomTheme.DefaultBackground);
    private AI.Contracts.Themes.CustomThemeSeeds _baseline = new(AI.Contracts.Themes.CustomTheme.DefaultBackground);
    private IReadOnlyDictionary<string, string> _palette = new Dictionary<string, string>();
    private IReadOnlyList<AI.Contracts.Themes.ThemeContrastFinding> _shortfalls = [];
    private AI.Contracts.Themes.ThemeContrastFinding? _bodyText;
    private string _name = string.Empty;
    private string _baselineName = string.Empty;
    private string? _activeId;
    private AI.Contracts.Themes.CustomTheme? _active;
    private string? _editingId;
    private string? _status;
    private bool _saving;
    private bool _hexInvalid;
    private bool _confirmingDelete;

    private string FamilyValue => _seeds.Family == AI.Contracts.Themes.ThemeFamily.Light ? "light" : "dark";

    private string CleanName => AI.Contracts.Themes.CustomTheme.CleanName(_name);

    /// <summary>Whether the studio shows something other than the saved theme it opened, or the blank start.</summary>
    private bool IsDirty => _seeds != _baseline || CleanName != _baselineName;

    /// <summary>
    /// Closing the drawer drops a palette the person was only trying out, so the page goes back to what
    /// is actually saved. It repaints the saved theme rather than activating it: closing a form is not a
    /// change of choice and must not write the settings again.
    /// </summary>
    public void Dispose() => _ = Theme.PreviewCustomThemeAsync(_active).AsTask();

    protected override async Task OnInitializedAsync()
    {
        _preference = await Theme.GetAsync();
        _presetAccent = await Theme.GetPresetAccentAsync();
        _shownAccent = Accent;
        _themes = await Theme.GetCustomThemesAsync();
        var active = await Theme.GetActiveCustomThemeAsync();
        _active = active;
        _activeId = active?.Id;
        // The studio opens on the theme in use, so its dials show the colours already on the page.
        if (active is not null) Edit(active);
        else Blank();
    }

    private void Edit(AI.Contracts.Themes.CustomTheme theme)
    {
        _editingId = theme.Id;
        _name = theme.Name;
        _seeds = theme.Seeds;
        _confirmingDelete = false;
        Recompute();
        _baseline = _seeds;
        _baselineName = CleanName;
    }

    private void Blank()
    {
        _editingId = null;
        _name = string.Empty;
        _seeds = new AI.Contracts.Themes.CustomThemeSeeds(AI.Contracts.Themes.CustomTheme.DefaultBackground);
        _confirmingDelete = false;
        Recompute();
        _baseline = _seeds;
        _baselineName = CleanName;
    }

    private void Recompute()
    {
        var palette = AI.Contracts.Themes.ThemePalette.Generate(_seeds);
        // The engine resolves what the person left open (a family for a mid grey) and clamps the dials,
        // so the form shows the seeds the palette was actually built from.
        _seeds = palette.Seeds;
        _palette = palette.Tokens;
        _shortfalls = palette.Shortfalls;
        _bodyText = palette.Findings.FirstOrDefault(finding =>
            finding.ForegroundRole == AI.Contracts.Themes.ThemeToken.Text && finding.BackgroundRole == AI.Contracts.Themes.ThemeToken.Bg);
        _status = null;
        _hexInvalid = false;
    }

    private string ShortfallText => _shortfalls.Count == 1
        ? $"{_shortfalls[0].Label} reaches {Ratio(_shortfalls[0].Ratio)}:1, below the {Ratio(_shortfalls[0].Target)}:1 the interface promises."
        : $"{_shortfalls.Count} pairs are below their ratio, starting with {_shortfalls[0].Label} at {Ratio(_shortfalls[0].Ratio)}:1.";

    private static string Ratio(double value) => AI.Contracts.Themes.ThemePalette.FormatRatio(value);

    protected override async Task OnParametersSetAsync()
    {
        // The picker changed the accent of what paints the page: a saved theme in use keeps it as its own,
        // a preset makes it the presets' one. Either way a card now shows another accent.
        if (_shownAccent is null || _shownAccent == Accent) return;
        _shownAccent = Accent;
        _presetAccent = await Theme.GetPresetAccentAsync();
        _themes = await Theme.GetCustomThemesAsync();
        _active = await Theme.GetActiveCustomThemeAsync();
    }

    /// <summary>
    /// A saved theme's card is painted from its stored palette and shows its own accent. The values go
    /// through the colour parser first, because a stored theme may have been edited by hand and only a
    /// colour may reach the style.
    /// </summary>
    private string SwatchStyle(AI.Contracts.Themes.CustomTheme theme)
    {
        string Value(string role) =>
            theme.Tokens.TryGetValue(AI.Contracts.Themes.CustomTheme.CssPrefix + role, out var value)
            && AI.Contracts.Themes.SrgbColor.TryParse(value, out var color)
                ? color.ToHex()
                : "transparent";
        var accent = Enum.TryParse<AI.Web.Settings.AccentColor>(theme.Accent, true, out var own) && Enum.IsDefined(own) ? own : _presetAccent;
        return $"--swatch-bg: {Value(AI.Contracts.Themes.ThemeToken.Bg)}; --swatch-surface: {Value(AI.Contracts.Themes.ThemeToken.SurfaceRaised)}; "
            + $"--swatch-text: {Value(AI.Contracts.Themes.ThemeToken.Text)}; --swatch-border: {Value(AI.Contracts.Themes.ThemeToken.Border)}; "
            + AccentStyle(accent);
    }

    /// <summary>The chip of a card: the presets share one accent, a saved theme shows its own.</summary>
    private static string AccentStyle(AI.Web.Settings.AccentColor accent) =>
        $"--swatch-accent: var(--accent-swatch-{accent.ToString().ToLowerInvariant()})";

    private void SetName(ChangeEventArgs args)
    {
        _name = args.Value?.ToString() ?? string.Empty;
        _status = null;
    }

    private async Task SetBackgroundAsync(ChangeEventArgs args)
    {
        var text = args.Value?.ToString()?.Trim() ?? string.Empty;
        if (text.Length > 0 && text[0] != '#') text = "#" + text;
        if (!AI.Contracts.Themes.SrgbColor.TryParse(text, out var background))
        {
            _hexInvalid = true;
            return;
        }
        // Another background may suit the other family better, so the resolved choice is offered again.
        _seeds = _seeds with { Background = background.ToHex(), Family = null };
        await PreviewAsync();
    }

    private async Task StartFromAsync(string background)
    {
        _seeds = _seeds with { Background = background, Family = null };
        await PreviewAsync();
    }

    private async Task SetFamilyAsync(ChangeEventArgs args)
    {
        _seeds = _seeds with
        {
            Family = args.Value?.ToString() == "light" ? AI.Contracts.Themes.ThemeFamily.Light : AI.Contracts.Themes.ThemeFamily.Dark
        };
        await PreviewAsync();
    }

    private async Task SetContrastAsync(ChangeEventArgs args) => await SetDialAsync(args, (seeds, value) => seeds with { Contrast = value });

    private async Task SetSaturationAsync(ChangeEventArgs args) => await SetDialAsync(args, (seeds, value) => seeds with { Saturation = value });

    private async Task SetDialAsync(ChangeEventArgs args,
        Func<AI.Contracts.Themes.CustomThemeSeeds, int, AI.Contracts.Themes.CustomThemeSeeds> apply)
    {
        if (!int.TryParse(args.Value?.ToString(), out var value)) return;
        _seeds = apply(_seeds, value);
        await PreviewAsync();
    }

    /// <summary>
    /// Regenerates the palette and shows it on the page straight away, without saving it: the person is
    /// choosing colours, and a page that only moved on Save would hide the consequence of each choice.
    /// </summary>
    private async Task PreviewAsync()
    {
        Recompute();
        _confirmingDelete = false;
        await Theme.PreviewCustomThemeAsync(AI.Contracts.Themes.CustomTheme.Create(
            _editingId ?? AI.Contracts.Themes.CustomTheme.PreviewId, _name, _seeds));
    }

    private async Task SetPresetAsync(AI.Web.Settings.ThemePreference preference)
    {
        _saving = true;
        try
        {
            await Theme.SetAsync(preference);
            _preference = preference;
            _active = null;
            _activeId = null;
            // The studio leaves the theme that was in use, unless the person is in the middle of
            // changing it: a preset click must not throw away unsaved dials.
            if (!IsDirty) Blank();
            await ThemeChanged.InvokeAsync();
        }
        finally { _saving = false; }
    }

    /// <summary>
    /// Runs on click rather than on change: a saved card that is already selected still has to bring
    /// its theme back into the studio after the person started a new one.
    /// </summary>
    private async Task ActivateAsync(string id)
    {
        _saving = true;
        try
        {
            await Theme.SetActiveCustomThemeAsync(id);
            _activeId = id;
            var activated = (await Theme.GetCustomThemesAsync()).First(theme => theme.Id == id);
            _active = activated;
            Edit(activated);
            await ThemeChanged.InvokeAsync();
        }
        catch (InvalidOperationException)
        {
            // Another window removed it meanwhile: show what is actually saved.
            _themes = await Theme.GetCustomThemesAsync();
            _active = await Theme.GetActiveCustomThemeAsync();
            _activeId = _active?.Id;
        }
        finally { _saving = false; }
    }

    private Task SaveAsync() => SaveCoreAsync(_editingId);

    /// <summary>Keeps the theme being edited as it was saved and stores what the studio shows beside it.</summary>
    private Task SaveAsNewAsync() => SaveCoreAsync(null);

    private async Task SaveCoreAsync(string? id)
    {
        _saving = true;
        try
        {
            var saved = await Theme.SaveCustomThemeAsync(id, _name, _seeds);
            _themes = await Theme.GetCustomThemesAsync();
            _active = saved;
            _activeId = saved.Id;
            Edit(saved);
            _status = "Saved and in use";
            await ThemeChanged.InvokeAsync();
        }
        catch (InvalidOperationException error)
        {
            Notifications.ShowError($"Could not save the theme: {error.Message}");
        }
        finally { _saving = false; }
    }

    /// <summary>
    /// Starts a blank theme without repainting the page: the page keeps what is saved until the person
    /// picks a colour, so asking for a new theme never looks like the current one was lost.
    /// </summary>
    private async Task StartNewAsync()
    {
        Blank();
        await Theme.PreviewCustomThemeAsync(_active);
    }

    /// <summary>Puts the studio and the page back to what is saved.</summary>
    private async Task DiscardAsync()
    {
        var saved = _editingId is null ? null : _themes.FirstOrDefault(theme => theme.Id == _editingId);
        if (saved is not null) Edit(saved);
        else Blank();
        await Theme.PreviewCustomThemeAsync(_active);
    }

    /// <summary>A theme cannot be brought back, so the first press only asks, and the second removes it.</summary>
    private async Task DeleteAsync()
    {
        if (_editingId is not { } id) return;
        if (!_confirmingDelete)
        {
            _confirmingDelete = true;
            return;
        }
        _saving = true;
        try
        {
            await Theme.DeleteCustomThemeAsync(id);
            _themes = await Theme.GetCustomThemesAsync();
            _active = await Theme.GetActiveCustomThemeAsync();
            _activeId = _active?.Id;
            await StartNewAsync();
            _status = "Removed. The page is back to the selected theme";
            await ThemeChanged.InvokeAsync();
        }
        catch (InvalidOperationException error)
        {
            Notifications.ShowError($"Could not remove the theme: {error.Message}");
        }
        finally
        {
            _saving = false;
            _confirmingDelete = false;
        }
    }
}
