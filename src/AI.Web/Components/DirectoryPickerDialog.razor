@using AI.Web.FileSystem
@inject IDirectoryPickerState Picker
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

@* Picking, not typing: the host walks its own file system for us because the browser cannot name
   an absolute path. The path box stays anyway — pasting a path is faster than clicking down to it,
   and it is the only way in when the list is long or the thing is not there yet. *@
<div class="modal-backdrop @BackdropClass" @onclick="CancelAsync">
    <section class="directory-picker-modal" role="dialog" aria-modal="true" aria-labelledby="directory-picker-title"
             @ref="_dialog" @onclick:stopPropagation="true">
        <header>
            <div><strong id="directory-picker-title">@Title</strong><span>@Subtitle</span></div>
            <button class="icon-action" type="button" title="Close" aria-label="Close picker" @onclick="CancelAsync"><AppIcon Name="x" /></button>
        </header>
        <div class="directory-picker-toolbar">
            <button class="icon-action" type="button" title="Up one level" aria-label="Up one level" disabled="@(!Picker.CanGoUp || Picker.IsLoading)" @onclick="GoUpAsync"><AppIcon Name="arrow-up" /></button>
            <input class="directory-picker-path" @ref="_pathInput" value="@Picker.PathText" aria-label="@PathLabel" placeholder="Type or paste a path"
                   @oninput="OnPathInput" />
            <button class="secondary-action compact-action" type="button" disabled="@Picker.IsLoading" @onclick="GoToTypedPathAsync">Go</button>
        </div>
        <div class="directory-picker-body">
            @if (Picker.IsUnavailable)
            {
                <div class="directory-picker-empty">
                    <AppIcon Name="folder" />
                    <strong>Browsing is switched off on the host</strong>
                    <p>Type the full path above, or enable <code>FileSystem:BrowseEnabled</code> on the host.</p>
                </div>
            }
            else
            {
                <input class="directory-picker-filter" type="search" value="@Picker.Filter" aria-label="@FilterLabel" placeholder="Filter"
                       @oninput="OnFilterInput" />
                @if (Picker.IsLoading && Picker.Listing is null)
                {
                    <p class="empty-hint">Loading…</p>
                }
                else if (Picker.VisibleDirectories.Count == 0 && Picker.VisibleFiles.Count == 0)
                {
                    <p class="empty-hint">@EmptyText</p>
                }
                else
                {
                    var highlighted = HighlightedPath();
                    <ul class="directory-picker-list" role="listbox" aria-label="@FilterLabel">
                        @foreach (var entry in Picker.VisibleDirectories)
                        {
                            <li>
                                <button type="button" class="directory-picker-item @(entry.FullPath == highlighted ? "highlighted" : null)" title="@entry.FullPath"
                                        @onclick="() => NavigateAsync(entry.FullPath)">
                                    <AppIcon Name="folder" /><span>@entry.Name</span>
                                </button>
                            </li>
                        }
                        @* Files come after the folders and do not open: clicking one is the answer,
                           which is the whole difference between the two modes. *@
                        @foreach (var entry in Picker.VisibleFiles)
                        {
                            <li>
                                <button type="button" class="directory-picker-item directory-picker-file @(Picker.SelectedFile == entry.FullPath ? "selected" : null) @(entry.FullPath == highlighted ? "highlighted" : null)"
                                        title="@entry.FullPath" aria-pressed="@(Picker.SelectedFile == entry.FullPath)" @onclick="() => SelectFile(entry.FullPath)">
                                    <AppIcon Name="file" /><span>@entry.Name</span>
                                </button>
                            </li>
                        }
                    </ul>
                }
            }
            @if (Picker.WarningMessage is { } warning) { <p class="directory-picker-warning">@warning</p> }
            @if (Picker.ErrorMessage is { } error) { <p class="error" role="alert">@error</p> }
        </div>
        <footer class="settings-modal-actions directory-picker-actions">
            <span class="directory-picker-selection" title="@Picker.Selection">@(Picker.Selection ?? NothingSelectedText)</span>
            <button type="button" disabled="@(Picker.Selection is null)" @onclick="SelectAsync">Select</button>
            <button type="button" class="secondary-action" @onclick="CancelAsync">Cancel</button>
        </footer>
    </section>
</div>

@code {
    /// <summary>Whether a directory or a file is being asked for.</summary>
    [Parameter] public DirectoryPickerMode Mode { get; set; } = DirectoryPickerMode.Directory;

    /// <summary>Where the picker opens. The last path browsed, or the one being changed.</summary>
    [Parameter] public string? StartPath { get; set; }

    /// <summary>What the picked path is for, shown under the title.</summary>
    [Parameter] public string Subtitle { get; set; } = string.Empty;

    /// <summary>Extra CSS class on the backdrop. Settings drawers sit at z-index 45, so anything
    /// opened from them needs a class that lifts the backdrop above that (46+); the picker is used
    /// in other places too, so this is opt-in rather than hard-coded.</summary>
    [Parameter] public string? BackdropClass { get; set; }

    [Parameter] public EventCallback<string> Selected { get; set; }

    [Parameter] public EventCallback Cancelled { get; set; }

    private readonly CancellationTokenSource _cancellation = new();
    private ElementReference _pathInput;
    private ElementReference _dialog;
    private bool _focusPending = true;
    private IJSObjectReference? _keys;
    private DotNetObjectReference<DirectoryPickerDialog>? _self;
    // The row the arrows moved to, by path so it survives a re-render; null is none. A row that is
    // no longer listed — the filter changed, a folder opened — is not highlighted any more.
    private string? _highlight;
    private bool _scrollHighlight;
    private bool _focusFilter;

    private bool IsFileMode => Mode == DirectoryPickerMode.File;
    private string Title => IsFileMode ? "Select file" : "Select directory";
    private string PathLabel => IsFileMode ? "File path" : "Directory path";
    private string FilterLabel => IsFileMode ? "Filter files and directories" : "Filter directories";
    private string NothingSelectedText => IsFileMode ? "No file selected" : "No directory selected";

    private string EmptyText => Picker.Filter.Length > 0
        ? "Nothing matches the filter."
        : IsFileMode ? "This folder is empty." : "No subdirectories here.";

    protected override Task OnInitializedAsync() => Picker.OpenAsync(StartPath, Mode, _cancellation.Token);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _self = DotNetObjectReference.Create(this);
                var module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/directoryPicker.js");
                _keys = await module.InvokeAsync<IJSObjectReference>("attach", _dialog, _self);
            }
            if (_focusPending)
            {
                _focusPending = false;
                // The path box takes focus so a pasted path works without reaching for the mouse.
                await _pathInput.FocusAsync();
            }
            if (_keys is null) return;
            if (_focusFilter) { _focusFilter = false; await _keys.InvokeVoidAsync("focusFilter"); }
            if (_scrollHighlight) { _scrollHighlight = false; await _keys.InvokeVoidAsync("scrollHighlightIntoView"); }
        }
        catch (Exception error) when (error is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // The dialog closed before the browser got to it.
        }
    }

    /// <summary>
    /// Every key the picker answers, wherever the focus is while it is open (see directoryPicker.js).
    /// Up and Down move the highlight through folders then files; Enter opens the highlighted folder
    /// or takes the highlighted file, and without a highlight goes to the typed path or selects;
    /// Alt+Up goes up a level; Escape closes.
    /// </summary>
    [JSInvokable]
    public async Task OnPickerKey(string key, string source, string? rowPath)
    {
        switch (key)
        {
            case "Escape":
                await CancelAsync();
                return;
            case "Up":
                if (Picker.CanGoUp && !Picker.IsLoading) await GoUpAsync();
                return;
            case "ArrowUp" or "ArrowDown":
                MoveHighlight(key == "ArrowDown" ? 1 : -1);
                StateHasChanged();
                return;
            case "Enter":
                await EnterAsync(source, rowPath);
                return;
        }
    }

    private IReadOnlyList<string> Rows() =>
        Picker.VisibleDirectories.Concat(Picker.VisibleFiles).Select(entry => entry.FullPath).ToArray();

    /// <summary>The row that answers Enter: the one the arrows chose, or while filtering, the first match.</summary>
    private string? HighlightedPath()
    {
        var rows = Rows();
        if (_highlight is { } chosen && rows.Contains(chosen)) return chosen;
        return Picker.Filter.Length > 0 ? rows.FirstOrDefault() : null;
    }

    private void MoveHighlight(int direction)
    {
        var rows = Rows();
        if (rows.Count == 0) return;
        var index = HighlightedPath() is { } current ? rows.ToList().IndexOf(current) : -1;
        index = index < 0 ? (direction > 0 ? 0 : rows.Count - 1) : (index + direction + rows.Count) % rows.Count;
        _highlight = rows[index];
        _scrollHighlight = true;
    }

    private async Task EnterAsync(string source, string? rowPath)
    {
        // A row chosen with the arrows wins over the path box; typing a path clears that choice.
        var chosen = _highlight is { } path && Rows().Contains(path) ? path : null;
        var row = source == "row" ? rowPath : chosen ?? (source == "path" ? null : HighlightedPath());
        if (row is not null)
        {
            if (Picker.VisibleDirectories.Any(entry => entry.FullPath == row)) { await NavigateAsync(row); return; }
            if (Picker.VisibleFiles.Any(entry => entry.FullPath == row))
            {
                SelectFile(row);
                await SelectAsync();
                return;
            }
        }
        // In the path box Enter first honours what was typed there — a pasted path is a
        // destination, not a choice — and the Enter after that, with the box now naming what is
        // picked, selects it.
        if (source == "path" && !Picker.PathTextNamesSelection) await GoToTypedPathAsync();
        else await SelectAsync();
    }

    private void OnPathInput(ChangeEventArgs args)
    {
        Picker.SetPathText(args.Value?.ToString() ?? string.Empty);
        _highlight = null;
    }

    private void OnFilterInput(ChangeEventArgs args)
    {
        Picker.SetFilter(args.Value?.ToString() ?? string.Empty);
        _scrollHighlight = true;
    }

    private async Task NavigateAsync(string path)
    {
        await Picker.NavigateAsync(path, _cancellation.Token);
        OnLevelChanged();
    }

    /// <summary>A new level: nothing is highlighted yet, and the filter has the focus the gone row had.</summary>
    private void OnLevelChanged()
    {
        _highlight = null;
        _focusFilter = true;
        StateHasChanged();
    }

    private void SelectFile(string path) => Picker.SelectFile(path);

    private async Task GoUpAsync()
    {
        await Picker.GoUpAsync(_cancellation.Token);
        OnLevelChanged();
    }

    private async Task GoToTypedPathAsync()
    {
        await Picker.GoToTypedPathAsync(_cancellation.Token);
        _highlight = null;
        StateHasChanged();
    }

    private Task SelectAsync() => Picker.Selection is { } selection ? Selected.InvokeAsync(selection) : Task.CompletedTask;

    private Task CancelAsync() => Cancelled.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        _cancellation.Cancel();
        _cancellation.Dispose();
        if (_keys is not null)
        {
            try
            {
                await _keys.InvokeVoidAsync("dispose");
                await _keys.DisposeAsync();
            }
            catch (Exception error) when (error is JSException or JSDisconnectedException)
            {
                // The page is going away with the dialog; its listener goes with it.
            }
        }
        _self?.Dispose();
    }
}
