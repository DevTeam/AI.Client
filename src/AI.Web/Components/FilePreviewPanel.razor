@using AI.Web.Resources
@using AI.Web.Components.FilePreviews
@using AI.Contracts.Resources
@implements IAsyncDisposable
@inject IFilePreviewApi Api
@inject IFilePreviewViewers Viewers
@inject IApiBaseUrl ApiBaseUrl
@inject IJSRuntime Js

<section class="review-workspace file-preview-panel" id="@_id" aria-label="File preview" aria-busy="@_loading">
    <div class="file-preview-resizer" role="separator" tabindex="0" aria-label="Resize file preview" aria-orientation="vertical" aria-valuemin="320" aria-valuemax="1600" aria-valuenow="720"></div>
    <header class="review-workspace-header">
        <AppIcon Name="file" />
        <div class="review-workspace-identity">
            <strong>@(_file?.Name ?? Path)</strong>
            <span title="@(_file?.Path ?? Path)">@(_file?.Path ?? Path)</span>
        </div>
        <button class="icon-action" type="button" title="Copy path" aria-label="Copy path" @onclick="CopyPathAsync"><AppIcon Name="copy" /></button>
        @if (_file is not null)
        {
            <button class="icon-action" type="button" title="Add to message" aria-label="Add to message" @onclick="() => OnAttach.InvokeAsync(_file)"><AppIcon Name="plus" /></button>
            @if (_file.ContentUrl is not null)
            {
                <button class="icon-action" type="button" title="Download" aria-label="Download" @onclick="DownloadAsync"><AppIcon Name="download" /></button>
            }
        }
        <button class="icon-action" type="button" title="Full screen" aria-label="Full screen" @onclick="FullScreenAsync"><AppIcon Name="maximize" /></button>
        <button class="icon-action review-close" type="button" title="Close preview" aria-label="Close preview" @onclick="OnClose"><AppIcon Name="drawer-close" /></button>
    </header>
    @if (_error is not null) { <p class="review-error" role="alert">@_error</p> }
    @if (_loading) { <p class="file-preview-status" role="status">Loading file…</p> }
    else if (_file is not null)
    {
        <div class="file-preview-toolbar">
            <span>@(_file.Kind is "directory" or "archive" ? $"{_file.Entries.Count} entries" : $"{_file.Size:N0} bytes · {_file.ContentType}")</span>
        </div>
        <DynamicComponent Type="@Viewers.Resolve(_file.Kind)" Parameters="@ViewerParameters" />
    }
</section>

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public string Path { get; set; } = "";
    [Parameter] public int? StartLine { get; set; }
    [Parameter] public int? EndLine { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnOpenPath { get; set; }
    [Parameter] public EventCallback<FilePreview> OnAttach { get; set; }
    private readonly string _id = $"file-preview-{Guid.NewGuid():N}";
    private readonly CancellationTokenSource _cancel = new();
    private FilePreview? _file;
    private IJSObjectReference? _module, _handle;
    private string? _error;
    private bool _loading = true;
    private string? ContentUrl => _file?.ContentUrl is { } url ? new Uri(ApiBaseUrl.Value, url).AbsoluteUri : null;
    private IDictionary<string, object> ViewerParameters => new Dictionary<string, object>
    {
        [nameof(FilePreviewViewer.Context)] = new FilePreviewViewContext(ProjectId, _file!, ContentUrl,
            _id, StartLine, EndLine, OnOpenPath)
    };
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _file = await Api.DescribeAsync(ProjectId, Path, _cancel.Token);
        }
        catch (OperationCanceledException) when (_cancel.IsCancellationRequested) { }
        catch (Exception error) { _error = error.Message; }
        finally { _loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_cancel.IsCancellationRequested) return;
        if (firstRender)
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/filePreview.js");
            _handle = await _module.InvokeAsync<IJSObjectReference>("attach", _id);
        }
    }

    private async Task CopyPathAsync() { if (_module is not null) await _module.InvokeVoidAsync("copy", _file?.Path ?? Path); }

    private async Task FullScreenAsync() { if (_module is not null) await _module.InvokeVoidAsync("fullscreen", _id); }
    private async Task DownloadAsync()
    {
        if (_module is null || ContentUrl is null) return;
        try { await _module.InvokeVoidAsync("download", ContentUrl + "?download=true", _file?.Name); }
        catch (JSException) { _error = "Could not download this file. Try reopening it to refresh access."; }
    }

    public async ValueTask DisposeAsync()
    {
        await _cancel.CancelAsync();
        _cancel.Dispose();
        if (_handle is not null) { await _handle.InvokeVoidAsync("dispose"); await _handle.DisposeAsync(); }
        if (_module is not null) await _module.DisposeAsync();
    }
}
