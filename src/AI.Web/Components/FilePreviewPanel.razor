@using System.Net.Http.Json
@using AI.Contracts.Resources
@implements IAsyncDisposable
@inject HttpClient Http
@inject IApiBaseUrl ApiBaseUrl
@inject IJSRuntime Js

<section class="review-workspace file-preview-panel" id="@_id" aria-label="File preview" aria-busy="@_loading">
    <div class="file-preview-resizer" role="separator" tabindex="0" aria-label="Resize file preview" aria-orientation="vertical" aria-valuemin="320" aria-valuemax="1600" aria-valuenow="720"></div>
    <header class="review-workspace-header">
        <AppIcon Name="file" />
        <div class="review-workspace-identity">
            <strong>@(_file?.Name ?? Path)</strong>
            <span title="@(_file?.Path ?? Path)">@(_file?.Path ?? Path)</span>
        </div>
        <button class="icon-action" type="button" title="Copy path" aria-label="Copy path" @onclick="CopyPathAsync"><AppIcon Name="copy" /></button>
        @if (_file is not null)
        {
            <button class="icon-action" type="button" title="Add to message" aria-label="Add to message" @onclick="() => OnAttach.InvokeAsync(_file)"><AppIcon Name="plus" /></button>
            @if (_file.ContentUrl is not null)
            {
                <button class="icon-action" type="button" title="Download" aria-label="Download" @onclick="DownloadAsync"><AppIcon Name="download" /></button>
            }
        }
        <button class="icon-action" type="button" title="Full screen" aria-label="Full screen" @onclick="FullScreenAsync"><AppIcon Name="maximize" /></button>
        <button class="icon-action review-close" type="button" title="Close preview" aria-label="Close preview" @onclick="OnClose"><AppIcon Name="drawer-close" /></button>
    </header>
    @if (_error is not null) { <p class="review-error" role="alert">@_error</p> }
    @if (_loading) { <p class="file-preview-status" role="status">Loading file…</p> }
    else if (_file is not null)
    {
        <div class="file-preview-toolbar">
            <span>@(_file.Kind == "directory" ? $"{_file.Entries.Count} entries" : $"{_file.Size:N0} bytes · {_file.ContentType}")</span>
            @if (_file.Kind == "image")
            {
                <button type="button" @onclick="() => Zoom(-.25)">−</button>
                <button type="button" @onclick="() => Zoom(.25)">+</button>
                <button type="button" @onclick="() => _zoom = 0">Fit</button>
                <button type="button" @onclick="() => _zoom = 1">100%</button>
            }
            @if (_file.Kind == "text")
            {
                <button type="button" @onclick="CopyTextAsync">Copy loaded text</button>
            }
        </div>
        <div class="file-preview-body">
            @switch (_file.Kind)
            {
                case "image":
                    <div class="file-preview-image"><img src="@ContentUrl" alt="@_file.Name" style="@(_zoom == 0 || _imageWidth == 0 ? null : $"width:{_imageWidth * _zoom}px;max-width:none;max-height:none")" @onload="ImageLoadedAsync" @onerror="MediaFailed" /></div>
                    break;
                case "video":
                    <video class="file-preview-media" src="@ContentUrl" controls preload="metadata" @onerror="MediaFailed"></video>
                    break;
                case "audio":
                    <audio class="file-preview-media" src="@ContentUrl" controls preload="metadata" @onerror="MediaFailed"></audio>
                    break;
                case "pdf":
                    <iframe class="file-preview-pdf" src="@ContentUrl" title="@_file.Name"></iframe>
                    <p class="file-preview-status">If the PDF cannot be displayed, use Download.</p>
                    break;
                case "text":
                    <div class="file-preview-code">
                        <pre class="file-preview-line-numbers" aria-hidden="true">@string.Join('\n', Enumerable.Range(1, _text.Count(character => character == '\n') + 1))</pre>
                        <pre><code class="hljs">@if (_highlighted is null) { @_text } else { @((MarkupString)_highlighted) }</code></pre>
                    </div>
                    @if (_nextOffset is not null && _text.Length < 1_048_576)
                    {
                        <button class="file-preview-load" type="button" disabled="@_loadingText" @onclick="LoadMoreAsync">@(_loadingText ? "Loading…" : "Load more text")</button>
                    }
                    else if (_nextOffset is not null)
                    {
                        <p class="file-preview-status">Showing the first 1 MB of text. Download the file to read the rest.</p>
                    }
                    break;
                case "directory":
                    <div class="file-preview-directory">
                        @foreach (var entry in _file.Entries)
                        {
                            <button type="button" @onclick="() => OnOpenPath.InvokeAsync(entry.Path)"><AppIcon Name="@(entry.IsDirectory ? "folder" : "file")" /><span>@entry.Name</span></button>
                        }
                        @if (_file.HasMoreEntries) { <p>Showing the first 1,000 entries.</p> }
                        else if (_file.Entries.Count == 0) { <p>No readable files in this directory.</p> }
                    </div>
                    break;
                default:
                    <p class="file-preview-status">This format cannot be previewed. Use Download to open it in another application.</p>
                    break;
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public string Path { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnOpenPath { get; set; }
    [Parameter] public EventCallback<FilePreview> OnAttach { get; set; }
    private readonly string _id = $"file-preview-{Guid.NewGuid():N}";
    private readonly CancellationTokenSource _cancel = new();
    private FilePreview? _file;
    private IJSObjectReference? _module, _handle;
    private string? _error, _highlighted;
    private string _text = "";
    private bool _loading = true, _loadingText, _highlightPending;
    private int? _nextOffset;
    private double _zoom;
    private int _imageWidth;
    private string? ContentUrl => _file?.ContentUrl is { } url ? new Uri(ApiBaseUrl.Value, url).AbsoluteUri : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _file = await GetAsync<FilePreview>("preview");
            if (_file.Kind == "text") await ReadTextAsync(0);
        }
        catch (OperationCanceledException) when (_cancel.IsCancellationRequested) { }
        catch (Exception error) { _error = error.Message; }
        finally { _loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_cancel.IsCancellationRequested) return;
        if (firstRender)
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/filePreview.js");
            _handle = await _module.InvokeAsync<IJSObjectReference>("attach", _id);
        }
        if (_file?.Kind == "image" && _imageWidth == 0 && _module is not null) await ImageLoadedAsync();
        if (_highlightPending && _module is not null)
        {
            _highlightPending = false;
            try { _highlighted = await _module.InvokeAsync<string?>("highlight", _text, _file?.Name); }
            catch (JSException) { }
            if (!_cancel.IsCancellationRequested) StateHasChanged();
        }
    }

    private async Task<T> GetAsync<T>(string action, int offset = 0)
    {
        using var response = await Http.GetAsync($"api/projects/{ProjectId}/resources/{action}?path={Uri.EscapeDataString(Path)}&offset={offset}", _cancel.Token);
        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException(response.StatusCode switch
            {
                System.Net.HttpStatusCode.Forbidden => "The project does not have read access to this file.",
                System.Net.HttpStatusCode.NotFound => "The file or directory is no longer available.",
                _ => $"Could not load the file ({(int)response.StatusCode})."
            });
        return await response.Content.ReadFromJsonAsync<T>(_cancel.Token)
            ?? throw new InvalidOperationException("The Host returned no file information.");
    }

    private async Task ReadTextAsync(int offset)
    {
        var chunk = await GetAsync<FilePreviewText>("preview-text", offset);
        _text += chunk.Text;
        _nextOffset = chunk.NextOffset;
        _highlighted = null;
        _highlightPending = true;
    }

    private async Task LoadMoreAsync()
    {
        if (_nextOffset is not { } offset || _loadingText) return;
        _loadingText = true;
        try { await ReadTextAsync(offset); }
        catch (OperationCanceledException) when (_cancel.IsCancellationRequested) { }
        catch (Exception error) { _error = error.Message; }
        finally { _loadingText = false; }
    }

    private void Zoom(double amount) => _zoom = Math.Clamp((_zoom == 0 ? 1 : _zoom) + amount, .25, 4);
    private async Task ImageLoadedAsync()
    {
        if (_module is null) return;
        var width = await _module.InvokeAsync<int>("imageWidth", _id);
        if (width > 0 && width != _imageWidth) { _imageWidth = width; StateHasChanged(); }
    }
    private void MediaFailed() => _error = "This media format or codec could not be displayed, or file access has changed. Try reopening it or use Download.";
    private async Task CopyPathAsync() { if (_module is not null) await _module.InvokeVoidAsync("copy", _file?.Path ?? Path); }
    private async Task CopyTextAsync() { if (_module is not null) await _module.InvokeVoidAsync("copy", _text); }
    private async Task FullScreenAsync() { if (_module is not null) await _module.InvokeVoidAsync("fullscreen", _id); }
    private async Task DownloadAsync()
    {
        if (_module is null || ContentUrl is null) return;
        try { await _module.InvokeVoidAsync("download", ContentUrl + "?download=true", _file?.Name); }
        catch (JSException) { _error = "Could not download this file. Try reopening it to refresh access."; }
    }

    public async ValueTask DisposeAsync()
    {
        await _cancel.CancelAsync();
        _cancel.Dispose();
        if (_handle is not null) { await _handle.InvokeVoidAsync("dispose"); await _handle.DisposeAsync(); }
        if (_module is not null) await _module.DisposeAsync();
    }
}
