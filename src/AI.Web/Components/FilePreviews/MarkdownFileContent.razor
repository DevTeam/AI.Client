@implements IAsyncDisposable
@inject AI.Web.Resources.IFileMarkdownRenderer Renderer
@inject IJSRuntime Js

@* The fence scripts replace or extend nodes of the rendered markup, so new text gets a new element
   instead of a diff against nodes Blazor no longer owns. *@
<div class="file-preview-markdown" @ref="_element">
    <div class="markdown-content" @key="_html">@((MarkupString)_html)</div>
</div>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    private ElementReference _element;
    private IJSObjectReference? _module, _handle;
    private bool _disposed;
    private string? _rendered;
    private string _html = "";

    protected override void OnParametersSet()
    {
        if (_rendered == Text) return;
        _rendered = Text;
        _html = Renderer.Render(Text);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/filePreview.js");
            if (_disposed) return;
            _handle = await _module.InvokeAsync<IJSObjectReference>("attachMarkdown", _element);
            if (_disposed) await DisposeHandleAsync();
        }
        catch (Exception error) when (error is JSException or JSDisconnectedException or ObjectDisposedException) { }
    }

    private async Task DisposeHandleAsync()
    {
        var handle = _handle;
        _handle = null;
        if (handle is null) return;
        await handle.InvokeVoidAsync("dispose");
        await handle.DisposeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            await DisposeHandleAsync();
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (Exception error) when (error is JSException or JSDisconnectedException) { }
    }
}
