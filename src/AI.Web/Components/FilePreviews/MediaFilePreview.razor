@inherits FilePreviewViewer
@implements IAsyncDisposable
@inject IJSRuntime Js

@if (_error is not null) { <p class="review-error" role="alert">@_error</p> }
@if (Context.File.Kind == "image")
{
    <div class="file-preview-toolbar">
        <button type="button" title="Zoom out" @onclick="() => Zoom(-.25)">−</button>
        <button type="button" title="Zoom in" @onclick="() => Zoom(.25)">+</button>
        <button type="button" @onclick="() => _zoom = 0">Fit</button>
        <button type="button" @onclick="() => _zoom = 1">100%</button>
    </div>
}
<div class="file-preview-body">
    @switch (Context.File.Kind)
    {
        case "image":
            <div class="file-preview-image"><img src="@Context.ContentUrl" alt="@Context.File.Name" style="@(_zoom == 0 || _imageWidth == 0 ? null : $"width:{_imageWidth * _zoom}px;max-width:none;max-height:none")" @onload="ImageLoadedAsync" @onerror="MediaFailed" /></div>
            break;
        case "video":
            <video class="file-preview-media" src="@Context.ContentUrl" controls preload="metadata" @onerror="MediaFailed"></video>
            break;
        case "audio":
            <audio class="file-preview-media" src="@Context.ContentUrl" controls preload="metadata" @onerror="MediaFailed"></audio>
            break;
        case "pdf":
            <iframe class="file-preview-pdf" src="@Context.ContentUrl" title="@Context.File.Name"></iframe>
            <p class="file-preview-status">If the PDF cannot be displayed, use Download.</p>
            break;
    }
</div>

@code {
    private IJSObjectReference? _module;
    private double _zoom;
    private int _imageWidth;
    private string? _error;
    private bool _disposed;
    private void Zoom(double amount) => _zoom = Math.Clamp((_zoom == 0 ? 1 : _zoom) + amount, .25, 4);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Context.File.Kind == "image" && _imageWidth == 0 && !_disposed) await ImageLoadedAsync();
    }
    private async Task ImageLoadedAsync()
    {
        if (_disposed) return;
        _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/filePreview.js");
        var width = await _module.InvokeAsync<int>("imageWidth", Context.PanelId);
        if (!_disposed && width > 0 && width != _imageWidth) { _imageWidth = width; StateHasChanged(); }
    }
    private void MediaFailed() => _error = "This media format or codec could not be displayed, or file access has changed. Try reopening it or use Download.";
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null) await _module.DisposeAsync();
    }
}
