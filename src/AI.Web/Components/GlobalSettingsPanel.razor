    /// <summary>
    /// The chosen items join the drawer's unsaved edits, so closing saves them and Discard drops
    /// them, exactly as if they had been typed in. A replaced item keeps its id, and with it any key
    /// already saved for it on this Host.
    /// </summary>
    private void ApplyImport(SettingsImportSelection selection)
    {
        _import = null;
        var importedConnections = new List<ConnectionEditor>();
        var importedServers = new List<GlobalMcpServerEditor>();
        foreach (var choice in selection.Connections)
        {
            var candidate = choice.Candidate;
            var index = choice.Action == SettingsImportAction.Replace && candidate.ReplaceWith is { } replacement
                ? _connections.FindIndex(item => item.Id == replacement.Id)
                : -1;
            ConnectionEditor editor;
            if (index >= 0)
            {
                editor = ConnectionEditor.From(candidate.ReplaceWith!);
                editor.Secret = _connections[index].Secret;
                editor.KeyMissing = candidate.MissingIfReplaced.Count > 0;
                _connections[index] = editor;
            }
            else
            {
                editor = ConnectionEditor.From(candidate.AddAs with { Name = ImportPlanner.UniqueName(candidate.AddAs.Name, _connections.Select(item => item.Name)) });
                editor.KeyMissing = candidate.MissingIfAdded.Count > 0;
                _connections.Add(editor);
            }

            importedConnections.Add(editor);
        }

        foreach (var choice in selection.McpServers)
        {
            var candidate = choice.Candidate;
            var index = choice.Action == SettingsImportAction.Replace && candidate.ReplaceWith is { } replacement
                ? _globalMcpServers.FindIndex(item => item.Id == replacement.Id)
                : -1;
            GlobalMcpServerEditor editor;
            if (index >= 0)
            {
                editor = GlobalMcpServerEditor.From(candidate.ReplaceWith!);
                editor.Secret = _globalMcpServers[index].Secret;
                _globalMcpServers[index] = editor;
            }
            else
            {
                editor = GlobalMcpServerEditor.From(candidate.AddAs with { Name = ImportPlanner.UniqueName(candidate.AddAs.Name, _globalMcpServers.Select(item => item.Name)) });
                _globalMcpServers.Add(editor);
            }

            editor.CredentialMissing = candidate.Imported.CredentialOmitted;
            importedServers.Add(editor);
        }

        // Land on what came in, preferring one that still needs a key typed in.
        if (Section == "Connections")
        {
            var target = importedConnections.FirstOrDefault(item => item.NeedsKey) ?? importedConnections.FirstOrDefault();
            if (target is not null) SelectConnection(target.Id);
        }
        else
        {
            var target = importedServers.FirstOrDefault(item => item.MissingSecrets.Count > 0) ?? importedServers.FirstOrDefault();
            if (target is not null) _selectedMcpServerId = target.Id;
        }

        var counts = new List<string>(2);
        if (importedConnections.Count > 0) counts.Add(Plural(importedConnections.Count, "connection"));
        if (importedServers.Count > 0) counts.Add(Plural(importedServers.Count, "MCP server"));
        if (counts.Count == 0) return;
        var needKeys = importedConnections.Count(item => item.NeedsKey) + importedServers.Count(item => item.MissingSecrets.Count > 0);
        var keys = needKeys switch { 0 => string.Empty, 1 => " One needs a key.", _ => $" {needKeys} need keys." };
        Notifications.ShowSuccess($"Imported {string.Join(" and ", counts)}.{keys} Saved when you close settings.");
    }

    /// <summary>A key typed but not saved yet still means the item has one; the export says so.</summary>
    private static ConnectionSettings ExportSettings(ConnectionEditor connection) =>
        connection.ToSettings() with { HasCredential = connection.HasCredential || !string.IsNullOrWhiteSpace(connection.Secret) };

    private static AI.Contracts.Settings.McpServerSettings ExportSettings(GlobalMcpServerEditor server) =>
        server.ToSettings() with { HasCredential = server.HasCredential || !string.IsNullOrWhiteSpace(server.Secret) };

    private Task CopyConnectionAsync(ConnectionEditor connection) =>
        CopyAsync(TransferCodec.Export([ExportSettings(connection)], []), connection.Name, "key");

    private Task CopyMcpServerAsync(GlobalMcpServerEditor server) =>
        CopyAsync(TransferCodec.Export([], [ExportSettings(server)]), server.Name, "secrets");

    private async Task CopyAsync(string json, string name, string secrets)
    {
        try
        {
            _transferModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/settingsTransfer.js");
            await _transferModule.InvokeVoidAsync("writeClipboardText", json);
            Notifications.ShowSuccess($"Copied {name} as JSON, without its {secrets}.");
        }
        catch (JSException)
        {
            Notifications.ShowError("Could not copy to the clipboard.");
        }
    }

    /// <summary>Saves pending edits; <c>true</c> when there is nothing left unsaved.</summary>
    public async Task<bool> SaveAsync()
    {
        if (_memoryEditor is not null && !await _memoryEditor.SaveAsync())
        {
            _saveFailed = true;
            return false;
        }
        if (_skillEditor is not null && !await _skillEditor.SaveAsync())
        {
            _saveFailed = true;
            return false;
        }
        if (!_loaded || !HasChanges()) return true;
        _saving = true;
        StateHasChanged();
        try
        {
            var successMessage = SavedSettingsMessage();
            await SaveChangedItemsAsync();
            foreach (var connection in _connections.Where(item => !string.IsNullOrWhiteSpace(item.Secret)))
                await GlobalSettingsApi.SetConnectionCredentialAsync(connection.Id, connection.Secret, CancellationToken.None);
            foreach (var server in _globalMcpServers.Where(item => !string.IsNullOrWhiteSpace(item.Secret)))
                await GlobalSettingsApi.SetMcpCredentialAsync(server.Id, server.Secret, CancellationToken.None);
            await LoadGlobalSettingsAsync();
            await Saved.InvokeAsync();
            // Same corner toast the rest of the app uses, so "I saved something" always looks the
            // same wherever it happened — global settings, project settings, a chat's endpoint.
            Notifications.ShowSuccess(successMessage);
            return true;
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            // A save that fails silently is worse than no toast at all: the previous footer text
            // was easy to miss next to the Save button, and this panel is now the only place where
            // an endpoint's base URL / model / credentials are typed in.
            Notifications.ShowError($"Could not save {Title}: {error.Message}");
            _saveFailed = true;
            return false;
        }
        finally
        {
            // Home calls this on Escape and on switching sections, outside this component's own
            // event handlers, so nothing else would re-render the footer.
            _saving = false;
            StateHasChanged();
        }
    }

    private string SavedSettingsMessage()
    {
        if (Section == "Connections")
        {
            var removed = _loadedConnectionIds.Count(id => _connections.All(item => item.Id != id));
            var added = _connections.Count(item => !_loadedConnectionIds.Contains(item.Id));
            return removed == 1 && added == 0 ? "Connection deleted."
                : added == 1 && removed == 0 ? "Connection added."
                : "Connections updated.";
        }
        var removedServers = _loadedMcpServerIds.Count(id => _globalMcpServers.All(item => item.Id != id));
        var addedServers = _globalMcpServers.Count(item => !_loadedMcpServerIds.Contains(item.Id));
        return removedServers == 1 && addedServers == 0 ? "MCP server deleted."
            : addedServers == 1 && removedServers == 0 ? "MCP server added."
            : "MCP settings updated.";
    }

    [SuppressMessage("ReSharper", "PropertyCanBeMadeInitOnly.Local")]
    [SuppressMessage("ReSharper", "MemberCanBePrivate.Local")]
    private sealed class ConnectionEditor
    {
        public Guid Id { get; set; } = Guid.CreateVersion7();
        public string Name { get; set; } = "OpenAI connection";
        public string BaseUrl { get; set; } = string.Empty;
        public string Model { get; set; } = string.Empty;
        public ImageInputMode ImageInput { get; set; } = ImageInputMode.Automatic;
        public bool Enabled { get; set; } = true;
        public bool IsDefault { get; set; }
        public bool ForSubtasks { get; set; }
        public int Capability { get; set; }
        public string GoodFor { get; set; } = string.Empty;
        public long? ContextWindowTokens { get; set; }
        public long? ReservedOutputTokens { get; set; }
        public decimal? InputPrice { get; set; }
        public decimal? OutputPrice { get; set; }
        public decimal? CachedInputPrice { get; set; }
        public bool HasCredential { get; set; }
        public string? Secret { get; set; }
        // Came in from an import that named a key without its value. Only the import knows this:
        // a key is optional for a local endpoint, so a missing one is not otherwise a problem.
        public bool KeyMissing { get; set; }
        public bool NeedsKey => KeyMissing && !HasCredential && string.IsNullOrWhiteSpace(Secret);

        public static ConnectionEditor From(ConnectionSettings item) => new()
        {
            Id = item.Id, Name = item.Name, BaseUrl = item.BaseUrl, Model = item.Model, ImageInput = item.ImageInput,
            Enabled = item.Enabled, IsDefault = item.IsDefault, HasCredential = item.HasCredential,
            ForSubtasks = item.ForSubtasks, Capability = item.Capability ?? 0,
            GoodFor = item.GoodFor ?? string.Empty,
            ContextWindowTokens = item.ContextWindowTokens,
            ReservedOutputTokens = item.ReservedOutputTokens,
            InputPrice = item.Prices?.Input,
            OutputPrice = item.Prices?.Output,
            CachedInputPrice = item.Prices?.CachedInput
        };

        public ConnectionSettings ToSettings() =>
            // Zero is how a range input says "nobody has rated this"; it travels as absence.
            new(Id, Name, BaseUrl, Model, Enabled, IsDefault, HasCredential, ForSubtasks,
                Capability == 0 ? null : Capability,
                string.IsNullOrWhiteSpace(GoodFor) ? null : GoodFor,
                ContextWindowTokens, ReservedOutputTokens,
                // A price is a pair: an input price without an output one would cost half of every request.
                InputPrice is { } input && OutputPrice is { } output
                    ? new AI.Contracts.Usage.TokenPrices(input, output, CachedInputPrice)
                    : null,
                ImageInput);
    }

    [SuppressMessage("ReSharper", "PropertyCanBeMadeInitOnly.Local")]
    [SuppressMessage("ReSharper", "MemberCanBePrivate.Local")]
    private sealed class GlobalMcpServerEditor
    {
        public Guid Id { get; set; } = Guid.CreateVersion7();
        public string Name { get; set; } = "MCP server";
        public string Transport { get; set; } = "StreamableHttp";
        public bool Enabled { get; set; } = true;
        public string Policy { get; set; } = "Ask";
        public bool ModernProtocolOnly { get; set; }
        public string? Url { get; set; }
        public string? Command { get; set; }
        public string ArgumentsText { get; set; } = string.Empty;
        public string? WorkingDirectory { get; set; }
        public string EnvironmentText { get; set; } = string.Empty;
        public bool HasCredential { get; set; }
        public string? Secret { get; set; }
        // Secret variables the Host holds a value for; the text shows them as "secret:NAME=".
        public HashSet<string> SavedSecretNames { get; set; } = [];
        public bool CredentialMissing { get; set; }

        /// <summary>Secrets that have neither a saved value nor one typed in yet.</summary>
        public IReadOnlyList<string> MissingSecrets
        {
            get
            {
                var missing = new List<string>();
                if (Transport == "Stdio")
                {
                    missing.AddRange(ParseEnvironment()
                        .Where(variable => variable.IsSecret && string.IsNullOrEmpty(variable.Value) && !SavedSecretNames.Contains(variable.Name))
                        .Select(variable => variable.Name));
                }
                else if (Transport == "StreamableHttp" && CredentialMissing && !HasCredential && string.IsNullOrWhiteSpace(Secret))
                {
                    missing.Add("Credential");
                }

                return missing;
            }
        }

        public static GlobalMcpServerEditor From(AI.Contracts.Settings.McpServerSettings item) => new()
        {
            Id = item.Id, Name = item.Name, Transport = item.Transport, Enabled = item.Enabled,
            Policy = item.Policy, ModernProtocolOnly = item.ModernProtocolOnly, Url = item.Url, Command = item.Command,
            ArgumentsText = string.Join(Environment.NewLine, item.Arguments),
            WorkingDirectory = item.WorkingDirectory,
            EnvironmentText = string.Join(Environment.NewLine, item.EnvironmentVariables.Select(variable =>
                variable.IsSecret ? $"secret:{variable.Name}=" : $"{variable.Name}={variable.Value}")),
            HasCredential = item.HasCredential,
            SavedSecretNames = item.EnvironmentVariables.Where(variable => variable.IsSecret && variable.HasSecret)
                .Select(variable => variable.Name).ToHashSet(StringComparer.Ordinal)
        };

        public AI.Contracts.Settings.McpServerSettings ToSettings() => new(
            Id, Name, Transport, Enabled, Policy, Url, Command,
            ArgumentsText.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
            WorkingDirectory,
            ParseEnvironment(),
            HasCredential, ModernProtocolOnly);

        // HasSecret is the Host's to say, and it ignores what is sent; it is filled in here so an
        // import can tell a server that already holds a key from one that does not.
        private McpEnvironmentVariableSettings[] ParseEnvironment() =>
            EnvironmentText.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(line => line.Split('=', 2))
                .Where(parts => parts.Length == 2)
                .Select(parts =>
                {
                    var isSecret = parts[0].StartsWith("secret:", StringComparison.OrdinalIgnoreCase);
                    var name = isSecret ? parts[0][7..] : parts[0];
                    return new McpEnvironmentVariableSettings(name, parts[1], isSecret, isSecret && SavedSecretNames.Contains(name));
                }).ToArray();
    }

