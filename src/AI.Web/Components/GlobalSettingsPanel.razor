    private async Task SaveChangedItemsAsync()
    {
        foreach (var id in _loadedConnections.Keys.Where(id => _connections.All(item => item.Id != id)).ToArray())
            CaptureLoadedItems(await GlobalSettingsApi.RemoveConnectionAsync(id, _loadedConnections[id], CancellationToken.None));

        foreach (var editor in _connections)
        {
            var item = editor.ToSettings();
            _loadedConnections.TryGetValue(item.Id, out var expected);
            if (expected is not null && JsonSerializer.Serialize(item) == JsonSerializer.Serialize(expected)) continue;
            CaptureLoadedItems(await GlobalSettingsApi.UpsertConnectionAsync(item, expected, CancellationToken.None));
        }

        foreach (var id in _loadedMcpServers.Keys.Where(id => _globalMcpServers.All(item => item.Id != id)).ToArray())
            CaptureLoadedItems(await GlobalSettingsApi.RemoveMcpServerAsync(id, _loadedMcpServers[id], CancellationToken.None));

        foreach (var editor in _globalMcpServers)
        {
            var item = editor.ToSettings();
            _loadedMcpServers.TryGetValue(item.Id, out var expected);
            if (expected is not null && McpSnapshot(item) == McpSnapshot(expected)) continue;
            CaptureLoadedItems(await GlobalSettingsApi.UpsertMcpServerAsync(item, expected, CancellationToken.None));
        }

        foreach (var key in _loadedToolPolicies.Keys.Where(key => _toolPolicies.All(item =>
                     item.ServerId != key.ServerId || item.Name != key.Name || item.SchemaHash != key.SchemaHash)).ToArray())
        {
            CaptureLoadedItems(await GlobalSettingsApi.RemoveToolPolicyAsync(
                key.ServerId, key.Name, key.SchemaHash, CancellationToken.None));
        }

        foreach (var editor in _toolPolicies)
        {
            var item = editor.ToSettings();
            if (_loadedToolPolicies.TryGetValue(PolicyKey(item), out var expected) && expected == item) continue;
            CaptureLoadedItems(await GlobalSettingsApi.SetToolPolicyAsync(item, CancellationToken.None));
        }
    }

    private string Snapshot() => JsonSerializer.Serialize(new
    {
        Connections = _connections.Select(item => item.ToSettings()).ToArray(),
        McpServers = _globalMcpServers.Select(item => item.ToSettings()).ToArray(),
        ToolPolicies = _toolPolicies.Select(item => item.ToSettings()).ToArray()
    });

    private bool HasChanges() => Snapshot() != _loadedSnapshot
        || _connections.Any(item => !string.IsNullOrWhiteSpace(item.Secret))
        || _globalMcpServers.Any(item => !string.IsNullOrWhiteSpace(item.Secret));

