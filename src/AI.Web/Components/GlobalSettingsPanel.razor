                                                    <select @attributes="@(ControlHints.Attributes("settings.tools.decision"))" class="mcp-tool-decision is-@policy.Decision.ToLowerInvariant()" @bind="policy.Decision" aria-label="Policy for @policy.Name"><option>Ask</option><option>Allow</option><option>Deny</option></select>
