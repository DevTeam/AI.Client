@using System.Diagnostics.CodeAnalysis
@using System.Text.Json
@using AI.Contracts.Settings
@inject IGlobalSettingsApi GlobalSettingsApi
@inject IConnectionContextLimitsResolver ContextLimits
@inject INotificationService Notifications
@inject IThemeService Theme
@inject IClientSettingsService ClientSettings
@inject IClientMode ClientMode
@inject IHostConnection HostConnection
@inject ISettingsTransferCodec TransferCodec
@inject ISettingsImportPlanner ImportPlanner
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<div class="permissions-drawer-backdrop"></div>
<aside class="permissions-drawer settings-drawer" aria-label="@Title" @ref="_drawer" @onclick:stopPropagation="true">
    <header>
        <div><h2>@Title</h2><p>@Description</p></div>
        <div class="settings-drawer-header-actions">
            @if (CanTransfer)
            {
                <button class="icon-action" type="button" title="Import from clipboard or file (or press Ctrl+V here)" aria-label="Import settings" disabled="@(_saving || !_loaded)" @onclick="OpenImport"><AppIcon Name="import" /></button>
                <button class="icon-action" type="button" title="Export to clipboard or file" aria-label="Export settings" disabled="@(_saving || !_loaded)" @onclick="OpenExport"><AppIcon Name="export" /></button>
            }
            <button class="icon-action" type="button" title="Close" aria-label="Close @Title" disabled="@_saving" @onclick="RequestCloseAsync"><AppIcon Name="drawer-close" /></button>
        </div>
    </header>
    <div class="settings-drawer-content">
            @switch (Section)
            {
                case "Settings":
                {
                    <div class="app-settings">
                        <fieldset class="app-settings-group">
                            <legend>Theme</legend>
                            <div class="theme-options">
                                @foreach (var option in ThemeOptions)
                                {
                                    <label class="theme-option @(_theme == option.Value ? "selected" : string.Empty)"><input type="radio" name="theme" checked="@(_theme == option.Value)" @onchange="() => SetThemeAsync(option.Value)" /><span>@option.Label</span></label>
                                }
                            </div>
                        </fieldset>
                        <fieldset class="app-settings-group">
                            <legend>Accent color</legend>
                            <div class="accent-options">
                                @foreach (var accent in Enum.GetValues<AccentColor>())
                                {
                                    var name = accent.ToString();
                                    <label class="accent-option @(_accent == accent ? "selected" : string.Empty)" style="--swatch: var(--accent-swatch-@name.ToLowerInvariant())" title="@name"><input type="radio" name="accent" aria-label="@name" checked="@(_accent == accent)" @onchange="() => SetAccentAsync(accent)" /></label>
                                }
                            </div>
                        </fieldset>
                        <fieldset class="app-settings-group">
                            <legend>Corner roundness</legend>
                            <div class="corner-roundness-control">
                                <input type="range" min="0" max="200" step="25" value="@_cornerRoundnessPercent"
                                       aria-label="Corner roundness" aria-valuetext="@($"{_cornerRoundnessPercent}%")"
                                       @oninput="SetCornerRoundnessAsync" />
                                <output>@_cornerRoundnessPercent%</output>
                            </div>
                        </fieldset>
                        <fieldset class="app-settings-group">
                            <legend>Sounds</legend>
                            <label class="checkbox"><input type="checkbox" checked="@_notificationSoundEnabled" @onchange="SetNotificationSoundAsync" /> Play a sound for new chat notifications</label>
                            <label class="checkbox"><input type="checkbox" checked="@_otherSoundsEnabled" @onchange="SetOtherSoundsAsync" /> Play other sounds</label>
                        </fieldset>
                        <fieldset class="app-settings-group">
                            <legend>Chat</legend>
                            <label class="checkbox"><input type="checkbox" checked="@_showContextWindowUsage" @onchange="SetShowContextWindowUsageAsync" /> Show context window usage</label>
                            <label class="checkbox"><input type="checkbox" checked="@_showTurnTokens" @onchange="SetShowTurnTokensAsync" /> Show tokens next to each turn's time</label>
                            @* These are the Host's: it makes the model calls, whichever window is open. *@
                            <label class="checkbox"><input type="checkbox" checked="@_chatAutomation.AutoTitle" disabled="@(!_loaded)" @onchange="args => SetChatAutomationAsync(_chatAutomation with { AutoTitle = args.Value is true })" /> Name new chats after the first answer</label>
                            <label class="checkbox"><input type="checkbox" checked="@_chatAutomation.SuggestReplies" disabled="@(!_loaded)" @onchange="args => SetChatAutomationAsync(_chatAutomation with { SuggestReplies = args.Value is true })" /> Suggest a reply after each answer</label>
                            <label class="checkbox"><input type="checkbox" checked="@_chatAutomation.SuggestComments" disabled="@(!_loaded)" @onchange="args => SetChatAutomationAsync(_chatAutomation with { SuggestComments = args.Value is true })" /> Suggest a comment when writing a review comment</label>
                            <label class="checkbox"><input type="checkbox" checked="@_chatAutomation.RouteSkills" disabled="@(!_loaded)" @onchange="args => SetChatAutomationAsync(_chatAutomation with { RouteSkills = args.Value is true })" /> Pick a skill for each new message</label>
                            <p class="host-status-note">Naming, suggestions and skill picking each make one more request to the chat's connection.</p>
                        </fieldset>
                        @if (ClientMode.PublicWeb)
                        {
                            var (hostState, hostLabel) = HostConnection.Status switch
                            {
                                HostConnectionStatus.Connected => ("is-connected", "Connected"),
                                HostConnectionStatus.Offline => ("is-offline", "Reconnecting…"),
                                _ => ("is-connecting", "Connecting…")
                            };
                            var session = HostConnection.Session;
                            <fieldset class="app-settings-group">
                                <legend>Host</legend>
                                <div class="host-status-card">
                                    <span class="host-status-dot @hostState" aria-hidden="true"></span>
                                    <div class="host-status-copy" role="status">
                                        <strong>@hostLabel</strong>
                                        <span>@(session is null ? "AI Client Host" : $"AI Client Host {(Version.TryParse(session.Version, out var version) ? version.ToString(3) : session.Version)}") · @HostConnection.Address.Authority</span>
                                    </div>
                                    <button class="secondary-action" type="button" disabled="@_disconnectingHost" @onclick="DisconnectHostAsync">Disconnect</button>
                                </div>
                                <p class="host-status-note">Projects, chats and credentials stay on this computer. Disconnect removes this browser's access; connecting again takes one click.</p>
                                @if (session is not { DesktopInstalled: true })
                                {
                                    <p class="host-status-note">Prefer a separate window? <a href="https://github.com/DevTeam/AI.Client/releases/latest" target="_blank" rel="noopener noreferrer">Get the Desktop app</a>. It shares projects and chats with this Host.</p>
                                }
                            </fieldset>
                        }
                    </div>
                    break;
                }
                case "Memory":
                case "ProjectMemory":
                {
                    <MemoryEditor @ref="_memoryEditor" @key="Section" ProjectId="@(Section == "ProjectMemory" ? ProjectId : null)" Changed="StateHasChanged" />
                    break;
                }
                case "Skills":
                case "ProjectSkills":
                {
                    <SkillEditor @ref="_skillEditor" @key="Section" ProjectId="@(Section == "ProjectSkills" ? ProjectId : null)" Changed="StateHasChanged" />
                    break;
                }
                case "Connections":
                {
                    <div class="global-editor-layout">
                        <div class="settings-list-column">
                            <nav class="settings-list">@foreach (var connectionItem in _connections) { <div class="settings-list-item @(connectionItem.Id == _selectedConnectionId ? "selected" : string.Empty)"><button class="settings-list-select" type="button" @onclick="() => SelectConnection(connectionItem.Id)"><span>@connectionItem.Name</span><small>@ConnectionStatus(connectionItem)</small></button>@if (connectionItem.Id == _selectedConnectionId) { <span class="settings-item-actions"><button class="icon-action settings-item-copy" type="button" title="Copy as JSON (without the key)" aria-label="Copy connection as JSON" @onclick="() => CopyConnectionAsync(connectionItem)"><AppIcon Name="copy" /></button><button class="icon-action settings-item-remove" type="button" title="Remove connection" aria-label="Remove connection" @onclick="RemoveConnection"><AppIcon Name="trash" /></button></span> }</div> }</nav>
                            <button class="icon-action settings-list-add" type="button" title="Add connection" aria-label="Add connection" @onclick="AddConnection"><AppIcon Name="plus" /></button>
                        </div>
                        @if (GetSelectedConnection() is { } connection)
                        {
                            <form class="global-form" autocomplete="off" @onsubmit:preventDefault="true"><div class="connection-flags"><label class="checkbox"><input type="checkbox" @bind="connection.Enabled" /> Enabled</label><label class="checkbox"><input type="checkbox" checked="@connection.IsDefault" @onchange="args => SetDefaultConnection(connection.Id, args)" /> Default</label><label class="checkbox"><input type="checkbox" disabled="@(!connection.Enabled)" checked="@connection.ForSubtasks" @onchange="args => SetSubtaskConnection(connection.Id, args)" /> For subtasks</label></div><label>Name<InputText autocomplete="off" @bind-Value="connection.Name" /></label><label>Base URL<input type="url" autocomplete="url" class="text-input" placeholder="https://api.openai.com/v1" @bind="connection.BaseUrl" @bind:event="oninput" @bind:after="() => OnEndpointChanged(connection.Id)" /></label><div class="model-field-row"><div class="model-field"><span>Model</span><ModelPicker @bind-Value="connection.Model" AriaLabel="Model" Models="@(_resolvedModels.TryGetValue(connection.Id, out var list) ? list : null)" Loading="@(_resolvingModelsForId == connection.Id)" Error="@(_resolvedErrors.TryGetValue(connection.Id, out var err) ? err : null)" OnRetry="@(() => LoadModelsIfStaleAsync(connection.Id, force: true))" Placeholder="@ModelPickerPlaceholder(connection)" EmptyHint="@ModelPickerEmptyHint(connection)" /></div>@if (_resolvingModelsForId == connection.Id) { <span class="model-loading" aria-label="Loading models" role="status"><AppIcon Name="spinner" Class="tool-row-spinner" /></span> }</div><div class="connection-ratings"><label>Context window tokens<input type="number" min="1024" max="4000000" step="1" @bind="connection.ContextWindowTokens" /><small>Effective: @EffectiveLimits(connection).ContextWindowTokens (@SourceLabel(EffectiveLimits(connection).ContextWindowSource))</small></label><label>Reserved output tokens<input type="number" min="256" max="1000000" step="1" @bind="connection.ReservedOutputTokens" /><small>Effective: @EffectiveLimits(connection).ReservedOutputTokens (@SourceLabel(EffectiveLimits(connection).ReservedOutputSource))</small></label></div><div class="connection-ratings connection-prices"><label>Input price<input type="number" min="0" max="10000" step="0.01" @bind="connection.InputPrice" /><small>Per million tokens</small></label><label>Output price<input type="number" min="0" max="10000" step="0.01" @bind="connection.OutputPrice" /><small>Per million tokens</small></label><label>Cached input<input type="number" min="0" max="10000" step="0.01" @bind="connection.CachedInputPrice" /><small>Empty: same as input</small></label></div><p class="connection-prices-note">Prices cost the usage of an endpoint that does not price requests itself. Leave them empty to show tokens only.</p><div class="connection-ratings"><label>Capability<input type="range" min="0" max="5" step="1" @bind="connection.Capability" @bind:event="oninput" /><small>@RatingLabel(connection.Capability, Capabilities)</small></label></div><label>Good for<InputText autocomplete="off" @bind-Value="connection.GoodFor" placeholder="What the ratings cannot say: vision, long context, local" /></label><label>API key<InputText type="password" autocomplete="new-password" @bind-Value="connection.Secret" @bind-Value:after="() => OnEndpointChanged(connection.Id)" placeholder="@(connection.HasCredential ? "Saved; enter to replace" : connection.KeyMissing ? "Needed: imported without its key" : "Optional")" class="@(connection.NeedsKey ? "needs-key" : null)" /></label></form>
                        }
                    </div>
                    break;
                }
                default:
                {
                    <div class="global-editor-layout">
                        <div class="settings-list-column">
                            <nav class="settings-list">@foreach (var serverItem in _globalMcpServers) { <div class="settings-list-item @(serverItem.Id == _selectedMcpServerId ? "selected" : string.Empty)"><button class="settings-list-select" type="button" @onclick="() => _selectedMcpServerId = serverItem.Id"><span>@serverItem.Name</span><small>@McpServerStatus(serverItem)</small></button>@if (serverItem.Id == _selectedMcpServerId && !IsHostProvided(serverItem.Id)) { <span class="settings-item-actions"><button class="icon-action settings-item-copy" type="button" title="Copy as JSON (without secrets)" aria-label="Copy MCP server as JSON" @onclick="() => CopyMcpServerAsync(serverItem)"><AppIcon Name="copy" /></button><button class="icon-action settings-item-remove" type="button" title="Remove MCP server" aria-label="Remove MCP server" @onclick="RemoveGlobalMcpServer"><AppIcon Name="trash" /></button></span> }</div> }</nav>
                            <button class="icon-action settings-list-add" type="button" title="Add MCP server" aria-label="Add MCP server" @onclick="AddGlobalMcpServer"><AppIcon Name="plus" /></button>
                        </div>
                        @if (GetSelectedMcpServer() is { } server)
                        {
                            <form class="global-form" autocomplete="off" @onsubmit:preventDefault="true">
                                <div class="connection-flags"><label class="checkbox"><input type="checkbox" @bind="server.Enabled" /> Enabled</label></div>
                                <label>Name<InputText autocomplete="off" @bind-Value="server.Name" readonly="@IsHostProvided(server.Id)" /></label>
                                <label>Transport<select disabled="@IsHostProvided(server.Id)" @bind="server.Transport"><option>StreamableHttp</option><option>Stdio</option><option>InProcess</option></select></label>
                                <label>Server policy<select @bind="server.Policy"><option>Allow</option><option>Ask</option><option>Deny</option></select></label>
                                @if (IsHostProvided(server.Id))
                                {
                                    <section class="mcp-tool-policies">
                                        <div class="section-heading"><div><h3>Tool defaults</h3><p>Used by every project unless that project has an override.</p></div><button class="secondary-action" type="button" @onclick="DiscoverDefaultToolsAsync">Discover tools</button></div>
                                        @if (_toolPolicies.All(item => item.ServerId != server.Id))
                                        {
                                            <p class="empty-hint">No tools discovered. Unknown tools will ask for approval.</p>
                                        }
                                        @foreach (var policy in _toolPolicies.Where(item => item.ServerId == server.Id))
                                        {
                                            <div class="mcp-tool-policy-row">
                                                <div class="mcp-tool-name"><span>Tool</span><strong title="@policy.SchemaHash">@policy.Name</strong></div>
                                                <label>Policy<select @bind="policy.Decision" aria-label="Policy for @policy.Name"><option>Ask</option><option>Allow</option><option>Deny</option></select></label>
                                                <label>Calls/run<input type="number" min="1" max="2147483647" @bind="policy.MaxCallsPerRun" /></label>
                                                <label>Timeout, sec<input type="number" min="1" max="600" @bind="policy.TimeoutSeconds" /></label>
                                            </div>
                                        }
                                        <p class="mcp-policy-note">Deny disables the server. Otherwise a tool-specific Allow can run without confirmation; unknown tools ask by default.</p>
                                    </section>
                                }
                                else if (server.Transport == "StreamableHttp")
                                {
                                    <label>URL<InputText autocomplete="url" @bind-Value="server.Url" /></label><label>Credential<InputText type="password" autocomplete="new-password" @bind-Value="server.Secret" placeholder="@(server.HasCredential ? "Saved; enter to replace" : server.CredentialMissing ? "Needed: imported without it" : "Optional")" class="@(server.MissingSecrets.Count > 0 ? "needs-key" : null)" /></label>
                                }
                                else
                                {
                                    <label>Command<InputText @bind-Value="server.Command" /></label><label>Arguments<InputText @bind-Value="server.ArgumentsText" placeholder="One argument per line" /></label><label>Working directory<InputText @bind-Value="server.WorkingDirectory" /></label><label>Environment variables<InputTextArea @bind-Value="server.EnvironmentText" placeholder="NAME=value" />@if (server.MissingSecrets.Count > 0) { <small class="settings-needs-key-hint">Needs a value: @string.Join(", ", server.MissingSecrets). Type it after the = on its secret: line.</small> }</label>
                                }
                            </form>
                        }
                    </div>
                    break;
                }
            }
    </div>
    <footer>
        @if (_saveFailed)
        {
            <span class="settings-drawer-error" role="alert">Not saved. Fix the fields or discard.</span>
            <button class="secondary-action permissions-reset-all" type="button" disabled="@_saving" @onclick="DiscardAndCloseAsync">Discard changes</button>
        }
        else
        {
            <span>@(_saving ? "Saving…" : Stats)</span>
        }
    </footer>
</aside>
@if (_import is { } import)
{
    <SettingsImportDialog @key="import.Key" InitialText="@import.Text" Source="@import.Source"
                          Connections="@(_connections.Select(item => item.ToSettings()).ToArray())"
                          McpServers="@(_globalMcpServers.Select(item => item.ToSettings()).ToArray())"
                          Applied="ApplyImport" Cancelled="() => _import = null" />
}
@if (_exportOpen)
{
    <SettingsExportDialog Section="@Section"
                          Connections="@(_connections.Select(ExportSettings).ToArray())"
                          McpServers="@(_globalMcpServers.Where(item => !IsHostProvided(item.Id)).Select(ExportSettings).ToArray())"
                          Closed="() => _exportOpen = false" />
}
@code {
    [Parameter] public string Section { get; set; } = "Connections";
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public EventCallback<bool> ContextWindowUsageChanged { get; set; }
    [Parameter] public EventCallback<bool> TurnTokensChanged { get; set; }
    /// <summary>The project whose memory and skills the ProjectMemory and ProjectSkills sections edit.</summary>
    [Parameter] public Guid? ProjectId { get; set; }
    private MemoryEditor? _memoryEditor;
    private SkillEditor? _skillEditor;
    [Parameter] public EventCallback Close { get; set; }
    private bool _loaded;
    private bool _saving;
    private bool _disconnectingHost;
    private bool _saveFailed;
    // What was loaded, in the shape that is sent back; closing without edits must not write
    // (and toast) anything, and secrets never appear here, so they are checked separately.
    private string? _loadedSnapshot;
    private HashSet<Guid> _loadedConnectionIds = [];
    private HashSet<Guid> _loadedMcpServerIds = [];
    // Catalogs loaded from the endpoint on demand, keyed by connection id so switching between
    // connections in the left column keeps each one's results visible until the next refresh.
    private readonly Dictionary<Guid, IReadOnlyList<ResolvedModelInfo>> _resolvedModels = [];
    // What the last catalog was loaded for (BaseUrl and typed key), per connection. A load is needed
    // only when the form differs from it; storing it here skips duplicate calls and lets us know to
    // refresh after the user edits the URL or the key.
    private readonly Dictionary<Guid, string> _resolvedEndpoints = [];
    // Last failure per connection, kept so the picker can show why the dropdown is empty and offer
    // a Retry button. Cleared when the next attempt starts so a transient 401 does not linger once
    // the user fixes the key.
    private readonly Dictionary<Guid, string> _resolvedErrors = [];
    private Guid? _resolvingModelsForId;
    // Cancels an in-flight /models request when the user closes the drawer or refreshes again, so
    // the late response cannot leak into a different connection's dropdown.
    private CancellationTokenSource? _resolveCancellation;
    // Debounce for the auto-load: a typing burst into BaseUrl collapses into a single request
    // 350 ms after the last keystroke. The token cancels any pending timer so only the last
    // keystroke's request survives.
    private CancellationTokenSource? _autoLoadDebounce;
    // Connection id the pending debounce belongs to; if the user switches to a different one in the
    // middle of typing, the timer fires and would otherwise load for the old id.
    private Guid _autoLoadDebounceForId;
    // Auto-load latency in milliseconds. Short enough that the dropdown feels responsive after a
    // paste, long enough to skip the per-keystroke churn of typing the URL by hand.
    private const int AutoLoadDebounceMilliseconds = 350;
    private readonly List<ConnectionEditor> _connections = [];
    private readonly List<GlobalMcpServerEditor> _globalMcpServers = [];
    private readonly List<McpToolPolicyEditor> _toolPolicies = [];
    private Guid? _selectedConnectionId;
    private Guid? _selectedMcpServerId;
    private ThemePreference _theme;
    private AccentColor _accent;
    private int _cornerRoundnessPercent = 100;
    private bool _notificationSoundEnabled = true;
    private bool _otherSoundsEnabled = true;
    private bool _showContextWindowUsage = true;
    private bool _showTurnTokens;
    private ChatAutomationSettings _chatAutomation = new();
    private ElementReference _drawer;
    private IJSObjectReference? _transferModule;
    private IJSObjectReference? _transferSubscription;
    private DotNetObjectReference<GlobalSettingsPanel>? _transferReference;
    private ImportRequest? _import;
    private int _importCount;
    private bool _exportOpen;

    /// <summary>What the import dialog opens with; a new key each time so a second paste starts over.</summary>
    private sealed record ImportRequest(int Key, string? Text, string? Source);

    protected override async Task OnInitializedAsync()
    {
        HostConnection.Changed += OnHostConnectionChanged;
        _theme = await Theme.GetAsync();
        _accent = await Theme.GetAccentAsync();
        _cornerRoundnessPercent = await Theme.GetCornerRoundnessAsync();
        var clientSettings = await ClientSettings.GetAsync();
        _notificationSoundEnabled = clientSettings.NotificationSoundEnabled;
        _otherSoundsEnabled = clientSettings.OtherSoundsEnabled;
        _showContextWindowUsage = clientSettings.ShowContextWindowUsage;
        _showTurnTokens = clientSettings.ShowTurnTokens;
        await LoadGlobalSettingsAsync();
    }
    private async Task LoadGlobalSettingsAsync()
    {
        var settings = await GlobalSettingsApi.GetAsync(CancellationToken.None);
        _connections.Clear();
        _connections.AddRange(settings.Connections.Select(ConnectionEditor.From));
        _globalMcpServers.Clear();
        _globalMcpServers.AddRange(settings.McpServers.Select(GlobalMcpServerEditor.From));
        _toolPolicies.Clear();
        _toolPolicies.AddRange(settings.ToolPolicies.Select(McpToolPolicyEditor.From));
        _chatAutomation = settings.ChatAutomation ?? new ChatAutomationSettings();
        // A save reloads, and switching between Connections and MCP saves: keep the selection
        // where it was instead of jumping back to the first item every time.
        if (_connections.All(item => item.Id != _selectedConnectionId)) _selectedConnectionId = _connections.FirstOrDefault()?.Id;
        // The selection may have been just resolved (first open or post-save reload) without going
        // through SelectConnection; kick off the model load here so the catalog is in place by the
        // time the form paints. LoadModelsIfStaleAsync is a no-op when the cache for this BaseUrl
        // is fresh, so a redundant call on a Save-then-keep-selection is free.
        if (_selectedConnectionId is { } autoLoadId) _ = LoadModelsIfStaleAsync(autoLoadId);
        if (_globalMcpServers.All(item => item.Id != _selectedMcpServerId)) _selectedMcpServerId = _globalMcpServers.FirstOrDefault()?.Id;
        _loadedSnapshot = Snapshot();
        _loadedConnectionIds = _connections.Select(item => item.Id).ToHashSet();
        _loadedMcpServerIds = _globalMcpServers.Select(item => item.Id).ToHashSet();
        _saveFailed = false;
        _loaded = true;
    }

    /// <summary>The footer line, counted the way the permissions drawer counts its overrides.</summary>
    private string Stats => Section switch
    {
        "Settings" => "Applied right away",
        "Memory" or "ProjectMemory" => _memoryEditor?.Stats ?? string.Empty,
        "Skills" or "ProjectSkills" => _skillEditor?.Stats ?? string.Empty,
        "Connections" => $"{Plural(_connections.Count, "connection")} · {_connections.Count(item => item.Enabled)} enabled",
        _ => $"{Plural(_globalMcpServers.Count, "server")} · {_globalMcpServers.Count(item => item.Enabled)} enabled · {Plural(_toolPolicies.Count, "tool default")}"
    };

    private string Title => Section switch
    {
        "ProjectMemory" => "Project memory",
        "ProjectSkills" => "Project skills",
        _ => Section
    };

    /// <summary>Connections and MCP servers travel as text; the app's own look and memory do not.</summary>
    private bool CanTransfer => Section is not ("Settings" or "Memory" or "ProjectMemory" or "Skills" or "ProjectSkills");

    private string Description => Section switch
    {
        "Settings" => ClientMode.PublicWeb ? "How the app looks and behaves, and the Host it works with." : "How the app looks and behaves on this device.",
        "Memory" => "What the assistant remembers about you in every project.",
        "ProjectMemory" => "What the assistant remembers about this project.",
        "Skills" => "Instructions the assistant can use for focused tasks in every project.",
        "ProjectSkills" => "Instructions the assistant can use for focused tasks in this project.",
        "Connections" => "OpenAI-compatible endpoints available to every project.",
        _ => "Global MCP servers available to every project."
    };

    private static readonly (ThemePreference Value, string Label)[] ThemeOptions =
        [(ThemePreference.System, "System"), (ThemePreference.Light, "Light"), (ThemePreference.Dark, "Dark"), (ThemePreference.DarkBlue, "Dark blue")];

    /// <summary>Unlike the Host-side settings, a theme needs no save on close: it applies on click.</summary>
    private async Task SetThemeAsync(ThemePreference preference)
    {
        _theme = preference;
        await Theme.SetAsync(preference);
    }

    private async Task SetAccentAsync(AccentColor accent)
    {
        _accent = accent;
        await Theme.SetAccentAsync(accent);
    }

    private async Task SetCornerRoundnessAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var percent)) return;
        _cornerRoundnessPercent = Math.Clamp(percent, 0, 200);
        await Theme.SetCornerRoundnessAsync(_cornerRoundnessPercent);
    }

    private async Task SetNotificationSoundAsync(ChangeEventArgs args)
    {
        _notificationSoundEnabled = args.Value is true;
        await ClientSettings.UpdateAsync(current => current with { NotificationSoundEnabled = _notificationSoundEnabled });
    }

    private async Task SetOtherSoundsAsync(ChangeEventArgs args)
    {
        _otherSoundsEnabled = args.Value is true;
        await ClientSettings.UpdateAsync(current => current with { OtherSoundsEnabled = _otherSoundsEnabled });
    }

    private async Task SetShowContextWindowUsageAsync(ChangeEventArgs args)
    {
        _showContextWindowUsage = args.Value is true;
        await ClientSettings.UpdateAsync(current => current with { ShowContextWindowUsage = _showContextWindowUsage });
        await ContextWindowUsageChanged.InvokeAsync(_showContextWindowUsage);
    }

    private async Task SetShowTurnTokensAsync(ChangeEventArgs args)
    {
        _showTurnTokens = args.Value is true;
        await ClientSettings.UpdateAsync(current => current with { ShowTurnTokens = _showTurnTokens });
        await TurnTokensChanged.InvokeAsync(_showTurnTokens);
    }

    /// <summary>Applied on click like the rest of this section, but stored on the Host.</summary>
    private async Task SetChatAutomationAsync(ChatAutomationSettings automation)
    {
        var previous = _chatAutomation;
        _chatAutomation = automation;
        try
        {
            _chatAutomation = (await GlobalSettingsApi.SetChatAutomationAsync(automation, CancellationToken.None)).ChatAutomation
                ?? automation;
        }
        catch (HttpRequestException error)
        {
            _chatAutomation = previous;
            Notifications.ShowError($"Could not save the chat setting: {error.Message}");
        }
    }

    private static string Plural(int count, string word) => $"{count} {word}{(count == 1 ? string.Empty : "s")}";

    private SaveGlobalSettingsRequest BuildRequest() => new(
        // ReSharper disable once UseCollectionExpression
        _connections.Select(item => item.ToSettings()).ToArray(),
        [.. _globalMcpServers.Select(item => item.ToSettings())],
        [.. _toolPolicies.Select(item => item.ToSettings())]);

