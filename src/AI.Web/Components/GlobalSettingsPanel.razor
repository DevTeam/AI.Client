    private void SelectLinkedTool()
    {
        if (!_loaded || Section != "MCP" || ToolToEdit is null || _appliedSelection == LinkSelection) return;
        _appliedSelection = LinkSelection;
        var tool = AI.Contracts.Tools.ToolRef.Parse(ToolToEdit);
        Guid? serverId = tool.IsBuiltIn ? DefaultMcpServer.Id : tool.IsApp ? AppMcpServer.Id
            : tool.IsCSharp ? CSharpMcpServer.Id
            : tool.ServerPrefix.Length > 6 && tool.ServerPrefix.StartsWith("mcp_", StringComparison.Ordinal)
                && Guid.TryParse(tool.ServerPrefix[4..^2], out var id) ? id : null;
        var matches = _toolPolicies.Where(item => item.Name == tool.Name
            && (serverId is null || item.ServerId == serverId)).ToArray();
        if (serverId is null && tool.ServerPrefix.Length == 0 && matches.Select(item => item.ServerId).Distinct().Count() == 1)
            serverId = matches[0].ServerId;
        if (serverId is null || !_globalMcpServers.Any(item => item.Id == serverId))
        {
            Notifications.ShowError("The tool in this link is unavailable or ambiguous.");
            return;
        }
        SelectMcpServer(serverId.Value);
        _mcpTab = McpTab.Tools;
        _toolFilter = tool.Name;
        _expandedTool = tool.Name;
        if (matches.Length == 0)
            Notifications.ShowInfo("This tool is not in the saved catalog. Use Discover to load the server's tools.");
