@inject AI.Web.Navigation.IAppControlHints ControlHints
@using System.Diagnostics.CodeAnalysis
@using System.Text.Json
@using AI.Contracts.Settings
@using AI.Web.FileSystem
@inject IGlobalSettingsApi GlobalSettingsApi
@inject IConnectionContextLimitsResolver ContextLimits
@inject INotificationService Notifications
@inject IThemeService Theme
@inject IClientSettingsService ClientSettings
@inject IClientMode ClientMode
@inject IHostConnection HostConnection
@inject AI.Web.Updates.IPublishedDownloadLinks PublishedDownloads
@inject ISettingsTransferCodec TransferCodec
@inject ISettingsImportPlanner ImportPlanner
@inject IJSRuntime JsRuntime
@inject ISettingsListFilter ListFilter
@implements IAsyncDisposable

<div class="permissions-drawer-backdrop"></div>
<aside @attributes="@(ControlHints.Attributes(GuideSectionTarget, nativeTooltip: false))" class="permissions-drawer settings-drawer @(Section == "Settings" ? "is-narrow" : null)" aria-label="@Title" @ref="_drawer" @onclick:stopPropagation="true">
    <header>
        <div><h2>@Title</h2><p>@Description</p></div>
        <div class="settings-drawer-header-actions">
            @if (CanTransfer)
            {
                <button class="icon-action" type="button" title="Import from clipboard or file (or press Ctrl+V here)" aria-label="Import settings" disabled="@(_saving || !_loaded)" @onclick="OpenImport"><AppIcon Name="import" /></button>
                <button class="icon-action" type="button" title="Export to clipboard or file" aria-label="Export settings" disabled="@(_saving || !_loaded)" @onclick="OpenExport"><AppIcon Name="export" /></button>
            }
            <button @attributes="@(ControlHints.Attributes((Section == "Connections" ? "settings.connections.close" : null), "Close"))" class="icon-action" type="button" aria-label="Close @Title" disabled="@_saving" @onclick="RequestCloseAsync"><AppIcon Name="drawer-close" /></button>
        </div>
    </header>
    <div class="settings-drawer-content">
            @switch (Section)
            {
                case "Settings":
                {
                    <div class="app-settings">
                        @if (ClientMode.PublicWeb)
                        {
                            var (hostState, hostLabel) = HostConnection.Status switch
                            {
                                HostConnectionStatus.Connected => ("is-connected", "Connected"),
                                HostConnectionStatus.Offline => ("is-offline", "Reconnecting…"),
                                _ => ("is-connecting", "Connecting…")
                            };
                            var session = HostConnection.Session;
                            <section class="settings-group" aria-label="Host">
                                <div class="settings-card">
                                    <div class="settings-row">
                                        <span class="host-status-dot @hostState" aria-hidden="true"></span>
                                        <span class="settings-row-text" role="status">
                                            <span class="settings-row-label">@hostLabel</span>
                                            <span class="settings-row-hint" title="Projects, chats and credentials stay on this computer. Disconnect removes this browser's access; connecting again takes one click.">@(session is null ? "AI Client Host" : $"AI Client Host {(Version.TryParse(session.Version, out var version) ? version.ToString(3) : session.Version)}") · @HostConnection.Address.Authority</span>
                                        </span>
                                        <button class="compact-action" type="button" disabled="@_disconnectingHost" @onclick="DisconnectHostAsync">Disconnect</button>
                                    </div>
                                    @if (session is not { DesktopInstalled: true })
                                    {
                                        <div class="settings-row">
                                            <span class="settings-row-text"><span class="settings-row-label">Desktop app</span><span class="settings-row-hint">A separate window with the same projects and chats</span></span>
                                            @if (_desktopReleaseUrl is not null)
                                            {
                                                <a href="@_desktopReleaseUrl" target="_blank" rel="noopener noreferrer">Get it</a>
                                            }
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                        <UpdatesPanel />
                        <section class="settings-group" aria-labelledby="settings-appearance">
                            <h3 id="settings-appearance">Appearance</h3>
                            <div class="settings-card">
                                <div @attributes="@(ControlHints.Attributes("settings.appearance.theme"))" class="settings-row is-stacked" role="radiogroup" aria-labelledby="settings-theme">
                                    <span class="settings-row-label" id="settings-theme">Theme</span>
                                    <span class="theme-options">
                                        @foreach (var option in ThemeOptions)
                                        {
                                            <label class="theme-option @(_theme == option.Value ? "selected" : string.Empty)"><input type="radio" name="theme" value="@option.Value.ToString().ToLowerInvariant()" checked="@(_theme == option.Value)" @onchange="() => SetThemeAsync(option.Value)" /><span>@option.Label</span></label>
                                        }
                                    </span>
                                </div>
                                <div @attributes="@(ControlHints.Attributes("settings.appearance.accent"))" class="settings-row" role="radiogroup" aria-labelledby="settings-accent">
                                    <span class="settings-row-label" id="settings-accent">Accent</span>
                                    <span class="accent-options">
                                        @foreach (var accent in Enum.GetValues<AccentColor>())
                                        {
                                            var name = accent.ToString();
                                            <label class="accent-option @(_accent == accent ? "selected" : string.Empty)" style="--swatch: var(--accent-swatch-@name.ToLowerInvariant())" title="@name"><input type="radio" name="accent" aria-label="@name" checked="@(_accent == accent)" @onchange="() => SetAccentAsync(accent)" /></label>
                                        }
                                    </span>
                                </div>
                                <div @attributes="@(ControlHints.Attributes("settings.appearance.corners"))" class="settings-row">
                                    <span class="settings-row-label">Corners</span>
                                    <span class="corner-roundness-control">
                                        <input type="range" min="0" max="200" step="25" value="@_cornerRoundnessPercent"
                                               aria-label="Corner roundness" aria-valuetext="@($"{_cornerRoundnessPercent}%")"
                                               @oninput="SetCornerRoundnessAsync" />
                                        <output>@_cornerRoundnessPercent%</output>
                                    </span>
                                </div>
                            </div>
                        </section>
                        <section class="settings-group" aria-labelledby="settings-chat">
                            <h3 id="settings-chat">Chat</h3>
                            <div class="settings-card">
                                <label @attributes="@(ControlHints.Attributes("settings.chat.turn_tokens"))" class="settings-row">
                                    <span class="settings-row-text"><span class="settings-row-label">Tokens per turn</span><span class="settings-row-hint">@ControlHints.GetSummary("settings.chat.turn_tokens")</span></span>
                                    <input class="settings-switch" type="checkbox" role="switch" checked="@_showTurnTokens" @onchange="SetShowTurnTokensAsync" />
                                </label>
                                <label class="settings-row">
                                    <span class="settings-row-text"><span class="settings-row-label">Notes while working</span><span class="settings-row-hint">@ControlHints.GetSummary("settings.chat.live_notes")</span></span>
                                    <select @attributes="@(ControlHints.Attributes("settings.chat.live_notes"))" value="@_liveNoteCount" @onchange="SetLiveNoteCountAsync">
                                        @for (var count = AI.Web.Settings.ClientSettings.MinLiveNoteCount; count <= AI.Web.Settings.ClientSettings.MaxLiveNoteCount; count++)
                                        {
                                            <option value="@count">@count</option>
                                        }
                                    </select>
                                </label>
                                @* These are the Host's: it makes the model calls, whichever window is open. *@
                                <details class="settings-disclosure">
                                    <summary @attributes="@(ControlHints.Attributes("settings.chat.helpers"))" class="settings-row">
                                        <span class="settings-row-text"><span class="settings-row-label">Model helpers</span><span class="settings-row-hint">@ControlHints.GetSummary("settings.chat.helpers")</span></span>
                                        <span class="settings-row-value">@ChatHelpersOn of 4</span>
                                        <AppIcon Name="chevron-right" Class="settings-disclosure-chevron" />
                                    </summary>
                                    <label @attributes="@(ControlHints.Attributes("settings.chat.auto_title"))" class="settings-row">
                                        <span class="settings-row-label">Name new chats after the first answer</span>
                                        <input class="settings-switch" type="checkbox" role="switch" checked="@_chatAutomation.AutoTitle" disabled="@(!_loaded)" @onchange="args => SetChatAutomationAsync(_chatAutomation with { AutoTitle = args.Value is true })" />
                                    </label>
                                    <label @attributes="@(ControlHints.Attributes("settings.chat.reply_suggestions"))" class="settings-row">
                                        <span class="settings-row-label">Suggest a reply after each answer</span>
                                        <input class="settings-switch" type="checkbox" role="switch" checked="@_chatAutomation.SuggestReplies" disabled="@(!_loaded)" @onchange="args => SetChatAutomationAsync(_chatAutomation with { SuggestReplies = args.Value is true })" />
                                    </label>
                                    <label @attributes="@(ControlHints.Attributes("settings.chat.review_suggestions"))" class="settings-row">
                                        <span class="settings-row-label">Suggest review comments</span>
                                        <input class="settings-switch" type="checkbox" role="switch" checked="@_chatAutomation.SuggestComments" disabled="@(!_loaded)" @onchange="args => SetChatAutomationAsync(_chatAutomation with { SuggestComments = args.Value is true })" />
                                    </label>
                                    <label @attributes="@(ControlHints.Attributes("settings.chat.skill_routing"))" class="settings-row">
                                        <span class="settings-row-label">Pick a skill for each new message</span>
                                        <input class="settings-switch" type="checkbox" role="switch" checked="@_chatAutomation.RouteSkills" disabled="@(!_loaded)" @onchange="args => SetChatAutomationAsync(_chatAutomation with { RouteSkills = args.Value is true })" />
                                    </label>
                                </details>
                            </div>
                        </section>
                        <CorrectionLanguagesSettings />
                        <section class="settings-group" aria-labelledby="settings-guide">
                            <h3 id="settings-guide">Application guide</h3>
                            <div class="settings-card">
                                <label class="settings-row">
                                    <span class="settings-row-text"><span class="settings-row-label">Suggest help when idle</span><span class="settings-row-hint">@ControlHints.GetSummary("settings.guide.enabled")</span></span>
                                    <input @attributes="@(ControlHints.Attributes("settings.guide.enabled"))" class="settings-switch" type="checkbox" role="switch" checked="@_guideSuggestionsEnabled" @onchange="SetGuideSuggestionsAsync" />
                                </label>
                                <label class="settings-row">
                                    <span class="settings-row-label">Idle time before a suggestion</span>
                                    <select @attributes="@(ControlHints.Attributes("settings.guide.idle"))" value="@_guideIdleMinutes" @onchange="SetGuideIdleAsync"><option value="1">1 minute</option><option value="5">5 minutes</option><option value="10">10 minutes</option><option value="15">15 minutes</option><option value="30">30 minutes</option><option value="60">1 hour</option><option value="120">2 hours</option></select>
                                </label>
                                <div @attributes="@(ControlHints.Attributes("settings.guide.progress"))" class="settings-row"><span class="settings-row-text"><span class="settings-row-label">Learning progress</span><span class="settings-row-hint">@_guideCompletedCount topics completed</span></span><button class="compact-action" type="button" @onclick="ResetGuideProgressAsync">Reset progress</button></div>
                            </div>
                        </section>
                        <section class="settings-group" aria-labelledby="settings-sounds">
                            <h3 id="settings-sounds">Sounds</h3>
                            <div class="settings-card">
                                <label class="settings-row">
                                    <span class="settings-row-label">New chat notifications</span>
                                    <input @attributes="@(ControlHints.Attributes("settings.sounds.notifications"))" class="settings-switch" type="checkbox" role="switch" checked="@_notificationSoundEnabled" @onchange="SetNotificationSoundAsync" />
                                </label>
                                <label @attributes="@(ControlHints.Attributes("settings.sounds.other"))" class="settings-row">
                                    <span class="settings-row-label">Other sounds</span>
                                    <input class="settings-switch" type="checkbox" role="switch" checked="@_otherSoundsEnabled" @onchange="SetOtherSoundsAsync" />
                                </label>
                            </div>
                        </section>
                    </div>
                    break;
                }
                case "Memory":
                case "ProjectMemory":
                {
                    <MemoryEditor @ref="_memoryEditor" @key="Section" ProjectId="@(Section == "ProjectMemory" ? ProjectId : null)" Changed="StateHasChanged" />
                    break;
                }
                case "Skills":
                case "ProjectSkills":
                {
                    <SkillEditor @ref="_skillEditor" @key="Section" ProjectId="@(Section == "ProjectSkills" ? ProjectId : null)" SkillToEdit="@SkillToEdit" SkillSource="@SkillSource" LinkSelection="@LinkSelection" Changed="StateHasChanged" />
                    break;
                }
                case "Connections":
                {
                    <div class="global-editor-layout">
                        <div class="settings-list-column">
                            <SettingsFilterField @bind-Value="_connectionFilter" Placeholder="Filter connections" Shown="@ShownConnections.Count" Total="@_connections.Count" Submitted="() => SelectFirst(ShownConnections.Select(item => item.Id), SelectConnection)" />
                            <nav class="settings-list">@if (_connections.Count > 0 && ShownConnections.Count == 0) { <p class="empty-hint">No connections match “@_connectionFilter.Trim()”.</p> }@foreach (var connectionItem in ShownConnections) { <div class="settings-list-item @(connectionItem.Id == _selectedConnectionId ? "selected" : string.Empty)"><button class="settings-list-select" type="button" @onclick="() => SelectConnection(connectionItem.Id)"><span><SettingsFilterText Text="@connectionItem.Name" Query="@_connectionFilter" /></span><small><SettingsFilterText Text="@ConnectionStatus(connectionItem)" Query="@_connectionFilter" /></small></button>@if (connectionItem.Id == _selectedConnectionId) { <span class="settings-item-actions"><button class="icon-action settings-item-copy" type="button" title="Copy as JSON (without the key)" aria-label="Copy connection as JSON" @onclick="() => CopyConnectionAsync(connectionItem)"><AppIcon Name="copy" /></button><button class="icon-action settings-item-remove" type="button" title="Remove connection" aria-label="Remove connection" @onclick="RemoveConnection"><AppIcon Name="trash" /></button></span> }</div> }</nav>
                            <button @attributes="@(ControlHints.Attributes("settings.connections.add", "Add connection"))" class="icon-action settings-list-add" type="button" aria-label="Add connection" @onclick="AddConnection"><AppIcon Name="plus" /></button>
                        </div>
                        @if (GetSelectedConnection() is { } connection)
                        {
                            var limits = EffectiveLimits(connection);
                            <form class="global-form settings-form" autocomplete="off" @onsubmit:preventDefault="true">
                                <div class="settings-card">
                                    <label @attributes="@(ControlHints.Attributes("settings.connection.enabled"))" class="settings-row">
                                        <span class="settings-row-label">Enabled</span>
                                        <input class="settings-switch" type="checkbox" role="switch" @bind="connection.Enabled" />
                                    </label>
                                    <label @attributes="@(ControlHints.Attributes("settings.connection.default"))" class="settings-row">
                                        <span class="settings-row-text"><span class="settings-row-label">Default</span><span class="settings-row-hint">@ControlHints.GetSummary("settings.connection.default")</span></span>
                                        <input class="settings-switch" type="checkbox" role="switch" checked="@connection.IsDefault" @onchange="args => SetDefaultConnection(connection.Id, args)" />
                                    </label>
                                    <label @attributes="@(ControlHints.Attributes("settings.connection.subtasks"))" class="settings-row">
                                        <span class="settings-row-text"><span class="settings-row-label">For subtasks</span><span class="settings-row-hint">@ControlHints.GetSummary("settings.connection.subtasks")</span></span>
                                        <input class="settings-switch" type="checkbox" role="switch" disabled="@(!connection.Enabled)" checked="@connection.ForSubtasks" @onchange="args => SetSubtaskConnection(connection.Id, args)" />
                                    </label>
                                </div>
                                <section class="settings-group" aria-labelledby="connection-endpoint">
                                    <h3 id="connection-endpoint">Endpoint</h3>
                                    <div class="settings-card">
                                        <label class="settings-row settings-field"><span class="settings-row-label">Name</span><InputText autocomplete="off" @bind-Value="connection.Name" /></label>
                                        <label @attributes="@(ControlHints.Attributes("settings.connection.url"))" class="settings-row settings-field"><span class="settings-row-label">Base URL</span><input type="url" autocomplete="url" class="text-input" placeholder="https://api.openai.com/v1" @bind="connection.BaseUrl" @bind:event="oninput" @bind:after="() => OnEndpointChanged(connection.Id)" /></label>
                                        <label @attributes="@(ControlHints.Attributes("settings.connection.credential"))" class="settings-row settings-field"><span class="settings-row-label">API key</span><InputText type="password" autocomplete="new-password" @bind-Value="connection.Secret" @bind-Value:after="() => OnEndpointChanged(connection.Id)" placeholder="@(connection.HasCredential ? "Saved; enter to replace" : connection.KeyMissing ? "Needed: imported without its key" : "Optional")" class="@(connection.NeedsKey ? "needs-key" : null)" /></label>
                                        @* A div, not a label: a label refocuses the picker on any click inside it. *@
                                        <div @attributes="@(ControlHints.Attributes("settings.connection.model"))" class="settings-row settings-field">
                                            <span class="settings-row-label">Model</span>
                                            <span class="settings-field-control"><ModelPicker @bind-Value="connection.Model" @bind-Value:after="() => InvalidateImageTest(connection)" AriaLabel="Model" Models="@(_resolvedModels.TryGetValue(connection.Id, out var list) ? list : null)" Loading="@(_resolvingModelsForId == connection.Id)" Error="@(_resolvedErrors.TryGetValue(connection.Id, out var err) ? err : null)" OnRetry="@(() => LoadModelsIfStaleAsync(connection.Id, force: true))" Placeholder="@ModelPickerPlaceholder(connection)" EmptyHint="@ModelPickerEmptyHint(connection)" /></span>
                                            @if (_resolvingModelsForId == connection.Id) { <span class="model-loading" aria-label="Loading models" role="status"><AppIcon Name="spinner" Class="tool-row-spinner" /></span> }
                                        </div>
                                        @{ var testingImage = _testingImageForId == connection.Id; }
                                        <div class="settings-row settings-field image-input-row">
                                            <span class="settings-row-text"><span class="settings-row-label" id="connection-image-input">Image input</span><span class="settings-row-hint">@ImageInputHint(connection.ImageInput)</span></span>
                                            <span class="settings-field-control">
                                                <span class="theme-options" role="radiogroup" aria-labelledby="connection-image-input">
                                                    @foreach (var option in ImageInputOptions)
                                                    {
                                                        <label class="theme-option @(connection.ImageInput == option.Value ? "selected" : string.Empty)" title="@ImageInputHint(option.Value)"><input type="radio" name="connection-image-input" checked="@(connection.ImageInput == option.Value)" @onchange="() => connection.ImageInput = option.Value" /><span>@option.Label</span></label>
                                                    }
                                                </span>
                                                <button class="compact-action image-test-action" type="button" title="Send a test image to the selected model and pick the mode from its answer" disabled="@(testingImage || string.IsNullOrWhiteSpace(connection.BaseUrl) || string.IsNullOrWhiteSpace(connection.Model))" @onclick="() => TestImageAsync(connection)"><AppIcon Name="@(testingImage ? "spinner" : "image")" Class="@(testingImage ? "tool-row-spinner" : null)" /><span>@(testingImage ? "Testing…" : "Test")</span></button>
                                            </span>
                                        </div>
                                        @if (!testingImage && _imageTestResults.TryGetValue(connection.Id, out var imageTest))
                                        {
                                            <div class="settings-row image-test-result @(imageTest.Supported switch { true => "is-supported", false => "is-unsupported", null => "is-failed" })" role="status">
                                                <AppIcon Name="@(imageTest.Supported switch { true => "check", false => "x", null => "error" })" />
                                                <span>@imageTest.Detail</span>
                                            </div>
                                        }
                                    </div>
                                </section>
                                <section class="settings-group" aria-labelledby="connection-more">
                                    <h3 id="connection-more">Details</h3>
                                    <div class="settings-card">
                                        <details class="settings-disclosure">
                                            <summary class="settings-row">
                                                <span class="settings-row-text"><span class="settings-row-label">Profile</span><span class="settings-row-hint">How subtasks pick a connection</span></span>
                                                <span class="settings-row-value">@RatingLabel(connection.Capability, Capabilities)</span>
                                                <AppIcon Name="chevron-right" Class="settings-disclosure-chevron" />
                                            </summary>
                                            <label @attributes="@(ControlHints.Attributes("settings.connection.capability"))" class="settings-row settings-field"><span class="settings-row-label">Capability</span><span class="settings-field-control settings-range"><input type="range" min="0" max="5" step="1" @bind="connection.Capability" @bind:event="oninput" /><output title="@ControlHints.GetHint("settings.connection.capability")">@RatingLabel(connection.Capability, Capabilities)</output></span></label>
                                            <label @attributes="@(ControlHints.Attributes("settings.connection.good_for"))" class="settings-row settings-field"><span class="settings-row-label">Good for</span><InputText autocomplete="off" @bind-Value="connection.GoodFor" placeholder="Vision, long context, local" /></label>
                                        </details>
                                        <details class="settings-disclosure">
                                            <summary class="settings-row">
                                                <span class="settings-row-text"><span class="settings-row-label">Context limits</span><span class="settings-row-hint">Empty fields use the model's defaults</span></span>
                                                <span class="settings-row-value" title="@($"Context window: {limits.ContextWindowTokens} tokens ({SourceLabel(limits.ContextWindowSource)}). Reserved output: {limits.ReservedOutputTokens} tokens ({SourceLabel(limits.ReservedOutputSource)})")">@FormatTokens(limits.ContextWindowTokens) / @FormatTokens(limits.ReservedOutputTokens)</span>
                                                <AppIcon Name="chevron-right" Class="settings-disclosure-chevron" />
                                            </summary>
                                            <label @attributes="@(ControlHints.Attributes("settings.connection.context_window"))" class="settings-row settings-field"><span class="settings-row-text"><span class="settings-row-label">Context window</span><span class="settings-row-hint">@limits.ContextWindowTokens tokens, @SourceLabel(limits.ContextWindowSource)</span></span><input type="number" min="1024" max="4000000" step="1" title="@ControlHints.GetHint("settings.connection.context_window")" placeholder="@limits.ContextWindowTokens" @bind="connection.ContextWindowTokens" /></label>
                                            <label @attributes="@(ControlHints.Attributes("settings.connection.reserved_output"))" class="settings-row settings-field"><span class="settings-row-text"><span class="settings-row-label">Reserved output</span><span class="settings-row-hint">@limits.ReservedOutputTokens tokens, @SourceLabel(limits.ReservedOutputSource)</span></span><input type="number" min="256" max="1000000" step="1" title="@ControlHints.GetHint("settings.connection.reserved_output")" placeholder="@limits.ReservedOutputTokens" @bind="connection.ReservedOutputTokens" /></label>
                                        </details>
                                        <details class="settings-disclosure">
                                            <summary class="settings-row">
                                                <span class="settings-row-text"><span class="settings-row-label">Prices</span><span class="settings-row-hint">Per million tokens, for endpoints that do not price requests</span></span>
                                                <span class="settings-row-value">@PriceSummary(connection)</span>
                                                <AppIcon Name="chevron-right" Class="settings-disclosure-chevron" />
                                            </summary>
                                            <label @attributes="@(ControlHints.Attributes("settings.connection.input_price"))" class="settings-row settings-field"><span class="settings-row-label">Input</span><input type="number" min="0" max="10000" step="0.01" title="@ControlHints.GetHint("settings.connection.input_price")" @bind="connection.InputPrice" /></label>
                                            <label @attributes="@(ControlHints.Attributes("settings.connection.output_price"))" class="settings-row settings-field"><span class="settings-row-label">Output</span><input type="number" min="0" max="10000" step="0.01" title="@ControlHints.GetHint("settings.connection.output_price")" @bind="connection.OutputPrice" /></label>
                                            <label @attributes="@(ControlHints.Attributes("settings.connection.cached_price"))" class="settings-row settings-field"><span class="settings-row-text"><span class="settings-row-label">Cached input</span><span class="settings-row-hint">@ControlHints.GetSummary("settings.connection.cached_price")</span></span><input type="number" min="0" max="10000" step="0.01" title="@ControlHints.GetHint("settings.connection.cached_price")" @bind="connection.CachedInputPrice" /></label>
                                        </details>
                                    </div>
                                </section>
                            </form>
                        }
                    </div>
                    break;
                }
                default:
                {
                    <div class="global-editor-layout">
                        <div class="settings-list-column">
                            <SettingsFilterField @bind-Value="_mcpFilter" Placeholder="Filter servers and tools" Shown="@ShownMcpServers.Count" Total="@_globalMcpServers.Count" Hotkey="@(_mcpTab != McpTab.Tools || GetSelectedMcpServer() is null)" Submitted="() => SelectFirst(ShownMcpServers.Select(item => item.Id), SelectFilteredMcpServer)" />
                            <nav class="settings-list">@if (_globalMcpServers.Count > 0 && ShownMcpServers.Count == 0) { <p class="empty-hint">No servers or tools match “@_mcpFilter.Trim()”.</p> }@foreach (var serverItem in ShownMcpServers) { <div class="settings-list-item @(serverItem.Id == _selectedMcpServerId ? "selected" : string.Empty)"><button class="settings-list-select" type="button" @onclick="() => SelectFilteredMcpServer(serverItem.Id)"><span><SettingsFilterText Text="@serverItem.Name" Query="@_mcpFilter" /></span><small>@if (MatchingToolCount(serverItem) is > 0 and var toolMatches) { <span class="settings-filter-tools">@Plural(toolMatches, "matching tool")</span> } else { <SettingsFilterText Text="@McpServerStatus(serverItem)" Query="@_mcpFilter" /> }</small></button>@if (serverItem.Id == _selectedMcpServerId && !IsHostProvided(serverItem.Id)) { <span class="settings-item-actions"><button class="icon-action settings-item-copy" type="button" title="Copy as JSON (without secrets)" aria-label="Copy MCP server as JSON" @onclick="() => CopyMcpServerAsync(serverItem)"><AppIcon Name="copy" /></button>@if (serverItem.Id != CSharpMcpServer.Id) { <button class="icon-action settings-item-remove" type="button" title="Remove MCP server" aria-label="Remove MCP server" @onclick="RemoveGlobalMcpServer"><AppIcon Name="trash" /></button> }</span> }</div> }</nav>
                            <button class="icon-action settings-list-add" type="button" title="Add MCP server" aria-label="Add MCP server" @onclick="AddGlobalMcpServer"><AppIcon Name="plus" /></button>
                        </div>
                        @if (GetSelectedMcpServer() is { } server)
                        {
                            var hostProvided = IsHostProvided(server.Id);
                            var tools = _toolPolicies.Where(item => item.ServerId == server.Id).ToList();
                            <form class="global-form settings-form" autocomplete="off" @onsubmit:preventDefault="true">
                                @* The tool list can run to dozens of rows, so it gets a page of its own
                                   rather than burying the server's few fields under it. *@
