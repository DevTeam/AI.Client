    private bool _discoveringTools;

    private async Task DiscoverToolsAsync()
    {
        if (_discoveringTools || GetSelectedMcpServer() is not { } server) return;
        var request = new DiscoverMcpToolsRequest(server.ToSettings(), server.Secret);
        _discoveringTools = true;
        try
        {
            var tools = await GlobalSettingsApi.DiscoverMcpToolsAsync(request, CancellationToken.None);
            var identities = tools.Select(tool => (tool.Name, tool.SchemaHash)).ToHashSet();
            _toolPolicies.RemoveAll(item => item.ServerId == server.Id && !identities.Contains((item.Name, item.SchemaHash)));
            foreach (var tool in tools)
            {
                var previous = _toolPolicies.SingleOrDefault(item => item.ServerId == tool.ServerId
                    && item.Name == tool.Name && item.SchemaHash == tool.SchemaHash);
                _toolPolicies.RemoveAll(item => item.ServerId == tool.ServerId && item.Name == tool.Name);
                _toolPolicies.Add(previous ?? McpToolPolicyEditor.From(tool));
            }
            if (tools.Count == 0) Notifications.ShowInfo("No tools were found.");
            else Notifications.ShowSuccess($"Discovered {tools.Count} tool(s).");
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            Notifications.ShowError($"Could not discover tools for {server.Name}: {error.Message}");
        }
        finally { _discoveringTools = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _transferModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/settingsTransfer.js");
            _transferReference = DotNetObjectReference.Create(this);
            _transferSubscription = await _transferModule.InvokeAsync<IJSObjectReference>("watchTransfer", _drawer, _transferReference);
        }
        catch (JSException)
        {
            // The drawer closed before the module loaded; the buttons still work without it.
        }
        catch (JSDisconnectedException)
        {
            // The page is going away.
        }
    }

