    private readonly record struct TurnState(string Kind, string Icon, string Text, bool CanResume, bool CanRebase);

    /// <summary>
    /// Why the turn at the head of this branch's queue stopped, or null when there is nothing to
    /// answer for. A generating run is deliberately not one of these: the composer already shows
    /// its elapsed time and its Stop button, and repeating them here said nothing new. Only a
    /// command that already reached the transcript gets a status - a message still waiting its
    /// turn is a queue row, not a state.
    /// </summary>
    private TurnState? GetTurnState()
    {
        if (SelectedRun is not { } run) return null;
        var committed = run.ActiveMessageId is not null
            || run.Queue.Any(item => item.Stage == QueuedMessageStage.UserCommitted);
        // A failure always gets a chip, committed command or not: its text is the only place the
        // reason is shown now that the composer line no longer repeats it.
        if (!committed && run.Status != ChatRunStatus.Failed) return null;
        var canResume = run.RecoveryActions?.Any(action => action is RunRecoveryAction.Retry or RunRecoveryAction.Resume) == true;
        var canRebase = run.RecoveryActions?.Contains(RunRecoveryAction.Rebase) == true;
        return run.Status switch
        {
            ChatRunStatus.Failed => new TurnState("failed", "error", $"Failed: {run.Error}", canResume, canRebase),
            ChatRunStatus.Interrupted => new TurnState("stopped", "interrupted", "Interrupted before it finished", canResume, canRebase),
            ChatRunStatus.Paused => new TurnState("stopped", "interrupted", "Stopped before it finished", canResume, canRebase),
            _ => null
        };
    }

    private ElementReference _historyMarkers;
