    private Guid? _fileLinkScope;
    private DotNetObjectReference<MessageFeed>? _selfReference;
    // Mirrors the JS side's "the user is at the bottom" state, which is the only thing that
    // decides whether new content scrolls the feed. Starts true: an empty feed is at its bottom.
    private bool _pinned = true;
    // Something arrived below the viewport while the user was reading further up. Cleared as soon
    // as they are back at the bottom, by whatever means.
    private bool _newBelow;
    private Guid? _scrollResetChatId;
    private Guid? _scrollResetTranscriptId;
    private int _historyMarkerCount = -1;
    private string? _historyMarkerScrollKey;
    private bool _disposed;

    // Everything above is set by Home on every one of its renders (i.e. on every composer
    // keystroke), since Blazor always calls SetParametersAsync on a child regardless of whether
    // the values actually changed. ShouldRender is what turns "parameters were reassigned" into
    // "parameters actually changed" — without it, this component would rebuild and diff its own
    // render tree (the whole message list) just as often as before the split.
    private ChatDetails? _renderedSelectedChat;
    private Guid? _renderedTranscriptId;
    private Guid? _renderedBranchLeafId;
    private Guid? _renderedJustArrivedLeafId;
    private Guid? _renderedForkSourceId;
    private Guid? _renderedMessageBranchMenuId;
    private ChatRunSnapshot? _renderedSelectedRun;
    private ChatTokenUsage? _renderedChatUsage;
    private bool _renderedShowTurnTokens;
    private HistoryCheckpoint? _renderedActiveCheckpoint;
    private (ChatTokenUsage? ChatUsage, bool ShowTurnTokens, HistoryCheckpoint? ActiveCheckpoint, TurnTokenUsage? TurnUsage) _usageState;
    private int _usageVersion;
    private TimeSpan? _renderedGeneratingElapsed;
    private int _renderedTranscriptRunPresentationVersion;
    private int _renderedReviewVersion;
    private int _renderedExpandedTurnsVersion;
    private bool _renderedHasSelectedProject;
    private string? _renderedSelectedProjectName;
    private Guid? _renderedSelectedProjectId;
    private bool _renderedHasProjectDirectories;
    private bool _renderedIsComposerEmpty;
    private bool _renderedPinned = true;
    private string? _renderedSearchQuery;
    private bool _renderedNewBelow;
    private int _renderedLiveTextTick;
    private int _renderedLiveNoteCount;

    protected override bool ShouldRender()
    {
        var changed = !ReferenceEquals(_renderedSelectedChat, SelectedChat)
            || _renderedTranscriptId != TranscriptId
            || _renderedBranchLeafId != BranchLeafId
            || _renderedJustArrivedLeafId != JustArrivedLeafId
            || _renderedForkSourceId != ForkSourceId
            || _renderedMessageBranchMenuId != MessageBranchMenuId
            || !ReferenceEquals(_renderedSelectedRun, SelectedRun)
            || !ReferenceEquals(_renderedChatUsage, ChatUsage)
            || _renderedShowTurnTokens != ShowTurnTokens
            || !ReferenceEquals(_renderedActiveCheckpoint, ActiveCheckpoint)
            || _renderedGeneratingElapsed != GeneratingElapsed
            || _renderedTranscriptRunPresentationVersion != TranscriptRunPresentationVersion
            || _renderedReviewVersion != ReviewVersion
            || _renderedExpandedTurnsVersion != _expandedTurnsVersion
            || _renderedHasSelectedProject != HasSelectedProject
            || _renderedSelectedProjectName != SelectedProjectName
            // The tips exist only while no chat is open, so a chat's feed never re-renders for them.
            || SelectedChat is null
                && (_renderedSelectedProjectId != SelectedProjectId
                    || _renderedHasProjectDirectories != HasProjectDirectories
                    || _renderedIsComposerEmpty != IsComposerEmpty)
            || !string.Equals(_renderedSearchQuery ?? string.Empty, SearchQuery ?? string.Empty, StringComparison.Ordinal)
            // The jump affordance lives entirely in this component's own state, and ShouldRender
            // is what decides whether its StateHasChanged reaches the DOM at all.
            || _renderedPinned != _pinned
            || _renderedNewBelow != _newBelow
            || _renderedLiveTextTick != _liveTextTick
            || _renderedLiveNoteCount != LiveNoteCount;

        _renderedSelectedChat = SelectedChat;
        _renderedTranscriptId = TranscriptId;
        _renderedBranchLeafId = BranchLeafId;
        _renderedJustArrivedLeafId = JustArrivedLeafId;
        _renderedForkSourceId = ForkSourceId;
        _renderedMessageBranchMenuId = MessageBranchMenuId;
        _renderedSelectedRun = SelectedRun;
        _renderedChatUsage = ChatUsage;
        _renderedShowTurnTokens = ShowTurnTokens;
        _renderedActiveCheckpoint = ActiveCheckpoint;
        _renderedGeneratingElapsed = GeneratingElapsed;
        _renderedTranscriptRunPresentationVersion = TranscriptRunPresentationVersion;
        _renderedReviewVersion = ReviewVersion;
        _renderedExpandedTurnsVersion = _expandedTurnsVersion;
        _renderedHasSelectedProject = HasSelectedProject;
        _renderedSelectedProjectName = SelectedProjectName;
        _renderedSelectedProjectId = SelectedProjectId;
        _renderedHasProjectDirectories = HasProjectDirectories;
        _renderedIsComposerEmpty = IsComposerEmpty;
        _renderedSearchQuery = SearchQuery;
        _renderedPinned = _pinned;
        _renderedNewBelow = _newBelow;
        _renderedLiveTextTick = _liveTextTick;
        _renderedLiveNoteCount = LiveNoteCount;

        return changed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            try
            {
                _historyMarkersModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/historyMarkers.js");
                _scrollModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/chatComposer.js");
                _messageScrollModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/messageScroll.js");
                _mermaidBlocksModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/mermaidBlocks.js");
                _svgBlocksModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/svgBlocks.js");
                _codeHighlightModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/codeHighlight.js");
                _fileLinksModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/fileLinks.js");
                // The scroller element is part of this component's fixed markup, so it outlives
                // every chat switch — one attach for the lifetime of the feed.
                _selfReference = DotNetObjectReference.Create(this);
                _messageScrollHandle = await _messageScrollModule.InvokeAsync<IJSObjectReference>("attach", _messagesContainer, _selfReference);
                // Same lifetime as the scroller. attach() runs the first render pass for any
                // fences already in the feed so opening a long transcript after a reload still
                // shows diagrams without requiring the user to scroll to the bottom.
                _mermaidBlocksHandle = await _mermaidBlocksModule.InvokeAsync<IJSObjectReference>("attach", _messagesContainer);
                _svgBlocksHandle = await _svgBlocksModule.InvokeAsync<IJSObjectReference>("attach", _messagesContainer);
                _codeHighlightHandle = await _codeHighlightModule.InvokeAsync<IJSObjectReference>("attach", _messagesContainer);
                _fileLinksHandle = await _fileLinksModule.InvokeAsync<IJSObjectReference>("attach", _messagesContainer, _selfReference);
            }
            catch (Exception error) when (error is JSException or ObjectDisposedException)
            {
                _historyMarkersModule = null;
                _mermaidBlocksModule = null;
                _svgBlocksModule = null;
                _codeHighlightModule = null;
                _fileLinksModule = null;
            }
        }

        await SyncFileLinkScopeAsync();
        await SyncCurrentTurnSummaryVisibilityAsync();

        if (await AdvanceTurnExpansionAsync()) return;

        // Highlight before the deferred scroll: a search result scrolls to its occurrence, which
        // exists only once the transcript has been walked for it.
        await ApplySearchHighlightAsync();
        await ApplyDeferredScrollAsync();
        await SyncHistoryMarkersAsync();
    }

    private string? _watchedTurnSummaryElementId;

    private async Task SyncCurrentTurnSummaryVisibilityAsync()
    {
        if (_messageScrollHandle is not { } handle) return;
        var elementId = GetCurrentTurnSummaryElementId();
        if (_watchedTurnSummaryElementId == elementId) return;
        _watchedTurnSummaryElementId = elementId;
        try { await handle.InvokeVoidAsync("watchElementVisibility", elementId); }
        catch (Exception error) when (error is JSException or ObjectDisposedException) { }
    }

    private string? GetCurrentTurnSummaryElementId()
    {
        if (SelectedRun is not { Status: ChatRunStatus.Generating } run) return null;
        var activeMessageId = run.ActiveMessageId
            ?? run.Queue.FirstOrDefault(item => item.Stage == QueuedMessageStage.UserCommitted)?.Id;
        return activeMessageId is { } id ? $"turn-summary-{id}" : null;
    }

    [JSInvokable]
    public Task OnTurnSummaryVisibilityChanged(bool visible) =>
        OnCurrentTurnSummaryVisibilityChanged.InvokeAsync(visible);

    /// <summary>
    /// A click on an "@" link to a chat, a review or captured changes in a user message: it opens
    /// what it names. Files and directories are ordinary local-path links and never get here.
    /// </summary>
    [JSInvokable]
    public Task OnMentionLinkClicked(string resourceId)
    {
        if (!Guid.TryParse(resourceId, out var id) || SelectedChat is null) return Task.CompletedTask;
        var reference = SelectedChat.Messages.SelectMany(item => item.Resources ?? []).FirstOrDefault(item => item.Id == id);
        switch (reference)
        {
            case { Kind: ChatResourceKind.Chat } when Guid.TryParse(reference.Path, out var chatId):
                return OnOpenChat.InvokeAsync(chatId);
            case { Kind: ChatResourceKind.Review }:
                return OnOpenReview.InvokeAsync(reference);
            case { Kind: ChatResourceKind.Diff }:
                ToggleSnapshot(reference.Id);
                break;
        }
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnAppNavigationLinkClicked(string href) => OnNavigateApp.InvokeAsync(href);

    /// <summary>The "@diff" references whose captured changes are open under their message.</summary>
    private readonly HashSet<Guid> _shownSnapshots = [];

    private void ToggleSnapshot(Guid resourceId)
    {
        if (!_shownSnapshots.Add(resourceId)) _shownSnapshots.Remove(resourceId);
        // The transcript boundary lets a render through only when a version it watches moves.
        _expandedTurnsVersion++;
        StateHasChanged();
    }

    private string MessageMarkdown(ChatMessageView message) =>
        message.Role == "User" ? MentionLinks.Link(message.Content, message.Resources) : message.Content;

