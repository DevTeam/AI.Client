    // token Blazor diffs into the feed produces DOM mutations, and that is exactly when a newly
    // completed ```mermaid block needs to be drawn. The handle owns a MutationObserver and a
    // microtask-batched render loop; disposing it on chat switch (or on component teardown)
    // stops the loop without leaving a dangling observer against a detached subtree.
    private IJSObjectReference? _mermaidBlocksModule;
    private IJSObjectReference? _mermaidBlocksHandle;
    private IJSObjectReference? _svgBlocksModule;
    private IJSObjectReference? _svgBlocksHandle;
