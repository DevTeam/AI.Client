@inject AI.Web.Navigation.IAppControlHints ControlHints
@* Split out of Home.razor so that typing in the composer doesn't re-render the whole message
   list: Blazor only re-renders a child component if ShouldRender() says so, so this component
   can be skipped entirely on renders where none of its parameters actually changed (see
   ShouldRender below). Without this boundary, every keystroke in the composer (which lives in
   Home and calls StateHasChanged on the whole page) also rebuilt and diffed this list. *@
@inject IMarkdownRenderer MarkdownRenderer
@inject AI.Web.Resources.IMentionLinkWriter MentionLinks
@inject AI.Web.Resources.IResourcePresenter ResourcePresenter
@inject IChatFeedProjection Feed
@inject IJSRuntime JsRuntime
@inject IChatRunsApi RunsApi
@inject IChatHistoryApi ChatHistoryApi
@inject IRunStatusPresentation StatusPresentation
@inject ITurnLiveText LiveText
@inject IToolPresentations Presentations
@inject IApiBaseUrl ApiBaseUrl
@inject IUsagePresentation Usage
@inject AI.Web.Chats.IChatScheduleApi ScheduleApi
@inject AI.Contracts.Schedules.IScheduleCalendar ScheduleCalendar
@implements IAsyncDisposable
@using AI.Contracts.Tools
@using AI.Contracts.Resources
@using AI.Contracts.Workspace

<div class="messages-area">
@if (SelectedChat is not null)
{
    <nav class="history-markers" aria-hidden="true" @ref="_historyMarkers">
        <TranscriptRenderBoundary ChatId="@SelectedChat.Id"
                                  ChatRevision="@SelectedChat.Revision"
                                  BranchLeafId="@BranchLeafId"
                                  ForkSourceId="@ForkSourceId"
                                  BranchMenuId="@MessageBranchMenuId"
                                  RunPresentationVersion="@TranscriptRunPresentationVersion">
        @{
            var forkPoints = GetForkPointIds();
            var historyEntries = BuildHistoryEntries(GetVisibleBranchMessages(), forkPoints);
        }
        @for (var index = 0; index < historyEntries.Count; index++)
        {
            var entry = historyEntries[index];
            var isLast = index == historyEntries.Count - 1 && SelectedRun is not { Status: ChatRunStatus.Generating };
            <button class="history-marker @GetHistoryMarkerClass(entry, isLast)" type="button" tabindex="-1"
                    data-target="message-@entry.Question.Id"
                    data-question-target="message-@entry.Question.Id"
                    data-answer-target="@(entry.Answer is { } answer ? $"message-{answer.Id}" : string.Empty)"
                    data-fork="@(entry.HasFork ? "true" : string.Empty)"
                    data-created="@entry.Question.CreatedAt.ToString("o")"></button>
        }
        @if (SelectedRun is { Status: ChatRunStatus.Generating })
        {
            <button class="history-marker history-marker-assistant history-marker-generating" type="button" tabindex="-1" data-target="@GetGeneratingMarkerTarget()" data-question-text="Generating…" data-fork=""></button>
        }
        </TranscriptRenderBoundary>
    </nav>
    <div class="history-marker-tip" role="tooltip" aria-hidden="true"></div>
    <div class="history-scroll-hint history-scroll-hint-up" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 14 5-5 5 5" /></svg></div>
    <div class="history-scroll-hint history-scroll-hint-down" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 10 5 5 5-5" /></svg></div>
}
<div class="workspace-messages" @ref="_messagesContainer">
    @if (!HasSelectedProject)
    {
        @* Laid out like a new chat's screen: the same banner and the same cards, here for what
           comes before the first chat. *@
        <div class="workspace-empty workspace-empty-start">
            <h2>Select a project</h2>
            <p>Choose a project on the left or create a new one.</p>
            <GuideBanner HasModel="@HasModel" OnStartGuide="@OnStartGuide" />
            <section class="chat-tips" aria-label="Before the first chat">
                <div class="chat-tips-grid">
                    <article class="chat-tip">
                        <div class="chat-tip-head"><AppIcon Name="project" /><span class="chat-tip-title">Projects</span></div>
                        <p class="chat-tip-text">A project holds chats together with folder access, memory, skills and tool permissions.</p>
                        <p class="chat-tip-actions"><button type="button" class="chat-tip-action is-primary" @onclick="OnCreateProject"><AppIcon Name="plus" />New project</button></p>
                    </article>
                    <article class="chat-tip">
                        <div class="chat-tip-head"><AppIcon Name="connection" /><span class="chat-tip-title">Model connections</span></div>
                        <p class="chat-tip-text">Each connection is an OpenAI-compatible endpoint with its key and model. The default one answers new chats.</p>
                        <p class="chat-tip-actions"><button type="button" class="chat-tip-action" @onclick='() => OnOpenSettings.InvokeAsync("Connections")'>Connections</button></p>
                    </article>
                    <article class="chat-tip">
                        <div class="chat-tip-head"><AppIcon Name="settings" /><span class="chat-tip-title">Settings</span></div>
                        <p class="chat-tip-text">Theme and corners, sounds, chat helpers such as reply suggestions, and how often the guide is offered.</p>
                        <p class="chat-tip-actions"><button type="button" class="chat-tip-action" @onclick='() => OnOpenSettings.InvokeAsync("Settings")'>Settings</button></p>
                    </article>
                </div>
            </section>
        </div>
    }
    else if (SelectedChat is null)
    {
        <div class="workspace-empty workspace-empty-start">
            <h2>Start a conversation</h2>
            <p>Write a message below. A new chat will be created in <button class="workspace-empty-project" type="button" title="Project menu" aria-haspopup="menu" @onclick="args => OnOpenProjectMenu.InvokeAsync(args)">@SelectedProjectName</button>.</p>
            <ChatTips ProjectId="@SelectedProjectId" HasDirectories="@HasProjectDirectories" IsComposerEmpty="@IsComposerEmpty"
                      OnStartGuide="@OnStartGuide" HasModel="@HasModel" OnStartTopic="@OnStartGuideTopic"
                      OnInsertText="OnInsertComposerText" OnOpenProjectMenu="OnOpenProjectMenu"
                      OnAddDirectory="OnAddDirectory" OnCreateSkill="OnCreateSkill" />
        </div>
    }
    else
    {
        // Folded: the fork point is a step of a collapsed turn, so the picker stands in for it
        // under the turn's summary line.
        RenderFragment<(ChatMessageView Message, bool Folded)> renderBranchPicker = picker =>
        @<text>
                @if (HasBranchPicker(picker.Message))
                {
                    var pickerMessage = picker.Message;
                    <div class="message-branch-indicator" @onkeydown="args => OnBranchPickerKeyDown.InvokeAsync(args)">
                        <span class="branch-connector" aria-hidden="true"></span>
                        @if (ForkSourceId == pickerMessage.Id)
                        {
                            <span class="branch-pending" title="@(picker.Folded ? "The branch starts inside this turn and will be created after you send its first message" : "The branch will be created after you send its first message")"><AppIcon Name="git-branch" /><span>New branch</span></span>
                        }
                        else
                        {
                            var options = GetBranchOptions(pickerMessage);
                            <button @attributes="@(ControlHints.Attributes("chat.branches", picker.Folded ? "Branches start inside this turn · expand it to see where" : "Choose branch"))" class="branch-picker-trigger" type="button" aria-label="Choose branch" aria-expanded="@(MessageBranchMenuId == pickerMessage.Id ? "true" : "false")" @onclick="() => OnToggleBranchMenu.InvokeAsync(pickerMessage.Id)"><AppIcon Name="git-branch" /><span>Branch @GetActiveBranchPosition(options) of @options.Count</span></button>
                            @if (MessageBranchMenuId == pickerMessage.Id)
                            {
                                <BranchPickerMenu @key="pickerMessage.Id" Items="@GetBranchPickerItems(options)"
                                                  OnSelect="item => SelectBranchOptionAsync((BranchOption)item.Key)" />
                            }
                        }
                    </div>
                }
            </text>;
        <TranscriptRenderBoundary ChatId="@SelectedChat.Id"
                                  ChatRevision="@SelectedChat.Revision"
                                  BranchLeafId="@BranchLeafId"
                                  JustArrivedLeafId="@JustArrivedLeafId"
                                  ForkSourceId="@ForkSourceId"
                                  BranchMenuId="@MessageBranchMenuId"
                                  RunPresentationVersion="@TranscriptRunPresentationVersion"
                                  ExpandedTurnsVersion="@_expandedTurnsVersion"
                                  ReviewVersion="@ReviewVersion"
                                  TurnElapsedSeconds="@GetGeneratingElapsedSeconds()"
                                  LiveTextVersion="@GetLiveTextInputVersion()"
                                  UsageVersion="@_usageVersion">
        @{ var modelSwitches = Feed.BuildModelSwitches(GetVisibleBranchMessages(), ChatUsage?.Turns ?? [], SelectedRun?.TurnUsage); }
        @foreach (var feedTurn in GetRenderedFeedTurns())
        {
            var turnModelSwitches = feedTurn.Key is Guid modelTurnId ? modelSwitches.GetValueOrDefault(modelTurnId) : null;
            <TranscriptTurnBoundary @key="feedTurn.Key" Stamp="@GetTurnStamp(feedTurn, turnModelSwitches)" Messages="@feedTurn.Messages">
            @foreach (var entry in feedTurn.Entries)
            {
                var item = entry.Item;
                @if (entry.Summary is { } summary)
                {
                    var turnId = summary.Id!.Value;
                    var expanded = IsTurnExpanded(summary);
                    var canExpand = CanExpandTurn(summary);
                    var summaryKey = (turnId, "turn-summary");
                    var usageKey = (turnId, "turn-usage");
                    RenderFragment summaryContent = @<text>
                        @if (_loadingTurnIds.Contains(turnId))
                        {
                            <span class="turn-summary-spinner" aria-hidden="true"><AppIcon Name="spinner" Class="tool-row-spinner" /></span>
                        }
                        <span class="turn-summary-text">@(_loadingTurnIds.Contains(turnId) ? "Loading details…" : GetTurnSummaryText(summary))</span>
                        @* Only a finished turn says what it used: a figure ticking up beside the timer
                           would pull the eye away from the answer being written under it. *@
                        @if (ShowTurnTokens && !IsRunningTurn(summary) && GetTurnUsage(turnId) is { } turnUsage)
                        {
                            <span class="turn-summary-tokens" title="Input → output tokens">· @Usage.FormatFlow(turnUsage.Totals)</span>
                        }
                        @if (canExpand)
                        {
                            <span class="turn-summary-chevron" aria-hidden="true"><AppIcon Name="chevron-right" /></span>
                        }
                        @* The running turn's file changes, in the one line of the turn that never moves.
                           The full card is docked above the composer; under the live text it was pushed
                           up and down by every note that replaced the last. *@
                        @if (IsRunningTurn(summary) && GetLiveChanges() is { } summaryChanges)
                        {
                            <span class="turn-summary-changes" title="Files changed so far · the list is above the composer"
                                  aria-label="@summaryChanges.Files.Count @(summaryChanges.Files.Count == 1 ? "file" : "files") changed, @summaryChanges.Additions additions, @summaryChanges.Deletions deletions">
                                <AppIcon Name="diff" />
                                <span class="turn-summary-changes-files">@summaryChanges.Files.Count @(summaryChanges.Files.Count == 1 ? "file" : "files")</span>
                                <span class="workspace-added">+@summaryChanges.Additions</span>
                                <span class="workspace-removed">−@summaryChanges.Deletions</span>
                            </span>
                        }
                    </text>;
                    @if (canExpand)
                    {
                        <button @key="summaryKey" id="turn-summary-@turnId" type="button"
                                class="turn-summary @(expanded ? "is-expanded" : string.Empty) @GetTurnSummaryStateClasses(summary)"
                                aria-expanded="@(expanded ? "true" : "false")"
                                @onclick="() => ToggleTurnAsync(turnId)">
                            @summaryContent
                        </button>
                    }
                    else
                    {
                        <div @key="summaryKey" id="turn-summary-@turnId"
                             class="turn-summary is-static @GetTurnSummaryStateClasses(summary)">
                            @summaryContent
                        </div>
                    }
                    @if (expanded && GetTurnUsage(turnId) is { } expandedUsage)
                    {
                        <TurnUsageDetails @key="usageKey" Turn="@expandedUsage" />
                    }
                    @* A branch leaving a folded step would vanish with it. Its picker stands in under
                       the summary line, which is where the lines part: on the branch that left, the
                       step is the last of the turn. Expanding puts it back under its own step. *@
                    @if (!expanded && summary.IntermediateMessages.Where(HasBranchPicker).ToArray() is { Length: > 0 } foldedForks)
                    {
                        var forksKey = (turnId, "turn-forks");
                        <div @key="forksKey" class="turn-forks">
                            @foreach (var fork in foldedForks)
                            {
                                @renderBranchPicker((fork, true))
                            }
                        </div>
                    }
                }
                else if (entry.ChangesMessage is { WorkspaceChanges: { IsEmpty: false } collapsedChanges })
                {
                    var changesKey = (entry.ChangesMessage.Id, "workspace-changes-collapsed");
                    <WorkspaceChanges @key="changesKey" Changes="@collapsedChanges" SourceMessageId="@entry.ChangesMessage.Id"
                                      ExpandUpward="true"
                                      ProjectId="@SelectedChat.ProjectId" ChatId="@SelectedChat.Id"
                                      Review="@(DiffReviews?.GetValueOrDefault(entry.ChangesMessage.Id))"
                                      OnReview="OnReviewChanges" OnReviewChanged="OnDiffReviewChanged" />
                }
                else if (entry.ActiveTools is { Count: > 0 } activeTools)
                {
                    var activeToolsKey = (entry.TurnId, "active-tools");
                    @* The assistant/tool-call message can trail the run snapshot by one event. Use
                       the same component and visual position meanwhile; once persistence catches up,
                       the matching call moves into the durable group instead of changing UI shape. *@
                    <article @key="activeToolsKey" class="workspace-message tool-group" role="status" aria-live="polite">
                        <ToolActivityGroup Group="@(Array.Empty<ChatMessageView>())" ActiveTools="activeTools"
                                           ProjectId="@SelectedChat.ProjectId" OnOpenAsset="OnOpenAsset" IsLive="true" />
                    </article>
                }
                else if (entry.CollapseTurnId is { } collapseTurnId)
                {
                    var collapseKey = (collapseTurnId, "turn-collapse");
                    <button @key="collapseKey"
                            id="turn-collapse-@collapseTurnId"
                            class="turn-collapse-footer"
                            type="button"
                            title="Collapse the intermediate steps of this turn"
                            @onclick="() => CollapseTurnFromEndAsync(collapseTurnId)">
                        <AppIcon Name="chevron-up" /><span>Hide steps</span>
                    </button>
                }
                else if (entry.LiveText is { } liveText)
                {
                    @* What the running turn is saying right now, in full, under the few notes before
                       it. Keyed by the note, not the turn: a new note mounts a fresh element, which
                       is what plays the entry animation, while growth of the same text only patches
                       it, and a note that ages or is pushed out keeps its element, so the class
                       change is what fades it and folds it away. *@
                    var liveKey = (entry.TurnId, "live-text", entry.LiveVersion);
                    var current = entry.LiveAge == 0 && !entry.LiveLeaving;
                    <article @key="liveKey" id="@(current ? "message-live" : null)"
                             class="workspace-message assistant live-text streaming @(entry.LivePreamble ? "is-preamble" : string.Empty) @(entry.LiveAge switch { 0 => string.Empty, 1 => "is-previous", _ => "is-older" }) @(entry.LiveLeaving ? "is-leaving" : string.Empty)"
                             aria-hidden="@(entry.LiveLeaving ? "true" : null)"
                             @onmouseenter="() => SetLiveTextHeld(true)"
                             @onmouseleave="() => SetLiveTextHeld(false)">
                        <div class="live-text-body">
                            <StreamingMarkdown Html="@RenderLiveMarkdown(liveText)" />
                        </div>
                    </article>
                }
                else if (entry.Activity is { } activity)
                {
                    @* Keep the activity slot's height stable while showing only concrete actions. *@
                    var activityKey = (entry.TurnId, "turn-activity");
                    var idle = ReferenceEquals(activity, TurnActivity.None);
                    <div @key="activityKey" class="turn-activity"
                         role="@(idle ? null : "status")" aria-hidden="@(idle ? "true" : null)">
                        @if (!idle)
                        {
                            <span class="turn-activity-title">@activity.Title</span>
                        }
                        @if (activity.Detail is { Length: > 0 } activityDetail)
                        {
                            <span class="turn-activity-detail" title="@activityDetail">@activityDetail</span>
                        }
                    </div>
                }
                else if (entry.StreamingRun is { } streamingRun)
                {
                    @* StreamingContent contains publishable final text only. Provisional model prose
                       remains inside the agent until it either becomes durable tool intent or is
                       accepted through the completion protocol. *@
                    <article id="message-streaming" class="workspace-message assistant @(streamingRun.Status == ChatRunStatus.Generating ? "streaming" : string.Empty)">
                        @if (streamingRun.Status != ChatRunStatus.Generating) { <span class="message-status">Incomplete</span> }
                        <StreamingMarkdown Html="@RenderLiveMarkdown(streamingRun.StreamingContent)" />
                    </article>
                }
                else if (item?.Message is { } message)
                {
                    @if (message.Role == "User" && turnModelSwitches is not null)
                    {
                        @foreach (var change in turnModelSwitches)
                        {
                            <div class="history-checkpoint-mark model-switch-mark" role="note">
                                <div class="history-checkpoint-line">
                                    <span class="history-checkpoint-rule" aria-hidden="true"></span>
                                    <span class="history-checkpoint-label"><AppIcon Name="sparkles" />Model switched · @change.PreviousModel → @change.Model</span>
                                    <span class="history-checkpoint-rule" aria-hidden="true"></span>
                                </div>
                            </div>
                        }
                    }
                    @if (ActiveCheckpoint is { } activeCheckpoint && message.Role == "User" && message.ParentId == activeCheckpoint.UpToMessageId)
                    {
                        <HistoryCheckpointMark @key="activeCheckpoint.Id" Checkpoint="@activeCheckpoint" OnUndo="OnUndoCheckpoint" />
                    }
                    <article @key="message.Id" id="message-@message.Id"
                             class="workspace-message @message.Role.ToLowerInvariant() @(message.Role == "User" && string.IsNullOrWhiteSpace(message.Content) ? "resource-only" : string.Empty) @(message.Sender is null ? string.Empty : "from-branch") @(message.Delivery != MessageDelivery.Turn ? "is-aside" : string.Empty) @(entry.RevealIndex is null ? string.Empty : "turn-message-arriving") @(message.Id == BranchLeafId ? "branch-leaf" : string.Empty) @(message.Id == JustArrivedLeafId ? "branch-leaf-arrived" : string.Empty) @(message.Id == ForkSourceId ? "fork-source" : string.Empty)"
                             style="@MessageStyle(entry.RevealIndex, message)">
                        <div class="message-body">
                        @if (message.Role == "User" && (message.Sender is not null || message.Delivery != MessageDelivery.Turn))
                        {
                            @* Where the message came from and how it was delivered, when that is anything other
                               than the person starting a turn: docs/34-asides-and-team-messages.md. *@
                            <div class="message-origin" @attributes="@(message.Sender is { } teamSender && SelectedChat.MemberOf(teamSender.BranchId) is not null
                                     ? ControlHints.Attributes("chat.team_message", nativeTooltip: false) : null)">
                                @if (message.Sender is { } sender)
                                {
                                    @if (sender.ChatId == SelectedChat.Id && SelectedChat.Branches?.Any(branch => branch.Id == sender.BranchId) == true)
                                    {
                                        <button class="message-origin-sender" type="button" title="Open the branch that sent it"
                                                @onclick="() => OnOpenSenderBranch.InvokeAsync(sender.BranchId)">@SenderMark(sender)<span>@SelectedChat.SenderName(sender)</span></button>
                                    }
                                    else
                                    {
                                        <span class="message-origin-sender">@SenderMark(sender)<span>@SelectedChat.SenderName(sender)</span></span>
                                    }
                                    @if (sender.Intent is { Length: > 0 } intent)
                                    {
                                        <span class="message-origin-intent @(intent is "question" or "blocker" ? "needs-answer" : intent == "done" ? "is-done" : string.Empty)">@intent</span>
                                    }
                                }
                                @if (message.Delivery == MessageDelivery.InTurn)
                                {
                                    <span class="message-origin-delivery" title="The model read this before its next step, without a new turn">Added during the turn</span>
                                }
                                else if (message.Delivery == MessageDelivery.Aside)
                                {
                                    <span class="message-origin-delivery" title="Added without starting a turn; the next turn reads it">Aside</span>
                                }
                            </div>
                        }
                        @if (message.IsIncomplete) { <span class="message-status">Incomplete</span> }
                        @if (message.Role == "User" && string.IsNullOrWhiteSpace(message.Content)
                            && message.Resources is not { Count: > 0 })
                        {
                            <span class="message-empty-label">Empty message</span>
                        }
                        @* What the "+" menu attached leads the message, as attachments lead a letter: first what
                           to work with, then what to do with it. A reference with an "@" link is drawn in the
                           text instead, where the user wrote it; both are the same pill. The skill the message
                           invoked from the slash list comes first, as it did in the composer: the text after it
                           is what the user asked of the skill. *@
                        @if (message.Resources?.Any(item => item.Kind == ChatResourceKind.Skill || item.Mention is null) == true)
                        {
                            <div class="message-resource-list" aria-label="Attached references">
                                @foreach (var skill in message.Resources.Where(item => item.Kind == ChatResourceKind.Skill))
                                {
                                    <span class="resource-pill" @key="skill.Id">
                                        <a class="resource-pill-target mention-skill" href="@ResourcePresenter.Target(skill)" title="@($"Skill {skill.Path} · click to open")"><span class="resource-pill-label">@(skill.Name ?? skill.Path)</span></a>
                                    </span>
                                }
                                @foreach (var resource in message.Resources.Where(item => item.Kind != ChatResourceKind.Skill && item.Mention is null))
                                {
                                    var kind = $"mention-{resource.Kind.ToString().ToLowerInvariant()}";
                                    <span class="resource-pill" @key="resource.Id">
                                        @if (resource.Kind == ChatResourceKind.File && resource.AssetId is not null)
                                        {
                                            <button class="resource-pill-target @kind @(resource.IsContentSnapshot ? "has-content" : null)" type="button"
                                                    title="@ResourcePresenter.Hint(resource)" @onclick="() => OnOpenAsset.InvokeAsync(resource)">
                                                <span class="resource-pill-label">@ResourceLabel(resource)</span>
                                                @if (ResourcePresenter.Summary(resource) is { } size) { <span class="resource-pill-detail">@size</span> }
                                            </button>
                                        }
                                        else if (resource.Kind is ChatResourceKind.File or ChatResourceKind.Directory)
                                        {
                                            @* A local path like any "@" link: fileLinks.js adds its access, menu and drag. *@
                                            <a class="resource-pill-target mention-link @kind" href="@ResourcePresenter.Target(resource)" title="@ResourcePresenter.Hint(resource)"><span class="resource-pill-label">@ResourceLabel(resource)</span></a>
                                        }
                                        else if (resource.Kind == ChatResourceKind.Image)
                                        {
                                            <button class="resource-pill-target @kind chat-image-link" type="button"
                                                    title="@ResourcePresenter.Hint(resource)" aria-label="@ResourcePresenter.Hint(resource)"
                                                    @onclick="() => OnOpenAsset.InvokeAsync(resource)">
                                                <ChatImageThumbnail ProjectId="SelectedChat.ProjectId" Resource="resource" />
                                            </button>
                                        }
                                        else if (resource.Kind == ChatResourceKind.Review)
                                        {
                                            <button class="resource-pill-target @kind" type="button" title="Open review" @onclick="() => OnOpenReview.InvokeAsync(resource)"><span class="resource-pill-label">@ResourceLabel(resource)</span></button>
                                        }
                                        else if (resource.Kind == ChatResourceKind.Chat && Guid.TryParse(resource.Path, out var referencedChatId))
                                        {
                                            <button class="resource-pill-target @kind" type="button" title="Open chat" @onclick="() => OnOpenChat.InvokeAsync(referencedChatId)"><span class="resource-pill-label">@ResourceLabel(resource)</span></button>
                                        }
                                        else if (resource.Kind == ChatResourceKind.Diff && ResourcePresenter.Changes(resource) is { Changes.IsEmpty: false })
                                        {
                                            <button class="resource-pill-target @kind" type="button" title="@ResourcePresenter.Hint(resource)" aria-expanded="@(_shownSnapshots.Contains(resource.Id) ? "true" : "false")" @onclick="() => ToggleSnapshot(resource.Id)"><span class="resource-pill-label">@ResourceLabel(resource)</span><span class="resource-pill-detail">@ResourcePresenter.Summary(resource)</span></button>
                                        }
                                        else
                                        {
                                            <span class="resource-pill-target @kind" title="@ResourcePresenter.Hint(resource)"><span class="resource-pill-label">@ResourceLabel(resource)</span></span>
                                        }
                                    </span>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(message.Content))
                        {
                            @if (message.Role is "User" or "Assistant" && message.ToolCalls is null)
                            {
                                <MessageReviewText @key="message.Id" ProjectId="SelectedChat.ProjectId" ChatId="SelectedChat.Id"
                                                   MessageId="message.Id" Content="@((MarkupString)RenderMarkdownCached(message.Id, MessageMarkdown(message)))"
                                                   Review="@(MessageReviews?.GetValueOrDefault(message.Id))"
                                                   OnChanged="OnMessageReviewChanged" OnAttach="OnAttachMessageReview" />
                            }
                            else { <div class="markdown-content">@((MarkupString)RenderMarkdownCached(message.Id, message.Content))</div> }
                        }
                        </div>
                        @* Keep every action visible beneath the content. *@
                        <div class="message-actions">
                            @if (!string.IsNullOrWhiteSpace(message.Content))
                            {
                                <button class="icon-action message-copy-action" type="button" title="Copy Markdown" aria-label="Copy Markdown" @onclick="() => OnCopyMessage.InvokeAsync(message.Content)"><AppIcon Name="copy" /><AppIcon Name="check" Class="copied-icon" /></button>
                            }
                            @if (message.Role == "User")
                            {
                                <button class="icon-action" type="button" @attributes="@(ControlHints.Attributes("chat.edit_branch", "Edit and branch"))" aria-label="Edit and branch" @onclick="() => OnEditAndBranch.InvokeAsync(message)"><AppIcon Name="edit" /></button>
                                <button class="icon-action" type="button" @attributes="@(ControlHints.Attributes("chat.fork", GetForkHint(message)))" aria-label="Fork from here" disabled="@IsForkSource(message)" @onclick="() => OnForkFromMessage.InvokeAsync(message)"><AppIcon Name="fork" /></button>
                                <button class="icon-action destructive-action" type="button" title="Edit and replace branch…" aria-label="Edit and replace branch" @onclick="() => OnEditAndReplaceBranch.InvokeAsync(message)"><AppIcon Name="edit-replace" /></button>
                            }
                            else
                            {
                                <button class="icon-action" type="button" @attributes="@(ControlHints.Attributes("chat.fork", GetForkHint(message)))" aria-label="Fork from here" disabled="@IsForkSource(message)" @onclick="() => OnForkFromMessage.InvokeAsync(message)"><AppIcon Name="fork" /></button>
                            }
                        </div>
                        @renderBranchPicker((message, false))
                    </article>
                    @* What a "@diff" captured, shown by a click on its link or its chip. *@
                    @foreach (var diff in (message.Resources ?? []).Where(resource => resource.Kind == ChatResourceKind.Diff && _shownSnapshots.Contains(resource.Id)))
                    {
                        @if (ResourcePresenter.Changes(diff) is { Changes.IsEmpty: false } snapshot)
                        {
                            var snapshotKey = (message.Id, diff.Id);
                            <WorkspaceChanges @key="snapshotKey" Changes="@snapshot.Changes" Label="@ResourcePresenter.Label(diff)" InitiallyExpanded="true"
                                              ProjectId="@SelectedChat.ProjectId" ChatId="@SelectedChat.Id" />
                        }
                    }
                    @if (message.WorkspaceChanges is { IsEmpty: false } messageChanges)
                    {
                        var changesKey = (message.Id, "workspace-changes");
                        <WorkspaceChanges @key="changesKey" Changes="@messageChanges" SourceMessageId="@message.Id"
                                          ExpandUpward="@(!entry.IsExpandedIntermediate)"
                                          ProjectId="@SelectedChat.ProjectId" ChatId="@SelectedChat.Id"
                                          Review="@(DiffReviews?.GetValueOrDefault(message.Id))"
                                          OnReview="OnReviewChanges" OnReviewChanged="OnDiffReviewChanged" />
                    }
                }
                else if (item?.ToolGroup is { } group)
                {
                    var anchor = group[^1];
                    var preamble = Feed.PreambleOf(group);
                    @* One block per cycle: the assistant's explanation, then the tools it announced.
                       They were two articles with a boundary between them, which read as unrelated
                       cards; together they read as intent followed by actions. The preamble needs no
                       id of its own here — the block already has the anchor's.

                       The key is the group's *first* message, not the anchor: a live group grows as
                       each call lands, so keying it by the last one handed Blazor a new identity on
                       every result and threw away ToolActivityGroup's state — an expanded group
                       snapped shut each time a tool reported back. The first message is what opened
                       the group and never changes while it grows. *@
                    <article @key="group[0].Id" id="message-@anchor.Id"
                             class="workspace-message tool-group @(entry.RevealIndex is null ? string.Empty : "turn-message-arriving") @(anchor.Id == BranchLeafId ? "branch-leaf" : string.Empty) @(anchor.Id == JustArrivedLeafId ? "branch-leaf-arrived" : string.Empty) @(anchor.Id == ForkSourceId ? "fork-source" : string.Empty)"
                             style="@(entry.RevealIndex is { } groupRevealIndex ? $"--turn-arrive-delay: {groupRevealIndex * 60}ms" : null)">
                        @if (preamble is not null)
                        {
                            @if (preamble.IsIncomplete) { <span class="message-status">Incomplete</span> }
                            <div class="markdown-content preamble-content">@((MarkupString)RenderMarkdownCached(preamble.Id, preamble.Content))</div>
                        }
                        <ToolActivityGroup Group="group"
                                           ProjectId="@SelectedChat.ProjectId"
                                           OnOpenAsset="OnOpenAsset"
                                           ChatId="@SelectedChat.Id"
                                           ChatRevision="@SelectedChat.Revision"
                                           ActiveTools="@GetActiveToolsForGroup(group)"
                                           IsLive="@(IsBranchGenerating() && anchor.Id == BranchLeafId)" />
                        <div class="message-actions">
                            <button class="icon-action" type="button" title="Copy" aria-label="Copy" @onclick="() => OnCopyMessage.InvokeAsync(BuildToolGroupSummaryText(group))"><AppIcon Name="copy" /></button>
                            <button class="icon-action" type="button" @attributes="@(ControlHints.Attributes("chat.fork", GetForkHint(anchor)))" aria-label="Fork from here" disabled="@IsForkSource(anchor)" @onclick="() => OnForkFromMessage.InvokeAsync(anchor)"><AppIcon Name="fork" /></button>
                        </div>
                        @renderBranchPicker((anchor, false))
                    </article>
                    @if (entry.IsExpandedIntermediate)
                    {
                        @foreach (var checkpoint in Feed.CheckpointsOf(group))
                        {
                            <div @key="checkpoint.CallId" class="context-checkpoint" role="note">
                                <span class="context-checkpoint-mark" aria-hidden="true"><AppIcon Name="check" /></span>
                                <span>Context checkpoint</span>
                                <span class="context-checkpoint-detail">@checkpoint.CoveredMessages earlier messages summarized for this run</span>
                            </div>
                        }
                    }
                }
            }
            </TranscriptTurnBoundary>
        }
        </TranscriptRenderBoundary>
        @* The live cards are appended after the transcript, outside its render boundary. *@
        @* Why the turn stopped, and what can be done about it. Only for a turn that is NOT
           running: while it generates, the composer already says so and already offers Stop, and
           a second copy of both here was pure duplication. *@
        @if (GetTurnState() is { } turn)
        {
            <section class="turn-status chat-card-header turn-status-@turn.Kind" role="status">
                <span class="turn-status-icon chat-card-mark" aria-hidden="true"><AppIcon Name="@turn.Icon" /></span>
                <span class="turn-status-text chat-card-title">@turn.Text</span>
                <span class="chat-card-header-actions turn-status-controls">
                    <button class="icon-action turn-status-copy chat-card-action chat-card-action-icon" type="button" title="Copy error" aria-label="Copy error" @onclick="() => OnCopyMessage.InvokeAsync(turn.Text)"><AppIcon Name="copy" /></button>
                    <span class="turn-status-actions">
                        @if (turn.CanResume)
                        {
                            <button type="button" class="turn-status-action turn-status-primary chat-card-action chat-card-action-primary" title="Run this message again" aria-label="@(turn.Kind == "failed" ? "Retry" : "Continue")" @onclick="() => OnResumeRun.InvokeAsync()"><AppIcon Name="@(turn.Kind == "failed" ? "refresh" : "play")" Class="turn-status-action-icon" /><span class="turn-status-action-label">@(turn.Kind == "failed" ? "Retry" : "Continue")</span></button>
                        }
                        @if (turn.CanRebase)
                        {
                            <button type="button" class="turn-status-action chat-card-action" title="Continue this message from the current branch head" aria-label="From branch head" @onclick="() => OnRebaseRun.InvokeAsync()"><AppIcon Name="fork" Class="turn-status-action-icon" /><span class="turn-status-action-label">From branch head</span></button>
                        }
                        <button type="button" class="turn-status-action destructive-action chat-card-action chat-card-action-danger" title="Drop this message from the queue and let the rest of it continue" aria-label="Discard" @onclick="() => OnDiscardRun.InvokeAsync()"><AppIcon Name="trash" Class="turn-status-action-icon" /><span class="turn-status-action-label">Discard</span></button>
                    </span>
                </span>
            </section>
        }
        @* A question the model asked, in the same place and for the same reason as an approval:
           it is what the person has to do next, so it is what they should end up looking at. *@
        @* A chat that already exists still cannot be answered without a model: the setup row sits
           at the end of it, where the reply would appear. *@
        @if (!HasModel)
        {
            <div class="chat-model-setup"><GuideBanner HasModel="false" SetupOnly="true" OnStartGuide="@OnStartGuide" /></div>
        }
        @if (SelectedRun is { PendingPrompt: { Presentation: "chat" } prompt } promptRun)
        {
            <UserPromptCard Prompt="prompt"
                            OnNavigateApp="@OnNavigateApp"
                            OnAnswer="response => RunsApi.AnswerPromptAsync(promptRun.ProjectId, promptRun.ChatId, promptRun.BranchId, response, CancellationToken.None)" />
        }
    }
</div>
@* Only shown when the feed is NOT following the bottom and there is in fact something down
   there to go to — a new answer, or one being written. A permanent "scroll down" control would
   duplicate the history-marker strip on the left, which already exists to move around the
   transcript; this one exists to say "the thing you were waiting for arrived elsewhere". *@
@if (SelectedChat is not null && !_pinned && (_newBelow || SelectedRun is { Status: ChatRunStatus.Generating }))
{
    @* The label says what is waiting below: a message that arrived, or one still being written. *@
    var writing = !_newBelow;
    <button type="button" class="messages-jump"
            title="Jump to the latest message (End)"
            @onclick="JumpToBottomAsync">
        <AppIcon Name="arrow-down" />
        <span>@(writing ? "Writing…" : "New message")</span>
        @if (SelectedRun is { Status: ChatRunStatus.Generating }) { <span class="messages-jump-dot" aria-hidden="true"></span> }
    </button>
}
</div>

@code {
    // Copy yields the raw calls and results, not the rendered summaries: someone copying tool
    // activity wants the payload to paste into a bug report, not the UI's wording of it. The
    // preamble leads, because the block is one thing on screen and should be one thing on the
    // clipboard.
    private string BuildToolGroupSummaryText(IReadOnlyList<ChatMessageView> group)
    {
        var parts = Feed.BuildInvocations(group).Select(invocation =>
            $"{invocation.Call.Name}({invocation.Call.Arguments})"
            + (invocation.Result is { } result ? $"\n=> {result.Content}" : string.Empty));
        if (Feed.PreambleOf(group) is { } preamble) parts = parts.Prepend(preamble.Content);
        return string.Join("\n\n", parts);
    }

