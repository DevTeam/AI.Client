    private async Task SyncFileLinkScopeAsync()
    {
        var scope = SelectedChat?.ProjectId;
        if (_fileLinksHandle is null || scope == _fileLinkScope) return;
        _fileLinkScope = scope;
        try
        {
            // The module asks the Host itself: a batch of a hundred paths marshalled through .NET
            // and parsed by the WebAssembly runtime blocked the page for about 150 ms, while a
            // browser fetch parses the same answer off the main thread's critical path.
            await _fileLinksHandle.InvokeVoidAsync("setScope", scope?.ToString(),
                scope is { } projectId ? new Uri(ApiBaseUrl.Value, $"api/projects/{projectId}/resources/resolve").ToString() : null);
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
        }
    }

    /// <summary>
    /// Pushes the current SearchQuery to the JS side. Called from OnAfterRenderAsync on every
    /// render that touched the transcript, so a streaming token that diffs in new text also
    /// re-walks it for highlights — the wrappers themselves died with whatever Blazor rebuilt.
    /// The DOM walk is skipped when the query did not change since the last render, which is by
    /// far the common case.
    /// </summary>
    private async Task ApplySearchHighlightAsync()
    {
        if (_disposed || _messageScrollHandle is not { } handle) return;
        var chatId = SelectedChat?.Id;
        var normalized = (SearchQuery ?? string.Empty).Trim();
        if (_appliedSearchChatId == chatId
            && string.Equals(_appliedSearchQuery, normalized, StringComparison.Ordinal)) return;
        // The same chat re-walked (its activity loaded, say) keeps the find bar where it was. Not
        // judged by _appliedSearchChatId: that is cleared on purpose to force such a re-walk.
        var keepPosition = _searchPositionChatId == chatId && chatId is not null;
        _searchPositionChatId = chatId;
        _appliedSearchChatId = chatId;
        _appliedSearchQuery = normalized;
        try
        {
            SetSearchPosition(await handle.InvokeAsync<int[]>("applySearchHighlight", normalized, keepPosition));
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException) { }
    }

    private Task ApplyDeferredScrollAsync() => TryPendingScrollAsync();

    /// <summary>
    /// One attempt at the pending scroll. A miss keeps the target: a search result in another chat
    /// is asked for before that chat's transcript has rendered, and several renders can pass before
    /// it does. The deadline stops a target that never appears from jumping the feed much later.
    /// </summary>
    private async Task<bool> TryPendingScrollAsync()
    {
        if (_pendingScrollToMessageId is not { } messageId || _messageScrollHandle is not { } handle) return false;
        if (DateTime.UtcNow > _pendingScrollDeadline)
        {
            _pendingScrollToMessageId = null;
            return false;
        }

        var target = await ResolveRenderedTargetAsync(messageId);
        try
        {
            if (!await handle.InvokeAsync<bool>("scrollMessageIntoView", target)) return false;
            _pendingScrollToMessageId = null;
            await AdoptSearchPositionAsync(handle);
            return true;
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
            _pendingScrollToMessageId = null;
            return false;
        }
    }

    /// <summary>
    /// The element to scroll to for <paramref name="messageId"/>. Search can land on a progress note
    /// or tool result. Compact transcripts contain its lightweight message shell, but the
    /// corresponding DOM node intentionally does not exist until that turn is expanded, so the one
    /// owning turn is loaded first; a tool call is drawn as part of its group, under the last id.
    /// </summary>
    private async Task<Guid> ResolveRenderedTargetAsync(Guid messageId)
    {
        var owner = Feed.BuildTurns(GetVisibleBranchMessages(), LastTurnEndedWithoutFinalAnswer())
            .FirstOrDefault(turn => turn.Id is not null
                && turn.IntermediateMessages.Any(message => message.Id == messageId));
        if (owner?.Id is { } turnId && !_expandedTurns.Contains(turnId))
            await ToggleTurnAsync(turnId);

        var targetItem = owner?.IntermediateItems
            .FirstOrDefault(item => ChatFeed.MessagesOf(item).Any(message => message.Id == messageId));
        return targetItem is { ToolGroup: { Count: > 0 } group }
            ? group[^1].Id
            : messageId;
    }

    // Occurrences of the search query in the rendered transcript, and which one is current (-1
    // before the first step). Kept by the JS side; mirrored here only to report changes.
    private int _searchMatchIndex = -1;
    private int _searchMatchCount;
    // The chat the JS side's current occurrence belongs to.
    private Guid? _searchPositionChatId;

    // A scroll to a search result walks the DOM it found, which can be a chat this component has
    // not highlighted yet; the occurrence it landed on belongs to that chat, and the highlight
    // pass that follows must keep it rather than start over.
    private async Task AdoptSearchPositionAsync(IJSObjectReference handle)
    {
        _searchPositionChatId = SelectedChat?.Id;
        SetSearchPosition(await handle.InvokeAsync<int[]>("searchPosition"));
    }

    private void SetSearchPosition(int[]? position)
    {
        if (position is not [var index, var count]) return;
        if (index == _searchMatchIndex && count == _searchMatchCount) return;
        _searchMatchIndex = index;
        _searchMatchCount = count;
        _ = OnSearchPositionChanged.InvokeAsync((index, count));
    }

    /// <summary>Moves to the next (<paramref name="delta"/> 1) or previous (-1) occurrence and scrolls to it.</summary>
    public async Task StepSearchMatchAsync(int delta)
    {
        if (_disposed || _messageScrollHandle is not { } handle) return;
        try
        {
            SetSearchPosition(await handle.InvokeAsync<int[]>("stepSearchMatch", delta));
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException) { }
    }

    /// <summary>F3 / Shift+F3 stepped from the keyboard, anywhere on the page.</summary>
    [JSInvokable]
    public Task OnSearchStepped(int index, int count)
    {
        SetSearchPosition([index, count]);
        return Task.CompletedTask;
    }


    /// <summary>
    /// Scrolls the feed to a specific message — the one the user picked from a search result.
    /// If the target message is not in the DOM yet, the request is retried after later renders.
    /// </summary>
    public async Task ScrollToMessageAsync(Guid messageId)
    {
        if (_disposed || messageId == Guid.Empty) return;
        _pendingScrollToMessageId = messageId;
        _pendingScrollDeadline = DateTime.UtcNow.AddSeconds(PendingScrollSeconds);
        if (await TryPendingScrollAsync()) return;

        // Rendering is what brings the target into the DOM: an expanded turn, or a transcript
        // that was only just selected.
        _expandedTurnsVersion++;
        StateHasChanged();
    }

    /// <summary>
    /// Goes to the bottom and starts following again, regardless of where the user was. Reserved
    /// for what the user themselves just asked for — sending a message, or opening a chat with no
    /// remembered position. New content arriving on its own goes through
    /// <see cref="FollowNewContentAsync"/> instead.
    /// </summary>
    public async Task ScrollToBottomAsync()
    {
        if (_disposed) return;
        ClearNewBelow();
        if (_messageScrollHandle is { } handle)
        {
            try
            {
                await handle.InvokeVoidAsync("scrollToBottom");
                return;
            }
            catch (Exception error) when (error is JSException or ObjectDisposedException)
            {
                return;
            }
        }
        var module = _scrollModule;
        if (module is null) return;
        try
        {
            await module.InvokeVoidAsync("scrollToBottom", _messagesContainer);
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
            // The parent can request a scroll while this feed is being replaced by a settings view.
        }
    }

    /// <summary>
    /// Reports that new content has just been rendered at the end of the transcript. The feed
    /// follows it only if the user was already at the bottom; otherwise their position is left
    /// exactly where it was and the jump affordance is lit instead.
    /// </summary>
    public async Task FollowNewContentAsync()
    {
        if (_disposed || _messageScrollHandle is not { } handle) return;
        try
        {
            if (await handle.InvokeAsync<bool>("followIfPinned")) return;
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
            return;
        }
        if (_newBelow) return;
        _newBelow = true;
        StateHasChanged();
    }

    public async Task<bool> IsAtBottomAsync()
    {
        if (_disposed || _messageScrollHandle is not { } handle) return false;
        try { return await handle.InvokeAsync<bool>("isAtBottom"); }
        catch (Exception error) when (error is JSException or ObjectDisposedException) { return false; }
    }

    private async Task JumpToBottomAsync()
    {
        if (_disposed || _messageScrollHandle is not { } handle) return;
        ClearNewBelow();
        try { await handle.InvokeVoidAsync("jumpToBottom"); }
        catch (Exception error) when (error is JSException or ObjectDisposedException) { }
    }

    /// <summary>Called from messageScroll.js whenever the user enters or leaves the bottom.</summary>
    [JSInvokable]
    public async Task OnPinnedChanged(bool pinned)
    {
        if (_pinned == pinned) return;
        _pinned = pinned;
        // Back at the bottom means everything below has been seen, whatever put them there.
        if (pinned) _newBelow = false;
        StateHasChanged();
        if (pinned) await OnReachedBottom.InvokeAsync();
    }

    private void ClearNewBelow()
    {
        _pinned = true;
        _newBelow = false;
    }

    // A different chat or branch is a different transcript: whatever was waiting below in the old
    // one says nothing about this one. The pinned flag is left to the JS side, which recomputes it
    // from the position this feed is restored to.
    protected override void OnParametersSet()
    {
        // Moves whenever anything the turn lines or the checkpoint mark read from has changed.
        var usageState = (ChatUsage, ShowTurnTokens, ActiveCheckpoint, SelectedRun?.TurnUsage);
        if (!ReferenceEquals(_usageState.ChatUsage, usageState.ChatUsage) || _usageState.ShowTurnTokens != usageState.ShowTurnTokens
            || !ReferenceEquals(_usageState.ActiveCheckpoint, usageState.ActiveCheckpoint)
            || !ReferenceEquals(_usageState.TurnUsage, usageState.TurnUsage))
        {
            _usageState = usageState;
            _usageVersion++;
        }
        if (_activityChatId != SelectedChat?.Id)
        {
            _activityCancellation?.Cancel();
            _activityCancellation?.Dispose();
            _activityCancellation = null;
            _activityChatId = SelectedChat?.Id;
            _activityMessages.Clear();
            _loadingTurnIds.Clear();
            _activityVersion++;
        }

        if (_expandedTurnsChatId != SelectedChat?.Id)
        {
            _expandedTurnsChatId = SelectedChat?.Id;
            _expandedTurnItemLimits.Clear();
            _turnExpansionsPending.Clear();
            if (_expandedTurns.Count > 0)
            {
                _expandedTurns.Clear();
                _expandedTurnsVersion++;
            }
        }

        if (_scrollResetChatId == SelectedChat?.Id && _scrollResetTranscriptId == TranscriptId) return;
        _scrollResetChatId = SelectedChat?.Id;
        _scrollResetTranscriptId = TranscriptId;
        _newBelow = false;
    }

    // Restores the last-viewed message for `key` (as persisted by historyMarkers.js while the
    // user scrolls), falling back to the bottom of the feed when there's nothing saved for it
    // yet (a chat/branch never viewed before) — same default as the old unconditional
    // scroll-to-bottom this replaced.
    public async Task RestoreScrollPositionAsync(string key)
    {
        var module = _historyMarkersModule;
        if (_disposed) return;
        if (module is null)
        {
            await ScrollToBottomAsync();
            return;
        }
        try
        {
            // Anchoring off for the duration: it holds the position the feed is being moved AWAY
            // from, and the rest of a transcript landing above the tail gives it every excuse to
            // put it back. Back on at the restored position — see SetScrollAnchoringAsync.
            await SetScrollAnchoringAsync(false);
            bool restored;
            try
            {
                restored = await module.InvokeAsync<bool>("restoreScrollPosition", _messagesContainer, key);
            }
            finally
            {
                await SetScrollAnchoringAsync(true);
            }

            if (!restored) await ScrollToBottomAsync();
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
            await ScrollToBottomAsync();
        }
    }

    // The scroll anchor is the transcript's memory of what the user was reading, held against
    // anything that changes height above it. Turning it back on re-reads that memory from where
    // the feed now is, so a deliberate move becomes the position being defended rather than the
    // one being corrected away.
    private async Task SetScrollAnchoringAsync(bool enabled)
    {
        if (_disposed || _messageScrollHandle is not { } handle) return;
        try { await handle.InvokeVoidAsync("setAnchoring", enabled); }
        catch (Exception error) when (error is JSException or ObjectDisposedException) { }
    }

    public async Task SaveScrollPositionAsync(string key)
    {
        var module = _historyMarkersModule;
        if (_disposed || module is null) return;
        try
        {
            await module.InvokeVoidAsync("saveScrollPosition", _messagesContainer, key);
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
            // The feed can disappear while navigation is completing.
        }
    }

    // Identifies the (chat, branch) pair whose scroll position historyMarkers.js should persist
    // while attached — null while no chat is open (nothing to track).
    private string? GetScrollKey() => SelectedChat is null ? null : $"{SelectedChat.Id}:{BranchLeafId}";

    // The strip is attached only while a chat is open, and re-measured whenever the number of
    // markers changes: the marker elements themselves are re-created by Blazor on every such change.
    private async Task SyncHistoryMarkersAsync()
    {
        if (_disposed || _historyMarkersModule is null) return;
        if (SelectedChat is null)
        {
            await DisposeHistoryMarkersAsync();
            _historyMarkerCount = -1;
            _historyMarkerScrollKey = null;
            return;
        }

        var count = GetVisibleBranchMessages().Count;
        var scrollKey = GetScrollKey();
        if (_historyMarkersHandle is not null
            && count == _historyMarkerCount
            && scrollKey == _historyMarkerScrollKey) return;

        _historyMarkerCount = count;
        await DisposeHistoryMarkersAsync();
        _historyMarkerScrollKey = scrollKey;
        try
        {
            _historyMarkersHandle = await _historyMarkersModule.InvokeAsync<IJSObjectReference>("attach", _historyMarkers, _messagesContainer, scrollKey);
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
            _historyMarkersHandle = null;
        }
    }

    private async Task DisposeHistoryMarkersAsync()
    {
        if (_historyMarkersHandle is not { } handle) return;
        // Clear the shared reference before yielding. Component disposal can overlap an in-flight
        // render callback, and both paths may otherwise dispose (and mutate) the same handle.
        _historyMarkersHandle = null;
        try
        {
            await handle.InvokeVoidAsync("dispose");
            await handle.DisposeAsync();
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
        }
    }

    // _selectedChat is always replaced wholesale rather than mutated, so a reference check on it
    // (plus the branch leaf) is a cheap, correct invalidation key for the message chain, the
    // fork-point set, and the per-message sibling lookup used by the branch picker.
    private object? _branchCacheChat;
    private Guid? _branchCacheBranchLeafId;
    private int _branchCacheActivityVersion = -1;
    private IReadOnlyList<ChatMessageView> _branchCacheMessages = [];
    private HashSet<Guid> _branchCacheMessageIds = [];
    private Dictionary<Guid, List<ChatMessageView>> _branchCacheChildrenByParent = [];
    private Dictionary<Guid, List<BranchOption>> _branchCacheOptions = [];
    private HashSet<Guid> _branchCacheForkPoints = [];

    /// <summary>
    /// One way on from a fork point: a message that continues the transcript, or, when a stored
    /// branch stops at the fork point itself while another one goes on, that stopping branch.
    /// <paramref name="Branch"/> is the stored branch the option shows, when the chat has one.
    /// </summary>
    private sealed record BranchOption(ChatMessageView Message, ChatBranchView? Branch, bool EndsHere = false);

    // The last query that has been pushed to JS. The transcript re-renders on a stream token or a
    // branch switch and our <mark> wrappers die with it; remembering what is already in the DOM
    // means a follow-up render only re-walks when the query itself actually changed.
    private string? _appliedSearchQuery;

    // A scroll target not in the DOM yet: its chat is still loading, only the tail of the
    // transcript is rendered, or its turn is collapsed. Retried after every render until it lands
    // or the deadline passes.
    private Guid? _pendingScrollToMessageId;
    private DateTime _pendingScrollDeadline;
    private const int PendingScrollSeconds = 10;

    // Chat whose messages the last applySearchHighlight walked. Blazor drops our <mark> wrappers
    // when it rebuilds the transcript for a chat/branch switch, so a "nothing changed, skip the
    // JS call" optimisation keyed on the query alone would silently leave the new chat with no
    // highlights. Resetting on chat id forces a re-walk the first time OnAfterRenderAsync runs
    // after the switch.
    private Guid? _appliedSearchChatId;
    private readonly record struct RenderedFeedEntry(
        FeedItem? Item = null,
        FeedTurn? Summary = null,
        ChatMessageView? ChangesMessage = null,
        int? RevealIndex = null,
        bool IsExpandedIntermediate = false,
        IReadOnlyList<ActiveToolInvocation>? ActiveTools = null,
        Guid? TurnId = null,
        Guid? CollapseTurnId = null,
        ChatRunSnapshot? StreamingRun = null,
        string? LiveText = null,
        int LiveVersion = 0,
        bool LivePreamble = false,
        int LiveAge = 0,
        bool LiveLeaving = false,
        TurnActivity? Activity = null);

    private sealed record TurnActivity(string Title, string? Detail)
    {
        public static TurnActivity None { get; } = new(string.Empty, null);
    }

    /// <summary>The changes of the run in progress, until its receipt lands in the transcript.</summary>
    private WorkspaceChangeSet? GetLiveChanges() =>
        SelectedRun is { Status: not ChatRunStatus.Completed, WorkspaceChanges: { IsEmpty: false } changes }
        && !Feed.LastTurnHasWorkspaceReceipt(GetVisibleBranchMessages())
            ? changes
            : null;

    private readonly HashSet<Guid> _expandedTurns = [];
    private readonly Dictionary<Guid, int> _expandedTurnItemLimits = [];
    private readonly HashSet<Guid> _turnExpansionsPending = [];
    private int _expandedTurnsVersion;
    private Guid? _expandedTurnsChatId;
    private const int InitialExpandedTurnItemCount = 0;
    private const int ExpandedTurnBatchSize = 2;
    private readonly Dictionary<Guid, ChatMessageView> _activityMessages = [];
    private readonly HashSet<Guid> _loadingTurnIds = [];
    private CancellationTokenSource? _activityCancellation;
    private Guid? _activityChatId;
    private int _activityVersion;

    /// <summary>One turn's entries, drawn behind its own <see cref="TranscriptTurnBoundary"/>.</summary>
    private sealed record RenderedFeedTurn(object Key, bool IsCurrent, IReadOnlyList<ChatMessageView> Messages, List<RenderedFeedEntry> Entries);

    private List<RenderedFeedTurn> GetRenderedFeedTurns()
    {
        var turns = new List<RenderedFeedTurn>();
        var liveTurnPresented = false;
        foreach (var turn in Feed.BuildTurns(GetVisibleBranchMessages(), LastTurnEndedWithoutFinalAnswer()))
        {
            var entries = new List<RenderedFeedEntry>();
            var messages = new List<ChatMessageView>();
            if (turn.UserMessage is { } turnUser) messages.Add(turnUser);
            messages.AddRange(turn.IntermediateMessages);
            if (turn.FinalAnswer is { } turnAnswer) messages.AddRange(ChatFeed.MessagesOf(turnAnswer));
            // Orphaned legacy messages have no turn id; their first message is just as stable.
            object key = turn.Id is { } turnKey ? turnKey : messages.Count > 0 ? messages[0].Id : turns.Count;
            turns.Add(new RenderedFeedTurn(key, IsCurrentTurn(turn), messages, entries));
            IReadOnlyList<FeedItem> visibleIntermediateItems = [];
            if (turn.UserMessage is { } user)
            {
                entries.Add(new RenderedFeedEntry(Item: new FeedItem(user, null)));
            }

            // Orphaned legacy messages have no stable turn id and therefore keep their existing
            // presentation. Normal turns get one summary when there is something to fold. A run
            // which has only just started is the sole zero-item exception: "Working for ..."
            // gives it a stable place before the first progress note lands.
            if (turn.Id is null)
            {
                entries.AddRange(turn.IntermediateItems.Select(item => new RenderedFeedEntry(Item: item)));
            }
            else if (turn.IntermediateItems.Count > 0 || IsCurrentUnfinishedTurn(turn))
            {
                entries.Add(new RenderedFeedEntry(Summary: turn));
                if (IsTurnExpanded(turn))
                {
                    var visibleCount = Math.Min(GetExpandedTurnItemLimit(turn.Id!.Value), turn.IntermediateItems.Count);
                    visibleIntermediateItems = turn.IntermediateItems.Take(visibleCount).ToArray();
                    entries.AddRange(visibleIntermediateItems
                        .Select((item, index) => new RenderedFeedEntry(
                            Item: item,
                            RevealIndex: index % ExpandedTurnBatchSize,
                            IsExpandedIntermediate: true)));
                    // File-change receipts from later chunks stay visible while the detailed
                    // blocks are mounted over several frames.
                    entries.AddRange(turn.IntermediateItems.Skip(visibleCount)
                        .SelectMany(ChatFeed.MessagesOf)
                        .Where(message => message.WorkspaceChanges is { IsEmpty: false })
                        .Select(message => new RenderedFeedEntry(ChangesMessage: message)));
                }
                else
                {
                    // The message itself is folded, not its durable workspace receipt, nor what the
                    // person added to the turn: that is theirs, not the model's work.
                    entries.AddRange(turn.IntermediateMessages
                        .Where(message => message.WorkspaceChanges is { IsEmpty: false } || message.Delivery == MessageDelivery.InTurn)
                        .Select(message => message.Delivery == MessageDelivery.InTurn
                            ? new RenderedFeedEntry(Item: new FeedItem(message, null))
                            : new RenderedFeedEntry(ChangesMessage: message)));
                }

                // The final answer arriving as StreamingContent is shown below as it is; the live
                // notes step aside at once rather than making the reader wait for it, folding away
                // the way each of them left the stack before.
                var answerStreaming = !string.IsNullOrWhiteSpace(SelectedRun?.StreamingContent);
                if (IsRunningTurn(turn))
                {
                    liveTurnPresented = true;
                    _liveFrame = LiveText.Present(turn.Id, GetLiveTexts(turn), _liveTextHeld, DateTimeOffset.UtcNow);
                    ScheduleLiveTextCheck(_liveFrame.NextCheck);
                    if (!IsTurnExpanded(turn))
                    {
                        AddLiveNotes(entries, turn, answerStreaming);
                        if (!answerStreaming)
                            entries.Add(new RenderedFeedEntry(Activity: GetTurnActivity() ?? TurnActivity.None, TurnId: turn.Id));
                    }
                    // Expanded, the notes are already there as themselves; only the step still in
                    // flight has nowhere else to appear.
                    else if (!answerStreaming && SelectedRun?.DraftContent is { } draft && !string.IsNullOrWhiteSpace(draft))
                    {
                        entries.Add(new RenderedFeedEntry(LiveText: draft, LiveVersion: -1, TurnId: turn.Id,
                            LivePreamble: SelectedRun.DraftToolCall is not null));
                    }
                }

                if (IsRunningTurn(turn) && IsTurnExpanded(turn)
                    && SelectedRun?.ActiveTools is { Count: > 0 } activeTools)
                {
                    var representedCallIds = visibleIntermediateItems
                        .Where(item => item.ToolGroup is not null)
                        .SelectMany(item => item.ToolGroup!)
                        .SelectMany(message => message.ToolCalls ?? [])
                        .Select(call => call.Id)
                        .ToHashSet(StringComparer.Ordinal);
                    var unrepresented = activeTools
                        .Where(active => !representedCallIds.Contains(active.CallId))
                        .ToArray();
                    if (unrepresented.Length > 0)
                        entries.Add(new RenderedFeedEntry(ActiveTools: unrepresented, TurnId: turn.Id));
                }

                // Once every progressively mounted intermediate block is present, close the
                // expanded region with a second affordance. A long turn can put its summary far
                // above the viewport, so requiring the user to find that first button again
                // defeats the purpose of folding the detail.
                if (_expandedTurns.Contains(turn.Id.Value)
                    && !_turnExpansionsPending.Contains(turn.Id.Value))
                {
                    entries.Add(new RenderedFeedEntry(CollapseTurnId: turn.Id));
                }

                if (IsCurrentTurn(turn) && turn.FinalAnswer is null && SelectedRun is { } streamingRun
                    && !string.IsNullOrWhiteSpace(streamingRun.StreamingContent))
                {
                    entries.Add(new RenderedFeedEntry(StreamingRun: streamingRun, TurnId: turn.Id));
                }
            }

            if (turn.FinalAnswer is { } answer)
            {
                entries.Add(new RenderedFeedEntry(Item: answer));
            }
        }

        if (!liveTurnPresented)
        {
            _liveFrame = LiveText.Present(null, [], false, DateTimeOffset.UtcNow);
            // The element under the pointer can go without a mouseleave; the next turn must not
            // inherit a hold nobody is exerting.
            _liveTextHeld = false;
        }

        return turns;
    }

    private TranscriptTurnStamp GetTurnStamp(RenderedFeedTurn turn, IReadOnlyList<ModelSwitch>? modelSwitches)
    {
        var shared = new TranscriptSharedStamp(SelectedChat?.Id ?? Guid.Empty, _expandedTurnsVersion, ReviewVersion, ShowTurnTokens);
        Guid? Held(Guid? id) => id is { } value && turn.Messages.Any(message => message.Id == value) ? value : null;
        var marks = new TranscriptTurnMarks(Held(BranchLeafId), Held(JustArrivedLeafId), Held(ForkSourceId), Held(MessageBranchMenuId));
        // Run statuses show in the running turn and in an open branch menu's dots, nowhere else.
        var runs = turn.IsCurrent || marks.BranchMenuId is not null ? TranscriptRunPresentationVersion : 0;
        // The pickers under a turn's messages count the branches leaving them and say which one is
        // on screen; a fork from here, or a switch to another branch, changes them without
        // touching the turn's own messages.
        var pickers = new HashCode();
        foreach (var message in turn.Messages)
        {
            var options = GetBranchOptions(message);
            pickers.Add(options.Count);
            if (options.Count > 1) pickers.Add(GetActiveBranchPosition(options));
        }
        var live = turn.IsCurrent
            ? new TranscriptLiveStamp(SelectedChat?.Revision ?? 0, GetGeneratingElapsedSeconds(), GetLiveTextInputVersion())
            : (TranscriptLiveStamp?)null;
        // What the turn used and where the model's view of the chat begins are reloaded after every
        // turn as new objects; each turn compares the figures and the mark it shows itself.
        var usage = turn.Key is Guid turnId ? GetTurnUsage(turnId)?.Totals : null;
        var checkpoint = ActiveCheckpoint is { } active && turn.Messages.FirstOrDefault() is { Role: "User" } user
            && user.ParentId == active.UpToMessageId ? active : null;
        var modelSwitchHash = new HashCode();
        foreach (var change in modelSwitches ?? []) modelSwitchHash.Add(change);
        return new TranscriptTurnStamp(shared, marks, runs, pickers.ToHashCode(), usage, checkpoint, live, modelSwitchHash.ToHashCode());
    }

    private LiveTextFrame _liveFrame = new([], null);
    private bool _liveTextHeld;
    private int _liveTextTick;
    private CancellationTokenSource? _liveTextTimer;
    private DateTimeOffset? _liveTextTimerDue;

    /// <summary>The turn's notes, oldest first, then the step in flight when the model is writing.</summary>
    private List<string> GetLiveTexts(FeedTurn turn)
    {
        var texts = turn.IntermediateMessages
            .Where(message => message.Role == "Assistant" && !string.IsNullOrWhiteSpace(message.Content))
            .Select(message => message.Content)
            .ToList();
        if (SelectedRun?.DraftContent is { } draft && !string.IsNullOrWhiteSpace(draft)) texts.Add(draft);
        return texts;
    }

    /// <summary>
    /// The newest notes as a stack: up to <see cref="LiveNoteCount"/> of them, plus the one that
    /// has just been pushed out, kept mounted so it can fold away instead of vanishing. Older ones
    /// fade by age; while the answer streams, every note folds away under it.
    /// </summary>
    private void AddLiveNotes(List<RenderedFeedEntry> entries, FeedTurn turn, bool answerStreaming)
    {
        var notes = _liveFrame.Notes;
        var count = Math.Clamp(LiveNoteCount, AI.Web.Settings.ClientSettings.MinLiveNoteCount, AI.Web.Settings.ClientSettings.MaxLiveNoteCount);
        for (var index = Math.Max(0, notes.Count - count - 1); index < notes.Count; index++)
        {
            var note = notes[index];
            var age = notes.Count - 1 - index;
            entries.Add(new RenderedFeedEntry(LiveText: note.Text, LiveVersion: note.Id, TurnId: turn.Id,
                LivePreamble: IsPreamble(turn, note.Text), LiveAge: age,
                LiveLeaving: answerStreaming || age >= count));
        }
    }

    /// <summary>
    /// Whether the shown text is known to lead into tool calls rather than being a possible answer:
    /// the step in flight has started a call, or the text landed as a note with calls attached.
    /// </summary>
    private bool IsPreamble(FeedTurn turn, string shown)
    {
        if (SelectedRun?.DraftContent is { } draft && draft.Trim().StartsWith(shown, StringComparison.Ordinal))
            return SelectedRun.DraftToolCall is not null;
        return turn.IntermediateMessages.Any(message => message.Role == "Assistant"
            && message.ToolCalls is { Count: > 0 }
            && message.Content?.Trim().StartsWith(shown, StringComparison.Ordinal) == true);
    }

    /// <summary>
    /// The one line under the live text for tool activity or an approval wait. Questions and
    /// rate-limit waits have their own cards.
    /// </summary>
    private TurnActivity? GetTurnActivity()
    {
        if (SelectedRun is not { Status: ChatRunStatus.Generating } run || run.PendingPrompt is not null || run.Wait is not null) return null;
        if (run.PendingApproval is not null) return new TurnActivity("Waiting for tool approval", null);
        if (run.ActiveTools is { Count: > 0 } tools)
        {
            var call = Presentations.DescribeCall(tools[^1].Name, tools[^1].Arguments);
            return new TurnActivity(call.Title, call.Detail);
        }
        if (run.DraftToolCall is { } preparing)
            return new TurnActivity($"Preparing {Presentations.DescribeCall(preparing, null).Title}…", null);
        return null;
    }

    // Everything the live text is computed from that the transcript boundary does not already
    // watch: the draft growing, the final answer starting, a reading delay running out, the hold.
    private int GetLiveTextInputVersion() => HashCode.Combine(
        SelectedRun?.DraftContent?.Length,
        SelectedRun?.DraftToolCall,
        // The activity line under the text: which call is running, and whether a wait has its own card.
        SelectedRun?.ActiveTools is { Count: > 0 } tools ? tools[^1].CallId : null,
        SelectedRun?.Wait is null,
        string.IsNullOrEmpty(SelectedRun?.StreamingContent),
        _liveTextTick,
        // The hold, and how many notes the stack keeps.
        HashCode.Combine(_liveTextHeld, LiveNoteCount),
        // The changes chip in the running turn's summary line.
        HashCode.Combine(SelectedRun?.WorkspaceChanges?.Files.Count, SelectedRun?.WorkspaceChanges?.Additions, SelectedRun?.WorkspaceChanges?.Deletions));

    private void SetLiveTextHeld(bool held)
    {
        if (_liveTextHeld == held) return;
        _liveTextHeld = held;
        _liveTextTick++;
    }

    /// <summary>
    /// Wakes the transcript when a waiting text becomes due. Nothing else would: the run may be
    /// quiet (a tool running, the model thinking) exactly while the reader finishes the old text.
    /// </summary>
    private void ScheduleLiveTextCheck(DateTimeOffset? due)
    {
        if (due is null || due == _liveTextTimerDue) return;
        _liveTextTimerDue = due;
        _liveTextTimer?.Cancel();
        _liveTextTimer?.Dispose();
        var timer = _liveTextTimer = new CancellationTokenSource();
        var delay = due.Value - DateTimeOffset.UtcNow;
        _ = FireAsync(delay > TimeSpan.Zero ? delay : TimeSpan.Zero);

        async Task FireAsync(TimeSpan wait)
        {
            try { await Task.Delay(wait + TimeSpan.FromMilliseconds(20), timer.Token); }
            catch (OperationCanceledException) { return; }
            if (_disposed) return;
            _liveTextTimerDue = null;
            _liveTextTick++;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool LastTurnEndedWithoutFinalAnswer()
    {
        if (SelectedRun is not { } run
            || run.Status is not (ChatRunStatus.Generating or ChatRunStatus.Failed
                or ChatRunStatus.Interrupted or ChatRunStatus.Paused)) return false;

        var activeMessageId = run.ActiveMessageId
            ?? run.Queue.FirstOrDefault(item => item.Stage == QueuedMessageStage.UserCommitted)?.Id;
        if (activeMessageId is null) return false;

        // Chat persistence and run-state publication are separate event streams. The final
        // assistant message can therefore reach the UI one frame before the Completed snapshot.
        // A complete plain assistant message is authoritative: keeping it "intermediate" during
        // that frame makes the UI claim that an already answered turn is still working.
        if (Feed.LastTurnHasCompleteAnswer(GetVisibleBranchMessages())) return false;

        return GetVisibleBranchMessages().LastOrDefault(message => message.StartsTurn)?.Id
            == activeMessageId;
    }

    private bool IsTurnExpanded(FeedTurn turn) =>
        turn.Id is { } id
        && (_expandedTurns.Contains(id)
            || (ForkSourceId is { } forkSource
                && turn.IntermediateMessages.Any(message => message.Id == forkSource)));

    private bool CanExpandTurn(FeedTurn turn) =>
        turn.IntermediateItems.Count > 0
        || IsCurrentTurn(turn) && SelectedRun?.ActiveTools is { Count: > 0 };

    private async Task ToggleTurnAsync(Guid turnId)
    {
        if (_messageScrollHandle is { } handle)
        {
            try { await handle.InvokeVoidAsync("anchorElement", $"turn-summary-{turnId}"); }
            catch (Exception error) when (error is JSException or ObjectDisposedException) { }
        }

        if (_expandedTurns.Remove(turnId))
        {
            _expandedTurnItemLimits.Remove(turnId);
            _turnExpansionsPending.Remove(turnId);
        }
        else
        {
            _expandedTurns.Add(turnId);
            _expandedTurnItemLimits[turnId] = InitialExpandedTurnItemCount;
            var turn = Feed.BuildTurns(GetVisibleBranchMessages(), LastTurnEndedWithoutFinalAnswer())
                .FirstOrDefault(item => item.Id == turnId);
            if (turn is not null && NeedsActivity(turn))
            {
                _loadingTurnIds.Add(turnId);
                _expandedTurnsVersion++;
                StateHasChanged();
                // A running turn stays open when its activity could not be loaded: what the run's
                // snapshots carry is enough to list the steps, and each step loads its own result
                // when opened. Folding it back made the turn spring shut under the click.
                if (!await LoadTurnActivityAsync(turnId) && !IsRunningTurn(turn))
                {
                    _expandedTurns.Remove(turnId);
                    _expandedTurnItemLimits.Remove(turnId);
                }
            }
            if (_expandedTurns.Contains(turnId)) _turnExpansionsPending.Add(turnId);
        }
        _expandedTurnsVersion++;
    }

    private static bool NeedsActivity(FeedTurn turn) => turn.IntermediateMessages.Any(message =>
        message.ContentOmitted
        || message.ToolCalls?.Any(call => call.Arguments.Length == 0) == true);

    private async Task<bool> LoadTurnActivityAsync(Guid turnId)
    {
        if (SelectedChat is not { } chat || BranchLeafId is not { } branchLeafId) return false;
        _activityCancellation?.Cancel();
        _activityCancellation?.Dispose();
        var cancellation = new CancellationTokenSource();
        _activityCancellation = cancellation;
        try
        {
            var activity = await ChatHistoryApi.GetTurnActivityAsync(
                chat.ProjectId,
                chat.Id,
                turnId,
                branchLeafId,
                cancellation.Token);
            // Not tied to the revision: messages never change once written, so activity read a
            // step behind the page is still true. A running turn moves the revision with every
            // step, and requiring a match turned away almost every load made while it ran.
            if (activity is null || cancellation.IsCancellationRequested
                || SelectedChat?.Id != chat.Id || BranchLeafId != branchLeafId) return false;
            foreach (var message in activity.Messages) _activityMessages[message.Id] = message;
            _activityVersion++;
            _appliedSearchChatId = null;
            return true;
        }
        catch (OperationCanceledException)
        {
            return false;
        }
        finally
        {
            if (ReferenceEquals(_activityCancellation, cancellation))
            {
                _activityCancellation.Dispose();
                _activityCancellation = null;
            }
            _loadingTurnIds.Remove(turnId);
        }
    }

    private async Task CollapseTurnFromEndAsync(Guid turnId)
    {
        if (!_expandedTurns.Contains(turnId)) return;

        if (_messageScrollHandle is { } handle)
        {
            try
            {
                // Keep the content following the expanded region in place. This lets the final
                // answer rise naturally into view instead of jumping back to the summary at the
                // beginning of a potentially very long turn. Focus still returns to that summary
                // for keyboard users, without changing the scroll position.
                await handle.InvokeVoidAsync("anchorFollowingElement", $"turn-collapse-{turnId}");
                await handle.InvokeVoidAsync("focusElement", $"turn-summary-{turnId}");
            }
            catch (Exception error) when (error is JSException or ObjectDisposedException) { }
        }

        _expandedTurns.Remove(turnId);
        _expandedTurnItemLimits.Remove(turnId);
        _turnExpansionsPending.Remove(turnId);
        _expandedTurnsVersion++;
    }

    private int GetExpandedTurnItemLimit(Guid turnId) =>
        _expandedTurnItemLimits.GetValueOrDefault(turnId, int.MaxValue);

    private async Task<bool> AdvanceTurnExpansionAsync()
    {
        if (_turnExpansionsPending.Count == 0) return false;

        // Yield between batches so the chevron paints immediately instead of one click paying
        // for every accumulated tool-result presentation in a single UI-thread task.
        await Task.Delay(TimeSpan.FromMilliseconds(16));
        if (_disposed) return true;

        var turns = Feed.BuildTurns(GetVisibleBranchMessages(), LastTurnEndedWithoutFinalAnswer())
            .Where(turn => turn.Id is not null)
            .ToDictionary(turn => turn.Id!.Value);
        foreach (var turnId in _turnExpansionsPending.ToArray())
        {
            if (!turns.TryGetValue(turnId, out var turn) || !_expandedTurns.Contains(turnId))
            {
                _turnExpansionsPending.Remove(turnId);
                _expandedTurnItemLimits.Remove(turnId);
                continue;
            }

            var next = GetExpandedTurnItemLimit(turnId) + ExpandedTurnBatchSize;
            if (next >= turn.IntermediateItems.Count)
            {
                _expandedTurnItemLimits[turnId] = int.MaxValue;
                _turnExpansionsPending.Remove(turnId);
            }
            else
            {
                _expandedTurnItemLimits[turnId] = next;
            }
        }

        _expandedTurnsVersion++;
        StateHasChanged();
        return true;
    }

    private bool IsCurrentTurn(FeedTurn turn)
    {
        if (turn.Id is not { } id) return false;
        return GetVisibleBranchMessages().LastOrDefault(message => message.StartsTurn)?.Id == id;
    }

    private bool IsRunningTurn(FeedTurn turn) =>
        IsCurrentTurn(turn) && turn.FinalAnswer is null
        && SelectedRun?.Status == ChatRunStatus.Generating;

    private bool IsCurrentUnfinishedTurn(FeedTurn turn) =>
        IsCurrentTurn(turn) && LastTurnEndedWithoutFinalAnswer();

    private string GetGeneratingMarkerTarget()
    {
        if (SelectedRun is { } run
            && !string.IsNullOrWhiteSpace(run.StreamingContent)) return "message-streaming";
        var turnId = GetVisibleBranchMessages().LastOrDefault(message => message.StartsTurn)?.Id;
        return turnId is { } id ? $"turn-summary-{id}" : "message-streaming";
    }

    private string GetTurnSummaryText(FeedTurn turn)
    {
        var elapsed = GetTurnDuration(turn);
        var duration = Feed.FormatDuration(elapsed);
        if (IsRunningTurn(turn))
        {
            // The model's words are under the row in full, and what it is doing with its hands is
            // the line under them; the row only keeps time.
            return $"Working for {duration}";
        }

        if (IsCurrentTurn(turn))
        {
            return SelectedRun?.Status switch
            {
                ChatRunStatus.Failed => $"Failed after {duration}",
                ChatRunStatus.Interrupted or ChatRunStatus.Paused => $"Stopped after {duration}",
                _ => $"Worked for {duration}"
            };
        }

        return $"Worked for {duration}";
    }

    private TurnTokenUsage? GetTurnUsage(Guid turnId) =>
        SelectedRun?.TurnUsage is { } live && live.TurnId == turnId
            ? live
            : ChatUsage?.Turns.FirstOrDefault(turn => turn.TurnId == turnId);

    private TimeSpan GetTurnDuration(FeedTurn turn)
    {
        if (IsRunningTurn(turn) && GeneratingElapsed is { } generating) return generating;
        if (turn.UserMessage is not { } user || turn.LastMessage is not { } last) return TimeSpan.Zero;
        return last.CreatedAt > user.CreatedAt ? last.CreatedAt - user.CreatedAt : TimeSpan.Zero;
    }

    private int? GetGeneratingElapsedSeconds() => GeneratingElapsed is { } elapsed
        ? Math.Max(0, (int)elapsed.TotalSeconds)
        : null;

    private string GetTurnSummaryStateClasses(FeedTurn turn)
    {
        var messages = turn.IntermediateMessages.ToArray();
        return string.Join(' ', new[]
        {
            messages.Any(message => message.Id == BranchLeafId) ? "branch-leaf" : null,
            messages.Any(message => message.Id == JustArrivedLeafId) ? "branch-leaf-arrived" : null,
            messages.Any(message => message.Id == ForkSourceId) ? "fork-source" : null
        }.Where(value => value is not null));
    }

    private void EnsureBranchCache()
    {
        if (ReferenceEquals(_branchCacheChat, SelectedChat)
            && _branchCacheBranchLeafId == BranchLeafId
            && _branchCacheActivityVersion == _activityVersion)
        {
            return;
        }

        // Keep the previous chat's rendered markdown warm as well as the current chat's. Chat
        // switching commonly alternates between two transcripts, and reparsing/sanitizing every
        // large message made that path needlessly expensive. The two-chat LRU keeps that common
        // path fast without retaining every transcript opened during the app's lifetime.
        if (!ReferenceEquals(_branchCacheChat, SelectedChat))
        {
            ActivateMarkdownCache();
        }

        _branchCacheChat = SelectedChat;
        _branchCacheBranchLeafId = BranchLeafId;
        _branchCacheActivityVersion = _activityVersion;
        _branchCacheMessages = ComputeVisibleBranchMessages();
        _branchCacheMessageIds = BranchLeafId is null
            ? []
            : _branchCacheMessages.Select(message => message.Id).ToHashSet();

        var childrenByParent = new Dictionary<Guid, List<ChatMessageView>>();
        var messagesById = new Dictionary<Guid, ChatMessageView>();
        if (SelectedChat is not null)
        {
            foreach (var stored in SelectedChat.Messages)
            {
                var item = _activityMessages.GetValueOrDefault(stored.Id, stored);
                messagesById[item.Id] = item;
                if (item.ParentId is not { } parentId) continue;
                if (!childrenByParent.TryGetValue(parentId, out var siblings))
                {
                    siblings = [];
                    childrenByParent[parentId] = siblings;
                }
                siblings.Add(item);
            }
            foreach (var siblings in childrenByParent.Values)
            {
                siblings.Sort((a, b) => a.CreatedAt.CompareTo(b.CreatedAt));
            }
        }
        _branchCacheChildrenByParent = childrenByParent;

        // A branch can stop exactly where another goes on: Ctrl+Alt+Enter, or a fork from the
        // last message, starts a branch at the head of the one on screen. That message then has a
        // single child, yet two lines meet there, so the line that stops is an option of its own.
        var endingBranches = new Dictionary<Guid, ChatBranchView>();
        foreach (var branch in SelectedChat?.Branches ?? [])
        {
            if (branch.HeadMessageId is { } headId) endingBranches.TryAdd(headId, branch);
        }
        // Each branch's messages, by their distance from its head, so a continuation can be named
        // after the branch it leads into.
        var branchPaths = (SelectedChat?.Branches ?? [])
            .Select(branch => (Branch: branch, Path: GetBranchPath(branch.HeadMessageId, messagesById)))
            .ToArray();
        // The sidebar's order: the chat's main line first, then its branches as the chat stores them.
        var sidebarOrder = new Dictionary<Guid, int>();
        foreach (var branch in SelectedChat?.Branches ?? [])
        {
            sidebarOrder.TryAdd(branch.Id, branch.Id == SelectedChat?.Id ? -1 : sidebarOrder.Count);
        }
        var optionsByMessage = new Dictionary<Guid, List<BranchOption>>(childrenByParent.Count);
        foreach (var (parentId, children) in childrenByParent)
        {
            var options = new List<BranchOption>(children.Count + 1);
            if (endingBranches.TryGetValue(parentId, out var ending) && messagesById.TryGetValue(parentId, out var head))
            {
                options.Add(new BranchOption(head, ending, EndsHere: true));
            }
            var isForkPoint = options.Count + children.Count > 1;
            options.AddRange(children.Select(child =>
                new BranchOption(child, isForkPoint ? FindOwningBranch(child.Id, branchPaths) : null)));
            // Stable, so lines the chat stores no branch for keep their order by time, after the rest.
            optionsByMessage[parentId] = options
                .OrderBy(option => option.Branch is { } branch && sidebarOrder.TryGetValue(branch.Id, out var rank) ? rank : int.MaxValue)
                .ToList();
        }
        _branchCacheOptions = optionsByMessage;
        _branchCacheForkPoints = optionsByMessage
            .Where(pair => pair.Value.Count > 1)
            .Select(pair => pair.Key)
            // ReSharper disable once UseCollectionExpression
            .ToHashSet();
    }

    private static Dictionary<Guid, int> GetBranchPath(Guid? headId, Dictionary<Guid, ChatMessageView> messagesById)
    {
        var path = new Dictionary<Guid, int>();
        for (var id = headId; id is { } current && messagesById.TryGetValue(current, out var message) && path.TryAdd(current, path.Count);)
        {
            id = message.ParentId;
        }
        return path;
    }

    /// <summary>
    /// The branch a message belongs to: of the branches running through it, the one whose root is
    /// the nearest at or above it. The main line has no root, so any other branch through the
    /// message has started nearer to it. Null for a chat that stores no branches.
    /// </summary>
    private static ChatBranchView? FindOwningBranch(Guid messageId,
        IReadOnlyList<(ChatBranchView Branch, Dictionary<Guid, int> Path)> branchPaths)
    {
        ChatBranchView? owner = null;
        var ownerRoot = int.MaxValue;
        foreach (var (branch, path) in branchPaths)
        {
            if (!path.TryGetValue(messageId, out var position)) continue;
            var root = branch.RootMessageId is { } rootId && path.TryGetValue(rootId, out var rootPosition)
                ? rootPosition
                : int.MaxValue;
            if (root < position || (owner is not null && root >= ownerRoot)) continue;
            owner = branch;
            ownerRoot = root;
        }
        return owner;
    }

    private IReadOnlyList<ChatMessageView> GetVisibleBranchMessages()
    {
        EnsureBranchCache();
        return _branchCacheMessages;
    }

    private IReadOnlyList<ChatMessageView> ComputeVisibleBranchMessages()
    {
        if (SelectedChat is null) return [];
        var messages = SelectedChat.Messages
            .Select(message => _activityMessages.GetValueOrDefault(message.Id, message))
            .ToArray();
        return Feed.BuildBranch(messages, BranchLeafId);
    }

    private HashSet<Guid> GetForkPointIds()
    {
        EnsureBranchCache();
        return _branchCacheForkPoints;
    }

    private List<BranchOption> GetBranchOptions(ChatMessageView message)
    {
        EnsureBranchCache();
        return _branchCacheOptions.TryGetValue(message.Id, out var options) ? options : [];
    }

    private bool HasBranchPicker(ChatMessageView message) =>
        GetBranchOptions(message).Count > 1 || ForkSourceId == message.Id;

    // The strip only shows the user's own questions (see BuildHistoryEntries), so every marker in
    // the loop is "history-marker-user" — brightness-by-role no longer distinguishes anything
    // there. Only the separate trailing "Generating" marker still uses history-marker-assistant.
    private readonly record struct HistoryEntry(ChatMessageView Question, ChatMessageView? Answer, bool HasFork);

    // chain is the full branch (user + assistant, root to leaf); a question's answer is simply
    // the next message in the chain when that next message is the assistant's reply to it.
    private static List<HistoryEntry> BuildHistoryEntries(IReadOnlyList<ChatMessageView> chain, HashSet<Guid> forkPoints)
    {
        var entries = new List<HistoryEntry>();
        for (var index = 0; index < chain.Count; index++)
        {
            if (!chain[index].StartsTurn) continue;
            ChatMessageView? answer = null;
            var hasFork = forkPoints.Contains(chain[index].Id);
            for (var next = index + 1; next < chain.Count && !chain[next].StartsTurn; next++)
            {
                hasFork |= forkPoints.Contains(chain[next].Id);
                if (chain[next].Role == "Assistant" && chain[next].ToolCalls is not { Count: > 0 }) answer = chain[next];
            }
            entries.Add(new HistoryEntry(chain[index], answer, hasFork));
        }
        return entries;
    }

    private string GetHistoryMarkerClass(HistoryEntry entry, bool isLast)
    {
        var classes = new List<string>(3) { "history-marker-user" };

        if (entry.HasFork)
        {
            classes.Add("history-marker-fork");
        }

        // Only IsIncomplete is per-message; the run status describes the branch as a whole, so it
        // can only be attributed to the last question's answer, not the question itself.
        if (entry.Answer is { IsIncomplete: true })
        {
            classes.Add("history-marker-incomplete");
        }
        else if (isLast && SelectedRun is { } run)
        {
            switch (run.Status)
            {
                case ChatRunStatus.Failed:
                    classes.Add("history-marker-failed");
                    break;
                case ChatRunStatus.Interrupted or ChatRunStatus.Paused:
                    classes.Add("history-marker-incomplete");
                    break;
                default:
                {
                    if (run.HasUnreadResponse) classes.Add("history-marker-unread");
                    break;
                }
            }
        }

        return string.Join(' ', classes);
    }

    // The last message forks too, as Ctrl+Alt+Enter does: the new branch goes on from it while the
    // current one stops there, and the picker under it then switches between the two.
    private bool IsForkSource(ChatMessageView message) => message.Id == ForkSourceId;

    private string GetForkHint(ChatMessageView message) =>
        IsForkSource(message) ? "The new branch starts here" : "Fork from here";

    // Every message rendered here is an ancestor of BranchLeafId, i.e. part of the same branch
    // SelectedRun tracks — so "is this branch generating" is a single check, not per-message.
    private bool IsBranchGenerating() => SelectedRun?.Status == ChatRunStatus.Generating;

    private IReadOnlyList<ActiveToolInvocation> GetActiveToolsForGroup(IReadOnlyList<ChatMessageView> group)
    {
        if (SelectedRun?.ActiveTools is not { Count: > 0 } activeTools) return [];
        var callIds = group
            .SelectMany(message => message.ToolCalls ?? [])
            .Select(call => call.Id)
            .ToHashSet(StringComparer.Ordinal);
        return activeTools.Where(active => callIds.Contains(active.CallId)).ToArray();
    }

    // Matches the chat-details LRU in Home: the same five transcripts stay instant to switch
    // between, and the rendered HTML for the rest is dropped rather than accumulated.
    private const int RetainedMarkdownChatCount = 5;
    private readonly Dictionary<Guid, (Guid ChatId, string Content, string Html)> _markdownCache = [];
    private readonly LinkedList<Guid> _markdownChatLru = [];

    // Markdig is not cheap; caching by message id means a re-render only
    // re-parses messages whose content actually changed (in practice, just the one being edited).
    // The running turn's text has no message id yet, and the turn is drawn again on every tick of
    // its timer and every tool progress report while the texts themselves stay put. The cache is
    // keyed by text and dropped whole when it fills: a growing text leaves a trail of stale keys,
    // and the stack has only a few texts to parse again.
    private const int LiveMarkdownCacheSize = 16;
    private readonly Dictionary<string, string> _liveMarkdown = new(StringComparer.Ordinal);

    private string RenderLiveMarkdown(string content)
    {
        if (_liveMarkdown.TryGetValue(content, out var html)) return html;
        if (_liveMarkdown.Count >= LiveMarkdownCacheSize) _liveMarkdown.Clear();
        return _liveMarkdown[content] = MarkdownRenderer.Render(content);
    }

    private string RenderMarkdownCached(Guid messageId, string content)
    {
        var chatId = SelectedChat?.Id ?? Guid.Empty;
        if (_markdownCache.TryGetValue(messageId, out var cached)
            && cached.ChatId == chatId
            && cached.Content == content)
        {
            return cached.Html;
        }
        var html = MarkdownRenderer.Render(content);
        _markdownCache[messageId] = (chatId, content, html);
        return html;
    }

    private static string GetMessagePreview(string content)
    {
        var text = content.ReplaceLineEndings(" ").Trim();
        return text[..Math.Min(text.Length, 36)] + (text.Length > 36 ? "…" : string.Empty);
    }

    /// <summary>A teammate's colour before its name; any other sender keeps the branch icon.</summary>
    private RenderFragment SenderMark(MessageSender sender) => SelectedChat?.MemberOf(sender.BranchId) is { Swatch: not null } member
        ? builder => { builder.OpenComponent<MemberDot>(0); builder.AddAttribute(1, nameof(MemberDot.Member), member); builder.CloseComponent(); }
        : builder => { builder.OpenComponent<AppIcon>(0); builder.AddAttribute(1, nameof(AppIcon.Name), "git-branch"); builder.CloseComponent(); };

    /// <summary>
    /// The article's own custom properties: its arrival delay while a turn unfolds, and the colour
    /// of the teammate that sent it, which edges its card.
    /// </summary>
    private string? MessageStyle(int? revealIndex, ChatMessageView message)
    {
        var parts = new List<string>(2);
        if (revealIndex is { } index) parts.Add($"--turn-arrive-delay: {index * 60}ms");
        if (message.Sender is { } sender && SelectedChat?.MemberOf(sender.BranchId)?.Swatch is { } swatch)
            parts.Add($"--member-color: {swatch}");
        return parts.Count == 0 ? null : string.Join("; ", parts);
    }

    private string ResourceLabel(ChatResource resource)
    {
        switch (resource.Kind)
        {
            case ChatResourceKind.Image:
                return resource.Source == ChatResourceSource.Clipboard ? "Image" : resource.Name ?? "Image";
            case ChatResourceKind.File or ChatResourceKind.Directory or ChatResourceKind.Diff:
                return ResourcePresenter.Label(resource);
            case ChatResourceKind.Chat or ChatResourceKind.Project:
                return resource.Name ?? resource.Path;
        }
        if (resource.Kind != ChatResourceKind.Review) return resource.Path;
        if (resource.ReviewKind == ChatReviewKind.Message || MessageReviewIds?.Contains(resource.Id) == true)
        {
            var count = MessageReviews?.Values.FirstOrDefault(item => item.Id == resource.Id)?.MessageComments?.Count;
            return count is > 0 ? $"Message comments · {count}" : "Message comments";
        }
        return ReviewNames?.GetValueOrDefault(resource.Id) ?? resource.Name ?? resource.Path;
    }

    private void ActivateMarkdownCache()
    {
        if (SelectedChat is not { } chat) return;

        var existing = _markdownChatLru.Find(chat.Id);
        if (existing is not null) _markdownChatLru.Remove(existing);
        _markdownChatLru.AddFirst(chat.Id);

        // A refreshed revision may have removed messages. Do not retain rendered content which
        // is no longer part of the chat even while the chat itself remains in the LRU.
        var liveIds = chat.Messages.Select(message => message.Id).ToHashSet();
        foreach (var key in _markdownCache
                     .Where(pair => pair.Value.ChatId == chat.Id && !liveIds.Contains(pair.Key))
                     .Select(pair => pair.Key)
                     .ToList())
        {
            _markdownCache.Remove(key);
        }

        while (_markdownChatLru.Count > RetainedMarkdownChatCount)
        {
            var expiredChatId = _markdownChatLru.Last!.Value;
            _markdownChatLru.RemoveLast();
            foreach (var key in _markdownCache
                         .Where(pair => pair.Value.ChatId == expiredChatId)
                         .Select(pair => pair.Key)
                         .ToList())
            {
                _markdownCache.Remove(key);
            }
        }
    }

    private string GetBranchOptionTitle(BranchOption option)
    {
        // Named as the sidebar names it: the main line by its chat, any other line by its branch.
        if (option.Branch is { } branch)
        {
            return branch.Id == SelectedChat?.Id || string.IsNullOrWhiteSpace(branch.Title)
                ? SelectedChat?.Title ?? branch.Title
                : branch.Title;
        }
        var siblings = option.Message.ParentId is { } parentId
            && _branchCacheOptions.TryGetValue(parentId, out var options)
                ? options
                : [];
        // A chat that stores no branch for this line falls back to the messages themselves.
        if (siblings.Count > 0 && ReferenceEquals(siblings[0], option))
        {
            return option.Message.Role == "Assistant" ? "Original response" : "Original message";
        }

        return GetMessagePreview(option.Message.Content);
    }

    /// <summary>
    /// The picker's lines. A branch a scheduled run made is told apart by the schedule itself, not
    /// by its title, and is shown by run number and start with its outcome beside it.
    /// </summary>
    private IReadOnlyList<BranchPickerItem> GetBranchPickerItems(IReadOnlyList<BranchOption> options)
    {
        var schedule = SelectedChat is null ? null : ScheduleApi.Parse(SelectedChat.Kind, SelectedChat.KindState);
        var runs = (schedule?.Runs ?? []).Where(run => run.BranchId is not null)
            .GroupBy(run => run.BranchId!.Value).ToDictionary(group => group.Key, group => group.Last());
        return options.Select(option =>
        {
            var title = GetBranchOptionTitle(option);
            var hint = GetBranchOptionHint(option) ?? title;
            var statusTooltip = GetOptionStatusTooltip(option);
            var tooltip = statusTooltip is null ? hint : $"{hint} · {statusTooltip}";
            if (schedule is not null && !option.EndsHere && option.Branch is { } branch && runs.TryGetValue(branch.Id, out var run))
            {
                // Short enough for a narrow feed; the branch title in the tooltip keeps the weekday.
                var started = ScheduleCalendar.ToLocal(run.StartedAt, schedule.Settings.TimeZone)
                    .ToString("d MMM HH:mm", System.Globalization.CultureInfo.InvariantCulture);
                var tag = run.Manual ? "manual" : run.Attempt > 1 ? $"retry {run.Attempt - 1}" : null;
                var status = GetOptionStatusClass(option);
                return new BranchPickerItem(option, $"#{run.Number} · {started}", "git-branch",
                    status is { Length: > 0 } and not "run-status-generating" ? status : null,
                    $"{branch.Title}{(run.Summary is { Length: > 0 } summary ? $" · {summary}" : null)}",
                    IsOptionActive(option), false, run.Status, run.Number, tag);
            }
            return new BranchPickerItem(option, title, GetBranchOptionIcon(option), GetOptionStatusClass(option), tooltip,
                IsOptionActive(option), option.EndsHere);
        }).ToArray();
    }

    // The sidebar's icons: the chat for its main line, a branch for every other line.
    private string GetBranchOptionIcon(BranchOption option) =>
        option.Branch is { } branch && branch.Id == SelectedChat?.Id ? "message-circle" : "git-branch";

    private string? GetBranchOptionHint(BranchOption option) =>
        option.EndsHere ? $"{GetBranchOptionTitle(option)} · ends at this message" : null;

    // GetRunForBranch resolves any option's message id to its actual governing run branch
    // (the branch whose head or root it is, or the chat's own id — see
    // BranchLeafHelpers.RunBranchIdFor); an option that ends here is its branch's head. For the
    // currently active option specifically, SelectedRun already IS that exact run, so we use it
    // directly rather than resolving from scratch — same result, cheaper.
    private ChatRunSnapshot? GetOptionRun(BranchOption option) =>
        IsOptionActive(option) ? SelectedRun : GetRunForBranch?.Invoke(option.Message.Id);

    // The active option's own content is the transcript rendered right below this picker, so its
    // status is already visible there — showing it again here too would be the same redundant
    // echo the sidebar avoids. Generating is kept even for the active option since it's live
    // progress rather than a state the user has already seen.
    private string GetOptionStatusClass(BranchOption option)
    {
        var run = GetOptionRun(option);
        return IsOptionActive(option) && run?.Status != ChatRunStatus.Generating
            ? string.Empty
            : StatusPresentation.GetStatusClass(run);
    }

    private string? GetOptionStatusTooltip(BranchOption option)
    {
        var run = GetOptionRun(option);
        if (run is null) return null;
        if (IsOptionActive(option) && run.Status != ChatRunStatus.Generating) return null;
        return StatusPresentation.GetStatusTooltip(run);
    }

    private bool IsMessageInActiveBranch(Guid messageId)
    {
        EnsureBranchCache();
        return _branchCacheMessageIds.Contains(messageId);
    }

    // The fork point itself is on screen either way; only the line that stops there makes it the leaf.
    private bool IsOptionActive(BranchOption option) =>
        option.EndsHere ? option.Message.Id == BranchLeafId : IsMessageInActiveBranch(option.Message.Id);

    private int GetActiveBranchPosition(IReadOnlyList<BranchOption> options)
    {
        for (var index = 0; index < options.Count; index++)
        {
            if (IsOptionActive(options[index])) return index + 1;
        }
        return 1;
    }

    // An option named after a stored branch opens that branch where it ends. Walking down from the
    // option's message would follow the first child at every step and could end on another line,
    // such as a branch that goes on from where this one stops.
    private Task SelectBranchOptionAsync(BranchOption option) => option.Branch?.HeadMessageId is { } head
        ? OnSelectBranchLeaf.InvokeAsync(head)
        : OnSelectBranch.InvokeAsync(option.Message.Id);

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        _activityCancellation?.Cancel();
        _activityCancellation?.Dispose();
        _activityCancellation = null;
        _liveTextTimer?.Cancel();
        _liveTextTimer?.Dispose();
        _liveTextTimer = null;
        await DisposeHistoryMarkersAsync();
        var historyMarkersModule = _historyMarkersModule;
        var scrollModule = _scrollModule;
        var messageScrollModule = _messageScrollModule;
        var messageScrollHandle = _messageScrollHandle;
        var mermaidBlocksModule = _mermaidBlocksModule;
        var mermaidBlocksHandle = _mermaidBlocksHandle;
        var svgBlocksModule = _svgBlocksModule;
        var svgBlocksHandle = _svgBlocksHandle;
        var codeHighlightModule = _codeHighlightModule;
        var codeHighlightHandle = _codeHighlightHandle;
        var fileLinksModule = _fileLinksModule;
        var fileLinksHandle = _fileLinksHandle;
        _historyMarkersModule = null;
        _scrollModule = null;
        _messageScrollModule = null;
        _messageScrollHandle = null;
        _mermaidBlocksModule = null;
        _mermaidBlocksHandle = null;
        _svgBlocksModule = null;
        _svgBlocksHandle = null;
        _codeHighlightModule = null;
        _codeHighlightHandle = null;
        _fileLinksModule = null;
        _fileLinksHandle = null;
        try
        {
            if (messageScrollHandle is not null)
            {
                await messageScrollHandle.InvokeVoidAsync("dispose");
                await messageScrollHandle.DisposeAsync();
            }
            // The mermaid handle holds a MutationObserver; disposing it first stops new renders
            // from being scheduled, which lets the module itself be released even if a render
            // is mid-flight on the rAF queue (the await below yields to the event loop).
            if (mermaidBlocksHandle is not null)
            {
                await mermaidBlocksHandle.InvokeVoidAsync("dispose");
                await mermaidBlocksHandle.DisposeAsync();
            }
            if (svgBlocksHandle is not null)
            {
                await svgBlocksHandle.InvokeVoidAsync("dispose");
                await svgBlocksHandle.DisposeAsync();
            }
            if (codeHighlightHandle is not null)
            {
                await codeHighlightHandle.InvokeVoidAsync("dispose");
                await codeHighlightHandle.DisposeAsync();
            }
            if (fileLinksHandle is not null)
            {
                await fileLinksHandle.InvokeVoidAsync("dispose");
                await fileLinksHandle.DisposeAsync();
            }
            if (historyMarkersModule is not null) await historyMarkersModule.DisposeAsync();
            if (scrollModule is not null) await scrollModule.DisposeAsync();
            if (messageScrollModule is not null) await messageScrollModule.DisposeAsync();
            if (mermaidBlocksModule is not null) await mermaidBlocksModule.DisposeAsync();
            if (svgBlocksModule is not null) await svgBlocksModule.DisposeAsync();
            if (codeHighlightModule is not null) await codeHighlightModule.DisposeAsync();
            if (fileLinksModule is not null) await fileLinksModule.DisposeAsync();
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
        }
        _selfReference?.Dispose();
        _selfReference = null;
    }
}
