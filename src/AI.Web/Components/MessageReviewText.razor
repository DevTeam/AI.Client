@using AI.Contracts.Resources
@using Microsoft.AspNetCore.Components.Web
@using AI.Web.Resources
@inject IReviewApi ReviewsApi
@inject INotificationService Notifications
@inject IJSRuntime JsRuntime
@implements IDisposable

<div id="review-message-@MessageId" class="markdown-content message-review-text"
     @onmouseup="CaptureAsync" @onkeyup="CaptureKeyboardAsync">@Content</div>
@if (_selection is { } selected && _editing)
{
    <div id="review-editor-@MessageId" popover="manual"
         class="message-review-editor @(_popupBelow ? "is-below" : null)" role="dialog" aria-label="Comment on selected text"
         style="left: @_popupXpx; top: @_popupYpx;" @onkeydown="HandleEditorKeyDown">
        <small>Comment on “@selected.Quote”</small>
        <ReviewCommentInput @ref="_input" @bind-Value="_body" AriaLabel="Message review comment" OnKeyDown="HandleTextKeyDownAsync"
                            Suggest="(automatic, token) => SuggestAsync(selected, automatic, token)" />
        <div class="message-review-editor-actions">
            <button class="review-comment-icon-action" type="button" title="Suggest a comment (Ctrl+Space)" aria-label="Suggest a comment" aria-keyshortcuts="Control+Space" disabled="@_saving" @onclick="() => _input?.RequestAsync() ?? Task.CompletedTask"><AppIcon Name="lightbulb" /></button>
            <button class="review-comment-icon-action is-save" type="button" title="Save comment (Enter)" aria-label="Save comment" aria-keyshortcuts="Enter" disabled="@(_saving || string.IsNullOrWhiteSpace(_body))" @onclick="SaveAsync"><AppIcon Name="check" /></button>
            @if (_editingId is { } editingId && _current?.MessageComments?.FirstOrDefault(item => item.Id == editingId) is { } editingComment)
            {
                <button class="review-comment-icon-action is-danger" type="button" title="Delete comment" aria-label="Delete comment" disabled="@_saving" @onclick="() => DeleteAsync(editingComment)"><AppIcon Name="trash" /></button>
            }
            <button class="review-comment-icon-action" type="button" title="Cancel (Esc)" aria-label="Cancel comment" aria-keyshortcuts="Escape" @onclick="Cancel"><AppIcon Name="x" /></button>
        </div>
        @if (_error is not null) { <p class="error" role="alert">@_error</p> }
    </div>
}
@if (_current?.MessageComments is { Count: > 0 } comments)
{
    <button type="button" class="message-review-toggle" aria-expanded="@_showComments" @onclick="() => _showComments = !_showComments" @onkeydown="HandleCommentsKeyDown">
        <AppIcon Name="message-circle" /> @comments.Count @(comments.Count == 1 ? "comment" : "comments")
        <AppIcon Name="@(_showComments ? "chevron-up" : "chevron-down")" />
    </button>
    @if (_showComments)
    {
        <div class="message-review-comments" data-review-message="@MessageId" @onkeydown="HandleCommentsKeyDown">
            <ul class="message-review-comment-list">
                @foreach (var comment in comments.OrderBy(item => item.Start))
                {
                    <li class="message-review-comment" @key="comment.Id" data-review-comment-id="@comment.Id">
                        <button type="button" class="message-review-comment-open" title="Edit comment" @onclick="() => EditAsync(comment)">
                            <span class="message-review-quote">@comment.Quote</span>
                            <span class="message-review-body">@comment.Body</span>
                        </button>
                        <span class="message-review-comment-actions">
                            <button class="review-comment-icon-action" type="button" title="Edit comment" aria-label="Edit comment" disabled="@_saving" @onclick="() => EditAsync(comment)"><AppIcon Name="edit" /></button>
                            <button class="review-comment-icon-action is-danger" type="button" title="Delete comment" aria-label="Delete comment" disabled="@_saving" @onclick="() => DeleteAsync(comment)"><AppIcon Name="trash" /></button>
                        </span>
                    </li>
                }
            </ul>
            <div class="message-review-comments-footer">
                <button type="button" class="message-review-attach" title="Attach these comments to the message you're writing"
                        @onclick="() => OnAttach.InvokeAsync(_current)"><AppIcon Name="plus" />Add to message</button>
            </div>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public Guid ChatId { get; set; }
    [Parameter, EditorRequired] public Guid MessageId { get; set; }
    [Parameter, EditorRequired] public MarkupString Content { get; set; }
    [Parameter] public ChatReview? Review { get; set; }
    [Parameter] public EventCallback<ChatReview> OnChanged { get; set; }
    [Parameter] public EventCallback<ChatReview> OnAttach { get; set; }

    private sealed record MessageTextHit(int Start, int End, string Quote, int? Hit, double X, double Y, bool Below);
    private ChatReview? _current;
    private MessageTextHit? _selection;
    private Guid? _editingId;
    private string _body = string.Empty;
    private string? _error;
    private bool _editing, _saving, _showComments;
    private double _popupX, _popupY;
    private bool _popupBelow;
    private string _popupXpx => $"{_popupX.ToString(System.Globalization.CultureInfo.InvariantCulture)}px";
    private string _popupYpx => $"{_popupY.ToString(System.Globalization.CultureInfo.InvariantCulture)}px";
    private long _highlightRevision = -1;
    private bool _focusEditor;
    private ReviewCommentInput? _input;
    private DotNetObjectReference<MessageReviewText>? _reference;

    protected override void OnParametersSet()
    {
        if (Review is not null && (_current is null || Review.Revision > _current.Revision))
            _current = Review;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_editing)
        {
            _reference ??= DotNetObjectReference.Create(this);
            var focus = _focusEditor;
            _focusEditor = false;
            try { await JsRuntime.InvokeVoidAsync("messageReviews.showEditor", MessageId, _reference, focus); }
            catch (Exception error) when (error is JSException or ObjectDisposedException) { }
        }
        var revision = _current?.Revision ?? 0;
        if (!firstRender && _highlightRevision == revision) return;
        _highlightRevision = revision;
        try
        {
            await JsRuntime.InvokeVoidAsync("messageReviews.setComments", MessageId,
                (_current?.MessageComments ?? []).Select(item => new { item.Id, item.Start, item.End, item.Quote, item.Body }).ToArray());
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException) { }
    }

    private Task CaptureKeyboardAsync(KeyboardEventArgs _) => CaptureAsync(null);

    private async Task CaptureAsync(MouseEventArgs? args)
    {
        // A right click opens the menu the user copies from; it does not start a comment.
        if (args is { Button: not 0 }) return;
        MessageTextHit? hit;
        try
        {
            hit = await JsRuntime.InvokeAsync<MessageTextHit?>("messageReviews.capture", MessageId,
                args?.ClientX ?? 0, args?.ClientY ?? 0);
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException) { return; }
        if (hit is null) return;
        if (hit.End > hit.Start)
        {
            BeginComment(hit);
        }
        else if (hit.Hit is { } position && _current?.MessageComments?.FirstOrDefault(item =>
                     item.Start <= position && position < item.End) is { } comment)
            await EditAsync(comment);
    }

    private void BeginComment(MessageTextHit hit)
    {
        _selection = hit;
        Position(hit);
        _editingId = null;
        _body = string.Empty;
        _editing = true;
        _error = null;
    }

    private async Task EditAsync(MessageReviewComment comment)
    {
        MessageTextHit? hit;
        try { hit = await JsRuntime.InvokeAsync<MessageTextHit?>("messageReviews.locate", MessageId, comment.Start, comment.End); }
        catch (Exception error) when (error is JSException or ObjectDisposedException) { return; }
        if (hit is null) return;
        _selection = hit with { Quote = comment.Quote };
        Position(hit);
        _editingId = comment.Id;
        _body = comment.Body;
        _editing = true;
        _focusEditor = true;
        _error = null;
    }

    private void Position(MessageTextHit hit)
    {
        _popupX = hit.X;
        _popupY = hit.Y;
        _popupBelow = hit.Below;
    }

    private void HandleEditorKeyDown(KeyboardEventArgs args)
    {
        // The first Esc hides a suggested comment, the next one closes the editor.
        if (args.Key == "Escape" && _input?.DismissSuggestion() != true) Cancel();
    }

    private async Task<string?> SuggestAsync(MessageTextHit selected, bool automatic, CancellationToken token) =>
        (await ReviewsApi.SuggestCommentAsync(ProjectId, ChatId,
            new ReviewCommentSuggestionRequest(selected.Quote, MessageId, Automatic: automatic), token))?.Text;

    private Task HandleTextKeyDownAsync(KeyboardEventArgs args) =>
        args is { Key: "Enter", ShiftKey: false, CtrlKey: false, AltKey: false, MetaKey: false } && !_saving
            ? SaveAsync() : Task.CompletedTask;

    private void HandleCommentsKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") _showComments = false;
    }

    // Called by messageReviews.js when the user copies, presses Escape or clicks outside the editor.
    [JSInvokable]
    public async Task DismissEditor(bool save)
    {
        if (!_editing) return;
        var unchanged = _editingId is { } id && _current?.MessageComments?.FirstOrDefault(item => item.Id == id)?.Body == _body.Trim();
        if (save && !_saving && !unchanged && !string.IsNullOrWhiteSpace(_body)) await SaveAsync();
        else Cancel();
        StateHasChanged();
    }

    public void Dispose() => _reference?.Dispose();

    private void Cancel() { _selection = null; _editing = false; _editingId = null; _body = string.Empty; _error = null; }

    private async Task SaveAsync()
    {
        if (_selection is not { } selected || string.IsNullOrWhiteSpace(_body)) return;
        var editing = _editingId is not null;
        _saving = true;
        try
        {
            var comment = new MessageReviewComment(_editingId ?? Guid.CreateVersion7(),
                selected.Start, selected.End, selected.Quote, _body.Trim());
            if (_current is null)
            {
                _current = await ReviewsApi.CreateAsync(ProjectId, ChatId,
                    new CreateReviewRequest(MessageId, "Message review", [], ChatReviewKind.Message, [comment]),
                    CancellationToken.None);
            }
            else
            {
                var comments = (_current.MessageComments ?? []).Where(item => item.Id != comment.Id)
                    .Append(comment).ToArray();
                _current = await ReviewsApi.UpdateAsync(ProjectId, ChatId, _current.Id,
                    new UpdateReviewRequest(_current.Name, [], [], _current.Revision, comments), CancellationToken.None);
            }
            await OnChanged.InvokeAsync(_current);
            _error = null;
            // The user may have selected other text while this was saving; that comment stays open.
            if (ReferenceEquals(_selection, selected)) Cancel();
            Notifications.ShowSuccess(editing ? "Message comment updated." : "Message comment added.");
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException or ArgumentException)
        {
            _error = error.Message;
            Notifications.ShowError($"Could not save message comment: {error.Message}");
        }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(MessageReviewComment comment)
    {
        if (_current is null) return;
        _saving = true;
        try
        {
            var updated = await ReviewsApi.UpdateAsync(ProjectId, ChatId, _current.Id,
                new UpdateReviewRequest(_current.Name, [], [], _current.Revision,
                    (_current.MessageComments ?? []).Where(item => item.Id != comment.Id).ToArray()), CancellationToken.None);
            _current = updated.MessageComments is { Count: > 0 } ? updated : null;
            await OnChanged.InvokeAsync(updated);
            _error = null;
            Cancel();
            Notifications.ShowSuccess("Message comment deleted.");
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException or ArgumentException)
        {
            _error = error.Message;
            Notifications.ShowError($"Could not delete message comment: {error.Message}");
        }
        finally { _saving = false; }
    }
}
