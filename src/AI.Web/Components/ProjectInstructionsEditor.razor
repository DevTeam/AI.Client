@using AI.Contracts.Instructions
@using AI.Web.Memory
@inject IMemoryApi MemoryApi

<section class="settings-group settings-form project-instructions" aria-labelledby="project-instructions-heading">
    <h3 id="project-instructions-heading">Instructions</h3>
    <div class="settings-card">
        <label class="settings-row is-stacked">
            <span class="settings-row-text"><span class="settings-row-label">Rules for the assistant</span><span class="settings-row-hint">Used at the start of each run</span></span>
            <textarea class="project-instructions-text" rows="8" maxlength="32000" disabled="@(_stored is null)"
                      placeholder="Code style, commands to run, what not to touch…"
                      @bind="_text" @bind:event="oninput"></textarea>
        </label>
        <label class="settings-row">
            <span class="settings-row-text"><span class="settings-row-label">Include AGENTS.md and CLAUDE.md</span><span class="settings-row-hint">From the project directories</span></span>
            <input class="settings-switch" type="checkbox" role="switch" disabled="@(_stored is null)" @bind="_includeFiles" />
        </label>
        @if (ProjectLayer is { } layer)
        {
            <details class="settings-disclosure">
                <summary class="settings-row">
                    <span class="settings-row-text"><span class="settings-row-label">Project context</span><span class="settings-row-hint @(layer.Truncated ? "instruction-budget-over" : null)">@(layer.Truncated ? "Some content omitted: over budget" : "What these instructions add, as saved")</span></span>
                    <span class="settings-row-value">@layer.Tokens / @layer.BudgetTokens</span>
                    <AppIcon Name="chevron-right" Class="settings-disclosure-chevron" />
                </summary>
                @foreach (var source in layer.Sources)
                {
                    <div class="settings-row instruction-source @(source.Included ? string.Empty : "excluded")">
                        <span class="settings-row-label" title="@source.Name">@source.Name</span>
                        <span class="settings-row-value">@(source.Included ? $"{source.Tokens} tokens" : "left out: over budget")</span>
                    </div>
                }
            </details>
        }
        <details class="settings-disclosure">
            <summary class="settings-row">
                <span class="settings-row-text"><span class="settings-row-label">What the model sees</span><span class="settings-row-hint">System instructions for the next run, in order</span></span>
                @if (_preview is { } total) { <span class="settings-row-value">@total.TotalTokens tokens</span> }
                <AppIcon Name="chevron-right" Class="settings-disclosure-chevron" />
            </summary>
            @if (IsDirty) { <div class="settings-row"><span class="settings-row-hint">Shows the last saved instructions. Close settings to update it.</span></div> }
            @if (_previewError is not null) { <div class="settings-row" role="status"><span class="settings-row-hint">@_previewError</span></div> }
            @if (_preview is { } preview)
            {
                @foreach (var item in preview.Layers)
                {
                    <details class="settings-disclosure model-context-layer">
                        <summary class="settings-row">
                            <span class="settings-row-label">@item.Title</span>
                            <span class="settings-row-value">@item.Tokens / @item.BudgetTokens@(item.Truncated ? " · cut" : string.Empty)</span>
                            <AppIcon Name="chevron-right" Class="settings-disclosure-chevron" />
                        </summary>
                        <pre>@item.Content</pre>
                    </details>
                }
                <div class="settings-row"><span class="settings-row-hint">Run-control instructions follow.</span></div>
            }
        </details>
    </div>
    @if (_error is { Length: > 0 })
    {
        <p class="settings-drawer-error" role="alert">@_error</p>
    }
    <p class="settings-note">Changes save when you close settings.</p>
</section>

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }

    private ProjectInstructions? _stored;
    private ModelContextPreview? _preview;
    private string _text = string.Empty;
    private bool _includeFiles = true;
    private string? _error;
    private string? _previewError;
    private Guid _loadedFor;

    public bool IsDirty => _stored is { } stored && (stored.Text != _text.Trim() || stored.IncludeWorkspaceFiles != _includeFiles);

    private ModelContextLayer? ProjectLayer => _preview?.Layers.FirstOrDefault(layer => layer.Key == "project.instructions");

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == ProjectId) return;
        _loadedFor = ProjectId;
        await LoadAsync();
    }

    /// <summary>The drawer calls this when it closes: closing is the save, as for the other project settings.</summary>
    public async Task<bool> SaveAsync()
    {
        if (!IsDirty || _stored is not { } stored) return true;
        _error = null;
        try
        {
            _stored = await MemoryApi.UpdateInstructionsAsync(ProjectId,
                new UpdateProjectInstructionsRequest(_text, _includeFiles, stored.Revision), CancellationToken.None);
            _text = _stored.Text;
            _includeFiles = _stored.IncludeWorkspaceFiles;
            await RefreshPreviewAsync();
            return true;
        }
        catch (MemoryConflictException error)
        {
            // Someone — possibly the assistant, with the user's approval — saved first. Keep the typed
            // text so nothing is lost, and move to the stored revision so the next save can land.
            _stored = await MemoryApi.GetInstructionsAsync(ProjectId, CancellationToken.None);
            _error = error.Message + " Your text is kept; save again to replace it.";
            return false;
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _error = error.Message;
            return false;
        }
    }

    public void Discard()
    {
        if (_stored is null) return;
        _text = _stored.Text;
        _includeFiles = _stored.IncludeWorkspaceFiles;
        _error = null;
    }

    private async Task LoadAsync()
    {
        _stored = null;
        _preview = null;
        _previewError = null;
        try
        {
            _stored = await MemoryApi.GetInstructionsAsync(ProjectId, CancellationToken.None);
            _text = _stored.Text;
            _includeFiles = _stored.IncludeWorkspaceFiles;
            _error = null;
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _error = "Instructions could not be loaded.";
            return;
        }
        await RefreshPreviewAsync();
    }

    private async Task RefreshPreviewAsync()
    {
        try
        {
            _preview = await MemoryApi.GetModelContextAsync(ProjectId, CancellationToken.None);
            _previewError = null;
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _preview = null;
            _previewError = "Preview is unavailable. Saved instructions will still be used.";
        }
    }
}
