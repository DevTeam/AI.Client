@using AI.Web.Resources
@using AI.Contracts.Resources
@* The composer's "@" list: the "+" menu reached from the keyboard. It is drawn like the slash list
   of skills and driven the same way — the page owns the selection (chatComposer.js hands it the
   keys), rows only report pointer picks, on mousedown so the textarea keeps focus and the caret.
   Inside a directory, a project or a chat the path to it stays above the rows, and the browse rows
   stay under them, so neither scrolls away in a long listing. *@
<div class="skill-command-menu resource-mention-menu" id="resource-mention-menu" data-levels="@(Levels ? "true" : null)">
    @if (Path is { Count: > 0 } segments)
    {
        <nav class="resource-mention-path" aria-label="Location">
            <button class="resource-mention-up" type="button" tabindex="-1" title="Up one level (Backspace)" aria-label="Up one level"
                    @onmousedown="() => OnPathNavigate.InvokeAsync(segments.Count - 1)" @onmousedown:preventDefault>
                <AppIcon Name="chevron-left" />
            </button>
            @for (var index = 0; index < segments.Count; index++)
            {
                var depth = index;
                if (depth > 0) { <span class="resource-mention-path-separator" aria-hidden="true">/</span> }
                if (depth == segments.Count - 1)
                {
                    <span class="resource-mention-path-current" aria-current="location">@segments[depth]</span>
                }
                else
                {
                    <button class="resource-mention-path-segment" type="button" tabindex="-1"
                            @onmousedown="() => OnPathNavigate.InvokeAsync(depth + 1)" @onmousedown:preventDefault>
                        @segments[depth]
                    </button>
                }
            }
            @if (Loading)
            {
                <AppIcon Name="spinner" Class="resource-mention-loading" />
            }
        </nav>
    }
    <div class="resource-mention-rows" role="listbox" aria-label="Add to chat">
        @for (var index = 0; index < Items.Count; index++)
        {
            var row = index;
            var item = Items[row];
            if (item.Group == ResourceMentionGroup.Browse) continue;
            if ((row == 0 || Items[row - 1].Group != item.Group) && item.Action != ResourceMentionAction.ShowMore
                && Path is null)
            {
                <div class="skill-command-label" role="presentation">@GroupLabel(item.Group)</div>
            }
            @Row(row, item)
        }
    </div>
    @if (Items.Any(item => item.Group == ResourceMentionGroup.Browse))
    {
        <div class="resource-mention-pinned" role="listbox" aria-label="Browse">
            @for (var index = 0; index < Items.Count; index++)
            {
                if (Items[index].Group == ResourceMentionGroup.Browse) { @Row(index, Items[index]) }
            }
        </div>
    }
    @if (Items.Any(CanSendContent))
    {
        <div class="resource-mention-keys" role="presentation">
            <span><kbd>Enter</kbd> path</span>
            <span><kbd>Shift+Enter</kbd> with content</span>
            @if (Items.Any(item => item.Opens))
            {
                <span><kbd>Tab</kbd> open</span>
            }
            @if (Path is not null)
            {
                <span><kbd>Backspace</kbd> up</span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ResourceMentionItem> Items { get; set; } = [];

    /// <summary>
    /// Where the list is, outermost first — a directory's segments, or the scope then the project
    /// and chat opened in it — or null while the list is a search.
    /// </summary>
    [Parameter] public IReadOnlyList<string>? Path { get; set; }

    /// <summary>The path is of opened levels, kept by the page, not of segments typed in the text.</summary>
    [Parameter] public bool Levels { get; set; }

    /// <summary>The Host has yet to answer for what is typed: the rows shown are the last answer.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>A place picked on the path: how many of its segments to keep, one fewer for "up".</summary>
    [Parameter] public EventCallback<int> OnPathNavigate { get; set; }

    [Parameter] public int SelectedIndex { get; set; }

    [Parameter] public EventCallback<int> OnPick { get; set; }

    [Parameter] public EventCallback<int> OnHover { get; set; }

    /// <summary>A row taken with the file's content rather than only its path.</summary>
    [Parameter] public EventCallback<int> OnPickContent { get; set; }

    /// <summary>
    /// A whole workspace file can go with its content. A directory is only ever a path, and a line
    /// range already carries the lines it names.
    /// </summary>
    public static bool CanSendContent(ResourceMentionItem item) =>
        item is { Kind: ChatResourceKind.File, Action: ResourceMentionAction.Attach, Lines: null };

    /// <summary>The icon a reference of this kind has everywhere: its chip in the composer and in the transcript.</summary>
    public static string IconOf(ChatResourceKind kind) => kind switch
    {
        ChatResourceKind.File => "file",
        ChatResourceKind.Directory => "folder",
        ChatResourceKind.Review => "diff",
        ChatResourceKind.Skill => "skill",
        ChatResourceKind.Chat => "message-circle",
        ChatResourceKind.Project => "project",
        ChatResourceKind.Diff => "git-branch",
        _ => "file"
    };

    private RenderFragment Row(int row, ResourceMentionItem item) =>
        @<div @key="item.Key" id="resource-mention-@row" role="option" aria-selected="@(row == SelectedIndex ? "true" : "false")"
              class="skill-command-item @(row == SelectedIndex ? "selected" : null) @(item.Attached ? "attached" : null) @(item.Action == ResourceMentionAction.ShowMore ? "resource-mention-more" : null)"
              data-opens="@(item.Opens ? "true" : null)"
              @onmousedown="() => OnPick.InvokeAsync(row)" @onmousedown:preventDefault
              @onmousemove="() => Hover(row)">
            <AppIcon Name="@IconOf(item)" />
            <span class="skill-command-name">@foreach (var part in Parts(item)) { if (part.Matched) { <mark>@part.Text</mark> } else { @part.Text } }</span>
            <span class="skill-command-description" title="@item.Detail">@item.Detail</span>
            @* "Tab to open" is a hint for the row the keyboard is on, not a column repeated down the list. *@
            <span class="skill-command-source">@(item.Attached ? "Attached" : item.Opens && row == SelectedIndex ? "Tab to open" : null)</span>
            @if (CanSendContent(item))
            {
                @* The second way to take the row, for the pointer: Shift+Enter is the keyboard's. *@
                <button class="resource-mention-content" type="button" tabindex="-1"
                        title="Add with its content (Shift+Enter)" aria-label="Add @item.Name with its content"
                        @onmousedown="() => OnPickContent.InvokeAsync(row)" @onmousedown:preventDefault @onmousedown:stopPropagation>
                    <AppIcon Name="file-text" />
                </button>
            }
        </div>;

    private static string IconOf(ResourceMentionItem item) => item.Action switch
    {
        ResourceMentionAction.BrowseFile => "file",
        ResourceMentionAction.BrowseDirectory => "folder-plus",
        ResourceMentionAction.ShowMore => "more",
        _ => item.BranchId is not null ? "git-branch" : IconOf(item.Kind)
    };

    private static string GroupLabel(ResourceMentionGroup group) => group switch
    {
        ResourceMentionGroup.Directories => "Project directories",
        ResourceMentionGroup.Files => "Files",
        ResourceMentionGroup.Changes => "Uncommitted changes",
        ResourceMentionGroup.Chats => "Chats",
        ResourceMentionGroup.OtherChats => "Chats in other projects",
        ResourceMentionGroup.Branches => "Branches",
        ResourceMentionGroup.Reviews => "Reviews",
        ResourceMentionGroup.Projects => "Projects",
        _ => "Add"
    };

    // mousemove rather than mouseenter, as in the slash list: rows scrolled under a still pointer
    // by the keyboard must not steal the selection back.
    private Task Hover(int row) => row == SelectedIndex ? Task.CompletedTask : OnHover.InvokeAsync(row);

    private static IEnumerable<(string Text, bool Matched)> Parts(ResourceMentionItem item)
    {
        var name = item.Name;
        var highlighted = item.Highlights.ToHashSet();
        var start = 0;
        for (var index = 1; index <= name.Length; index++)
        {
            if (index < name.Length && highlighted.Contains(index) == highlighted.Contains(start)) continue;
            yield return (name[start..index], highlighted.Contains(start));
            start = index;
        }
    }
}
