@using AI.Contracts.Chats
@using AI.Contracts.Resources
@using AI.Contracts.Workspace
@using AI.Web.Resources
@inject IReviewApi ReviewsApi
@inject IWorkspaceUndoState UndoState
@inject INotificationService Notifications
@inject IJSRuntime JsRuntime
@inject ISettingsListFilter ListFilter
@implements IDisposable

<section class="review-workspace" aria-label="Review changes">
    <header class="review-workspace-header">
        <AppIcon Name="diff" />
        <div class="review-workspace-identity">
            <strong title="@_current?.Name">@(_current?.Name ?? "Review")</strong>
            @if (_current is not null)
            {
                <span>@_current.Files.Count files · @_current.Comments.Count comments · Round @_current.SourceCreatedAt.LocalDateTime.ToString("g") · Created @_current.CreatedAt.LocalDateTime.ToString("g") · Updated @_current.UpdatedAt.LocalDateTime.ToString("g")</span>
            }
        </div>
        @if (_undoStatus is { } undoStatus && undoStatus.Files.Any(file => file.State == WorkspaceUndoFileState.Ready))
        {
            <button class="review-workspace-undo chat-card-action chat-card-action-danger" type="button" title="Undo changes in all files from this turn"
                    aria-label="Undo changes in all files from this turn" @onclick="() => BeginUndoAsync(null)"><AppIcon Name="undo" /><span class="workspace-undo-label">Undo</span></button>
        }
        @if (_undoStatus is not null && UndoneCount > 0)
        {
            <span class="workspace-undo-count">@UndoneCount/@_undoStatus.Files.Count undone</span>
        }
        @if (_current is not null)
        {
            @if (_confirmingDelete)
            {
                <span class="review-workspace-delete-confirm">Delete this review?</span>
                <button class="review-workspace-delete-yes" type="button" @onclick="DeleteAsync">Delete</button>
                <button class="confirm-cancel" type="button" title="Cancel" aria-label="Cancel" @onclick="() => _confirmingDelete = false"><AppIcon Name="x" /></button>
            }
            else
            {
                <button class="icon-action review-workspace-delete" type="button" title="Delete review" aria-label="Delete review" @onclick="() => _confirmingDelete = true"><AppIcon Name="trash" /></button>
            }
        }
        <button class="icon-action review-close" type="button" title="Close review" aria-label="Close review" @onclick="OnClose"><AppIcon Name="drawer-close" /></button>
    </header>
    @if (_confirmingUndo)
    {
        <div class="workspace-undo-confirm" role="group" aria-label="Confirm Undo">
            <span>@(_undoPath is null ? $"Undo changes in {ReadyCount} files from this turn?" : $"Undo changes in {Path.GetFileName(_undoPath)}?")</span>
            @if (_undoPath is null && _current is not null && _undoStatus is not null && _current.Files.Count < _undoStatus.Files.Count)
            {
                <span>Includes files excluded from this review.</span>
            }
            @if (PendingBlocked)
            {
                <span class="workspace-undo-warning">Files changed after this turn or cannot be restored. Review files individually.</span>
            }
            <button class="workspace-undo-confirm-yes" type="button" disabled="@(_undoBusy || PendingBlocked)" @onclick="ApplyUndoAsync">Undo</button>
            <button type="button" disabled="@_undoBusy" @onclick="() => _confirmingUndo = false">Cancel</button>
        </div>
    }
    @if (_error is { Length: > 0 })
    {
        <div class="review-error review-workspace-error" role="alert">
            <AppIcon Name="error" />
            <span>@_error</span>
            <button class="icon-action" type="button" title="Dismiss" aria-label="Dismiss error" @onclick="() => _error = null"><AppIcon Name="x" /></button>
        </div>
    }
    @if (_current is null)
    {
        <div class="review-empty"><AppIcon Name="diff" /><p>Review is unavailable.</p></div>
    }
    else if ((_current.SourceChanges ?? SourceOf(_current)?.WorkspaceChanges) is { } changes)
    {
        <div class="review-workspace-body" id="@_bodyId">
            <div class="review-diff-scroll">
                @foreach (var file in FilesInTreeOrder(BuildFileTree(changes.Files, null))
                    .Where(item => _current.Files.Contains(item.Path, StringComparer.Ordinal)))
                {
                    var fileId = FileId(file.Path);
                    <section class="review-file @(_hoveredFilePath == file.Path ? "is-tree-hovered" : null)" id="@fileId" @key="file.Path">
                        <ReviewDiffFile @key="file.Path" File="@file" SourceFiles="@changes.Files"
                                        ProjectId="@ProjectId" ChatId="@Chat.Id" SourceMessageId="@_current.SourceMessageId"
                                        Review="@_current" OnChanged="ReviewChangedAsync" Expanded="@_expandedFiles.Contains(file.Path)"
                                        OnExpand="() => { _expandedFiles.Add(file.Path); }">
                            <HeaderTemplate Context="comment">
                                <WorkspaceChangeFileHeader File="@file" Expanded="@_expandedFiles.Contains(file.Path)"
                                                           CommentCount="@_current.Comments.Count(item => item.Path == file.Path)"
                                                           OnToggle="() => ToggleExpandedFile(file.Path)" OnComment="@comment"
                                                           UndoFileState="@StateFor(file.Path)" OnUndo="() => BeginUndoAsync(file.Path)" />
                            </HeaderTemplate>
                        </ReviewDiffFile>
                    </section>
                }
            </div>
            <div class="review-tree-resizer" role="separator" tabindex="0" aria-label="Resize review file tree"
                 aria-orientation="vertical" aria-valuemin="180" aria-valuemax="600" aria-valuenow="352"></div>
            <aside class="review-file-tree" aria-label="Review files">
                @{ var shownFiles = FilesInTreeOrder(BuildFileTree(changes.Files, _fileFilter)).ToList(); }
                <SettingsFilterField @bind-Value="_fileFilter" Placeholder="Filter files" Shown="@shownFiles.Count" Total="@changes.Files.Count"
                                     Submitted="() => OpenFile(shownFiles[0].Path)" />
                <div class="review-file-tree-list">
                    @if (shownFiles.Count == 0 && changes.Files.Count > 0) { <p class="empty-hint">No files match “@_fileFilter.Trim()”.</p> }
                    @foreach (var node in BuildFileTree(changes.Files, _fileFilter)) { @RenderTreeNode(node) }
                </div>
            </aside>
        </div>
    }
    else if (_current.Kind == ChatReviewKind.Diff)
    {
        <div class="review-legacy-summary">
            <p>The original diff is no longer available for this review. Saved file names and comments:</p>
            @foreach (var path in _current.Files)
            {
                <section>
                    <strong>@path</strong>
                    @foreach (var comment in _current.Comments.Where(item => item.Path == path))
                    {
                        <p>@comment.Body</p>
                    }
                </section>
            }
        </div>
    }
    else { <div class="review-empty"><AppIcon Name="diff" /><p>The reviewed message is no longer available.</p></div> }
</section>

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public ChatDetails Chat { get; set; } = default!;
    [Parameter] public IReadOnlyList<ChatReview> Reviews { get; set; } = [];
    [Parameter] public Guid? StartReviewId { get; set; }

    /// <summary>The file to open and scroll to, when the review was opened for it.</summary>
    [Parameter] public string? StartPath { get; set; }
    [Parameter] public EventCallback<ChatReview> OnChanged { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private ChatReview? _current;
    private readonly HashSet<string> _expandedFiles = new(StringComparer.Ordinal);
    private readonly HashSet<string> _collapsedFolders = new(StringComparer.Ordinal);
    private readonly string _bodyId = $"review-body-{Guid.NewGuid():N}";
    private string _fileFilter = string.Empty;
    private string? _hoveredFilePath;
    private string? _error;
    private bool _saving;
    private bool _confirmingDelete;
    private string? _revealPath;
    private WorkspaceUndoStatus? _undoStatus;
    private string? _undoPath;
    private bool _confirmingUndo, _undoBusy;

    private int ReadyCount => _undoStatus?.Files.Count(file => file.State == WorkspaceUndoFileState.Ready) ?? 0;
    private int UndoneCount => _undoStatus?.Files.Count(file => file.State == WorkspaceUndoFileState.Undone) ?? 0;
    private bool PendingBlocked => _undoPath is { } path
        ? StateFor(path) != WorkspaceUndoFileState.Ready
        : _undoStatus is null || _undoStatus.Files.Any(file =>
            file.State is WorkspaceUndoFileState.Conflict or WorkspaceUndoFileState.Unavailable);

    private WorkspaceUndoFileState? StateFor(string path) =>
        _undoStatus?.Files.FirstOrDefault(file => file.Path == path)?.State;

    protected override async Task OnInitializedAsync()
    {
        UndoState.Changed += UndoChanged;
        if (_current is null || (_current.SourceChanges ?? SourceOf(_current)?.WorkspaceChanges)?.UndoId is not { } undoId) return;
        try { _undoStatus = await UndoState.LoadAsync(ProjectId, Chat.Id, _current.SourceMessageId, undoId); }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        { Notifications.ShowError($"Could not load Undo status: {error.Message}"); }
    }

    private void UndoChanged(Guid messageId, WorkspaceUndoStatus status)
    {
        if (_current?.SourceMessageId == messageId)
            _ = InvokeAsync(() => { _undoStatus = status; StateHasChanged(); });
    }

    private async Task BeginUndoAsync(string? path)
    {
        if (_current is null) return;
        try
        {
            var undoId = (_current.SourceChanges ?? SourceOf(_current)?.WorkspaceChanges)?.UndoId;
            if (undoId is null) return;
            _undoStatus = await UndoState.LoadAsync(ProjectId, Chat.Id, _current.SourceMessageId, undoId.Value, refresh: true);
            _undoPath = path;
            _confirmingUndo = true;
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        { Notifications.ShowError($"Could not check files for Undo: {error.Message}"); }
    }

    private async Task ApplyUndoAsync()
    {
        if (_undoBusy || _current is null) return;
        _undoBusy = true;
        try
        {
            _undoStatus = await UndoState.UndoAsync(ProjectId, Chat.Id, _current.SourceMessageId, _undoPath);
            if (_undoStatus?.AppliedCount > 0)
            {
                _confirmingUndo = false;
                Notifications.ShowSuccess($"Undid changes in {_undoStatus.AppliedCount} files.");
                if (_undoStatus.Error is { } issue) Notifications.ShowError(issue);
            }
            else Notifications.ShowError(_undoStatus?.Error ?? "No files were undone. The files may have changed since this turn.");
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        { Notifications.ShowError($"Could not undo files: {error.Message}"); }
        finally { _undoBusy = false; }
    }

    public void Dispose() => UndoState.Changed -= UndoChanged;

    private async Task DeleteAsync()
    {
        if (_current is not null) await OnDelete.InvokeAsync(_current.Id);
    }

    protected override void OnInitialized()
    {
        _current = Reviews.FirstOrDefault(item => item.Id == StartReviewId);
        if (_current is not null
            && (_current.SourceChanges ?? SourceOf(_current)?.WorkspaceChanges) is { } changes
            && FilesInTreeOrder(BuildFileTree(changes.Files, null))
                .Where(file => _current.Files.Contains(file.Path, StringComparer.Ordinal))
                .OrderByDescending(file => file.Path == StartPath)
                .FirstOrDefault() is { } firstFile)
        {
            _expandedFiles.Add(firstFile.Path);
            if (firstFile.Path == StartPath) _revealPath = StartPath;
        }
    }

    private ChatMessageView? SourceOf(ChatReview review) => Chat.Messages.FirstOrDefault(item => item.Id == review.SourceMessageId);
    private static string FileId(string path) => "review-file-" + Uri.EscapeDataString(path);
    private sealed class FileTreeNode(string name, string path)
    {
        public string Name { get; } = name;
        public string Path { get; } = path;
        public FileChange? File { get; set; }
        public List<FileTreeNode> Children { get; } = [];
    }

    // The filter matches every word of the query against the whole path, as the Settings lists do.
    private IReadOnlyList<FileTreeNode> BuildFileTree(IReadOnlyList<FileChange> files, string? filter)
    {
        var roots = new List<FileTreeNode>();
        foreach (var file in files.Where(item => ListFilter.Matches(filter ?? string.Empty, item.Path)))
        {
            var segments = file.Path.Split(['/', '\\'], StringSplitOptions.RemoveEmptyEntries);
            var siblings = roots;
            var path = string.Empty;
            for (var index = 0; index < segments.Length; index++)
            {
                path = path.Length == 0 ? segments[index] : path + "/" + segments[index];
                var node = siblings.FirstOrDefault(item => item.Name == segments[index]);
                if (node is null) { node = new FileTreeNode(segments[index], path); siblings.Add(node); }
                if (index == segments.Length - 1) node.File = file;
                siblings = node.Children;
            }
        }
        SortTree(roots);
        return roots.Select(Compact).ToList();
    }

    private static FileTreeNode Compact(FileTreeNode node)
    {
        while (node.File is null && node.Children is [{ File: null } only])
        {
            var merged = new FileTreeNode(node.Name + "/" + only.Name, only.Path);
            merged.Children.AddRange(only.Children);
            node = merged;
        }
        for (var index = 0; index < node.Children.Count; index++) node.Children[index] = Compact(node.Children[index]);
        return node;
    }

    private static void SortTree(List<FileTreeNode> nodes)
    {
        nodes.Sort((first, second) => first.File is null && second.File is not null ? -1
            : first.File is not null && second.File is null ? 1
            : StringComparer.OrdinalIgnoreCase.Compare(first.Name, second.Name));
        foreach (var node in nodes) SortTree(node.Children);
    }

    private static IEnumerable<FileChange> FilesInTreeOrder(IEnumerable<FileTreeNode> nodes)
    {
        foreach (var node in nodes)
        {
            if (node.File is { } file) yield return file;
            foreach (var child in FilesInTreeOrder(node.Children)) yield return child;
        }
    }

    private RenderFragment RenderTreeNode(FileTreeNode node) => @<text>
        @if (node.File is { } file)
        {
            var included = _current!.Files.Contains(file.Path, StringComparer.Ordinal);
            var lockReason = ExcludeBlockedReason(file.Path);
            <div class="review-tree-row @(included ? null : "is-excluded") @(_expandedFiles.Contains(file.Path) ? "is-open" : null)" @key="file.Path"
                 @onmouseenter="() => HoverFileAsync(file.Path)"
                 @onmouseleave="() => _hoveredFilePath = null">
                <input type="checkbox" checked="@included" disabled="@(lockReason is not null)"
                       title="@(lockReason ?? (included ? "Exclude from this review" : "Include in this review"))"
                       aria-label="Include @file.Path" @onchange="() => ToggleFileAsync(file.Path)" />
                <a href="#@FileId(file.Path)" title="@file.Path" aria-expanded="@_expandedFiles.Contains(file.Path)"
                   @onclick="() => ToggleExpandedFile(file.Path)">
                    <AppIcon Name="@(_expandedFiles.Contains(file.Path) ? "chevron-down" : "chevron-right")" Class="review-tree-file-chevron" />
                    <span class="review-tree-file-status is-@file.Kind.ToString().ToLowerInvariant()" title="@FileKindTitle(file.Kind)">@FileKindGlyph(file.Kind)</span>
                    <span class="review-tree-file-name"><SettingsFilterText Text="@node.Name" Query="@_fileFilter" /></span>
                </a>
                @if (StateFor(file.Path) == WorkspaceUndoFileState.Ready)
                {
                    <button class="icon-action workspace-change-undo-action" type="button" title="Undo changes in this file"
                            aria-label="Undo changes in @file.Path" @onclick="() => BeginUndoAsync(file.Path)"><AppIcon Name="undo" /></button>
                }
                else if (StateFor(file.Path) == WorkspaceUndoFileState.Undone)
                {
                    <span class="workspace-undo-count" title="Changes in this file were undone">Undone</span>
                }
                else if (StateFor(file.Path) == WorkspaceUndoFileState.Conflict)
                {
                    <span class="workspace-undo-warning" title="This file changed after the turn">Changed</span>
                }
                @if (_current.Comments.Count(item => item.Path == file.Path) is > 0 and var count)
                {
                    <span class="workspace-change-comments review-tree-comments" title="@count @(count == 1 ? "comment" : "comments")" aria-label="@count @(count == 1 ? "comment" : "comments")"><AppIcon Name="message-circle" />@count</span>
                }
                <span class="review-tree-counts">
                    <AnimatedCount Value="@file.Additions" Sign="+" Class="workspace-added" />
                    <AnimatedCount Value="@file.Deletions" Sign="−" Class="workspace-removed" />
                </span>
            </div>
        }
        else
        {
            <div class="review-tree-folder" @key="node.Path">
                <button class="review-tree-folder-toggle" type="button" aria-expanded="@FolderOpen(node.Path)"
                        disabled="@Filtering" @onclick="() => ToggleFolder(node.Path)">
                    <AppIcon Name="@(FolderOpen(node.Path) ? "chevron-down" : "chevron-right")" />
                    <AppIcon Name="folder" Class="review-tree-folder-icon" />
                    <span title="@node.Path"><SettingsFilterText Text="@node.Name" Query="@_fileFilter" /></span>
                </button>
                @if (FolderOpen(node.Path))
                {
                    <div class="review-tree-children">@foreach (var child in node.Children) { @RenderTreeNode(child) }</div>
                }
            </div>
        }
    </text>;

    private bool Filtering => ListFilter.Words(_fileFilter).Count > 0;

    // A filtered tree shows every folder that holds a match, whatever was collapsed before.
    private bool FolderOpen(string path) => Filtering || !_collapsedFolders.Contains(path);

    private void OpenFile(string path)
    {
        _expandedFiles.Add(path);
        _revealPath = path;
    }

    private void ToggleFolder(string path)
    {
        if (!_collapsedFolders.Add(path)) _collapsedFolders.Remove(path);
    }

    // Why a file cannot leave the review, shown on its disabled checkbox rather than as an error after the click.
    private string? ExcludeBlockedReason(string path)
    {
        if (_current is null || !_current.Files.Contains(path, StringComparer.Ordinal)) return null;
        if (_current.Comments.Any(item => item.Path == path)) return "Remove the file's comments to exclude it";
        return _current.Files.Count == 1 ? "A review needs at least one file" : null;
    }

    private async Task ToggleFileAsync(string path)
    {
        if (_current is null) return;
        var files = _current.Files.ToList();
        if (files.Contains(path, StringComparer.Ordinal) && _current.Comments.Any(item => item.Path == path))
        {
            _error = "Remove the file's comments before excluding it from this review.";
            Notifications.ShowError(_error);
            return;
        }
        if (!files.Remove(path)) files.Add(path);
        if (files.Count == 0) { _error = "A review must include at least one file."; Notifications.ShowError(_error); return; }
        if (await SaveAsync(files, _current.Comments)) Notifications.ShowSuccess("Review updated.");
    }

    private void ToggleExpandedFile(string path)
    {
        if (!_expandedFiles.Add(path)) _expandedFiles.Remove(path);
    }

    private async Task HoverFileAsync(string path)
    {
        _hoveredFilePath = path;
        try { await JsRuntime.InvokeVoidAsync("reviewWorkspace.revealFile", _bodyId, FileId(path)); }
        catch (Exception error) when (error is JSException or ObjectDisposedException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_current is null) return;
        try { await JsRuntime.InvokeVoidAsync("reviewWorkspace.initialize", _bodyId); }
        catch (Exception error) when (error is JSException or ObjectDisposedException) { }
        if (_revealPath is not { } path) return;
        _revealPath = null;
        try { await JsRuntime.InvokeVoidAsync("reviewWorkspace.revealFile", _bodyId, FileId(path)); }
        catch (Exception error) when (error is JSException or ObjectDisposedException) { }
    }

    private static string FileKindGlyph(FileChangeKind kind) => kind switch
    {
        FileChangeKind.Added => "A", FileChangeKind.Deleted => "D",
        FileChangeKind.Renamed => "R", _ => "M",
    };

    private static string FileKindTitle(FileChangeKind kind) => kind switch
    {
        FileChangeKind.Added => "Added", FileChangeKind.Deleted => "Deleted",
        FileChangeKind.Renamed => "Renamed", _ => "Modified",
    };

    private async Task ReviewChangedAsync(ChatReview review)
    {
        _current = review;
        await OnChanged.InvokeAsync(review);
    }

    private async Task<bool> SaveAsync(IReadOnlyList<string> files, IReadOnlyList<ReviewComment> comments)
    {
        if (_current is null || _saving) return false;
        _saving = true;
        try
        {
            var revised = await ReviewsApi.UpdateAsync(ProjectId, Chat.Id, _current.Id,
                new UpdateReviewRequest(_current.Name, files, comments, _current.Revision), CancellationToken.None);
            _current = revised;
            _error = null;
            await OnChanged.InvokeAsync(revised);
            return true;
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _error = error.Message;
            Notifications.ShowError($"Could not update review: {error.Message}");
            return false;
        }
        finally { _saving = false; }
    }
}
