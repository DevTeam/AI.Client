@using AI.Contracts.Chats
@using AI.Contracts.Resources
@using AI.Contracts.Workspace
@using AI.Web.Resources
@inject IReviewApi ReviewsApi
@inject INotificationService Notifications
@inject IJSRuntime JsRuntime

<section class="review-workspace" aria-label="Review changes">
    <header class="review-workspace-header">
        <AppIcon Name="diff" />
        <div class="review-workspace-identity">
            <strong title="@_current?.Name">@(_current?.Name ?? "Review")</strong>
            @if (_current is not null)
            {
                <span>@_current.Files.Count files · @_current.Comments.Count comments · Round @_current.SourceCreatedAt.LocalDateTime.ToString("g") · Created @_current.CreatedAt.LocalDateTime.ToString("g") · Updated @_current.UpdatedAt.LocalDateTime.ToString("g")</span>
            }
        </div>
        @if (_current is not null)
        {
            @if (_confirmingDelete)
            {
                <span class="review-workspace-delete-confirm">Delete this review?</span>
                <button class="review-workspace-delete-yes" type="button" @onclick="DeleteAsync">Delete</button>
                <button class="confirm-cancel" type="button" title="Cancel" aria-label="Cancel" @onclick="() => _confirmingDelete = false"><AppIcon Name="x" /></button>
            }
            else
            {
                <button class="icon-action review-workspace-delete" type="button" title="Delete review" aria-label="Delete review" @onclick="() => _confirmingDelete = true"><AppIcon Name="trash" /></button>
            }
        }
        <button class="icon-action review-close" type="button" title="Close review" aria-label="Close review" @onclick="OnClose"><AppIcon Name="drawer-close" /></button>
    </header>
    @if (_error is { Length: > 0 }) { <p class="review-error" role="alert">@_error</p> }
    @if (_current is null)
    {
        <p class="review-error">Review is unavailable.</p>
    }
    else if ((_current.SourceChanges ?? SourceOf(_current)?.WorkspaceChanges) is { } changes)
    {
        <div class="review-workspace-body" id="@_bodyId">
            <div class="review-diff-scroll">
                @foreach (var file in FilesInTreeOrder(BuildFileTree(changes.Files, null))
                    .Where(item => _current.Files.Contains(item.Path, StringComparer.Ordinal)))
                {
                    var fileId = FileId(file.Path);
                    <section class="review-file @(_hoveredFilePath == file.Path ? "is-tree-hovered" : null)" id="@fileId" @key="file.Path">
                        <WorkspaceChangeFileHeader File="@file" Expanded="@_expandedFiles.Contains(file.Path)"
                                                   CommentCount="@_current.Comments.Count(comment => comment.Path == file.Path)"
                                                   OnToggle="() => ToggleExpandedFile(file.Path)" />
                        @if (_expandedFiles.Contains(file.Path))
                        {
                            <ReviewDiffFile @key="file.Path" File="@file" SourceFiles="@changes.Files"
                                            ProjectId="@ProjectId" ChatId="@Chat.Id" SourceMessageId="@_current.SourceMessageId"
                                            Review="@_current" OnChanged="ReviewChangedAsync" />
                        }
                    </section>
                }
            </div>
            <div class="review-tree-resizer" role="separator" tabindex="0" aria-label="Resize review file tree"
                 aria-orientation="vertical" aria-valuemin="180" aria-valuemax="600" aria-valuenow="352"></div>
            <aside class="review-file-tree" aria-label="Review files">
                <input type="search" value="@_fileFilter" @oninput="e => _fileFilter = e.Value?.ToString() ?? string.Empty" placeholder="Filter files" aria-label="Filter review files" />
                @foreach (var node in BuildFileTree(changes.Files, _fileFilter)) { @RenderTreeNode(node) }
            </aside>
        </div>
    }
    else if (_current.Kind == ChatReviewKind.Diff)
    {
        <div class="review-legacy-summary">
            <p>The original diff is no longer available for this review. Saved file names and comments:</p>
            @foreach (var path in _current.Files)
            {
                <section>
                    <strong>@path</strong>
                    @foreach (var comment in _current.Comments.Where(item => item.Path == path))
                    {
                        <p>@comment.Body</p>
                    }
                </section>
            }
        </div>
    }
    else { <p class="review-error">The reviewed message is no longer available.</p> }
</section>

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public ChatDetails Chat { get; set; } = default!;
    [Parameter] public IReadOnlyList<ChatReview> Reviews { get; set; } = [];
    [Parameter] public Guid? StartReviewId { get; set; }

    /// <summary>The file to open and scroll to, when the review was opened for it.</summary>
    [Parameter] public string? StartPath { get; set; }
    [Parameter] public EventCallback<ChatReview> OnChanged { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private ChatReview? _current;
    private readonly HashSet<string> _expandedFiles = new(StringComparer.Ordinal);
    private readonly HashSet<string> _collapsedFolders = new(StringComparer.Ordinal);
    private readonly string _bodyId = $"review-body-{Guid.NewGuid():N}";
    private string _fileFilter = string.Empty;
    private string? _hoveredFilePath;
    private string? _error;
    private bool _saving;
    private bool _confirmingDelete;
    private string? _revealPath;

    private async Task DeleteAsync()
    {
        if (_current is not null) await OnDelete.InvokeAsync(_current.Id);
    }

    protected override void OnInitialized()
    {
        _current = Reviews.FirstOrDefault(item => item.Id == StartReviewId);
        if (_current is not null
            && (_current.SourceChanges ?? SourceOf(_current)?.WorkspaceChanges) is { } changes
            && FilesInTreeOrder(BuildFileTree(changes.Files, null))
                .Where(file => _current.Files.Contains(file.Path, StringComparer.Ordinal))
                .OrderByDescending(file => file.Path == StartPath)
                .FirstOrDefault() is { } firstFile)
        {
            _expandedFiles.Add(firstFile.Path);
            if (firstFile.Path == StartPath) _revealPath = StartPath;
        }
    }

    private ChatMessageView? SourceOf(ChatReview review) => Chat.Messages.FirstOrDefault(item => item.Id == review.SourceMessageId);
    private static string FileId(string path) => "review-file-" + Uri.EscapeDataString(path);
    private sealed class FileTreeNode(string name, string path)
    {
        public string Name { get; } = name;
        public string Path { get; } = path;
        public FileChange? File { get; set; }
        public List<FileTreeNode> Children { get; } = [];
    }

    private static IReadOnlyList<FileTreeNode> BuildFileTree(IReadOnlyList<FileChange> files, string? filter)
    {
        var roots = new List<FileTreeNode>();
        foreach (var file in files.Where(item => string.IsNullOrWhiteSpace(filter)
                     || item.Path.Contains(filter, StringComparison.OrdinalIgnoreCase)))
        {
            var segments = file.Path.Split(['/', '\\'], StringSplitOptions.RemoveEmptyEntries);
            var siblings = roots;
            var path = string.Empty;
            for (var index = 0; index < segments.Length; index++)
            {
                path = path.Length == 0 ? segments[index] : path + "/" + segments[index];
                var node = siblings.FirstOrDefault(item => item.Name == segments[index]);
                if (node is null) { node = new FileTreeNode(segments[index], path); siblings.Add(node); }
                if (index == segments.Length - 1) node.File = file;
                siblings = node.Children;
            }
        }
        SortTree(roots);
        return roots;
    }

    private static void SortTree(List<FileTreeNode> nodes)
    {
        nodes.Sort((first, second) => first.File is null && second.File is not null ? -1
            : first.File is not null && second.File is null ? 1
            : StringComparer.OrdinalIgnoreCase.Compare(first.Name, second.Name));
        foreach (var node in nodes) SortTree(node.Children);
    }

    private static IEnumerable<FileChange> FilesInTreeOrder(IEnumerable<FileTreeNode> nodes)
    {
        foreach (var node in nodes)
        {
            if (node.File is { } file) yield return file;
            foreach (var child in FilesInTreeOrder(node.Children)) yield return child;
        }
    }

    private RenderFragment RenderTreeNode(FileTreeNode node) => @<text>
        @if (node.File is { } file)
        {
            <div class="review-tree-row" @key="file.Path"
                 @onmouseenter="() => HoverFileAsync(file.Path)"
                 @onmouseleave="() => _hoveredFilePath = null">
                <input type="checkbox" checked="@_current!.Files.Contains(file.Path, StringComparer.Ordinal)" aria-label="Include @file.Path" @onchange="() => ToggleFileAsync(file.Path)" />
                <a href="#@FileId(file.Path)" title="@file.Path" aria-expanded="@_expandedFiles.Contains(file.Path)"
                   @onclick="() => ToggleExpandedFile(file.Path)">
                    <AppIcon Name="@(_expandedFiles.Contains(file.Path) ? "chevron-down" : "chevron-right")" Class="review-tree-file-chevron" />
                    <span class="review-tree-file-status" title="@FileKindTitle(file.Kind)">@FileKindGlyph(file.Kind)</span>
                    <span class="review-tree-file-name">@node.Name</span>
                </a>
                @if (_current.Comments.Count(item => item.Path == file.Path) is > 0 and var count)
                {
                    <span class="workspace-change-comments review-tree-comments" title="@count @(count == 1 ? "comment" : "comments")" aria-label="@count @(count == 1 ? "comment" : "comments")"><AppIcon Name="message-circle" />@count</span>
                }
                <span class="review-tree-counts">
                    <AnimatedCount Value="@file.Additions" Sign="+" Class="workspace-added" />
                    <AnimatedCount Value="@file.Deletions" Sign="−" Class="workspace-removed" />
                </span>
            </div>
        }
        else
        {
            <div class="review-tree-folder" @key="node.Path">
                <button class="review-tree-folder-toggle" type="button" aria-expanded="@(!_collapsedFolders.Contains(node.Path))"
                        @onclick="() => ToggleFolder(node.Path)">
                    <AppIcon Name="@(_collapsedFolders.Contains(node.Path) ? "chevron-right" : "chevron-down")" />
                    <span>@node.Name</span>
                </button>
                @if (!_collapsedFolders.Contains(node.Path))
                {
                    <div class="review-tree-children">@foreach (var child in node.Children) { @RenderTreeNode(child) }</div>
                }
            </div>
        }
    </text>;

    private void ToggleFolder(string path)
    {
        if (!_collapsedFolders.Add(path)) _collapsedFolders.Remove(path);
    }

    private async Task ToggleFileAsync(string path)
    {
        if (_current is null) return;
        var files = _current.Files.ToList();
        if (files.Contains(path, StringComparer.Ordinal) && _current.Comments.Any(item => item.Path == path))
        {
            _error = "Remove the file's comments before excluding it from this review.";
            Notifications.ShowError(_error);
            return;
        }
        if (!files.Remove(path)) files.Add(path);
        if (files.Count == 0) { _error = "A review must include at least one file."; Notifications.ShowError(_error); return; }
        if (await SaveAsync(files, _current.Comments)) Notifications.ShowSuccess("Review updated.");
    }

    private void ToggleExpandedFile(string path)
    {
        if (!_expandedFiles.Add(path)) _expandedFiles.Remove(path);
    }

    private async Task HoverFileAsync(string path)
    {
        _hoveredFilePath = path;
        try { await JsRuntime.InvokeVoidAsync("reviewWorkspace.revealFile", _bodyId, FileId(path)); }
        catch (Exception error) when (error is JSException or ObjectDisposedException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_current is null) return;
        try { await JsRuntime.InvokeVoidAsync("reviewWorkspace.initialize", _bodyId); }
        catch (Exception error) when (error is JSException or ObjectDisposedException) { }
        if (_revealPath is not { } path) return;
        _revealPath = null;
        try { await JsRuntime.InvokeVoidAsync("reviewWorkspace.revealFile", _bodyId, FileId(path)); }
        catch (Exception error) when (error is JSException or ObjectDisposedException) { }
    }

    private static string FileKindGlyph(FileChangeKind kind) => kind switch
    {
        FileChangeKind.Added => "A", FileChangeKind.Deleted => "D",
        FileChangeKind.Renamed => "R", _ => "M",
    };

    private static string FileKindTitle(FileChangeKind kind) => kind switch
    {
        FileChangeKind.Added => "Added", FileChangeKind.Deleted => "Deleted",
        FileChangeKind.Renamed => "Renamed", _ => "Modified",
    };

    private async Task ReviewChangedAsync(ChatReview review)
    {
        _current = review;
        await OnChanged.InvokeAsync(review);
    }

    private async Task<bool> SaveAsync(IReadOnlyList<string> files, IReadOnlyList<ReviewComment> comments)
    {
        if (_current is null || _saving) return false;
        _saving = true;
        try
        {
            var revised = await ReviewsApi.UpdateAsync(ProjectId, Chat.Id, _current.Id,
                new UpdateReviewRequest(_current.Name, files, comments, _current.Revision), CancellationToken.None);
            _current = revised;
            _error = null;
            await OnChanged.InvokeAsync(revised);
            return true;
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _error = error.Message;
            Notifications.ShowError($"Could not update review: {error.Message}");
            return false;
        }
        finally { _saving = false; }
    }
}
