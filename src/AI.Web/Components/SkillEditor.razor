@using AI.Contracts.Skills
@using AI.Web.Skills
@inject ISkillApi SkillApi
@inject INotificationService Notifications

<div class="global-editor-layout skill-editor">
    <div class="settings-list-column">
        <nav class="settings-list" aria-label="Skills">
            @if (_loaded && _skills.Count == 0) { <p class="empty-hint">No skills are available.</p> }
            @foreach (var source in new[] { "Built-in", "User", "Project" })
            {
                var group = _skills.Where(skill => skill.Source == source).OrderBy(skill => skill.Name).ToArray();
                if (group.Length == 0) continue;
                <div class="memory-group-label">@source</div>
                @foreach (var skill in group)
                {
                    <div class="settings-list-item @(Key(skill) == _selectedKey && !_creating ? "selected" : string.Empty) @(skill.Enabled ? string.Empty : "memory-disabled")">
                        <button class="settings-list-select" type="button" @onclick="() => TrySelect(skill)">
                            <span>@skill.Name</span><small>@skill.Description</small>
                        </button>
                    </div>
                }
            }
        </nav>
        <button class="icon-action settings-list-add" type="button" title="Add skill" aria-label="Add skill"
                disabled="@(!_loaded)" @onclick="Add"><AppIcon Name="plus" /></button>
    </div>
    @if (_creating || Selected is not null)
    {
        var selected = Selected;
        var readOnly = !_creating && selected?.Source == "Built-in";
        <div class="global-form skill-form">
            <div class="connection-flags">
                <span class="skill-source">@(_creating ? "New skill" : selected?.Source)</span>
                @if (_creating)
                {
                    <label>Scope
                        <select class="text-input" @bind="_scope">
                            <option value="User">User</option>
                            @if (ProjectId is not null) { <option value="Project">Project</option> }
                        </select>
                    </label>
                }
                else if (!readOnly)
                {
                    <label class="checkbox"><input type="checkbox" @bind="_enabled" /> Enabled</label>
                }
                else { <span class="skill-state">@(selected?.Enabled == true ? "Enabled" : "Disabled")</span> }
            </div>
            @if (selected is not null)
            {
                <label>Name<input class="text-input" value="@selected.Name" readonly /></label>
                <label>Description<textarea rows="2" readonly>@selected.Description</textarea></label>
                <label>Parameters<textarea class="skill-parameters" rows="8" readonly spellcheck="false">@FormatSchema(selected)</textarea></label>
            }
            <label>SKILL.md<textarea class="skill-content" rows="18" readonly="@readOnly" spellcheck="false"
                                     @bind="_draft" @bind:event="oninput"></textarea></label>
            <p class="memory-meta">@(_creating ? "Set the id, description, parameter schema and result schema in the frontmatter. The caller supplies data through parameters."
                : readOnly ? "Built-in skills are part of the application and cannot be edited here."
                : $"Revision {selected?.Revision}. Edit the SKILL.md text and save it here.")</p>
            @if (!readOnly)
            {
                <div class="skill-editor-actions">
                    <button class="secondary-action" type="button" disabled="@_saving" @onclick="SaveAsync">@(_saving ? "Saving…" : "Save skill")</button>
                    <button class="secondary-action" type="button" disabled="@_saving" @onclick="DiscardEdits">Discard edits</button>
                    @if (!_creating)
                    {
                        <button class="secondary-action" type="button" disabled="@_saving" @onclick="DeleteAsync">
                            @(_confirmDelete ? "Confirm delete" : "Delete")
                        </button>
                    }
                </div>
            }
            @if (selected is not null)
            {
                <div class="skill-runs-heading"><strong>Recent runs</strong>
                    <button class="secondary-action" type="button" @onclick="RefreshRunsAsync">Refresh</button></div>
                @if (_runs.Where(run => run.SkillId == selected.Id).Take(10).ToArray() is { Length: > 0 } recent)
                {
                    <div class="skill-runs" aria-live="polite">
                        @foreach (var run in recent)
                        {
                            <div class="skill-run">
                                <span class="skill-run-status">@run.Status</span>
                                <span>@run.StartedAt.ToLocalTime().ToString("g")</span>
                                <span>@run.Message</span>
                                @if (run.Output is { } output) { <pre>@output.GetRawText()</pre> }
                                @if (run.ChatId is { } chatId) { <small>Chat @chatId</small> }
                            </div>
                        }
                    </div>
                }
                else { <p class="memory-meta">No runs recorded for this skill.</p> }
            }
            @if (_error is { } error) { <p class="settings-drawer-error" role="alert">@error</p> }
        </div>
    }
    else
    {
        <div class="global-form"><p class="empty-hint">@(_error ?? (_loaded ? "Select a skill or add one." : "Loading skills…"))</p></div>
    }
</div>

@code {
    [Parameter] public Guid? ProjectId { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private IReadOnlyList<SkillDefinition> _skills = [];
    private IReadOnlyList<SkillRunRecord> _runs = [];
    private string? _selectedKey;
    private string _draft = "";
    private string _initialDraft = "";
    private string _scope = "User";
    private bool _enabled = true;
    private bool _creating;
    private bool _loaded;
    private bool _saving;
    private bool _confirmDelete;
    private string? _error;
    private SkillDefinition? Selected => _skills.FirstOrDefault(skill => Key(skill) == _selectedKey);
    private bool IsDirty => _creating ? _draft != _initialDraft
        : Selected is { } selected && (_draft != selected.Content || _enabled != selected.Enabled);
    private static string Key(SkillDefinition skill) => $"{skill.Source}:{skill.ProjectId}:{skill.Id}";
    private static string FormatSchema(SkillDefinition skill) =>
        System.Text.Json.JsonSerializer.Serialize(skill.ParametersSchema,
            new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    public string Stats => $"{_skills.Count} {(_skills.Count == 1 ? "skill" : "skills")} · {_skills.Count(skill => skill.Enabled)} enabled";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
            Select(_skills.FirstOrDefault());
            _loaded = true;
            await RefreshRunsAsync();
            await Changed.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _error = "Skills could not be loaded.";
            await Changed.InvokeAsync();
        }
    }

    private async Task ReloadAsync() => _skills = await SkillApi.ListAsync(ProjectId, CancellationToken.None);

    private void Select(SkillDefinition? skill)
    {
        _creating = false;
        _confirmDelete = false;
        _selectedKey = skill is null ? null : Key(skill);
        _draft = skill?.Content ?? "";
        _initialDraft = _draft;
        _enabled = skill?.Enabled ?? true;
        _error = null;
    }

    private void Add()
    {
        if (IsDirty) { _error = "Save or discard edits before opening another skill."; return; }
        _creating = true;
        _selectedKey = null;
        _scope = ProjectId is null ? "User" : "Project";
        _enabled = true;
        _confirmDelete = false;
        _error = null;
        _draft = """
            ---
            id: my-skill
            name: My skill
            description: Describe when this skill should be used.
            parameters: {"type":"object","properties":{},"additionalProperties":false}
            result: {"type":"string"}
            tools: []
            ---

            Describe the task and return a JSON result matching the result schema.
            """;
        _initialDraft = _draft;
    }

    private void TrySelect(SkillDefinition skill)
    {
        if (IsDirty) { _error = "Save or discard edits before opening another skill."; return; }
        Select(skill);
    }

    private void DiscardEdits() => Select(Selected ?? _skills.FirstOrDefault());

    public Task<bool> SavePendingAsync() => IsDirty ? SaveCoreAsync() : Task.FromResult(true);

    private async Task SaveAsync() => await SaveCoreAsync();

    private async Task<bool> SaveCoreAsync()
    {
        var selected = Selected;
        _saving = true;
        _error = null;
        try
        {
            var scope = _creating ? _scope : selected!.Source;
            var saved = await SkillApi.SaveAsync(new SkillWriteRequest(scope,
                scope == "Project" ? ProjectId : null, _draft, selected?.Revision ?? 0, _enabled), CancellationToken.None);
            await ReloadAsync();
            Select(_skills.First(skill => skill.Source == saved.Source && skill.ProjectId == saved.ProjectId && skill.Id == saved.Id));
            Notifications.ShowSuccess("Skill saved.");
            await Changed.InvokeAsync();
            return true;
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException or ArgumentException)
        {
            _error = error.Message;
            Notifications.ShowError("Skill was not saved.");
            return false;
        }
        finally { _saving = false; }
    }

    private async Task DeleteAsync()
    {
        if (!_confirmDelete) { _confirmDelete = true; return; }
        if (Selected is not { } skill) return;
        _saving = true;
        try
        {
            await SkillApi.DeleteAsync(skill, CancellationToken.None);
            await ReloadAsync();
            Select(_skills.FirstOrDefault());
            Notifications.ShowSuccess("Skill deleted.");
            await Changed.InvokeAsync();
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _error = error.Message;
            Notifications.ShowError("Skill was not deleted.");
        }
        finally { _saving = false; _confirmDelete = false; }
    }

    private async Task RefreshRunsAsync()
    {
        try { _runs = await SkillApi.ListRunsAsync(CancellationToken.None); }
        catch (HttpRequestException) { _error = "Skill runs could not be loaded."; }
    }
}
