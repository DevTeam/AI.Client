@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<div class="markdown-content" @ref="_element">@((MarkupString)(_fallback ? Html : _initialHtml))</div>

@code {
    [Parameter, EditorRequired] public string Html { get; set; } = string.Empty;

    private ElementReference _element;
    private IJSObjectReference? _module;
    private string _initialHtml = string.Empty;
    private string _appliedHtml = string.Empty;
    private bool _rendered;
    private bool _ready;
    private bool _updating;
    private bool _fallback;
    private bool _disposed;

    protected override void OnParametersSet()
    {
        if (!_rendered) _initialHtml = Html;
    }

    // Blazor's MarkupString diff replaces the whole Markdown fragment on every append. After the
    // first render, JavaScript updates only the changed nodes so completed links keep their DOM
    // identity, hover state, and file-link decoration while later text arrives.
    protected override bool ShouldRender() => !_rendered || _fallback;

    protected override Task OnParametersSetAsync() => _ready ? UpdateAsync() : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _rendered = true;
        try
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/streamingMarkdown.js");
            if (_disposed) return;
            await _module.InvokeVoidAsync("initialize", _element, _initialHtml);
            _appliedHtml = _initialHtml;
            _ready = true;
            await UpdateAsync();
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
            await UseFallbackAsync();
        }
    }

    private async Task UpdateAsync()
    {
        if (_updating || !_ready || _disposed || _module is null) return;
        _updating = true;
        try
        {
            while (!_disposed && !string.Equals(_appliedHtml, Html, StringComparison.Ordinal))
            {
                var html = Html;
                await _module.InvokeVoidAsync("update", _element, html);
                _appliedHtml = html;
            }
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
            await UseFallbackAsync();
        }
        finally
        {
            _updating = false;
        }
    }

    private async Task UseFallbackAsync()
    {
        if (_disposed) return;
        _ready = false;
        _fallback = true;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (Exception error) when (error is JSException or ObjectDisposedException) { }
        }
    }
}
