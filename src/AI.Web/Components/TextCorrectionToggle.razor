@* Without selected languages, the shortcut opens their settings. Otherwise it pauses or resumes correction. *@
<button type="button" class="composer-correction-toggle @(State.Languages.Count == 0 ? "is-unconfigured" : State.IsActive ? "is-on" : "is-off")" data-app-target="chat.text_correction"
        role="@(State.Languages.Count == 0 ? null : "switch")" aria-checked="@(State.Languages.Count == 0 ? null : State.IsActive ? "true" : "false")" aria-label="@Title()"
        title="@Title()" @onclick="OnToggle">
    <svg class="app-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m7 18 5-13 5 13M9 13.5h6" transform="@(State.IsActive ? "translate(-5 0)" : "rotate(180 12 11.5)")" />
        @if (State.IsActive)
        {
            <path class="composer-correction-check" d="m16 16.5 2.5 2.5 4-4.5" />
        }
    </svg>
</button>

@code {
    [Parameter, EditorRequired]
    public AI.Web.Settings.TextCorrectionState State { get; set; } = new([], true);

    [Parameter]
    public EventCallback OnToggle { get; set; }

    private string Title()
    {
        if (State.Languages.Count == 0)
            return "Text correction is not configured. Click to select correction languages in Settings.";
        var languages = string.Join(", ", State.Languages.Select(language => language.Name));
        return State.Enabled
            ? $"Text correction is on: {languages}. Click to pause correction while keeping your selected languages."
            : $"Text correction is paused: {languages}. Click to resume correction with your selected languages.";
    }
}
