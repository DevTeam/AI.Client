@inject AI.Web.Navigation.IAppControlHints ControlHints
@inject IChatRunsApi RunsApi
@inject INotificationService Notifications
@inject IToolPresentations Presentations
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable
@using AI.Contracts.Tools

@{ var presentation = Presentations.DescribeCall(Approval.Name, Approval.Arguments); }
<section @attributes="@(ControlHints.Attributes("chat.approval", nativeTooltip: false))" class="tool-approval-bar opens-upward @(_detailsOpen ? "is-expanded" : "is-collapsed")" role="region" aria-label="Tool approval" aria-busy="@(_decidingApproval ? "true" : "false")">
    <div class="tool-approval-main chat-card-header">
        <button class="tool-approval-header" type="button" aria-expanded="@_detailsOpen" aria-controls="@_detailsId" @ref="_header" title="@(_detailsOpen ? "Collapse tool details" : "Expand tool details")" @onclick="ToggleDetails">
            <span class="tool-approval-mark chat-card-mark" aria-hidden="true"><AppIcon Name="shield" /></span>
            <span class="tool-approval-copy">
                <span class="tool-approval-heading chat-card-title">Tool needs permission</span>
                <span class="tool-approval-summary" title="@presentation.Detail">
                    <strong>@presentation.Title</strong>
                    @if (presentation.Detail is { Length: > 0 } detail)
                    {
                        <span class="tool-approval-preview">@detail</span>
                    }
                    @if (Approval.BatchSize > 1)
                    {
                        <span class="tool-approval-count" title="Position in this batch of tool calls; each call is confirmed separately">Call @Approval.CallIndex of @Approval.BatchSize</span>
                    }
                </span>
                @* The assessment is advice; the person answers the pending call. *@
                @if (Approval.Assessment is { Length: > 0 } assessment)
                {
                    <span class="tool-approval-assessment"><AppIcon Name="shield-alert" /><span>@assessment</span></span>
                }
                @if (CommandNotes() is { Length: > 0 } notes)
                {
                    <span class="tool-approval-assessment"><AppIcon Name="shield-alert" /><span>@notes</span></span>
                }
            </span>
        </button>
        <div class="chat-card-header-actions tool-approval-controls">
            <div class="tool-approval-actions">
                <button @attributes="@(ControlHints.Attributes("chat.approval.deny", "Refuse this call without saving a permission rule"))" class="secondary-action tool-approval-deny chat-card-action" type="button" disabled="@_decidingApproval" @onclick="() => DecideAsync(ToolApprovalAction.Deny)">Deny</button>
                <div class="tool-approval-allow">
                    <button @attributes="@(ControlHints.Attributes("chat.approval.once", "Run this call once without saving a permission rule"))" class="tool-approval-once chat-card-action chat-card-action-primary" type="button" disabled="@_decidingApproval" @onclick="() => DecideAsync(ToolApprovalAction.Allow)">Allow once</button>
                    <div class="tool-approval-more @(_allowMenuOpen ? "is-open" : null)">
                        <button class="chat-card-action chat-card-action-icon" type="button" title="More allow options" aria-label="More allow options" aria-expanded="@_allowMenuOpen" aria-controls="@_menuId" @onclick="ToggleAllowMenu"><AppIcon Name="chevron-down" /></button>
                        @if (_allowMenuOpen)
                        {
                            <div class="tool-approval-menu-backdrop" @onclick="CloseAllowMenu"></div>
                            <div class="tool-approval-menu" id="@_menuId">
                                @* A process_run call can be remembered as the command it runs rather than as the whole tool. *@
                                @if (Approval.Command is { Options.Count: > 0 } scoped)
                                {
                                    <fieldset class="tool-approval-scope">
                                        <legend>Remember</legend>
                                        @foreach (var option in scoped.Options)
                                        {
                                            <label title="Allow commands that match this pattern"><input type="radio" name="@_scopeName" checked="@(_pattern == option)" @onchange="() => ChoosePattern(option)" /><code>@option</code></label>
                                        }
                                        <label title="Allow every call of this tool, whatever it runs"><input type="radio" name="@_scopeName" checked="@(_pattern is null)" @onchange="() => ChoosePattern(null)" /><span>Any @Approval.Name call</span></label>
                                    </fieldset>
                                }
                                <button type="button" disabled="@_decidingApproval" @onclick="() => DecideAsync(ToolApprovalAction.AllowForChat)"><strong>Allow for this chat</strong><span>Remember @Remembered in @ChatTitle</span></button>
                                <button type="button" disabled="@_decidingApproval" @onclick="() => DecideAsync(ToolApprovalAction.AllowForProject)"><strong>Allow for this project</strong><span>Use @Remembered in every chat in this project</span></button>
                                @if (_confirmGlobal)
                                {
                                    <div class="tool-approval-global-confirm"><span>Allow <code>@Remembered</code> in every project?</span><div><button type="button" disabled="@_decidingApproval" @onclick="() => DecideAsync(ToolApprovalAction.AllowGlobally)">Always allow</button><button class="confirm-cancel" type="button" title="Cancel" aria-label="Cancel" @onclick="CancelGlobalApproval"><AppIcon Name="x" /></button></div></div>
                                }
                                else
                                {
                                    <button type="button" @onclick="BeginGlobalApproval"><strong>@(_pattern is null ? "Always allow this tool" : "Always allow this command")</strong><span>Apply to every project</span></button>
                                }
                            </div>
                        }
                        else
                        {
                            <span id="@_menuId" hidden></span>
                        }
                    </div>
                </div>
            </div>
            <button class="tool-approval-details-toggle chat-card-action chat-card-action-icon" type="button" title="@(_detailsOpen ? "Collapse tool details" : "Expand tool details")" aria-label="@(_detailsOpen ? "Collapse tool details" : "Expand tool details")" aria-expanded="@_detailsOpen" aria-controls="@_detailsId" @onclick="ToggleDetails"><AppIcon Name="chevron-down" /></button>
        </div>
    </div>
    <div class="tool-approval-details" id="@_detailsId" aria-hidden="@(!_detailsOpen)" inert="@(!_detailsOpen)">
        <div class="tool-approval-details-inner">
            <div class="tool-approval-details-content">
                @if (Approval.Command is { } shown)
                {
                    <div class="tool-approval-details-label">Checked as</div>
                    <pre>@shown.Display</pre>
                }
                <div class="tool-approval-details-label">@Approval.Name · Arguments</div>
                <pre>@Approval.Arguments</pre>
                <p>Timeout: @Approval.TimeoutSeconds seconds. @(Approval.Name is "process_run" or "cs_run"
                    ? "It runs in a sandbox limited to the project's granted directories and the chat's temporary directory."
                    : "The process runs with your account's permissions; the working directory is not a sandbox.")</p>
                @if (Approval.BatchSize > 1)
                {
                    <p>Each call is confirmed separately.</p>
                }
            </div>
        </div>
    </div>
    @if (_approvalError is not null) { <p class="tool-approval-error" role="alert">@_approvalError</p> }
</section>

@code {
    [Parameter, EditorRequired] public ChatRunSnapshot Run { get; set; } = null!;
    [Parameter, EditorRequired] public ToolApproval Approval { get; set; } = null!;
    [Parameter] public string? ChatTitle { get; set; }

    private bool _decidingApproval;
    private bool _confirmGlobal;
    private bool _allowMenuOpen;
    private bool _detailsOpen;
    private string? _approvalError;
    private readonly string _detailsId = $"tool-approval-details-{Guid.NewGuid():N}";
    private readonly string _menuId = $"tool-approval-menu-{Guid.NewGuid():N}";
    private readonly string _scopeName = $"tool-approval-scope-{Guid.NewGuid():N}";
    private Guid _patternFor;
    private string? _pattern;
    private ElementReference _header;

    /// <summary>A new call starts from the narrowest useful pattern the Host offered, not the last choice.</summary>
    protected override void OnParametersSet()
    {
        if (_patternFor == Approval.Id) return;
        _patternFor = Approval.Id;
        _pattern = Approval.Command?.Options.FirstOrDefault();
    }

    private void ChoosePattern(string? pattern) => _pattern = pattern;

    private string Remembered => _pattern ?? Approval.Name;

    private string? CommandNotes()
    {
        if (Approval.Command is not { } command) return null;
        var notes = command.Rule is { } rule ? command.Warnings.Prepend($"The rule {rule} asks about this command.") : command.Warnings;
        return string.Join("\n", notes);
    }
    private IJSObjectReference? _summaryModule;
    private double? _headerTop;

    private async Task ToggleDetails()
    {
        _summaryModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/chatSummary.js");
        _headerTop = await _summaryModule.InvokeAsync<double?>("captureHeader", _header);
        _detailsOpen = !_detailsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_headerTop is not { } top || _summaryModule is null) return;
        _headerTop = null;
        await _summaryModule.InvokeVoidAsync("restoreHeader", _header, top);
    }

    public async ValueTask DisposeAsync()
    {
        if (_summaryModule is not null)
        {
            try { await _summaryModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
    private void ToggleAllowMenu()
    {
        if (_allowMenuOpen) CloseAllowMenu();
        else _allowMenuOpen = true;
    }
    private void CloseAllowMenu()
    {
        _allowMenuOpen = false;
        _confirmGlobal = false;
    }
    private void BeginGlobalApproval() => _confirmGlobal = true;
    private void CancelGlobalApproval() => _confirmGlobal = false;

    public bool CancelTransientUi()
    {
        if (_allowMenuOpen) { CloseAllowMenu(); return true; }
        if (_detailsOpen) { _detailsOpen = false; return true; }
        return false;
    }

    private async Task DecideAsync(ToolApprovalAction action)
    {
        _decidingApproval = true;
        _approvalError = null;
        CloseAllowMenu();
        var remembers = action is ToolApprovalAction.AllowForChat or ToolApprovalAction.AllowForProject or ToolApprovalAction.AllowGlobally;
        var pattern = remembers ? _pattern : null;
        try
        {
            await RunsApi.DecideToolAsync(Run.ProjectId, Run.ChatId, Run.BranchId,
                new ToolApprovalDecision(Approval.Id, action, pattern), CancellationToken.None);
            var saved = pattern is null ? "Tool permission" : "Command rule";
            var message = action switch
            {
                ToolApprovalAction.AllowForChat => $"{saved} saved for this chat.",
                ToolApprovalAction.AllowForProject => $"{saved} saved for this project.",
                ToolApprovalAction.AllowGlobally => $"{saved} saved globally.",
                _ => null
            };
            if (message is not null) Notifications.ShowSuccess(message);
        }
        // Only a conflict means the call stopped waiting. A failed connection or a server error
        // leaves the call pending, so the card stays answerable once the app is reachable again.
        catch (HttpRequestException error) when (error.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            _approvalError = "This approval is no longer available. Refresh the chat.";
            Notifications.ShowError(_approvalError);
        }
        catch (HttpRequestException)
        {
            _approvalError = "The app could not be reached, so the decision was not sent. Try again.";
            Notifications.ShowError(_approvalError);
        }
        finally { _decidingApproval = false; }
    }
}
