@inject AI.Web.Navigation.IAppControlHints ControlHints
@inject IProjectApi ProjectApi
@inject IChatHistoryApi ChatHistoryApi
@inject IGlobalSettingsApi GlobalSettingsApi
@inject INotificationService Notifications
@inject IToolDefaultDecision ToolDefaults

<div class="permissions-drawer-backdrop"></div>
<aside @attributes="@(ControlHints.Attributes(GuideTarget, nativeTooltip: false))" class="permissions-drawer" aria-label="Tool permissions" @onclick:stopPropagation="true">
    <header>
        <div><h2>Tool permissions</h2><p>@Scope · @Title</p></div>
        <button class="icon-action" type="button" title="Close" aria-label="Close permissions" @onclick="() => Close.InvokeAsync()"><AppIcon Name="drawer-close" /></button>
    </header>
    <nav class="permissions-tabs" aria-label="Permission view">
        <button @attributes="@(ControlHints.Attributes((GuideTarget + ".overrides"), "Show permission rules saved in this scope"))" class="@(!_showAll ? "selected" : string.Empty)" type="button" @onclick="() => _showAll = false">Overrides <span>@Overrides.Count</span></button>
        <button @attributes="@(ControlHints.Attributes((GuideTarget + ".effective")))" class="@(_showAll ? "selected" : string.Empty)" type="button" @onclick="() => _showAll = true">All effective</button>
    </nav>
    <div class="permissions-content">
        <p class="permissions-intro">@Description</p>
        @if (_loading)
        {
            <p class="empty-hint">Loading permissions…</p>
        }
        else if (VisiblePolicies.Count == 0 && VisibleRules.Count == 0)
        {
            <div class="permissions-empty"><AppIcon Name="tool" /><strong>@(_showAll ? "No tools available" : "No overrides")</strong><p>@(_showAll ? "No effective tool permissions could be listed." : "Tools use inherited permissions; select All effective to see them.")</p></div>
        }
        else
        {
            @foreach (var group in VisiblePolicies.GroupBy(item => item.ServerName))
            {
                <section class="permissions-group">
                    <h3><AppIcon Name="mcp" />@group.Key</h3>
                    @foreach (var policy in group)
                    {
                        <div class="permission-item">
                            <div>
                                <div class="permission-item-title"><code>@policy.Name</code><span class="permission-decision" title="Allow runs without asking; Ask requires approval; Deny refuses the tool call">@policy.Decision</span></div>
                                <p>
                                    <span title="@($"This rule comes from {policy.Source.ToLowerInvariant()} permissions; chat rules override project rules, which override global rules")">@policy.Source</span>
                                    @if (policy.Fallback is not null)
                                    {
                                        <span title="Decision that applies when this override is reset"> · fallback: @policy.Fallback</span>
                                    }
                                </p>
                                @if (Scope == "Branch")
                                {
                                    <select aria-label="Permission for @policy.Name" value="@policy.Decision"
                                            disabled="@_saving" @onchange="e => SetBranchPolicyAsync(policy, e.Value?.ToString())">
                                        <option value="Ask">Ask</option><option value="Allow">Allow</option><option value="Deny">Deny</option>
                                    </select>
                                }
                            </div>
                            @if (policy.CanReset)
                            {
                                <button class="icon-action" type="button" title="@ResetLabel" aria-label="@ResetLabel for @policy.Name" disabled="@_saving" @onclick="() => ResetAsync(policy)"><AppIcon Name="reset" /></button>
                            }
                        </div>
                    }
                </section>
            }
        }
        @* Command rules refine process_run by what it starts; they sit beside the tool's own permission. *@
        @if (!_loading)
        {
            <section class="permissions-group">
                <h3 title="Rules for the programs process_run starts; a matching rule decides inside the tool's own permission"><AppIcon Name="tool" />Command rules</h3>
                @foreach (var rule in VisibleRules)
                {
                    <div class="permission-item">
                        <div>
                            <div class="permission-item-title">
                                <code>@rule.Pattern</code>
                                @if (!OwnsRule(rule))
                                {
                                    <span class="permission-decision" title="Allow runs a matching command without asking; Ask requires approval; Deny refuses it">@rule.Decision</span>
                                }
                            </div>
                            <p><span title="@($"This rule comes from {rule.Scope.ToLowerInvariant()} command rules; a Deny wins, otherwise the most specific pattern decides")">@rule.Scope</span></p>
                            @if (OwnsRule(rule))
                            {
                                <select aria-label="Decision for @rule.Pattern" title="Allow runs a matching command without asking; Ask requires approval; Deny refuses it"
                                        value="@rule.Decision" disabled="@_saving" @onchange="e => ChangeRuleAsync(rule, e.Value?.ToString())">
                                    <option value="Allow">Allow</option><option value="Ask">Ask</option><option value="Deny">Deny</option>
                                </select>
                            }
                        </div>
                        @if (OwnsRule(rule))
                        {
                            <button class="icon-action" type="button" title="@($"Remove this {rule.Scope.ToLowerInvariant()} command rule")" aria-label="Remove command rule @rule.Pattern" disabled="@_saving" @onclick="() => RemoveRuleAsync(rule)"><AppIcon Name="reset" /></button>
                        }
                    </div>
                }
                <form class="command-rule-form" @onsubmit="AddRuleAsync" @onsubmit:preventDefault="true">
                    <input aria-label="Command pattern" placeholder="git diff *" spellcheck="false" autocomplete="off"
                           maxlength="2000" value="@_newPattern" @oninput="e => _newPattern = e.Value?.ToString() ?? string.Empty" disabled="@_saving" />
                    <select aria-label="Decision for the new command rule" @bind="_newDecision" disabled="@_saving">
                        <option value="Allow">Allow</option><option value="Ask">Ask</option><option value="Deny">Deny</option>
                    </select>
                    <select aria-label="Where the new command rule applies" @bind="NewScope" disabled="@_saving">
                        <option value="@RuleScope">@(RuleScope == CommandRule.Chat ? "This chat" : "This project")</option>
                        <option value="@CommandRule.Global">Every project</option>
                    </select>
                    <button type="submit" title="Save this command rule" disabled="@(_saving || string.IsNullOrWhiteSpace(_newPattern))">Add</button>
                </form>
                <p class="command-rule-hint">The program's name, then its arguments word by word. <code>*</code> or <code>?</code> inside a word is a mask; a lone <code>*</code> at the end allows any further arguments. A Deny always wins; otherwise the most specific rule decides.</p>
            </section>
        }
        @if (_error is not null) { <p class="error" role="alert">@_error</p> }
    </div>
    <footer>
        <span>@FooterText</span>
        @if (Overrides.Count > 0)
        {
            <button class="secondary-action permissions-reset-all" type="button" title="@($"Reset all {Scope.ToLowerInvariant()} overrides to inherited defaults")" disabled="@_saving" @onclick="ResetAllAsync">Reset all</button>
        }
    </footer>
</aside>

@code {
    private string GuideTarget => Scope == "Chat" ? "chat.permissions" : "project.permissions";
    [Parameter, EditorRequired] public string Scope { get; set; } = "Project";
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public Guid? ChatId { get; set; }
    [Parameter] public Guid? BranchId { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public EventCallback Close { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private GlobalSettings? _global;
    private ProjectDetails? _project;
    private ChatDetails? _chat;
    private IReadOnlyList<McpToolInfo> _builtInTools = [];
    private IReadOnlyList<CommandRule> _rules = [];
    private bool _showAll;
    private bool _loading;
    private bool _saving;
    private string? _error;
    private string? _loadedKey;

    private string Description => Scope == "Branch"
        ? "Permissions for this branch override its parent and chat. Reset restores the inherited rule."
        : Scope == "Chat"
        ? "Permissions saved for this chat. Resetting one restores the project or global default."
        : "Permissions saved for this project. Resetting one restores the global MCP default.";
    private string ResetLabel => Scope is "Chat" or "Branch" ? "Reset to inherited default" : "Reset to global default";
    private string FooterText => $"{Overrides.Count} {Scope.ToLowerInvariant()} override{(Overrides.Count == 1 ? string.Empty : "s")}";
    private IReadOnlyList<ViewPolicy> Overrides => BuildOverrides();
    private IReadOnlyList<ViewPolicy> VisiblePolicies => _showAll ? BuildEffective() : Overrides;

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Scope}:{ProjectId}:{ChatId}:{BranchId}";
        if (_loadedKey == key) return;
        _loadedKey = key;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _global = await GlobalSettingsApi.GetAsync(CancellationToken.None);
            _project = await ProjectApi.GetAsync(ProjectId, CancellationToken.None);
            _chat = ChatId is { } chatId
                ? await ChatHistoryApi.GetTranscriptAsync(ProjectId, chatId, CancellationToken.None) : null;
            _builtInTools = await GlobalSettingsApi.GetDefaultToolsAsync(CancellationToken.None);
            _rules = await GlobalSettingsApi.GetCommandRulesAsync(ProjectId, ChatId, CancellationToken.None);
        }
        catch (HttpRequestException) { _error = "Permissions could not be loaded."; }
        finally { _loading = false; }
    }

    private IReadOnlyList<ViewPolicy> BuildOverrides()
    {
        if (Scope == "Branch")
            return (CurrentBranch?.Settings?.ToolPolicies ?? [])
                .Select(item => View(item, "Branch", true, BranchFallback(item))).ToArray();
        if (Scope == "Chat")
            return (_chat?.ToolPolicies ?? []).Select(item => View(item, "Chat", true, ProjectFallback(item))).ToArray();
        return (_project?.ToolPolicies ?? []).Select(item => View(item, "Project", true, GlobalFallback(item))).ToArray();
    }

    private IReadOnlyList<ViewPolicy> BuildEffective()
    {
        var policies = new Dictionary<(Guid, string, string), ViewPolicy>();
        foreach (var tool in _builtInTools)
        {
            var server = _global?.McpServers.SingleOrDefault(item => item.Id == tool.ServerId);
            if (server is not { Enabled: true } || server.Policy == "Deny"
                || _project?.McpServers.SingleOrDefault(item => item.Id == tool.ServerId) is { Enabled: false }) continue;
            policies[(tool.ServerId, tool.Name, tool.SchemaHash)] = new ViewPolicy(
                tool.ServerId, tool.Name, tool.SchemaHash, ToolDefaults.GetDecision(tool.ServerId, tool.Name),
                server.Name, "Default", false, null);
        }
        foreach (var item in _global?.ToolPolicies ?? []) policies[(item.ServerId, item.Name, item.SchemaHash)] =
            new ViewPolicy(item.ServerId, item.Name, item.SchemaHash, item.Decision, ServerName(item.ServerId), "Global", false, null);
        foreach (var item in _project?.ToolPolicies ?? []) policies[(item.ServerId, item.Name, item.SchemaHash)] = View(item, "Project", Scope == "Project", GlobalFallback(item));
        if (Scope is "Chat" or "Branch") foreach (var item in _chat?.ToolPolicies ?? []) policies[(item.ServerId, item.Name, item.SchemaHash)] = View(item, "Chat", Scope == "Chat", ProjectFallback(item));
        if (Scope == "Branch")
            foreach (var branch in BranchLineage().Reverse())
                foreach (var item in branch.Settings?.ToolPolicies ?? [])
                    policies[(item.ServerId, item.Name, item.SchemaHash)] = View(item,
                        branch.Id == BranchId ? "Branch" : branch.Title, branch.Id == BranchId, BranchFallback(item));
        return policies.Values.OrderBy(item => item.ServerName).ThenBy(item => item.Name).ToArray();
    }

    private ViewPolicy View(ToolPolicySettings item, string source, bool canReset, string? fallback) =>
        new(item.ServerId, item.Name, item.SchemaHash, item.Decision, ServerName(item.ServerId), source, canReset, fallback);
    private string ServerName(Guid id) => _global?.McpServers.SingleOrDefault(item => item.Id == id)?.Name ?? "MCP server";
    private string? GlobalFallback(ToolPolicySettings item) => _global?.ToolPolicies.SingleOrDefault(policy => Same(policy, item))?.Decision
        ?? ToolDefaults.GetDecision(item.ServerId, item.Name);
    private string? ProjectFallback(ToolPolicySettings item) => _project?.ToolPolicies.SingleOrDefault(policy => Same(policy, item))?.Decision ?? GlobalFallback(item);
    private ChatBranchView? CurrentBranch => _chat?.Branches?.FirstOrDefault(branch => branch.Id == BranchId);
    private IEnumerable<ChatBranchView> BranchLineage()
    {
        if (_chat is null || BranchId is not { } id) yield break;
        var branches = (_chat.Branches ?? []).ToDictionary(branch => branch.Id);
        var visited = new HashSet<Guid>();
        while (id != _chat.Id && visited.Add(id) && branches.TryGetValue(id, out var branch))
        {
            yield return branch;
            id = branch.ParentBranchId ?? _chat.Id;
        }
    }
    private string? BranchFallback(ToolPolicySettings item) => BranchLineage().Skip(1)
        .SelectMany(branch => branch.Settings?.ToolPolicies ?? []).FirstOrDefault(policy => Same(policy, item))?.Decision
        ?? _chat?.ToolPolicies?.FirstOrDefault(policy => Same(policy, item))?.Decision ?? ProjectFallback(item);
    private static bool Same(McpToolPolicySettings left, ToolPolicySettings right) => left.ServerId == right.ServerId && left.Name == right.Name && left.SchemaHash == right.SchemaHash;
    private static bool Same(ToolPolicySettings left, ToolPolicySettings right) => left.ServerId == right.ServerId && left.Name == right.Name && left.SchemaHash == right.SchemaHash;

    /// <summary>A branch has no command rules of its own; it shows and edits its chat's.</summary>
    private string RuleScope => Scope == "Branch" ? CommandRule.Chat : Scope;
    private IReadOnlyList<CommandRule> VisibleRules => _rules
        .Where(rule => _showAll || rule.Scope == RuleScope)
        .OrderBy(rule => rule.Scope == CommandRule.Chat ? 0 : rule.Scope == CommandRule.Project ? 1 : 2)
        .ThenBy(rule => rule.Pattern, StringComparer.Ordinal)
        .ToArray();
    /// <summary>
    /// The drawer's own rules, and global ones: settings have no other place that lists them, so
    /// a global rule saved from a card is removed where it shows.
    /// </summary>
    private bool OwnsRule(CommandRule rule) => rule.Scope == RuleScope || rule.Scope == CommandRule.Global;

    private string _newPattern = string.Empty;
    private string _newDecision = "Allow";
    private string? _newScopeChoice;
    private string NewScope
    {
        get => _newScopeChoice ?? RuleScope;
        set => _newScopeChoice = value;
    }

    private Task AddRuleAsync() => SaveRuleAsync(NewScope, _newPattern, _newDecision, "Command rule saved.", () => _newPattern = string.Empty);

    /// <summary>Saving the same scope and pattern again replaces the rule, which is how its decision changes.</summary>
    private Task ChangeRuleAsync(CommandRule rule, string? decision) => decision is "Allow" or "Ask" or "Deny" && decision != rule.Decision
        ? SaveRuleAsync(rule.Scope, rule.Pattern, decision, "Command rule updated.", null)
        : Task.CompletedTask;

    private async Task SaveRuleAsync(string scope, string pattern, string decision, string message, Action? saved)
    {
        _saving = true;
        _error = null;
        try
        {
            var rule = await GlobalSettingsApi.AddCommandRuleAsync(new CreateCommandRuleRequest(scope,
                scope == CommandRule.Global ? null : ProjectId, scope == CommandRule.Chat ? ChatId : null,
                pattern.Trim(), decision), CancellationToken.None);
            _rules = _rules.Where(item => !(item.Scope == rule.Scope && item.ProjectId == rule.ProjectId
                    && item.ChatId == rule.ChatId && item.Pattern == rule.Pattern))
                .Append(rule).ToArray();
            saved?.Invoke();
            Notifications.ShowSuccess(message);
            await Changed.InvokeAsync();
        }
        // The Host explains a pattern it refuses ("A command pattern starts with the program's name…").
        catch (InvalidOperationException error) { _error = error.Message; }
        catch (HttpRequestException) { _error = "The command rule could not be saved."; }
        finally { _saving = false; }
    }

    private async Task RemoveRuleAsync(CommandRule rule)
    {
        _saving = true;
        _error = null;
        try
        {
            await GlobalSettingsApi.RemoveCommandRuleAsync(rule.Id, CancellationToken.None);
            _rules = _rules.Where(item => item.Id != rule.Id).ToArray();
            Notifications.ShowSuccess("Command rule removed.");
            await Changed.InvokeAsync();
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _error = "The command rule could not be removed.";
            Notifications.ShowError(_error);
        }
        finally { _saving = false; }
    }

    private async Task ResetAsync(ViewPolicy policy)
    {
        if (await ResetPolicyAsync(policy)) Notifications.ShowSuccess("Tool permission reset.");
        else Notifications.ShowError(_error ?? "Permission could not be reset.");
    }

    private async Task<bool> ResetPolicyAsync(ViewPolicy policy)
    {
        _saving = true;
        _error = null;
        try
        {
            if (Scope == "Branch")
            {
                await SetBranchPolicyAsync(policy, null);
                if (_error is not null) return false;
            }
            else if (Scope == "Chat" && ChatId is { } chatId)
                _chat = await ChatHistoryApi.RemoveToolPolicyAsync(ProjectId, chatId, policy.ServerId, policy.Name, policy.SchemaHash, CancellationToken.None);
            else
                _project = await ProjectApi.RemoveToolPolicyAsync(ProjectId, policy.ServerId, policy.Name, policy.SchemaHash, CancellationToken.None);
            if ((Scope is "Chat" or "Branch" && _chat is null) || (Scope == "Project" && _project is null))
            {
                _error = "Permission could not be reset.";
                return false;
            }
            await Changed.InvokeAsync();
            return true;
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _error = "Permission could not be reset.";
            return false;
        }
        finally { _saving = false; }
    }

    private async Task SetBranchPolicyAsync(ViewPolicy policy, string? decision)
    {
        if (ChatId is not { } chatId || BranchId is not { } branchId || CurrentBranch is not { } branch) return;
        _saving = true;
        _error = null;
        try
        {
            var previous = branch.Settings ?? new BranchSettings();
            var policies = (previous.ToolPolicies ?? []).Where(item => !(item.ServerId == policy.ServerId
                && item.Name == policy.Name && item.SchemaHash == policy.SchemaHash)).ToList();
            if (decision is "Allow" or "Ask" or "Deny")
            {
                var old = previous.ToolPolicies?.FirstOrDefault(item => item.ServerId == policy.ServerId
                    && item.Name == policy.Name && item.SchemaHash == policy.SchemaHash);
                policies.Add(new ToolPolicySettings(policy.ServerId, policy.Name, policy.SchemaHash, decision,
                    old?.MaxCallsPerRun, old?.TimeoutSeconds));
            }
            _chat = await ChatHistoryApi.UpdateBranchSettingsAsync(ProjectId, chatId, branchId,
                new UpdateBranchSettingsRequest(previous with { ToolPolicies = policies }), CancellationToken.None);
            if (_chat is null) _error = "Branch permissions could not be saved.";
            else await Changed.InvokeAsync();
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _error = "Branch permissions could not be saved.";
        }
        finally { _saving = false; }
    }

    private async Task ResetAllAsync()
    {
        var resetCount = 0;
        foreach (var policy in Overrides.ToArray())
        {
            if (!await ResetPolicyAsync(policy))
            {
                Notifications.ShowError(_error ?? "Permissions could not be reset.");
                return;
            }
            resetCount++;
        }
        if (resetCount > 0) Notifications.ShowSuccess("Tool permissions reset.");
    }

    private sealed record ViewPolicy(Guid ServerId, string Name, string SchemaHash, string Decision,
        string ServerName, string Source, bool CanReset, string? Fallback);
}
