@ChildContent

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public Guid? ChatId { get; set; }
    [Parameter] public long ChatRevision { get; set; }
    [Parameter] public Guid? BranchLeafId { get; set; }
    // The transient accent line is the one piece of transcript state that changes on its own,
    // with nothing else moving: it is dropped by a timer a few seconds after the answer lands.
    // Without it here the boundary blocks that render and the line stays on screen for good.
    [Parameter] public Guid? JustArrivedLeafId { get; set; }
    [Parameter] public Guid? ForkSourceId { get; set; }
    [Parameter] public Guid? BranchMenuId { get; set; }
    [Parameter] public int RunPresentationVersion { get; set; }
    [Parameter] public int ExpandedTurnsVersion { get; set; }
    [Parameter] public int? TurnElapsedSeconds { get; set; }
    // The running turn's live text moves on its own clock: it grows with each draft publication and
    // switches when a reading delay runs out, neither of which changes the chat revision.
    [Parameter] public int LiveTextVersion { get; set; }
    [Parameter] public int ReviewVersion { get; set; }
    // What turns used and where the model's view of the chat begins arrive from the Host's ledger,
    // after the messages they describe, and change nothing else the boundary watches.
    [Parameter] public int UsageVersion { get; set; }
    private Guid? _renderedChatId;
    private long _renderedChatRevision = -1;
    private Guid? _renderedBranchLeafId;
    private Guid? _renderedJustArrivedLeafId;
    private Guid? _renderedForkSourceId;
    private Guid? _renderedBranchMenuId;
    private int _renderedRunPresentationVersion;
    private int _renderedExpandedTurnsVersion;
    private int? _renderedTurnElapsedSeconds;
    private int _renderedLiveTextVersion;
    private int _renderedReviewVersion;
    private int _renderedUsageVersion;

    protected override bool ShouldRender()
    {
        var changed = _renderedChatId != ChatId
            || _renderedChatRevision != ChatRevision
            || _renderedBranchLeafId != BranchLeafId
            || _renderedJustArrivedLeafId != JustArrivedLeafId
            || _renderedForkSourceId != ForkSourceId
            || _renderedBranchMenuId != BranchMenuId
            || _renderedRunPresentationVersion != RunPresentationVersion
            || _renderedExpandedTurnsVersion != ExpandedTurnsVersion
            || _renderedTurnElapsedSeconds != TurnElapsedSeconds
            || _renderedLiveTextVersion != LiveTextVersion
            || _renderedReviewVersion != ReviewVersion
            || _renderedUsageVersion != UsageVersion;

        _renderedChatId = ChatId;
        _renderedChatRevision = ChatRevision;
        _renderedBranchLeafId = BranchLeafId;
        _renderedJustArrivedLeafId = JustArrivedLeafId;
        _renderedForkSourceId = ForkSourceId;
        _renderedBranchMenuId = BranchMenuId;
        _renderedRunPresentationVersion = RunPresentationVersion;
        _renderedExpandedTurnsVersion = ExpandedTurnsVersion;
        _renderedTurnElapsedSeconds = TurnElapsedSeconds;
        _renderedLiveTextVersion = LiveTextVersion;
        _renderedReviewVersion = ReviewVersion;
        _renderedUsageVersion = UsageVersion;
        return changed;
    }
}
