@inject IUsagePresentation Usage
@* One quiet line under an opened turn: what it cost and where. Requests made for the turn's own
   housekeeping — routing, approval checks, summaries — are counted apart from its answer and its
   subtasks, since that is where a turn that looked short usually spent. *@
<p class="turn-usage" aria-label="Token usage of this turn">
    <span title="All model requests recorded for this turn, including subtasks and background work">@Turn.Totals.Requests @(Turn.Totals.Requests == 1 ? "request" : "requests")</span>
    <span title="Input tokens sent across this turn's requests, including cached input; ≈ includes estimates where the endpoint did not report usage">in @(Estimated ? "≈" : null)@Usage.FormatExact(Turn.Totals.Tokens.InputTokens)@if (Usage.CachePercent(Turn.Totals.Tokens) is > 0 and var cache) { <small title="Share of input tokens served from the provider's cache"> (@cache% cached)</small> }</span>
    @if (Usage.FormatPrefixChanges(Turn.Totals) is { } changes) { <span title="Requests whose start differed from the request before them, which costs the provider's cache">cache reset by @changes</span> }
    <span title="Output tokens recorded across this turn's requests; ≈ includes estimates where the endpoint did not report usage">out @(Estimated ? "≈" : null)@Usage.FormatExact(Turn.Totals.Tokens.OutputTokens)</span>
    @if (Turn.Totals.Tokens.ReasoningTokens > 0) { <span title="@($"{Usage.FormatExact(Turn.Totals.Tokens.ReasoningTokens)} reasoning tokens reported by the endpoint for this turn")">reasoning @Usage.FormatTokens(Turn.Totals.Tokens.ReasoningTokens)</span> }
    @if (Part(nameof(TokenUsagePurpose.Subtask)) is { } subtasks) { <span title="Input → output tokens used by delegated model requests in this turn">subtasks @Usage.FormatFlow(subtasks)</span> }
    @if (Background() is { } background) { <span title="@($"{Usage.FormatExact(background)} input and output tokens used by skill routing, approval checks and summaries")">background @Usage.FormatTokens(background)</span> }
    @if (Usage.OutputSpeed(Turn.Totals) is { } speed) { <span title="Output tokens divided by total recorded request duration for this turn">@speed tok/s</span> }
    @if (Usage.FormatCost(Turn.Totals) is { } cost) { <span title="Cost of priced requests in this turn; unpriced requests are excluded and ≈ marks estimated costs">@cost</span> }
</p>

@code {
    private static readonly string[] BackgroundPurposes =
    [
        nameof(TokenUsagePurpose.Routing), nameof(TokenUsagePurpose.ToolRisk),
        nameof(TokenUsagePurpose.Checkpoint), nameof(TokenUsagePurpose.Compaction)
    ];

    [Parameter, EditorRequired]
    public TurnTokenUsage Turn { get; set; } = null!;

    private bool Estimated => Usage.IsEstimated(Turn.Totals);

    private TokenUsageTotals? Part(string key) =>
        Turn.ByPurpose.FirstOrDefault(slice => slice.Key == key)?.Totals;

    private long? Background()
    {
        var tokens = Turn.ByPurpose.Where(slice => BackgroundPurposes.Contains(slice.Key))
            .Sum(slice => slice.Totals.Tokens.InputTokens + slice.Totals.Tokens.OutputTokens);
        return tokens > 0 ? tokens : null;
    }
}
