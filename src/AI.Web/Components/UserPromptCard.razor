@* The model has asked the person something and the run is holding still until they answer. It sits
   inline at the end of the transcript rather than over it: the question belongs to this chat, and
   the other chats in the window are still working. *@
@using AI.Contracts.Runs
@using AI.Contracts.Schedules
@inject IScheduleCalendar ScheduleCalendar
@inject IUserPromptInputs Inputs
@using AI.Web.FileSystem
@using AI.Web.Markdown
@inject IJSRuntime JsRuntime
@implements IDisposable

<section class="@CssClass" role="region" aria-label="Question from the assistant" @onkeydown="HandleKeyDownAsync" @onfocusin="PauseDefaults">
    <div class="user-prompt-heading chat-card-header">
        <span class="chat-card-mark" aria-hidden="true"><AppIcon Name="info" /></span>
        <strong class="user-prompt-title chat-card-title">@(Prompt.Questions.Count > 1 ? $"Questions ({Prompt.Questions.Count})" : "Question")</strong>
    </div>
    <div class="user-prompt-content">
    @for (var index = 0; index < Prompt.Questions.Count; index++)
    {
        var questionIndex = index;
        var question = Prompt.Questions[questionIndex];
        <fieldset class="user-prompt-question" @onfocusin="() => _active = questionIndex">
            <legend>
                @if (question.Label is { Length: > 0 } label)
                {
                    <span class="user-prompt-chip">@label</span>
                }
                <AppNavigationText Text="@question.Text" OnNavigateApp="@OnNavigateApp" />
            </legend>
            @if (Prompt.ReplyButtons)
            {
                @* Each option is the answer itself, so it is a button rather than a radio: the send
                   arrow on its edge, the one the composer's send button carries, says that pressing
                   it sends, and there is no Answer button below to look for. *@
                <div class="user-prompt-replies">
                    @for (var option = 0; option < question.Options.Count; option++)
                    {
                        var optionIndex = option;
                        var choice = question.Options[optionIndex];
                        var chosen = _sending && _chosen == optionIndex;
                        <button class="@ReplyClass(choice, optionIndex)" type="button" disabled="@_sending"
                                aria-keyshortcuts="@(optionIndex < 9 ? (optionIndex + 1).ToString() : null)"
                                @onclick="() => ReplyAsync(optionIndex)">
                            @if (optionIndex < 9)
                            {
                                <kbd class="user-prompt-reply-key" aria-hidden="true">@(optionIndex + 1)</kbd>
                            }
                            <span class="user-prompt-reply-text">
                                <span class="user-prompt-reply-label">@choice.Label</span>
                                @if (choice.Description is { Length: > 0 } description)
                                {
                                    <span class="user-prompt-reply-description">@description</span>
                                }
                            </span>
                            <span class="user-prompt-reply-send" aria-hidden="true">
                                <AppIcon Name="@(chosen ? "spinner" : "arrow-up")" Class="@(chosen ? "tool-row-spinner" : null)" />
                            </span>
                        </button>
                    }
                </div>
                @if (question.AllowOther)
                {
                    <label class="user-prompt-reply-other">
                        <span class="visually-hidden">Your own answer</span>
                        <input class="user-prompt-other-input" type="text" disabled="@_sending"
                               placeholder="Or type your own answer and press Enter"
                               value="@_other[questionIndex]"
                               @oninput="args => TypeOther(questionIndex, args)"
                               @onfocus="() => _typing = true" @onblur="() => _typing = false"
                               @onkeydown="args => TypeReplyKeyAsync(questionIndex, args)" @onkeydown:stopPropagation="true" />
                    </label>
                }
            }
            else if (question.Input is { } input)
            {
                @InputField(questionIndex, question, input)
            }
            else
            {
            @for (var option = 0; option < question.Options.Count; option++)
            {
                var optionIndex = option;
                var choice = question.Options[optionIndex];
                <label class="user-prompt-option">
                    <input type="@(question.MultiSelect ? "checkbox" : "radio")"
                           name="@($"{Prompt.Id}-{question.Id}")"
                           checked="@IsSelected(questionIndex, optionIndex)"
                           disabled="@_sending"
                           @onchange="args => Select(questionIndex, optionIndex, question.MultiSelect, args)" />
                    <span>
                        <span class="user-prompt-option-label">@choice.Label</span>
                        @if (choice.Description is { Length: > 0 } description)
                        {
                            <span class="user-prompt-option-description">@description</span>
                        }
                    </span>
                    @if (DigitTarget == questionIndex && optionIndex < 9)
                    {
                        <kbd class="user-prompt-option-key" aria-hidden="true">@(optionIndex + 1)</kbd>
                    }
                </label>
            }
            @if (SchedulePickers.IsSchedulePicker(question.PickerKind))
            {
                <SchedulePickerField Kind="@(question.PickerKind!)" MultiSelect="@question.MultiSelect" Disabled="@_sending"
                                     Label="@question.Label" Values="@_values[questionIndex]"
                                     ValuesChanged="values => SchedulePicked(questionIndex, values)" />
            }
            else if (question.PickerKind is "branch" or "commit")
            {
                <div class="user-prompt-paths">
                    @if (_values[questionIndex].Count > 0)
                    {
                        <ul>
                            @foreach (var value in _values[questionIndex])
                            {
                                <li><span title="@value">@value</span><button class="icon-action" type="button" title="Remove selection" aria-label="Remove @value" disabled="@_sending" @onclick="() => _values[questionIndex].Remove(value)"><AppIcon Name="x" /></button></li>
                            }
                        </ul>
                    }
                    <button class="secondary-action compact-action" type="button" disabled="@_sending" @onclick="() => _gitPickerQuestion = questionIndex" @onkeydown:stopPropagation="true">
                        <AppIcon Name="@(question.PickerKind == "branch" ? "git-branch" : "git-commit")" /> Select @(question.PickerKind == "branch" ? (question.MultiSelect ? "branches" : "branch") : (question.MultiSelect ? "commits" : "commit"))…
                    </button>
                </div>
            }
            else if (PathMode(question) is { } mode)
            {
                @if (IsMultiplePaths(question))
                {
                    <div class="user-prompt-paths">
                        @if (_paths[questionIndex].Count > 0)
                        {
                            <ul>
                                @foreach (var path in _paths[questionIndex])
                                {
                                    <li>
                                        <span title="@path">@path</span>
                                        <button class="icon-action" type="button" title="Remove from list"
                                                aria-label="Remove @path from the list" disabled="@_sending"
                                                @onclick="() => RemovePath(questionIndex, path)"><AppIcon Name="x" /></button>
                                    </li>
                                }
                            </ul>
                        }
                        <button class="secondary-action compact-action" type="button" disabled="@_sending"
                                @onclick="() => OpenPicker(questionIndex, mode)" @onkeydown:stopPropagation="true">
                            <AppIcon Name="folder-plus" /> Add directory
                        </button>
                    </div>
                }
                else
                {
                @* A path is the one answer nobody should be typing from memory, so the free-text
                   slot becomes a box with the host's own file browser behind it. It still travels
                   as free text, which is why the model needs no new answer shape to read it. *@
                <label class="user-prompt-option user-prompt-other user-prompt-path">
                    <input type="@(question.MultiSelect ? "checkbox" : "radio")"
                           name="@($"{Prompt.Id}-{question.Id}")"
                           checked="@(_other[questionIndex] is { Length: > 0 })"
                           disabled="@_sending"
                           @onchange="args => SelectOther(questionIndex, question.MultiSelect, args)" />
                    <span>
                        <span class="user-prompt-option-label">@(mode == DirectoryPickerMode.File ? "File" : "Directory")</span>
                        <span class="user-prompt-path-row">
                            <input class="user-prompt-other-input" type="text" disabled="@_sending"
                                   placeholder="@(mode == DirectoryPickerMode.File ? "Path to a file" : "Path to a directory")"
                                   aria-label="@(mode == DirectoryPickerMode.File ? "File path" : "Directory path")"
                                   value="@_other[questionIndex]"
                                   @onfocus="() => _typing = true" @onblur="() => _typing = false"
                               @oninput="args => TypeOther(questionIndex, args)" />
                            <button class="secondary-action compact-action" type="button" disabled="@_sending"
                                    @onclick="() => OpenPicker(questionIndex, mode)" @onkeydown:stopPropagation="true">Browse…</button>
                        </span>
                    </span>
                </label>
                }
            }
            @if (question.AllowOther && PathMode(question) is null)
            {
                <label class="user-prompt-option user-prompt-other">
                    <input type="@(question.MultiSelect ? "checkbox" : "radio")"
                           name="@($"{Prompt.Id}-{question.Id}")"
                           checked="@(_other[questionIndex] is { Length: > 0 })"
                           disabled="@_sending"
                           @onchange="args => SelectOther(questionIndex, question.MultiSelect, args)" />
                    <span>
                        <span class="user-prompt-option-label">@(question.Options.Count == 0 ? "Your answer" : "Other")</span>
                        <input class="user-prompt-other-input" type="text" disabled="@_sending"
                               placeholder="Type your answer"
                               value="@_other[questionIndex]"
                               @onfocus="() => _typing = true" @onblur="() => _typing = false"
                               @oninput="args => TypeOther(questionIndex, args)" />
                    </span>
                </label>
            }
            }
            @if (question.Preview is { } template && Inputs.RenderPreview(template, PreviewValues(questionIndex)) is { Length: > 0 } preview)
            {
                <p class="user-prompt-preview" aria-live="polite"><AppIcon Name="eye" /><span>@preview</span></p>
            }
            @if (question.Rememberable && !Prompt.ReplyButtons)
            {
                <label class="user-prompt-remember" title="The assistant saves your answer to memory and does not ask this again">
                    <input type="checkbox" checked="@_remember[questionIndex]" disabled="@_sending"
                           @onchange="args => _remember[questionIndex] = args.Value is true" />
                    <span>Remember my answer</span>
                </label>
            }
        </fieldset>
    }
    <p class="user-prompt-note @(IsReady && !Prompt.ReplyButtons ? "ready" : null)" role="status" aria-live="polite">
        @if (Prompt.ReplyButtons)
        {
            <span class="user-prompt-reply-hint"><AppIcon Name="zap" /><span>Click an answer to send it right away, or press <kbd>1</kbd>–<kbd>@Math.Min(9, Prompt.Questions[0].Options.Count)</kbd>.@(Prompt.Presentation == "overlay" && IsTimed
                ? " If none is picked in time, nothing is chosen and no action is taken." : null)</span></span>
        }
        else if (IsReady)
        {
            <span>All questions answered. Press <kbd>Enter</kbd> to continue.</span>
        }
        else if (Prompt.Presentation == "overlay" && IsTimed)
        {
            <span>This question expires automatically. No action will be taken without an answer.</span>
        }
        else
        {
            <span>Answer what matters to you — anything you leave blank is left to the assistant to decide.@if (DigitCount(DigitTarget) is > 1 and var digits)
                {
                    <text> Press <kbd>1</kbd>–<kbd>@digits</kbd> to pick in the question you are on.</text>
                }</span>
        }
    </p>
    @* The countdown reads like the guide step's: a timer line, a bar that drains along the bottom
       edge, and a warning in the last seconds — accent when the defaults are about to be sent,
       amber when the question is about to close unanswered. *@
    @if (_secondsLeft is { } seconds)
    {
        <div class="user-prompt-timeout" role="timer" aria-live="off"><AppIcon Name="timer" />@(AutoContinue
            ? "Continues with recommended answers" : "Closes automatically") in @(seconds / 60):@((seconds % 60).ToString("00"))</div>
    }
    <div class="user-prompt-actions">
        @* Two ways not to answer, and they mean opposite things: "decide yourself" hands the choice
           over and the work goes on, "decline" refuses it and the work stops until they say more. *@
        <button class="secondary-action user-prompt-decline chat-card-action chat-card-action-danger" type="button" disabled="@_sending" @onclick="DeclineAsync" @onkeydown:stopPropagation="true"
                title="Don't answer and stop the assistant here"><span>Decline</span></button>
        @if (Prompt.Presentation != "overlay")
        {
            <button class="secondary-action chat-card-action" type="button" disabled="@_sending" @onclick="DismissAsync" @onkeydown:stopPropagation="true"
                    title="Let the assistant choose and carry on"><span>Decide yourself</span></button>
        }
        @if (!Prompt.ReplyButtons)
        {
        <button @ref="_submitButton" class="user-prompt-submit chat-card-action chat-card-action-primary" type="button" disabled="@_sending" @onclick="AnswerAsync" @onkeydown:stopPropagation="true"
                title="@(AutoContinue ? "Pressed automatically when the time runs out" : null)">
            @if (_sending)
            {
                <span>Continuing…</span>
            }
            else if (IsReady)
            {
                <span>Continue <kbd aria-hidden="true">Enter ↵</kbd></span>
            }
            else
            {
                <span>Answer</span>
            }
        </button>
        }
    </div>
    @if (_error is not null) { <p class="user-prompt-error" role="alert">@_error</p> }
    @if (_secondsLeft is not null)
    {
        <div class="user-prompt-progress" aria-hidden="true"><span style="transform: scaleX(@Remaining.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))"></span></div>
    }
    </div>
</section>

@if (_pickerQuestion is { } picking)
{
    <DirectoryPickerDialog Mode="_pickerMode" StartPath="@PickerStartPath(picking)"
                           Subtitle="@Prompt.Questions[picking].Label"
                           Selected="path => PickedAsync(picking, path)" Cancelled="ClosePicker" />
}
@if (_gitPickerQuestion is { } gitPicking)
{
    var question = Prompt.Questions[gitPicking];
    <GitPickerDialog @key="gitPicking" Kind="@(question.PickerKind!)" RepositoryPath="@(question.RepositoryPath!)"
                     Revision="@question.Revision" MultiSelect="@question.MultiSelect" Values="@_values[gitPicking]"
                     Selected="values => GitPickedAsync(gitPicking, values)" Cancelled="() => _gitPickerQuestion = null" />
}

@code {
    [Parameter, EditorRequired] public UserPrompt Prompt { get; set; } = default!;
    [Parameter] public EventCallback<string> OnNavigateApp { get; set; }

    /// <summary>Sends the answer; returns false when the prompt is no longer the one being waited on.</summary>
    [Parameter, EditorRequired] public Func<UserPromptResponse, Task<bool>> OnAnswer { get; set; } = default!;

    private readonly Dictionary<int, HashSet<int>> _selected = [];
    private readonly Dictionary<int, string> _other = [];
    private readonly Dictionary<int, List<string>> _paths = [];
    private readonly Dictionary<int, List<string>> _values = [];
    private readonly Dictionary<int, List<int>> _order = [];
    private readonly Dictionary<int, bool> _remember = [];
    private int? _active;
    private bool _typing;
    private bool _sending;
    private int? _chosen;
    private string? _error;
    private Guid _rendered;
    private int? _pickerQuestion;
    private int? _gitPickerQuestion;
    private DirectoryPickerMode _pickerMode;
    private CancellationTokenSource? _timer;
    private int? _secondsLeft;
    private bool _defaultsPaused;

    private int _totalSeconds;
    private ElementReference _submitButton;
    private bool _pressed;
    private static readonly TimeSpan PressLead = TimeSpan.FromMilliseconds(1200);

    private async Task PressSubmitAsync()
    {
        try
        {
            var module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/appGuide.js");
            await module.InvokeAsync<bool>("press", _submitButton);
        }
        catch (Exception error) when (error is JSException or InvalidOperationException or TaskCanceledException) { }
    }
    private bool? _countingAuto;

    private void PauseDefaults() => _defaultsPaused = true;

    /// <summary>When the time runs out the recommended answers are sent, as if Continue was pressed.</summary>
    private bool AutoContinue => Prompt.SubmitDefaults && !_defaultsPaused;

    private bool Expiring => _secondsLeft <= AppGuideStep.ExpiringSeconds;

    // A question asked without a time limit (the guide waiting while the person gets a view ready)
    // arrives with no expiry and a zero timeout; counting down from zero would close it at once.
    private bool IsTimed => Prompt.ExpiresAt is not null || Prompt.TimeoutSeconds > 0;

    private string CssClass => $"user-prompt{(_secondsLeft is not null ? " is-timed" : null)}{(AutoContinue ? " is-auto" : null)}{(_secondsLeft is not null && Expiring ? " is-expiring" : null)}";

    private double Remaining => Math.Clamp((double)(_secondsLeft ?? 0) / Math.Max(1, _totalSeconds), 0, 1);

    private async Task CountDownAsync(Guid promptId, CancellationToken token)
    {
        if (Prompt.TimeoutSeconds <= 0 && Prompt.ExpiresAt is null) return;
        var expiry = Prompt.ExpiresAt ?? DateTimeOffset.UtcNow.AddSeconds(Prompt.TimeoutSeconds);
        try
        {
            while (!token.IsCancellationRequested && _rendered == promptId)
            {
                var deadline = AutoContinue ? Prompt.DefaultSubmitAt ?? expiry : expiry;
                _secondsLeft = Math.Max(0, (int)Math.Ceiling((deadline - DateTimeOffset.UtcNow).TotalSeconds));
                // The bar measures the deadline being counted: the whole question's lifetime for the
                // expiry, and what was left when it started for the defaults, whose start is not sent.
                if (_countingAuto != AutoContinue)
                {
                    _countingAuto = AutoContinue;
                    _totalSeconds = AutoContinue ? _secondsLeft.Value : (int)Prompt.TimeoutSeconds;
                }
                _totalSeconds = Math.Max(_totalSeconds, _secondsLeft.Value);
                await InvokeAsync(StateHasChanged);
                if (_secondsLeft == 0)
                {
                    if (!_sending) await InvokeAsync(() => SendAsync(Prompt.SubmitDefaults && !_defaultsPaused && IsReady
                        ? UserPromptOutcome.Answered : UserPromptOutcome.Expired));
                    return;
                }
                var left = deadline - DateTimeOffset.UtcNow;
                // The recommended answers go out through Continue, so the virtual pointer presses it
                // just before they do; the send below is the same either way.
                if (AutoContinue && IsReady && !_pressed && left <= PressLead)
                {
                    _pressed = true;
                    await InvokeAsync(PressSubmitAsync);
                    continue;
                }
                var step = AutoContinue && IsReady && !_pressed ? left - PressLead : left;
                await Task.Delay(TimeSpan.FromMilliseconds(Math.Clamp(step.TotalMilliseconds, 50, 1000)), token);
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _timer?.Cancel();
        _timer?.Dispose();
    }

    /// <summary>Which picker a question wants, or null for a question that is not about a path.</summary>
    private static DirectoryPickerMode? PathMode(UserPromptQuestion question) => question.PathKind switch
    {
        "directory" or "directories" => DirectoryPickerMode.Directory,
        "file" => DirectoryPickerMode.File,
        _ => null
    };

    private static bool IsMultiplePaths(UserPromptQuestion question) => question.PathKind == "directories";

    private string? PickerStartPath(int question) => _paths.GetValueOrDefault(question)?.LastOrDefault()
        ?? _other.GetValueOrDefault(question);

    private void OpenPicker(int question, DirectoryPickerMode mode)
    {
        _pickerQuestion = question;
        _pickerMode = mode;
    }

    private void ClosePicker() => _pickerQuestion = null;

    private Task GitPickedAsync(int question, IReadOnlyList<string> values)
    {
        _gitPickerQuestion = null;
        _values[question] = values.ToList();
        if (!Prompt.Questions[question].MultiSelect)
        {
            _selected[question].Clear();
            _other[question] = string.Empty;
        }
        return Task.CompletedTask;
    }

    /// <summary>
    /// A picked path is an answer, not just text in a box: it goes in through the same door typing
    /// does, so choosing it also ticks the question the way typing would.
    /// </summary>
    private Task PickedAsync(int question, string path)
    {
        _pickerQuestion = null;
        if (IsMultiplePaths(Prompt.Questions[question]))
        {
            if (!_paths[question].Contains(path, StringComparer.OrdinalIgnoreCase)) _paths[question].Add(path);
            return Task.CompletedTask;
        }

        TypeOther(question, new ChangeEventArgs { Value = path });
        return Task.CompletedTask;
    }

    private void RemovePath(int question, string path) =>
        _paths[question].RemoveAll(item => string.Equals(item, path, StringComparison.OrdinalIgnoreCase));

    private bool IsReady => Prompt.Questions.Select((_, index) => HasAnswer(index)).All(answered => answered)
        && Prompt.Questions.Select((_, index) => index).All(index => !IsInvalidText(index));

    private bool HasAnswer(int index) =>
        _selected.GetValueOrDefault(index)?.Count > 0
        || !string.IsNullOrWhiteSpace(_other.GetValueOrDefault(index))
        || _paths.GetValueOrDefault(index)?.Count > 0
        || _values.GetValueOrDefault(index)?.Count > 0
        || _order.GetValueOrDefault(index)?.Count > 0;

    /// <summary>Typed text the question's pattern or length refuses: it cannot be sent as it is.</summary>
    private bool IsInvalidText(int index) =>
        Prompt.Questions[index].Input?.Kind == UserPromptInputKind.Text
        && !string.IsNullOrWhiteSpace(_other.GetValueOrDefault(index))
        && Inputs.Normalize(Prompt.Questions[index], _other[index]) is null;

    protected override void OnParametersSet()
    {
        // A second question replacing the first is a different question: nothing typed for the one
        // that has gone should be carried into the one that arrived.
        if (_rendered == Prompt.Id) return;
        _rendered = Prompt.Id;
        _timer?.Cancel();
        _timer?.Dispose();
        _secondsLeft = null;
        _totalSeconds = 0;
        _countingAuto = null;
        _pressed = false;
        _defaultsPaused = false;
        _selected.Clear();
        _other.Clear();
        _paths.Clear();
        _values.Clear();
        _order.Clear();
        _remember.Clear();
        _active = null;
        _typing = false;
        for (var index = 0; index < Prompt.Questions.Count; index++)
        {
            _selected[index] = Prompt.Questions[index].Options.Select((option, position) => (option, position))
                .Where(item => item.option.Recommended).Select(item => item.position).ToHashSet();
            _other[index] = string.Empty;
            _paths[index] = [];
            _values[index] = [];
            _order[index] = [];
            _remember[index] = false;
            SyncPreset(index);
            Prefill(index);
        }

        _sending = false;
        _chosen = null;
        _error = null;
        _pickerQuestion = null;
        _gitPickerQuestion = null;
        if ((Prompt.Presentation == "overlay" || Prompt.SubmitDefaults) && IsTimed)
        {
            _timer = new CancellationTokenSource();
            _ = CountDownAsync(Prompt.Id, _timer.Token);
        }
    }

    /// <summary>
    /// What the model said it would go on with is on the card from the start, ready to keep or
    /// change: a default fills its control, a rank starts in the order offered, and a recommended
    /// preset sets its slider or swatch. Keeping it is an answer like any other.
    /// </summary>
    private void Prefill(int index)
    {
        var question = Prompt.Questions[index];
        var defaults = question.Defaults ?? [];
        var kind = question.Input?.Kind;
        switch (kind)
        {
            case UserPromptInputKind.Rank:
                _selected[index].Clear();
                _order[index] = Enumerable.Range(0, question.Options.Count).ToList();
                return;
            case UserPromptInputKind.Number or UserPromptInputKind.Range or UserPromptInputKind.Scale or UserPromptInputKind.Color:
            {
                var preset = question.Options.FirstOrDefault(option => option.Recommended)?.Value;
                _selected[index].Clear();
                _values[index] = (defaults.Count > 0
                    ? kind == UserPromptInputKind.Range
                        ? defaults.Count == 2 && Inputs.PresetValues(question, $"{defaults[0]}..{defaults[1]}") is { } ends ? ends.ToList() : []
                        : defaults.Select(value => Inputs.Normalize(question, value)).OfType<string>().Take(1).ToList()
                    : Inputs.PresetValues(question, preset)?.ToList()) ?? [];
                return;
            }
            case UserPromptInputKind.Text:
                _selected[index].Clear();
                _other[index] = defaults.Count > 0 ? defaults[0] : string.Empty;
                return;
            case UserPromptInputKind.Search:
                return;
        }
        if (defaults.Count == 0) return;
        if (question.PathKind == "directories") _paths[index] = defaults.ToList();
        else if (question.PathKind is not null || question.PickerKind is null && question.Options.Count == 0) _other[index] = defaults[0];
        else if (_values[index].Count == 0)
            _values[index] = defaults.Select(value => Inputs.Normalize(question, value)).OfType<string>()
                .Take(question.MultiSelect ? 200 : 1).ToList();
    }

    private void SetValues(int question, IReadOnlyList<string> values)
    {
        _values[question] = values.ToList();
        _selected[question].Clear();
    }

    private void SetOrder(int question, IReadOnlyList<int> order) => _order[question] = order.ToList();

    /// <summary>A preset under a slider or a text box sets it, ready to adjust.</summary>
    private void ApplyPreset(int question, UserPromptOption option)
    {
        var prompt = Prompt.Questions[question];
        if (prompt.Input?.Kind == UserPromptInputKind.Text)
        {
            _other[question] = option.Value ?? option.Label;
            return;
        }
        if (Inputs.PresetValues(prompt, option.Value) is { } values) _values[question] = values.ToList();
    }

    private bool IsPreset(int question, UserPromptOption option)
    {
        var prompt = Prompt.Questions[question];
        if (prompt.Input?.Kind == UserPromptInputKind.Text) return _other[question] == (option.Value ?? option.Label);
        return Inputs.PresetValues(prompt, option.Value) is { } values && values.SequenceEqual(_values[question]);
    }

    private void ToggleSearch(int question, int option)
    {
        var prompt = Prompt.Questions[question];
        if (prompt.MultiSelect)
        {
            if (!_selected[question].Remove(option)) _selected[question].Add(option);
            return;
        }
        var on = !_selected[question].Contains(option);
        _selected[question].Clear();
        _other[question] = string.Empty;
        if (on) _selected[question].Add(option);
    }

    private Task TextKeyAsync(KeyboardEventArgs args) =>
        args.Key == "Enter" && (args.CtrlKey || args.MetaKey) && !_sending ? AnswerAsync() : Task.CompletedTask;

    private Task SubmitIfReadyAsync() => IsReady && !_sending ? AnswerAsync() : Task.CompletedTask;

    /// <summary>What the preview line reads: the values, the chosen labels, the text and how many things are chosen.</summary>
    private UserPromptPreviewValues PreviewValues(int index)
    {
        var question = Prompt.Questions[index];
        var chosen = question.Input?.Kind == UserPromptInputKind.Rank ? _order[index] : _selected[index].Order().ToList();
        var labels = chosen.Select(option => question.Options[option].Label).ToList();
        var values = chosen.Select(option => question.Options[option].Value).OfType<string>().Concat(_values[index]).ToList();
        var text = string.IsNullOrWhiteSpace(_other[index]) ? null : _other[index].Trim();
        return new UserPromptPreviewValues(values, labels, text,
            chosen.Count + _values[index].Count + _paths[index].Count + (text is null ? 0 : 1));
    }

    /// <summary>
    /// The question digits pick in: the one holding focus, otherwise the first that has something
    /// to pick by number — a list of options or a scale.
    /// </summary>
    private int? DigitTarget => _active is { } active && DigitCount(active) > 0 ? active
        : Enumerable.Range(0, Prompt.Questions.Count).Select(index => (int?)index).FirstOrDefault(index => DigitCount(index) > 0);

    private int DigitCount(int? index)
    {
        if (index is not { } at || at >= Prompt.Questions.Count || Prompt.ReplyButtons) return 0;
        var question = Prompt.Questions[at];
        return question.Input?.Kind switch
        {
            null => Math.Min(9, question.Options.Count),
            UserPromptInputKind.Scale => (int)Math.Min(9, question.Input.Max ?? 5),
            _ => 0
        };
    }

    private bool PickByDigit(char digit)
    {
        if (DigitTarget is not { } target) return false;
        var question = Prompt.Questions[target];
        var number = digit - '0';
        if (question.Input?.Kind == UserPromptInputKind.Scale)
        {
            if (Inputs.Normalize(question, number.ToString(System.Globalization.CultureInfo.InvariantCulture)) is not { } value) return false;
            _values[target] = [value];
            return true;
        }
        var option = number - 1;
        if (option < 0 || option >= question.Options.Count) return false;
        var on = !(question.MultiSelect && _selected[target].Contains(option));
        Select(target, option, question.MultiSelect, new ChangeEventArgs { Value = on });
        return true;
    }

    private bool IsSelected(int question, int option) => _selected[question].Contains(option);

    private void Select(int question, int option, bool multiSelect, ChangeEventArgs args)
    {
        var on = args.Value is true or "true" or "on";
        if (!multiSelect)
        {
            _selected[question].Clear();
            _values[question].Clear();
            // Picking a listed option is also how you abandon the free-text one: with radios the
            // browser clears its control but not what was typed into it, and a stale "other"
            // travelling alongside a chosen option is an answer nobody gave.
            _other[question] = string.Empty;
        }

        if (on) _selected[question].Add(option); else _selected[question].Remove(option);
        if (!multiSelect) SyncPreset(question);
    }

    /// <summary>
    /// A preset chosen above a schedule picker shows in the picker, ready to adjust; adjusting it
    /// then is the answer, and the preset is no longer chosen.
    /// </summary>
    private void SyncPreset(int question)
    {
        var prompt = Prompt.Questions[question];
        if (prompt.MultiSelect || !SchedulePickers.IsSchedulePicker(prompt.PickerKind)) return;
        var value = _selected[question].Select(index => prompt.Options[index].Value)
            .Select(value => SchedulePickers.Normalize(prompt.PickerKind, value, ScheduleCalendar))
            .OfType<string>().FirstOrDefault();
        if (value is not null) _values[question] = [value];
    }

    private void SchedulePicked(int question, IReadOnlyList<string> values)
    {
        var prompt = Prompt.Questions[question];
        if (!prompt.MultiSelect && values.Count > 0 && _values[question].SequenceEqual(values)) return;
        _values[question] = values.ToList();
        if (prompt.MultiSelect || values.Count == 0) return;
        _selected[question].Clear();
        _other[question] = string.Empty;
    }

    private void SelectOther(int question, bool multiSelect, ChangeEventArgs args)
    {
        if (!multiSelect)
        {
            _selected[question].Clear();
            _values[question].Clear();
        }
        if (args.Value is false or "false") _other[question] = string.Empty;
    }

    /// <summary>Typing is choosing: reaching for the field and then having to tick it as well is a trap.</summary>
    private void TypeOther(int question, ChangeEventArgs args)
    {
        var text = args.Value?.ToString() ?? string.Empty;
        _other[question] = text;
        if (text.Length > 0 && !Prompt.Questions[question].MultiSelect)
        {
            _selected[question].Clear();
            _values[question].Clear();
        }
    }

    private Task AnswerAsync() => SendAsync(UserPromptOutcome.Answered);

    private string ReplyClass(UserPromptOption choice, int option) =>
        $"user-prompt-reply{(choice.Recommended ? " is-recommended" : null)}{(_sending && _chosen == option ? " is-chosen" : null)}";

    /// <summary>A reply button is the whole answer: it replaces whatever else was typed and goes at once.</summary>
    private Task ReplyAsync(int option)
    {
        if (_sending) return Task.CompletedTask;
        _selected[0] = [option];
        _other[0] = string.Empty;
        _values[0].Clear();
        _chosen = option;
        return SendAsync(UserPromptOutcome.Answered);
    }

    private Task TypeReplyKeyAsync(int question, KeyboardEventArgs args)
    {
        if (args.Key != "Enter" || args.ShiftKey || args.IsComposing || _sending || string.IsNullOrWhiteSpace(_other[question]))
            return Task.CompletedTask;
        _selected[question].Clear();
        _chosen = null;
        return SendAsync(UserPromptOutcome.Answered);
    }

    private Task DismissAsync() => SendAsync(UserPromptOutcome.Dismissed);

    private Task DeclineAsync() => SendAsync(UserPromptOutcome.Declined);

    private Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (Prompt.ReplyButtons)
            return args.Key is [>= '1' and <= '9'] && !args.AltKey && !args.CtrlKey && !args.MetaKey && !args.ShiftKey
                && args.Key[0] - '1' < Prompt.Questions[0].Options.Count
                    ? ReplyAsync(args.Key[0] - '1')
                    : Task.CompletedTask;
        if (args.Key is [>= '0' and <= '9'] && !args.AltKey && !args.CtrlKey && !args.MetaKey && !args.ShiftKey
            && !_typing && !_sending)
        {
            PickByDigit(args.Key[0]);
            return Task.CompletedTask;
        }
        return args.Key == "Enter" && !args.AltKey && !args.CtrlKey && !args.MetaKey && !args.ShiftKey
            && !args.IsComposing && IsReady && !_sending
                ? AnswerAsync()
                : Task.CompletedTask;
    }

    private async Task SendAsync(UserPromptOutcome outcome)
    {
        if (_sending) return;
        _error = null;
        if (outcome == UserPromptOutcome.Answered
            && Prompt.Questions.Select((_, index) => index).FirstOrDefault(IsInvalidText, -1) is var invalid and >= 0)
        {
            _error = $"The answer to “{Prompt.Questions[invalid].Label ?? Prompt.Questions[invalid].Text}” is not in the expected form.";
            return;
        }
        _sending = true;
        var accepted = false;
        try
        {
            var answers = outcome == UserPromptOutcome.Answered
                ? Prompt.Questions
                    .Select((question, index) => new UserPromptAnswer(question.Id,
                        question.Input?.Kind == UserPromptInputKind.Rank ? _order[index].ToArray() : _selected[index].Order().ToArray(),
                        string.IsNullOrWhiteSpace(_other[index]) ? null
                            // Several lines may be code, whose leading spaces are part of it.
                            : question.Input is { Kind: UserPromptInputKind.Text, Multiline: true } ? _other[index].TrimEnd() : _other[index].Trim(),
                        _paths[index].Count == 0 ? null : _paths[index].ToArray(),
                        _values[index].Count == 0 ? null : _values[index].ToArray(),
                        _remember[index]))
                    .Where(answer => answer.Selected.Count > 0 || answer.Other is not null || answer.Paths is { Count: > 0 } || answer.Values is { Count: > 0 })
                    .ToArray()
                : [];
            // Answering nothing at all is telling the assistant to decide, which is what the other
            // button says. Sending it as an answer would have the same effect with a worse record.
            if (answers.Length == 0 && outcome == UserPromptOutcome.Answered) outcome = UserPromptOutcome.Dismissed;
            // An accepted answer keeps the card as it was sent until the run takes the question away:
            // the pressed choice stays marked, and nothing on the card can be pressed a second time.
            accepted = await OnAnswer(new UserPromptResponse(Prompt.Id, outcome, answers));
            if (!accepted) _error = "This question is no longer available.";
        }
        catch (HttpRequestException)
        {
            _error = "The answer could not be sent. Try again.";
        }
        finally
        {
            if (!accepted)
            {
                _sending = false;
                _chosen = null;
            }
        }
    }

    /// <summary>The control of a value-like question; see <see cref="UserPromptInput"/>.</summary>
    private RenderFragment InputField(int index, UserPromptQuestion question, UserPromptInput input) => __builder =>
    {
        var presets = input.Kind is UserPromptInputKind.Number or UserPromptInputKind.Range or UserPromptInputKind.Text
            ? question.Options : [];
        if (presets.Count > 0)
        {
            <div class="user-prompt-presets" role="group" aria-label="Presets">
                @foreach (var option in presets)
                {
                    var preset = option;
                    <button class="@($"user-prompt-preset{(IsPreset(index, preset) ? " is-chosen" : null)}{(preset.Recommended ? " is-recommended" : null)}")"
                            type="button" disabled="@_sending" title="@preset.Description" aria-pressed="@(IsPreset(index, preset) ? "true" : "false")"
                            @onclick="() => ApplyPreset(index, preset)">@preset.Label</button>
                }
            </div>
        }
        switch (input.Kind)
        {
            case UserPromptInputKind.Number or UserPromptInputKind.Range:
                <PromptSliderField Question="@question" Values="@_values[index]" Disabled="@_sending"
                                   ValuesChanged="values => SetValues(index, values)" TypingChanged="typing => _typing = typing" />
                break;
            case UserPromptInputKind.Scale:
                <PromptScaleField Question="@question" Values="@_values[index]" Disabled="@_sending"
                                  ValuesChanged="values => SetValues(index, values)" />
                break;
            case UserPromptInputKind.Rank:
                <PromptRankField Question="@question" Order="@_order[index]" Disabled="@_sending"
                                 OrderChanged="order => SetOrder(index, order)" />
                break;
            case UserPromptInputKind.Search:
                <PromptSearchField Question="@question" ListId="@($"{Prompt.Id:N}-{index}")" Selected="@_selected[index]" Disabled="@_sending"
                                   Toggle="option => ToggleSearch(index, option)" Submit="SubmitIfReadyAsync" TypingChanged="typing => _typing = typing" />
                @if (question.AllowOther)
                {
                    <label class="user-prompt-option user-prompt-other">
                        <span>
                            <span class="user-prompt-option-label">Not in the list</span>
                            <input class="user-prompt-other-input" type="text" disabled="@_sending" placeholder="Type your answer"
                                   value="@_other[index]" @onfocus="() => _typing = true" @onblur="() => _typing = false"
                                   @oninput="args => TypeOther(index, args)" />
                        </span>
                    </label>
                }
                break;
            case UserPromptInputKind.Color:
                <PromptColorField Question="@question" Values="@_values[index]" Disabled="@_sending"
                                  ValuesChanged="values => SetValues(index, values)" TypingChanged="typing => _typing = typing" />
                break;
            case UserPromptInputKind.Text:
                var code = input.Language is { Length: > 0 };
                var invalid = IsInvalidText(index);
                <div class="@($"user-prompt-text{(code ? " is-code" : null)}{(invalid ? " is-invalid" : null)}")">
                    @if (input.Multiline)
                    {
                        <textarea class="user-prompt-textarea" rows="@(code ? 8 : 4)" maxlength="@(input.MaxLength ?? 4000)"
                                  placeholder="@(input.Placeholder ?? "Type your answer")" spellcheck="@(code ? "false" : "true")"
                                  aria-label="@(question.Label ?? "Your answer")" aria-invalid="@(invalid ? "true" : "false")"
                                  disabled="@_sending" value="@_other[index]"
                                  @onfocus="() => _typing = true" @onblur="() => _typing = false"
                                  @oninput="args => _other[index] = args.Value?.ToString() ?? string.Empty"
                                  @onkeydown="TextKeyAsync" @onkeydown:stopPropagation="true"></textarea>
                    }
                    else
                    {
                        <input class="user-prompt-other-input" type="text" maxlength="@(input.MaxLength ?? 4000)"
                               placeholder="@(input.Placeholder ?? "Type your answer")" spellcheck="@(code ? "false" : "true")"
                               aria-label="@(question.Label ?? "Your answer")" aria-invalid="@(invalid ? "true" : "false")"
                               disabled="@_sending" value="@_other[index]"
                               @onfocus="() => _typing = true" @onblur="() => _typing = false"
                               @oninput="args => _other[index] = args.Value?.ToString() ?? string.Empty" />
                    }
                    <span class="user-prompt-text-meta">
                        @if (code)
                        {
                            <span class="user-prompt-text-language">@input.Language</span>
                        }
                        @if (input.Multiline)
                        {
                            <span><kbd>Ctrl</kbd>+<kbd>Enter</kbd> to answer</span>
                        }
                    </span>
                    @if (invalid)
                    {
                        <span class="user-prompt-field-error" role="alert">
                            @(input.Pattern is { } pattern ? "Expected the form " : "Too long.")
                            @if (input.Pattern is { } shown)
                            {
                                <code>@shown</code>
                            }
                        </span>
                    }
                </div>
                break;
        }
    };
}
