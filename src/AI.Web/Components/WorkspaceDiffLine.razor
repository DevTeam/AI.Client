@using AI.Contracts.Workspace
@using Microsoft.AspNetCore.Components.Web

@if (Line.Kind == DiffLineKind.Hunk)
{
    <div class="diff-hunk">@Line.Text</div>
}
else if (Line.Kind == DiffLineKind.Note)
{
    <div class="diff-note">@Line.Text</div>
}
else
{
    <div class="diff-line @KindClass(Line.Kind) @(ReviewMode ? "diff-line-review" : null) @(Commented ? "diff-line-commented" : null) @(Selected ? "diff-line-selected" : null)"
         @onclick="OnLineClick">
        @if (ReviewMode)
        {
            <button class="diff-line-comment" type="button" title="Comment on line; Shift-click another line to select a range"
                    aria-label="Comment on line" @onclick="OnComment" @onclick:stopPropagation="true">+</button>
        }
        <span class="diff-gutter" aria-hidden="true">@Line.OldLine</span>
        <span class="diff-gutter" aria-hidden="true">@Line.NewLine</span>
        <span class="diff-sign">@Sign(Line.Kind)</span>
        <span class="diff-text">@Line.Text</span>
    </div>
}

@code {
    [Parameter, EditorRequired] public DiffLine Line { get; set; } = default!;
    [Parameter] public bool ReviewMode { get; set; }
    [Parameter] public bool Commented { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnComment { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnLineClick { get; set; }

    private static string KindClass(DiffLineKind kind) => kind switch
    {
        DiffLineKind.Added => "diff-line-added",
        DiffLineKind.Removed => "diff-line-removed",
        _ => "diff-line-context",
    };

    private static string Sign(DiffLineKind kind) => kind switch
    {
        DiffLineKind.Added => "+",
        DiffLineKind.Removed => "−",
        _ => " ",
    };
}
