@implements IDisposable
@inject INotificationService Notifications

@* Renders the single, fixed-position toast region for the whole app. Sits in App.razor so it shows
   above any page (Home.razor, GlobalSettingsPanel, ToolPermissionsDrawer — anywhere a save might
   happen). Subscribes to NotificationService.Changed for the latest event and its short history. *@

<div class="toast-region" @onmouseenter="Notifications.PauseAutoDismiss" @onmouseleave="Notifications.ResumeAutoDismiss">
    @if (_current is not null)
    {
        <div class="toast @KindClass(_current.Kind) @(_current.RequiresAction ? "attention" : string.Empty)" role="status" aria-live="polite" aria-atomic="true">
            <AppIcon Name="@(_current.Kind == NotificationKind.Error ? "error" : _current.Kind == NotificationKind.Success ? "check" : "info")" />
            @if (_current.ChatId is not null)
            {
                <button class="toast-message-link" type="button" @onclick="() => Notifications.Open(_current)">@_current.Message</button>
            }
            else
            {
                <span>@_current.Message</span>
            }
            <button class="icon-action" type="button" title="Dismiss notification" aria-label="Dismiss notification" @onclick="Notifications.Dismiss"><AppIcon Name="x" /></button>
        </div>
        @if (Notifications.History.Skip(1).Take(2).Any())
        {
            <div class="toast-recent">
                @foreach (var previous in Notifications.History.Skip(1).Take(2))
                {
                    <button type="button" disabled="@(previous.ChatId is null)" @onclick="() => Notifications.Open(previous)">@previous.Message</button>
                }
                <button class="toast-view-all" type="button" @onclick="Notifications.OpenCenter">View all notifications@(Notifications.History.Count > 3 ? $" · {Notifications.History.Count - 3} more" : string.Empty)</button>
            </div>
        }
    }
</div>

@code {
    private NotificationMessage? _current;

    protected override void OnInitialized()
    {
        _current = Notifications.Current;
        Notifications.Changed += OnNotificationsChanged;
    }

    private void OnNotificationsChanged()
    {
        _current = Notifications.Current;
        // InvokeAsync is overkill here: the event is raised on whatever thread the caller used,
        // which is always the Blazor synchronization context (every caller is a Razor event handler
        // or a service method invoked from one), so a direct StateHasChanged would also be safe.
        // Kept as InvokeAsync for the same reason WorkspaceLayoutService.AttachAsync is — so the
        // component still re-renders correctly if a future caller fires the event off-thread.
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Notifications.Changed -= OnNotificationsChanged;

    private static string KindClass(NotificationKind kind) => kind switch
    {
        NotificationKind.Success => "success",
        NotificationKind.Error => "error",
        NotificationKind.Info => "info",
        _ => string.Empty
    };
}
