    /// <summary>
    /// The answer a drafted reply would go to: the head of the branch on screen, when it is a finished
    /// answer and the composer would send to it. A run still busy, a question or approval waiting,
    /// and a fork or replacement in progress each mean the next message is something else.
    /// </summary>
    private ReplySuggestionTarget? GetReplySuggestionTarget()
    {
        if (_selectedProject is not { } project || _selectedChat is not { } chat || _isForking || GetReplaceSource() is not null)
            return null;
        if (GetSelectedRun() is { } run && (run.Status == ChatRunStatus.Generating || run.Queue.Count > 0
                || run.PendingPrompt is not null || run.PendingApproval is not null))
            return null;
        var branchId = GetSelectedRunBranchId();
        if (chat.Branches?.SingleOrDefault(branch => branch.Id == branchId)?.HeadMessageId is not { } head) return null;
        return chat.Messages.LastOrDefault(message => message.Id == head) is { Role: "Assistant", IsIncomplete: false }
            ? new ReplySuggestionTarget(project.Id, chat.Id, branchId, head)
            : null;
    }

