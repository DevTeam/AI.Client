    private string AcceptSkill(AI.Contracts.Skills.SkillDefinition skill)
    {
        // One skill per message: picking another replaces the chip instead of adding a second.
        var previous = _draftResources.FindIndex(item => item.Kind == ChatResourceKind.Skill);
        if (previous >= 0) _draftResources.RemoveAt(previous);
        else if (_draftResources.Count >= 20)
        {
            _chatError = "A message can reference at most 20 resources. Remove one to add a skill.";
            return _chat.Message;
        }
        _draftResources.Insert(0, new ChatResource(Guid.NewGuid(), ChatResourceKind.Skill, skill.Id, skill.Name));
        _resourceDrafts[GetComposerDraftKey()] = _draftResources.ToArray();
        _recentSkillIds.Remove(skill.Id);
        _recentSkillIds.Insert(0, skill.Id);
        if (_recentSkillIds.Count > 5) _recentSkillIds.RemoveAt(_recentSkillIds.Count - 1);
        _chat.Message = string.Empty;
        _skillMatches = [];
        _composerNeedsResize = true;
        WorkspaceStateService.QueueComposerDraftSave(GetComposerDraftKey(), _chat.Message);
        return _chat.Message;
    }

    /// <summary>
    /// Every edit and caret move in the composer, from chatComposer.js: opens, narrows or closes the
    /// "@" list. The text comes with the caret because the bound value can still be a render behind.
    /// </summary>
    [JSInvokable]
    public async Task OnComposerCaret(string text, int caret)
    {
        var mention = _selectedProject is null ? null : MentionMatcher.GetMention(text, caret);
        // The caret in a link already made shows how its file is sent, not the list it came from.
        var bubble = mention is null ? null : MentionBubbleTarget(text, mention);
        var bubbleChanged = bubble?.Id != _mentionBubbleId;
        _mentionBubbleId = bubble?.Id;
        if (bubble is not null) mention = null;
        if (mention is null)
        {
            if (_mention is null && _mentionDismissedAt is null)
            {
                if (bubbleChanged) await InvokeAsync(StateHasChanged);
                return;
            }
            CloseMention();
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (_mentionDismissedAt is { } dismissed && dismissed != mention.Start) _mentionDismissedAt = null;
        var starting = _mention?.Start != mention.Start;
        _mention = mention;
        if (starting) _ = LoadMentionSourcesAsync();
        RecomputeMentionItems();
        if (NeedsFileSearch(mention) && _mentionFilesQuery != mention.Filter) _ = SearchMentionFilesAsync(mention.Filter);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>The draft's file link the "@" word is, whole: a file whose path or content the switch chooses.</summary>
    private ChatResource? MentionBubbleTarget(string text, AI.Web.Resources.ResourceMention mention)
    {
        var word = text[mention.Start..Math.Min(mention.End, text.Length)];
        return _draftResources.FirstOrDefault(item => item.Mention == word && CanSendContent(item));
    }

    private static bool CanSendContent(ChatResource resource) =>
        resource is { Kind: ChatResourceKind.File, Lines: null, AssetId: null };

    private ChatResource? GetMentionBubbleResource() => _mentionBubbleId is { } id && !IsMentionListOpen() && !IsSkillListOpen()
        ? _draftResources.FirstOrDefault(item => item.Id == id && item.Mention is not null
            && _chat.Message.Contains(item.Mention, StringComparison.Ordinal))
        : null;

    /// <summary>Path only, or the file's content as well: switched on a draft's link or pill.</summary>
    private void SetDraftIncludeContent(Guid id, bool includeContent)
    {
        var index = _draftResources.FindIndex(item => item.Id == id);
        if (index < 0 || !CanSendContent(_draftResources[index])) return;
        _draftResources[index] = _draftResources[index] with { IncludeContent = includeContent };
        _resourceDrafts[GetComposerDraftKey()] = _draftResources.ToArray();
    }

    private bool IsMentionListOpen() => _mention is { } mention && _mentionItems.Count > 0
        && _mentionDismissedAt != mention.Start && !IsSkillListOpen();

    private static bool NeedsFileSearch(AI.Web.Resources.ResourceMention mention) =>
        mention.Scope is null or ChatResourceKind.File or ChatResourceKind.Directory;

    private void CloseMention()
    {
        _mention = null;
        _mentionItems = [];
        _mentionDismissedAt = null;
    }

    private async Task WarmMentionSearchAsync(Guid projectId)
    {
        try { await ResourceApi.WarmAsync(projectId, CancellationToken.None); }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            // Only a head start: without it the first search starts the index itself.
        }
    }

    /// <summary>
    /// Changes and reviews can move between one "@" and the next, so they are read again when a word
    /// starts — changes at most every few seconds, since git status over large trees takes a while.
    /// Neither holds the list up: each group appears when its answer does.
    /// </summary>
    private async Task LoadMentionSourcesAsync()
    {
        if (_selectedProject is not { } project) return;
        var diffs = _mentionDiffsLoadedFor == project.Id && DateTimeOffset.UtcNow - _mentionDiffsLoadedAt < TimeSpan.FromSeconds(10)
            ? Task.CompletedTask : LoadMentionDiffsAsync(project.Id);
        var reviews = _selectedChat is not null && _reviews.Count == 0 ? LoadMentionReviewsAsync() : Task.CompletedTask;
        await Task.WhenAll(diffs, reviews);
    }

    private async Task LoadMentionDiffsAsync(Guid projectId)
    {
        IReadOnlyList<WorkspaceDiffSource> diffs;
        try { diffs = await ResourceApi.ListDiffsAsync(projectId, CancellationToken.None); }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            // Without git, or with the Host busy, the list just has no changes to offer.
            diffs = [];
        }
        if (_selectedProject?.Id != projectId) return;
        _mentionDiffs = diffs;
        _mentionDiffsLoadedFor = projectId;
        _mentionDiffsLoadedAt = DateTimeOffset.UtcNow;
        await RefreshMentionAsync();
    }

    private async Task LoadMentionReviewsAsync()
    {
        await LoadReviewsAsync();
        await RefreshMentionAsync();
    }

    private async Task RefreshMentionAsync()
    {
        if (_mention is null) return;
        RecomputeMentionItems();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SearchMentionFilesAsync(string query)
    {
        if (_selectedProject is not { } project) return;
        var version = ++_mentionSearchVersion;
        _mentionFilesQuery = query;
        ResourceSearchResult found;
        try
        {
            found = await ResourceApi.SearchAsync(project.Id, query, 40, CancellationToken.None);
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            found = new ResourceSearchResult([], true);
        }
        // A later keystroke already asked again; its answer is the one to show.
        if (version != _mentionSearchVersion || _selectedProject?.Id != project.Id || _mention is null) return;
        _mentionFiles = found.Items;
        RecomputeMentionItems();
        await InvokeAsync(StateHasChanged);
        if (found.Complete) return;
        // The Host is still indexing: what it has is shown, and the same word is asked again shortly.
        await Task.Delay(400);
        if (version == _mentionSearchVersion && _mention?.Filter == query) await SearchMentionFilesAsync(query);
    }

    private AI.Web.Resources.ProjectDirectory[] ProjectDirectories() => _security.DirectoryGrants
        .Where(grant => grant.ToolNames.Contains("read", StringComparison.OrdinalIgnoreCase))
        .Select(grant => new AI.Web.Resources.ProjectDirectory(
            grant.DisplayName is { Length: > 0 } name ? name : ResourceDisplayName(grant.CanonicalRoot), grant.CanonicalRoot))
        .ToArray();

    private void RecomputeMentionItems()
    {
        if (_mention is not { } mention) { _mentionItems = []; return; }
        var selectedKey = _mentionItems.ElementAtOrDefault(_mentionIndex)?.Key;
        var reviews = ReviewsForComposer();
        _mentionItems = MentionMatcher.Match(new AI.Web.Resources.ResourceMentionSources(
            _mentionFiles, _mentionDiffs, _chats, reviews, _projects, _draftResources,
            _selectedChat?.Id, _selectedProject?.Id, ProjectDirectories()), mention);
        var kept = selectedKey is null ? -1 : _mentionItems.ToList().FindIndex(item => item.Key == selectedKey);
        _mentionIndex = kept >= 0 && mention.Filter.Length > 0 ? kept : 0;
        _scrollMention = true;
    }

