    private async Task DeleteChatAsync(ChatSummary chat)
    {
        if (_selectedProject is null || _deletingChatId is not null) return;

        // The confirm button stays on screen through three round trips. A second click used to
        // start a second delete that found the chat already gone and reported the 404 as a
        // conflict, leaving "changed elsewhere" under the composer for a chat that was deleted.
        _deletingChatId = chat.Id;
        try
        {
            await DeleteChatCoreAsync(chat);
        }
        finally
        {
            _deletingChatId = null;
        }
    }

    private async Task DeleteChatCoreAsync(ChatSummary chat)
    {
        if (_selectedProject is null) return;

        // Stopping the runs comes first, and the revision is read only afterwards: interrupting a
        // generating branch commits whatever the model had written as a truncated message, which
        // changes the chat. A revision read before that is stale by the time the delete uses it,
        // and the delete comes back as "the chat changed elsewhere" for a change this very method
        // caused. The sidebar's own ChatSummary.Revision is never trusted here either - it goes
        // stale for a chat that kept generating after the user switched away.
        foreach (var run in RunState.Runs.Values.Where(item => item.ChatId == chat.Id).ToArray())
        {
            await ChatRunsApi.ClearAllAsync(_selectedProject.Id, chat.Id, run.BranchId, Guid.CreateVersion7(), CancellationToken.None);
        }

        var current = await ChatHistoryApi.GetTranscriptAsync(_selectedProject.Id, chat.Id, CancellationToken.None);
        if (current is null)
        {
            CloseContextMenus();
            await LoadChatsAsync(_selectedProject.Id);
            return;
        }

        var result = await ChatHistoryApi.DeleteAsync(_selectedProject.Id, chat.Id, current.Revision, CancellationToken.None);
        // Revision 0 is the Host's NotFound: someone else already deleted it, which is the outcome
        // asked for, not a conflict to report.
        if (!result.IsDeleted && result.Revision != 0)
        {
            _chatError = "The chat changed elsewhere. Reload it before deleting.";
            CloseContextMenus();
            return;
        }

        if (_selectedChat?.Id == chat.Id)
        {
            _selectedChat = null;
            _selectedBranchId = null;
            _branchLeafId = null;
            SetJustArrivedLeaf(null);
            _wasGeneratingByBranch.Clear();
            // An edit or fork begun in the deleted chat points at its messages; carried over, the
            // next first message of a new chat is sent as a replacement of one that is gone.
            ResetBranchOperationState();
            _chat.Message = string.Empty;
            _chatError = null;
            _composerNeedsResize = true;
        }

        CloseContextMenus();
        await LoadChatsAsync(_selectedProject.Id);
        if (result.IsDeleted) Notifications.ShowSuccess("Chat deleted.");
    }

