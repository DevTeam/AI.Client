    /// <summary>
    /// The last segment of a Host path. Split by hand: in the browser <c>Path</c> follows the
    /// browser's own conventions, so a Windows path from the Host would come back whole.
    /// </summary>
    private static string ResourceDisplayName(string path)
    {
        var trimmed = path.TrimEnd('\\', '/');
        var name = trimmed[(trimmed.LastIndexOfAny(['\\', '/']) + 1)..];
        return string.IsNullOrEmpty(name) ? path : name;
    }

