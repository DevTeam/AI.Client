    private async Task SaveProjectSettingsAsync()
    {
        if (_selectedProject is null) return;
        await SaveProjectAsync();
    }

    private sealed class ProjectEditor
    {
        public ProjectEditor()
        {
        }

        public ProjectEditor(string name, string description, long revision)
        {
            Name = name;
            Description = description;
            Revision = revision;
        }

        public string Name { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;

        public long Revision { get; set; }

        public Guid? ConnectionId { get; set; }
    }

    private sealed class ProjectSecurityEditor
    {
        private long Revision { get; init; }

        public List<DirectoryGrantEditor> DirectoryGrants { get; } = [];

        public List<McpServerEditor> McpServers { get; } = [];

        public List<ToolPolicyEditor> ToolPolicies { get; } = [];

        public static ProjectSecurityEditor From(ProjectDetails project)
        {
            var editor = new ProjectSecurityEditor { Revision = project.Revision };
            editor.DirectoryGrants.AddRange(project.DirectoryGrants.Select(item => new DirectoryGrantEditor
            {
                Id = item.Id,
                DisplayName = item.DisplayName,
                CanonicalRoot = item.CanonicalRoot,
                Recursive = item.Recursive,
                ToolNames = string.Join(", ", item.ToolNames),
                Mode = item.ToolNames.Contains("write", StringComparer.OrdinalIgnoreCase) ? "Read/write" : "Read only"
            }));
            editor.McpServers.AddRange(project.McpServers.Select(item => new McpServerEditor
            {
                Id = item.Id,
                DisplayName = item.DisplayName,
                Transport = item.Transport,
                Enabled = item.Enabled
            }));
            editor.ToolPolicies.AddRange(project.ToolPolicies.Select(item => new ToolPolicyEditor
            {
                ServerId = item.ServerId,
                Name = item.Name,
                SchemaHash = item.SchemaHash,
                Decision = item.Decision,
                MaxCallsPerRun = item.MaxCallsPerRun,
                TimeoutSeconds = item.TimeoutSeconds
            }));
            return editor;
        }

        public UpdateProjectSecurityRequest ToRequest() => new(
            Revision,
            DirectoryGrants.Select(item => new DirectoryGrantSettings(
                item.Id,
                item.DisplayName,
                item.CanonicalRoot,
                item.Recursive,
                // ReSharper disable once UseCollectionExpression
                item.ToolNames.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))).ToArray(),
            // ReSharper disable once UseCollectionExpression
            McpServers.Select(item => new AI.Contracts.Projects.McpServerSettings(item.Id, item.DisplayName, item.Transport, item.Enabled)).ToArray(),
            ToolPolicies.Select(item => new ToolPolicySettings(
                item.ServerId,
                item.Name,
                item.SchemaHash,
                item.Decision,
                item.MaxCallsPerRun,
                // ReSharper disable once UseCollectionExpression
                item.TimeoutSeconds)).ToArray());
    }

    [SuppressMessage("ReSharper", "PropertyCanBeMadeInitOnly.Local")]
    private sealed class DirectoryGrantEditor
    {
        public Guid Id { get; init; } = Guid.CreateVersion7();

        public string DisplayName { get; set; } = "Directory";

        public string CanonicalRoot { get; set; } = string.Empty;

        public bool Recursive { get; set; } = true;

        public string ToolNames { get; set; } = "read";

        public string Mode
        {
            get => ToolNames.Contains("write", StringComparison.OrdinalIgnoreCase) ? "Read/write" : "Read only";
            set => ToolNames = value == "Read/write" ? "read, write, edit, delete" : "read";
        }
    }

    [SuppressMessage("ReSharper", "PropertyCanBeMadeInitOnly.Local")]
    private sealed class McpServerEditor
    {
        public Guid Id { get; set; } = Guid.CreateVersion7();

        public string DisplayName { get; set; } = "MCP server";

        public string Transport { get; set; } = "Stdio";

        public bool Enabled { get; set; } = true;
    }

    [SuppressMessage("ReSharper", "PropertyCanBeMadeInitOnly.Local")]
    private sealed class ToolPolicyEditor
    {
        public Guid ServerId { get; set; }

        public string Name { get; set; } = "tool";

        public string SchemaHash { get; set; } = "pending-discovery";

        public string Decision { get; set; } = "Ask";

        public int? MaxCallsPerRun { get; set; }

        public long? TimeoutSeconds { get; set; }
    }

    private sealed class ChatEditor
    {
        public string BaseUrl { get; set; } = string.Empty;

        public string Model { get; set; } = string.Empty;

        // ReSharper disable once UnusedAutoPropertyAccessor.Local
        public string? ApiKey { get; set; }

        public Guid? CredentialProfileId { get; set; }

        public string Message { get; set; } = string.Empty;
    }

    /// <summary>
    /// From the run event stream: "connected", "offline" or "unauthorized". The local UI and the
    /// Desktop app share their Host's lifetime, so only the published app shows it.
    /// </summary>
    [JSInvokable]
    public async Task OnHostConnectionChanged(string status)
    {
        if (!ClientMode.PublicWeb) return;
        if (status == "unauthorized")
        {
            // The grant was revoked elsewhere or the Host lost it; the connection page gets a new one.
            await JsRuntime.InvokeVoidAsync("aiHostBridge.forget");
            Navigation.Refresh(forceReload: true);
            return;
        }

        await HostConnection.ReportAsync(status == "connected");
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeGuideAsync();
        Notifications.Changed -= OnNotificationsChanged;
        HostConnection.Changed -= OnHostStatusChanged;
        ReplySuggestions.Changed -= OnReplySuggestionChanged;
        CorrectionLanguages.Changed -= OnTextCorrectionChanged;
        Notifications.OpenRequested -= OnNotificationOpenRequested;
        Notifications.CenterRequested -= OnNotificationCenterRequested;
        CancelChatSelection();
        if (_projectSelectionCancellation is not null)
        {
            await _projectSelectionCancellation.CancelAsync();
            _projectSelectionCancellation.Dispose();
            _projectSelectionCancellation = null;
        }
        _projectsBusy?.Dispose();
        _searchBusy?.Dispose();
        _chatsBusy?.Dispose();
        await _generatingTickerCancellation.CancelAsync();
        _generatingTickerCancellation.Dispose();

        if (_justArrivedLeafCancellation is not null)
        {
            await _justArrivedLeafCancellation.CancelAsync();
            _justArrivedLeafCancellation.Dispose();
        }

        await DisposeComposerHandleAsync();

        if (_chatListDragHandle is not null) { await _chatListDragHandle.InvokeVoidAsync("dispose"); await _chatListDragHandle.DisposeAsync(); }
        if (_chatListDragModule is not null) await _chatListDragModule.DisposeAsync();

        if (_resourceDropSubscription is not null) { await _resourceDropSubscription.InvokeVoidAsync("dispose"); await _resourceDropSubscription.DisposeAsync(); }
        if (_composerModule is not null)
        {
            await _composerModule.DisposeAsync();
        }

        if (_inlineEditorModule is not null)
        {
            await _inlineEditorModule.DisposeAsync();
        }

        if (_runEventsSubscription is not null) { await _runEventsSubscription.InvokeVoidAsync("dispose"); await _runEventsSubscription.DisposeAsync(); }
        if (_focusSubscription is not null) { await _focusSubscription.InvokeVoidAsync("dispose"); await _focusSubscription.DisposeAsync(); }
        if (_escapeSubscription is not null) { await _escapeSubscription.InvokeVoidAsync("dispose"); await _escapeSubscription.DisposeAsync(); }
        if (_drawerDismissSubscription is not null) { await _drawerDismissSubscription.InvokeVoidAsync("dispose"); await _drawerDismissSubscription.DisposeAsync(); }
        if (_branchPickerDismissSubscription is not null) { await _branchPickerDismissSubscription.InvokeVoidAsync("dispose"); await _branchPickerDismissSubscription.DisposeAsync(); }
        if (_queueDragSubscription is not null) { await _queueDragSubscription.InvokeVoidAsync("dispose"); await _queueDragSubscription.DisposeAsync(); }
        CancelNavigationCountdown();
        if (_navigationCueModule is not null) await _navigationCueModule.DisposeAsync();
        if (_runEventsModule is not null) await _runEventsModule.DisposeAsync();
        if (_archiveModule is not null) await _archiveModule.DisposeAsync();
        if (_navigationHandle is not null) { await _navigationHandle.InvokeVoidAsync("dispose"); await _navigationHandle.DisposeAsync(); }
        if (_navigationModule is not null) await _navigationModule.DisposeAsync();

        if (_scrollbarGutterHandle is not null) { await _scrollbarGutterHandle.InvokeVoidAsync("dispose"); await _scrollbarGutterHandle.DisposeAsync(); }
        if (_scrollbarGutterModule is not null) await _scrollbarGutterModule.DisposeAsync();
        if (_chatSummaryModule is not null) await _chatSummaryModule.DisposeAsync();

        _dotNetReference?.Dispose();
        await WorkspaceLayoutService.DisposeAsync();
    }
