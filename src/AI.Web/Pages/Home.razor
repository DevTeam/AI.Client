@inject AI.Web.Navigation.IAppControlHints ControlHints
@page "/"
@using System.Diagnostics.CodeAnalysis
@using System.Text.Json
@using AI.Web.State
@using AI.Web.FileSystem
@using AI.Contracts.Resources
@using Microsoft.AspNetCore.Components.Forms
@inject IClientMetadata ClientMetadata
@inject IClientMode ClientMode
@inject IHostConnection HostConnection
@inject HttpClient Http
@inject IApiBaseUrl _apiBaseUrl
@inject IProjectApi ProjectApi
@inject IChatHistoryApi ChatHistoryApi
@inject ISearchResultPresentation SearchResults
@inject IChatMessageDeltaMerger ChatMessageDeltaMerger
@inject IJSRuntime JsRuntime
@inject IWorkspaceLayoutService WorkspaceLayoutService
@inject IWorkspaceStateService WorkspaceStateService
@inject IGlobalSettingsApi GlobalSettingsApi
@inject AI.Web.Memory.IMemoryApi MemoryApi
@inject AI.Web.Skills.ISkillApi SkillApi
@inject AI.Web.Skills.ISkillCommandMatcher SkillMatcher
@inject AI.Web.Resources.IResourceMentionMatcher MentionMatcher
@inject IChatRunsApi ChatRunsApi
@inject IRunStateService RunState
@inject IChatComposerService Composer
@inject AI.Web.Resources.IResourceApi ResourceApi
@inject AI.Web.Resources.IDropAccessPlanner DropAccessPlanner
@inject AI.Web.Resources.IReviewApi ReviewApi
@inject IChatFeedProjection Feed
@inject INotificationService Notifications
@inject IRunStatusPresentation StatusPresentation
@inject IComposerHistoryNavigator _composerHistoryNavigator
@inject AI.Web.Updates.IUpdateClient Updates
@inject IReplySuggestionState ReplySuggestions
@inject AI.Web.Navigation.INavigationCues NavigationCues
@inject AI.Web.Navigation.IAppNavigationLinks NavigationLinks
@inject AI.Web.Navigation.IAppGuideApi GuideApi
@inject AI.Contracts.Navigation.IAppNavigationTargets GuideTargets
@inject AI.Contracts.Navigation.IAppGuideTopics GuideTopics
@inject IChatTipsState ChatTips
@inject IComposerContextPresentation ContextPresentation
@inject IClientSettingsService ClientSettings
@inject AI.TextCorrection.ITextAutoCorrectionAnalyzer TextCorrection
@inject AI.TextCorrection.ITextCorrectionPreparation TextCorrectionPreparation
@inject AI.TextCorrection.IWordBoundaries TextWordBoundaries
@inject ITextCorrectionLanguages CorrectionLanguages
@inject IChatUsageStore ChatUsage
@inject IHistoryCheckpointApi HistoryCheckpoints
@inject IChatWidgetLayout WidgetLayout
@inject IDelayedBusyIndicatorFactory BusyIndicatorFactory
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>@ClientMetadata.ProductName</PageTitle>

@* The shell's classes belong to workspaceLayout.js; the widget column's state is passed as data
   instead, since a re-rendered class attribute would wipe the classes the script has set. *@
<main class="workspace-shell" data-widgets="@GetChatWidgetsState()" @ref="_workspace">
    <aside @attributes="@(ControlHints.Attributes("workspace.sidebar"))" class="workspace-sidebar" id="workspace-sidebar">
        <div class="sidebar-projects">
        @* The projects list is the sidebar's top level now, so it has no heading of its own and
           nothing to collapse it into. Creating a project is an action row at the head of the
           list — the position the button already occupied, minus the section chrome around it. *@
        @* Search opens in the right-hand drawer slot, like the settings sections: the results sit
           beside the transcript they lead into instead of replacing the project tree. *@
        <button @attributes="@(ControlHints.Attributes("workspace.search", "Search messages (Ctrl+K)"))" class="workspace-nav-item search-nav-action @(_isSearchOpen ? "selected" : string.Empty)" type="button" data-search-open
                aria-keyshortcuts="Control+K" aria-expanded="@(_isSearchOpen ? "true" : "false")" aria-controls="search-drawer" @onclick="ToggleSearchPanelAsync">
            <AppIcon Name="search" /><span class="nav-item-label">Search</span><kbd class="nav-item-shortcut" aria-hidden="true">Ctrl+K</kbd>
        </button>
        <div id="projects-nav">
        <button @attributes="@(ControlHints.Attributes("projects.create", "New project (Alt+Shift+N)"))" class="workspace-nav-item new-project-action" type="button" data-hotkey="Alt+Shift+KeyN" aria-keyshortcuts="Alt+Shift+N" @onclick="BeginProjectCreation"><AppIcon Name="plus" /><span class="nav-item-label">New project</span><kbd class="nav-item-shortcut" aria-hidden="true">Alt+Shift+N</kbd></button>
        @if (ProjectsBusy.IsVisible)
        {
            <div class="sidebar-skeleton" role="status" aria-label="Loading projects">
                @for (var row = 0; row < SkeletonProjectRows; row++)
                {
                    <div class="sidebar-skeleton-row" aria-hidden="true"><span class="sidebar-skeleton-mark"></span><span class="sidebar-skeleton-label"></span></div>
                }
            </div>
        }
        @if (_isCreatingProject)
        {
            <div class="project-nav-row project-nav-row-new">
                <input class="sidebar-inline-editor" @ref="_editingInput" value="@_newProjectName" @oninput="e => _newProjectName = e.Value?.ToString() ?? string.Empty" @onkeydown="HandleNewProjectKeyDownAsync" @onblur="SaveNewProjectAsync" placeholder="Project name" aria-label="Project name" />
            </div>
        }
        @foreach (var project in _projects)
        {
            <div @key="project.Id" data-project-id="@project.Id" class="project-nav-row @(project.Id == _selectedProject?.Id ? "selected" : string.Empty) @(_draggedProjectId == project.Id ? "dragging" : string.Empty)" title="@GetProjectRunTitle(project.Id)" draggable="true" @ondragstart="() => OnProjectDragStart(project.Id)" @ondragover="OnDragOver" @ondragover:preventDefault="true" @ondrop="() => OnProjectDrop(project)" @oncontextmenu="() => OnProjectContextMenu(project)" @oncontextmenu:preventDefault="true">
                @if (_editingProjectId == project.Id)
                {
                    <input class="sidebar-inline-editor" @ref="_editingInput" value="@_editingTitle" @oninput="e => _editingTitle = e.Value?.ToString() ?? string.Empty" @onkeydown="e => HandleInlineEditKeyAsync(e, () => SaveProjectTitleAsync(project))" @onblur="() => SaveProjectTitleAsync(project)" aria-label="Project name" />
                }
                else
                {
                    @* Clicking the active project lands on its "new chat" composer, mirroring the
                       per-project "+" button. Clicking a different project restores the
                       chat/branch the user last left on, the same way a fresh page load does.
                       Without the same-project shortcut the user would have to reach for the
                       "+" button every time they wanted to start a new conversation in the
                       project they were already in. *@
                    <button @attributes="@(ControlHints.Attributes("project"))" class="workspace-nav-item project-link" type="button" aria-keyshortcuts="Alt+ArrowUp Alt+ArrowDown" @onkeydown="e => HandleProjectItemKeyDownAsync(e, project)" @onclick="() => HandleProjectItemClickAsync(project)"><span class="status-dot @GetProjectStatusClass(project.Id)"></span><span class="nav-item-label">@project.Name</span></button>
                }
                <button @attributes="@(ControlHints.Attributes((project.Id == _selectedProject?.Id ? "chat.new" : null), (project.Id == _selectedProject?.Id ? "New chat (Alt+N)" : "New chat")))" class="icon-action project-action-button project-new-chat-button" type="button" aria-label="New chat"
                        data-hotkey="@(project.Id == _selectedProject?.Id ? "Alt+KeyN" : null)" aria-keyshortcuts="@(project.Id == _selectedProject?.Id ? "Alt+N" : null)" @onclick="() => CreateChatForProjectAsync(project)"><AppIcon Name="plus" /></button>
                <button class="icon-action project-action-button project-rename-button" type="button" title="Rename" aria-label="Rename project" @onclick="() => BeginProjectRenameAsync(project)"><AppIcon Name="edit" /></button>
                <button @attributes="@(ControlHints.Attributes((project.Id == _selectedProject?.Id ? "project.menu" : null), "Project settings"))" class="icon-action project-action-button project-menu-button @(_isProjectMenuOpen && project.Id == _selectedProject?.Id ? "menu-open" : string.Empty)" type="button" aria-label="Project settings" @onclick="() => ToggleProjectMenuAsync(project)"><AppIcon Name="more" /></button>
            </div>
            @if (project.Id == _selectedProject?.Id)
            {
                @* Chat and branch rows carry the shared help as data attributes for the guide but no
                   tooltip: explaining what a chat is would cover the list on every hover, while the
                   row's own title already says something about this chat rather than the control. *@
                <nav class="workspace-chat-list" aria-label="Chats in @project.Name" @onkeydown="OnChatListKeyDown" @onpointerenter="OnChatListPointerEnter" @onpointerleave="OnChatListPointerLeave">
                    @{
                        var orderedChats = GetOrderedChats();
                        var visibleChatCount = GetVisibleChatCount(orderedChats);
                        var hiddenChatCount = orderedChats.Count - visibleChatCount;
                        var hiddenChatAttention = hiddenChatCount > 0 ? CountHiddenChatsNeedingAttention(orderedChats, visibleChatCount) : 0;
                        var pinnedChatCount = orderedChats.Count(item => item.IsPinned);
                    }
                    @if (pinnedChatCount == 0 && _isChatDragActive)
                    {
                        <div @key="PinDividerKey" class="chat-pin-divider empty" aria-hidden="true"><span>Drop here to pin</span></div>
                    }
                    @for (var chatIndex = 0; chatIndex < visibleChatCount; chatIndex++)
                    {
                        var chat = orderedChats[chatIndex];
                        var branchCount = GetBranchCount(chat);
                        <div @key="chat.Id" class="chat-nav-row @(chat.Id == GetActiveChatId() && GetSelectedBranchId() is null ? "selected" : string.Empty)" data-chat-id="@chat.Id" data-pinned="@(chat.IsPinned ? "true" : "false")" title="@GetRunTitle(chat.Id, chat.Id, GetRun(chat.Id, chat.Id))" @oncontextmenu="() => OnChatContextMenu(chat.Id)" @oncontextmenu:preventDefault="true">
                            @if (_editingChatId == chat.Id)
                            {
                                <input class="sidebar-inline-editor chat-link" @ref="_editingInput" value="@_editingTitle" @oninput="e => _editingTitle = e.Value?.ToString() ?? string.Empty" @onkeydown="e => HandleInlineEditKeyAsync(e, () => SaveChatTitleAsync(chat))" @onblur="() => SaveChatTitleAsync(chat)" aria-label="Chat name" />
                            }
                            else
                            {
                                <button @attributes="@(ControlHints.Attributes("chat", nativeTooltip: false))" class="workspace-nav-item chat-link" type="button" aria-keyshortcuts="@(chat.IsPinned ? "Alt+ArrowUp Alt+ArrowDown Alt+P" : "Alt+P")" @onkeydown="e => HandleChatItemKeyDownAsync(e, chat)" @onclick="() => SelectChatAsync(chat.Id)"><span class="chat-icon-with-branch-count"><AppIcon Name="@(chat.IsPinned ? "pin" : "message-circle")" Class="@GetRunStatusClass(chat.Id, chat.Id, GetRun(chat.Id, chat.Id))" />@if (branchCount > 0) { <span class="chat-branch-count @GetChatBranchStatusClass(chat.Id)" title="@GetChatBranchCountTitle(chat, branchCount)">@FormatBranchCount(branchCount)</span> }</span><span class="nav-item-label">@chat.Title</span>@if (branchCount > 0) { <span class="visually-hidden">, @GetBranchCountTitle(branchCount)</span> }</button>
                            }
                            <button class="icon-action chat-row-action" type="button" title="Rename" aria-label="Rename chat" @onclick="() => BeginChatRename(chat)"><AppIcon Name="edit" /></button>
                            <button class="icon-action chat-row-action chat-menu-button @(_chatMenuId == chat.Id ? "menu-open" : string.Empty)" type="button" title="Chat menu" aria-label="Chat menu" @onclick="() => ToggleChatMenuAsync(chat.Id)"><AppIcon Name="more" /></button>
                            @if (_chatMenuId == chat.Id)
                            {
                                <div class="chat-menu" role="menu" @onclick:stopPropagation="true">
                                    <button type="button" role="menuitem" @onclick="() => ToggleChatPinAsync(chat)">
                                        <AppIcon Name="@(chat.IsPinned ? "unpin" : "pin")" />
                                        <span>@(chat.IsPinned ? "Unpin chat" : "Pin chat")</span>
                                    </button>
                                    <button type="button" role="menuitem" @onclick="() => OpenChatPermissions(chat)">
                                        <AppIcon Name="tool" />
                                        <span>Tool permissions</span>
                                        @if (GetChatPermissionCount(chat.Id) > 0)
                                        {
                                            <span class="menu-count">@GetChatPermissionCount(chat.Id)</span>
                                        }
                                    </button>
                                    @if (_menuReviews.TryGetValue(chat.Id, out var chatReviews) && chatReviews.Any(item => item.Kind == ChatReviewKind.Diff))
                                    {
                                        <button id="chat-reviews-trigger-@chat.Id" class="review-submenu-trigger" type="button" role="menuitem" aria-haspopup="menu" aria-expanded="@(_reviewSubmenuChatId == chat.Id)" @onclick="() => ToggleReviewSubmenu(chat.Id, false)"><AppIcon Name="diff" /><span>Reviews</span><AppIcon Name="chevron-right" /></button>
                                        @if (_reviewSubmenuChatId == chat.Id)
                                        {
                                        <div id="chat-reviews-popup-@chat.Id" popover="manual" class="review-submenu" role="menu" aria-label="Chat reviews">
                                            <div class="review-menu-list">
                                            @foreach (var review in chatReviews.Where(item => item.Kind == ChatReviewKind.Diff).OrderByDescending(item => item.UpdatedAt))
                                            {
                                                <div class="review-menu-row" @key="review.Id">
                                                    @if (_confirmingReviewDeleteId == review.Id)
                                                    {
                                                        <span class="review-menu-confirm-label">Delete review?</span>
                                                        <button type="button" class="review-menu-confirm-delete" aria-label="Delete @review.Name" @onclick="() => DeleteReviewAsync(chat.Id, review.Id)">Delete</button>
                                                        <button type="button" class="review-menu-cancel" title="Cancel deletion" aria-label="Cancel deletion" @onclick="() => _confirmingReviewDeleteId = null"><AppIcon Name="x" /></button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="review-menu-open" role="menuitem" title="@review.Name" @onclick="() => OpenReviewForChatAsync(chat.Id, review.Id)"><AppIcon Name="diff" /><span>@review.Name</span></button>
                                                        <button type="button" class="review-menu-delete" title="Delete review" aria-label="Delete @review.Name" @onclick="() => _confirmingReviewDeleteId = review.Id"><AppIcon Name="trash" /></button>
                                                    }
                                                </div>
                                            }
                                            </div>
                                        </div>
                                        }
                                    }
                                    <button type="button" role="menuitem" @onclick="() => ArchiveChatAsync(chat)"><AppIcon Name="archive" /><span>Archive chat</span></button>
                                    @if (_isConfirmingChatDelete)
                                    {
                                        <div class="project-menu-confirm"><span>Delete this chat and all its branches?</span><button class="danger compact-action" type="button" disabled="@(_deletingChatId is not null)" @onclick="() => DeleteChatAsync(chat)">Delete</button><button class="confirm-cancel" type="button" title="Cancel" aria-label="Cancel" @onclick="CancelChatDelete"><AppIcon Name="x" /></button></div>
                                    }
                                    else
                                    {
                                        <button class="menu-danger" type="button" role="menuitem" @onclick="ConfirmChatDelete"><AppIcon Name="trash" />Delete chat</button>
                                    }
                                </div>
                            }
                        </div>
                        @if (_selectedChat?.Id == chat.Id)
                        {
                            @foreach (var branch in GetBranchTreeItems())
                            {
                                <div class="chat-nav-row branch-nav-row @(GetSelectedBranchId() == branch.RootId ? "selected" : string.Empty)" data-branch-id="@branch.RootId" title="@GetRunTitle(chat.Id, branch.RootId, GetBranchRun(chat.Id, branch))" style="--branch-depth: @Math.Min(branch.Depth, 3)">
                                    <span class="branch-tree-line" aria-hidden="true"></span>
                                    @if (_editingBranchId == branch.RootId)
                                    {
                                        <input class="sidebar-inline-editor chat-link" @ref="_editingInput" value="@_editingTitle" @oninput="e => _editingTitle = e.Value?.ToString() ?? string.Empty" @onkeydown="e => HandleInlineEditKeyAsync(e, () => SaveBranchTitleAsync(branch))" @onblur="() => SaveBranchTitleAsync(branch)" aria-label="Branch name" />
                                    }
                                    else
                                    {
                                        <button @attributes="@(ControlHints.Attributes("branch", nativeTooltip: false))" class="workspace-nav-item chat-link branch-link" type="button" @onclick="() => SelectBranchTreeItemAsync(branch)"><AppIcon Name="git-branch" Class="@GetRunStatusClass(chat.Id, branch.RootId, GetBranchRun(chat.Id, branch))" /><span class="nav-item-label">@branch.Title</span></button>
                                    }
                                    <button class="icon-action chat-row-action" type="button" title="Rename" aria-label="Rename branch" @onclick="() => BeginBranchRename(branch)"><AppIcon Name="edit" /></button>
                                    <button class="icon-action chat-row-action chat-menu-button @(_branchMenuId == branch.RootId ? "menu-open" : string.Empty)" type="button" title="Branch menu" aria-label="Branch menu" @onclick="() => ToggleBranchMenuAsync(branch.RootId)"><AppIcon Name="more" /></button>
                                    @if (_branchMenuId == branch.RootId)
                                    {
                                        <div class="chat-menu" role="menu" @onclick:stopPropagation="true">
                                            @if (ReviewsForBranch(branch).Count > 0)
                                            {
                                                <button id="branch-reviews-trigger-@branch.RootId" class="review-submenu-trigger" type="button" role="menuitem" aria-haspopup="menu" aria-expanded="@(_reviewSubmenuBranchId == branch.RootId)" @onclick="() => ToggleReviewSubmenu(branch.RootId, true)"><AppIcon Name="diff" /><span>Reviews</span><AppIcon Name="chevron-right" /></button>
                                                @if (_reviewSubmenuBranchId == branch.RootId)
                                                {
                                                <div id="branch-reviews-popup-@branch.RootId" popover="manual" class="review-submenu" role="menu" aria-label="Branch reviews">
                                                    <div class="review-menu-list">
                                                    @foreach (var review in ReviewsForBranch(branch))
                                                    {
                                                        <div class="review-menu-row" @key="review.Id">
                                                            @if (_confirmingReviewDeleteId == review.Id)
                                                            {
                                                                <span class="review-menu-confirm-label">Delete review?</span>
                                                                <button type="button" class="review-menu-confirm-delete" aria-label="Delete @review.Name" @onclick="() => DeleteReviewAsync(chat.Id, review.Id)">Delete</button>
                                                                <button type="button" class="review-menu-cancel" title="Cancel deletion" aria-label="Cancel deletion" @onclick="() => _confirmingReviewDeleteId = null"><AppIcon Name="x" /></button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" class="review-menu-open" role="menuitem" title="@review.Name" @onclick="() => OpenReviewForBranchAsync(branch, review.Id)"><AppIcon Name="diff" /><span>@review.Name</span></button>
                                                                <button type="button" class="review-menu-delete" title="Delete review" aria-label="Delete @review.Name" @onclick="() => _confirmingReviewDeleteId = review.Id"><AppIcon Name="trash" /></button>
                                                            }
                                                        </div>
                                                    }
                                                    </div>
                                                </div>
                                                }
                                            }
                                            @if (_confirmingBranchDeleteId == branch.RootId)
                                            {
                                                <div class="project-menu-confirm"><span>Delete this branch?</span><button class="danger compact-action" type="button" @onclick="() => DeleteBranchAsync(branch)">Delete</button><button class="confirm-cancel" type="button" title="Cancel" aria-label="Cancel" @onclick="CancelBranchDelete"><AppIcon Name="x" /></button></div>
                                            }
                                            else
                                            {
                                                <button class="menu-danger" type="button" role="menuitem" @onclick="() => ConfirmBranchDelete(branch.RootId)"><AppIcon Name="trash" />Delete branch</button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                        @if (chatIndex == pinnedChatCount - 1)
                        {
                            <div @key="PinDividerKey" class="chat-pin-divider" aria-hidden="true"></div>
                        }
                    }
                    @if (hiddenChatCount > 0 || _visibleChatCount > ChatPageSize)
                    {
                        <div class="chat-list-pager">
                            @if (hiddenChatCount > 0)
                            {
                                <button class="workspace-nav-item chat-list-more" type="button" @onclick="ShowMoreChats" aria-label="@GetShowMoreChatsLabel(hiddenChatCount, hiddenChatAttention)"><span class="nav-item-label">Show @hiddenChatCount more</span>@if (hiddenChatAttention > 0) { <span class="chat-list-more-attention" title="@GetHiddenAttentionTitle(hiddenChatAttention)" aria-hidden="true">@FormatBranchCount(hiddenChatAttention)</span> }</button>
                            }
                            @if (_visibleChatCount > ChatPageSize)
                            {
                                <button class="workspace-nav-item chat-list-less" type="button" @onclick="ShowFewerChats" aria-label="Show fewer chats"><span class="nav-item-label">Less</span></button>
                            }
                        </div>
                    }
                    @if (ChatsBusy.IsVisible)
                    {
                        <div class="sidebar-skeleton" role="status" aria-label="Loading chats">
                            @for (var row = 0; row < SkeletonChatRows; row++)
                            {
                                <div class="sidebar-skeleton-row" aria-hidden="true"><span class="sidebar-skeleton-mark"></span><span class="sidebar-skeleton-label"></span></div>
                            }
                        </div>
                    }
                    else if (orderedChats.Count == 0) { <span class="empty-hint">No active chats</span> }
                    @if (_archiveSuggestionProject == project.Id && _archiveSuggestionCount >= 10)
                    {
                        <div class="archive-suggestion" role="status"><span>@_archiveSuggestionCount chats inactive for 30 days</span><button type="button" @onclick="() => OpenArchive(true)">Review</button><button class="icon-action" type="button" title="Dismiss cleanup suggestion" aria-label="Dismiss cleanup suggestion" @onclick="DismissArchiveSuggestionAsync"><AppIcon Name="x" /></button></div>
                    }
                    <button class="workspace-nav-item archive-nav-item" type="button" @onclick="() => OpenArchive(false)"><AppIcon Name="archive" /><span class="nav-item-label">Archive · @_chats.Count(chat => chat.ArchivedAt is not null)</span></button>
                </nav>
                <div class="directory-nav-group">
                    @if (_security.DirectoryGrants.Count == 0)
                    {
                        <button class="workspace-nav-item directory-empty-action" type="button" @onclick="OpenDirectoryPickerForNewGrant">
                            <AppIcon Name="folder-plus" />
                            <span class="nav-item-label">Add directory</span>
                        </button>
                    }
                    else
                    {
                        <div class="directory-nav-row directory-nav-row-header">
                            <span class="directory-row-main">
                                <button class="icon-action directory-toggle" type="button" aria-expanded="@_directoriesExpanded" title="@(_directoriesExpanded ? "Collapse project directory grants" : "Show project directory grants")" aria-label="Toggle directories" @onclick="ToggleDirectoriesExpanded"><AppIcon Name="@(_directoriesExpanded ? "chevron-down" : "chevron-right")" /></button>
                                <AppIcon Name="folder" />
                                <span class="nav-item-label directory-label">Directories</span>
                                <span class="directory-count" title="Directories the assistant's file tools are allowed to access for this project">@_security.DirectoryGrants.Count</span>
                            </span>
                            <button class="icon-action directory-row-action directory-add-button" type="button" title="Add directory" aria-label="Add directory" @onclick="OpenDirectoryPickerForNewGrant"><AppIcon Name="plus" /></button>
                        </div>
                        @if (_directoriesExpanded)
                        {
                            @foreach (var directory in _security.DirectoryGrants)
                            {
                                <div class="directory-nav-row directory-nav-row-child" draggable="true" data-drag-path="@directory.CanonicalRoot" data-drag-kind="Directory">
                                    <span class="directory-row-main">
                                        <span class="nav-item-label directory-name" title="@directory.CanonicalRoot">@GetDirectoryDisplayNameSuggestion(directory.CanonicalRoot)</span>
                                    </span>
                                    <button class="directory-lock-indicator @(directory.Mode == "Read/write" ? "directory-lock-rw" : "directory-lock-ro")" type="button" title="@(directory.Mode == "Read/write" ? "Read/write — click to make read only" : "Read only — click to allow write")" aria-label="Toggle directory access mode" @onclick="() => ToggleDirectoryModeAsync(directory)"><AppIcon Name="@(directory.Mode == "Read/write" ? "unlock" : "lock")" /></button>
                                    <button class="icon-action directory-row-action directory-edit-button" type="button" title="Change directory" aria-label="Change directory" @onclick="() => OpenDirectoryPicker(directory)"><AppIcon Name="edit" /></button>
                                    <button class="icon-action directory-row-action directory-menu-button @(_directoryMenuId == directory.Id ? "menu-open" : string.Empty)" type="button" title="Directory menu" aria-label="Directory menu" @onclick="() => ToggleDirectoryMenu(directory.Id)"><AppIcon Name="more" /></button>
                                    @if (_directoryMenuId == directory.Id)
                                    {
                                        <div class="chat-menu" role="menu" @onclick:stopPropagation="true">
                                            @if (_isConfirmingDirectoryDelete)
                                            {
                                                <div class="review-menu-row"><span class="review-menu-confirm-label">Remove access?</span><button type="button" class="review-menu-confirm-action" title="Files stay on disk" @onclick="() => RemoveDirectoryGrantAsync(directory.Id)">Remove</button><button type="button" class="review-menu-cancel" title="Cancel removing directory access" aria-label="Cancel" @onclick="CancelDirectoryDelete"><AppIcon Name="x" /></button></div>
                                            }
                                            else
                                            {
                                                <button type="button" role="menuitem" @onclick="ConfirmDirectoryDelete"><AppIcon Name="folder-minus" />Remove access</button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                </div>
            }
        }
        </div>
        <span class="visually-hidden" role="status" aria-live="polite">@_sidebarAnnouncement</span>
        </div>
        <nav class="global-nav root-nav sidebar-global-nav" aria-label="Application settings">
            <button class="workspace-nav-item @(_globalSection == "Connections" ? "selected" : string.Empty)" type="button" title="Connections (Alt+1)" data-hotkey="Alt+Digit1" aria-keyshortcuts="Alt+1" @onclick='() => OpenGlobalSection("Connections")'><AppIcon Name="connection" /><span>Connections</span><span class="directory-count" title="Enabled model connections">@_connections.Count(item => item.Enabled)</span><kbd class="nav-item-shortcut" aria-hidden="true">Alt+1</kbd></button>
            <button class="workspace-nav-item @(_globalSection == "MCP" ? "selected" : string.Empty)" type="button" title="MCP (Alt+2)" data-hotkey="Alt+Digit2" aria-keyshortcuts="Alt+2" @onclick='() => OpenGlobalSection("MCP")'><AppIcon Name="mcp" /><span>MCP</span><span class="directory-count" title="Enabled MCP servers">@_enabledMcpServerCount</span><kbd class="nav-item-shortcut" aria-hidden="true">Alt+2</kbd></button>
            <button class="workspace-nav-item @(_globalSection == "Memory" ? "selected" : string.Empty)" type="button" title="Memory (Alt+3)" data-hotkey="Alt+Digit3" aria-keyshortcuts="Alt+3" @onclick='() => OpenGlobalSection("Memory")'><AppIcon Name="memory" /><span>Memory</span><span class="directory-count" title="Enabled personal memory entries">@_userMemoryCount</span><kbd class="nav-item-shortcut" aria-hidden="true">Alt+3</kbd></button>
            <button class="workspace-nav-item @(_globalSection == "Skills" ? "selected" : string.Empty)" type="button" title="Skills (Alt+4)" data-hotkey="Alt+Digit4" aria-keyshortcuts="Alt+4" @onclick='() => OpenGlobalSection("Skills")'><AppIcon Name="skill" /><span>Skills</span><span class="directory-count" title="Enabled personal skills">@_skillCount</span><kbd class="nav-item-shortcut" aria-hidden="true">Alt+4</kbd></button>
            <button class="workspace-nav-item @(_globalSection == "Settings" ? "selected" : string.Empty)" type="button" title="Settings (Alt+0)" data-hotkey="Alt+Digit0" aria-keyshortcuts="Alt+0" @onclick='() => OpenGlobalSection("Settings")'><AppIcon Name="settings" /><span>Settings</span>@if (ClientMode.PublicWeb)
                {
                    @* The only place the published app shows its link to the Host; details and
                       Disconnect are in Settings. *@
                    var (hostState, hostLabel) = HostConnection.Status switch
                    {
                        HostConnectionStatus.Connected => ("is-connected", "Host connected"),
                        HostConnectionStatus.Offline => ("is-offline", "Reconnecting to Host…"),
                        _ => ("is-connecting", "Connecting to Host…")
                    };
                    <span class="host-status-dot @hostState" role="img" aria-label="@hostLabel" title="@hostLabel"></span>
                }<kbd class="nav-item-shortcut" aria-hidden="true">Alt+0</kbd></button>
        </nav>
    </aside>

    <div class="workspace-resizer" data-side="left" role="separator" tabindex="0" aria-orientation="vertical"
         aria-label="Resize project sidebar" aria-controls="workspace-sidebar" aria-valuemin="0"
         title="Drag to resize, drag to the edge to hide · Double-click to hide or show"></div>

    <section class="workspace-conversation" aria-label="Chat">
        <header class="workspace-header">
            @* Hiding the sidebar is a layout preference kept by workspaceLayout.js, which also
               handles this button; the edge of a hidden sidebar is easy to miss, this is not. *@
            <button @attributes="@(ControlHints.Attributes("workspace.sidebar.toggle", "Toggle sidebar (Ctrl+B)"))" class="icon-action sidebar-toggle-button" type="button" data-sidebar-toggle
                    aria-controls="workspace-sidebar" aria-label="Toggle sidebar">
                <AppIcon Name="panel-left" />
            </button>
            <div class="notification-quick-access @(_hideNotificationPreview ? "preview-hidden" : null)" @onpointerleave="RestoreNotificationPreview">
                <button @attributes="@(ControlHints.Attributes("workspace.notifications"))" class="history-notifications-button" type="button" aria-label="Notifications" aria-expanded="@_notificationsOpen" @onclick="ToggleNotificationsAsync">
                    <AppIcon Name="bell" />
                    @if (Notifications.UnreadCount > 0) { <span class="notification-count">@Notifications.UnreadCount</span> }
                </button>
                @if (!_notificationsOpen)
                {
                    var recentNotifications = Notifications.History.Where(item => item.ProjectId is not null && item.ChatId is not null).Take(4).ToList();
                    <div class="notification-quick-popover">
                        <div class="notification-quick-surface" role="group" aria-label="Recent chat notifications">
                            <div class="notification-quick-heading">Recent notifications</div>
                            @foreach (var item in recentNotifications)
                            {
                                <button class="notification-quick-item @(item.IsSeen ? string.Empty : "new") @(item.Kind == NotificationKind.Error ? "error" : item.RequiresAction && !item.IsResolved ? "attention" : string.Empty)" type="button" @onclick="() => OpenNotificationAsync(item)">
                                    <AppIcon Name="@(item.Kind == NotificationKind.Error ? "error" : item.RequiresAction && !item.IsResolved ? "info" : "check")" />
                                    <span><strong>@item.Message</strong><small>@item.CreatedAt.LocalDateTime.ToString("g")@(item.IsResolved ? " · Resolved" : string.Empty)</small></span>
                                </button>
                            }
                            @if (recentNotifications.Count == 0) { <p class="notification-quick-empty">No chat notifications yet</p> }
                            <button class="notification-quick-all" type="button" @onclick="ToggleNotificationsAsync">All notifications <AppIcon Name="chevron-right" /></button>
                        </div>
                    </div>
                }
            </div>
            <div class="workspace-history-actions">
                <button class="icon-action" type="button" title="Back" aria-label="Back" disabled="@(!_canNavigateBack)" @onclick="GoBackAsync"><AppIcon Name="chevron-left" /></button>
                <button class="icon-action" type="button" title="Forward" aria-label="Forward" disabled="@(!_canNavigateForward)" @onclick="GoForwardAsync"><AppIcon Name="chevron-right" /></button>
            </div>
            <span class="workspace-location" title="@GetWorkspaceLocation()">@GetWorkspaceLocation()</span>
            @if (_selectedProject is not null)
            {
                <button @attributes="@(ControlHints.Attributes("chat.widgets", (_chatWidgetsOpen ? "Hide chat widgets" : "Show chat widgets")))" class="icon-action workspace-widgets-toggle" type="button"
                        aria-label="Chat widgets" aria-pressed="@(_chatWidgetsOpen ? "true" : "false")"
                        @onclick="ToggleChatWidgetsAsync">
                    <AppIcon Name="panel-right" />
                </button>
            }
        </header>
        <MessageFeed @ref="_messageFeed"
            HasSelectedProject="@(_selectedProject is not null)"
            SelectedProjectName="@_selectedProject?.Name"
            OnOpenProjectMenu="OpenProjectMenuAtAsync"
            SelectedProjectId="@_selectedProject?.Id"
            HasProjectDirectories="@(_security.DirectoryGrants.Count > 0)"
            IsComposerEmpty="@string.IsNullOrEmpty(_chat.Message)"
            OnInsertComposerText="InsertComposerTextAsync"
            OnAddDirectory="OpenDirectoryPickerForNewGrant"
            OnCreateSkill='() => OpenGlobalSection("ProjectSkills")'
            OnStartGuide='() => StartGuideTopicAsync(new AppGuideTopicsView.GuideTopicSelection("basic", "show"))'
            HasModel="@HasEnabledModel"
            OnCreateProject="BeginProjectCreation"
            OnStartGuideTopic='topic => StartGuideTopicAsync(new AppGuideTopicsView.GuideTopicSelection(topic, "show"))'
            OnOpenSettings="OpenGlobalSection"
            SearchQuery="@_searchQuery"
            OnSearchPositionChanged="OnFeedSearchPositionChanged"
            SelectedChat="@_selectedChat"
            TranscriptId="@_selectedBranchId"
            BranchLeafId="@_branchLeafId"
            JustArrivedLeafId="@_justArrivedLeafId"
            ForkSourceId="@_forkSourceId"
            MessageBranchMenuId="@_messageBranchMenuId"
            SelectedRun="@GetSelectedRun()"
            ChatUsage="@(_selectedChat is null ? null : ChatUsage.Find(_selectedChat.Id))"
            ShowTurnTokens="@_showTurnTokens"
            LiveNoteCount="@_liveNoteCount"
            ActiveCheckpoint="@GetActiveCheckpoint()"
            OnUndoCheckpoint="UndoCheckpointAsync"
            GeneratingElapsed="@GetGeneratingElapsed()"
            TranscriptRunPresentationVersion="@GetTranscriptRunPresentationVersion()"
            GetRunForBranch="@(messageId => _selectedChat is null ? null : GetRun(_selectedChat.Id, BranchLeafHelpers.RunBranchIdFor(messageId, _selectedChat)))"
            OnCopyMessage="CopyMessageAsync"
            OnReviewChanges="OpenReviewFromChangesAsync"
            OnOpenReview="OpenAttachedReviewAsync"
            OnOpenChat="SelectChatAsync"
            OnNavigateApp="OpenAppNavigationLinkAsync"
            OnFileLinkMenu="OpenFileLinkMenu"
            OnOpenFile="OpenFileLinkPreviewAsync"
            OnOpenAsset="OpenAssetPreviewAsync"
            ReviewNames="@_reviews.ToDictionary(item => item.Id, item => item.Name)"
            MessageReviewIds="@_reviews.Where(item => item.Kind == ChatReviewKind.Message).Select(item => item.Id).ToHashSet()"
            MessageReviews="@_reviews.Where(item => item.Kind == ChatReviewKind.Message).GroupBy(item => item.SourceMessageId).ToDictionary(group => group.Key, group => group.OrderByDescending(item => item.UpdatedAt).First())"
            DiffReviews="@_reviews.Where(item => item.Kind == ChatReviewKind.Diff).GroupBy(item => item.SourceMessageId).ToDictionary(group => group.Key, group => group.OrderByDescending(item => item.UpdatedAt).First())"
            OnDiffReviewChanged="OnReviewChangedAsync"
            OnMessageReviewChanged="OnReviewChangedAsync"
            OnAttachMessageReview="AttachReviewAsync"
            ReviewVersion="@_reviewVersion"
            OnForkFromMessage="ForkFromMessageAsync"
            OnEditAndBranch="EditAndBranchAsync"
            OnEditAndReplaceBranch="EditAndReplaceBranchAsync"
            OnToggleBranchMenu="ToggleMessageBranchMenu"
            OnSelectBranch="SelectMessageBranch"
            OnOpenSenderBranch="OpenSenderBranchAsync"
            OnSelectBranchLeaf="SelectMessageBranchLeaf"
            OnBranchPickerKeyDown="HandleBranchPickerKeyDown"
            OnCurrentTurnSummaryVisibilityChanged="SetCurrentTurnSummaryVisibility"
            OnReachedBottom="MarkSelectedConversationReadAsync"
            OnResumeRun="ResumeQueueAsync"
            OnRebaseRun="RebaseQueueAsync"
            OnDiscardRun="DiscardCommandAsync">
        </MessageFeed>
        <div class="composer-dock">
        @if (GetLiveTurnChanges() is { } dockedChanges)
        {
            <WorkspaceChanges @key="@GetSelectedRun()?.ActiveMessageId"
                              Changes="@dockedChanges" Label="Current turn" Live="true" ExpandUpward="true"
                              ProjectId="@_selectedChat!.ProjectId" ChatId="@_selectedChat.Id" />
        }
        @if (GetSelectedRun() is { } selectedRun && GetPendingQueue(selectedRun) is { Count: > 0 } pendingQueue)
        {
            @* Only what has not been sent yet. A command that is already a message in the
               transcript belongs to the turn chip above, not to a list whose every row promises
               that it can still be edited, reordered or removed. *@
            <section class="chat-queue chat-summary-card opens-upward @(_isQueueExpanded ? "is-expanded" : "is-collapsed") @(_queueActionPending ? "queue-busy" : null)"
                     aria-label="Queued messages" aria-busy="@(_queueActionPending ? "true" : "false")">
                <div class="queue-header chat-summary-top">
                    <button class="queue-summary chat-summary-toggle chat-card-header" type="button" aria-expanded="@_isQueueExpanded" @ref="_queueHeader"
                            aria-controls="queued-message-details" title="@(_isQueueExpanded ? "Collapse queued messages" : "Expand queued messages")"
                            @onclick="ToggleQueueDetailsAsync">
                        <span class="chat-summary-icon chat-card-mark" aria-hidden="true"><AppIcon Name="queue" /></span>
                        <span class="chat-summary-title chat-card-title">Queued · @pendingQueue.Count</span>
                        <span class="chat-summary-chevron" aria-hidden="true"><AppIcon Name="chevron-down" /></span>
                    </button>
                    <div class="queue-actions chat-card-header-actions">
                        @if (_isConfirmingQueueClearAll)
                        {
                            <span class="queue-clear-confirm">
                                <span>Stop the run and drop everything?</span>
                                <button class="chat-card-action chat-card-action-danger" type="button" @onclick="ClearEverythingAsync">Clear all</button>
                                <button class="chat-card-action chat-card-action-icon" type="button" title="Cancel" aria-label="Cancel" @onclick="() => _isConfirmingQueueClearAll = false"><AppIcon Name="x" /></button>
                            </span>
                        }
                        else
                        {
                            <button type="button" class="queue-action-button queue-action-clear chat-card-action chat-card-action-icon" title="@($"Remove the {pendingQueue.Count} message(s) still waiting in the queue")"
                                    aria-label="Clear queued messages" @onclick="ClearQueueAsync"><AppIcon Name="queue-clear" /></button>
                            @if (HasCommittedCommand(selectedRun))
                            {
                                <button type="button" class="queue-action-button destructive-action chat-card-action chat-card-action-icon chat-card-action-danger" title="Stop the run and clear everything, including the message already sent"
                                        aria-label="Stop and clear everything" @onclick="() => _isConfirmingQueueClearAll = true"><AppIcon Name="trash" /></button>
                            }
                        }
                    </div>
                </div>
                <div class="chat-summary-details" id="queued-message-details" aria-hidden="@(!_isQueueExpanded)" inert="@(!_isQueueExpanded)">
                    <div class="chat-summary-details-inner">
                        <div class="queue-items">
                            @foreach (var item in pendingQueue)
                            {
                                <div @key="item.Id" class="queue-item" data-queue-id="@item.Id">
                                    @if (_editingQueueId == item.Id)
                                    {
                                        <input value="@_editingQueueText" @oninput="args => _editingQueueText = args.Value?.ToString() ?? string.Empty"
                                               @onkeydown="args => HandleQueueEditKeyAsync(args, item.Id)" @onblur="() => SaveQueuedMessageAsync(item.Id)" autofocus />
                                    }
                                    else
                                    {
                                        @* An aside has no place in the order: the turn in flight takes it at its next
                                           step, or it follows the reply. Only its text and its presence can change. *@
                                        @if (!item.IsAside)
                                        {
                                            <button class="queue-drag-handle" type="button" title="Drag to reorder" aria-label="Drag queued message"><AppIcon Name="drag" /></button>
                                        }
                                        <span title="@item.Content">
                                            @if (item.IsAside)
                                            {
                                                <span class="queue-aside-label" title="Read by the turn in flight at its next step, or added after its reply">Aside</span>
                                            }
                                            @(string.IsNullOrWhiteSpace(item.Content) ? "Workspace references" : GetSingleLine(item.Content))
                                            @if (item.Resources is { Count: > 0 })
                                            {
                                                <span class="queue-resource-count"> refs: @item.Resources.Count</span>
                                            }
                                        </span>
                                        @if (!item.IsAside)
                                        {
                                            <button class="icon-action queue-send-now" type="button" title="Interrupt and send this message now" aria-label="Interrupt and send this message now" @onclick="() => SendQueuedMessageNowAsync(item.Id)"><AppIcon Name="zap" /></button>
                                            <button class="icon-action" type="button" title="Move up" aria-label="Move up" @onclick="() => MoveQueuedMessageAsync(item.Id, -1)"><AppIcon Name="chevron-up" /></button>
                                            <button class="icon-action" type="button" title="Move down" aria-label="Move down" @onclick="() => MoveQueuedMessageAsync(item.Id, 1)"><AppIcon Name="chevron-down" /></button>
                                        }
                                        <button class="icon-action" type="button" title="Edit queued message" aria-label="Edit queued message" @onclick="() => BeginQueueEdit(item)"><AppIcon Name="edit" /></button>
                                        <button class="icon-action destructive-action" type="button" title="Remove queued message" aria-label="Remove queued message" @onclick="() => RemoveQueuedMessageAsync(item.Id)"><AppIcon Name="trash" /></button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>
        }
        @if (GetSelectedRun() is { PendingApproval: { } dockedApproval } dockedApprovalRun)
        {
            <ToolApprovalBar @ref="_toolApprovalBar" @key="dockedApproval.Id" Run="dockedApprovalRun" Approval="dockedApproval" ChatTitle="@_selectedChat?.Title" />
        }
        </div>
        <div class="composer-prelude">
            @if (_navigationCue is { } cue)
            {
                @* A move the assistant asked for. It is announced before it happens, and can be refused. *@
                <div @key="cue.Id" class="navigation-cue chat-card-header @(cue.Automatic ? "is-counting" : "is-offer")" role="status" aria-live="polite">
                    <span class="chat-card-mark" aria-hidden="true"><AppIcon Name="@(cue.Automatic ? "chevron-right" : "info")" /></span>
                    <span class="navigation-cue-text chat-card-title">@(cue.Automatic ? $"The assistant is opening {cue.Where} in {cue.SecondsLeft} s" : $"The assistant created {cue.Where}")</span>
                    <span class="chat-card-header-actions">
                        @if (cue.Automatic)
                        {
                            <button class="chat-card-action" type="button" @onclick="StayOnNavigationCue">Stay here</button>
                            <button class="chat-card-action chat-card-action-primary" type="button" @onclick="() => FollowNavigationCueAsync(cue)">Open now</button>
                        }
                        else
                        {
                            <button class="chat-card-action chat-card-action-primary" type="button" @onclick="() => FollowNavigationCueAsync(cue)">Open</button>
                            <button class="chat-card-action" type="button" @onclick="StayOnNavigationCue">Not now</button>
                        }
                    </span>
                </div>
            }
            else if (_navigationArrival is { } arrival)
            {
                <div @key="arrival.Id" class="navigation-cue chat-card-header is-arrival" role="status" aria-live="polite">
                    <span class="chat-card-mark" aria-hidden="true"><AppIcon Name="info" /></span>
                    <span class="navigation-cue-text chat-card-title">The assistant opened @arrival.Where. You were in @arrival.From.</span>
                    <span class="chat-card-header-actions">
                        <button class="chat-card-action" type="button" @onclick="ReturnFromNavigationAsync">Go back</button>
                        <button class="chat-card-action chat-card-action-icon" type="button" title="Dismiss" aria-label="Dismiss" @onclick="() => _navigationArrival = null"><AppIcon Name="x" /></button>
                    </span>
                </div>
            }        <div class="composer-status" role="status">
            @* While the composer shows a history entry the counter comes first and the plain
               hint is dropped — the hint describes what Enter does with text the user wrote,
               and that is no longer the interesting thing on screen. A fork/replace/generating
               chip still wins the line; the counter just prefixes it. *@
            @if (_composerHistoryNavigator.Index is { } historyIndex) { <span class="composer-history-counter" title="Position in your sent-message history; ↑ on the first line goes back, ↓ on the last line goes forward, Esc restores your draft">History @(historyIndex + 1)/@GetComposerHistory().Count</span> }
            @* Held states carry no status word: the turn chip above already names the state and,
               for a failure, its reason. This line says only what the Enter key will do. *@
            @if (_isSendingNowFromComposer || _sendingQueuedNowId is not null) { <span class="queue-transition-status"><AppIcon Name="spinner" Class="tool-row-spinner" />Interrupting and sending…</span> }
            else if (_isClearingEverything) { <span class="queue-transition-status"><AppIcon Name="spinner" Class="tool-row-spinner" />Stopping and clearing…</span> }
            else if (GetSelectedRun()?.Status == ChatRunStatus.Generating && _chat.Message.Length > 0) { <span>@GetComposerHint()</span> }
            else if (GetSelectedRun()?.Status == ChatRunStatus.Generating && GetGeneratingStatusText() is { Length: > 0 } generatingStatus) { <span class="composer-generating-status">@generatingStatus</span> }
            else if (GetSelectedRun() is { Status: ChatRunStatus.Paused or ChatRunStatus.Interrupted } heldRun) { <span>@GetHeldRunEnterHint(heldRun)</span> }
            else if (GetSelectedRun() is { Status: ChatRunStatus.Failed } failedRun) { <span class="error">@GetHeldRunEnterHint(failedRun)</span> }
            else if (GetReplaceSource() is { } replaceSource) { <span class="fork-mode replace-mode"><AppIcon Name="edit-replace" /><span>Replacing branch from “@GetMessagePreview(replaceSource.Content)”</span><button class="icon-action" type="button" title="Cancel replacement" aria-label="Cancel replacement" @onclick="CancelBranchOperation"><AppIcon Name="x" /></button></span> }
            else if (_isForking) { <span class="fork-mode"><AppIcon Name="fork" /><span>@GetForkModeText()</span><button class="icon-action" type="button" title="Cancel fork" aria-label="Cancel fork" @onclick="CancelBranchOperation"><AppIcon Name="x" /></button></span> }
            else if (!_composerHistoryNavigator.IsActive) { <span>@GetComposerHint()</span> }
        </div>
        </div>
        <footer class="workspace-composer">
            @if (GetPendingResourceAccess() is { } access)
            {
                <div class="composer-access" role="status" @key="access">
                    <span class="composer-access-badge"><AppIcon Name="lock" /></span>
                    <div class="composer-access-text">
                        <strong>@ResourceDisplayName(access.Path) is outside this project</strong>
                        @if (access.Folder is { } folder)
                        {
                            <span>To add it, let the project read <code class="composer-access-path" title="@folder">@folder</code> and its subfolders.</span>
                        }
                        else
                        {
                            <span>It lies at the root of a drive, and a whole drive is never shared. Add one of its folders under Directories instead.</span>
                        }
                    </div>
                    <div class="composer-access-actions">
                        @if (access.Folder is not null)
                        {
                            <button type="button" class="composer-access-allow" disabled="@_isGrantingResourceAccess" @onclick="AllowResourceAccessAsync">
                                @if (_isGrantingResourceAccess) { <AppIcon Name="spinner" Class="tool-row-spinner" /> } else { <AppIcon Name="folder-plus" /> }
                                Allow and add
                            </button>
                        }
                        <button type="button" class="icon-action composer-access-dismiss" title="Not now" aria-label="Dismiss" @onclick="DismissResourceAccess"><AppIcon Name="x" /></button>
                    </div>
                </div>
            }
            @if (_draftResources.Any(item => item.Mention is null))
            {
                <div class="composer-resource-list" aria-label="Attached resources">
                    @foreach (var skill in _draftResources.Where(item => item.Kind == ChatResourceKind.Skill))
                    {
                        <span class="resource-pill" @key="skill.Id" title="@SkillChipTitle(skill)">
                            <span class="resource-pill-target mention-skill"><span class="resource-pill-label">@(skill.Name ?? skill.Path)</span></span>
                            <button class="resource-pill-remove" type="button" aria-label="Remove skill @(skill.Name ?? skill.Path)" title="Remove skill" @onclick="() => RemoveDraftResource(skill.Id)"><AppIcon Name="x" /></button>
                        </span>
                    }
                    @foreach (var resource in _draftResources.Where(item => item.Kind != ChatResourceKind.Skill && item.Mention is null))
                    {
                        @* The pill the reference keeps in the sent message and an "@" link has in the text. *@
                        <span class="resource-pill" @key="resource.Id" title="@DraftChipTitle(resource)">
                            @if (resource.Kind == ChatResourceKind.Image && _selectedProject is not null)
                            {
                                <button class="resource-pill-target mention-image chat-image-link" type="button"
                                        title="@DraftChipTitle(resource)" aria-label="@DraftChipTitle(resource)"
                                        @onclick="() => OpenAssetPreviewAsync(resource)">
                                    <ChatImageThumbnail ProjectId="_selectedProject.Id" Resource="resource" />
                                </button>
                            }
                            else if (resource.Kind == ChatResourceKind.File && resource.AssetId is not null)
                            {
                                <button class="resource-pill-target mention-file" type="button"
                                        title="@DraftChipTitle(resource)" @onclick="() => OpenAssetPreviewAsync(resource)">
                                    <span class="resource-pill-label">@DraftChipLabel(resource)</span>
                                </button>
                            }
                            else
                            {
                                <span class="resource-pill-target mention-@resource.Kind.ToString().ToLowerInvariant() @(resource.IncludeContent ? "has-content" : null)"><span class="resource-pill-label">@DraftChipLabel(resource)</span></span>
                            }
                            @if (CanSendContent(resource))
                            {
                                <button class="resource-pill-content" type="button" aria-pressed="@(resource.IncludeContent ? "true" : "false")"
                                        aria-label="Send the content of @DraftChipLabel(resource)"
                                        title="@(resource.IncludeContent ? "Sends its content as it is when you send · click to send only the path" : "Sends only the path · click to send its content as well")"
                                        @onclick="() => SetDraftIncludeContent(resource.Id, !resource.IncludeContent)"><AppIcon Name="file-text" /></button>
                            }
                            <button class="resource-pill-remove" type="button" aria-label="Remove @DraftChipTitle(resource)" title="Remove reference" @onclick="() => RemoveDraftResource(resource.Id)"><AppIcon Name="x" /></button>
                        </span>
                    }
                </div>
            }
            @if (IsSkillListOpen())
            {
                <SkillCommandMenu Matches="_skillMatches" SelectedIndex="_skillSuggestionIndex" OnPick="PickSkillSuggestionAsync" OnHover="HoverSkillSuggestion" />
            }
            else if (IsMentionListOpen())
            {
                <ResourceMentionMenu Items="_mentionItems" SelectedIndex="_mentionIndex" OnPick="PickMentionSuggestionAsync" OnPickContent="PickMentionContentAsync" OnHover="HoverMentionSuggestion" />
            }
            @* chatComposer.js draws the draft's "@" links as pills under the text; nothing here renders into it. *@
            <div @attributes="@(ControlHints.Attributes("chat.composer"))" class="composer-input">
                <div class="composer-mention-highlight" aria-hidden="true" hidden></div>
                @if (GetMentionBubbleResource() is { } bubbled)
                {
                    @* Placed over the link by chatComposer.js; pressed on mousedown so the caret stays in the text. *@
                    <div class="composer-mention-bubble" role="group" aria-label="How @ResourceDisplayName(bubbled.Path) is sent">
                        <span class="composer-mention-bubble-modes">
                            <button type="button" aria-pressed="@(bubbled.IncludeContent ? "false" : "true")" title="Send the path; the model reads the file when it needs it"
                                    @onmousedown="() => SetDraftIncludeContent(bubbled.Id, false)" @onmousedown:preventDefault><AppIcon Name="link" />Path</button>
                            <button type="button" aria-pressed="@(bubbled.IncludeContent ? "true" : "false")" title="Send the file's content as it is when you send the message"
                                    @onmousedown="() => SetDraftIncludeContent(bubbled.Id, true)" @onmousedown:preventDefault><AppIcon Name="file-text" />Content</button>
                        </span>
                        <span class="composer-mention-bubble-hint">@(bubbled.IncludeContent ? "Sent as it is when you send" : "Read by the model when needed")</span>
                    </div>
                }
                <div class="composer-suggestion" hidden><span class="composer-suggestion-text"></span><button class="composer-suggestion-accept" type="button" tabindex="-1" title="Use this reply (Tab) · Esc hides it">Tab</button></div>
                <textarea @ref="_composer" value="@_chat.Message" @oninput="OnComposerInput" @onkeydown="HandleComposerKeyDown" placeholder="@GetComposerPlaceholder()" aria-label="Message"
                          aria-controls="@(IsSkillListOpen() ? "skill-command-menu" : IsMentionListOpen() ? "resource-mention-menu" : null)"
                          aria-activedescendant="@(IsSkillListOpen() ? $"skill-command-{_skillSuggestionIndex}" : IsMentionListOpen() ? $"resource-mention-{_mentionIndex}" : null)"></textarea>
            </div>
            <div class="composer-footer">
                <InputFile id="composer-file-picker" class="composer-file-picker-input" OnChange="OnFilesSelectedAsync" multiple="multiple" />
                <div class="composer-resource-menu-anchor">
                    <button @attributes="@(ControlHints.Attributes("chat.context", "Add to chat"))" class="icon-action composer-add-resource" type="button" aria-label="Add to chat" aria-expanded="@_isResourceMenuOpen" @onclick="ToggleResourceMenu"><AppIcon Name="plus" /></button>
                    @if (_isResourceMenuOpen)
                    {
                        <div class="composer-resource-menu-backdrop" @onclick="CloseResourceMenu"></div>
                        <div class="composer-resource-menu" role="menu" aria-label="Add to chat">
                            <span class="composer-resource-menu-label">Add</span>
                            <button type="button" role="menuitem" @onclick="OpenFilePickerAsync"><AppIcon Name="file" /> File</button>
                            <button type="button" role="menuitem" @onclick="() => OpenResourcePicker(DirectoryPickerMode.File)"><AppIcon Name="link" /> File path</button>
                            <button type="button" role="menuitem" @onclick="() => OpenResourcePicker(DirectoryPickerMode.Directory)"><AppIcon Name="folder" /> Directory path</button>
                            @if (_selectedChat is not null)
                            {
                                <button type="button" role="menuitem" aria-expanded="@_isReviewSubmenuOpen" @onclick="ToggleReviewSubmenuAsync"><AppIcon Name="diff" /> Review <AppIcon Name="chevron-right" /></button>
                                @if (_isReviewSubmenuOpen)
                                {
                                    <div class="composer-review-submenu" role="group" aria-label="Reviews">
                                        @foreach (var review in ReviewsForComposer())
                                        {
                                            <button type="button" role="menuitem" @onclick="() => AttachExistingReviewAsync(review)"><AppIcon Name="diff" /><span>@review.Name</span></button>
                                        }
                                        @if (!_reviews.Any(item => item.Kind == ChatReviewKind.Diff)) { <span class="composer-resource-menu-label">No reviews yet</span> }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
                <TextCorrectionToggle State="@_textCorrection" OnToggle="ToggleTextCorrectionAsync" />
                <ApprovalModePicker Mode="@GetApprovalMode()" ModeChanged="SetApprovalModeAsync" Disabled="@(_selectedProject is null)" />
                <div class="composer-endpoint">
                    <button class="composer-endpoint-trigger" type="button" title="Endpoint for this chat" aria-label="Endpoint for this chat" aria-haspopup="true" aria-expanded="@(_isEndpointMenuOpen ? "true" : "false")" @onclick="ToggleEndpointMenu" disabled="@(_connections.Count == 0)">
                        <span>@GetEndpointDisplayName()</span>
                        <AppIcon Name="chevron-down" />
                    </button>
                    @if (_isEndpointMenuOpen)
                    {
                        <div class="context-menu-backdrop" @onclick="CloseEndpointMenu"></div>
                        <span class="composer-endpoint-menu" role="menu">
                            @foreach (var connection in _connections.Where(item => item.Enabled))
                            {
                                var isSelected = connection.Id == _chat.CredentialProfileId;
                                <span class="composer-endpoint-row @(isSelected ? "selected" : string.Empty)">
                                    <button type="button" role="menuitem" class="composer-endpoint-select" @onclick="() => SelectChatEndpointAsync(connection.Id)">
                                        @if (isSelected) { <AppIcon Name="check" /> } else { <span class="branch-option-spacer"></span> }
                                        <span>@connection.Name</span>
                                        @if (connection.IsDefault) { <span class="composer-endpoint-default">Default</span> }
                                    </button>
                                    <button type="button" role="menuitem" class="icon-action composer-endpoint-edit" title="Edit connection" aria-label="@($"Edit connection {connection.Name}")" @onclick="() => EditChatConnectionAsync(connection.Id)"><AppIcon Name="edit" /></button>
                                </span>
                            }
                        </span>
                    }
                </div>
                @if (GetSelectedRun()?.Status == ChatRunStatus.Generating) { <button type="button" class="stop-button" title="Stop generation" aria-label="Stop generation" @onclick="StopGenerationAsync"><AppIcon Name="stop" /></button> }
                <ComposerSendButton ActiveMode="@GetComposerSendMode()" CanAside="@(_selectedChat is not null && !_isForking && _replaceSourceId is null)" TurnInFlight="@IsTurnInFlight()" Disabled="@(!CanSendMessage())" Busy="@_isSubmittingMessage" OnClick="SubmitFromSendButtonAsync" Context="@GetComposerContext()" />
            </div>
            @if (!string.IsNullOrEmpty(_chatError)) { <p class="error" role="alert">@_chatError</p> }
        </footer>
    </section>

    @if (_selectedProject is not null)
    {
        <div class="workspace-resizer" data-side="right" role="separator" tabindex="0" aria-orientation="vertical"
             aria-label="Resize chat widgets" aria-controls="chat-widgets" aria-valuemin="0"
             title="Drag to resize, drag to the edge to hide · Double-click to hide or show"></div>
    }
    @* Phone width only: the shade behind an open drawer, which closes it when tapped. *@
    <div class="workspace-phone-scrim" aria-hidden="true"></div>
    @if (IsChatWidgetsVisible())
    {
        // A new chat has no stored chat yet: its widgets show their empty state until the first message.
        var widgetChat = _selectedChat;
        var widgetRun = GetSelectedRun();
        var widgetUsage = widgetChat is null ? null : ChatUsage.Find(widgetChat.Id);
        var widgetMessages = widgetChat is null ? [] : GetWidgetMessages(widgetChat);
        <ChatWidgetRail Widgets="@_chatWidgets" GuideExpandedWidgetId="@_guideExpandedWidgetId" GuideExpansionDismissed="() => _guideExpandedWidgetId = null" WidgetsChanged="SaveChatWidgetsAsync" OnClose="ToggleChatWidgetsAsync">
            <WidgetTemplate Context="widget">
                @switch (widget.Definition.Id)
                {
                    case ChatWidgetCatalog.AppGuide:
                        <AppGuideWidget Widget="@widget" Completed="@_completedGuideTopics" Running="@GuideRunning"
                                        Paused="@_guidePaused" StepNumber="@_guideStepNumber" Note="@_guideNote"
                                        TopicTitle="@(_guideTopic is { } guideTopic ? GuideTopics.Find(guideTopic)?.Title : null)"
                                        OnStart="StartGuideTopicAsync" OnPause="ToggleGuidePauseAsync" OnStop="StopGuideStepAsync" />
                        break;
                    case ChatWidgetCatalog.ChatContext:
                        <ChatContextWidget Widget="@widget"
                                           Context="@GetComposerContext()" />
                        break;
                    case ChatWidgetCatalog.ChatUsage:
                        <ChatUsageWidget Widget="@widget"
                                         Context="@GetComposerContext()"
                                         ChatUsage="@widgetUsage"
                                         LiveTurn="@widgetRun?.TurnUsage"
                                         IsGenerating="@(widgetRun?.Status == ChatRunStatus.Generating)"
                                         ConnectionName="@GetComposerConnection()?.Name"
                                         OnNewChat="CreateChatAsync"
                                         OnOpenConnections='() => OpenGlobalSection("Connections")'
                                         ActiveCheckpoint="@GetActiveCheckpoint()"
                                         Compacting="@_compactingHistory"
                                         CompactionNote="@(widgetChat is not null && _compactionNoteChatId == widgetChat.Id ? _compactionNote : null)"
                                         OnCompact="CompactHistoryAsync"
                                         OnUndoCheckpoint="UndoCheckpointAsync" />
                        break;
                    case ChatWidgetCatalog.ChatFiles:
                        <ChatFilesWidget Widget="@widget"
                                         Messages="@widgetMessages"
                                         LiveChanges="@(widgetRun is { Status: not ChatRunStatus.Completed } ? widgetRun.WorkspaceChanges : null)"
                                         OnReview="OpenReviewForFileAsync" />
                        break;
                    case ChatWidgetCatalog.ChatTools:
                        <ChatToolsWidget Widget="@widget"
                                         Messages="@widgetMessages"
                                         Run="@widgetRun" />
                        break;
                    case ChatWidgetCatalog.ChatPerformance:
                        <ChatPerformanceWidget Widget="@widget"
                                              ChatUsage="@widgetUsage"
                                              LiveTurn="@widgetRun?.TurnUsage"
                                              Messages="@widgetMessages"
                                              IsGenerating="@(widgetRun?.Status == ChatRunStatus.Generating)" />
                        break;
                    case ChatWidgetCatalog.ChatSubtasks:
                        <ChatSubtasksWidget Widget="@widget"
                                            ChatUsage="@widgetUsage"
                                            LiveTurn="@widgetRun?.TurnUsage"
                                            Messages="@widgetMessages"
                                            IsGenerating="@(widgetRun?.Status == ChatRunStatus.Generating)" />
                        break;
                    case ChatWidgetCatalog.ChatKnowledge:
                        <ChatKnowledgeWidget Widget="@widget"
                                             Messages="@widgetMessages"
                                             Run="@widgetRun" />
                        break;
                    case ChatWidgetCatalog.ChatTimeline:
                        <ChatTimelineWidget Widget="@widget"
                                            Messages="@widgetMessages"
                                            ChatUsage="@widgetUsage"
                                            LiveTurn="@widgetRun?.TurnUsage"
                                            IsGenerating="@(widgetRun?.Status == ChatRunStatus.Generating)"
                                            OnSelectTurn="ScrollToTurnAsync" />
                        break;
                    case ChatWidgetCatalog.ChatBranches:
                        <ChatBranchesWidget Widget="@widget"
                                            Branches="@widgetChat?.Branches"
                                            Messages="@(widgetChat?.Messages ?? [])"
                                            SelectedBranchId="@GetSelectedBranchId()"
                                            OnSelectBranch="OnWidgetBranchSelectedAsync" />
                        break;
                    case ChatWidgetCatalog.ChatReferences:
                        <ChatReferencesWidget Widget="@widget"
                                              Messages="@widgetMessages"
                                              IsGenerating="@(widgetRun?.Status == ChatRunStatus.Generating)"
                                              OnSelectMessage="ScrollToTurnAsync" />
                        break;
                    case ChatWidgetCatalog.ChatModels:
                        <ChatModelsWidget Widget="@widget"
                                          ChatUsage="@widgetUsage"
                                          LiveTurn="@widgetRun?.TurnUsage"
                                          Messages="@widgetMessages"
                                          IsGenerating="@(widgetRun?.Status == ChatRunStatus.Generating)" />
                        break;
                }
            </WidgetTemplate>
        </ChatWidgetRail>
    }

    @if (_showArchive && _selectedProject is { } archiveProject)
{
    <ChatArchiveDrawer @ref="_archiveDrawer" @key="archiveProject.Id" ProjectId="@archiveProject.Id" ProjectName="@archiveProject.Name"
        Chats="@_chats" StartWithCleanup="@_archiveCleanup" Close="CloseArchive"
        Open="OpenArchivedChatAsync" Changed="ArchiveChangedAsync" SuggestionsChanged="RefreshArchiveSuggestionsAsync" />
}

@if (_isProjectMenuOpen && _selectedProject is not null)
    {
        <div class="context-menu-backdrop" @onclick="CloseContextMenus" @oncontextmenu="OnBackdropContextMenu" @oncontextmenu:preventDefault="true"></div>
        <div class="project-menu" role="menu" style="@GetProjectMenuStyle()" @onclick:stopPropagation="true">
            <button type="button" role="menuitem" @onclick="OpenProjectSettings"><AppIcon Name="sliders" />Project settings</button>
            <button type="button" role="menuitem" @onclick='() => OpenGlobalSection("ProjectMemory")'>
                <AppIcon Name="memory" />
                <span>Memory</span>
                @if (_projectMemoryCount > 0)
                {
                    <span class="menu-count">@_projectMemoryCount</span>
                }
            </button>
            <button type="button" role="menuitem" @onclick='() => OpenGlobalSection("ProjectSkills")'>
                <AppIcon Name="skill" />
                <span>Skills</span>
                @if (_projectSkillCount > 0)
                {
                    <span class="menu-count">@_projectSkillCount</span>
                }
            </button>
            <button type="button" role="menuitem" @onclick="OpenProjectPermissions">
                <AppIcon Name="tool" />
                <span>Tool permissions</span>
                @if (_security.ToolPolicies.Count > 0)
                {
                    <span class="menu-count">@_security.ToolPolicies.Count</span>
                }
            </button>
            <button type="button" role="menuitem" @onclick="() => OpenArchive(true)"><AppIcon Name="archive" />Archive old chats…</button>
            @if (_isConfirmingProjectDelete)
            {
                <div class="project-menu-confirm"><span>Are you sure?</span><button class="danger compact-action" type="button" @onclick="DeleteProjectAsync">Delete</button><button class="confirm-cancel" type="button" title="Cancel" aria-label="Cancel" @onclick="CancelProjectDelete"><AppIcon Name="x" /></button></div>
            }
            else
            {
                <button class="menu-danger" type="button" role="menuitem" @onclick="ConfirmProjectDelete"><AppIcon Name="trash" />Delete project</button>
            }
        </div>
    }

    @if (_chatMenuId is not null)
    {
        <div class="context-menu-backdrop" @onclick="CloseContextMenus" @oncontextmenu="OnBackdropContextMenu" @oncontextmenu:preventDefault="true"></div>
    }

    @if (_directoryMenuId is not null)
    {
        <div class="context-menu-backdrop" @onclick="CloseContextMenus" @oncontextmenu="OnBackdropContextMenu" @oncontextmenu:preventDefault="true"></div>
    }

    @if (_fileLinkMenu is { } fileLink)
    {
        <div class="context-menu-backdrop" @onclick="CloseFileLinkMenu" @oncontextmenu="OnFileLinkBackdropContextMenu" @oncontextmenu:preventDefault="true"></div>
        <div class="chat-menu file-link-menu" role="menu" aria-label="Link menu"
             style="left: min(@(fileLink.ClientX.ToString(System.Globalization.CultureInfo.InvariantCulture))px, calc(100vw - 15rem)); top: min(@(fileLink.ClientY.ToString(System.Globalization.CultureInfo.InvariantCulture))px, calc(100vh - 7rem));"
             @onclick:stopPropagation="true">
            <div class="file-link-menu-path" title="@fileLink.Path">@ResourceDisplayName(fileLink.Path)</div>
            @if (fileLink.Readable == false)
            {
                <button type="button" role="menuitem" disabled="@(_selectedProject is null)" title="@($"Let the assistant's tools read {FileLinkGrantPath(fileLink)}")" @onclick="GrantFileLinkAccessAsync"><AppIcon Name="folder-plus" />Allow project access</button>
            }
            else
            {
                <button type="button" role="menuitem" disabled="@(_selectedProject is null)" @onclick="AddFileLinkToMessageAsync"><AppIcon Name="plus" />Add to message</button>
            }
            <button type="button" role="menuitem" @onclick="CopyFileLinkPathAsync"><AppIcon Name="copy" />Copy path</button>
        </div>
    }

    @if (_isProjectSettingsOpen && _selectedProject is not null)
    {
        <div class="permissions-drawer-backdrop"></div>
        <aside @attributes="@(ControlHints.Attributes("project.settings"))" class="permissions-drawer project-settings-drawer" aria-label="Project settings">
            <header>
                <div class="project-settings-heading"><h2>Project settings</h2><p title="@_selectedProject.Name">@_selectedProject.Name</p></div>
                <button class="icon-action" type="button" title="Close" aria-label="Close project settings" @onclick="RequestCloseProjectSettingsAsync"><AppIcon Name="drawer-close" /></button>
            </header>
            <div class="permissions-content project-settings-content">
                <EditForm Model="_editor" class="settings-form project-settings-form">
                    <DataAnnotationsValidator />
                    <div class="settings-card">
                        <label @attributes="@(ControlHints.Attributes("project.name"))" class="settings-row settings-field"><span class="settings-row-label">Name</span><InputText @bind-Value="_editor.Name" /></label>
                        <label class="settings-row settings-field">
                            <span class="settings-row-label">Connection</span>
                            <select @bind="_editor.ConnectionId"><option value="">— Default —</option>@foreach (var connection in _connections) { <option value="@connection.Id" disabled="@(!connection.Enabled)">@connection.Name@(!connection.Enabled ? " (Unavailable)" : string.Empty)</option> }</select>
                        </label>
                        <label @attributes="@(ControlHints.Attributes("project.description"))" class="settings-row is-stacked"><span class="settings-row-label">Description</span><InputTextArea @bind-Value="_editor.Description" rows="2" /></label>
                    </div>
                </EditForm>
                <div @attributes="@(ControlHints.Attributes("project.instructions"))"><ProjectInstructionsEditor @ref="_instructionsEditor" ProjectId="@_selectedProject.Id" /></div>
                @if (!string.IsNullOrEmpty(_error)) { <p class="error" role="alert">@_error</p> }
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <footer>
                    <span class="settings-drawer-error">Not saved.</span>
                    <button class="secondary-action permissions-reset-all" type="button" @onclick="CancelCurrentSettingsAsync">Discard changes</button>
                </footer>
            }
        </aside>
    }

    @if (_isSearchOpen)
    {
        @* No backdrop and no close on an outside press: the point of the panel is reading the chat
           beside it while stepping through what was found. *@
        <aside @attributes="@(ControlHints.Attributes("search"))" class="permissions-drawer search-drawer" id="search-drawer" aria-label="Search messages">
            <header>
                <h2>Search</h2>
                <button @attributes="@(ControlHints.Attributes("search.close", "Close (Esc)"))" class="icon-action" type="button" aria-label="Close search" @onclick="CloseSearchPanelAsync"><AppIcon Name="drawer-close" /></button>
            </header>
            <div class="search-drawer-controls">
                @* A combobox in the ARIA sense: focus stays in the box while Up/Down move the active
                   result, so the query can still be edited between steps. *@
                <input @attributes="@(ControlHints.Attributes("search.query"))" type="search" class="search-drawer-input" @ref="_searchInput" value="@_searchQuery" @oninput="OnSearchInput" @onkeydown="OnSearchKeyDown"
                       placeholder="Search messages in all chats" aria-label="Search messages in all chats" aria-keyshortcuts="Control+K"
                       role="combobox" aria-autocomplete="list" aria-controls="search-results"
                       aria-expanded="@(_searchGroups.Count > 0 ? "true" : "false")"
                       aria-activedescendant="@(_searchActiveMessageId is { } activeRow ? SearchRowId(activeRow) : null)" />
                <div class="search-drawer-options">
                    <label @attributes="@(ControlHints.Attributes("search.archived"))" class="archive-search-toggle"><input type="checkbox" @bind="_searchIncludeArchived" @bind:after="RunSearchAsync" /> Include archived chats</label>
                    @* Steps through the occurrences in the open chat. It counts only what is rendered:
                       a match inside a collapsed turn shows up once that turn is opened. *@
                    @if (_selectedChat is not null && _searchQuery.Trim().Length >= 2)
                    {
                        <div class="find-bar" role="group" aria-label="Occurrences in this chat">
                            <span class="find-bar-count" aria-live="polite">@(_feedSearchCount == 0
                                ? "None in this chat"
                                : _feedSearchIndex < 0 ? $"{_feedSearchCount} in this chat" : $"{_feedSearchIndex + 1} / {_feedSearchCount}")</span>
                            <button class="icon-action" type="button" title="Previous in this chat (Shift+F3)" aria-label="Previous occurrence in this chat" aria-keyshortcuts="Shift+F3" disabled="@(_feedSearchCount == 0)" @onclick="() => StepFeedSearchAsync(-1)"><AppIcon Name="chevron-up" /></button>
                            <button class="icon-action" type="button" title="Next in this chat (F3)" aria-label="Next occurrence in this chat" aria-keyshortcuts="F3" disabled="@(_feedSearchCount == 0)" @onclick="() => StepFeedSearchAsync(1)"><AppIcon Name="chevron-down" /></button>
                        </div>
                    }
                </div>
                @* One line that always says what the panel is doing: waiting for more input,
                   searching, or what the last search found. Text, not motion alone, so it reads the
                   same with animations switched off. *@
                <p class="search-drawer-status @(SearchBusy.IsVisible ? "busy" : string.Empty)" role="status" aria-live="polite">
                    @if (_searchQuery.Trim().Length == 1)
                    {
                        <span>Type one more character</span>
                    }
                    else if (SearchBusy.IsVisible)
                    {
                        <AppIcon Name="spinner" Class="archive-spinner" /><span>Searching all chats…</span>
                    }
                    else if (_searchResult is { Error: { Length: > 0 } searchError })
                    {
                        <AppIcon Name="error" /><span>@searchError</span>
                    }
                    else if (_searchResult is { } summary)
                    {
                        <span>@SearchSummary(summary)</span>
                    }
                </p>
            </div>
            @if (_searchResult is { } found)
            {
                @* Results of the previous query stay while the next one runs, dimmed once the wait
                   is long enough to notice, instead of blinking out on every keystroke. *@
                <div @attributes="@(ControlHints.Attributes("search.results"))" class="search-drawer-results @(_isSearching && SearchBusy.IsVisible ? "stale" : string.Empty)" id="search-results" role="listbox" aria-label="Search results" aria-busy="@(_isSearching ? "true" : "false")">
                    @* A failure is reported by the status line alone. *@
                    @if (found.Matches.Count == 0 && found.Error is not { Length: > 0 })
                    {
                        <p class="empty-hint search-drawer-hint">No messages contain “@_searchResultQuery”.@(_searchIncludeArchived ? string.Empty : " Archived chats were not searched.")</p>
                    }
                    else if (found.Matches.Count > 0)
                    {
                        @foreach (var group in _searchGroups)
                        {
                            var expanded = _expandedSearchGroups.Contains(group.ChatId);
                            var shown = expanded ? group.Matches : group.Matches.Take(SearchGroupPreviewCount);
                            var hidden = group.Matches.Count - SearchGroupPreviewCount;
                            <section @key="group.ChatId" class="search-group @(group.ChatId == _selectedChat?.Id ? "current" : string.Empty)" role="group" aria-label="@group.ChatTitle">
                                @* The header opens the chat at its newest match; it is a pointer shortcut,
                                   the keyboard reaches the same place through the first row. *@
                                <button class="search-group-header" type="button" tabindex="-1" title="Open at the newest match" @onclick="() => OpenSearchMatchAsync(group.Matches[0])">
                                    <span class="search-group-title">@group.ChatTitle</span>
                                    <span class="search-group-count" title="@group.Occurrences occurrence(s)">@group.Occurrences</span>
                                </button>
                                <span class="search-group-where">@group.ProjectName@(group.IsArchived ? " · Archived" : string.Empty)</span>
                                @foreach (var match in shown)
                                {
                                    var active = match.MessageId == _searchActiveMessageId;
                                    <button id="@SearchRowId(match.MessageId)" @key="match.MessageId" class="search-result @(active ? "active" : string.Empty)" type="button" tabindex="-1"
                                            role="option" aria-selected="@(active ? "true" : "false")" @onclick="() => OpenSearchMatchAsync(match)">
                                        <span class="search-result-snippet">@foreach (var part in SearchResults.Highlight(match.Snippet, _searchResultQuery))
                                        {
                                            if (part.IsMatch) { <mark>@part.Text</mark> } else { @part.Text }
                                        }</span>
                                        <span class="search-result-meta">@match.Role · @match.CreatedAt.LocalDateTime.ToString("g")@(match.MatchCount > 1 ? $" · {match.MatchCount} matches" : string.Empty)</span>
                                    </button>
                                }
                                @if (hidden > 0)
                                {
                                    <button class="search-group-more" type="button" tabindex="-1" aria-expanded="@(expanded ? "true" : "false")" @onclick="() => ToggleSearchGroup(group.ChatId)">@(expanded ? "Show fewer" : $"Show {hidden} more")</button>
                                }
                            </section>
                        }
                    }
                </div>
            }
            else if (!_isSearching)
            {
                <p class="empty-hint search-drawer-hint">Searches the messages of every chat. Up/Down pick a result, Enter opens it, F3 steps through the open chat.</p>
            }
        </aside>
    }

    @if (_isDirectoryPickerOpen && _selectedProject is not null)
    {
        <DirectoryPickerDialog StartPath="@_directoryPickerStartPath"
                               Subtitle="@(_directoryPickerGrantId is null ? "New directory grant" : "Change directory grant")"
                               Selected="OnDirectoryPickedAsync" Cancelled="CloseDirectoryPicker" />
    }
    @if (_resourcePickerMode is { } resourceMode && _selectedProject is not null)
    {
        <DirectoryPickerDialog @key="resourceMode" Mode="resourceMode"
                               StartPath="@ResourcePickerStartPath()"
                               Subtitle="Add a workspace reference to the chat"
                               Selected="OnResourcePickedAsync" Cancelled="CloseResourcePicker" />
    }
    @if (_reviewWorkspaceOpen && _selectedProject is not null && _selectedChat is not null)
    {
        <ReviewWorkspace @key="_reviewPanelKey" ProjectId="@_selectedProject.Id" Chat="@(_reviewChat ?? _selectedChat)"
                         Reviews="@_reviews" StartReviewId="@_reviewStartId" StartPath="@_reviewStartPath"
                         OnChanged="OnReviewChangedAsync" OnDelete="@(id => DeleteReviewAsync(_selectedChat.Id, id))" OnClose="CloseReviewAsync" />
    }
    @if ((_previewPath is not null || _previewAsset is not null) && _selectedProject?.Id == _previewProjectId)
    {
        <FilePreviewPanel @key="_previewVersion" ProjectId="@_previewProjectId" Path="@(_previewPath ?? string.Empty)" AssetResource="@_previewAsset"
                          StartLine="@_previewStartLine" EndLine="@_previewEndLine"
                          OnClose="CloseFilePreview" OnOpenPath="OpenFilePreviewAsync" OnAttach="AttachPreviewAsync"
                          OnAttachAsset="AttachPreviewAsset" />
    }
</main>

@if (_guideStep is { } guideStep)
{
    <AppGuideStep @key="_guideStepNumber" Step="@guideStep" StepNumber="@_guideStepNumber" TotalSeconds="@_guideStepSeconds"
                  Title="@((_guideChatId is not null || _bootstrapStep > 0 ? GuideTopics.Find(_guideTopic ?? "basic")?.Title : null) ?? "Assistant navigation")"
                  TargetLabel="@(GuideTargets.Find(guideStep.Target ?? "project")?.Label ?? "this control")"
                  Busy="@_guideStepBusy" Paused="@_guidePaused" TargetUsed="@_guideTargetUsed"
                  SecondsLeft="@Math.Max(0, (int)Math.Ceiling((_guideStepDeadlineAt - DateTimeOffset.UtcNow).TotalSeconds))" AutoContinue="@_guideStepAutoContinue"
                  OnContinue="ContinueGuideStepAsync" OnStop="StopGuideStepAsync" OnNavigateApp="OpenAppNavigationLinkAsync" />
