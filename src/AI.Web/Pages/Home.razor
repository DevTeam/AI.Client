    private IReadOnlyList<ChatReview> ReviewsForBranch(BranchTreeItem branch)
    {
        if (_reviewChat is null || _selectedChat is null || _reviewChat.Id != _selectedChat.Id) return [];
        var visibleMessages = Feed.BuildBranch(_reviewChat.Messages, branch.LeafId)
            .Select(item => item.Id).ToHashSet();
        return _reviews.Where(item => item.Kind == ChatReviewKind.Diff && !IsEmptyReview(item)
            && visibleMessages.Contains(item.SourceMessageId))
            .OrderByDescending(item => item.UpdatedAt).ToArray();
    }

    private IReadOnlyList<ChatReview> ReviewsForComposer()
    {
        if (_selectedChat is null) return [];
        var lastAnswer = Feed.BuildBranch(_selectedChat.Messages, _branchLeafId)
            .LastOrDefault(item => item.Role == "Assistant" && item.ToolCalls is null && !item.IsIncomplete);
        var lastReviewSourceId = lastAnswer?.WorkspaceChanges is { IsEmpty: false } ? lastAnswer.Id : (Guid?)null;
        return _reviews.Where(item => item.Kind == ChatReviewKind.Diff && !IsEmptyReview(item))
            .OrderByDescending(item => item.SourceMessageId == lastReviewSourceId)
            .ThenByDescending(item => item.UpdatedAt).ToArray();
    }

