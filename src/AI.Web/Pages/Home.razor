    /// <summary>
    /// Connections and MCP open as a drawer over the chat, like tool permissions, so switching
    /// between them no longer tears down the conversation. A second section replaces the first
    /// only after the open one has saved itself.
    /// </summary>
    private async Task OpenGlobalSection(string section)
    {
        CloseContextMenus();
        if (_globalSection == section)
        {
            await RequestCloseGlobalSettingsAsync();
            return;
        }
        if (_globalSettingsPanel is not null && !await _globalSettingsPanel.SaveAsync()) return;
        if (!await CloseDrawersExceptAsync(Drawer.GlobalSettings)) return;
        _globalSection = section;
        await LoadMemoryCountAsync();
    }

