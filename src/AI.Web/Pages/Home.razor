    /// <summary>
    /// The reference behind an "@" link: what the "+" menu would add for the row, remembered with
    /// the link's text. A second link to the same thing takes the reference over.
    /// </summary>
    private async Task AttachMentionAsync(AI.Web.Resources.ResourceMentionItem item, bool includeContent)
    {
        if (item.Kind is ChatResourceKind.File or ChatResourceKind.Directory)
        {
            await AddDraftResourceAsync([item.Kind], item.Value, lines: item.Lines, mention: item.Token, includeContent: includeContent);
            return;
        }
        ChatResource reference;
        if (item.Kind == ChatResourceKind.Review)
        {
            if (_reviews.FirstOrDefault(review => review.Id.ToString() == item.Value) is not { } review || IsEmptyReview(review)) return;
            reference = new ChatResource(review.Id, ChatResourceKind.Review, string.Empty, review.Name, review.Kind, Mention: item.Token);
        }
        else reference = new ChatResource(Guid.NewGuid(), item.Kind, item.Value, item.Name, Mention: item.Token);
        var existing = _draftResources.FindIndex(resource => resource.Kind == item.Kind
            && (item.Kind == ChatResourceKind.Review ? resource.Id == reference.Id : resource.Path == item.Value));
        if (existing >= 0) _draftResources[existing] = _draftResources[existing] with { Mention = item.Token };
        else if (_draftResources.Count >= 20)
        {
            _chatError = "A message can reference at most 20 resources.";
            Notifications.ShowError(_chatError);
            return;
        }
        else _draftResources.Add(reference);
        _resourceDrafts[GetComposerDraftKey()] = _draftResources.ToArray();
    }

