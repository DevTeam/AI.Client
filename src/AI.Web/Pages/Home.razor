    private static WorkspaceTarget ParseWorkspaceTarget(string url)
    {
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var pair in new Uri(url).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2) values[Uri.UnescapeDataString(parts[0])] = Uri.UnescapeDataString(parts[1]);
        }
        Guid? ReadId(string key) => values.TryGetValue(key, out var value) && Guid.TryParse(value, out var id) ? id : null;
        return new WorkspaceTarget(ReadId("project"), ReadId("chat"), ReadId("branch"), ReadId("message"),
            values.TryGetValue("panel", out var panel) && panel == "notifications");
    }

    private string GetWorkspaceLocation()
    {
        var project = _selectedProject?.Name ?? "Projects";
        if (_selectedChat is null) return project;
        var branch = GetSelectedBranchItem();
        return branch is null ? $"{project} / {_selectedChat.Title}" : $"{project} / {_selectedChat.Title} / {branch.Title}";
    }

    private async Task NavigateToTargetAsync(WorkspaceTarget target)
    {
        if (target.ProjectId is { } projectId && _selectedProject?.Id != projectId)
        {
            var project = _projects.FirstOrDefault(item => item.Id == projectId);
            if (project is null)
            {
                Notifications.ShowError("The project in this link is unavailable.");
                return;
            }
            await SelectProjectAsync(project, restoreLastChat: false);
        }
        if (target.ChatId is { } chatId && _selectedProject is not null)
        {
            if (_chats.All(item => item.Id != chatId))
            {
                Notifications.ShowError("The chat in this link is unavailable.");
                return;
            }
            if (_selectedChat?.Id != chatId || (target.BranchId ?? chatId) == chatId && _selectedBranchId != chatId)
                await SelectChatAsync(chatId);
            if (target.BranchId is { } branchId && branchId != chatId && GetSelectedBranchId() != branchId
                && GetBranchTreeItems().FirstOrDefault(item => item.RootId == branchId) is { } branch)
                await SelectBranchTreeItemAsync(branch);
            else if (target.BranchId is { } missingBranchId && missingBranchId != chatId && GetSelectedBranchId() != missingBranchId)
                Notifications.ShowError("The branch in this link is unavailable.");
            _targetMessageId = target.MessageId;
        }
        else if (target.ChatId is null && _selectedChat is not null && _selectedProject is not null)
        {
            await SelectProjectAsync(_selectedProject, restoreLastChat: false);
        }
        _notificationsOpen = target.NotificationsOpen;
        if (_notificationsOpen) Notifications.MarkAllSeen();
    }

    private async Task SyncWorkspaceUrlAsync(bool replace = false, bool overrideMessage = false, Guid? messageId = null)
    {
        if (_navigationHandle is null || _suppressNavigationWrite) return;
        var current = ParseWorkspaceTarget(await _navigationHandle.InvokeAsync<string>("url"));
        var sameDestination = current.ProjectId == _selectedProject?.Id
            && current.ChatId == _selectedChat?.Id
            && (current.BranchId ?? current.ChatId) == (_selectedBranchId ?? _selectedChat?.Id);
        var urlMessageId = overrideMessage ? messageId : sameDestination ? current.MessageId : null;
        var buttons = await _navigationHandle.InvokeAsync<NavigationButtons>("set",
            _selectedProject?.Id.ToString(), _selectedChat?.Id.ToString(), _selectedBranchId?.ToString(),
            urlMessageId?.ToString(), _notificationsOpen ? "notifications" : null, replace);
        _canNavigateBack = buttons.CanBack;
        _canNavigateForward = buttons.CanForward;
    }

    [JSInvokable]
    public async Task OnWorkspaceHistoryChanged(string url, NavigationButtons buttons)
    {
        _canNavigateBack = buttons.CanBack;
        _canNavigateForward = buttons.CanForward;
        _notificationCenterHistoryEntry = false;
        _suppressNavigationWrite = true;
        try { await NavigateToTargetAsync(ParseWorkspaceTarget(url)); }
        finally { _suppressNavigationWrite = false; }
        await SyncWorkspaceUrlAsync(replace: true);
        await InvokeAsync(StateHasChanged);
    }

    private Task GoBackAsync() => _navigationHandle?.InvokeVoidAsync("back").AsTask() ?? Task.CompletedTask;
    private Task GoForwardAsync() => _navigationHandle?.InvokeVoidAsync("forward").AsTask() ?? Task.CompletedTask;

    private async Task ToggleNotificationsAsync()
    {
        _hideNotificationPreview = true;
        if (_notificationsOpen)
        {
            if (_notificationCenterHistoryEntry && _navigationHandle is not null)
            {
                _notificationCenterHistoryEntry = false;
                await GoBackAsync();
                return;
            }
            _notificationsOpen = false;
            await SyncWorkspaceUrlAsync(replace: true);
            return;
        }
        if (!await CloseDrawersExceptAsync(Drawer.Notifications)) return;
        _notificationsOpen = true;
        Notifications.Dismiss();
        Notifications.MarkAllSeen();
        _notificationCenterHistoryEntry = true;
        await SyncWorkspaceUrlAsync();
    }

    private enum Drawer { Notifications, Permissions, GlobalSettings, ProjectSettings, Review }

    /// <summary>
    /// All right-hand drawers share one slot, so opening one closes the rest instead of stacking
    /// them (the narrower notifications drawer used to cover half of Connections/MCP). Settings
    /// drawers save on close; false means one kept itself open because its save failed.
    /// </summary>
    private async Task<bool> CloseDrawersExceptAsync(Drawer keep)
    {
        if (keep != Drawer.Notifications && _notificationsOpen)
        {
            // Replace rather than go back: the drawer being opened is not a history entry either.
            _notificationsOpen = false;
            _notificationCenterHistoryEntry = false;
            await SyncWorkspaceUrlAsync(replace: true);
        }
        if (keep != Drawer.Permissions && _permissionsScope is not null) ClosePermissions();
        if (keep != Drawer.GlobalSettings && _globalSection is not null)
        {
            await RequestCloseGlobalSettingsAsync();
            if (_globalSection is not null) return false;
        }
        if (keep != Drawer.ProjectSettings && _isProjectSettingsOpen)
        {
            await RequestCloseProjectSettingsAsync();
            if (_isProjectSettingsOpen) return false;
        }
        if (keep != Drawer.Review && _reviewWorkspaceOpen) await CloseReviewAsync();
        return true;
    }

    private async Task OpenNotificationAsync(NotificationMessage item)
    {
        if (item.ProjectId is null || item.ChatId is null) return;
        _hideNotificationPreview = true;
        var wasCenterOpen = _notificationsOpen;
        Notifications.MarkSeen(item.Id);
        Notifications.Dismiss();
        _suppressNavigationWrite = true;
        try { await NavigateToTargetAsync(new WorkspaceTarget(item.ProjectId, item.ChatId, item.BranchId, item.MessageId, false)); }
        finally { _suppressNavigationWrite = false; }
        _notificationsOpen = false;
        _notificationCenterHistoryEntry = false;
        await SyncWorkspaceUrlAsync(replace: wasCenterOpen, overrideMessage: true, messageId: item.MessageId);
        await InvokeAsync(StateHasChanged);
    }

    private void OnNotificationOpenRequested(NotificationMessage item) => _ = InvokeAsync(() => OpenNotificationAsync(item));
    private void RestoreNotificationPreview() => _hideNotificationPreview = false;
    private void OnNotificationCenterRequested() => _ = InvokeAsync(async () =>
    {
        if (!_notificationsOpen) await ToggleNotificationsAsync();
        StateHasChanged();
    });
    private void OnNotificationsChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        Notifications.Changed += OnNotificationsChanged;
        Notifications.OpenRequested += OnNotificationOpenRequested;
        Notifications.CenterRequested += OnNotificationCenterRequested;
        await Notifications.InitializeAsync();
        await LoadGlobalSettingsAsync();
        foreach (var run in await ChatRunsApi.GetAsync(CancellationToken.None)) StoreRun(run);
        await WorkspaceStateService.InitializeAsync();
        var target = ParseWorkspaceTarget(Navigation.Uri);
        var projectId = target.ProjectId ?? (target.ChatId is { } chatId
            ? RunState.Runs.Values.FirstOrDefault(run => run.ChatId == chatId)?.ProjectId
            : null);
        await LoadProjectsAsync(projectId ?? WorkspaceStateService.LastProjectId,
            restoreLastChat: target.ChatId is null);
        if (target.ProjectId is not null && _selectedProject?.Id != target.ProjectId)
            Notifications.ShowError("The project in this link is unavailable.");
        if (target.ChatId is not null && (target.ProjectId is null || _selectedProject?.Id == target.ProjectId))
            await NavigateToTargetAsync(target);
        _notificationsOpen = target.NotificationsOpen;
        if (_notificationsOpen) Notifications.MarkAllSeen();
        _workspaceInitialized = true;
        _ = RunGeneratingTickerAsync(_generatingTickerCancellation.Token);
    }

    // The composer status shows elapsed generation time, which needs to advance once a second
    // even though nothing about the run itself has changed — snapshot pushes alone (OnRunSnapshot)
    // are too sparse (e.g. silent while a tool call is running) to drive that on their own.
    private async Task RunGeneratingTickerAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            try { await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken); }
            catch (OperationCanceledException) { break; }
            if (GetSelectedRun()?.Status == ChatRunStatus.Generating) await InvokeAsync(StateHasChanged);
        }
    }

    // Elapsed time the LLM has actually spent producing the response — excludes time spent
    // waiting on a tool approval decision or a tool running, since the LLM isn't "generating"
    // during either.
    private TimeSpan? GetGeneratingElapsed()
    {
        if (_selectedChat is null || GetSelectedRun()?.Status != ChatRunStatus.Generating) return null;
        return RunState.GetLlmGeneratingElapsed(new RunKey(_selectedChat.Id, GetSelectedRunBranchId()));
    }

    private string GetGeneratingStatusText()
    {
        var run = GetSelectedRun();
        if (run?.Wait is { Kind: ChatRunWaitKind.RateLimit } wait)
        {
            var seconds = Math.Max(0, (int)Math.Ceiling((wait.RetryAt - DateTimeOffset.UtcNow).TotalSeconds));
            return $"Rate limited · retrying in {seconds}s (attempt {wait.Attempt})" + GetGeneratingEnterHint();
        }
        var elapsed = GetGeneratingElapsed();
        var fallback = $"Generating{(elapsed is { } value ? $"... {FormatElapsed(value)}" : "...")}";
        var activeMessageId = run?.ActiveMessageId
            ?? run?.Queue.FirstOrDefault(item => item.Stage == QueuedMessageStage.UserCommitted)?.Id;
        if (_selectedChat is null || elapsed is null || activeMessageId is null)
            return fallback + GetGeneratingEnterHint();

        var branch = Feed.BuildBranch(_selectedChat.Messages, _branchLeafId);
        // A run snapshot can reach the browser before the matching chat revision. Do not borrow
        // the previous turn's final answer as the new run's progress title during that window.
        var turn = Feed.BuildTurns(branch, lastTurnEndedWithoutFinalAnswer: true)
            .LastOrDefault(item => item.UserMessage?.Id == activeMessageId);
        var title = turn is null ? null : Feed.RunningTitleOf(turn, elapsed.Value);
        if (title is not null && _currentTurnSummaryVisible)
            return GetGeneratingEnterHint().TrimStart(' ', '·');
        return (title ?? fallback) + GetGeneratingEnterHint();
    }

    private bool _currentTurnSummaryVisible;
    private void SetCurrentTurnSummaryVisibility(bool visible) =>
        _currentTurnSummaryVisible = visible;

    private static string FormatElapsed(TimeSpan elapsed)
    {
        var totalSeconds = Math.Max(0, (int)elapsed.TotalSeconds);
        var minutes = totalSeconds / 60;
        var seconds = totalSeconds % 60;
        return minutes > 0 ? $"{minutes}m {seconds}s" : $"{seconds}s";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetReference = DotNetObjectReference.Create(this);
            await WorkspaceLayoutService.AttachAsync(_workspace);
            try
            {
                _composerModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/chatComposer.js");
                _resourceDropSubscription = await _composerModule.InvokeAsync<IJSObjectReference>("watchResourceDrop", _dotNetReference);
                _inlineEditorModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/inlineEditor.js");
                _runEventsModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/runEvents.js");
                _runEventsSubscription = await _runEventsModule.InvokeAsync<IJSObjectReference>("subscribe", _apiBaseUrl.Value.ToString(), _dotNetReference);
                _focusSubscription = await _runEventsModule.InvokeAsync<IJSObjectReference>("watchFocus", _dotNetReference);
                _escapeSubscription = await _runEventsModule.InvokeAsync<IJSObjectReference>("watchEscape", _dotNetReference);
                _drawerDismissSubscription = await _runEventsModule.InvokeAsync<IJSObjectReference>("watchDrawerDismiss", _dotNetReference);
                _queueDragSubscription = await _runEventsModule.InvokeAsync<IJSObjectReference>("watchQueueDrag", _dotNetReference);
                _applicationFocused = await _runEventsModule.InvokeAsync<bool>("isFocused");
                _navigationModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/workspaceNavigation.js");
                _navigationHandle = await _navigationModule.InvokeAsync<IJSObjectReference>("attach", _dotNetReference);
                _scrollbarGutterModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/chatScrollbarGutter.js");
                _scrollbarGutterHandle = await _scrollbarGutterModule.InvokeAsync<IJSObjectReference>(
                    "attach",
                    ".workspace-messages",
                    ".workspace-conversation",
                    "--chat-scrollbar-width");
            }
            catch (JSException)
            {
                _composerModule = null;
            }

            StateHasChanged();
        }

        if (_pendingReviewSubmenu is { } submenu && _runEventsModule is not null)
        {
            _pendingReviewSubmenu = null;
            var prefix = submenu.IsBranch ? "branch" : "chat";
            await _runEventsModule.InvokeVoidAsync("showReviewSubmenu",
                $"{prefix}-reviews-trigger-{submenu.OwnerId}", $"{prefix}-reviews-popup-{submenu.OwnerId}");
        }

        if (_attachComposer && _composerModule is not null && _dotNetReference is not null)
        {
            await DisposeComposerHandleAsync();

            try
            {
                var handle = await _composerModule.InvokeAsync<IJSObjectReference>("attach", _composer, _dotNetReference);
                _composerHandle = handle;
            }
            catch (Exception error) when (error is JSException or ObjectDisposedException)
            {
                _composerModule = null;
                _composerHandle = null;
            }
            _attachComposer = false;
        }

        await SyncFileLinkAccessAsync();

        if (_scrollMessagesToBottom && _messageFeed is not null)
        {
            // An explicit "just sent a message" always wins over a stale pending restore from
            // whatever chat/branch switch happened to precede it in this render.
            _scrollMessagesToBottom = false;
            _followNewMessages = false;
            _pendingScrollRestoreKey = null;
            await _messageFeed.ScrollToBottomAsync();
        }
        else if (_pendingScrollRestoreKey is { } restoreKey && _messageFeed is not null)
        {
            // Restoring where the user left this chat is itself a position decision, so a
            // snapshot that landed in the same render must not also drag the feed to the end.
            _pendingScrollRestoreKey = null;
            _followNewMessages = false;
            await _messageFeed.RestoreScrollPositionAsync(restoreKey);
        }
        else if (_followNewMessages && _messageFeed is not null)
        {
            _followNewMessages = false;
            await _messageFeed.FollowNewContentAsync();
        }

        if (_targetMessageId is { } targetMessageId && _messageFeed is not null)
        {
            _targetMessageId = null;
            await _messageFeed.ScrollToMessageAsync(targetMessageId);
        }

        // After the render that shows the transcript, never before it: both of these are round
        // trips, and neither of them changes what the user is looking at.
        if (_openedChatToSettle is { } opened)
        {
            _openedChatToSettle = null;
            if (_selectedProject?.Id == opened.ProjectId && _selectedChat?.Id == opened.ChatId)
            {
                await MarkSelectedChatReadAsync();
                await WorkspaceStateService.SetProjectContextAsync(opened.ProjectId, opened.ChatId, opened.BranchLeafId);
            }
        }

        if (_composerNeedsResize && _composerHandle is not null)
        {
            _composerNeedsResize = false;
            var handle = _composerHandle;
            try
            {
                await handle.InvokeVoidAsync("resize");
            }
            catch (Exception error) when (error is JSException or ObjectDisposedException)
            {
                if (ReferenceEquals(_composerHandle, handle)) _composerHandle = null;
            }
        }

        if (_focusEditingInputPending && _inlineEditorModule is not null)
        {
            _focusEditingInputPending = false;
            await _inlineEditorModule.InvokeVoidAsync("focusAndSelect", _editingInput);
        }

        if (!_suppressNavigationWrite) await SyncWorkspaceUrlAsync(firstRender);
    }

