        if (!result.IsDeleted) { Notifications.ShowError("Branch was not deleted. Reload the chat and try again."); return; }
        _selectedChat = await ChatHistoryApi.GetTranscriptAsync(_selectedProject.Id, _selectedChat.Id, CancellationToken.None);
        _selectedBranchId = result.ParentBranchId ?? _selectedChat?.Id;
