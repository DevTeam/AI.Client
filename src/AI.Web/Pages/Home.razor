        await CloseReviewAsync();
        _reviewChat = null;
        _reviews.Clear();
        _reviewVersion++;
        _attachComposer = true;
        ResetBranchOperationState();
        _selectedChat = null;
        _selectedBranchId = null;
        _branchLeafId = null;
        await WorkspaceStateService.SetProjectContextAsync(_selectedProject.Id, null, null);
        SetJustArrivedLeaf(null);
        _wasGeneratingByBranch.Clear();
        if (_defaultConnectionId is { } endpointId)
        {
            await SelectChatProfileAsync(new ChangeEventArgs { Value = endpointId.ToString() });
        }
        // Drop any previously-typed "new chat" draft for this project. The user just clicked
        // "+", they want a fresh composer — if we only cleared _chat.Message here, the draft
        // would still be in localStorage and reappear the next time they navigate away and
        // back (RestoreComposerDraft in SelectProjectAsync would find it again). The flush
        // makes the deletion land in localStorage before that navigation can happen.
        WorkspaceStateService.QueueComposerDraftSave($"new:{_selectedProject.Id}", string.Empty);
        await WorkspaceStateService.FlushPendingComposerDraftAsync();
        _chat.Message = string.Empty;
        _draftResources.Clear();
        _resourceDrafts.Remove(GetComposerDraftKey());
        if (_composerHandle is not null) await _composerHandle.InvokeVoidAsync("focus");
    }

