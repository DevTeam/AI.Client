    private async Task AttachFileAsync(byte[] data, string name, ChatResourceSource source)
    {
        if (_selectedProject is not { } project) return;
        if (_draftResources.Count >= 20)
        {
            Notifications.ShowError("A message can reference at most 20 resources.");
            return;
        }
        try
        {
            var resource = await ResourceApi.UploadFileAsync(project.Id, data, name, source, CancellationToken.None);
            if (_selectedProject?.Id != project.Id) return;
            _draftResources.Add(resource);
            _resourceDrafts[GetComposerDraftKey()] = _draftResources.ToArray();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception error) when (error is IOException or InvalidOperationException or HttpRequestException)
        { Notifications.ShowError($"Could not attach the file: {error.Message}"); }
    }

