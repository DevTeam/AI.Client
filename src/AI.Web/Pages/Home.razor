    /// <summary>
    /// Takes the directory the picker came back with. A new grant is created here rather than when
    /// the picker opened, so nothing is left behind if it is closed without choosing anything.
    /// </summary>
    private async Task OnDirectoryPickedAsync(string path)
    {
        var grantId = _directoryPickerGrantId;
        CloseDirectoryPicker();
        await WorkspaceStateService.SetLastBrowsedDirectoryAsync(path);

        var grant = grantId is { } id ? _security.DirectoryGrants.SingleOrDefault(item => item.Id == id) : null;
        if (grant is null)
        {
            await AddDirectoryGrantAsync(path);
            return;
        }
        if (string.Equals(grant.CanonicalRoot, path, StringComparison.Ordinal)) return;

        grant.CanonicalRoot = path;
        grant.DisplayName = GetDirectoryDisplayNameSuggestion(path);
        await PersistDirectoryGrantsAsync();
    }

    /// <summary>Adds a read-only grant over <paramref name="path"/>; true once it is saved.</summary>
    private async Task<bool> AddDirectoryGrantAsync(string path, string? successMessage = null)
    {
        // Paths are canonicalised by the host, so two grants over one directory would be two
        // identical rows — and revoking the one you can see would leave the other in force.
        if (_security.DirectoryGrants.Exists(item => string.Equals(item.CanonicalRoot, path, StringComparison.OrdinalIgnoreCase)))
        {
            Notifications.ShowInfo("That directory is already granted.");
            return false;
        }

        var grant = new DirectoryGrantEditor
        {
            ToolNames = "read",
            CanonicalRoot = path,
            DisplayName = GetDirectoryDisplayNameSuggestion(path)
        };
        _security.DirectoryGrants.Add(grant);
        _directoriesExpanded = true;
        return await PersistDirectoryGrantsAsync(successMessage);
    }

    private static string GetDirectoryDisplayNameSuggestion(string path)
    {
        var trimmed = path.TrimEnd('\\', '/');
        var separatorIndex = trimmed.LastIndexOfAny(['\\', '/']);
        return separatorIndex >= 0 ? trimmed[(separatorIndex + 1)..] : trimmed;
    }

