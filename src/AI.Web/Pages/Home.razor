    {
        if (_composerCtrlDown == ctrl && _composerAltDown == alt && _composerShiftDown == shift) return Task.CompletedTask;
        _composerCtrlDown = ctrl;
        _composerAltDown = alt;
        _composerShiftDown = shift;
