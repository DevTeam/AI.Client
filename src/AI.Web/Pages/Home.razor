        }
        else if (_isProjectMenuOpen || _chatMenuId is not null || _branchMenuId is not null || _directoryMenuId is not null || _fileLinkMenu is not null)
        {
            CloseContextMenus();
        }
        else if (_isConfirmingQueueClearAll)
        {
            _isConfirmingQueueClearAll = false;
        }
        else if (_toolApprovalBar?.CancelTransientUi() == true)
        {
            // Escape closes the approval details or global confirmation first.
