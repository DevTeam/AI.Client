    private async Task<bool> LoadFullReviewAsync(Guid id)
    {
        if (_selectedProject is null || _selectedChat is null) return false;
        var projectId = _selectedProject.Id;
        var chatId = _selectedChat.Id;
        try
        {
            var review = await ReviewApi.GetAsync(projectId, chatId, id, CancellationToken.None);
            if (_selectedProject?.Id != projectId || _selectedChat?.Id != chatId) return false;
            if (review is null) { _chatError = "Review is unavailable."; return false; }
            var index = _reviews.FindIndex(item => item.Id == id);
            if (index < 0) _reviews.Add(review); else _reviews[index] = review;
            _reviewVersion++;
            return true;
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _chatError = $"Could not open review: {error.Message}";
            return false;
        }
    }

    private async Task OpenReviewFromChangesAsync(Guid sourceMessageId)
    {
        if (_openingReviewSourceId == sourceMessageId) return;
        if (_reviewWorkspaceOpen && _reviews.FirstOrDefault(item => item.Id == _reviewStartId)?.SourceMessageId != sourceMessageId)
            await CloseReviewAsync();
        if (!await CloseDrawersExceptAsync(Drawer.Review)) return;
        _openingReviewSourceId = sourceMessageId;
        try
        {
            await LoadReviewsAsync();
            if (!await LoadReviewChatAsync() || _reviewChat is null || _selectedProject is null) return;
            var review = _reviews.Where(item => item.Kind == ChatReviewKind.Diff && item.SourceMessageId == sourceMessageId)
                .OrderByDescending(item => item.UpdatedAt).FirstOrDefault();
            if (review is null)
            {
                var source = _reviewChat.Messages.FirstOrDefault(item => item.Id == sourceMessageId);
                if (source?.WorkspaceChanges is not { IsEmpty: false } changes) return;
                review = await ReviewApi.CreateAsync(_selectedProject.Id, _reviewChat.Id,
                    new CreateReviewRequest(sourceMessageId, $"Review {source.CreatedAt.LocalDateTime:g}",
                        changes.Files.Select(item => item.Path).ToArray()), CancellationToken.None);
                _reviews.Add(review);
                _reviewVersion++;
            }
            else if (!await LoadFullReviewAsync(review.Id)) return;
            OpenReviewPanel(review.Id);
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException or ArgumentException)
        {
            _chatError = $"Could not open review: {error.Message}";
        }
        finally { _openingReviewSourceId = null; }
    }

    private async Task<bool> LoadReviewChatAsync()
    {
        if (_selectedProject is null || _selectedChat is null) return false;
        var projectId = _selectedProject.Id;
        var chatId = _selectedChat.Id;
        try
        {
            var full = await ChatHistoryApi.GetAsync(projectId, chatId, CancellationToken.None);
            if (full is null || _selectedProject?.Id != projectId || _selectedChat?.Id != chatId) return false;
            _reviewChat = full;
            return true;
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _chatError = $"Could not open review: {error.Message}";
            return false;
        }
    }

    private void OpenReviewPanel(Guid reviewId)
    {
        if (_selectedChat is null) return;
        _reviewStartId = reviewId;
        _reviewPanelKey++;
        _reviewWorkspaceOpen = true;
    }

    private void CloseReview() => _reviewWorkspaceOpen = false;

    private async Task CloseReviewAsync()
    {
        if (!_reviewWorkspaceOpen) return;
        var review = _reviews.FirstOrDefault(item => item.Id == _reviewStartId);
        CloseReview();
        if (review is not null && IsEmptyReview(review))
            await DeleteReviewAsync(review.ChatId, review.Id, notify: false);
    }

    private async Task OnReviewChangedAsync(ChatReview review)
    {
        if (IsEmptyReview(review))
        {
            var previous = _reviews.FirstOrDefault(item => item.Id == review.Id);
            if (!_reviewWorkspaceOpen || _reviewStartId != review.Id
                || previous is { } existing && !IsEmptyReview(existing))
                await DeleteReviewAsync(review.ChatId, review.Id, notify: false);
            else
            {
                var draftIndex = _reviews.FindIndex(item => item.Id == review.Id);
                if (draftIndex < 0) _reviews.Add(review); else _reviews[draftIndex] = review;
                _reviewVersion++;
            }
            return;
        }
        var index = _reviews.FindIndex(item => item.Id == review.Id);
        if (index < 0) _reviews.Add(review); else _reviews[index] = review;
        _reviews.Sort((first, second) => second.SourceCreatedAt.CompareTo(first.SourceCreatedAt));
        _menuReviews[review.ChatId] = _reviews.ToArray();
        _reviewVersion++;
        if (IsFromPreviousRound(review)) AddReviewToDraft(review);
    }

    private Task AttachReviewAsync(ChatReview review)
    {
        if (_selectedChat?.Id != review.ChatId || _selectedProject?.Id != review.ProjectId
            || IsEmptyReview(review)) return Task.CompletedTask;
        AddReviewToDraft(review);
        return Task.CompletedTask;
    }

    private void AddReviewToDraft(ChatReview review)
    {
        if (IsEmptyReview(review)) { RemoveReviewFromDraft(review.Id); return; }
        var reference = new ChatResourceRef(review.Id, ChatResourceKind.Review, string.Empty, review.Name, review.Kind);
        var index = _draftResources.FindIndex(item => item.Id == review.Id);
        if (index >= 0) _draftResources[index] = reference;
        else if (_draftResources.Count < 20) _draftResources.Add(reference);
        else { _chatError = "A message can reference at most 20 resources."; return; }
        _resourceDrafts[GetComposerDraftKey()] = _draftResources.ToArray();
    }

    private static bool IsEmptyReview(ChatReview review) => review.Kind == ChatReviewKind.Diff
        ? review.Comments.Count == 0 : review.MessageComments is not { Count: > 0 };

    private bool IsFromPreviousRound(ChatReview review)
    {
        if (_selectedChat?.Id != review.ChatId || _selectedProject?.Id != review.ProjectId) return false;
        var branch = Feed.BuildBranch(_selectedChat.Messages, _branchLeafId);
        var run = GetSelectedRun();
        var activeMessageId = run?.ActiveMessageId
            ?? run?.Queue.FirstOrDefault(item => item.Stage == QueuedMessageStage.UserCommitted)?.Id;
        var lastTurnIsPending = run?.Status is ChatRunStatus.Generating or ChatRunStatus.Failed
                or ChatRunStatus.Interrupted or ChatRunStatus.Paused
            && activeMessageId is not null
            && !Feed.LastTurnHasCompleteAnswer(branch)
            && branch.LastOrDefault(message => message.Role == "User")?.Id == activeMessageId;
        var completedAnswers = Feed.BuildTurns(branch, lastTurnIsPending)
            .Select(turn => turn.FinalAnswer?.Message)
            .Where(message => message is { IsIncomplete: false })
            .Select(message => message!.Id).ToArray();
        if (completedAnswers.Length == 0) return false;
        var lastAnswer = -1;
        var previousAnswer = -1;
        for (var index = 0; index < branch.Count; index++)
        {
            if (branch[index].Id == completedAnswers[^1]) lastAnswer = index;
            if (completedAnswers.Length > 1 && branch[index].Id == completedAnswers[^2]) previousAnswer = index;
        }
        for (var index = previousAnswer + 1; index <= lastAnswer; index++)
            if (branch[index].Id == review.SourceMessageId) return true;
        return false;
    }

    private string ReviewName(ChatResourceRef reference) =>
        reference.ReviewKind == ChatReviewKind.Message
            ? $"Message comments · {_reviews.FirstOrDefault(item => item.Id == reference.Id)?.MessageComments?.Count ?? 0}"
            : _reviews.FirstOrDefault(item => item.Id == reference.Id)?.Name ?? reference.Name ?? reference.Path;

    private string? ResourcePickerStartPath()
    {
        var roots = _security.DirectoryGrants
            .Where(grant => grant.ToolNames.Split(',', StringSplitOptions.TrimEntries)
                .Contains("read", StringComparer.OrdinalIgnoreCase))
            .Select(grant => grant.CanonicalRoot)
            .Where(path => !string.IsNullOrWhiteSpace(path))
            .ToArray();
        var previous = WorkspaceStateService.LastBrowsedDirectory;
        var comparison = OperatingSystem.IsWindows() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal;
        if (previous is not null && roots.Any(root => string.Equals(previous, root, comparison)
            || previous.StartsWith(Path.EndsInDirectorySeparator(root) ? root : root + Path.DirectorySeparatorChar,
                comparison))) return previous;
        return roots.FirstOrDefault();
    }

