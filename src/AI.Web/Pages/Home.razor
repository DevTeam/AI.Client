    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.AltKey || e.CtrlKey || e.MetaKey) return;
        switch (e.Key)
        {
            case "Escape":
                await CloseSearchPanelAsync();
                break;
            case "ArrowDown":
            case "ArrowUp":
                await MoveSearchActiveAsync(e.Key == "ArrowDown" ? 1 : -1);
                break;
            case "Enter":
                var rows = GetVisibleSearchRows();
                if (rows.Count == 0) break;
                var target = rows.FirstOrDefault(row => row.MessageId == _searchActiveMessageId) ?? rows[0];
                await OpenSearchMatchAsync(target);
                break;
        }
    }

    // The rows in the order they are drawn: the keyboard walks exactly what the eye sees.
    private List<ChatSearchMatch> GetVisibleSearchRows() =>
        _searchGroups.SelectMany(group => _expandedSearchGroups.Contains(group.ChatId)
            ? group.Matches
            : group.Matches.Take(SearchGroupPreviewCount)).ToList();

    private async Task MoveSearchActiveAsync(int step)
    {
        var rows = GetVisibleSearchRows();
        if (rows.Count == 0) return;
        var current = rows.FindIndex(row => row.MessageId == _searchActiveMessageId);
        var next = current < 0
            ? step > 0 ? 0 : rows.Count - 1
            : Math.Clamp(current + step, 0, rows.Count - 1);
        _searchActiveMessageId = rows[next].MessageId;
        StateHasChanged();
        await WorkspaceLayoutService.RevealElementAsync(SearchRowId(rows[next].MessageId));
    }

    private void ToggleSearchGroup(Guid chatId)
    {
        if (!_expandedSearchGroups.Add(chatId)) _expandedSearchGroups.Remove(chatId);
    }

    private void SetSearchResult(ChatSearchResult? result)
    {
        _searchResult = result;
        _searchResultQuery = _searchQuery.Trim();
        _searchGroups = result is null ? [] : SearchResults.Group(result.Matches);
        _expandedSearchGroups.Clear();
        _searchActiveMessageId = null;
    }

    private async Task ClearSearch()
    {
        await CancelSearchAsync();
        _searchQuery = string.Empty;
        SetSearchResult(null);
    }

    private async Task CancelSearchAsync()
    {
        if (_searchCancellation is { } previous)
        {
            await previous.CancelAsync();
            previous.Dispose();
            _searchCancellation = null;
        }

        _isSearching = false;
        SearchBusy.End();
    }

    private async Task RunSearchAsync()
    {
        // Typing is faster than searching, so each keystroke cancels the scan the last one started;
        // otherwise the answer to a half-typed word could land after the answer to the whole one.
        await CancelSearchAsync();
        var query = _searchQuery.Trim();
        if (query.Length < 2)
        {
            // One character matches nearly everything and costs a full scan to prove it.
            SetSearchResult(null);
            return;
        }

        var cancellation = new CancellationTokenSource();
        _searchCancellation = cancellation;
        _isSearching = true;
        SearchBusy.Begin();
        try
        {
            var result = await ChatHistoryApi.SearchAsync(query, null, cancellation.Token, _searchIncludeArchived);
            if (!cancellation.IsCancellationRequested && _searchQuery.Trim() == query)
            {
                SetSearchResult(result);
                _isSearching = false;
                SearchBusy.End();
            }
        }
        catch (OperationCanceledException) { }
        catch (HttpRequestException)
        {
            if (!cancellation.IsCancellationRequested) SetSearchResult(new ChatSearchResult([], 0, 0, false, null, "Search is unavailable."));
            _isSearching = false;
            SearchBusy.End();
        }
    }

    private async Task OpenSearchMatchAsync(ChatSearchMatch match)
    {
        // Whatever was opened, by pointer or keyboard, is where the next Up/Down continues from.
        _searchActiveMessageId = match.MessageId;
        if (_projects.SingleOrDefault(item => item.Id == match.ProjectId) is { } project)
        {
            if (_selectedProject?.Id != project.Id) await SelectProjectAsync(project, restoreLastChat: false);
            await SelectChatAsync(match.ChatId);
        }

        // Keep the sidebar showing the matching list while the feed scrolls: clearing first would
        // dismiss the results panel, and dismissing the results panel also drops the highlight
        // (the highlight is driven by SearchQuery, which ClearSearch resets). The "close search"
        // rule therefore kicks in only once the user dismisses the results themselves — typing a
        // new query, hitting Escape, or clicking the input built-in clear button.
        if (_messageFeed is not null) await _messageFeed.ScrollToMessageAsync(match.MessageId);
    }

    // The chat the sidebar should show as selected: what the user just clicked, if its transcript
    // is still loading, and otherwise what is actually open.
    private Guid? GetActiveChatId() => _pendingChatId ?? _selectedChat?.Id;

    // Supersedes any selection still in flight. The abandoned one stops at its next guard, and
    // its HTTP request is cancelled rather than deserialised into a transcript nobody wants.
    private CancellationToken BeginChatSelection(Guid chatId)
    {
        CancelChatSelection();
        var cancellation = new CancellationTokenSource();
        _chatSelectionCancellation = cancellation;
        _pendingChatId = chatId;
        return cancellation.Token;
    }

    private void CancelChatSelection()
    {
        _chatSelectionCancellation?.Cancel();
        _chatSelectionCancellation?.Dispose();
        _chatSelectionCancellation = null;
        _pendingChatId = null;
    }

    private async Task SelectChatAsync(Guid chatId)
    {
        await CloseReviewAsync();
        _reviewChat = null;
        _attachComposer = true;
        ResetBranchOperationState();
        CloseContextMenus();
        var cancellation = BeginChatSelection(chatId);
        if (_selectedProject is not null)
        {
            var projectId = _selectedProject.Id;
            if (_selectedChat is { } currentChat) CacheChatDetails(currentChat);
            // Clicking the chat's own sidebar entry while a DIFFERENT one of its branches is
            // already open is the only explicit way back to the main branch (there's no separate
            // "main branch" row next to the fork rows) — it must always land there. Restoring the
            // remembered branch here too made it a no-op once any branch had ever been visited:
            // SelectBranchTreeItemAsync had just written that branch as "last left on" for this
            // exact chat, so the restore step below immediately re-selected it right back,
            // permanently masking the reset. The remembered-branch restore is for the OTHER case
            // this method serves — arriving at this chat from somewhere else (a different chat, a
            // fresh page load) — which is exactly what "already viewing this chat" rules out.
            var wasAlreadyOnThisChat = _selectedChat?.Id == chatId;
            ChatDetails? details;
            try
            {
                // Reading the destination and recording the old scroll position are independent.
                // Running them together removes a full JS round-trip from the user's wait while
                // still letting the old DOM be measured before the new transcript is rendered.
                var detailsTask = GetChatForSelectionAsync(projectId, chatId, cancellation);
                var saveScrollTask = SaveCurrentScrollPositionAsync();
                await Task.WhenAll(detailsTask, saveScrollTask);
                details = await detailsTask;
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch (HttpRequestException)
            {
                _pendingChatId = null;
                if (!ClientMode.PublicWeb || HostConnection.Status == HostConnectionStatus.Connected)
                    Notifications.ShowError("The chat could not be loaded. Try again.");
                return;
            }

            // Superseded while the transcript was on its way: everything below writes selection
            // state, and writing it now would undo the chat the user has since asked for.
            if (cancellation.IsCancellationRequested) return;

            _pendingChatId = null;
            _selectedChat = details;
            _branchLeafId = GetOriginalBranchLeaf(_selectedChat);

            // Prefer the branch this chat was last left on, within this project, if it's still
            // part of the chat (a branch can be deleted independently of the chat itself).
            var context = WorkspaceStateService.GetProjectContext(_selectedProject.Id);
            // The branch id survives changes to its head while this project is away. Older
            // saved contexts have only a leaf and are matched against current branch heads.
            var rememberedBranch = _selectedChat is null || wasAlreadyOnThisChat
                ? null : GetRememberedBranch(_selectedChat, context);
            if (rememberedBranch is not null)
            {
                _branchLeafId = rememberedBranch.HeadMessageId;
            }

            _selectedBranchId = rememberedBranch?.Id ?? _selectedChat?.Id;
            if (_selectedChat?.ConnectionId is { } endpointId)
            {
                // Restore the selection without persisting an endpoint change when opening a chat.
                SelectGlobalConnection(endpointId);
            }
            RestoreComposerDraft();
            // Whether to jump to the bottom or restore the last-viewed message is decided in
            // MessageFeed (it knows whether a saved position exists) — see OnAfterRenderAsync.
            _pendingScrollRestoreKey = GetScrollPositionKey();
            if (_selectedChat is not null)
                _openedChatToSettle = (projectId, _selectedChat.Id, GetSelectedRunBranchId());
            if (_selectedChat is not null)
                await WorkspaceStateService.SetProjectContextAsync(projectId, _selectedChat.Id,
                    _branchLeafId, _selectedBranchId);
            await LoadReviewsAsync();
        }
        else
        {
            _pendingChatId = null;
        }
    }

    private async Task<ChatDetails?> GetChatForSelectionAsync(Guid projectId, Guid chatId, CancellationToken cancellationToken)
    {
        var knownRevision = _chats.FirstOrDefault(chat => chat.Id == chatId)?.Revision;
        if (_chatDetailsCache.TryGetValue(chatId, out var cached)
            && cached.ProjectId == projectId
            && (knownRevision is null || cached.Revision >= knownRevision))
        {
            CacheChatDetails(cached);
            return cached;
        }

        var loaded = await ChatHistoryApi.GetTranscriptAsync(projectId, chatId, cancellationToken);
        if (loaded is not null) CacheChatDetails(loaded);
        return loaded;
    }

    private void CacheChatDetails(ChatDetails chat)
    {
        if (_chatDetailsCacheSizes.TryGetValue(chat.Id, out var previousSize))
            _chatDetailsCacheBytes -= previousSize;
        var size = EstimateChatDetailsSize(chat);
        _chatDetailsCache[chat.Id] = chat;
        _chatDetailsCacheSizes[chat.Id] = size;
        _chatDetailsCacheBytes += size;
        var existing = _chatDetailsLru.Find(chat.Id);
        if (existing is not null) _chatDetailsLru.Remove(existing);
        _chatDetailsLru.AddFirst(chat.Id);

        while (_chatDetailsLru.Count > MinRetainedChatDetailsCount
               && (_chatDetailsLru.Count > MaxRetainedChatDetailsCount
                   || _chatDetailsCacheBytes > RetainedChatDetailsBudgetBytes))
        {
            var expiredChatId = _chatDetailsLru.Last!.Value;
            _chatDetailsLru.RemoveLast();
            _chatDetailsCache.Remove(expiredChatId);
            if (_chatDetailsCacheSizes.Remove(expiredChatId, out var expiredSize))
                _chatDetailsCacheBytes -= expiredSize;
        }
    }

    private static long EstimateChatDetailsSize(ChatDetails chat)
    {
        // Strings dominate these objects (especially tool output). Two bytes per character is the
        // useful lower-bound for their managed representation; object/list overhead is covered by
        // the conservative budget rather than paying for a full graph walk or re-serialization.
        long characters = chat.Title.Length;
        foreach (var message in chat.Messages)
        {
            characters += message.Role.Length + message.Content.Length;
            foreach (var call in message.ToolCalls ?? [])
                characters += call.Id.Length + call.Name.Length + call.Arguments.Length;
            if (message.WorkspaceChanges is { } changes)
                foreach (var file in changes.Files)
                    characters += file.Path.Length + (file.PreviousPath?.Length ?? 0) + (file.Diff?.Length ?? 0);
        }
        return Math.Max(4096, characters * sizeof(char));
    }

    private ChatRunSnapshot? GetRun(Guid chatId, Guid branchId) => RunState.Runs.GetValueOrDefault(new RunKey(chatId, branchId));
    private ChatRunSnapshot? GetBranchRun(Guid chatId, BranchTreeItem branch) => GetRun(chatId, branch.RootId);
    private ChatRunSnapshot? GetSelectedRun() => _selectedChat is not null ? GetRun(_selectedChat.Id, GetSelectedRunBranchId()) : null;
    /// <summary>Show live changes above the composer until the turn's receipt appears in the feed.</summary>
    private AI.Contracts.Workspace.WorkspaceChangeSet? GetLiveTurnChanges()
    {
        var run = GetSelectedRun();
        if (ReferenceEquals(_liveTurnChangesChat, _selectedChat)
            && _liveTurnChangesLeafId == _branchLeafId
            && ReferenceEquals(_liveTurnChangesRun, run))
            return _liveTurnChangesCache;

        _liveTurnChangesChat = _selectedChat;
        _liveTurnChangesLeafId = _branchLeafId;
        _liveTurnChangesRun = run;
        _liveTurnChangesCache = CalculateLiveTurnChanges(run);
        return _liveTurnChangesCache;
    }

    private AI.Contracts.Workspace.WorkspaceChangeSet? CalculateLiveTurnChanges(ChatRunSnapshot? run)
    {
        if (_selectedChat is null || run is not { Status: not ChatRunStatus.Completed, WorkspaceChanges: { IsEmpty: false } changes })
            return null;
        var branch = Feed.BuildBranch(_selectedChat.Messages, _branchLeafId);
        var lastUserId = branch.LastOrDefault(message => message.Role == "User")?.Id;
        var activeMessageId = run.ActiveMessageId
            ?? run.Queue.FirstOrDefault(item => item.Stage == QueuedMessageStage.UserCommitted)?.Id;

        // The run snapshot can arrive before its user message. Ignore the previous turn's
        // receipt while the two event streams catch up.
        if (activeMessageId is { } activeId && activeId != lastUserId)
            return changes;

        return Feed.LastTurnHasWorkspaceReceipt(branch) ? null : changes;
    }

