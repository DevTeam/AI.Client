    private async Task OnComposerInput(ChangeEventArgs args)
    {
        // Typing detaches the composer from history: the text is the user's own again, so it
        // goes back to being saved as a draft and Up starts a fresh walk from the newest entry.
        _composerHistoryNavigator.Reset();
        var wasCommand = SkillMatcher.GetQuery(_chat.Message) is not null;
        _chat.Message = args.Value?.ToString() ?? string.Empty;
        if (_chat.Message == "?" && _selectedChat is null && ChatTips.IsHidden)
        {
            // The way back to hidden tips: a lone "?" in a new chat's empty message shows them
            // and is not kept as text.
            _chat.Message = string.Empty;
            if (_composerHandle is not null) await _composerHandle.InvokeVoidAsync("reset");
            await ChatTips.SetHiddenAsync(false);
            return;
        }
        WorkspaceStateService.QueueComposerDraftSave(GetComposerDraftKey(), _chat.Message);
        await UpdateSkillSuggestionsAsync(reload: !wasCommand);
    }

    /// <summary>
    /// Recomputes the slash list for the current text. The skills are re-read each time a command
    /// starts, so one edited in Settings or by the assistant a moment ago is already there.
    /// </summary>
    private async Task UpdateSkillSuggestionsAsync(bool reload)
    {
        if (SkillMatcher.GetQuery(_chat.Message) is not { } query || _selectedProject is not { } project)
        {
            _skillMatches = [];
            _skillSuggestionsDismissed = false;
            return;
        }
        if (reload || _composerSkillsProjectId != project.Id)
        {
            try
            {
                _composerSkills = await SkillApi.ListAsync(project.Id, CancellationToken.None);
                _composerSkillsProjectId = project.Id;
            }
            catch (HttpRequestException)
            {
                // Without the list the slash is plain text; the message still sends as typed.
                _composerSkills = [];
                _composerSkillsProjectId = null;
            }
            // The user may have typed on, or switched project, while the list was loading.
            if (SkillMatcher.GetQuery(_chat.Message) is not { } current || _selectedProject?.Id != project.Id)
            {
                _skillMatches = [];
                return;
            }
            query = current;
        }
        var selectedId = _skillMatches.ElementAtOrDefault(_skillSuggestionIndex)?.Skill.Id;
        _skillMatches = SkillMatcher.Match(_composerSkills, query, _recentSkillIds);
        // A narrowing query keeps the highlighted row while it still matches; otherwise the best one.
        var kept = selectedId is null ? -1 : _skillMatches.ToList().FindIndex(item => item.Skill.Id == selectedId);
        _skillSuggestionIndex = kept >= 0 && query.Length > 0 ? kept : 0;
        _scrollSkillSuggestion = true;
    }

    private bool IsSkillListOpen() => _skillMatches.Count > 0 && !_skillSuggestionsDismissed
        && SkillMatcher.GetQuery(_chat.Message) is not null;

    [JSInvokable]
    public Task MoveSkillSuggestion(int direction)
    {
        if (!IsSkillListOpen()) return Task.CompletedTask;
        _skillSuggestionIndex = (_skillSuggestionIndex + direction + _skillMatches.Count) % _skillMatches.Count;
        _scrollSkillSuggestion = true;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>Enter or Tab in the list: the highlighted skill becomes the message's chip. Returns the text left in the composer.</summary>
    [JSInvokable]
    public async Task<string?> AcceptSkillSuggestion()
    {
        if (!IsSkillListOpen()) return null;
        var text = AcceptSkill(_skillMatches[Math.Clamp(_skillSuggestionIndex, 0, _skillMatches.Count - 1)].Skill);
        await InvokeAsync(StateHasChanged);
        return text;
    }

