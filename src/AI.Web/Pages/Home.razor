    private async Task DeleteReviewAsync(Guid chatId, Guid reviewId, bool notify = true)
    {
        if (_selectedProject is null) return;
        var projectId = _selectedProject.Id;
        try
        {
            if (!await ReviewApi.DeleteAsync(projectId, chatId, reviewId, CancellationToken.None))
            {
                _chatError = "Review no longer exists.";
                if (notify) Notifications.ShowError(_chatError);
                return;
            }
            if (_runEventsModule is not null) await _runEventsModule.InvokeVoidAsync("hideReviewSubmenus");
            CloseContextMenus();
            if (_menuReviews.TryGetValue(chatId, out var menuReviews))
                _menuReviews[chatId] = menuReviews.Where(item => item.Id != reviewId).ToArray();
            _reviews.RemoveAll(item => item.Id == reviewId);
            _reviewVersion++;
            foreach (var key in _resourceDrafts.Keys.Where(key => key.StartsWith($"{chatId}:", StringComparison.Ordinal)).ToArray())
                _resourceDrafts[key] = _resourceDrafts[key].Where(item => item.Id != reviewId).ToArray();
            if (_selectedChat?.Id == chatId)
            {
                RemoveReviewFromDraft(reviewId);
                var refreshed = await ChatHistoryApi.GetAsync(projectId, chatId, CancellationToken.None);
                if (refreshed is not null) { _selectedChat = refreshed; _reviewChat = refreshed; CacheChatDetails(refreshed); }
                if (_reviewStartId == reviewId) CloseReview();
            }
            if (notify) Notifications.ShowSuccess("Review deleted.");
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _chatError = $"Could not delete review: {error.Message}";
            if (notify) Notifications.ShowError(_chatError);
        }
    }

    private async Task OpenAttachedReviewAsync(ChatResource reference)
    {
        if (reference.ReviewKind == ChatReviewKind.Message
            || _reviews.Any(item => item.Id == reference.Id && item.Kind == ChatReviewKind.Message))
        {
            var review = _reviews.FirstOrDefault(item => item.Id == reference.Id);
            if (review is null) { await LoadReviewsAsync(); review = _reviews.FirstOrDefault(item => item.Id == reference.Id); }
            if (review is not null && _messageFeed is not null)
                await _messageFeed.ScrollToMessageAsync(review.SourceMessageId);
            return;
        }
        await OpenReviewAsync(reference.Id);
    }

    private async Task LoadReviewsAsync()
    {
        var projectId = _selectedProject?.Id;
        var chatId = _selectedChat?.Id;
        _reviews.Clear();
        _reviewVersion++;
        if (projectId is null || chatId is null) return;
        try
        {
            var reviews = await PruneEmptyReviewsAsync(projectId.Value, chatId.Value,
                await ReviewApi.ListAsync(projectId.Value, chatId.Value, CancellationToken.None));
            if (_selectedProject?.Id == projectId && _selectedChat?.Id == chatId)
            {
                _reviews.AddRange(reviews);
                _reviewVersion++;
            }
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _chatError = $"Could not load reviews: {error.Message}";
        }
    }

    private async Task<IReadOnlyList<ChatReview>> PruneEmptyReviewsAsync(Guid projectId, Guid chatId,
        IReadOnlyList<ChatReview> reviews)
    {
        var kept = new List<ChatReview>(reviews.Count);
        var deletedIds = new HashSet<Guid>();
        foreach (var review in reviews)
        {
            if (!IsEmptyReview(review) || _reviewWorkspaceOpen && _reviewStartId == review.Id)
            {
                kept.Add(review);
                continue;
            }
            if (await ReviewApi.DeleteAsync(projectId, chatId, review.Id, CancellationToken.None))
                deletedIds.Add(review.Id);
        }
        if (deletedIds.Count == 0) return kept;
        foreach (var key in _resourceDrafts.Keys.Where(key => key.StartsWith($"{chatId}:", StringComparison.Ordinal)).ToArray())
            _resourceDrafts[key] = _resourceDrafts[key].Where(item => !deletedIds.Contains(item.Id)).ToArray();
        if (_selectedChat?.Id == chatId && _selectedProject?.Id == projectId)
        {
            _draftResources.RemoveAll(item => deletedIds.Contains(item.Id));
            var refreshed = await ChatHistoryApi.GetAsync(projectId, chatId, CancellationToken.None);
            if (refreshed is not null) { _selectedChat = refreshed; _reviewChat = refreshed; CacheChatDetails(refreshed); }
        }
        return kept;
    }

    private async Task OpenReviewAsync(Guid id)
    {
        if (_reviewWorkspaceOpen && _reviewStartId != id) await CloseReviewAsync();
        if (!await CloseDrawersExceptAsync(Drawer.Review)) return;
        await LoadReviewsAsync();
        if (!await LoadFullReviewAsync(id)) return;
        if (!await LoadReviewChatAsync()) return;
        OpenReviewPanel(id);
    }

    private async Task<bool> LoadFullReviewAsync(Guid id)
    {
        if (_selectedProject is null || _selectedChat is null) return false;
        var projectId = _selectedProject.Id;
        var chatId = _selectedChat.Id;
        try
        {
            var review = await ReviewApi.GetAsync(projectId, chatId, id, CancellationToken.None);
            if (_selectedProject?.Id != projectId || _selectedChat?.Id != chatId) return false;
            if (review is null) { _chatError = "Review is unavailable."; return false; }
            var index = _reviews.FindIndex(item => item.Id == id);
            if (index < 0) _reviews.Add(review); else _reviews[index] = review;
            _reviewVersion++;
            return true;
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _chatError = $"Could not open review: {error.Message}";
            return false;
        }
    }

    private Task OpenReviewFromChangesAsync(Guid sourceMessageId) => OpenReviewFromChangesAsync(sourceMessageId, null);

    private Task OpenReviewForFileAsync(ChatFileReviewRequest request) =>
        OpenReviewFromChangesAsync(request.SourceMessageId, request.Path);

    private async Task OpenReviewFromChangesAsync(Guid sourceMessageId, string? path)
    {
        _ = ChatTips.MarkUsedAsync(AI.Web.Components.ChatTips.Review);
        if (_openingReviewSourceId == sourceMessageId) return;
        if (_reviewWorkspaceOpen && _reviews.FirstOrDefault(item => item.Id == _reviewStartId)?.SourceMessageId != sourceMessageId)
            await CloseReviewAsync();
        if (!await CloseDrawersExceptAsync(Drawer.Review)) return;
        _openingReviewSourceId = sourceMessageId;
        try
        {
            await LoadReviewsAsync();
            if (!await LoadReviewChatAsync() || _reviewChat is null || _selectedProject is null) return;
            var review = _reviews.Where(item => item.Kind == ChatReviewKind.Diff && item.SourceMessageId == sourceMessageId)
                .OrderByDescending(item => item.UpdatedAt).FirstOrDefault();
            if (review is null)
            {
                var source = _reviewChat.Messages.FirstOrDefault(item => item.Id == sourceMessageId);
                if (source?.WorkspaceChanges is not { IsEmpty: false } changes) return;
                review = await ReviewApi.CreateAsync(_selectedProject.Id, _reviewChat.Id,
                    new CreateReviewRequest(sourceMessageId, $"Review {source.CreatedAt.LocalDateTime:g}",
                        changes.Files.Select(item => item.Path).ToArray()), CancellationToken.None);
                _reviews.Add(review);
                _reviewVersion++;
            }
            else if (!await LoadFullReviewAsync(review.Id)) return;
            OpenReviewPanel(review.Id, path);
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException or ArgumentException)
        {
            _chatError = $"Could not open review: {error.Message}";
        }
        finally { _openingReviewSourceId = null; }
    }

    private async Task<bool> LoadReviewChatAsync()
    {
        if (_selectedProject is null || _selectedChat is null) return false;
        var projectId = _selectedProject.Id;
        var chatId = _selectedChat.Id;
