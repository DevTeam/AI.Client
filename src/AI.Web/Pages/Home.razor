    private int GetTranscriptRunPresentationVersion()
    {
        if (_selectedChat is null) return 0;
        var hash = new HashCode();
        foreach (var run in RunState.Runs.Values.Where(run => run.ChatId == _selectedChat.Id).OrderBy(run => run.BranchId))
        {
            hash.Add(run.BranchId);
            hash.Add(run.Status);
            hash.Add(run.HasUnreadResponse);
            hash.Add(run.PendingApproval?.Id);
            hash.Add(run.PendingPrompt?.Id);
            hash.Add(run.Error);
        }
        return hash.ToHashCode();
    }
    private void StoreRun(ChatRunSnapshot run) => RunState.Store(run);
    private bool IsVisibleRun(ChatRunSnapshot run) =>
        StatusPresentation.HasVisibleAttention(run) || run.Status == ChatRunStatus.Generating || run.HasUnreadResponse;
    private BranchTreeItem? GetSelectedBranchItem() =>
        GetBranchTreeItems().FirstOrDefault(branch => branch.RootId == _selectedBranchId);

    private Guid? GetSelectedBranchId() => GetSelectedBranchItem()?.RootId;

    private Guid GetSelectedRunBranchId() => _selectedChat is null ? Guid.Empty : _selectedBranchId ?? _selectedChat.Id;
    // Priority for picking the ONE run a collapsed project row represents when several of its
    // chats disagree: an outright failure always wins, then anything else needing user action,
    // then an unread completion, then an in-progress run — matching how urgently each state
    // deserves the user's attention rather than e.g. insertion order.
    private int GetProjectRunPriority(ChatRunSnapshot run) => run switch
    {
        { Status: ChatRunStatus.Failed } => 0,
        _ when StatusPresentation.HasVisibleAttention(run) => 1,
        { HasUnreadResponse: true } => 2,
        { Status: ChatRunStatus.Generating } => 3,
        _ => 4
    };
    private ChatRunSnapshot? GetProjectRun(Guid projectId) => GetProjectRuns(projectId)
        .Where(IsVisibleRun)
        .OrderBy(GetProjectRunPriority)
        .FirstOrDefault();
    private ChatRunSnapshot? GetChatBranchRun(Guid chatId) => RunState.Runs.Values
        .Where(run => run.ChatId == chatId && run.BranchId != chatId)
        .Where(run => !ShouldHideCurrentRunStatus(run.ChatId, run.BranchId, run) && IsVisibleRun(run))
        .OrderBy(GetProjectRunPriority)
        .FirstOrDefault();
    private string GetChatBranchStatusClass(Guid chatId) => GetRunStatusClass(GetChatBranchRun(chatId));
    private int GetBranchCount(ChatSummary chat)
    {
        var details = _selectedChat?.Id == chat.Id
            ? _selectedChat
            : _chatDetailsCache.GetValueOrDefault(chat.Id);
        return details?.Branches?.Count(branch => branch.Id != chat.Id && branch.HeadMessageId is not null)
            ?? chat.BranchCount;
    }
    private string GetChatBranchCountTitle(ChatSummary chat, int branchCount)
    {
        var countTitle = GetBranchCountTitle(branchCount);
        return GetChatBranchRun(chat.Id) is { } run
            ? $"{countTitle} · {StatusPresentation.GetStatusTooltip(run)}"
            : countTitle;
    }
    private string GetProjectRunTooltip(Guid projectId) { var runs = GetProjectRuns(projectId).ToArray(); return $"{runs.Count(item => item.Status == ChatRunStatus.Generating)} generating · {runs.Count(item => item.HasUnreadResponse)} unread · {runs.Count(item => item.Status == ChatRunStatus.Failed)} failed"; }
    private IEnumerable<ChatRunSnapshot> GetProjectRuns(Guid projectId)
    {
        return RunState.Runs.Values.Where(run => run.ProjectId == projectId && run.ShowInMainRuns);
    }
    // The open project's own status is already visible per-chat below it, so the project row
    // itself shows nothing — repeating it there would be the same redundant echo we just
    // removed from the currently open chat/branch row.
    private string? GetProjectRunTitle(Guid projectId) =>
        _selectedProject?.Id == projectId || GetProjectRun(projectId) is null ? null : GetProjectRunTooltip(projectId);
    private string GetProjectStatusClass(Guid projectId) =>
        _selectedProject?.Id == projectId ? string.Empty : GetRunStatusClass(GetProjectRun(projectId));
    // A completed/unread/attention status for what's currently open in the transcript needs no
    // separate sidebar signal — the message feed already shows it. Generating is the exception:
    // it stays visible even for the open chat/branch, since it is live progress rather than a
    // state the user has already seen.
    private bool IsCurrentRun(Guid chatId, Guid branchId) => _selectedChat?.Id == chatId && GetSelectedRunBranchId() == branchId;
    private bool ShouldHideCurrentRunStatus(Guid chatId, Guid branchId, ChatRunSnapshot? run) =>
        IsCurrentRun(chatId, branchId) && run?.Status != ChatRunStatus.Generating;
    private string? GetRunTitle(Guid chatId, Guid branchId, ChatRunSnapshot? run) =>
        ShouldHideCurrentRunStatus(chatId, branchId, run) || run is null || !IsVisibleRun(run) ? null : StatusPresentation.GetStatusTooltip(run);
    private string GetRunStatusClass(Guid chatId, Guid branchId, ChatRunSnapshot? run) =>
        ShouldHideCurrentRunStatus(chatId, branchId, run) ? string.Empty : GetRunStatusClass(run);
    private string GetRunStatusClass(ChatRunSnapshot? run) => StatusPresentation.GetStatusClass(run);

    private async Task MarkSelectedConversationReadAsync()
    {
        if (!_applicationFocused || _pendingScrollRestoreKey is not null || _openedChatToSettle is not null
            || _selectedProject is null || _selectedChat is null || _messageFeed is null) return;
        var projectId = _selectedProject.Id;
        var chatId = _selectedChat.Id;
        var branchId = GetSelectedRunBranchId();
        if (GetRun(chatId, branchId)?.HasUnreadResponse != true
            && !Notifications.History.Any(item => item.ChatId == chatId && item.BranchId == branchId && !item.IsSeen)) return;
        if (!await _messageFeed.IsAtBottomAsync()) return;
        if (!_applicationFocused || _pendingScrollRestoreKey is not null || _openedChatToSettle is not null
            || _selectedProject?.Id != projectId || _selectedChat?.Id != chatId || GetSelectedRunBranchId() != branchId) return;
        Notifications.MarkChatBranchSeen(chatId, branchId);
        await MarkChatReadAsync(projectId, chatId, branchId);
    }

    private async Task MarkChatReadAsync(Guid projectId, Guid chatId, Guid branchId)
    {
        if (_isConfirmingProjectDelete || GetRun(chatId, branchId)?.HasUnreadResponse != true) return;
        if (!await _projectMutationGate.WaitAsync(0, CancellationToken.None)) return;
        try
        {
            if (_isConfirmingProjectDelete || GetRun(chatId, branchId)?.HasUnreadResponse != true) return;
            var snapshot = await ChatRunsApi.MarkReadAsync(projectId, chatId, branchId, Guid.CreateVersion7(), CancellationToken.None);
            if (snapshot is not null) StoreRun(snapshot);
        }
        finally
        {
            _projectMutationGate.Release();
        }
    }

    private async Task DisposeComposerHandleAsync()
    {
        var handle = _composerHandle;
        _composerHandle = null;
        if (handle is not null) await DisposeJsReferenceAsync(handle, invokeDispose: true);
    }

    private static async Task DisposeJsReferenceAsync(IJSObjectReference reference, bool invokeDispose = false)
    {
        try
        {
            if (invokeDispose) await reference.InvokeVoidAsync("dispose");
            await reference.DisposeAsync();
        }
        catch (Exception error) when (error is JSException or ObjectDisposedException)
        {
        }
    }

    private void BeginQueueEdit(QueuedChatMessage item) { _editingQueueId = item.Id; _editingQueueText = item.Content; }
    private async Task HandleQueueEditKeyAsync(KeyboardEventArgs args, Guid id)
    {
        switch (args.Key)
        {
            case "Enter":
                await SaveQueuedMessageAsync(id);
                break;
            case "Escape":
                _editingQueueId = null;
                break;
        }
    }
    private async Task SaveQueuedMessageAsync(Guid id)
    {
        if (_editingQueueId != id || _selectedProject is null || _selectedChat is null) return;
        await RunQueueCommandAsync(() => ChatRunsApi.UpdateQueuedAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), id, new UpdateQueuedMessageRequest(Guid.CreateVersion7(), _editingQueueText), CancellationToken.None));
        _editingQueueId = null;
    }
    private async Task MoveQueuedMessageAsync(Guid id, int offset)
    {
        if (_selectedProject is null || _selectedChat is null || GetSelectedRun() is not { } run) return;
        // Positions are indices into the whole queue, including a command that is already in the
        // transcript and so has no row of its own - computing them from the visible rows instead
        // would move the message one place short.
        var position = run.Queue.ToList().FindIndex(item => item.Id == id) + offset;
        await RunQueueCommandAsync(() => ChatRunsApi.UpdateQueuedAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), id, new UpdateQueuedMessageRequest(Guid.CreateVersion7(), Position: position), CancellationToken.None));
    }
    [JSInvokable]
    public async Task DropQueuedMessageAsync(string draggedValue, string targetValue)
    {
        if (!Guid.TryParse(draggedValue, out var draggedId) || !Guid.TryParse(targetValue, out var targetId) || draggedId == targetId || GetSelectedRun() is not { } run) return;
        var position = run.Queue.ToList().FindIndex(item => item.Id == targetId);
        if (_selectedProject is null || _selectedChat is null || position < 0) return;
        await RunQueueCommandAsync(() => ChatRunsApi.UpdateQueuedAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), draggedId, new UpdateQueuedMessageRequest(Guid.CreateVersion7(), Position: position), CancellationToken.None));
    }
    private async Task RemoveQueuedMessageAsync(Guid id)
    {
        if (_selectedProject is null || _selectedChat is null || _queueActionPending) return;
        _queueActionPending = true;
        _optimisticallyHiddenQueueIds.Add(id);
        try
        {
            await RunQueueCommandAsync(() => ChatRunsApi.RemoveQueuedAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), id, Guid.CreateVersion7(), CancellationToken.None));
        }
        finally
        {
            _optimisticallyHiddenQueueIds.Remove(id);
            _queueActionPending = false;
        }
    }
    private async Task SendQueuedMessageNowAsync(Guid id)
    {
        if (_selectedProject is null || _selectedChat is null || _queueActionPending) return;
        _queueActionPending = true;
        _sendingQueuedNowId = id;
        _optimisticallyHiddenQueueIds.Add(id);
        try
        {
            await RunQueueCommandAsync(() => ChatRunsApi.SendQueuedNowAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), id, Guid.CreateVersion7(), CancellationToken.None));
        }
        finally
        {
            _optimisticallyHiddenQueueIds.Remove(id);
            _sendingQueuedNowId = null;
            _queueActionPending = false;
        }
    }

    /// <summary>
    /// Runs one queue command and makes its outcome visible. A refusal carries the server's own
    /// reason - "this message has already been sent", "the branch changed" - and showing it is the
    /// whole point: these buttons used to fail silently, leaving no way to tell a refusal from a
    /// no-op. A null snapshot means the run itself is gone, which needs no announcement.
    /// </summary>
    private async Task RunQueueCommandAsync(Func<Task<ChatRunSnapshot?>> command)
    {
        try
        {
            if (await command() is { } snapshot) StoreRun(snapshot);
        }
        catch (Exception error) when (error is InvalidOperationException or HttpRequestException)
        {
            Notifications.ShowError(error.Message);
        }
    }
    private Task ResumeQueueAsync() => _selectedProject is null || _selectedChat is null ? Task.CompletedTask
        : RunQueueCommandAsync(() => ChatRunsApi.ResumeAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), Guid.CreateVersion7(), CancellationToken.None));
    private Task SkipFailedQueueAsync() => _selectedProject is null || _selectedChat is null ? Task.CompletedTask
        : RunQueueCommandAsync(() => ChatRunsApi.SkipFailedAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), Guid.CreateVersion7(), CancellationToken.None));
    private Task RebaseQueueAsync() => _selectedProject is null || _selectedChat is null ? Task.CompletedTask
        : RunQueueCommandAsync(() => ChatRunsApi.RebaseAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), Guid.CreateVersion7(), CancellationToken.None));
    private async Task ClearQueueAsync()
    {
        if (_selectedProject is null || _selectedChat is null || _queueActionPending) return;
        _queueActionPending = true;
        _hidePendingQueue = true;
        try
        {
            await RunQueueCommandAsync(() => ChatRunsApi.ClearAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), Guid.CreateVersion7(), CancellationToken.None));
        }
        finally
        {
            _hidePendingQueue = false;
            _queueActionPending = false;
        }
    }
    private async Task ClearEverythingAsync()
    {
        _isConfirmingQueueClearAll = false;
        if (_selectedProject is null || _selectedChat is null || _queueActionPending) return;
        _queueActionPending = true;
        _hidePendingQueue = true;
        _isClearingEverything = true;
        try
        {
            await RunQueueCommandAsync(() => ChatRunsApi.ClearAllAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId(), Guid.CreateVersion7(), CancellationToken.None));
        }
        finally
        {
            _hidePendingQueue = false;
            _isClearingEverything = false;
            _queueActionPending = false;
