    private async Task<bool> MoveItemAsync<T>(List<T> items, Guid id, int direction, string orderKey, Func<T, Guid> idSelector)
    {
        var currentIndex = items.FindIndex(item => idSelector(item) == id);
        var targetIndex = currentIndex + direction;
        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= items.Count)
        {
            return false;
        }

        var item = items[currentIndex];
        items.RemoveAt(currentIndex);
        items.Insert(targetIndex, item);
        await SaveOrderAsync(orderKey, items.Select(idSelector));
        return true;
    }

    private static string GetMoveDirection(int direction) => direction < 0 ? "up" : "down";

    /// <summary>Dropping a chat onto another only ever pins/unpins it to match the target's zone — the
    /// list itself always follows the server's pinned-then-recent order, so there is nothing else to persist.</summary>
    private async Task OnChatDrop(ChatSummary targetChat)
    {
        var draggedId = _draggedChatId;
        _draggedChatId = null;
        if (draggedId is not { } id || id == targetChat.Id || _selectedProject is null)
        {
            return;
        }

        var dragged = _chats.Find(c => c.Id == id);
        if (dragged is null || dragged.IsPinned == targetChat.IsPinned)
        {
            return;
        }

        var updated = await ChatHistoryApi.PinAsync(_selectedProject.Id, dragged.Id, new PinChatRequest(targetChat.IsPinned, dragged.Revision), CancellationToken.None);
        if (updated is null)
        {
            Notifications.ShowError("Chat pin state was not saved. Reload and try again.");
            return;
        }

        var index = _chats.FindIndex(item => item.Id == id);
        _chats[index] = updated;
    }

    private const string ProjectOrderKey = "ai-client.project-order.v1";

    private async Task ApplyProjectOrderAsync()
    {
        var order = await LoadOrderAsync(ProjectOrderKey);
        if (order.Count == 0)
        {
            return;
        }

        var ordered = ApplyOrder(_projects, order, p => p.Id);
        _projects.Clear();
        _projects.AddRange(ordered);
    }

    private async Task<List<Guid>> LoadOrderAsync(string key)
    {
        try
        {
            var json = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", key);
            return string.IsNullOrEmpty(json) ? [] : JsonSerializer.Deserialize<List<Guid>>(json) ?? [];
        }
        catch (JsonException)
        {
            return [];
        }
    }

    private Task SaveOrderAsync(string key, IEnumerable<Guid> ids) =>
        JsRuntime.InvokeVoidAsync("localStorage.setItem", key, JsonSerializer.Serialize(ids)).AsTask();

    private static List<T> ApplyOrder<T>(IReadOnlyList<T> items, List<Guid> order, Func<T, Guid> idSelector)
    {
        var byId = items.ToDictionary(idSelector);
        var result = new List<T>(items.Count);
        var used = new HashSet<Guid>();
        foreach (var id in order)
        {
            if (byId.TryGetValue(id, out var item) && used.Add(id))
            {
                result.Add(item);
            }
        }

        result.AddRange(items.Where(item => used.Add(idSelector(item))));
        return result;
    }

