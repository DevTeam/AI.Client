    private async Task LoadChatsAsync(Guid projectId, bool refreshSelected = true)
    {
        var chats = await ChatHistoryApi.ListAsync(projectId, CancellationToken.None);
        ChatsBusy.End();
        if (_selectedProject?.Id != projectId) return;
        if (_chatPagingProjectId != projectId)
        {
            _chatPagingProjectId = projectId;
            _visibleChatCount = ChatPageSize;
        }

        _deferredChats = null;
        _chats.Clear();
        _chats.AddRange(chats);
        await CheckArchiveSuggestionsAsync();

        // Every save moves the chat's revision, and a run's messages reach the open chat with its
        // snapshots: when the list says the copy here is current, the reload brought the same chat
        // with every message as a new object, and the transcript redrew all of its turns for it on
        // each step of a run.
        if (refreshSelected && _selectedChat is { } selected
            && chats.SingleOrDefault(item => item.Id == selected.Id)?.Revision != selected.Revision)
        {
            var refreshed = await ChatHistoryApi.GetTranscriptAsync(projectId, selected.Id, CancellationToken.None);
            if (_selectedChat?.Id == selected.Id && refreshed is not null && refreshed.Revision >= _selectedChat.Revision)
                _selectedChat = refreshed;
        }
    }

