    // The Host signals that application data changed without saying what, because a tool can touch
    // anything the user can. So this re-reads what is currently on screen — the project list, the
    // selected project's chats, the open chat — and leaves the selection alone unless the thing
    // that was selected is gone.
    [JSInvokable]
    public async Task OnApplicationDataChanged()
    {
        try
        {
            var projects = await ProjectApi.ListAsync(CancellationToken.None);
            _projects.Clear();
            _projects.AddRange(projects);
            await ApplyProjectOrderAsync();
            if (_selectedProject is { } selected)
            {
                if (_projects.SingleOrDefault(item => item.Id == selected.Id) is not { } refreshed)
                {
                    // The open project was deleted; fall back to whatever is left.
                    await LoadProjectsAsync();
                    return;
                }

                _selectedProject = refreshed;
                await LoadChatsAsync(selected.Id);
                // A model may have changed the project's directories; the sidebar and the access icons
                // on message links both follow them.
                await LoadSecurityAsync(selected.Id);
                if (_selectedChat is { } chat && _chats.All(item => item.Id != chat.Id)) _selectedChat = null;
            }
        }
        catch (HttpRequestException)
        {
            // A reload that cannot reach the Host is not worth reporting: the run event stream is
            // about to report the same outage far more visibly.
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    private AI.Web.Navigation.NavigationCue? _navigationCue;
    private AI.Web.Navigation.NavigationArrival? _navigationArrival;
    private CancellationTokenSource? _navigationCountdown;
    private IJSObjectReference? _navigationCueModule;

    /// <summary>Typing or scrolling this recently means the user is busy with what is on screen.</summary>
    private const int NavigationQuietMs = 2_500;

    // A model asked to show the user a place, usually one it has just created: a project and its first
    // chat, a continuation chat, a new branch. Taking the window without a word surprised people, so
    // the move is announced first. It happens on its own only while the window shows the chat that
    // asked and the user is not busy there, after a short countdown with a pointer travelling to
    // the row it opens; otherwise it is only offered. The lists are re-read first because that place
    // may be younger than the data-changed signal that announces it.
    [JSInvokable]
    public async Task OnNavigateRequested(string json)
    {
        var target = JsonSerializer.Deserialize<AI.Contracts.Navigation.AppNavigation>(json,
            new JsonSerializerOptions(JsonSerializerDefaults.Web));
        if (target is null) return;
        if (target.RequestId != Guid.Empty || target.Target is not null)
        {
            await HandleGuideNavigationAsync(target);
            return;
        }
        try
        {
            var projects = await ProjectApi.ListAsync(CancellationToken.None);
            _projects.Clear();
            _projects.AddRange(projects);
            await ApplyProjectOrderAsync();
            if (_selectedProject?.Id == target.ProjectId) await LoadChatsAsync(target.ProjectId);
        }
        catch (HttpRequestException)
        {
            // Unreachable Host: the event stream reports the outage itself.
            return;
        }

        var module = await NavigationCueModuleAsync();
        var busy = await module.InvokeAsync<bool>("isUserBusy", NavigationQuietMs);
        CancelNavigationCountdown();
        var cue = NavigationCues.Decide(target, _selectedChat?.Id, busy, GetWorkspaceLocation());
        _navigationCue = cue;
        _navigationArrival = null;
        await InvokeAsync(StateHasChanged);
        if (cue.Automatic) await CountDownToNavigationAsync(cue);
    }

    private async Task<IJSObjectReference> NavigationCueModuleAsync() =>
        _navigationCueModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/navigationCue.js");

    private void CancelNavigationCountdown()
    {
        _navigationCountdown?.Cancel();
        _navigationCountdown?.Dispose();
        _navigationCountdown = null;
    }

    private async Task CountDownToNavigationAsync(AI.Web.Navigation.NavigationCue cue)
    {
        var countdown = new CancellationTokenSource();
        _navigationCountdown = countdown;
        var module = await NavigationCueModuleAsync();
        // After the render that lists a chat created a moment ago, so the pointer can find its row.
        await Task.Delay(50);
        await module.InvokeVoidAsync("playCursor", cue.Target.ProjectId.ToString(), cue.Target.ChatId?.ToString(),
            cue.SecondsLeft * 1000);
        try
        {
            for (var left = cue.SecondsLeft; left > 0; left--)
            {
                if (_navigationCue?.Id != cue.Id) return;
                _navigationCue = cue with { SecondsLeft = left };
                await InvokeAsync(StateHasChanged);
                await Task.Delay(1000, countdown.Token);
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        if (_navigationCue?.Id != cue.Id) return;
        // The user may have moved on or started typing during the countdown: the move becomes an offer.
        if (_selectedChat?.Id != cue.Target.SourceChatId || await module.InvokeAsync<bool>("isUserBusy", 1_000))
        {
            await module.InvokeVoidAsync("cancelCursor");
            _navigationCue = cue with { Automatic = false };
            await InvokeAsync(StateHasChanged);
            return;
        }
        await FollowNavigationCueAsync(cue);
    }

    private async Task FollowNavigationCueAsync(AI.Web.Navigation.NavigationCue cue)
    {
        if (_navigationCue?.Id != cue.Id) return;
        CancelNavigationCountdown();
        _navigationCue = null;
        var target = cue.Target;
        try
        {
            await NavigateToTargetAsync(new WorkspaceTarget(target.ProjectId, target.ChatId, target.BranchId, null, false));
            await SyncWorkspaceUrlAsync();
        }
        catch (HttpRequestException)
        {
            return;
        }
        var arrival = new AI.Web.Navigation.NavigationArrival(Guid.NewGuid(), cue.From, cue.Where);
        _navigationArrival = arrival;
        await InvokeAsync(StateHasChanged);
        // After the render that shows the target's row, so there is a row to mark.
        await Task.Delay(50);
        await (await NavigationCueModuleAsync()).InvokeVoidAsync("highlightArrival", target.ProjectId.ToString(),
            target.ChatId?.ToString());
        await Task.Delay(NavigationCues.ArrivalNoteDuration);
        if (_navigationArrival?.Id != arrival.Id) return;
        _navigationArrival = null;
        await InvokeAsync(StateHasChanged);
    }

    // Declining keeps the place findable: it goes into the notifications, which open it on a click.
    private async Task StayOnNavigationCue()
    {
        CancelNavigationCountdown();
        if (_navigationCue is not { } cue) return;
        _navigationCue = null;
        if (_navigationCueModule is not null) await _navigationCueModule.InvokeVoidAsync("cancelCursor");
        if (cue.Target.ChatId is { } chatId)
            Notifications.ShowChatEvent($"The assistant created {cue.Where}", NotificationKind.Info, cue.Target.ProjectId,
                chatId, cue.Target.BranchId ?? chatId);
    }

    private async Task ReturnFromNavigationAsync()
    {
        _navigationArrival = null;
        await GoBackAsync();
    }

    private static readonly JsonSerializerOptions RunSnapshotJsonOptions = new(JsonSerializerDefaults.Web);

    /// <summary>
    /// The run frames that arrived since the last call, oldest first. Each is a change against the
    /// one before it, so all are applied; the page is drawn once for the lot, and not at all when
    /// they only carried text for chats that are not on screen — those show nothing of it.
    /// </summary>
    [JSInvokable]
    public async Task OnRunSnapshots(string[] frames)
    {
        var chatOrderChanged = false;
        var visible = false;
        foreach (var json in frames)
        {
            var update = JsonSerializer.Deserialize<ChatRunSnapshotUpdate>(json, RunSnapshotJsonOptions);
            if (update is null) continue;
            visible |= update.IsFull || update.Runs.Count > 0 || update.Removed.Count > 0
                || update.StreamingAppends.Any(append => append.ChatId == _selectedChat?.Id)
                || update.DraftAppends?.Any(append => append.ChatId == _selectedChat?.Id) == true;
            chatOrderChanged |= await ApplyRunSnapshotAsync(update);
        }
        if (chatOrderChanged) await RefreshChatOrderAsync();
        if (visible || chatOrderChanged) await InvokeAsync(StateHasChanged);
    }

    /// <summary>Applies one run frame; returns whether a chat moved in the sidebar.</summary>
    private async Task<bool> ApplyRunSnapshotAsync(ChatRunSnapshotUpdate update)
    {
        var snapshots = update.Runs;
        if (update.KeptWorkspaceChanges is { Count: > 0 } kept)
        {
            var keys = kept.Select(key => new RunKey(key.ChatId, key.BranchId)).ToHashSet();
            snapshots = snapshots.Select(run => keys.Contains(new RunKey(run.ChatId, run.BranchId))
                ? run with { WorkspaceChanges = RunState.Runs.GetValueOrDefault(new RunKey(run.ChatId, run.BranchId))?.WorkspaceChanges }
                : run).ToArray();
        }

        if (update.IsFull) RunState.RemoveMissing(snapshots);
        else RunState.Remove(update.Removed);
        RunState.AppendStreaming(update.StreamingAppends);
        RunState.AppendDraft(update.DraftAppends ?? []);

        var appendedKeys = update.StreamingAppends.Select(append => new RunKey(append.ChatId, append.BranchId))
            .Concat((update.DraftAppends ?? []).Select(append => new RunKey(append.ChatId, append.BranchId)))
            .Distinct();
        var updatedSnapshots = snapshots.Concat(appendedKeys.Select(key => RunState.Runs.GetValueOrDefault(key)).OfType<ChatRunSnapshot>());
        var chatOrderChanged = false;
        foreach (var snapshot in updatedSnapshots)
        {
            var previous = GetRun(snapshot.ChatId, snapshot.BranchId);
            chatOrderChanged |= MovesChatInList(previous, snapshot);
            await ShowRunNotificationAsync(previous, snapshot);
            StoreRun(snapshot);
            if (snapshot.ChatId == _selectedChat?.Id)
            {
                // Not a scroll-to-bottom: the run producing output is not a reason to yank the
                // user away from whatever they scrolled up to read.
                if (IsCurrentRun(snapshot.ChatId, snapshot.BranchId)) _followNewMessages = true;
                if (snapshot.ChatRevision > _selectedChat.Revision && _selectedProject is not null)
                {
                    if (ChatMessageDeltaMerger.TryApply(_selectedChat, snapshot, out var updatedChat))
                    {
                        _selectedChat = updatedChat;
                        CacheChatDetails(updatedChat);
                    }
                    else
                    {
                        _selectedChat = await ChatHistoryApi.GetTranscriptAsync(_selectedProject.Id, snapshot.ChatId, CancellationToken.None);
                        if (_selectedChat is not null) CacheChatDetails(_selectedChat);
                        await LoadChatsAsync(_selectedProject.Id, refreshSelected: false);
                    }
                }
                // Selection can change while the transcript reload is awaiting its response.
                // Only the branch still selected may advance the visible transcript.
                if (IsCurrentRun(snapshot.ChatId, snapshot.BranchId) && _selectedChat?.Branches?.SingleOrDefault(branch => branch.Id == snapshot.BranchId)?.HeadMessageId is { } head)
                    _branchLeafId = head;
            }

            // Mark the just-arrived leaf for the transient accent line. We only animate when a run
            // crosses from Generating into a non-generating state AND the chat revision actually
            // bumped (so a stale push without a new message doesn't re-trigger), and only on the
            // currently selected chat so we don't draw lines on a chat the user isn't looking at.
            _wasGeneratingByBranch.TryGetValue(snapshot.BranchId, out var wasGenerating);
            var isGenerating = snapshot.Status == ChatRunStatus.Generating;
            if (wasGenerating && !isGenerating
                && snapshot.ChatId == _selectedChat?.Id
                && snapshot.ChatRevision > 0
                && _selectedChat is { } chatForArrival
                && chatForArrival.Revision > 0)
            {
                var arrivedHead = _selectedChat?.Branches?.SingleOrDefault(branch => branch.Id == snapshot.BranchId)?.HeadMessageId;
                if (arrivedHead is { } headId && headId == _branchLeafId) SetJustArrivedLeaf(headId);
            }
            if (wasGenerating && !isGenerating) _ = RefreshChatUsageAfterTurnAsync(snapshot.ChatId);
            _wasGeneratingByBranch[snapshot.BranchId] = isGenerating;
            var summaries = snapshot.TurnUsage?.ByPurpose
                .Where(slice => slice.Key is nameof(TokenUsagePurpose.Compaction) or nameof(TokenUsagePurpose.Checkpoint))
                .Sum(slice => slice.Totals.Requests) ?? 0;
            if (summaries > _summariesByBranch.GetValueOrDefault(snapshot.BranchId) && isGenerating)
                _ = RefreshChatUsageAfterSummaryAsync(snapshot.ChatId);
            _summariesByBranch[snapshot.BranchId] = summaries;
        }
        return chatOrderChanged;
    }

    /// <summary>
    /// Whether this run event is one of the moments that lift a chat in the sidebar: a message
    /// started a run, or the run ended with a reply, a pause or a failure. Tool steps in between
    /// do not count, which is also what the Host records as the chat's activity.
    /// </summary>
    private bool MovesChatInList(ChatRunSnapshot? previous, ChatRunSnapshot current)
    {
        if (_selectedProject?.Id != current.ProjectId) return false;
        if (_chats.All(chat => chat.Id != current.ChatId)) return true;
        if (previous is null || previous.Status == current.Status) return false;
        return current.Status == ChatRunStatus.Generating || previous.Status == ChatRunStatus.Generating
            || current.Status == ChatRunStatus.Failed;
    }

    /// <summary>
    /// Re-reads the order of the chat list after activity elsewhere. While the user is pointing at
    /// the list or dragging a chat the new order waits, and it is applied the moment they stop.
    /// </summary>
    private async Task RefreshChatOrderAsync()
    {
        if (_selectedProject is not { } project) return;
        IReadOnlyList<ChatSummary> chats;
        try { chats = await ChatHistoryApi.ListAsync(project.Id, CancellationToken.None); }
        catch (HttpRequestException) { return; }
        if (_selectedProject?.Id != project.Id) return;
        if (_isChatDragActive || _isChatListHovered)
        {
            _deferredChats = chats;
            return;
        }

        await ApplyChatOrderAsync(chats);
    }

    private async Task ApplyChatOrderAsync(IReadOnlyList<ChatSummary> chats)
    {
        _deferredChats = null;
        if (_chatListDragHandle is not null && !_chats.Select(chat => chat.Id).SequenceEqual(chats.Select(chat => chat.Id)))
        {
            await _chatListDragHandle.InvokeVoidAsync("capturePositions");
            _playChatListMove = true;
        }

        _chats.Clear();
        _chats.AddRange(chats);
    }

    private async Task ApplyDeferredChatOrderAsync()
    {
        if (_deferredChats is not { } chats || _isChatDragActive || _isChatListHovered) return;
        await ApplyChatOrderAsync(chats);
        StateHasChanged();
    }

    // Touch has no hover: a finger lifting off the list must not count as the pointer leaving it
    // with a reorder waiting, or the list would move under the tap it just made.
    private void OnChatListPointerEnter(PointerEventArgs args)
    {
        if (args.PointerType == "mouse") _isChatListHovered = true;
    }

    private async Task OnChatListPointerLeave(PointerEventArgs args)
    {
        _isChatListHovered = false;
        await ApplyDeferredChatOrderAsync();
    }

    [JSInvokable]
    public async Task OnChatDragStateChanged(bool isActive)
    {
        _isChatDragActive = isActive;
        if (!isActive) await ApplyDeferredChatOrderAsync();
        StateHasChanged();
    }

    /// <summary>
    /// A chat was dropped. Inside the pinned zone it takes the place in front of
    /// <paramref name="beforeChatId"/> (last when null), pinning it if it was not; anywhere below
    /// the zone it is unpinned and goes back to its place by activity.
    /// </summary>
    [JSInvokable]
    public async Task OnChatDropped(string chatId, bool pinned, string? beforeChatId)
    {
        if (!Guid.TryParse(chatId, out var id) || _chats.Find(chat => chat.Id == id) is not { } chat) return;
        Guid? before = Guid.TryParse(beforeChatId, out var beforeId) ? beforeId : null;
        if (await PinChatAsync(chat, pinned, before))
            _sidebarAnnouncement = pinned == chat.IsPinned ? $"Moved chat {chat.Title}."
                : pinned ? $"Pinned chat {chat.Title}." : $"Unpinned chat {chat.Title}.";
        StateHasChanged();
    }

    private async Task ShowRunNotificationAsync(ChatRunSnapshot? previous, ChatRunSnapshot current)
    {
        if (!current.ShowInMainRuns) return;
        if (!StatusPresentation.NeedsAttention(current) && current.Status != ChatRunStatus.Failed)
            Notifications.ResolveChatAttention(current.ChatId, current.BranchId);
        if (!_workspaceInitialized || previous is null || current.Revision <= previous.Revision) return;

        var visibleHere = _applicationFocused && _selectedChat?.Id == current.ChatId
            && GetSelectedRunBranchId() == current.BranchId;
        string? title = null;
        var kind = NotificationKind.Info;
        var requiresAction = false;
        Guid? messageId = null;

        if (current.PendingApproval is { } approval && previous?.PendingApproval?.Id != approval.Id)
        {
            if (!visibleHere) { title = "Tool approval needed"; requiresAction = true; }
        }
        else if (current.PendingPrompt is { } prompt && previous?.PendingPrompt?.Id != prompt.Id)
        {
            if (!visibleHere) { title = "Your answer needed"; requiresAction = true; }
        }
        else if (current.Status == ChatRunStatus.Failed && previous?.Status != ChatRunStatus.Failed)
        {
            title = "Run failed";
            kind = NotificationKind.Error;
            requiresAction = true;
        }
        else if (current.Status is ChatRunStatus.Paused or ChatRunStatus.Interrupted && previous?.Status != current.Status)
        {
            if (!visibleHere) { title = $"Run {current.Status.ToString().ToLowerInvariant()}"; requiresAction = true; }
        }
        else if (current.Status == ChatRunStatus.Completed && previous?.Status == ChatRunStatus.Generating
            && current.HasUnreadResponse && !visibleHere)
        {
            title = "Reply ready";
            kind = NotificationKind.Success;
            messageId = current.HeadMessageId;
        }

        if (title is null) return;
        var location = await GetNotificationLocationAsync(current);
        Notifications.ShowChatEvent($"{title} · {location}", kind, current.ProjectId, current.ChatId,
            current.BranchId, requiresAction, messageId);
    }

    private async Task<string> GetNotificationLocationAsync(ChatRunSnapshot run)
    {
        var projectName = _projects.FirstOrDefault(project => project.Id == run.ProjectId)?.Name ?? "Project";
        var chatName = _selectedChat?.Id == run.ChatId ? _selectedChat.Title
            : _chats.FirstOrDefault(chat => chat.Id == run.ChatId)?.Title
            ?? _chatDetailsCache.GetValueOrDefault(run.ChatId)?.Title;
        if (chatName is null && !_notificationChatTitles.TryGetValue(run.ChatId, out chatName))
        {
            try
            {
                foreach (var chat in await ChatHistoryApi.ListAsync(run.ProjectId, CancellationToken.None))
                    _notificationChatTitles[chat.Id] = chat.Title;
                _notificationChatTitles.TryGetValue(run.ChatId, out chatName);
            }
            catch (HttpRequestException) { /* The event still links to the chat by ID. */ }
        }
        return $"{projectName} / {chatName ?? $"Chat {run.ChatId.ToString("N")[..8]}"}";
    }

    // Single entry point for the transient accent-line marker: setting it also schedules the clear,
    // and cancels whatever clear was already pending, so a restart can't be cut short by a stale timer.
    private void SetJustArrivedLeaf(Guid? leafId)
    {
        _justArrivedLeafCancellation?.Cancel();
        _justArrivedLeafCancellation?.Dispose();
        _justArrivedLeafCancellation = null;
        _justArrivedLeafId = leafId;
        if (leafId is null) return;

        var cancellation = new CancellationTokenSource();
        _justArrivedLeafCancellation = cancellation;
        _ = ClearJustArrivedLeafIdAsync(leafId.Value, cancellation.Token);
    }

    // Drops the class once the animation has played out; subsequent renders then take the fast
    // path through MessageFeed's ShouldRender.
    private async Task ClearJustArrivedLeafIdAsync(Guid arrived, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(BranchLeafLineLifetime, cancellationToken);
        }
        catch (OperationCanceledException) { return; }
        if (_justArrivedLeafId == arrived)
        {
            _justArrivedLeafId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task OnApplicationFocusChanged(bool focused)
    {
        _applicationFocused = focused;
        if (focused) await MarkSelectedConversationReadAsync();
    }

    private static Task HandleComposerKeyDown(KeyboardEventArgs args) => Task.CompletedTask;

    private void BeginProjectCreation()
    {
        CancelInlineEdit();
        _isCreatingProject = true;
        _newProjectName = string.Empty;
        _focusEditingInputPending = true;
        CloseContextMenus();
    }

    private async Task SaveNewProjectAsync()
    {
        if (!_isCreatingProject || _isCompletingInlineEdit) return;
        var name = _newProjectName.Trim();
        if (string.IsNullOrEmpty(name))
        {
            CancelInlineEdit();
            return;
        }

        _isCompletingInlineEdit = true;
        try
        {
            var project = await ProjectApi.CreateAsync(new CreateProjectRequest(name, string.Empty), CancellationToken.None);
            await LoadProjectsAsync(project.Id);
            Notifications.ShowSuccess("Project created.");
        }
        catch (HttpRequestException)
        {
            _error = "The local gateway is unavailable.";
        }
        finally
        {
            _isCompletingInlineEdit = false;
            CancelInlineEdit();
        }
    }

    private async Task HandleNewProjectKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CancelInlineEdit();
        }
        else if (args.Key == "Enter")
        {
            await SaveNewProjectAsync();
        }
    }

    private async Task HandleProjectItemClickAsync(ProjectSummary project)
    {
        // Re-clicking the open project is a shortcut for its "new chat" composer: reload
        // chats so anything created elsewhere shows up, but keep the chat/branch picker on
        // the empty entry and preserve any draft the user was typing for a new chat in this
        // project. Switching between projects is the path that restores the chat/branch the
        // user last left on — without that, flipping from A → B → A would leave A empty even
        // when there was a conversation in progress.
        await SelectProjectAsync(project, restoreLastChat: _selectedProject?.Id != project.Id);
    }

    private async Task SelectProjectAsync(ProjectSummary project, bool restoreLastChat = true)
    {
        await CloseReviewAsync();
        _reviewChat = null;
        _projectSelectionCancellation?.Cancel();
        _projectSelectionCancellation?.Dispose();
        var projectSelection = new CancellationTokenSource();
        _projectSelectionCancellation = projectSelection;
        var cancellation = projectSelection.Token;

        // Start independent I/O before changing the selection. The remembered chat and the
        // previous project's selection can be saved alongside the destination reads.
        var saveContextTask = _selectedProject is { } currentProject && currentProject.Id != project.Id
            ? WorkspaceStateService.SetProjectContextAsync(currentProject.Id, _selectedChat?.Id,
                _branchLeafId, _selectedBranchId)
            : Task.CompletedTask;
        var context = restoreLastChat ? WorkspaceStateService.GetProjectContext(project.Id) : default;
        var saveScrollTask = SaveCurrentScrollPositionAsync();
        var flushDraftTask = WorkspaceStateService.FlushPendingComposerDraftAsync();
        var projectDetailsTask = ProjectApi.GetAsync(project.Id, cancellation);
        var chatsTask = ChatHistoryApi.ListAsync(project.Id, cancellation);
        var rememberedChatTask = context.ChatId is { } rememberedChatId
            ? ChatHistoryApi.GetTranscriptAsync(project.Id, rememberedChatId, cancellation)
            : null;

        try
        {
            var reads = rememberedChatTask is null
                ? new Task[] { saveContextTask, saveScrollTask, flushDraftTask, projectDetailsTask, chatsTask }
                : [saveContextTask, saveScrollTask, flushDraftTask, projectDetailsTask, chatsTask, rememberedChatTask];
            await Task.WhenAll(reads);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            return;
        }

        if (cancellation.IsCancellationRequested
            || !ReferenceEquals(_projectSelectionCancellation, projectSelection)) return;

        var details = await projectDetailsTask;
        if (details is null)
        {
            return;
        }

        var chats = await chatsTask;
        var rememberedChat = rememberedChatTask is null ? null : await rememberedChatTask;
        if (rememberedChat is not null) CacheChatDetails(rememberedChat);

        // Publish the destination as one coherent state. Previously the new project and a null
        // chat were rendered before these reads completed, so every switch visibly flashed the
        // empty composer and only then restored the remembered transcript.
        _attachComposer = true;
        ResetBranchOperationState();
        CancelChatSelection();
        _selectedProject = project;
        CloseFilePreview();
        _isProjectMenuOpen = false;
        _isProjectSettingsOpen = false;
        _isConfirmingProjectDelete = false;
        _chatMenuId = null;
        _branchMenuId = null;
        _isConfirmingChatDelete = false;
        _directoryMenuId = null;
        _isConfirmingDirectoryDelete = false;
        SetJustArrivedLeaf(null);
        _wasGeneratingByBranch.Clear();
        _error = null;

        _security = ProjectSecurityEditor.From(details);
        _editor = new ProjectEditor(project.Name, project.Description, project.Revision);
        // A null 'ConnectionId' on the stored project means "follow the global default", so we
        // mirror that here instead of substituting the default's id — the user must opt in to a
        // concrete connection by picking one in the drawer, otherwise the project keeps
        // following whatever the global default is at the moment a new chat is created.
        _editor.ConnectionId = details.ConnectionId;
        _defaultConnectionId = details.ConnectionId ?? GetDefaultConnection()?.Id;
        if (_defaultConnectionId is { } defaultId) SelectGlobalConnection(defaultId);
        else if (GetDefaultConnection() is { } defaultConnection) SelectGlobalConnection(defaultConnection.Id);

        _chatPagingProjectId = project.Id;
        _visibleChatCount = ChatPageSize;
        _chats.Clear();
        _chats.AddRange(chats);
        ChatsBusy.End();

        // restoreLastChat is true everywhere a user switches projects (sidebar click, initial
        // load, right-click menu). The narrow paths that pass false are the ones that
        // immediately follow up with a different selection — BeginProjectRenameAsync,
        // ToggleProjectMenuAsync, CreateChatForProjectAsync, OpenSearchMatchAsync — and so
        // would just throw away the restore work they asked for.
        if (context.ChatId is { } chatId
            && _chats.Any(chat => chat.Id == chatId)
            && rememberedChat?.Id == chatId)
        {
            ApplyRememberedChat(rememberedChat, context);
            await WorkspaceStateService.SetProjectContextAsync(project.Id, chatId,
                _branchLeafId, _selectedBranchId);
        }
        else
        {
            _selectedChat = null;
            _selectedBranchId = null;
            _branchLeafId = null;
            // The new-chat draft lives per project ("new:{projectId}"); restore it when no
            // remembered chat is available, so clicking a project never lands the user on a
            // composer that has forgotten the message they were typing for that project.
            RestoreComposerDraft();
        }

        await LoadReviewsAsync();
        await WorkspaceStateService.SetLastProjectIdAsync(project.Id);
    }

    private void ApplyRememberedChat(
        ChatDetails chat,
        (Guid? ChatId, Guid? BranchLeafId, Guid? BranchId) context)
    {
        _selectedChat = chat;
        var rememberedBranch = GetRememberedBranch(chat, context);
        _selectedBranchId = rememberedBranch?.Id ?? chat.Id;
        _branchLeafId = rememberedBranch?.HeadMessageId ?? GetOriginalBranchLeaf(chat);
        if (chat.ConnectionId is { } endpointId) SelectGlobalConnection(endpointId);
        RestoreComposerDraft();
        _pendingScrollRestoreKey = GetScrollPositionKey();
        _openedChatToSettle = (_selectedProject!.Id, chat.Id, GetSelectedRunBranchId());
    }

    private static ChatBranchView? GetRememberedBranch(ChatDetails chat,
        (Guid? ChatId, Guid? BranchLeafId, Guid? BranchId) context)
    {
        if (context.ChatId != chat.Id) return null;
        return context.BranchId is { } branchId
            ? chat.Branches?.FirstOrDefault(branch => branch.Id == branchId)
            : chat.Branches?.FirstOrDefault(branch => branch.HeadMessageId == context.BranchLeafId);
    }

    private async Task SaveProjectAsync()
    {
        if (_selectedProject is null)
        {
            return;
        }

        // 'UseDefaultConnection' is the explicit signal that a stored concrete connection should
        // be cleared and the project should once again follow the global default. Sending it
        // together with a null 'ConnectionId' only when the stored value was non-null avoids
        // accidentally re-sending the flag on every save.
        var useDefaultConnection = _editor.ConnectionId is null && _projectSettingsSnapshot.ConnectionId is not null;
        var connectionId = useDefaultConnection ? null : _editor.ConnectionId;
        var result = await ProjectApi.UpdateAsync(
            _selectedProject.Id,
            new UpdateProjectRequest(_editor.Name, _editor.Description, _editor.Revision, connectionId, useDefaultConnection),
            CancellationToken.None);
        if (result is { Status: ProjectUpdateStatus.Updated, Project: not null })
        {
            await LoadProjectsAsync(result.Project.Id);
            Notifications.ShowSuccess("Project saved.");
            await CloseProjectSettingsAsync();
            return;
        }

        _error = result.Status == ProjectUpdateStatus.Conflict
            ? "This project was changed elsewhere. Reload it before saving."
            : "This project no longer exists.";
    }

    private async Task DeleteProjectAsync()
    {
        if (_selectedProject is null)
        {
            return;
        }

        await _projectMutationGate.WaitAsync(CancellationToken.None);
        ProjectDeleteResult result;
        try
        {
            var current = await ProjectApi.GetAsync(_selectedProject.Id, CancellationToken.None);
            if (current is null)
            {
                _error = "This project no longer exists.";
                return;
            }
            result = await ProjectApi.DeleteAsync(_selectedProject.Id, current.Revision, CancellationToken.None);
        }
        finally
        {
            _projectMutationGate.Release();
        }
        if (result.IsDeleted)
        {
            await LoadProjectsAsync();
            _isProjectMenuOpen = false;
            _isProjectSettingsOpen = false;
            _isConfirmingProjectDelete = false;
            Notifications.ShowSuccess("Project deleted.");
            return;
        }

        _error = result.Revision > 0
            ? "This project was changed elsewhere. Reload it before deleting."
            : "This project no longer exists.";
    }

    private async Task LoadProjectsAsync(Guid? selectedId = null, bool restoreLastChat = true)
    {
        try
        {
            // Only when there is nothing to show: a refresh must not replace the list the user is
            // reading with placeholders.
            if (_projects.Count == 0) ProjectsBusy.Begin();
            _error = null;
            // Into a local first: clearing before the await emptied the sidebar for the length of
            // the request even when the list was about to come back unchanged.
            var projects = await ProjectApi.ListAsync(CancellationToken.None);
            _projects.Clear();
            _projects.AddRange(projects);
            await ApplyProjectOrderAsync();
            // The project list can be shown — and clicked — now. Its chats arrive later, under
            // their own placeholder, instead of holding this one up.
            ProjectsBusy.End();
            var project = selectedId is null
                ? _projects.FirstOrDefault()
                : _projects.SingleOrDefault(item => item.Id == selectedId) ?? _projects.FirstOrDefault();
            if (project is not null)
            {
                await SelectProjectAsync(project, restoreLastChat);
            }
            else
            {
                _selectedProject = null;
            }
        }
        catch (HttpRequestException)
        {
            _error = "The local gateway is unavailable.";
        }
        finally
        {
            ProjectsBusy.End();
            ChatsBusy.End();
        }
    }

    // The project and grants the message links were last checked against. Directories change from
    // the sidebar, the settings drawer, a link's own menu or a model's app_security call; comparing
    // after each render catches every one of them without each having to remember the links.
    private Guid? _fileLinkProjectId;
    private string _fileLinkGrants = string.Empty;

    private async Task SyncFileLinkAccessAsync()
    {
        var projectId = _selectedProject?.Id;
        var grants = string.Join('\n', _security.DirectoryGrants
            .Select(grant => $"{grant.CanonicalRoot}|{grant.Recursive}|{grant.ToolNames}")
            .Order(StringComparer.Ordinal));
        if (projectId == _fileLinkProjectId && grants == _fileLinkGrants) return;
        var sameProject = projectId == _fileLinkProjectId;
        _fileLinkProjectId = projectId;
        _fileLinkGrants = grants;
        // A switch of project is the feed's own business: it re-scopes its links when its chat changes.
        if (sameProject && _messageFeed is not null) await _messageFeed.RefreshFileLinksAsync();
    }

    private async Task LoadSecurityAsync(Guid id)
    {
        var project = await ProjectApi.GetAsync(id, CancellationToken.None);
        if (project is not null && _selectedProject?.Id == id)
        {
            _security = ProjectSecurityEditor.From(project);
            // The index behind the "@" list is built while the user is still reading, not on the first "@".
            _ = WarmMentionSearchAsync(id);
            _editor.ConnectionId = project.ConnectionId ?? GetDefaultConnection()?.Id;
            _defaultConnectionId = _editor.ConnectionId;
            if (_defaultConnectionId is { } defaultId)
            {
                SelectGlobalConnection(defaultId);
            }
            else
            {
                var defaultConnection = GetDefaultConnection();
                if (defaultConnection is not null) SelectGlobalConnection(defaultConnection.Id);
            }
            await LoadChatsAsync(id);
        }
    }

    /// <summary>
    /// A question is open, so what was typed is the answer to it.
    /// </summary>
    /// <remarks>
    /// Someone reading a question and writing underneath it means that as a reply, not as the next
    /// piece of work. Queueing it instead deadlocks the obvious thing to do: the run holds until
    /// the question times out, and the message they wrote is delivered a quarter of an hour after
    /// they wrote it. It answers the first question that takes free text; if none does — every
    /// question is a closed list — the message is an ordinary one and goes to the queue.
    /// </remarks>
    private async Task<bool> TryAnswerPendingPromptAsync(string text)
    {
        if (_isForking || _replaceSourceId is not null || _draftResources.Count > 0 || string.IsNullOrWhiteSpace(text)) return false;
        if (GetSelectedRun() is not { PendingPrompt: { } prompt } run) return false;
        if (prompt.Questions.FirstOrDefault(question => question.AllowOther) is not { } target) return false;
        if (!await ChatRunsApi.AnswerPromptAsync(run.ProjectId, run.ChatId, run.BranchId,
                new UserPromptResponse(prompt.Id, UserPromptOutcome.Answered,
                    [new UserPromptAnswer(target.Id, [], text.Trim())]), CancellationToken.None))
            // The question moved on while they were typing. Their text stays in the composer, so
            // nothing is lost and the next Enter sends it the ordinary way.
            return false;

        var draftKey = GetComposerDraftKey();
        _chat.Message = string.Empty;
        _composerHistoryNavigator.Reset();
        WorkspaceStateService.QueueComposerDraftSave(draftKey, string.Empty);
        return true;
    }

    private async Task SubmitComposerAsync(ComposerSubmitMode mode)
    {
        if (_isSubmittingMessage || !CanSendMessage()) return;
        // A message that starts a new chat has nothing to replace or fork from, whatever mode
        // the composer was left in.
        if (_selectedChat is null) ResetBranchOperationState();

        // An aside needs a conversation to join; the first message of a new chat is its first turn.
        var effectiveMode = _isForking ? ComposerSubmitMode.Fork
            : _replaceSourceId is not null ? ComposerSubmitMode.Send
            : mode == ComposerSubmitMode.Aside && _selectedChat is null ? ComposerSubmitMode.Send
            : mode;
        _isSubmittingMessage = true;
        _isSendingNowFromComposer = effectiveMode == ComposerSubmitMode.SendNow;
        _chatError = null;
        ComposerSubmitOutcome.Accepted? pendingUiUpdate = null;
        // Keep the key that owns the submitted text. A first message changes the current
        // key from "new:{projectId}" to the newly-created chat (and a branch submission can
        // advance its leaf) before ApplyAcceptedRunState clears the composer.
        var submittedDraftKey = GetComposerDraftKey();
        // Both are read before the submission moves the composer on: ApplyAcceptedRunState
        // clears the text, and a first message can change the selected project's chat underneath.
        var submittedText = _chat.Message;
        var submittedProjectId = _selectedProject?.Id;
        try
        {
            var corrected = await PrepareComposerSubmissionAsync();
            if (corrected is null || GetComposerDraftKey() != submittedDraftKey) return;
            _chat.Message = corrected;
            submittedText = corrected;
            if (await TryAnswerPendingPromptAsync(_chat.Message)) return;
            // The selected branch id remains stable while edit/fork modes temporarily move the
            // visible leaf to their parent. The server revalidates that branch atomically.
            var request = new ComposerSubmitRequest(
                effectiveMode,
                _selectedProject?.Id,
                _selectedChat,
                _branchLeafId,
                _forkSourceId,
                _replaceSourceId,
                _chat.CredentialProfileId,
                _chat.BaseUrl,
                _chat.Model,
                _chat.Message,
                GetSelectedRun(),
                _selectedChat is null ? null : GetSelectedRunBranchId(),
                SubmittedResources(),
                _newChatApprovalMode);

            var outcome = await Composer.SubmitAsync(request, CancellationToken.None);

            switch (outcome)
            {
                case ComposerSubmitOutcome.Rejected rejected:
                    _chatError = rejected.Reason;
                    return;
                case ComposerSubmitOutcome.Accepted accepted:
                    // ApplyAcceptedRunState runs (and StoreRun completes) BEFORE the guard is
                    // released in `finally` below — that's what makes GetSelectedRun() see this
                    // message's queue entry before a second, fast Ctrl+Enter can read the run
                    // cache. An earlier version of this guard released right after SubmitAsync
                    // returned but before StoreRun ran, leaving exactly that window open: two
                    // Ctrl+Enter presses in quick succession could both compute their enqueue
                    // anchor off the SAME stale (pre-StoreRun) run, silently forking the branch
                    // instead of queuing sequentially.
                    //
                    // FinishAcceptedUiUpdatesAsync (JS interop, sidebar refresh) is deliberately
                    // NOT awaited here, inside the guard — a subsequent fix held the guard
                    // through that too and it round-trips a real LoadChatsAsync network call,
                    // which was slow enough that a THIRD rapid Ctrl+Enter got silently dropped
                    // by the `_isSubmittingMessage` check above instead of being queued. None of
                    // that work affects what the next submission's GetSelectedRun() sees, so it
                    // runs after the guard drops.
                    ApplyAcceptedRunState(accepted, submittedDraftKey);
                    pendingUiUpdate = accepted;
                    _ = MarkTipsUsedAsync(effectiveMode, request.Resources);
                    break;
            }
        }
        catch (JSException error)
        {
            _chatError = $"Could not prepare the message: {error.Message}";
            return;
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _chatError = "The endpoint did not accept the request. Verify the base URL, model, and API key.";
            return;
        }
        finally
        {
            _isSubmittingMessage = false;
            _isSendingNowFromComposer = false;
        }

        if (pendingUiUpdate is not null)
        {
            // Only an accepted submission joins the history. A rejected one leaves its text in
            // the composer, and text the user can still see is not something to page back to.
            if (submittedProjectId is { } historyProjectId)
            {
                await WorkspaceStateService.AppendComposerHistoryAsync(historyProjectId, submittedText);
            }
            await FinishAcceptedUiUpdatesAsync(pendingUiUpdate);
        }
    }

    private void ApplyAcceptedRunState(ComposerSubmitOutcome.Accepted accepted, string submittedDraftKey)
    {
        // Accepted outcome is always safe to project onto component state: the service has
        // already persisted the chat, message and run. We just sync local UI state. Kept
        // synchronous (no JS interop, no network calls) so it finishes — and StoreRun's cache
        // update takes effect — before the submit guard in SubmitComposerAsync is released.
        if (_selectedChat?.Id != accepted.Chat.Id || _selectedChat.Revision < accepted.Chat.Revision) _selectedChat = accepted.Chat;
        _selectedBranchId = accepted.RunBranchId;
        StoreRun(accepted.Snapshot);
        // An aside on an idle branch is already in the transcript when the submission returns, and
        // the push carrying it may have arrived first; its own snapshot brings it in either way.
        if (accepted.Snapshot.ChatId == _selectedChat.Id && accepted.Snapshot.ChatRevision > _selectedChat.Revision
            && ChatMessageDeltaMerger.TryApply(_selectedChat, accepted.Snapshot, out var updatedChat))
        {
            _selectedChat = updatedChat;
            CacheChatDetails(updatedChat);
        }
        // A leaf the transcript does not hold yet would show an empty branch; the push moves it.
        if (accepted.UpdatedBranchLeafId is { } updatedLeaf && _selectedChat.Messages.Any(message => message.Id == updatedLeaf))
        {
            _branchLeafId = updatedLeaf;
        }
        _messageBranchMenuId = null;
        _forkSourceId = null;
        _isForking = false;
        _replaceSourceId = null;
        _chat.Message = string.Empty;
        _draftResources.Clear();
        _resourceDrafts.Remove(submittedDraftKey);
        _composerHistoryNavigator.Reset();
        // Clear the draft under its pre-submit key. GetComposerDraftKey() now points at the
        // accepted chat/branch, so using it here would leave the submitted new-chat text
        // stored under the project and restore it when the user returns to a fresh chat.
        WorkspaceStateService.QueueComposerDraftSave(submittedDraftKey, string.Empty);
    }

    private async Task FinishAcceptedUiUpdatesAsync(ComposerSubmitOutcome.Accepted accepted)
    {
        await WorkspaceStateService.SetProjectContextAsync(accepted.Chat.ProjectId, accepted.Chat.Id,
            _branchLeafId, _selectedBranchId);
        // The textarea's DOM value is independent from the bound _chat.Message — Blazor will
        // sync it on the next render, but for Queue mode the snapshot that triggers a render
        // doesn't always arrive (the dispatcher only Publishes when the worker actually
        // starts). Arm every after-render action BEFORE requesting that render: keyboard submits
        // arrive through JS interop and are not guaranteed a second automatic render after this
        // method returns. Requesting the render first could therefore rebuild a long transcript
        // at scrollTop 0 and never run the pending scroll-to-bottom action.
        _composerNeedsResize = true;
        _scrollMessagesToBottom = true;
        await InvokeAsync(StateHasChanged);
        if (_composerHandle is not null) await _composerHandle.InvokeVoidAsync("reset");

        // Refresh chat list in a guarded block so a transient failure (network blip,
        // revision conflict) doesn't roll back the projection already applied in
        // ApplyAcceptedRunState. The queue is already visible from accepted.Snapshot, so the
        // worst case is a stale sidebar that the next OnRunSnapshot event will fix.
        try
        {
            await LoadChatsAsync(accepted.Chat.ProjectId);
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            // The queue is visible from the snapshot — a stale sidebar isn't worth a render
            // failure. The next snapshot event will reconcile it.
        }
    }

