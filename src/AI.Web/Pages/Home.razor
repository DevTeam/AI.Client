    public async ValueTask DisposeAsync()
    {
        Notifications.Changed -= OnNotificationsChanged;
        Notifications.OpenRequested -= OnNotificationOpenRequested;
        Notifications.CenterRequested -= OnNotificationCenterRequested;
        CancelChatSelection();
        if (_projectSelectionCancellation is not null)
        {
            await _projectSelectionCancellation.CancelAsync();
            _projectSelectionCancellation.Dispose();
            _projectSelectionCancellation = null;
        }
        _projectsBusy?.Dispose();
        _chatsBusy?.Dispose();
        await _generatingTickerCancellation.CancelAsync();
        _generatingTickerCancellation.Dispose();

        if (_justArrivedLeafCancellation is not null)
        {
            await _justArrivedLeafCancellation.CancelAsync();
            _justArrivedLeafCancellation.Dispose();
        }

        await DisposeComposerHandleAsync();

        if (_resourceDropSubscription is not null) { await _resourceDropSubscription.InvokeVoidAsync("dispose"); await _resourceDropSubscription.DisposeAsync(); }
        if (_composerModule is not null)
        {
            await _composerModule.DisposeAsync();
        }

        if (_inlineEditorModule is not null)
        {
            await _inlineEditorModule.DisposeAsync();
        }

        if (_runEventsSubscription is not null) { await _runEventsSubscription.InvokeVoidAsync("dispose"); await _runEventsSubscription.DisposeAsync(); }
        if (_focusSubscription is not null) { await _focusSubscription.InvokeVoidAsync("dispose"); await _focusSubscription.DisposeAsync(); }
        if (_escapeSubscription is not null) { await _escapeSubscription.InvokeVoidAsync("dispose"); await _escapeSubscription.DisposeAsync(); }
        if (_drawerDismissSubscription is not null) { await _drawerDismissSubscription.InvokeVoidAsync("dispose"); await _drawerDismissSubscription.DisposeAsync(); }
        if (_queueDragSubscription is not null) { await _queueDragSubscription.InvokeVoidAsync("dispose"); await _queueDragSubscription.DisposeAsync(); }
        if (_runEventsModule is not null) await _runEventsModule.DisposeAsync();
        if (_navigationHandle is not null) { await _navigationHandle.InvokeVoidAsync("dispose"); await _navigationHandle.DisposeAsync(); }
        if (_navigationModule is not null) await _navigationModule.DisposeAsync();

        if (_scrollbarGutterHandle is not null) { await _scrollbarGutterHandle.InvokeVoidAsync("dispose"); await _scrollbarGutterHandle.DisposeAsync(); }
        if (_scrollbarGutterModule is not null) await _scrollbarGutterModule.DisposeAsync();

        _dotNetReference?.Dispose();
        await WorkspaceLayoutService.DisposeAsync();
    }
}
