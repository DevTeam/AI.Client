    [JSInvokable]
    public async Task OnEscapePressed()
    {
        if (_notificationsOpen)
        {
            await ToggleNotificationsAsync();
        }
        else if (_permissionsScope is not null)
        {
            ClosePermissions();
        }
        else if (_globalSection is not null)
        {
            await RequestCloseGlobalSettingsAsync();
        }
        else if (_isProjectSettingsOpen)
        {
            await RequestCloseProjectSettingsAsync();
        }
        else if (_reviewWorkspaceOpen)
        {
            await CloseReviewAsync();
        }
        else if (_isEndpointMenuOpen)
        {
            CloseEndpointMenu();
        }
        else if (_messageBranchMenuId is not null)
        {
            _messageBranchMenuId = null;
        }
        else if (_isProjectMenuOpen || _chatMenuId is not null || _branchMenuId is not null || _directoryMenuId is not null || _fileLinkMenu is not null)
        {
            CloseContextMenus();
        }
        else if (_isConfirmingQueueClearAll)
        {
            _isConfirmingQueueClearAll = false;
        }
        else if (_messageFeed?.CancelTransientUi() == true)
        {
            // The child invalidates its cached render; the parent render below schedules it.
        }
        else if (_replaceSourceId is not null || _isForking)
        {
            CancelBranchOperation();
        }
        else if (Notifications.Current is not null)
        {
            // Escape first dismisses the corner toast — pressing Escape a second time then falls
            // through to the rest of the handlers (close context menus, cancel branch op).
            Notifications.Dismiss();
            return;
        }
        else
        {
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

