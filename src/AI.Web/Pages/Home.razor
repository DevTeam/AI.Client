            var result = await ProjectApi.UpdateAsync(project.Id, new UpdateProjectRequest(_editingTitle.Trim(), details.Description, details.Revision, details.ConnectionId), CancellationToken.None);
            if (result.Status == ProjectUpdateStatus.Updated) await LoadProjectsAsync(project.Id);
