    private async Task OnProjectDrop(ProjectSummary targetProject)
    {
        var draggedId = _draggedProjectId;
        _draggedProjectId = null;
        if (draggedId is not { } id || id == targetProject.Id)
        {
            return;
        }

        var draggedIndex = _projects.FindIndex(p => p.Id == id);
        var targetIndex = _projects.FindIndex(p => p.Id == targetProject.Id);
        if (draggedIndex < 0 || targetIndex < 0)
