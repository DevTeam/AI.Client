    /// <summary>
    /// Walks the project's sent-message history: -1 towards older entries, +1 back towards newer
    /// ones and finally back to the draft the user started from. Returns null when the press
    /// changes nothing, so the JS side leaves the textarea untouched.
    /// </summary>
    [JSInvokable]
    public ComposerHistoryMove? MoveComposerHistory(int direction)
    {
        var history = GetComposerHistory();
        var text = direction < 0
            ? _composerHistoryNavigator.MoveOlder(history, _chat.Message)
            : _composerHistoryNavigator.MoveNewer(history);
        if (text is null) return null;
        // Deliberately not saved as a draft: browsing is transient, and persisting each entry the
        // user walks past would overwrite the unsent text they still expect to find here.
        _chat.Message = text;
        StateHasChanged();
        return new ComposerHistoryMove(text, _composerHistoryNavigator.IsActive);
    }

    /// <summary>Escape while browsing: puts the user's own text back.</summary>
    [JSInvokable]
    public string? ExitComposerHistory()
    {
        if (_composerHistoryNavigator.Exit() is not { } draft) return null;
        _chat.Message = draft;
        StateHasChanged();
        return draft;
    }

