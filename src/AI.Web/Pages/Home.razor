    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs args)
    {
        if (args.FileCount > 20)
        {
            Notifications.ShowError("Select at most 20 files at a time.");
            return;
        }
        foreach (var file in args.GetMultipleFiles(20))
        {
            try
            {
                await using var stream = file.OpenReadStream(15 * 1024 * 1024);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                await AttachFileAsync(buffer.ToArray(), file.Name, ChatResourceSource.Upload);
            }
            catch (Exception error) when (error is IOException or InvalidOperationException or HttpRequestException)
            { Notifications.ShowError($"Could not attach the file: {error.Message}"); }
        }
    }

