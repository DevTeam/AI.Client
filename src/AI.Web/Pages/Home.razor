    private async Task CheckArchiveSuggestionsAsync()
    {
        if (_selectedProject is not { } project || _archiveSuggestionLoading) return;
        if (_archiveSuggestionProject == project.Id && DateTimeOffset.UtcNow - _archiveSuggestionCheckedAt < TimeSpan.FromMinutes(5)) return;
        _archiveSuggestionLoading = true;
        try
        {
            _archiveModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/chatArchive.js");
            var state = await _archiveModule.InvokeAsync<JsonElement>("suggestionState", project.Id);
            _archiveSuggestionCount = 0; _archiveSuggestionProject = project.Id;
            _archiveSuggestionCheckedAt = DateTimeOffset.UtcNow;
            if (!state.TryGetProperty("enabled", out var enabled) || enabled.ValueKind != JsonValueKind.True) return;
            var preview = await ChatHistoryApi.PreviewArchiveAsync(project.Id, new(DateTimeOffset.UtcNow.AddDays(-30)), CancellationToken.None);
            if (_selectedProject?.Id != project.Id) return;
            _archiveSuggestionFingerprint = string.Join(",", preview.Chats.Select(chat => chat.Id).Order());
            if (state.TryGetProperty("dismissed", out var dismissed) && dismissed.GetString() == _archiveSuggestionFingerprint) return;
            _archiveSuggestionCount = preview.Chats.Count;
        }
        catch (Exception error) when (error is JSException or HttpRequestException) { _archiveSuggestionCount = 0; }
        finally { _archiveSuggestionLoading = false; }
    }

    private async Task DismissArchiveSuggestionAsync()
    {
        _archiveSuggestionCount = 0;
        if (_archiveModule is not null && _archiveSuggestionProject is { } projectId)
        {
            try { await _archiveModule.InvokeVoidAsync("dismissSuggestion", projectId, _archiveSuggestionFingerprint); }
            catch (JSException) { }
        }
    }

