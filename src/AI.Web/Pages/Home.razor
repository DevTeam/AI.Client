    {
        if (_archiveSaving) return;
        _archiveSaving = true; _chatMenuId = null;
        try
        {
            var result = await ChatHistoryApi.ArchiveAsync(projectId, request, CancellationToken.None);
            if (result.Skipped.Count > 0)
