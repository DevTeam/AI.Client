            var review = _reviews.FirstOrDefault(item => item.Id == reference.Id);
            if (review is null) { await LoadReviewsAsync(); review = _reviews.FirstOrDefault(item => item.Id == reference.Id); }
            if (review is not null && _messageFeed is not null)
                await _messageFeed.ScrollToMessageAsync(review.SourceMessageId);
            return;
        }
        await OpenReviewAsync(reference.Id);
    }

    private async Task RemoveMessageResourceAsync((Guid MessageId, Guid ResourceId) link)
    {
        if (_selectedProject is null || _selectedChat is null) return;
        var projectId = _selectedProject.Id;
        var chatId = _selectedChat.Id;
        try
        {
            var updated = await ChatHistoryApi.RemoveResourceReferenceAsync(projectId, chatId,
                link.MessageId, link.ResourceId, _selectedChat.Revision, CancellationToken.None);
            if (updated is null)
            {
                var current = await ChatHistoryApi.GetAsync(projectId, chatId, CancellationToken.None);
                if (current?.Messages.FirstOrDefault(item => item.Id == link.MessageId)?.Resources
                    ?.Any(item => item.Id == link.ResourceId) == true)
                    updated = await ChatHistoryApi.RemoveResourceReferenceAsync(projectId, chatId,
                        link.MessageId, link.ResourceId, current.Revision, CancellationToken.None);
                else updated = current;
            }
            if (updated is null) { _chatError = "The chat changed. Try removing the resource again."; return; }
            if (_selectedProject?.Id == projectId && _selectedChat?.Id == chatId)
            {
                _selectedChat = updated;
                _reviewChat = updated;
                _reviewVersion++;
            }
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _chatError = $"Could not remove resource link: {error.Message}";
        }
    }

    private async Task LoadReviewsAsync()
    {
        var projectId = _selectedProject?.Id;
        var chatId = _selectedChat?.Id;
        _reviews.Clear();
        _reviewVersion++;
        if (projectId is null || chatId is null) return;
        try
        {
            var reviews = await PruneEmptyReviewsAsync(projectId.Value, chatId.Value,
                await ReviewApi.ListAsync(projectId.Value, chatId.Value, CancellationToken.None));
            if (_selectedProject?.Id == projectId && _selectedChat?.Id == chatId)
            {
                _reviews.AddRange(reviews);
                _reviewVersion++;
            }
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            _chatError = $"Could not load reviews: {error.Message}";
        }
    }

    private async Task<IReadOnlyList<ChatReview>> PruneEmptyReviewsAsync(Guid projectId, Guid chatId,
        IReadOnlyList<ChatReview> reviews)
    {
        var kept = new List<ChatReview>(reviews.Count);
        var deletedIds = new HashSet<Guid>();
        foreach (var review in reviews)
        {
            if (!IsEmptyReview(review) || _reviewWorkspaceOpen && _reviewStartId == review.Id)
            {
                kept.Add(review);
                continue;
            }
            if (await ReviewApi.DeleteAsync(projectId, chatId, review.Id, CancellationToken.None))
                deletedIds.Add(review.Id);
        }
        if (deletedIds.Count == 0) return kept;
        foreach (var key in _resourceDrafts.Keys.Where(key => key.StartsWith($"{chatId}:", StringComparison.Ordinal)).ToArray())
            _resourceDrafts[key] = _resourceDrafts[key].Where(item => !deletedIds.Contains(item.Id)).ToArray();
        if (_selectedChat?.Id == chatId && _selectedProject?.Id == projectId)
        {
            _draftResources.RemoveAll(item => deletedIds.Contains(item.Id));
            var refreshed = await ChatHistoryApi.GetAsync(projectId, chatId, CancellationToken.None);
            if (refreshed is not null) { _selectedChat = refreshed; _reviewChat = refreshed; CacheChatDetails(refreshed); }
        }
        return kept;
    }

