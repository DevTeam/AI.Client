    }

    // The Host already sends pinned chats first in their manual order and the rest by activity.
    // A chat without messages stays out of the list until its first message, except the open one:
    // its first message may still be on the way to the Host when the list is re-read.
    private ChatArchiveDrawer? _archiveDrawer;
    private void CloseArchive() { if (_archiveDrawer?.IsBusy != true) _showArchive = false; }
    private IJSObjectReference? _archiveModule;
    private Guid? _archiveSuggestionProject;
    private int _archiveSuggestionCount;
    private string _archiveSuggestionFingerprint = "";
    private DateTimeOffset _archiveSuggestionCheckedAt;
    private bool _archiveSuggestionLoading;
    private bool _showArchive, _archiveCleanup, _archiveSaving;

    private async Task RefreshArchiveSuggestionsAsync()
    {
        _archiveSuggestionCheckedAt = default;
        await CheckArchiveSuggestionsAsync();
