    /// <summary>
    /// Adds a file or directory reference to the composer of the chat that is open now. Each kind is
    /// tried in turn and the first the Host accepts wins; when none is, the first refusal is shown.
    /// </summary>
    private async Task AddDraftResourceAsync(IReadOnlyList<ChatResourceKind> kinds, string path, bool notifyErrors = true,
        ChatLineRange? lines = null, string? mention = null, bool includeContent = false, bool offerAccess = true)
    {
        if (_selectedProject is null) return;
        var comparison = OperatingSystem.IsWindows() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal;
        var existing = _draftResources.FindIndex(item => kinds.Contains(item.Kind) && string.Equals(item.Path, path, comparison));
        if (existing >= 0)
        {
            // One reference per path: a newer link to it, or to other lines of it, takes it over.
            if (mention is not null)
            {
                _draftResources[existing] = _draftResources[existing] with
                {
                    Lines = lines, Mention = mention,
                    IncludeContent = includeContent && lines is null && _draftResources[existing].Kind == ChatResourceKind.File
                };
                _resourceDrafts[GetComposerDraftKey()] = _draftResources.ToArray();
            }
            return;
        }
        if (_draftResources.Count >= 20)
        {
            _chatError = "A message can reference at most 20 resources.";
            if (notifyErrors) Notifications.ShowError(_chatError);
            return;
        }
        var projectId = _selectedProject.Id;
        var draftKey = GetComposerDraftKey();
        try
        {
            ChatResource? created = null;
            Exception? firstError = null;
            foreach (var candidate in kinds)
            {
                try
                {
                    created = await ResourceApi.CreateAsync(projectId, candidate, path, CancellationToken.None);
                    break;
                }
                catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
                {
                    firstError ??= error;
                }
            }
            if (created is not { } resource) throw firstError ?? new InvalidOperationException("The path could not be added.");
            if (_selectedProject?.Id != projectId || GetComposerDraftKey() != draftKey) return;
            if (_draftResources.Any(item => item.Kind == resource.Kind && string.Equals(item.Path, resource.Path,
                    OperatingSystem.IsWindows() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal))) return;
            _draftResources.Add(resource with
            {
                Lines = resource.Kind == ChatResourceKind.File ? lines : null, Mention = mention,
                IncludeContent = includeContent && lines is null && resource.Kind == ChatResourceKind.File
            });
            _resourceDrafts[draftKey] = _draftResources.ToArray();
            await WorkspaceStateService.SetLastBrowsedDirectoryAsync(resource.Kind == ChatResourceKind.Directory
                ? resource.Path : Path.GetDirectoryName(resource.Path) ?? resource.Path);
            _chatError = null;
            if (_pendingResourceAccess is { } pending && string.Equals(pending.Path, resource.Path, comparison)) _pendingResourceAccess = null;
        }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            // A path outside the project is a question of access, not a failure: the composer asks.
            if (offerAccess && await OfferResourceAccessAsync(projectId, draftKey, path, lines, mention, includeContent)) return;
            _chatError = $"Could not add the resource: {error.Message}";
            if (notifyErrors) Notifications.ShowError(_chatError);
        }
    }

