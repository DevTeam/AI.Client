    private async Task SyncWorkspaceUrlAsync(bool replace = false, bool overrideMessage = false, Guid? messageId = null)
    {
        if (_navigationHandle is null || _suppressNavigationWrite) return;
        var current = ParseWorkspaceTarget(await _navigationHandle.InvokeAsync<string>("url"));
        var sameDestination = current.ProjectId == _selectedProject?.Id
            && current.ChatId == _selectedChat?.Id
            && (current.BranchId ?? current.ChatId) == (_selectedBranchId ?? _selectedChat?.Id);
        var urlMessageId = overrideMessage ? messageId : sameDestination ? current.MessageId : null;
        var buttons = await _navigationHandle.InvokeAsync<NavigationButtons>("set",
            _selectedProject?.Id.ToString(), _selectedChat?.Id.ToString(), _selectedBranchId?.ToString(),
            urlMessageId?.ToString(), _notificationsOpen ? "notifications" : null, replace);
        _canNavigateBack = buttons.CanBack;
        _canNavigateForward = buttons.CanForward;
