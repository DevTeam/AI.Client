        ChatResourceKind.Review => ReviewName(resource),
        ChatResourceKind.File when resource.Lines is { } lines => $"{resource.Path}, lines {LineRangeText(lines)}",
        ChatResourceKind.File when resource.IncludeContent => $"{resource.Path}\nWith its content, captured when the message is sent",
        ChatResourceKind.Diff => $"Uncommitted changes in {resource.Path}, captured when the message is sent",
        ChatResourceKind.Chat => $"Chat “{resource.Name ?? resource.Path}”",
