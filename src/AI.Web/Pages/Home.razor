    /// <summary>
    /// A link does not say whether it names a file or a directory. A trailing separator settles it;
    /// otherwise the Host is asked for a file first and a directory second, and it checks the path
    /// against the project's read grants either way.
    /// </summary>
    private async Task AddFileLinkToMessageAsync()
    {
        if (_fileLinkMenu is not { } link) return;
        CloseFileLinkMenu();
        if (_selectedProject is null) return;
        ChatResourceKind[] kinds = link.Kind is { } known ? [known]
            : link.Path.EndsWith('\\') || link.Path.EndsWith('/') ? [ChatResourceKind.Directory]
            : [ChatResourceKind.File, ChatResourceKind.Directory];
        await AddDraftResourceAsync(kinds, link.Path);
    }

    /// <summary>A directory is granted as it is; a file through the directory that holds it.</summary>
    private static string FileLinkGrantPath(FileLinkMenuRequest link)
    {
        if (link.Kind == ChatResourceKind.Directory) return link.Path;
        var trimmed = link.Path.TrimEnd('\\', '/');
        var separator = trimmed.LastIndexOfAny(['\\', '/']);
        // "C:\file.txt" lives in "C:\", not in "C:".
        return separator <= 0 ? link.Path : trimmed[..(trimmed[separator - 1] == ':' ? separator + 1 : separator)];
    }

    /// <summary>
    /// Grants read access to the linked directory, or to the one holding the linked file, the same
    /// way the directory picker does. The file tools see it from the assistant's next run.
    /// </summary>
    private async Task GrantFileLinkAccessAsync()
    {
        if (_fileLinkMenu is not { } link) return;
        CloseFileLinkMenu();
        var folder = FileLinkGrantPath(link);
        if (!await AddDirectoryGrantAsync(folder,
                $"The project can now read {GetDirectoryDisplayNameSuggestion(folder)}; the assistant's tools see it from its next run.")) return;
    }

