    /// <summary>
    /// Enter or Tab in the "@" list. Tab on a directory opens it — the word becomes its path and the
    /// list shows what is inside; everything else attaches the row the way the "+" menu would and
    /// takes the typed word out of the message. Returns the composer's new text and caret.
    /// </summary>
    [JSInvokable]
    public async Task<AI.Web.Composer.ComposerTextEdit?> AcceptMentionSuggestion(string text, int caret, bool openDirectory,
        bool includeContent)
    {
        if (!IsMentionListOpen()) return null;
        var item = _mentionItems[Math.Clamp(_mentionIndex, 0, _mentionItems.Count - 1)];
        var edit = await AcceptMentionAsync(item, text, caret, openDirectory, includeContent);
        await InvokeAsync(StateHasChanged);
        return edit;
    }

    private Task PickMentionSuggestionAsync(int index) => PickMentionAsync(index, includeContent: false);

    private Task PickMentionContentAsync(int index) => PickMentionAsync(index, includeContent: true);

    private async Task PickMentionAsync(int index, bool includeContent)
    {
        if (index < 0 || index >= _mentionItems.Count || _mention is not { } mention) return;
        var edit = await AcceptMentionAsync(_mentionItems[index], _chat.Message, mention.End, openDirectory: false, includeContent);
        if (_composerHandle is not null && edit is not null) await _composerHandle.InvokeVoidAsync("setText", edit.Text, edit.Caret);
    }

    private void HoverMentionSuggestion(int index) => _mentionIndex = index;

    private async Task<AI.Web.Composer.ComposerTextEdit?> AcceptMentionAsync(AI.Web.Resources.ResourceMentionItem item,
        string text, int caret, bool openDirectory, bool includeContent)
    {
        if (MentionMatcher.GetMention(text, caret) is not { } mention) return null;
        if (openDirectory && item is { Kind: ChatResourceKind.Directory, Action: AI.Web.Resources.ResourceMentionAction.Attach })
        {
            var relative = item.OpenAs ?? (item.Detail is { Length: > 0 } parent ? $"{parent}/{item.Name}" : item.Name);
            var opened = $"{text[..mention.Start]}@{relative}/";
            var edit = new AI.Web.Composer.ComposerTextEdit(opened + text[mention.End..], opened.Length);
            SetComposerText(edit.Text);
            // chatComposer.js took the list for closed when it sent the key; the list stays open on
            // the directory's contents, so the state goes to it again or it stops passing the keys.
            _mentionListPushed = null;
            await OnComposerCaret(edit.Text, edit.Caret);
            return edit;
        }
        var before = text[..mention.Start];
        var after = text[mention.End..];
        CloseMention();
        if (item.Action != AI.Web.Resources.ResourceMentionAction.Attach)
        {
            // The picker answers later; its choice is written where the "@" word was.
            if (after.StartsWith(' ') && (before.Length == 0 || char.IsWhiteSpace(before[^1]))) after = after[1..];
            var removed = new AI.Web.Composer.ComposerTextEdit(before + after, before.Length);
            SetComposerText(removed.Text);
            OpenResourcePicker(item.Action == AI.Web.Resources.ResourceMentionAction.BrowseFile
                ? DirectoryPickerMode.File : DirectoryPickerMode.Directory);
            _pendingMentionAt = before.Length;
            return removed;
        }
        var result = InsertMention(before, after, item.Token);
        // Shift+Enter on a row that is only ever a path, a directory or lines, adds it as Enter does.
        await AttachMentionAsync(item, includeContent && ResourceMentionMenu.CanSendContent(item));
        return result;
    }

    /// <summary>
    /// The link replaces the typed word and is followed by a space, so typing goes on after it the
    /// way it does in Claude Code and Codex.
    /// </summary>
    private AI.Web.Composer.ComposerTextEdit InsertMention(string before, string after, string token)
    {
        var separator = after.Length > 0 && char.IsWhiteSpace(after[0]) ? string.Empty : " ";
        var edit = new AI.Web.Composer.ComposerTextEdit(before + token + separator + after, before.Length + token.Length + 1);
        SetComposerText(edit.Text);
        return edit;
    }

