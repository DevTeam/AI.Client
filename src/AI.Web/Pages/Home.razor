    private async Task HandleChatItemKeyDownAsync(KeyboardEventArgs args, ChatSummary chat)
    {
        if (!args.AltKey || _selectedProject is null)
        {
            return;
        }

        if (args.Key is "p" or "P")
        {
            await ToggleChatPinAsync(chat);
        }
        else if (args.Key is "ArrowUp" or "ArrowDown" && chat.IsPinned)
        {
            await MovePinnedChatAsync(chat, args.Key == "ArrowUp" ? -1 : 1);
        }
    }

    /// <summary>Moves a pinned chat one place up or down among the pinned chats; it never leaves the zone.</summary>
    private async Task MovePinnedChatAsync(ChatSummary chat, int direction)
    {
        var pinned = GetOrderedChats().Where(item => item.IsPinned).ToList();
        var index = pinned.FindIndex(item => item.Id == chat.Id);
        var target = index + direction;
        if (index < 0 || target < 0 || target >= pinned.Count) return;
        // Up: in front of the previous chat. Down: in front of the chat after the next one, or last.
        Guid? before = direction < 0 ? pinned[target].Id : target + 1 < pinned.Count ? pinned[target + 1].Id : null;
        if (await PinChatAsync(chat, true, before))
        {
            _focusChatAfterRender = chat.Id;
            _sidebarAnnouncement = $"Moved chat {chat.Title} {GetMoveDirection(direction)}, {target + 1} of {pinned.Count} pinned.";
        }
    }

    private async Task ToggleChatPinAsync(ChatSummary chat)
    {
        _chatMenuId = null;
        // The pin button performs an instant toggle with no follow-up UI (unlike rename or the
        // chat menu), so it must give up keyboard focus itself — otherwise :focus-within would
        // keep the whole row's actions visible after the click, even once the pointer moves away.
        await WorkspaceLayoutService.BlurActiveElementAsync();
        // Pinning from the button, the menu or Alt+P puts the chat last among the pinned ones:
        // the order the user already gave them stays as it was.
        if (await PinChatAsync(chat, !chat.IsPinned, null))
            _sidebarAnnouncement = chat.IsPinned ? $"Unpinned chat {chat.Title}." : $"Pinned chat {chat.Title}.";
    }

    /// <summary>Pins, moves or unpins a chat and re-reads the list, animating the rows that moved.</summary>
    private async Task<bool> PinChatAsync(ChatSummary chat, bool isPinned, Guid? beforeChatId)
    {
        if (_selectedProject is not { } project) return false;
        var updated = await ChatHistoryApi.PinAsync(project.Id, chat.Id, new PinChatRequest(isPinned, chat.Revision, beforeChatId), CancellationToken.None);
        if (updated is null)
        {
            Notifications.ShowError("Chat pin state was not saved. Reload and try again.");
            return false;
        }

        // Placing a chat can give keys to chats pinned before manual ordering existed, which moves
        // their revisions too, so the whole list is re-read rather than patching this one row.
        IReadOnlyList<ChatSummary> chats;
        try { chats = await ChatHistoryApi.ListAsync(project.Id, CancellationToken.None); }
        catch (HttpRequestException) { return true; }
        if (_selectedProject?.Id == project.Id) await ApplyChatOrderAsync(chats);
        return true;
    }

    private async Task<bool> MoveItemAsync<T>(List<T> items, Guid id, int direction, string orderKey, Func<T, Guid> idSelector)
    {
        var currentIndex = items.FindIndex(item => idSelector(item) == id);
        var targetIndex = currentIndex + direction;
        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= items.Count)
        {
            return false;
        }

        var item = items[currentIndex];
        items.RemoveAt(currentIndex);
        items.Insert(targetIndex, item);
        await SaveOrderAsync(orderKey, items.Select(idSelector));
        return true;
    }

    private static string GetMoveDirection(int direction) => direction < 0 ? "up" : "down";

    private const string ProjectOrderKey = "ai-client.project-order.v1";

    private async Task ApplyProjectOrderAsync()
    {
        var order = await LoadOrderAsync(ProjectOrderKey);
        if (order.Count == 0)
        {
            return;
        }

        var ordered = ApplyOrder(_projects, order, p => p.Id);
        _projects.Clear();
        _projects.AddRange(ordered);
    }

    private async Task<List<Guid>> LoadOrderAsync(string key)
    {
        try
        {
            var json = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", key);
            return string.IsNullOrEmpty(json) ? [] : JsonSerializer.Deserialize<List<Guid>>(json) ?? [];
        }
        catch (JsonException)
        {
            return [];
        }
    }

    private Task SaveOrderAsync(string key, IEnumerable<Guid> ids) =>
        JsRuntime.InvokeVoidAsync("localStorage.setItem", key, JsonSerializer.Serialize(ids)).AsTask();

    private static List<T> ApplyOrder<T>(IReadOnlyList<T> items, List<Guid> order, Func<T, Guid> idSelector)
    {
        var byId = items.ToDictionary(idSelector);
        var result = new List<T>(items.Count);
        var used = new HashSet<Guid>();
        foreach (var id in order)
        {
            if (byId.TryGetValue(id, out var item) && used.Add(id))
            {
                result.Add(item);
            }
        }

        result.AddRange(items.Where(item => used.Add(idSelector(item))));
        return result;
    }

