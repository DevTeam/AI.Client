    /// <param name="announce">False when the caller reports the outcome in its own notification.</param>
    private async Task<bool> PersistDirectoryGrantsAsync(string? successMessage = null, bool announce = true)
    {
        if (_selectedProject is null) return false;

        var result = await ProjectApi.UpdateSecurityAsync(_selectedProject.Id, _security.ToRequest(), CancellationToken.None);
        if (result.Status != ProjectUpdateStatus.Updated || result.Project is null)
        {
            await LoadSecurityAsync(_selectedProject.Id);
            if (announce) Notifications.ShowError("Directory changes were not saved. Reload the project and try again.");
            return false;
        }

        _security = ProjectSecurityEditor.From(result.Project);
        _editor.Revision = result.Project.Revision;
        // SaveSecurityAsync is the "Save" of the project settings panel, so it gets the same toast
        // as the project form itself — otherwise the one panel with a dozen fields is the one that
        // stays silent about whether the write landed.
        if (announce) Notifications.ShowSuccess(successMessage ?? "Project settings saved.");
        return true;
    }

    private async Task CreateChatAsync()
    {
        if (_selectedProject is null) return;
        await CloseReviewAsync();
        _reviewChat = null;
        _reviews.Clear();
        _reviewVersion++;
        _attachComposer = true;
        ResetBranchOperationState();
        _selectedChat = null;
        _selectedBranchId = null;
        _branchLeafId = null;
        SetJustArrivedLeaf(null);
        _wasGeneratingByBranch.Clear();
        if (_defaultConnectionId is { } endpointId)
        {
            await SelectChatProfileAsync(new ChangeEventArgs { Value = endpointId.ToString() });
        }
        // Drop any previously-typed "new chat" draft for this project. The user just clicked
        // "+", they want a fresh composer — if we only cleared _chat.Message here, the draft
        // would still be in localStorage and reappear the next time they navigate away and
        // back (RestoreComposerDraft in SelectProjectAsync would find it again). The flush
        // makes the deletion land in localStorage before that navigation can happen.
        WorkspaceStateService.QueueComposerDraftSave($"new:{_selectedProject.Id}", string.Empty);
        await WorkspaceStateService.FlushPendingComposerDraftAsync();
        _chat.Message = string.Empty;
        _draftResources.Clear();
        _resourceDrafts.Remove(GetComposerDraftKey());
        if (_composerHandle is not null) await _composerHandle.InvokeVoidAsync("focus");
    }

    private async Task CreateChatForProjectAsync(ProjectSummary project)
    {
