        {
            await SelectProjectAsync(project, restoreLastChat: false);
        }

        await CreateChatAsync();
    }

    // Searching replaces the sidebar tree rather than sitting beside it, so state is only these
    // three fields: what was typed, what came back, and whether a request is in flight. There is no
    // paging in the UI — a person narrows a query sooner than they page through it — so the cursor
    // the service returns is reported as "more remain" and otherwise left alone.
    private string _searchQuery = string.Empty;
    private ChatSearchResult? _searchResult;
    private bool _isSearching;
    private CancellationTokenSource? _searchCancellation;

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        if (_searchQuery.Trim().Length < 2)
        {
            // One character matches nearly everything and costs a full scan to prove it.
            await CancelSearchAsync();
            _searchResult = null;
            return;
        }

        await RunSearchAsync();
    }

    private Task OnSearchKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? ClearSearch() : Task.CompletedTask;

    private async Task ClearSearch()
    {
        await CancelSearchAsync();
        _searchQuery = string.Empty;
        _searchResult = null;
    }

    private async Task CancelSearchAsync()
    {
        if (_searchCancellation is { } previous)
        {
            await previous.CancelAsync();
            previous.Dispose();
            _searchCancellation = null;
        }

        _isSearching = false;
    }

    private async Task RunSearchAsync()
    {
        // Typing is faster than searching, so each keystroke cancels the scan the last one started;
        // otherwise the answer to a half-typed word could land after the answer to the whole one.
        await CancelSearchAsync();
        var cancellation = new CancellationTokenSource();
        _searchCancellation = cancellation;
        _isSearching = true;
        var query = _searchQuery.Trim();
        try
        {
            var result = await ChatHistoryApi.SearchAsync(query, null, cancellation.Token);
            if (!cancellation.IsCancellationRequested && _searchQuery.Trim() == query)
            {
                _searchResult = result;
                _isSearching = false;
            }
        }
        catch (OperationCanceledException) { }
        catch (HttpRequestException)
        {
            if (!cancellation.IsCancellationRequested) _searchResult = new ChatSearchResult([], 0, 0, false, null, "Search is unavailable.");
            _isSearching = false;
        }
    }

    private async Task OpenSearchMatchAsync(ChatSearchMatch match)
    {
        if (_projects.SingleOrDefault(item => item.Id == match.ProjectId) is { } project)
        {
            if (_selectedProject?.Id != project.Id) await SelectProjectAsync(project, restoreLastChat: false);
            await SelectChatAsync(match.ChatId);
        }

        // Keep the sidebar showing the matching list while the feed scrolls: clearing first would
        // dismiss the results panel, and dismissing the results panel also drops the highlight
        // (the highlight is driven by SearchQuery, which ClearSearch resets). The "close search"
        // rule therefore kicks in only once the user dismisses the results themselves — typing a
        // new query, hitting Escape, or clicking the input built-in clear button.
        if (_messageFeed is not null) await _messageFeed.ScrollToMessageAsync(match.MessageId);
    }

    // The chat the sidebar should show as selected: what the user just clicked, if its transcript
    // is still loading, and otherwise what is actually open.
    private Guid? GetActiveChatId() => _pendingChatId ?? _selectedChat?.Id;

    // Supersedes any selection still in flight. The abandoned one stops at its next guard, and
    // its HTTP request is cancelled rather than deserialised into a transcript nobody wants.
    private CancellationToken BeginChatSelection(Guid chatId)
    {
        CancelChatSelection();
        var cancellation = new CancellationTokenSource();
        _chatSelectionCancellation = cancellation;
        _pendingChatId = chatId;
        return cancellation.Token;
    }

    private void CancelChatSelection()
    {
        _chatSelectionCancellation?.Cancel();
        _chatSelectionCancellation?.Dispose();
        _chatSelectionCancellation = null;
        _pendingChatId = null;
    }

    private async Task SelectChatAsync(Guid chatId)
    {
        await CloseReviewAsync();
        _reviewChat = null;
        _attachComposer = true;
        ResetBranchOperationState();
        CloseContextMenus();
        var cancellation = BeginChatSelection(chatId);
        if (_selectedProject is not null)
        {
            var projectId = _selectedProject.Id;
            if (_selectedChat is { } currentChat) CacheChatDetails(currentChat);
            // Clicking the chat's own sidebar entry while a DIFFERENT one of its branches is
            // already open is the only explicit way back to the main branch (there's no separate
            // "main branch" row next to the fork rows) — it must always land there. Restoring the
            // remembered branch here too made it a no-op once any branch had ever been visited:
            // SelectBranchTreeItemAsync had just written that branch as "last left on" for this
            // exact chat, so the restore step below immediately re-selected it right back,
            // permanently masking the reset. The remembered-branch restore is for the OTHER case
            // this method serves — arriving at this chat from somewhere else (a different chat, a
            // fresh page load) — which is exactly what "already viewing this chat" rules out.
            var wasAlreadyOnThisChat = _selectedChat?.Id == chatId;
            ChatDetails? details;
            try
            {
                // Reading the destination and recording the old scroll position are independent.
                // Running them together removes a full JS round-trip from the user's wait while
                // still letting the old DOM be measured before the new transcript is rendered.
                var detailsTask = GetChatForSelectionAsync(projectId, chatId, cancellation);
                var saveScrollTask = SaveCurrentScrollPositionAsync();
                await Task.WhenAll(detailsTask, saveScrollTask);
                details = await detailsTask;
            }
            catch (OperationCanceledException)
            {
                return;
            }

            // Superseded while the transcript was on its way: everything below writes selection
            // state, and writing it now would undo the chat the user has since asked for.
            if (cancellation.IsCancellationRequested) return;

            _pendingChatId = null;
            _selectedChat = details;
            _branchLeafId = GetOriginalBranchLeaf(_selectedChat);

            // Prefer the branch this chat was last left on, within this project, if it's still
            // part of the chat (a branch can be deleted independently of the chat itself).
            var context = WorkspaceStateService.GetProjectContext(_selectedProject.Id);
            // A remembered leaf can sit on a branch whose transcript is NOT the one currently in
            // _selectedChat.Messages — at this point _branchLeafId has just been reset to main
            // via GetOriginalBranchLeaf, so Messages reflects the main transcript and any leaf
            // that lives past the fork point is invisible to a Messages-based check. Match
            // against the chat's branch heads instead: that's what "is this still a valid leaf
            // for this chat?" actually means, and it's stable across which branch is currently
            // expanded.
            if (!wasAlreadyOnThisChat
                && _selectedChat is not null
                && context.ChatId == chatId
                && context.BranchLeafId is { } rememberedBranchLeafId
                && _selectedChat.Branches?.Any(branch => branch.HeadMessageId == rememberedBranchLeafId) == true)
            {
                _branchLeafId = rememberedBranchLeafId;
            }

            _selectedBranchId = _selectedChat?.Branches?.FirstOrDefault(branch => branch.HeadMessageId == _branchLeafId)?.Id ?? _selectedChat?.Id;
            if (_selectedChat?.ConnectionId is { } endpointId)
            {
                // Restore the selection without persisting an endpoint change when opening a chat.
                SelectGlobalConnection(endpointId);
            }
            RestoreComposerDraft();
            // Whether to jump to the bottom or restore the last-viewed message is decided in
            // MessageFeed (it knows whether a saved position exists) — see OnAfterRenderAsync.
            _pendingScrollRestoreKey = GetScrollPositionKey();
            _openedChatToSettle = (projectId, _selectedChat?.Id, _branchLeafId);
            await LoadReviewsAsync();
        }
        else
        {
            _pendingChatId = null;
        }
    }

    private async Task<ChatDetails?> GetChatForSelectionAsync(Guid projectId, Guid chatId, CancellationToken cancellationToken)
    {
        var knownRevision = _chats.FirstOrDefault(chat => chat.Id == chatId)?.Revision;
        if (_chatDetailsCache.TryGetValue(chatId, out var cached)
            && cached.ProjectId == projectId
            && (knownRevision is null || cached.Revision >= knownRevision))
        {
            CacheChatDetails(cached);
            return cached;
        }

        var loaded = await ChatHistoryApi.GetTranscriptAsync(projectId, chatId, cancellationToken);
        if (loaded is not null) CacheChatDetails(loaded);
        return loaded;
    }

    private void CacheChatDetails(ChatDetails chat)
    {
        if (_chatDetailsCacheSizes.TryGetValue(chat.Id, out var previousSize))
            _chatDetailsCacheBytes -= previousSize;
        var size = EstimateChatDetailsSize(chat);
        _chatDetailsCache[chat.Id] = chat;
        _chatDetailsCacheSizes[chat.Id] = size;
        _chatDetailsCacheBytes += size;
        var existing = _chatDetailsLru.Find(chat.Id);
        if (existing is not null) _chatDetailsLru.Remove(existing);
        _chatDetailsLru.AddFirst(chat.Id);

        while (_chatDetailsLru.Count > MinRetainedChatDetailsCount
               && (_chatDetailsLru.Count > MaxRetainedChatDetailsCount
                   || _chatDetailsCacheBytes > RetainedChatDetailsBudgetBytes))
        {
            var expiredChatId = _chatDetailsLru.Last!.Value;
            _chatDetailsLru.RemoveLast();
            _chatDetailsCache.Remove(expiredChatId);
            if (_chatDetailsCacheSizes.Remove(expiredChatId, out var expiredSize))
                _chatDetailsCacheBytes -= expiredSize;
        }
    }

    private static long EstimateChatDetailsSize(ChatDetails chat)
    {
        // Strings dominate these objects (especially tool output). Two bytes per character is the
        // useful lower-bound for their managed representation; object/list overhead is covered by
        // the conservative budget rather than paying for a full graph walk or re-serialization.
        long characters = chat.Title.Length;
        foreach (var message in chat.Messages)
        {
            characters += message.Role.Length + message.Content.Length;
            foreach (var call in message.ToolCalls ?? [])
                characters += call.Id.Length + call.Name.Length + call.Arguments.Length;
            if (message.WorkspaceChanges is { } changes)
                foreach (var file in changes.Files)
                    characters += file.Path.Length + (file.PreviousPath?.Length ?? 0) + (file.Diff?.Length ?? 0);
        }
        return Math.Max(4096, characters * sizeof(char));
    }

    private ChatRunSnapshot? GetRun(Guid chatId, Guid branchId) => RunState.Runs.GetValueOrDefault(new RunKey(chatId, branchId));
    private ChatRunSnapshot? GetBranchRun(Guid chatId, BranchTreeItem branch) => GetRun(chatId, branch.RootId);
    private ChatRunSnapshot? GetSelectedRun() => _selectedChat is not null ? GetRun(_selectedChat.Id, GetSelectedRunBranchId()) : null;
    private int GetTranscriptRunPresentationVersion()
    {
        if (_selectedChat is null) return 0;
        var hash = new HashCode();
        foreach (var run in RunState.Runs.Values.Where(run => run.ChatId == _selectedChat.Id).OrderBy(run => run.BranchId))
        {
            hash.Add(run.BranchId);
            hash.Add(run.Status);
            hash.Add(run.HasUnreadResponse);
            hash.Add(run.PendingApproval?.Id);
            hash.Add(run.PendingPrompt?.Id);
            hash.Add(run.Error);
        }
        return hash.ToHashCode();
    }
    private void StoreRun(ChatRunSnapshot run) => RunState.Store(run);
    private bool IsVisibleRun(ChatRunSnapshot run) =>
        StatusPresentation.HasVisibleAttention(run) || run.Status == ChatRunStatus.Generating || run.HasUnreadResponse;
    private BranchTreeItem? GetSelectedBranchItem() =>
        GetBranchTreeItems().FirstOrDefault(branch => branch.RootId == _selectedBranchId);

    private Guid? GetSelectedBranchId() => GetSelectedBranchItem()?.RootId;

    private Guid GetSelectedRunBranchId() => _selectedChat is null ? Guid.Empty : _selectedBranchId ?? _selectedChat.Id;
    // Priority for picking the ONE run a collapsed project row represents when several of its
    // chats disagree: an outright failure always wins, then anything else needing user action,
    // then an unread completion, then an in-progress run — matching how urgently each state
    // deserves the user's attention rather than e.g. insertion order.
    private int GetProjectRunPriority(ChatRunSnapshot run) => run switch
    {
        { Status: ChatRunStatus.Failed } => 0,
        _ when StatusPresentation.HasVisibleAttention(run) => 1,
        { HasUnreadResponse: true } => 2,
        { Status: ChatRunStatus.Generating } => 3,
        _ => 4
    };
    private ChatRunSnapshot? GetProjectRun(Guid projectId) => GetProjectRuns(projectId)
        .Where(IsVisibleRun)
        .OrderBy(GetProjectRunPriority)
        .FirstOrDefault();
    private ChatRunSnapshot? GetChatBranchRun(Guid chatId) => RunState.Runs.Values
        .Where(run => run.ChatId == chatId && run.BranchId != chatId)
        .Where(run => !ShouldHideCurrentRunStatus(run.ChatId, run.BranchId, run) && IsVisibleRun(run))
        .OrderBy(GetProjectRunPriority)
        .FirstOrDefault();
    private string GetChatBranchStatusClass(Guid chatId) => GetRunStatusClass(GetChatBranchRun(chatId));
    private int GetBranchCount(ChatSummary chat)
    {
        var details = _selectedChat?.Id == chat.Id
            ? _selectedChat
            : _chatDetailsCache.GetValueOrDefault(chat.Id);
        return details?.Branches?.Count(branch => branch.Id != chat.Id && branch.HeadMessageId is not null)
            ?? chat.BranchCount;
    }
    private string GetChatBranchCountTitle(ChatSummary chat, int branchCount)
    {
        var countTitle = GetBranchCountTitle(branchCount);
        return GetChatBranchRun(chat.Id) is { } run
            ? $"{countTitle} · {StatusPresentation.GetStatusTooltip(run)}"
            : countTitle;
    }
    private string GetProjectRunTooltip(Guid projectId) { var runs = GetProjectRuns(projectId).ToArray(); return $"{runs.Count(item => item.Status == ChatRunStatus.Generating)} generating · {runs.Count(item => item.HasUnreadResponse)} unread · {runs.Count(item => item.Status == ChatRunStatus.Failed)} failed"; }
    private IEnumerable<ChatRunSnapshot> GetProjectRuns(Guid projectId)
    {
        return RunState.Runs.Values.Where(run => run.ProjectId == projectId);
    }
    // The open project's own status is already visible per-chat below it, so the project row
    // itself shows nothing — repeating it there would be the same redundant echo we just
    // removed from the currently open chat/branch row.
    private string? GetProjectRunTitle(Guid projectId) =>
        _selectedProject?.Id == projectId || GetProjectRun(projectId) is null ? null : GetProjectRunTooltip(projectId);
    private string GetProjectStatusClass(Guid projectId) =>
        _selectedProject?.Id == projectId ? string.Empty : GetRunStatusClass(GetProjectRun(projectId));
    // A completed/unread/attention status for what's currently open in the transcript needs no
    // separate sidebar signal — the message feed already shows it. Generating is the exception:
    // it stays visible even for the open chat/branch, since it is live progress rather than a
    // state the user has already seen.
    private bool IsCurrentRun(Guid chatId, Guid branchId) => _selectedChat?.Id == chatId && GetSelectedRunBranchId() == branchId;
    private bool ShouldHideCurrentRunStatus(Guid chatId, Guid branchId, ChatRunSnapshot? run) =>
        IsCurrentRun(chatId, branchId) && run?.Status != ChatRunStatus.Generating;
    private string? GetRunTitle(Guid chatId, Guid branchId, ChatRunSnapshot? run) =>
        ShouldHideCurrentRunStatus(chatId, branchId, run) || run is null || !IsVisibleRun(run) ? null : StatusPresentation.GetStatusTooltip(run);
    private string GetRunStatusClass(Guid chatId, Guid branchId, ChatRunSnapshot? run) =>
        ShouldHideCurrentRunStatus(chatId, branchId, run) ? string.Empty : GetRunStatusClass(run);
    private string GetRunStatusClass(ChatRunSnapshot? run) => StatusPresentation.GetStatusClass(run);

    // Captures the currently selected chat/branch synchronously (before any await), then hands
    // off to MarkChatReadAsync. This must NOT read _selectedChat/_selectedBranchId again after
    // an await: a fast second chat switch reassigns those fields while this call's own
    // MarkReadAsync request is still in flight, and re-reading them post-await would mark the
    // NEW selection read instead of the one this call was actually invoked for — leaving the
    // chat the user already left showing an unread indicator that never gets cleared.
    private Task MarkSelectedChatReadAsync() =>
        _selectedProject is null || _selectedChat is null
            ? Task.CompletedTask
            : MarkChatReadAsync(_selectedProject.Id, _selectedChat.Id, GetSelectedRunBranchId());

    private async Task MarkChatReadAsync(Guid projectId, Guid chatId, Guid branchId)
    {
        if (_isConfirmingProjectDelete || GetRun(chatId, branchId)?.HasUnreadResponse != true) return;
        if (!await _projectMutationGate.WaitAsync(0, CancellationToken.None)) return;
        try
        {
            if (_isConfirmingProjectDelete || GetRun(chatId, branchId)?.HasUnreadResponse != true) return;
            var snapshot = await ChatRunsApi.MarkReadAsync(projectId, chatId, branchId, Guid.CreateVersion7(), CancellationToken.None);
            if (snapshot is not null) StoreRun(snapshot);
        }
        finally
        {
            _projectMutationGate.Release();
        }
    }

    private async Task DisposeComposerHandleAsync()
    {
        var handle = _composerHandle;
        _composerHandle = null;
        if (handle is not null) await DisposeJsReferenceAsync(handle, invokeDispose: true);
    }

