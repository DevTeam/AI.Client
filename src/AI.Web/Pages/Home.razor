    /// <param name="announce">False when the caller reports the outcome in its own notification.</param>
    private async Task<bool> PersistDirectoryGrantsAsync(string? successMessage = null, bool announce = true)
    {
        if (_selectedProject is null) return false;

        var result = await ProjectApi.UpdateSecurityAsync(_selectedProject.Id, _security.ToRequest(), CancellationToken.None);
        if (result.Status != ProjectUpdateStatus.Updated || result.Project is null)
        {
            await LoadSecurityAsync(_selectedProject.Id);
            if (announce) Notifications.ShowError("Directory changes were not saved. Reload the project and try again.");
            return false;
        }

        _security = ProjectSecurityEditor.From(result.Project);
        _editor.Revision = result.Project.Revision;
        // SaveSecurityAsync is the "Save" of the project settings panel, so it gets the same toast
        // as the project form itself — otherwise the one panel with a dozen fields is the one that
        // stays silent about whether the write landed.
        if (announce) Notifications.ShowSuccess(successMessage ?? "Project settings saved.");
        return true;
    }

    private async Task CreateChatAsync()
    {
